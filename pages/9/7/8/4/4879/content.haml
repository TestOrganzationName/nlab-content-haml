              slice functor
              %a{:href => "/nlab/new/slice+functor"} ?
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} /
                  %mi a
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo{:stretchy => "false"} /
                  %mi a
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p/a \colon E/a \to B/p(a)
            has a
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %a.existingWikiWord{:href => "/nlab/show/right+inverse"} right inverse
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi a
                  %annotation{:encoding => "application/x-tex"} c_a
            %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
            if one just requires that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi a
                %annotation{:encoding => "application/x-tex"} c_a
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} full and faithful
            %a.existingWikiWord{:href => "/nlab/show/counit+of+the+adjunction"} counit of the adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} /
                  %mi a
                  %mo ⊣
                  %msub
                    %mi c
                    %mi a
                %annotation{:encoding => "application/x-tex"} p/a \dashv c_a
            is an isomorphism. Explicating this condition in elementary terms, one arrives at the above definition.
          %p A simpler version of this characterization is the following.
          .un_lemma
            %h6#lemma Lemma
            %p
              A functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p \colon E \to B
              is a
              %a.existingWikiWord{:href => "/nlab/show/cleavage"} cloven
              Street fibration if and only if the canonical functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi p
                  %annotation{:encoding => "application/x-tex"} i \colon E \to B/p
              has a right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                      %mo{:stretchy => "false"} /
                      %mi B
                    %annotation{:encoding => "application/x-tex"} Cat / B
          .proof
            %h6#proof Proof
            %p
              First, recall that the 2-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi B
                  %annotation{:encoding => "application/x-tex"} Cat/B
              has objects the functors
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} C \to B
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %mover
                              %mo →
                              %mi h
                          %mtd
                            %mi C
                            %mo ′
                        %mtr
                          %mtd
                          %mtd
                            %mi f
                            %mo ↘
                            %mo ≅
                            %mo ↙
                            %mi g
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                            %mi B
                          %mtd
                  %annotation{:encoding => "application/x-tex"} \array{C &amp; \xrightarrow{h} &amp; C' \\ &amp; f \searrow \cong \swarrow g &amp;  \\  &amp; B  &amp; }
            %p
              which commute up to specified isomorphism, and as 2-cells the natural transformations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %msub
                      %mi h
                      %mn 1
                    %mo →
                    %msub
                      %mi h
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \alpha : h_1 \to h_2
              which commute with the specified isomorphisms (i.e.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mover
                      %mo →
                      %mo ≅
                    %mi g
                    %msub
                      %mi h
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %mi g
                        %mi α
                    %mi g
                    %msub
                      %mi h
                      %mn 2
                    %mover
                      %mo →
                      %mo ≅
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f \xrightarrow{\cong} g h_1 \xrightarrow{g \alpha} g h_2 \xrightarrow{\cong} f
              is the identity).
            %p
              Next, recall that the
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi p
                  %annotation{:encoding => "application/x-tex"} B/p
              has objects the triples
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi e
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x, e, k)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:lspace => "verythinmathspace"} :
                    %mi x
                    %mo →
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} k \colon x \to p(e)
              a morphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \pi \colon B/p \to B
              denote the projection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi e
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi x
                    %annotation{:encoding => "application/x-tex"} (x, e, k) \mapsto x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi p
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi p
                  %annotation{:encoding => "application/x-tex"} i\colon p \to B/p
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi B
                  %annotation{:encoding => "application/x-tex"} Cat/B
              sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} e\in E
              to the triple
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi e
                      %mo ,
                      %msub
                        %mn 1
                        %mrow
                          %mi p
                          %mo{:stretchy => "false"} (
                          %mi e
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p(e),e,1_{p(e)})
            %p
              Somewhat imprecisely, seeing both categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi p
                  %annotation{:encoding => "application/x-tex"} B/p
              as sitting over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              means that functors between those should be the identity (up to specified isomorphism) on the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              component, and natural transformations should have the identity as their
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              component (modulo the specified isomorphisms).
            %p
              Now, to give an adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ⊣
                    %mi r
                  %annotation{:encoding => "application/x-tex"} i \dashv r
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Cat
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:lspace => "verythinmathspace"} :
                    %mi x
                    %mo →
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} k \colon x \to p(e)
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} /
                      %mi p
                    %annotation{:encoding => "application/x-tex"} B/p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi e
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r(x,e,k) = r(k)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              and an arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mn 1
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi e
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i(r(k)) = (p(r(k)), r(k), 1_{p(r(k))}) \to (x,e,k)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi p
                  %annotation{:encoding => "application/x-tex"} B/p
              that is
              %a.existingWikiWord{:href => "/nlab/show/universal+arrow"} universal
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi θ
                      %mi k
                    %mo{:lspace => "verythinmathspace"} :
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \theta_k\colon p(r(k)) \to x
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi k
                    %mo{:lspace => "verythinmathspace"} :
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi e
                  %annotation{:encoding => "application/x-tex"} \epsilon_k\colon r(k) \to e
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi r
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mn 1
                          %mtd
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi r
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi θ
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi p
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi ϵ
                                  %mi k
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %munder
                              %mo →
                              %mi k
                          %mtd
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    p(r(k)) &amp; \overset{1}{\to} &amp; p(r(k)) \\
                    \\mathllap{\theta} \downarrow &amp; &amp; \downarrow \mathrlap{p(\epsilon_k)} \\
                    x &amp; \underset{k}{\to} &amp; p(e)
                    }
            %p
              commutes, i.e. such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ϵ
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi k
                      %mo ∘
                      %msub
                        %mi θ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} p(\epsilon_k) = k \circ \theta_k
            %p
              Note that since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mi π
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi e
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x = \pi(x,e,k)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              supply a natural transformation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi p
                      %mi r
                      %mo →
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \theta\colon p r \to \pi
              %a.existingWikiWord{:href => "/nlab/show/doctrinal+adjunction"} doctrinal adjunction
              arguments, in order for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ⊣
                    %mi r
                  %annotation{:encoding => "application/x-tex"} i \dashv r
              to be an adjunction in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                      %mo{:stretchy => "false"} /
                      %mi B
                    %annotation{:encoding => "application/x-tex"} Cat/B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              be invertible (and we then use it to make
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              into a morphism in
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                      %mo{:stretchy => "false"} /
                      %mi B
                    %annotation{:encoding => "application/x-tex"} Cat/B
            %p
              Now, the universal property of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi θ
                      %mi k
                    %mo ,
                    %msub
                      %mi ϵ
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\theta_k,\epsilon_k)
              tells us that for any other morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
