                  %annotation{:encoding => "application/x-tex"} \Sigma
              (which are
              %a.existingWikiWord{:href => "/nlab/show/Stein+manifolds"} Stein manifolds
              by
              = succeed ")," do
                %a{:href => "Stein+manifold#SteinSurfacesAreOpenRiemannSurfaces"} this Example
              %a.existingWikiWord{:href => "/nlab/show/holomorphic+maps"} holomorphic maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Maps
                      %mi hol
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Σ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mover
