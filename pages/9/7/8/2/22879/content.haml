              %a.maruku-ref{:href => "#SegalOnHomotopyTypeOfRationalMapsIntoCPn"}
              may be compared to the
              = succeed "," do
                %a{:href => "Oka+principle#HomotopicalOkaPrinciple"} homotopical Oka principle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              is an
              %a.existingWikiWord{:href => "/nlab/show/Oka+manifold"} Oka manifold
              by
              = succeed ")" do
                %a{:href => "Oka+manifold#ComplexProjectiveSpaceIsOkaManifold"} this Prop.
