                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    Maps^{deg = d}_{rat}
                    \\big(
                    \\mathbb{C}P^{n_1}
                    ,\,
                    \\mathbb{C}P^{n_2}
                    \\big)
                    \\xhookrightarrow{\;\;\;\;}
                    Maps^{deg = d}_{cts}
                    \\big(
                    \\mathbb{C}P^{n_1}
                    ,\,
                    \\mathbb{C}P^{n_2}
                    \\big)
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              of
              %a.existingWikiWord{:href => "/nlab/show/rational+maps"} rational maps
              of algebraic degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              into the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              of
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              in the sense of
              %a.maruku-eqref{:href => "#eq:DegreeOfAMapBetweenComplexProjectiveSpaces"} (3)
              induces an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              on integral
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
              in degrees
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mn 2
                    %msub
                      %mi n
                      %mn 1
                    %mo −
                    %mn 2
                    %msub
                      %mi n
                      %mn 2
                    %mo +
                    %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} ⌊
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} ⌋
                    %mo +
                    %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\leq\,
                    \\big(
                    2 n_1 - 2 n_2 + 1
                    \\big)
                    \\big(
                    \\lfloor(d+2)/2\rfloor + 1
                    \\big)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⌊
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⌋
                  %annotation{:encoding => "application/x-tex"} \lfloor - \rfloor
              denotes the integer
              %a.existingWikiWord{:href => "/nlab/show/floor"} floor
              of a rational number.
          %p
            (
            %a{:href => "#Mostovoy06"}> Mostovoy 2006, Theorem 2
            , with corrected proof in
            = succeed ")" do
              %a{:href => "#Mostovoy12"} Mostovoy 2012
          %p
            An analogous result for
            %a.existingWikiWord{:href => "/nlab/show/real+projective+spaces"} real projective spaces
            is in
            = succeed "." do
              %a{:href => "#AdamaszekKozlowskiYamaguchi08"} Adamaszek, Kozlowski &amp; Yamaguchi 2008
          %p
            Prop.
            %a.maruku-ref{:href => "#HomologyEquivalenceForMapsBetweenComplexProjectiveSpaces"}
            generalizes to the case that the
            %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %msup
                    %mi P
                    %mrow
                      %msub
                        %mi n
                        %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n_2}
            is allowed to be any
            %a.existingWikiWord{:href => "/nlab/show/smooth+variety"} smooth
            %a.existingWikiWord{:href => "/nlab/show/toric+variety"} toric variety
            (
            %a{:href => "#MostovoyMunguiaVillanueva12"}> Mostovoy &amp; Munguia-Villanueva 2012
            ,
            = succeed ")." do
              %a{:href => "#KozlowskiYamaguchi18"} Kozlowski &amp; Yamaguchi 2018
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+monopole"} Yang-Mills monopole
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Oka+principle"} Oka principle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cohomotopy"} Cohomotopy
          %h2#references References
          %h3#maps_out_of_riemann_surfaces Maps out of Riemann surfaces
          %p
            The original theorem for
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/rational+maps"} rational maps
            %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
            from compact
            %a.existingWikiWord{:href => "/nlab/show/Riemann+surfaces"} Riemann surfaces
            to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+spaces"} complex projective spaces
          %ul
            %li#Segal79
              %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"}> Graeme Segal
              ,
              = succeed "," do
                %em The topology of spaces of rational functions
              = succeed ")" do
                %a{:href => "https://projecteuclid.org/euclid.acta/1485890033"} euclid:1485890033
          %p Further discussion:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fred+Cohen"}> Fred Cohen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ralph+Cohen"} Ralph Cohen
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/B.+M.+Mann"} B. M. Mann
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/R.+J.+Milgram"} R. J. Milgram
                = succeed "," do
                  %em The topology of rational functions and divisors of surfaces
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/BF02398886"} doi:10.1007/BF02398886
            %li#FriedlanderLawson97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eric+M.+Friedlander"}> Eric M. Friedlander
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/H.+Blaine+Lawson"} H. Blaine Lawson
                = succeed "," do
                  %em Duality Relating Spaces of Algebraic Cocycles and Cycles
                = succeed ")" do
                  %a{:href => "https://dornsife.usc.edu/assets/sites/1163/docs/Preprint_versionsPublications/10/projH.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ralph+L.+Cohen"}> Ralph L. Cohen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+D.+S.+Jones"} John D. S. Jones
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Graeme+B.+Segal"} Graeme B. Segal
                = succeed "," do
                  %em Stability for holomorphic spheres and Morse theory
                = succeed "," do
                  %em Geometry and Topology: Aarhus
              %p
                Volume: 258 (2000) (
                %a{:href => "https://arxiv.org/abs/math/9904185"}> arXiv:math/9904185
                ,
                = succeed ")" do
                  %a{:href => "https://bookstore.ams.org/conm-258"} ISBN:978-0-8218-2158-9
            %li#Kamiyama07
              %p
                Yasuhiko Kamiyama,
                = succeed "," do
                  %em Remarks on spaces of real rational functions
                = succeed ")" do
                  %a{:href => "https://www.jstor.org/stable/44239357"} jstor:44239357
          %p
            The analog for rational curves into
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/real+projective+spaces"} real projective spaces
          %ul
            %li#Mostovoy01
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Mostovoy"}> Jacob Mostovoy
              ,
              = succeed "," do
                %em Spaces of Rational Loops on a Real Projective Space
              = succeed ")" do
                %a{:href => "https://www.jstor.org/stable/221802"} jstor:221802
          %p
            Identification of the higher
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Maps
                      %mi rat
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mn 1
                    %mo ,
                    %mi ℂ
                    %msup
                      %mi P
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Maps_{rat}(\mathbb{C}P^1, \mathbb{C}P^1)
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Martin+A.+Guest"}> Martin A. Guest
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andrzej+Kozlowski"} Andrzej Kozlowski
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kohhei+Yamaguchi"} Kohhei Yamaguchi
              = succeed "," do
                %em The homotopy type of the space of rational functions
              = succeed ")" do
                %a{:href => "https://projecteuclid.org/journals/kyoto-journal-of-mathematics/volume-35/issue-4/The-homotopy-type-of-the-space-of-rational-functions/10.1215/kjm/1250518652.full"} doi:10.1215/kjm/1250518652
          %p
            Identification of the full
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Maps
                    %mi rat
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %msup
                    %mi P
                    %mn 1
                  %mo ,
                  %mi ℂ
                  %msup
                    %mi P
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Maps_{rat}(\mathbb{C}P^1, \mathbb{C}P^n)
            with a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/configuration+space+of+points"} configuration space of points
          %ul
            %li#CohenShimamoto91
              %a.existingWikiWord{:href => "/nlab/show/Ralph+L.+Cohen"}> Ralph L. Cohen
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Don+H.+Shimamoto"} Don H. Shimamoto
              = succeed "," do
                %em Rational Functions, Labelled Configurations, and Hilbert Schemes
              %strong 43
              2 (1991) 509-528 (
              %a{:href => "https://doi.org/10.1112/jlms/s2-43.3.509"}> doi:10.1112/jlms/s2-43.3.509
              )
          %p
            Generalization to the case that the
            %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            is
          %p
            … a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Grassmannian"} Grassmannian
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Frances+Kirwan"}> Frances Kirwan
                ,
                = succeed "," do
                  %em On spaces of maps from Riemann surfaces to Grassmannians and applications to the cohomology of moduli of vector bundles
                = succeed ")" do
                  %a{:href => "https://www.projecteuclid.org/journals/arkiv-for-matematik/volume-24/issue-1-2/On-spaces-of-maps-from-Riemann-surfaces-to-Grassmannians-and/10.1007/BF02384399.full"} doi:10.1007/BF02384399
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Benjamin+M.+Mann"}> Benjamin M. Mann
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/R.+James+Milgram"} R. James Milgram
                = succeed "," do
                  %em Some spaces of holomorphic maps to complex Grassmann manifolds
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/journals/journal-of-differential-geometry/volume-33/issue-2/Some-spaces-of-holomorphic-maps-to-complex-Grassmann/10.4310/jdg/1214446318.full"} doi:10.4310/jdg/1214446318
            %li#Havlicek92
              %p
                John W. Havlicek,
                = succeed "," do
                  %em On spaces of holomorphic maps from two copies of the riemann sphere to complex grassmannians
                = succeed ")" do
                  %a{:href => "https://www.proquest.com/docview/304009877"} proquest:304009877
          %p
            … a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/toric+variety"} toric variety
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+A.+Guest"}> Martin A. Guest
                ,
                = succeed "," do
                  %em Configuration spaces and the space of rational curves on a toric variety
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1090/S0273-0979-1994-00515-4"} doi:10.1090/S0273-0979-1994-00515-4
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+A.+Guest"}> Martin A. Guest
                ,
                = succeed "," do
                  %em The topology of the space of rational curves on a toric variety
                = succeed "," do
                  %a{:href => "https://projecteuclid.org/journals/acta-mathematica/volume-174/issue-1/The-topology-of-the-space-of-rational-curves-on-a/10.1007/BF02392803.full"} doi:10.1007/BF02392803
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/alg-geom/9301005"} arXiv:alg-geom/9301005
          %p
            … a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/flag+manifold"} flag manifold
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/C.+P.+Boyer"}> C. P. Boyer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/B.+M.+Mann"} B. M. Mann
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/J.+C.+Hurtubise"} J. C. Hurtubise
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/R.+J.+Milgram"} R. J. Milgram
                = succeed "," do
                  %em The topology of the space of rational maps into generalized flag manifolds
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/journals/acta-mathematica/volume-173/issue-1/The-topology-of-the-space-of-rational-maps-into-generalized/10.1007/BF02392569.full"} doi:10.1007/BF02392569
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/J.+C.+Hurtubise"}> J. C. Hurtubise
                ,
                = succeed "," do
                  %em Holomorphic maps of a Riemann surface into a flag manifold
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/journals/journal-of-differential-geometry/volume-43/issue-1/Holomorphic-maps-of-a-Riemann-surface-into-a-flag-manifold/10.4310/jdg/1214457899.full"} doi:10.4310/jdg/1214457899
          %p
            Application to the
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of
            %a.existingWikiWord{:href => "/nlab/show/Skyrmions"} Skyrmions
            (via their rational map Ansatz, see the references
            = succeed "):" do
              %a{:href => "skyrmion#SkyrmionsFromRationalMapsReferences"} there
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steffen+Krusch"}> Steffen Krusch
                ,
                = succeed "," do
                  %em Homotopy of rational maps and the quantization of Skyrmions
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/S0003-4916(03)00014-9"} doi:10.1016/S0003-4916(03)00014-9
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steffen+Krusch"}> Steffen Krusch
                ,
                = succeed "," do
                  %em Skyrmions and Rational Maps
                = succeed "," do
                  %a{:href => "http://newton.kias.re.kr/KH04/talks/krusch.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/Krusch_SkyrmionsAndRationalMaps.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steffen+Krusch"}> Steffen Krusch
                ,
                %em Quantization of Skyrmions
                (
                %a{:href => "https://arxiv.org/abs/hep-th/0610176"}> arXiv:hep-th/0610176
                )
          %h3#maps_between_projective_spaces_2 Maps between projective spaces
          %p
            On maps between
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+spaces"} complex projective spaces
          %ul
            %li#Mostovoy06
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Mostovoy"}> Jacob Mostovoy
              ,
              = succeed "," do
                %em Spaces of rational maps and the Stone–Weierstrass theorem
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/j.top.2005.08.003"} doi:10.1016/j.top.2005.08.003
          %p corrected proof in:
          %ul
            %li#Mostovoy12
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Mostovoy"}> Jacob Mostovoy
              ,
              = succeed "," do
                %em Truncated Simplicial Resolutions and Spaces of Rational Maps
              = succeed ")" do
                %a{:href => "https://doi.org/10.1093/qmath/haq031"} doi:10.1093/qmath/haq031
          %p
            On maps between
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/real+projective+spaces"} real projective spaces
          %ul
            %li#AdamaszekKozlowskiYamaguchi08
              %a.existingWikiWord{:href => "/nlab/show/Michal+Adamaszek"}> Michal Adamaszek
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andrzej+Kozlowski"} Andrzej Kozlowski
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kohhei+Yamaguchi"} Kohhei Yamaguchi
              = succeed "," do
                %em Spaces of algebraic and continuous maps between real algebraic varieties
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/0809.4893"} arXiv:0809.4893
              = succeed ")" do
                %a{:href => "https://doi.org/10.1093/qmath/haq029"} doi:10.1093/qmath/haq029
          %p
            On maps from
            %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
            to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andrzej+Kozlowski"}> Andrzej Kozlowski
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kohhei+Yamaguchi"} Kohhei Yamaguchi
              %em Spaces of algebraic maps from real projective spaces into complex projective spaces
              (
              %a{:href => "https://arxiv.org/abs/0812.3954"}> arXiv:0812.3954
              ), in:
              %a.existingWikiWord{:href => "/nlab/show/Yves+F%C3%A9lix"} Yves Félix
              et al. (eds.)
              = succeed "," do
                %em Homotopy Theory of Function Spaces and Related Topics
              = succeed ")" do
                %a{:href => "https://bookstore.ams.org/conm-519"} ISBN:978-0-8218-4929-3
          %p
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariantly
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andrzej+Kozlowski"}> Andrzej Kozlowski
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kohhei+Yamaguchi"} Kohhei Yamaguchi
              = succeed "," do
                %em Spaces of equivariant algebraic maps from real projective spaces into complex projective spaces
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1109.0353"} arXiv:1109.0353
              = succeed ")" do
                %a{:href => "https://www.kurims.kyoto-u.ac.jp/~kenkyubu/bessatsu/open/B39/pdf/B39_006.pdf"} published pdf
          %h3#maps_from_projective_spaces_to_toric_varieties Maps from projective spaces to toric varieties
          %p
            On maps from
            %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
            to smooth
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/toric+varieties"} toric varieties
          %ul
            %li#MostovoyMunguiaVillanueva12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Mostovoy"}> Jacob Mostovoy
                , Erendira Munguia-Villanueva,
                = succeed "," do
                  %em Spaces of morphisms from a projective space to a toric variety
                %strong 48
                1 (2014) (
                %a{:href => "https://arxiv.org/abs/1210.2795"}> arXiv:1210.2795
                ,
                = succeed ")" do
                  %a{:href => "http://scm.org.co/archivos/revista/Articulos/1129.pdf"} published pdf
            %li#KozlowskiYamaguchi18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrzej+Kozlowski"}> Andrzej Kozlowski
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kohhei+Yamaguchi"} Kohhei Yamaguchi
                = succeed "," do
                  %em The homotopy type of spaces of rational curves on a toric variety
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/j.topol.2018.06.006"} doi:10.1016/j.topol.2018.06.006
        .revisedby
