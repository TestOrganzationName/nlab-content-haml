          %h2#idea Idea
          %p
            In the context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
            %em Maxwell’s equations
            are the
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            for the electromagnetic
            %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            %a.existingWikiWord{:href => "/nlab/show/electric+current"} electric current
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/magnetic+current"} magnetic current
          %p
            (This is the specialization of the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+equations"} Yang-Mills equations
            for the case that the
            %a.existingWikiWord{:href => "/nlab/show/structure+group"} structure group
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
            = succeed ")." do
              %a{:href => "Yang-Mills+equation#AbelianCase"} there
          %h2#three_dimensional_formulation Three dimensional formulation
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is here the (vector of) strength of electric field and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            the strength of magnetic field;
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            is the charge and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mi el
                %annotation{:encoding => "application/x-tex"} j_{el}
            the density of the electrical current;
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon_0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mu_0
            are constants (electrical permeability, speed of the light, and magnetic permeability; all of/in vacuum:
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 0
                    %msub
                      %mi ϵ
                      %mn 0
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi c
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mu_0 \epsilon_0  = 1/c^2
          %h3#integral_formulation_in_vacuum Integral formulation in vacuum
          %p
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Gauss%27+law"} Gauss' law
              for electric fields
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %msub
                      %mo ∫
                      %mrow
                        %mo ∂
                        %mi V
                    %mi E
                    %mo ⋅
                    %mi d
                    %mi A
                    %mo =
                    %mfrac
                      %mi Q
                      %mrow
                        %msub
                          %mi ϵ
                          %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\textstyle{\int}_{\partial V} E\cdot d A =  \frac{Q}{\epsilon_0}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mi V
                %annotation{:encoding => "application/x-tex"} \partial V
            is a closed surface which is a boundary of a 3d domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            (physicists say “volume”) and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo =
                  %mstyle{:displaystyle => "false"}
                    %msub
                      %mo ∫
                      %mi V
                    %mi ρ
                    %mi d
                    %mi V
                %annotation{:encoding => "application/x-tex"} Q = \textstyle{\int}_V \rho d V
            the charge in the domain
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋅
                %annotation{:encoding => "application/x-tex"} \cdot
            denotes the scalar (dot) product. Surface element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi A
                %annotation{:encoding => "application/x-tex"} d A
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi n
                      %mo{:stretchy => "false"} →
                    %mi d
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \vec{n} d |A|
          %p
            %strong No magnetic monopoles
            (Gauss’ law for magnetic fields)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %msub
                      %mo ∫
                      %mi Σ
                    %mi B
                    %mo ⋅
                    %mi d
                    %mi A
                    %mo =
                    %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\textstyle{\int}_\Sigma B\cdot d A =  0
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is any closed surface.
          %p
            %strong Faraday’s law of induction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %msub
                      %mo ∮
                      %mrow
                        %mo ∂
                        %mi Σ
                    %mi E
                    %mo ⋅
                    %mi d
                    %mi s
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi t
                    %mstyle{:displaystyle => "false"}
                      %msub
                        %mo ∫
                        %mi Σ
                      %mi B
                      %mo ⋅
                      %mi d
                      %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\textstyle{\oint}_{\partial \Sigma} E\cdot d s = - \frac{d}{d t} \textstyle{\int}_\Sigma B\cdot d A
          %p
            The line element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi s
                %annotation{:encoding => "application/x-tex"} d s
            is the differential (or 1-d measure on the boundary) of the length times the unit vector in counter-circle direction (or parametrize the curve with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            being a vector in 3d space, express magnetic field in the same parameter and calculate the integral as a function of parameter:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋅
                %annotation{:encoding => "application/x-tex"} \cdot
            is a scalar (“dot”) product).
          %p
            %strong Ampère-Maxwell law
            (or generalized Ampère’s law; Maxwell added the second term involving derivative of the flux of electric field to the Ampère’s law which described the magnetic field due electric current).
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %msub
                      %mo ∮
                      %mrow
                        %mo ∂
                        %mi Σ
                    %mi B
                    %mo ⋅
                    %mi d
                    %mi s
                    %mo =
                    %msub
                      %mi μ
                      %mn 0
                    %mi I
                    %mo +
                    %msub
                      %mi μ
                      %mn 0
                    %msub
                      %mi ϵ
                      %mn 0
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi t
                    %mstyle{:displaystyle => "false"}
                      %msub
                        %mo ∫
                        %mi Σ
                      %mi E
                      %mo ⋅
                      %mi d
                      %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\textstyle{\oint}_{\partial \Sigma} B\cdot d s = \mu_0 I + \mu_0 \epsilon_0 \frac{d}{d t} \textstyle{\int}_\Sigma E\cdot d A
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is a surface and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \partial \Sigma
            its boundary;
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is the total current through
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            (integral of the component of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mi el
                %annotation{:encoding => "application/x-tex"} j_{el}
            normal to the surface).
          %h3#DifferentialEquations Differential equations
          %p
            Here we put units with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} c = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            we denote the density of the charge.
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pre-metric+electromagnetism"} pregeometric form
            %a.existingWikiWord{:href => "/nlab/show/differential+equations"} differential equations
            for
            %em four
            fields (
            %a.existingWikiWord{:href => "/nlab/show/vector+fields"}> vector fields
            ) called
          %ul
            %li
              %p
                %em electric field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} \vec E
            %li
              %p
                %em magnetic flux density
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi B
                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} \vec B
            %li
              %p
                %em magnetic field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} \vec H
            %li
              %p
                %em displacement field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi D
                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} \vec D
                (or similar)
          %p and state:
          %ul
            %li
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/magnetic+Gauss+law"}> magnetic Gauss law
                  )
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi div
                      %mi B
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} div B = 0
              %p
                (“there is no source for magnetic
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/flux"} flux
                = succeed "\u201D)" do
                  %a.existingWikiWord{:href => "/nlab/show/magnetic+monopoles"} magnetic monopoles
            %li
              %p
                %strong> Faraday’s law
                \:
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mi d
                        %mrow
                          %mi d
                          %mi t
                      %mi B
                      %mo +
                      %mi rot
                      %mi E
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \frac{d}{d t} B + rot E = 0
            %li
              %p
                %strong>
                  (
                  %a.existingWikiWord{:href => "/nlab/show/electric+Gauss+law"}> electric Gauss law
                  )
                \:
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi div
                      %mi D
                      %mo =
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} div D = \rho
              %p
                (“the source of electric
                %a.existingWikiWord{:href => "/nlab/show/flux"} flux
                is electric current”)
            %li
              %p
                %strong generalized Ampère’s law
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mfrac
                        %mi d
                        %mrow
                          %mi d
                          %mi t
                      %mi D
                      %mo +
                      %mi rot
                      %mi H
                      %mo =
                      %msub
                        %mi j
                        %mi el
                    %annotation{:encoding => "application/x-tex"} - \frac{d}{d t} D + rot H = j_{el}
          %p
            In order to complete this
            %a.existingWikiWord{:href => "/nlab/show/pregeometric+electromagnetism"} pregeometric
            form to the actual
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            %em
              %a.existingWikiWord{:href => "/nlab/show/constitutive+equation"} constitutive equation
            which expresses
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi D
                    %mo{:stretchy => "false"} →
                  %mo ,
                  %mover
                    %mi H
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\vec D, \vec H)
            as a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} →
                    %mo ,
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\vec E, \vec B)
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
            and in the absence of
            %a.existingWikiWord{:href => "/nlab/show/background+field"} background
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/constitutive+relation"} constitutive relation
          %ul
            %li
              %p
                equates the displacement field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi D
                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} \vec D
                with the electric field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} \vec E
                times a constant
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϵ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \epsilon_0
              %p
                called the “
                %em> permitivity of the vacuum
                ”,
            %li
              %p
                equates the magnetic flux
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi B
                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} \vec B
                with the magnetic field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} \vec H
                times a constant
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mu_0
              %p
                called the “
                %em> permeability of the vacuum
                ”.
          %p
            But for
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+fields"} electromagnetic fields
            inside
            %a.existingWikiWord{:href => "/nlab/show/dielectric+media"} dielectric media
            other
            %a.existingWikiWord{:href => "/nlab/show/constitutive+relations"} constitutive relations
            appear. For small field strengths these are typically
            %a.existingWikiWord{:href => "/nlab/show/linear+functions"} linear functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            (e.g.
            = succeed ")" do
              %a{:href => "#deLangeRaab06"} de Lange &amp; Raab 2006 (19)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi D
                    %mo{:stretchy => "false"} →
                  %mo ,
                  %mover
                    %mi H
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mo =
                    %mo !
                  %mspace{:width => "thickmathspace"}
                  %mi C
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} →
                  %mo ,
                  %mover
                    %mi B
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (\vec D, \vec H)
                  \\;\overset{!}{=}\;
                  C\big((\vec E, \vec B)\big)
                  \\,,
          %p
            but in general the constitutive
            %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            can be a non-linear or even be a “
            %a.existingWikiWord{:href => "/nlab/show/multi-valued+function"}> multi-valued function
            ” (namely when there are hysteresis effects in the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/dielectric+medium"} dielectric medium
          %p
            Similarly (interestingly), in the presence of
            %a.existingWikiWord{:href => "/nlab/show/background+field"} background
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            (such as for
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+fields"} electromagnetic fields
            in and around a star) there is a linear such relation depending on the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+metric"} pseudo-Riemannian metric
            %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
            acting on the electromagnetic fields re-packaged as a
            %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
            %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
            (see
            = succeed ")." do
              %a{:href => "#InTermsOfFaradayTensor"} below
          %h2#InTermsOfFaradayTensor
            In terms of Faraday tensor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
          %p
            This is adapted from
            = succeed "," do
              %em
                %a{:href => "electromagnetic+field#MaxwellEquations"} electromagnetic field – Maxwell’s equations
            = succeed "." do
              %a{:href => "#ReferencesForMaxwellEquationsViaDifferentialForms"} below
          %p
            In modern language, the insight of (
            %a{:href => "#Maxwell1865"}> Maxwell, 1865
            ) is that locally, when physical
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            is well approximated by a patch of its tangent space, i.e. by a patch of 4-dimensional
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+space"} Minkowski space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 4
                    %mo ,
                    %mi g
                    %mo =
                    %mi diag
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U \subset (\mathbb{R}^4, g = diag(-1,1,1,1))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} →
                  %mo =
                  %mrow
                    %mo [
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi E
                              %mn 1
                        %mtr
                          %mtd
                            %msub
                              %mi E
                              %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi E
                              %mn 3
                    %mo ]
                %annotation{:encoding => "application/x-tex"} \vec E = \left[ \array{E_1 \\ E_2 \\ E_3} \right]
            and magnetic field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi B
                    %mo{:stretchy => "false"} →
                  %mo =
                  %mrow
                    %mo [
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi B
                              %mn 1
                        %mtr
                          %mtd
                            %msub
                              %mi B
                              %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi B
                              %mn 3
                    %mo ]
                %annotation{:encoding => "application/x-tex"} \vec B = \left[ \array{B_1 \\ B_2 \\ B_3} \right]
            combine into a differential
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} 2-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi F
                        %mtd
                          %mo ≔
                          %mi E
                          %mo ∧
                          %mi d
                          %mi t
                          %mo +
                          %mi B
                      %mtr
                        %mtd
                        %mtd
                          %mo ≔
                          %msub
                            %mi E
                            %mn 1
                          %mi d
                          %msup
                            %mi x
                            %mn 1
                          %mo ∧
                          %mi d
                          %mi t
                          %mo +
                          %msub
                            %mi E
                            %mn 2
                          %mi d
                          %msup
                            %mi x
                            %mn 2
                          %mo ∧
                          %mi d
                          %mi t
                          %mo +
                          %msub
                            %mi E
                            %mn 3
                          %mi d
                          %msup
                            %mi x
                            %mn 3
                          %mo ∧
                          %mi d
                          %mi t
                      %mtr
                        %mtd
                        %mtd
                          %mphantom
                            %mo ≔
                          %mo +
                          %msub
                            %mi B
                            %mn 1
                          %mi d
                          %msup
                            %mi x
                            %mn 2
                          %mo ∧
                          %mi d
                          %msup
                            %mi x
                            %mn 3
                          %mo +
                          %msub
                            %mi B
                            %mn 2
                          %mi d
                          %msup
                            %mi x
                            %mn 3
                          %mo ∧
                          %mi d
                          %msup
                            %mi x
                            %mn 1
                          %mo +
                          %msub
                            %mi B
                            %mn 3
                          %mi d
                          %msup
                            %mi x
                            %mn 1
                          %mo ∧
                          %mi d
                          %msup
                            %mi x
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  F &amp; \coloneqq E \wedge d t + B
                  \\\
                  \&amp; \coloneqq
                  E_1 d x^1 \wedge d t +
                  E_2 d x^2 \wedge d t +
                  E_3 d x^3 \wedge d t
                  \\\
                  \&amp; \phantom{\coloneqq} +
                  B_1 d x^2 \wedge d x^3 +
                  B_2 d x^3 \wedge d x^1 +
                  B_3 d x^1 \wedge d x^2
                  \\end{aligned}
          %p
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^2(U)
            and the
            %a.existingWikiWord{:href => "/nlab/show/electric+charge"} electric charge
            density and current density combine to a differential 3-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi j
                            %mi el
                        %mtd
                          %mo ≔
                          %mi j
                          %mo ∧
                          %mi dt
                          %mo −
                          %mi ρ
                          %mi d
                          %msup
                            %mi x
                            %mn 1
                          %mo ∧
                          %mi d
                          %msup
                            %mi x
                            %mn 2
                          %mo ∧
                          %mi d
                          %msup
                            %mi x
                            %mn 3
                      %mtr
                        %mtd
                        %mtd
                          %mo ≔
                          %msub
                            %mi j
                            %mn 1
                          %mi d
                          %msup
                            %mi x
                            %mn 2
                          %mo ∧
                          %mi d
                          %msup
                            %mi x
                            %mn 3
                          %mo ∧
                          %mi d
                          %mi t
                          %mo +
                          %msub
                            %mi j
                            %mn 2
                          %mi d
                          %msup
                            %mi x
                            %mn 3
                          %mo ∧
                          %mi d
                          %msup
                            %mi x
                            %mn 1
                          %mo ∧
                          %mi d
                          %mi t
                          %mo +
                          %msub
                            %mi j
                            %mn 3
                          %mi d
                          %msup
                            %mi x
                            %mn 1
                          %mo ∧
                          %mi d
                          %msup
                            %mi x
                            %mn 2
                          %mo ∧
                          %mi d
                          %mi t
                          %mo −
                          %mi ρ
                          %mspace{:width => "thickmathspace"}
                          %mi d
                          %msup
                            %mi x
                            %mn 1
                          %mo ∧
                          %mi d
                          %msup
                            %mi x
                            %mn 2
                          %mo ∧
                          %mi d
                          %msup
                            %mi x
                            %mn 3
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  j_{el} &amp; \coloneqq j\wedge dt - \rho d x^1 \wedge d x^2 \wedge d x^3 \\
                  \&amp; \coloneqq    j_1 d x^2 \wedge d x^3 \wedge d t +
                  j_2 d x^3 \wedge d x^1 \wedge d t +
                  j_3 d x^1 \wedge d x^2 \wedge d t
                  \-
                  \\rho \; d x^1 \wedge d x^2 \wedge d x^3
                  \\end{aligned}
          %p
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^3(U)
            such that the following two equations of differential forms are satisfied
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi d
                          %mi F
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %mi d
                          %mo ⋆
                          %mi F
                          %mo =
                          %msub
                            %mi j
                            %mi el
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  d F = 0
                  \\\
                  d \star F  = j_{el}
                  \\end{aligned}
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            is the de Rham differential operator and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \star
            the
            %a.existingWikiWord{:href => "/nlab/show/Hodge+star"} Hodge star
            operator. If we decompose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                  %mi F
                %annotation{:encoding => "application/x-tex"} \star F
            into its components as before as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mo ⋆
                          %mi F
                        %mtd
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi D
                          %mo +
                          %mi H
                          %mo ∧
                          %mi dt
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mi D
                            %mn 1
                          %mspace{:width => "thickmathspace"}
                          %mi d
                          %msup
                            %mi x
                            %mn 2
                          %mo ∧
                          %mi d
                          %msup
                            %mi x
                            %mn 3
                          %mo −
                          %msub
                            %mi D
                            %mn 2
                          %mspace{:width => "thickmathspace"}
                          %mi d
                          %msup
                            %mi x
                            %mn 3
                          %mo ∧
                          %mi d
                          %msup
                            %mi x
                            %mn 1
                          %mo −
                          %msub
                            %mi D
                            %mn 3
                          %mspace{:width => "thickmathspace"}
                          %mi d
                          %msup
                            %mi x
                            %mn 1
                          %mo ∧
                          %mi d
                          %msup
                            %mi x
                            %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mphantom
                            %mo =
                          %mo +
                          %msub
                            %mi H
                            %mn 1
                          %mspace{:width => "thickmathspace"}
                          %mi d
                          %msup
                            %mi x
                            %mn 1
                          %mo ∧
                          %mi d
                          %mi t
                          %mo +
                          %msub
                            %mi H
                            %mn 2
                          %mspace{:width => "thickmathspace"}
                          %mi d
                          %msup
                            %mi x
                            %mn 2
                          %mo ∧
                          %mi d
                          %mi t
                          %mo +
                          %msub
                            %mi H
                            %mn 3
                          %mspace{:width => "thickmathspace"}
                          %mi d
                          %msup
                            %mi x
                            %mn 3
                          %mo ∧
                          %mi d
                          %mi t
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\star F
                  \&amp;= -D + H\wedge dt \\
                  \&amp;= -D_1 \; d x^2 \wedge d x^3
                  \-D_2 \; d x^3 \wedge d x^1
                  \-D_3 \; d x^1 \wedge d x^2
                  \\\
                  \&amp; \phantom{=} +
                  H_1 \; d x^1 \wedge d t
                  +
                  H_2 \; d x^2 \wedge d t
                  +
                  H_3 \; d x^3 \wedge d t
                  \\end{aligned}
          %p then in terms of these components the Maxwell equations read as follows:
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi F
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} d F = 0
            gives the
            %a.existingWikiWord{:href => "/nlab/show/magnetic+Gauss+law"} magnetic Gauss law
            and Faraday’s law
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo ⋆
                  %mi F
                  %mo =
                  %msub
                    %mi j
                    %mi el
                %annotation{:encoding => "application/x-tex"} d \star F = j_{el}
            gives
            %a.existingWikiWord{:href => "/nlab/show/Gauss%27s+law"} Gauss's law
            and Ampère-Maxwell law
          %h2#in_terms_of_the_faraday_bivector_
            In terms of the Faraday bivector
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
          %p
            In the
            %a.existingWikiWord{:href => "/nlab/show/geometric+algebra"} geometric algebra
            formalism of electromagnetism, one works in the 4-dimensional
            %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi{:mathvariant => "normal"} Cl
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 3
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Cl}^{1, 3}(\mathbb{R})
            representing
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi γ
                    %mi i
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\gamma_i\}
            have signature
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (+, -, -, -)
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi γ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \gamma_0
            representing the time dimension and the other three basis vectors representing the spacial dimensions. The pseudoscalar of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi{:mathvariant => "normal"} Cl
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 3
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Cl}^{1, 3}(\mathbb{R})
            is represented by the product of all the basis vectors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi i
                  %msub
                    %mi γ
                    %mi i
                  %mo =
                  %msub
                    %mi γ
                    %mn 0
                  %msub
                    %mi γ
                    %mn 1
                  %msub
                    %mi γ
                    %mn 2
                  %msub
                    %mi γ
                    %mn 3
                %annotation{:encoding => "application/x-tex"} I = \prod_{i} \gamma_i = \gamma_0 \gamma_1 \gamma_2 \gamma_3
          %p
            The basis
            %a.existingWikiWord{:href => "/nlab/show/bivectors"} bivectors
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi{:mathvariant => "normal"} Cl
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 3
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Cl}^{1, 3}(\mathbb{R})
            come in two sets, the
            %em timelike bivectors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 1
                    %mo =
                    %msub
                      %mi γ
                      %mn 1
                    %msub
                      %mi γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \sigma_1 = \gamma_1 \gamma_0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 2
                    %mo =
                    %msub
                      %mi γ
                      %mn 2
                    %msub
                      %mi γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \sigma_2 = \gamma_2 \gamma_0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 3
                    %mo =
                    %msub
                      %mi γ
                      %mn 3
                    %msub
                      %mi γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \sigma_3 = \gamma_3 \gamma_0
            %em spacelike bivectors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %msub
                      %mi σ
                      %mn 1
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi γ
                      %mn 2
                    %msub
                      %mi γ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} I \sigma_1 = -\gamma_2 \gamma_3
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %msub
                      %mi σ
                      %mn 2
                    %mo =
                    %msub
                      %mi γ
                      %mn 1
                    %msub
                      %mi γ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} I \sigma_2 = \gamma_1 \gamma_3
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %msub
                      %mi σ
                      %mn 3
                    %mo =
                    %msub
                      %mi γ
                      %mn 1
                    %msub
                      %mi γ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} I \sigma_3 = \gamma_1 \gamma_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi{:mathvariant => "normal"} Cl
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 3
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Cl}^{1, 3}(\mathbb{R})
            is equivalent to the three-dimensional
            %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi{:mathvariant => "normal"} Cl
                    %mrow
                      %mn 3
                      %mo ,
                      %mn 0
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Cl}^{3, 0}(\mathbb{R})
            corresponding to the relative space in the rest frame defined by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \gamma_0
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            be a vector in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi{:mathvariant => "normal"} Cl
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 3
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Cl}^{1, 3}(\mathbb{R})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            relative to the basis
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi γ
                    %mi i
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\gamma_i\}
            to be
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi i
                    %mo =
                    %msub
                      %mi γ
                      %mi i
                    %mo ⋅
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x^i = \gamma_i \cdot x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mn 0
                %annotation{:encoding => "application/x-tex"} x^0
            is also denoted as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            since it represents the time coordinate. The spacetime vector derivative is defined as the operator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo =
                  %msub
                    %mi γ
                    %mn 0
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %mi t
                  %mo +
                  %msub
                    %mi γ
                    %mn 1
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mn 1
                  %mo +
                  %msub
                    %mi γ
                    %mn 2
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mn 2
                  %mo +
                  %msub
                    %mi γ
                    %mn 3
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mn 3
                %annotation{:encoding => "application/x-tex"} \nabla = \gamma_0 \frac{\partial}{\partial t} + \gamma_1 \frac{\partial}{\partial x^1} + \gamma_2 \frac{\partial}{\partial x^2} + \gamma_3 \frac{\partial}{\partial x^3}
          %p The relative vector derivative is defined as the operator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mo ∇
                  %mo =
                  %msub
                    %mi σ
                    %mn 1
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mn 1
                  %mo +
                  %msub
                    %mi σ
                    %mn 2
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mn 2
                  %mo +
                  %msub
                    %mi σ
                    %mn 3
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mn 3
                %annotation{:encoding => "application/x-tex"} \mathbf{\nabla} = \sigma_1 \frac{\partial}{\partial x^1} + \sigma_2 \frac{\partial}{\partial x^2} + \sigma_3 \frac{\partial}{\partial x^3}
          %p
            Assuming the use of
            %a.existingWikiWord{:href => "/nlab/show/natural+units"} natural units
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo =
                  %msub
                    %mi ϵ
                    %mn 0
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} c = \epsilon_0 = 1
            and ignoring the polarization and magnatization fields for the time being, Maxwell’s equations are written as:
          %ul
            %li
              %p electric Gauss’s law:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mo ∇
                      %mo ⋅
                      %mi E
                      %mo =
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \mathbf{\nabla} \cdot E = \rho
            %li
              %p Faraday’s law:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mo ∇
                      %mo ∧
                      %mi E
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %mi t
                      %mrow
                        %mo (
                        %mi I
                        %mi B
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \mathbf{\nabla} \wedge E = -\frac{\partial}{\partial t}\left(I B\right)
            %li
              %p magnetic Gauss’s law:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mo ∇
                      %mo ⋅
                      %mi B
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathbf{\nabla} \cdot B = 0
            %li
              %p Ampère-Maxwell law:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mo ∇
                      %mo ∧
                      %mi B
                      %mo =
                      %mi I
                      %mrow
                        %mo (
                        %mstyle{:mathvariant => "bold"}
                          %mi J
                        %mo +
                        %mfrac
                          %mo ∂
                          %mrow
                            %mo ∂
                            %mi t
                        %mrow
                          %mo (
                          %mi E
                          %mo )
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \mathbf{\nabla} \wedge B = I\left(\mathbf{J} + \frac{\partial}{\partial t}\left(E\right)\right)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            are the relative electric and magnetic relative fields,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            is the density of the charge, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi J
                %annotation{:encoding => "application/x-tex"} \mathbf{J}
            is the relative current of the charge.
          %p
            The
            %em Faraday bivector
            is the bivector
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %mi E
                    %mo +
                    %mi I
                    %mi B
                  %annotation{:encoding => "application/x-tex"} F = E + I B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mo ∇
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbf{\nabla} \cdot (I B) = 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mo ∇
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mstyle{:mathvariant => "bold"}
                    %mi J
                  %mo −
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %mi t
                  %mrow
                    %mo (
                    %mi E
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathbf{\nabla} \wedge (I B) = -\mathbf{J} - \frac{\partial}{\partial t}\left(E\right)
          %p and by adding the four equations together, one gets the equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mo ∇
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo +
                  %mi I
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mstyle{:mathvariant => "bold"}
                    %mo ∇
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo +
                  %mi I
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ρ
                  %mo −
                  %mstyle{:mathvariant => "bold"}
                    %mi J
                  %mo −
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %mi t
                  %mrow
                    %mo (
                    %mi E
                    %mo +
                    %mi I
                    %mi B
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathbf{\nabla} \cdot (E + I B) + \mathbf{\nabla} \wedge (E + I B) = \rho -\mathbf{J} -\frac{\partial}{\partial t}\left(E + I B\right)
          %p which then becomes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mo ∇
                  %mo ⋅
                  %mi F
                  %mo +
                  %mstyle{:mathvariant => "bold"}
                    %mo ∇
                  %mo ∧
                  %mi F
                  %mo +
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %mi t
                  %mrow
                    %mo (
                    %mi F
                    %mo )
                  %mo =
                  %mi ρ
                  %mo −
                  %mstyle{:mathvariant => "bold"}
                    %mi J
                %annotation{:encoding => "application/x-tex"} \mathbf{\nabla} \cdot F + \mathbf{\nabla} \wedge F + \frac{\partial}{\partial t}\left(F\right) = \rho - \mathbf{J}
          %p
            Given a timelike bivector
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            and a general bivector
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi{:mathvariant => "normal"} Cl
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 3
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Cl}^{1, 3}(\mathbb{R})
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mi M
                    %mo =
                    %mi v
                    %mo ⋅
                    %mi M
                    %mo +
                    %mi v
                    %mo ∧
                    %mi M
                  %annotation{:encoding => "application/x-tex"} v M = v \cdot M + v \wedge M
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mo ∇
                  %mi F
                  %mo +
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %mi t
                  %mrow
                    %mo (
                    %mi F
                    %mo )
                  %mo =
                  %mi ρ
                  %mo −
                  %mstyle{:mathvariant => "bold"}
                    %mi J
                %annotation{:encoding => "application/x-tex"} \mathbf{\nabla} F + \frac{\partial}{\partial t}\left(F\right) = \rho - \mathbf{J}
          %p or
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mstyle{:mathvariant => "bold"}
                      %mo ∇
                    %mo +
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi t
                    %mo )
                  %mrow
                    %mo (
                    %mi F
                    %mo )
                  %mo =
                  %mi ρ
                  %mo −
                  %mstyle{:mathvariant => "bold"}
                    %mi J
                %annotation{:encoding => "application/x-tex"} \left(\mathbf{\nabla} + \frac{\partial}{\partial t}\right)\left(F\right) = \rho - \mathbf{J}
          %p
            Now, the spacetime current is given by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo =
                    %msub
                      %mi γ
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo −
                    %mstyle{:mathvariant => "bold"}
                      %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J = \gamma_0 (\rho - \mathbf{J})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo =
                  %msub
                    %mi γ
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mo ∇
                  %mo +
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \nabla = \gamma_0 (\mathbf{\nabla} + \frac{\partial}{\partial t})
          %p
            Thus, by left multiplying each side by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \gamma_0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi γ
                    %mn 0
                  %mrow
                    %mo (
                    %mstyle{:mathvariant => "bold"}
                      %mo ∇
                    %mo +
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi t
                    %mo )
                  %mrow
                    %mo (
                    %mi F
                    %mo )
                  %mo =
                  %msub
                    %mi γ
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi ρ
                  %mo −
                  %mstyle{:mathvariant => "bold"}
                    %mi J
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \gamma_0 \left(\mathbf{\nabla} + \frac{\partial}{\partial t}\right)\left(F\right) = \gamma_0 (\rho - \mathbf{J})
          %p or
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mi F
                  %mo =
                  %mi J
                %annotation{:encoding => "application/x-tex"} \nabla F = J
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            is the spacetime vector derivative,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is the Faraday bivector, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            is the spacetime current.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hodge-Maxwell+theorem"} Hodge-Maxwell theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kirchhoff%27s+laws"} Kirchhoff's laws
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+equations"} Yang-Mills equations
          %h2#references References
          %p
            For more see the references at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
          %h3#general General
          %p Maxwell’s equations originate in:
          %ul
            %li#Maxwell1865
              %p
                %a.existingWikiWord{:href => "/nlab/show/James+Clerk+Maxwell"}> James Clerk Maxwell
                ,
                = succeed "," do
                  %em A Dynamical Theory of the Electromagnetic Field
                %strong 155
                (1865) 459-512 &amp;lbrack;
                %a{:href => "https://doi.org/10.1098/rstl.1865.0008"}> doi:10.1098/rstl.1865.0008
                ,
                = succeed "," do
                  %a{:href => "https://www.jstor.org/stable/108892"} jstor:108892
                = succeed "&rbrack;" do
                  %a{:href => "http://en.wikipedia.org/wiki/A_Dynamical_Theory_of_the_Electromagnetic_Field"} Wikipedia entry
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/James+Clerk+Maxwell"}> James Clerk Maxwell
                ,
                = succeed "," do
                  %em A Treatise on Electricity and Magnetism
                = succeed "," do
                  %a{:href => "https://archive.org/details/electricandmagne01maxwrich"} ark:/13960/t9s17v886
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/CBO9780511709333"} doi:10.1017/CBO9780511709333
                = succeed "," do
                  %a{:href => "https://www.aproged.pt/biblioteca/MaxwellI.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://en.wikipedia.org/wiki/A_Treatise_on_Electricity_and_Magnetism"} Wikipedia entry
          %p Some history and reflection:
          %ul
            %li
              %p
                A. C. T. Wu,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Chen+Ning+Yang"} Chen Ning Yang
                = succeed "," do
                  %em Evolution of the concept of vector potential in the description of the fundamental interactions
                %strong 21
                16 (2006) 3235-3277 &amp;lbrack;
                %a{:href => "https://doi.org/10.1142/S0217751X06033143"}> doi:10.1142/S0217751X06033143
                \&amp;rbrack;
            %li#Dyson07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Freeman+J.+Dyson"}> Freeman J. Dyson
                ,
                = succeed "," do
                  %em Why is Maxwell’s Theory so hard to understand?
                %a{:href => "https://ieeexplore.ieee.org/xpl/mostRecentIssue.jsp?punumber=4446147"} The Second European Conference on Antennas and Propagation, EuCAP 2007
                (
                %a{:href => "https://ieeexplore.ieee.org/xpl/mostRecentIssue.jsp?punumber=4446147"}> doi: 10.1049/ic.2007.1146
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chen+Ning+Yang"}> Chen Ning Yang
                ,
                = succeed "," do
                  %em The conceptual origins of Maxwell’s equations and gauge theory
                %strong 67
                11 (2014) &amp;lbrack;
                %a{:href => "https://doi.org/10.1063/PT.3.2585"}> doi:10.1063/PT.3.2585
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://home.ustc.edu.cn/~lxsphys/2021-3-18/The%20conceptual%20origins%20of%20Maxwell%27s%20equations%20and%20gauge%20theory.pdf"} pdf
          %p See also:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Freeman+J.+Dyson"}> Freeman J. Dyson
                \:
                = succeed "," do
                  %em Feynman’s proof of Maxwell’s equations
                %strong 58
                (1990) 209-211 &amp;lbrack;
                %a{:href => "https://physics.csuchico.edu/kagan/435B/problems/FeynmanPaper.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/DysonOnFeynmanOnMaxwell.pdf", :title => "pdf"} pdf
              %blockquote
                %p
                  (recounting an observation by
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Richard+Feynman"} Richard Feynman
              %p
                comment by N. Dombey: Am. J. Phys.
                %strong 59
                1 (1991) 85 &amp;lbrack;
                %a{:href => "https://pubs.aip.org/aapt/ajp/article-abstract/59/1/85/1053837/Comment-on-Feynman-s-proof-of-the-Maxwell?redirectedFrom=fulltext"}> journal
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/DombeyOnDysonOnFeynmanOnMaxwell.jpg", :title => "scan"} scan
              %p
                comment by I. E. Farquhar: Am. J. Phys.
                %strong 59
                1 (1991) 87 &amp;lbrack;
                %a{:href => "https://pubs.aip.org/aapt/ajp/article-abstract/59/1/87/1053797/Comment-on-Feynman-s-proof-of-the-Maxwell?redirectedFrom=fulltext"}> journal
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/FarquharOnDysonOnFeynmanOnMaxwell.jpg", :title => "scan"} scan
          %p
            For Maxwell’s equations in the generality of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dielectric+media"} dielectric media
          %ul
            %li
              %p
                G. Russakoff,
                = succeed "," do
                  %em A Derivation of the Macroscopic Maxwell Equations
                %strong 38
                (1970) 1188–1195 &amp;lbrack;
                %a{:href => "https://doi.org/10.1119/1.1976000"}> doi:10.1119/1.1976000
                \&amp;rbrack;
            %li#deLangeRaab06
              %p
                O. L. de Lange, R. E. Raab
                = succeed "," do
                  %em Surprises in the multipole description of macroscopic electrodynamics
                %strong 74
                (2006) 301–312 &amp;lbrack;
                %a{:href => "https://doi.org/10.1119/1.2151213"}> doi:10.1119/1.2151213
                \&amp;rbrack;
          %p
            On the Maxwell
            %a.existingWikiWord{:href => "/nlab/show/Green%27s+function"} Green's function
            (
            %a.existingWikiWord{:href => "/nlab/show/propagator"}> propagator
            ) and numerical solutions:
          %ul
            %li
              Boris Lo, Victor Minden, Phillip Colella,
              = succeed "," do
                %em A real-space Green’s function method for the numerical solution of Maxwell’s equations
              %strong 11
              2 (2016) 143–170 &amp;lbrack;
              %a{:href => "https://doi.org/10.2140/camcos.2016.11.143"}> doi:10.2140/camcos.2016.11.143
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://msp.org/camcos/2016/11-2/camcos-v11-n2-p01-s.pdf"} pdf
          %div
            %h3#ReferencesForMaxwellEquationsViaDifferentialForms Maxwell’s equations via differential forms
            %p
              On the expression of
              %a.existingWikiWord{:href => "/nlab/show/classical+field+theory"} classical
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Maxwell%27s+equations"} Maxwell's equations
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              and
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operators"} Hodge star operators
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/%C3%89lie+Cartan"}> Élie Cartan
                  , §80 in:
                  = succeed "," do
                    %em Sur les variétés à connexion affine, et la théorie de la relativité généralisée (première partie) (Suite)
                  %strong 41
                  (1924) 1-25 [
                  %a{:href => "http://www.numdam.org/item?id=ASENS_1924_3_41__1_0"}> numdam:ASENS_1924_3_41__1_
                  ]
                %blockquote
                  %p
                    (already in
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/pregeometric+electromagnetism"} pregeometric form
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Charles+Misner"}> Charles Misner
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Kip+Thorne"} Kip Thorne
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/John+Wheeler"} John Wheeler
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Gravitation"} Gravitation
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Theodore+Frankel"}> Theodore Frankel
                  ,
                  = succeed "," do
                    %em Maxwell’s equations
                  %strong 81
                  4 (1974) [
                  %a{:href => "https://doi.org/10.1080/00029890.1974.11993557"}> doi:10.1080/00029890.1974.11993557
                  ,
                  = succeed "," do
                    %a{:href => "https://www.jstor.org/stable/2318995"} jstor:2318995
                  = succeed "]" do
                    %a{:href => "https://doi.org/10.2307/2318995"} doi:10.2307/2318995
              %li#Thirring78
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Walter+Thirring"}> Walter Thirring
                  , vol 2 §1.3 in:
                  %em A Course in Mathematical Physics
                  – 1
                  %em Classical Dynamical Systems
                  and 2
                  = succeed "," do
                    %em Classical Field Theory
                  = succeed "]" do
                    %a{:href => "https://doi.org/10.1007/978-1-4684-0517-0"} doi:10.1007/978-1-4684-0517-0
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Theodore+Frankel"}> Theodore Frankel
                  , §§9-10 in:
                  = succeed "," do
                    %em Gravitational Curvature
                  = succeed "]" do
                    %a{:href => "https://archive.org/details/gravitationalcur0000fran"} ark:13960/t58d7nn19
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Dominic+G.+B.+Edelen"}> Dominic G. B. Edelen
                  , §9.2 in:
                  = succeed "," do
                    %em Applied exterior calculus
                  = succeed "]" do
                    %a{:href => "https://books.google.de/books/about/Applied_Exterior_Calculus.html?id=GUkViODKZ2oC"} GoogleBooks
              %li#Frankel97
