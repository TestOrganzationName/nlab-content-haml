          %h2#idea Idea
          %p
            %em Dependent type theory
            is the flavor of
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            that admits
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/dependent+types"} dependent types
          %p
            Its
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            is in
            %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+categories"} locally cartesian closed categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi X
                  %mo ⊢
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"}
                  x : X \vdash E(x) \; \mathrm{type}
          %p
            is interpreted as a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \to X
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            in the
            %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} C_{/X}
          %p
            Then change of
            %a.existingWikiWord{:href => "/nlab/show/context"} context
            corresponds to
            %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %em
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
            and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
          %p
            Dependent type systems are heavily used for
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/certified+programming"} software certification
          %h2#in_the_foundations_of_mathematics In the foundations of mathematics
          %p
            Dependent type theory itself support various
            %a.existingWikiWord{:href => "/nlab/show/foundations+of+mathematics"} foundations of mathematics
            via the
            %a.existingWikiWord{:href => "/nlab/show/propositions+as+some+types"} propositions as some types
            interpretation of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isProp
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi y
                %annotation{:encoding => "application/x-tex"} \mathrm{isProp}(A) \coloneqq \prod_{x:A} \prod_{y:A} x =_A y
          %p
            Suppose that a dependent type theory has a separate
            %a.existingWikiWord{:href => "/nlab/show/type"} type
            %a.existingWikiWord{:href => "/nlab/show/judgment"} judgment
            as well as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product+types"} dependent product types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+function+extensionality"} weak function extensionality
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/propositional+truncations"} propositional truncations
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/empty+type"} empty type
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sum+types"} sum types
            %a.existingWikiWord{:href => "/nlab/show/predicate+logic"} predicate logic
            are derivable from said type formers:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/universal+quantification"} universal quantification
                is the dependent product type of families of propositions due to weak function extensionality
            %li
              %p
                similarly,
                %a.existingWikiWord{:href => "/nlab/show/implication"} implication
                is the function type of two propositions due to weak function extensionality, and function types are just dependent product types of a constant family of types
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/logical+conjunction"} logical conjunction
                is the product type of two propositions, and product types are just dependent sum types of a constant family of types
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/existential+quantification"} existential quantification
                is the propositional truncation of dependent sum types
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/logical+disjunction"} logical disjunction
                is the propositional truncation of sum types
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/falsehood"} falsehood
                is the empty type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/truth"} truth
                is the unit type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
                and the
                %a.existingWikiWord{:href => "/nlab/show/law+of+double+negation"} law of double negation
                is stated as an
                %a.existingWikiWord{:href => "/nlab/show/inference+rule"} inference rule
                about propositions
          %p Then
          %ul
            %li
              %p
                One can add a
                %a.existingWikiWord{:href => "/nlab/show/cumulative+hierarchy"} cumulative hierarchy
                to the dependent type theory and work entirely in the cumulative hierarchy for
                %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
            %li
              %p
                One can add a
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
                to the dependent type theory and work entirely in the category of sets for
                %a.existingWikiWord{:href => "/nlab/show/structural+set+theory"} structural set theory
            %li
              %p
                One can add a
                %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
                satisfying certain
                %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/axiom+schemata"} axiom schemata
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/universe+extensionality"} universe extensionality
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/propositional+resizing"} propositional resizing
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/axiom+of+replacement"} replacement
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/axiom+of+infinity"} infinity
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} choice
                %a.existingWikiWord{:href => "/nlab/show/univalent+type+theory"} univalent type theory
                or
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/univalent+foundations"} univalent foundations
                %a.existingWikiWord{:href => "/nlab/show/small"} small
                %a.existingWikiWord{:href => "/nlab/show/object+classifiers"} object classifiers
                as well as all
                %a.existingWikiWord{:href => "/nlab/show/higher+inductive+types"} higher inductive
                and
                %a.existingWikiWord{:href => "/nlab/show/coinductive+types"} coinductive types
                to the universe results in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %li
              %p
                One can add a
                %a.existingWikiWord{:href => "/nlab/show/Russell+type+of+all+propositions"} Russell type of all propositions
                and a
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers+type"} natural numbers type
                and work in the dependent type theory itself for
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/higher-order+logic"} higher-order logic
          %h2#description Description
