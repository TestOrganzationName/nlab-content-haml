                          %msub
                            %mi 𝒜
                            %mo •
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mi 𝒢
                            %mo •
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathcal{D}^{cs}
                  \\\
                  \&amp;
                  {}^{\mathllap{ [-]_{{}_{\mathcal{A}}} }}
                  \\swarrow
                  \&amp;&amp;
                  \\searrow^{\mathrlap{ [-]_{\mathcal{G}} }}
                  \\\
                  \\mathcal{A}_\bullet
                  \&amp;&amp;
                  \&amp;&amp;
                  \\mathcal{G}^\bullet
