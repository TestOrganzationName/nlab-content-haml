                  \\;=\;
                  (\mathcal{A}^{-\bullet}, d= 0)
          %p
            as a
            %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
            in non-positive degree with vanishing
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+cochain+complexes"} tensor product of cochain complexes
            with the knot graph complex is the
            %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
            whose closed elements are the graded
            %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒲
                    %mo •
