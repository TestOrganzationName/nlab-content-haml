            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒜
                    %mo •
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi Span
                  %mrow
                    %mo (
                    %msup
                      %mi 𝒟
                      %mi t
                    %mo )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi STU
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Vect
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
