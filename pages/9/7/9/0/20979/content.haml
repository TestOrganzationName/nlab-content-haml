            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mi Grp
                %annotation{:encoding => "application/x-tex"}
                  Aut(\Gamma)
                  \\;\in\;
                  Grp
          %p
            for its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            whose
            %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
            we denote by
          #eq:AutomorphismGroup.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo |
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo |
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mi ℕ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left\vert Aut(\Gamma)\right\vert
                  \\;\in\;
                  \\mathbb{N}
                  \\,.
          %p Write
          #eq:KnotGraphComplex.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
