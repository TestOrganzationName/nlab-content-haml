          %p
            for the framed
            %a.existingWikiWord{:href => "/nlab/show/knot+graph+complex"} knot graph complex
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒢
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 3
                  %mo ⊂
                  %msup
