                  \\;\coloneqq\;
                  Span
                  \\left(
                  \\mathcal{D}^t
                  \\right)/(STU)
                  \\;
                  \\in
                  \\;
                  Vect_\bullet(\mathbb{R})
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            of
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+diagrams"} Jacobi diagrams
            %a.existingWikiWord{:href => "/nlab/show/quotient+vector+space"} modulo
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/STU-relations"} STU-relations
          %p Also write
          #eq:LinearizationMaps.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mi 𝒟
                            %mi cs
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msub
                                  %mo{:stretchy => "false"} ]
                                  %mrow
                                    %msub
                                      %mrow
                                      %mi 𝒜
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %mo{:stretchy => "false"} [
