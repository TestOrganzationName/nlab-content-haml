                %annotation{:encoding => "application/x-tex"} H^\bullet(GraphCplx)
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/knot+graph+complex"} knot graph complex
          #eq:TensorCochainsAsMaps.maruku-equation
            %span.maruku-eq-number (6)
