          %h2#idea Idea
          %p
            %strong Atomic sites
            are
            %a.existingWikiWord{:href => "/nlab/show/sites"} sites
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %msub
                    %mi J
                    %mi at
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{C}, J_{at})
            equipped with the
            %em atomic topology
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi at
                  %annotation{:encoding => "application/x-tex"} J_{at}
            %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %msub
                    %mi J
                    %mi at
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C}, J_{at})
            are precisely the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/atomic+topos"} atomic Grothendieck toposes
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, J_{at})
              is called
              %strong atomic
              if the
              %a.existingWikiWord{:href => "/nlab/show/covering+sieve"} covering
              %a.existingWikiWord{:href => "/nlab/show/sieves"} sieves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi at
                  %annotation{:encoding => "application/x-tex"} J_{at}
              are exactly the
              %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
              sieves
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ≠
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} S\neq\emptyset
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi at
                  %annotation{:encoding => "application/x-tex"} J_{at}
              of this form is called
              = succeed "." do
                %em atomic
          %h2#example Example
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi FinSet
                    %mi mono
                    %mi op
                %annotation{:encoding => "application/x-tex"} FinSet^{op}_{mono}
            be the opposite of the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSet
                    %mi mono
                %annotation{:encoding => "application/x-tex"} FinSet_{mono}
            with objects finite sets and monomorphisms. Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi FinSet
                    %mi mono
                    %mi op
                  %mo ,
                  %msub
                    %mi J
                    %mi at
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (FinSet^{op}_{mono}, J_{at})
            is an atomic site and the corresponding sheaf topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi FinSet
                    %mi mono
                    %mi op
                  %mo ,
                  %msub
                    %mi J
                    %mi at
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(FinSet^{op}_{mono}, J_{at})
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Schanuel+topos"} Schanuel topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mi at
                %annotation{:encoding => "application/x-tex"} J_{at}
            is indeed a
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
            is ensured by prop.
            = succeed "." do
              %a.maruku-ref{:href => "#atomic_ore"}
          %h2#properties Properties
          #atomic_ore.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              can be made into an atomic site if and only if for any diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; &amp; A \\
                    \&amp; &amp; \downarrow\\
                    B &amp; \to &amp; C
                    }
            %p
              there is an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              and arrows
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo →
                    %mi A
                    %mo ,
                    %mi B
                  %annotation{:encoding => "application/x-tex"} D \to A, B
              such that the following diagram commutes:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi D
                          %mtd
                            %mo →
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D &amp; \to &amp; A \\
                    \\downarrow &amp; &amp; \downarrow\\
                    B &amp; \to &amp; C
                    }
          .proof
            %h6#proof Proof
            %p This is exactly what is needed for the pullback stability axiom to hold, and the other axioms are immediate.
          %p
            The condition occurring in the proposition is called the (right)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Ore+condition"} Ore condition
            %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"} P. T. Johnstone
            (1979) that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi 𝒞
                        %mi op
                %annotation{:encoding => "application/x-tex"} Set^{\mathcal{C}^{op}}
            is a
            %a.existingWikiWord{:href => "/nlab/show/De+Morgan+topos"} De Morgan topos
            precisely if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            satisfies the Ore condition. Whence we see that every
            %a.existingWikiWord{:href => "/nlab/show/atomic+topos"} atomic Grothendieck toposes
            is a (
            %a.existingWikiWord{:href => "/nlab/show/Boolean+topos"}> Boolean
            ) subtopos of a De Morgan
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
          %p
            Recall that the
            %a.existingWikiWord{:href => "/nlab/show/dense+topology"} dense topology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mi d
                %annotation{:encoding => "application/x-tex"} J_d
            on a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            consists of all sieves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ∈
                  %msub
                    %mi J
                    %mi d
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S\in J_d(C)
            with the property that given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} f:D\to C
            there exists
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi E
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} g:E\to D
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⋅
                    %mi g
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} f\cdot g\in S
          #atomic_dense.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              satisfying the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Ore+condition"} Ore condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi at
                  %annotation{:encoding => "application/x-tex"} J_{at}
              coincides with the dense topology
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi d
                    %annotation{:encoding => "application/x-tex"} J_d
          .proof
            %h6#proof_2 Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}=\emptyset
              the claim is trivial. So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} C\in\mathcal{C}
              be an object and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              a sieve on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %p
              Assume
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ∈
                      %msub
                        %mi J
                        %mi d
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S\in J_d(C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} id\colon C\to C
              there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi E
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} g:E\to C
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mo ⋅
                    %mi g
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} id\cdot g\in S
              whence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ∈
                      %msub
                        %mi J
                        %mi at
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S\in J_{at}(C)
            %p
              Conversely, assume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S\in J_{at}(C)
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f:D\to C
              be a morphism. Then there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} g\in S
              by assumption and the diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mover
                      %mo →
                      %mi f
                    %mi C
                    %mover
                      %mo ←
                      %mi g
                    %mi E
                  %annotation{:encoding => "application/x-tex"} D\overset{f}{\rightarrow} C \overset{g}{\leftarrow} E
              can be completed to a commutative square
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⋅
                    %mi i
                    %mo =
                    %mi g
                    %mo ⋅
                    %mi h
                  %annotation{:encoding => "application/x-tex"} f\cdot i = g\cdot h
              but
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ⋅
                    %mi h
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} g\cdot h\in S
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} g\in S
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is a sieve. Whence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⋅
                    %mi i
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} f \cdot i\in S
              and, accordingly,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ∈
                      %msub
                        %mi J
                        %mi d
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S\in J_d(C)
          %p
            In other words, the atomic topology is just the
            %a.existingWikiWord{:href => "/nlab/show/dense+topology"} dense topology
            on categories satisfying the Ore condition. Since the corresponding sheaf toposes of the dense topology are just the double negation subtoposes of the corresponding presheaf topos we finally get:
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Atomic Grothendieck toposes i.e. toposes (equivalent to)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C}, J_{at})
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, J_{at})
              an atomic site are precisely (the toposes equivalent to) the
              %a.existingWikiWord{:href => "/nlab/show/double+negation"} double negation subtoposes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo ¬
                        %mo ¬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi 𝒞
                          %mi op
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_{\neg\neg}(Set^{\mathcal{C}^{op}})
              for a De Morgan presheaf topos
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi 𝒞
                            %mi op
                    %annotation{:encoding => "application/x-tex"} Set^{\mathcal{C}^{op}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ▪
                  %annotation{:encoding => "application/x-tex"} \qed
          %p
            The sheaves of atomic sheaf toposes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %msub
                    %mi J
                    %mi at
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C}, J_{at})
            are easy to describe:
          #atomic_sheaf.num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, J_{at})
              be an atomic site. A presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi 𝒞
                          %mi op
                  %annotation{:encoding => "application/x-tex"} P\in Set^{\mathcal{C}^{op}}
              is a sheaf for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi at
                  %annotation{:encoding => "application/x-tex"} J_{at}
              iff for any morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f:D\to C
              and any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y\in P(D)
              , if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(g)(y)=P(h)(y)
              for all diagrams
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %munder
                        %mo ⇉
                        %mi h
                      %mi g
                    %mi D
                    %mover
                      %mo →
                      %mi f
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    E\overset{g}{\underset{h}{\rightrightarrows}} D\overset{f}{\to} C
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⋅
                    %mi g
                    %mo =
                    %mi f
                    %mo ⋅
                    %mi h
                  %annotation{:encoding => "application/x-tex"} f\cdot g=f\cdot h
              , then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo =
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y=P(f)(x)
              for a unique
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x\in P(C)
          %p
            For the proof see Mac Lane-Moerdijk (
            %a{:href => "#MM94"}> 1994
            , pp.126f).
          %h2#the_more_general_definition The more general definition
          %p
            Thus far we have presented the classical approach as presented in Mac Lane-Moerdijk (
            %a{:href => "#MM94"}> 1994
            ) going back to Barr-Diaconescu (
            %a{:href => "#BD80"}> 1980
            ) but it was observed by
            %a.existingWikiWord{:href => "/nlab/show/Olivia+Caramello"} O. Caramello
            (
            %a{:href => "#Ca12"}> 2012
            ) that the atomic topology can in fact be defined on arbitrary categories not only on those satisfying the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Ore+condition"} Ore condition
          .num_defn
            %h6#definition_3 Definition’
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a category. The
              %em atomic topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi at
                  %annotation{:encoding => "application/x-tex"} J_{at}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is the smallest
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
              containing all the nonempty sieves. A site of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, J_{at})
              is called
              = succeed "." do
                %em atomic
          %p
            Note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mi at
                %annotation{:encoding => "application/x-tex"} J_{at}
            is well defined as the intersection of all Grothendieck topologies with the property that all nonempty sieves cover. The following proposition justifies the terminology:
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, J_{at})
              be an atomic site. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C}, J_{at})
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/atomic+topos"} atomic Grothendieck topos
          .proof
            %h6#proof_3 Proof
            %p
              The main idea is to consider the full subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}'
              on those objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ∉
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \emptyset\notin J_{at}(U)
              together with the
              %a.existingWikiWord{:href => "/nlab/show/dense+sub-site"} induced topology
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %msub
                        %mo ′
                        %mi at
                      %mo =
                      %msub
                        %mi J
                        %mi at
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %mi 𝒞
                          %mo ′
                    %annotation{:encoding => "application/x-tex"} J'_{at}=J_{at}|_{\mathcal{C}'}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}'
              satisfies the Ore condition and concludes by the
              %a.existingWikiWord{:href => "/nlab/show/comparison+lemma"} comparison lemma
              that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ′
                      %mo ,
                      %mi J
                      %msub
                        %mo ′
                        %mi at
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %msub
                        %mi J
                        %mi at
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C}', J'_{at})\simeq Sh(\mathcal{C}, J_{at})
              = succeed "," do
                %a{:href => "#Ca12"} 2012
          .num_example
            %h6#example_2 Example
            %p
              Consider the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              on the ‘walking co-span’
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mover
                        %mo →
                        %mi f
                      %mi C
                      %mover
                        %mo ←
                        %mi g
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A\overset{f}{\rightarrow} C\overset{g}{\leftarrow} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              does not satisfy the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Ore+condition"} Ore condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi at
                  %annotation{:encoding => "application/x-tex"} J_{at}
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi id
                      %mi A
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mi ∅
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "2em"}
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi id
                      %mi B
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mi ∅
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    J_{at}(A)=\{\{id_A\},\emptyset\} \qquad J_{at}(B)=\{\{id_B\},\emptyset\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi id
                      %mi C
                    %mo ,
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi g
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mi ∅
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "1em"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    J_{at}(C)=\{\{ id_C, f,g\},\{f \}, \{ g \},\{f,g\},\emptyset\} \quad .
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ∈
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \emptyset\in J_{at}(A)
              , respectively
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                      %mo ∈
                      %msub
                        %mi J
                        %mi at
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \emptyset\in J_{at}(B)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi g
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} f^\ast(\{g\})=\emptyset
              , respectively to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} g^\ast(\{f\})=\emptyset
              \. Whereas
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ∈
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \emptyset\in J_{at}({C})
              by the transitivity axiom applied to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo{:stretchy => "false"} }
                    %mo ∈
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \{f\}\in J_{at}(C)
              and the sieve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \emptyset
              since
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi ∅
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ∅
                      %mo ∈
                      %msub
                        %mi J
                        %mi at
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f^{\ast}(\emptyset)=\emptyset\in J_{at}(A)
            %p
              Accordingly the subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}'
              is empty and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C},J_{at})\simeq 1
              is degenerate. In particular,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi J
                      %mi at
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C},J_{at})
              is not equivalent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %msub
                        %mi J
                        %mi d
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi Sh
                        %mrow
                          %mo ¬
                          %mo ¬
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi 𝒞
                            %mi op
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi Set
                      %mo ×
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C},J_d)\simeq Sh_{\neg\neg}(Set^{\mathcal{C}^{op}})\simeq Set\times Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is distinct from the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dense+topology"} dense topology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi id
                      %mi A
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "2em"}
                    %msub
                      %mi J
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi id
                      %mi B
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    J_{d}(A)=\{\{id_A\}\} \qquad J_{d}(B)=\{\{id_B\}\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi id
                      %mi C
                    %mo ,
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "1em"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    J_{d}(C)=\{\{id_C, f,g\},\{f,g\}\} \quad .
            %p
              Further details on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi 𝒞
                            %mi op
                    %annotation{:encoding => "application/x-tex"} Set^{\mathcal{C}^{op}}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hypergraph"} hypergraph
          %p
            In the example, we observed that dense and the atomic topology need not coincide for categories not satisfying the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Ore+condition"} Ore condition
          .num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi d
                    %mo ⊆
                    %msub
                      %mi J
                      %mi at
                  %annotation{:encoding => "application/x-tex"} J_{d}\subseteq J_{at}
              in general, but
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi d
                    %mo =
                    %msub
                      %mi J
                      %mi at
                  %annotation{:encoding => "application/x-tex"} J_d=J_{at}
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              satisfies the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Ore+condition"} Ore condition
          .proof
            %h6#proof_4 Proof
            %p
              The proof of prop.
              %a.maruku-ref{:href => "#atomic_dense"}
              already showed that the sieves of the dense topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi d
                  %annotation{:encoding => "application/x-tex"} J_d
              are never empty regardless of the Ore condition. From prop.
              %a.maruku-ref{:href => "#atomic_ore"}
              follows that the atomic topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi at
                  %annotation{:encoding => "application/x-tex"} J_{at}
              will additionally contain empty sieves precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              does not satisfy the Ore condition.
          %p
            In particular,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %msub
                    %mi J
                    %mi at
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %msub
                    %mi J
                    %mi d
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Sh
                    %mrow
                      %mo ¬
                      %mo ¬
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi 𝒞
                        %mi op
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C},J_{at})\subseteq Sh(\mathcal{C},J_{d})\simeq Sh_{\neg\neg}(Set^{\mathcal{C}^{op}})
            \.
