                    %mi a
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi i
                  %msup
                    %mi V
                    %mi i
                  %mo +
                  %msub
                    %mi a
                    %mn 0
                  %mo +
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo &gt;
                      %mn 0
                  %msub
                    %mi a
                    %mi i
                  %msup
                    %mi F
                    %mi i
                %annotation{:encoding => "application/x-tex"} \sum_{i\gt 0} a_{-i} V^i + a_0 + \sum_{i\gt 0} a_i F^i
          %p (…)
          %h2#examples Examples
          %ul
            %li
              %p
                For a field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                the terminal
                = succeed "-scheme" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Sp
                        %mi k
                      %mi k
                    %annotation{:encoding => "application/x-tex"} Sp_k k
                is a group scheme in a unique way.
            %li
              %p
                An
                %a.existingWikiWord{:href => "/nlab/show/affine+scheme"} affine
                group scheme. Affine group
                %a.existingWikiWord{:href => "/nlab/show/variety"} varieties
                are called
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/linear+algebraic+group"} linear algebraic groups
            %li
              %p
                Complete group varieties are called
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/abelian+variety"} abelian varieties
            %li
              %p
                Given any group
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %span.newWikiWord
                  constant group scheme
                  %a{:href => "/nlab/new/constant+group+scheme"} ?
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi X
                    %annotation{:encoding => "application/x-tex"} G_X
                over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                %span.newWikiWord
                  etale group scheme
                  %a{:href => "/nlab/new/etale+group+scheme"} ?
                is the spectrum of a commutative
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
                %a.existingWikiWord{:href => "/nlab/show/comultiplication"} comultiplication
                reps.
                %span.newWikiWord
                  antipodism
                  %a{:href => "/nlab/new/antipodism"} ?
                resp.
                %a.existingWikiWord{:href => "/nlab/show/counit"} counit
                in the Hopf algebra.
            %li
              %p
                The functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo :
                      %mo =
                      %msub
                        %mi 𝔾
                        %mi m
                    %annotation{:encoding => "application/x-tex"} \mu:=\mathbb{G}_m
                is a group scheme given by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔾
                          %mi m
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo ,
                        %msub
                          %mi 𝒪
                          %mi S
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo ×
                      %annotation{:encoding => "application/x-tex"} \mathbb{G}_m(S)=\Gamma(S, \mathcal{O}_S)^\times
                = succeed "." do
                  %em the multiplicative group scheme
                %a.existingWikiWord{:href => "/nlab/show/p-divisible+group"} p-divisible groups
                the kernels of the
                = succeed "-group" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔾
                        %mi m
                    %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
                defined by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi n
                      %mo :
                      %mi x
                      %mo ↦
                      %msup
                        %mi x
                        %mi n
                    %annotation{:encoding => "application/x-tex"} (-)^n:x\mapsto x^n
                for an integer
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                are of particular interest. These kernels give the group schemes of the
                = succeed "-th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/root+of+unity"} root of unity
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/diagonalizable+group+scheme"}> diagonalizable group scheme
                \. Note that the multiplicative group scheme is diagonalizable.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/multiplicative+group+scheme"} multiplicative group scheme
                also called
                = succeed "." do
                  %em group scheme of multiplicative type
            %li
              %p
                The
                %em
                  %a.existingWikiWord{:href => "/nlab/show/additive+group"} additive group
                  scheme
                assigns to a ring its additive group. Also here the kernels of the powering-by-n map are of interest. These kernels give the group schemes of the
                = succeed "-th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "." do
                  %span.newWikiWord
                    nilpotent element
                    %a{:href => "/nlab/new/nilpotent+object"} ?
            %li
              %p
                Group schemes can be constructed by
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/restriction+of+scalars"} restriction of scalars
            %li
              %p
                The functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo :
                      %mo =
                      %msub
                        %mi 𝔾
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \alpha:=\mathbb{G}_a
                is a group scheme given by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔾
                        %mi a
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ,
                      %msub
                        %mi 𝒪
                        %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{G}_a(S)=\Gamma(S, \mathcal{O}_S)
                the additive group of the ring of global functions. This group scheme is called
                = succeed "." do
                  %em the additive group scheme
            %li
              %p
                %span.newWikiWord
                  connected group scheme
                  %a{:href => "/nlab/new/connected+group+scheme"} ?
                (is synonymous to
                = succeed ")" do
                  %span.newWikiWord
                    local group scheme
                    %a{:href => "/nlab/new/local+group+scheme"} ?
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/unipotent+group+scheme"} unipotent group scheme
                (these are
                %a.existingWikiWord{:href => "/nlab/show/Cartier+duality"} Cartier duals
                of local group schemes)
            %li
              %p the kernel of any group scheme morphism is a group scheme.
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/algebraic+group"} algebraic group
                is in particular a group scheme.
          %h2#properties Properties
          %h3#cartier_duality Cartier duality
          %p
            (main article:
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Cartier+duality"} Cartier duality
          %p
            Suppose now that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a finite flat commutative group scheme (over
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %strong Cartier dual
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is given by the functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mi D
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ⊗
                    %mi S
                    %mo ,
                    %msub
                      %mi 𝔾
                      %mi m
                    %mo ⊗
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G^D(S)=Hom (G\otimes S, \mathbb{G}_m \otimes S)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            For example,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi α
                      %mi p
                      %mi D
                    %mo ≃
                    %msub
                      %mi α
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \alpha_p^D\simeq \alpha_p
          %h3#dieudonn_module Dieudonné module
          %p
            (main article:
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Dieudonn%C3%A9+module"} Dieudonné module
          %p
            There are certain correspondences (
            %a{:href => "#thmAcu"}> Theorem Acu
            –
            %a{:href => "#thmFftc"}> Theorem Fftc
            ) between certain categories of group schemes and certain categories of Dieudonné modules.
          .num_defn
            %h6#definition_2 Definition
            %p
              A
              %em Dieudonné module
              is a module over the
              %a.existingWikiWord{:href => "/nlab/show/Dieudonn%C3%A9+ring"} Dieudonné ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi k
                  %annotation{:encoding => "application/x-tex"} D_k
              of a field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              of prime
              %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
          .num_defn
            %h6#definition_3 Definition
            %p
              The Dieudonné ring of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is the ring generated by two objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ,
                    %mi V
                  %annotation{:encoding => "application/x-tex"} F,V
              subject to the relations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FV
                    %mo =
                    %mi VF
                    %mo =
                    %mi p
                  %annotation{:encoding => "application/x-tex"} FV=VF=p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fw
                    %mo =
                    %msup
                      %mi w
                      %mi σ
                    %mi F
                  %annotation{:encoding => "application/x-tex"} Fw=w^\sigma F
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mi V
                    %mo =
                    %mi V
                    %msup
                      %mi w
                      %mi σ
                  %annotation{:encoding => "application/x-tex"} w V=V w^\sigma
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo :
                    %mrow
                      %mo {
                      %mrow
                        %mtable{:columnalign => "left left", :displaystyle => "false"}
                          %mtr
                            %mtd
                              %mi W
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo{:stretchy => "false"} )
                              %mo →
                              %mi W
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi w
                                %mn 1
                              %mo ,
                              %msub
                                %mi w
                                %mn 2
                              %mo ,
                              %mi …
                              %mo{:stretchy => "false"} )
                              %mo ↦
                              %mo{:stretchy => "false"} (
                              %msubsup
                                %mi w
                                %mn 1
                                %mi p
                              %mo ,
                              %msubsup
                                %mi w
                                %mn 2
                                %mi p
                              %mo ,
                              %mi …
                              %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma:\begin{cases}
                    W(k)\to W(k)
                    \\\
                    (w_1,w_2,\dots)\mapsto (w_1^p,w_2^p,\dots)
                    \\end{cases}
            %p
              denotes the endomorphism of the
              %a.existingWikiWord{:href => "/nlab/show/Witt+ring"} Witt ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(k)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              given by raising each component of the
              %a.existingWikiWord{:href => "/nlab/show/Witt+vectors"} Witt vectors
              to the
              = succeed "-th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              is component-wise given by the
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+endomorphism"} Frobenius endomorphism
              of the file
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          %p
            The Dieudonné ring is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/graded+ring"} graded ring
            where the degree
            = succeed "-part" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
            %a.existingWikiWord{:href => "/nlab/show/free+object"} free module
            generated by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi n
                %annotation{:encoding => "application/x-tex"} V^{-n}
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo &lt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n\lt 0
            and by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mi n
                %annotation{:encoding => "application/x-tex"} F^n
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n\gt 0
          #thmAcu.num_theorem
            %h6#theorem Theorem
            %p
              (
              %a{:href => "#Demazure"}> III.5
              ,
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Acu
                        %mi k
                      %mo ≃
                      %msub
                        %mi Tor
                        %mi V
                      %msub
                        %mi D
                        %mi kMod
                    %annotation{:encoding => "application/x-tex"} Acu_k\simeq Tor_V D_kMod
            %p
              (see also
              %a.existingWikiWord{:href => "/nlab/show/Dieudonn%C3%A9+module"} Dieudonné module
              for more details concerning this theorem)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be a
              %a.existingWikiWord{:href => "/nlab/show/perfect+field"} perfect field
              of prime characteristic
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is perfect Frobenius is an automorphism.
            %p
              On the left we have the category of
              %a.existingWikiWord{:href => "/nlab/show/affine+scheme"} affine
              commutative
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unipotent+group+scheme"} unipotent group schemes
              %a.existingWikiWord{:href => "/nlab/show/Dieudonn%C3%A9+ring"} D_k
              %a.existingWikiWord{:href => "/nlab/show/Dieudonn%C3%A9+module"} -modules
              of
              = succeed "-torsion." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo :
                    %mrow
                      %mo {
                      %mrow
                        %mtable{:columnalign => "left left", :displaystyle => "false"}
                          %mtr
                            %mtd
                              %msub
                                %mi Acu
                                %mi k
                            %mtd
                              %mo →
                            %mtd
                              %msub
                                %mi Tor
                                %mi V
                              %msub
                                %mi D
                                %mi kMod
                          %mtr
                            %mtd
                              %mi G
                            %mtd
                              %mo ↦
                            %mtd
                              %msub
                                %mi colim
                                %mi n
                              %msub
                                %mi Acu
                                %mi k
                              %mo{:stretchy => "false"} (
                              %mi G
                              %mo ,
                              %msub
                                %mi W
                                %mi nk
                              %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    M:\begin{cases}
                    Acu_k&amp;\to&amp; Tor_V D_kMod
                    \\\
                    G&amp;\mapsto&amp;colim_n Acu_k(G,W_{nk})
                    \\end{cases}
            %p
              where we recall that how the colimit of the hom space can be multiplied by the generators of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Dieudonn%C3%A9+ring"} Dieudonné ring
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              (
              %a{:href => "#Demazure"}> III.6
              ,
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Feu
                        %mi k
                      %mo ≃
                      %msub
                        %mi Tor
                        %mi V
                      %msub
                        %mi D
                        %mi kMod
                    %annotation{:encoding => "application/x-tex"} Feu_k\simeq Tor_V D_kMod
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              (
              %a{:href => "#Demazure"}> III.6
              ,
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Fiu
                        %mi k
                      %mo ≃
                      %msub
                        %mi Tor
                        %mi F
                      %msub
                        %mi D
                        %mi kMod
                    %annotation{:encoding => "application/x-tex"} Fiu_k\simeq Tor_F D_kMod
          .num_theorem
            %h6#theorem_4 Theorem
            %p
              (
              %a{:href => "#Demazure"}> III.8
              ,
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Torf
                        %mi p
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi fin
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mi Mod
                      %mo ,
                      %mi F
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Torf_p\simeq (fin W(k) Mod,F,V)
          #thmFftc.num_theorem
            %h6#theorem_5 Theorem
            %p
              (
              %a{:href => "#Demazure"}> III.9
              ,
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Fftc
                      %mo ≃
                      %msub
                        %mover
                          %mi D
                          %mo{:stretchy => "false"} ^
                        %mi k
                      %msub
                        %mi Mod
                        %mrow
                          %mi fin
                          %mo .
                          %mi len
                          %mo .
                          %mi quot
                    %annotation{:encoding => "application/x-tex"} Fftc\simeq \hat D_k Mod_{fin.len.quot}
