                          %mn 1
                          %mn 12
                      %annotation{:encoding => "application/x-tex"} -\frac{1}{12}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mfrac
                          %mn 1
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} -\frac{1}{2}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mfrac
                          %mrow
                            %msup
                              %mi π
                              %mn 2
                          %mn 6
                      %annotation{:encoding => "application/x-tex"} \frac{\pi^2}{6}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mfrac
                          %mrow
                            %msup
                              %mi π
                              %mn 4
                          %mn 90
                      %annotation{:encoding => "application/x-tex"} \frac{\pi^4}{90}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mfrac
                          %mrow
                            %msup
                              %mi π
                              %mn 6
                          %mn 945
                      %annotation{:encoding => "application/x-tex"} \frac{\pi^6}{945}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mfrac
                          %mrow
                            %msup
                              %mi π
                              %mn 8
                          %mn 9450
                      %annotation{:encoding => "application/x-tex"} \frac{\pi^8}{9450}
          %p
            where for instance the value
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ζ
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mfrac
                    %mn 1
                    %mn 12
                %annotation{:encoding => "application/x-tex"} \zeta(-1) = -\frac{1}{12}
            turns out to be the
            %a{:href => "moduli+stack+of+elliptic+curves#EulerCharacteristic"} Euler characteristic of the moduli stack of complex elliptic curves
            and as such controls much of
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            (notably the critical dimension).
          %h3#periods_and_delignes_conjecture Periods and Deligne’s conjecture
          %p
            More generally, it is known that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            a
            %a.existingWikiWord{:href => "/nlab/show/number+field"} number field
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ζ
                    %mi K
                %annotation{:encoding => "application/x-tex"} \zeta_K
            its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+zeta+function"} Dedekind zeta function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ζ
                    %mi K
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \zeta_K(n)
            for integer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            happen to be
            %a.existingWikiWord{:href => "/nlab/show/periods"} periods
            (
            %a{:href => "http://mathoverflow.net/a/54244/381"}> MO comment
            ).
          %p
            Based on this (
            %a{:href => "#Deligne79"}> Deligne 79
            ) identified
            %em critical values
            of
            = succeed "-functions" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %a.existingWikiWord{:href => "/nlab/show/conjecture"} conjectured
            that these all are algebraic multiples of
            %a.existingWikiWord{:href => "/nlab/show/determinants"} determinants
            of
            %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
            whose entries are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/periods"} periods
            = succeed ")." do
              %a{:href => "#KonsevichZagier"} Konsevich Zagier, section 3
          %p
            Notice that under the
            %a.existingWikiWord{:href => "/nlab/show/function+field+analogy"} function field analogy
            these arithmetic
            = succeed "-functions" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %a.existingWikiWord{:href => "/nlab/show/eta+functions"} eta functions
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/zeta+functions+of+elliptic+differential+operators"} zeta functions of elliptic differential operators
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Dirac+operators"} Dirac operators
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonians"} Hamiltonians
            encode
            %a.existingWikiWord{:href => "/nlab/show/partition+functions"} partition functions
            and
            %a.existingWikiWord{:href => "/nlab/show/path+integrals"} path integrals
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+mechanical+systems"} quantum mechanical systems
            %a.existingWikiWord{:href => "/nlab/show/periods"} periods
            naturally appear as
            %a.existingWikiWord{:href => "/nlab/show/expectation+values"} expectation values
            in
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            (highlighted in
            = succeed ")." do
              %a{:href => "deformation%20quantization#Kontsevich99"} Kontsevich 99
          %h3#regulators_and_beilinsons_conjectures Regulators and Beilinson’s conjectures
          %p
            Another kind of special value is given by the classical
            %a.existingWikiWord{:href => "/nlab/show/class+number+formula"} class number formula
            which says that the
            %a.existingWikiWord{:href => "/nlab/show/residue"} residue
            of the
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+zeta+function"} Dedekind zeta function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ζ
                    %mi K
                %annotation{:encoding => "application/x-tex"} \zeta_K
            of a
            %a.existingWikiWord{:href => "/nlab/show/number+field"} number field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n = 1
            is proportional to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/regulator+of+a+number+field"} regulator of the number field
          %p
            Also the
            %a.existingWikiWord{:href => "/nlab/show/Birch+and+Swinnerton-Dyer+conjecture"} Birch and Swinnerton-Dyer conjecture
            expresses the first non-vanishing
            %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            of the
            = succeed "-series" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} s= 1
            in terms of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/regulator+of+a+number+field"} regulator
          %p
            Motivated by this (
            %a{:href => "#Beilinson85"}> Beilinson 85
            ) generalized both Deligne’s conjecture and the statements about regulators by defining
            %a.existingWikiWord{:href => "/nlab/show/higher+regulators"} higher regulators
            (“Beilinson regulators”) and conjecturing a general statement that expresses special values of
            = succeed "-function" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Beilinson%27s+conjectures"} Beilinson's conjectures
          %h3#periods_and_scholls_conjecture Periods and Scholl’s conjecture
          %p
            However (
            %a{:href => "#Scholl91"}> Scholl 91
            ) observed that also these
            %a.existingWikiWord{:href => "/nlab/show/Beilinson+regulators"} Beilinson regulators
            have an expression in terms of
            %a.existingWikiWord{:href => "/nlab/show/periods"} periods
            and (
            %a{:href => "#KonsevichZagier"}> Konsevich Zagier, section 3.2 and 3.5
            ) advertises the
          %p
            %strong> Deligne-Beilinson-Scholl conjecture
            \:
            %em
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              the order of vanishing of a motivic
              = succeed "-function" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
              of the function at that point is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/period"} period
          %h3#relative_langlands_and_boundary_conditions_in_topological_quantum_field_theory Relative Langlands and boundary conditions in topological quantum field theory
          %p
            Ongoing by work by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"} David Ben-Zvi
            = succeed "," do
              %span.newWikiWord
                Yiannis Sakellaridis
                %a{:href => "/nlab/new/Yiannis+Sakellaridis"} ?
            %a.existingWikiWord{:href => "/nlab/show/Akshay+Venkatesh"} Akshay Venkatesh
            relate special values of L-functions and periods to boundary conditions in a
            %a.existingWikiWord{:href => "/nlab/show/topological+quantum+field+theory"} topological quantum field theory
            approach to the
            %a.existingWikiWord{:href => "/nlab/show/Langlands+program"} Langlands program
            (see
            = succeed ")." do
              %a{:href => "#BenZvi"} BenZvi
