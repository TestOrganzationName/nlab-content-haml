                      %mi ℚ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ch^k_A(X)
                    \\;=\;
                    \\big(
                    (-)\otimes_{{}_{\mathbb{Q}}} k
                    \\big)
                    \\,\circ\,
                    ch^{\mathbb{Q}}_A(X)
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              Consider the following
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of
              %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              (shown for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} k = \mathbb{R}
            %div{:style => "margin: -40px 0px 20px 10px"}
              %figure{:style => "margin: 0 0 0 0"}
                %img{:src => "/nlab/files/RationalAndRealCharacterMap20210708.jpg", :width => "740px"}/
                %figcaption{:style => "text-align: center"}
                  (diagram from
                  = succeed ")" do
                    %a{:href => "#FSS20"} FSS 20
            %p Here:
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commutativity
                  of the bottom part is Prop.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#DerivedPLdeRhamFunctorsRelatedByChangeOfScalars"}
              %li
                %p
                  the triangle on the left as well as as the outer diagram
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commute
                  by basic properties of
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
                  (
                  %a{:href => "geometry+of+physics+--+categories+and+toposes#ReExpressingMiddleFunctorInAdjointTriple"}> this Lemma
                  );
              %li
                %p
                  the square on the right commutes by definition
                  = succeed ";" do
                    %a.maruku-eqref{:href => "#eq:ExtensionOfScalarsOnChomolology"} (5)
            %p Together this implies that the top rectangle commutes, which is the claim to be shown.
