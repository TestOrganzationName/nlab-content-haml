          %h2#preliminaries Preliminaries
          #NilpotententFiniteRationalHomotopyTypes.num_defn
            %h6#definition Definition
            %p
              %strong (nilpotent and finite rational homotopy types)
            %p Write
            #eq:NilpotentQFiniteHomotopyTypes.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi SimplicialSets
                      %mi Qu
                    %msubsup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mo ≥
                        %mn 1
                        %mo ,
                        %mi nil
                      %mrow
                        %msub
                          %mi fin
                          %mi ℚ
                    %mover
                      %mo ↪
                      %mphantom
                        %mi AAA
                    %mi Ho
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi SimplicialSets
                      %mi Qu
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ho
                    \\big(
                    SimplicialSets_{Qu}
                    \\big)^{fin_{\mathbb{Q}}}_{\geq 1, nil}
                    \\overset{
                    \\phantom{AAA}
                    }{\hookrightarrow}
                    Ho
                    \\big(
                    SimplicialSets_{Qu}
                    \\big)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
              (
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
              %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which are
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"}> connected
                  \:
                  = succeed ";" do
