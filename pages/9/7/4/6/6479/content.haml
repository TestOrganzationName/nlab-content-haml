                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mi y
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} cl(\{x\}) = cl(\{y\})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ′
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} X'/\sim
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi cl
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} [
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi b
                    %mo ∈
                    %mi cl
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \widehat{cl}(A) \coloneqq \{[b]: b \in cl(A)\}
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi b
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [b]
              denotes the equivalence class of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
          %h3#minimal_and_strongly_minimal_sets Minimal and strongly minimal sets
          %p
            We’ll suppose for now that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                %annotation{:encoding => "application/x-tex"} \mathbf{L}
            is a countable
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/signature+%28in+logic%29"} signature
            %a.existingWikiWord{:href => "/nlab/show/first-order+language"} language
            it generates consists of countably many formulas. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi M
                %annotation{:encoding => "application/x-tex"} \mathbf{M}
            be an
            = succeed "-structure," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          .num_defn
            %h6#definition_3 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊆
                      %mi M
                    %annotation{:encoding => "application/x-tex"} A \subseteq M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} b \in M
              is
              %strong algebraic
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              if there is a formula
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %msub
                      %mi w
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi w
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi(y, w_1, \ldots, w_n)
              and elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a_1, \ldots, a_n \in A
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                    %mo ⊧
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{M} \models \phi(b, a_1, \ldots, a_n)
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi c
                    %mo ∈
                    %mi M
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                    %mo ⊧
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{c \in M: \mathbf{M} \models \phi(c, a_1, \ldots, a_n)\}
            %p
              is finite. The
              %strong algebraic closure
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi acl
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} acl(A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              that are algebraic over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          #finclos.num_prop
            %h6#proposition Proposition
            %p
              The algebraic closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %mi acl
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \mapsto acl(A)
              defines a finitary closure operator on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
          .proof
            %h6#proof Proof
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi acl
                  %annotation{:encoding => "application/x-tex"} acl
              is monotone (preserves order) is obvious. Also the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi acl
                  %annotation{:encoding => "application/x-tex"} acl
              is finitary is easy: given that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi acl
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in acl(A)
              satisfies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                    %mo ⊧
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{M} \models \phi(b, a_1, \ldots, a_n)
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi a
                        %mi n
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a_1, \ldots, a_n \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi acl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in acl(A_0)
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 0
                      %mo =
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi a
                        %mi n
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} A_0 = \{a_1, \ldots, a_n\}
            %p
              Taking
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi(y, w)
              to be the equality predicate
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo =
                      %mi w
                    %annotation{:encoding => "application/x-tex"} y = w
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊆
                      %mi acl
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \subseteq acl(A)
            %p
              For idempotence of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi acl
                    %annotation{:encoding => "application/x-tex"} acl
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi b
                      %mi k
                    %mo ∈
                    %mi acl
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b_1, \ldots, b_k \in acl(A)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                    %mo ⊧
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi b
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{M} \models \psi(c, b_1, \ldots, b_k)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo ∈
                    %mi M
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                    %mo ⊧
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi b
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{y \in M: \mathbf{M} \models \psi(y, b_1, \ldots, b_k)\}
              has exactly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              elements. Write down a formula
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mrow
                        %mi m
                        %mo ,
                        %mi ψ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_{m, \psi}(x_1, \ldots, x_k)
              that says
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo ∈
                    %mi M
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                    %mo ⊧
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{y \in M: \mathbf{M} \models \psi(y, x_1, \ldots, x_k)\}
              has at most
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              elements (by adding some extra inequalities, we can make this “exactly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              elements”):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mrow
                        %mi m
                        %mo ,
                        %mi ψ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mo ∃
                      %mrow
                        %msub
                          %mi y
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi y
                          %mi m
                    %msub
                      %mo ∀
                      %mi y
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo =
                    %msub
                      %mi y
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∨
                    %mi …
                    %mo ∨
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo =
                    %msub
                      %mi y
                      %mi m
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} F_{m, \psi}(x_1, \ldots, x_k) \coloneqq \exists_{y_1, \ldots, y_m} \forall_y \psi(y, x_1, \ldots, x_k) \Leftrightarrow (y = y_1) \vee \ldots \vee (y = y_m).
            %p
              Now for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %mi k
                    %annotation{:encoding => "application/x-tex"} i = 1, \ldots, k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \phi_i
              be a formula witnessing
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mi i
                      %mo ∈
                      %mi acl
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b_i \in acl(A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                    %mo ⊧
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mi i
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %msub
                          %mi n
                          %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{M} \models \phi_i(b_i, a_{i, 1}, \ldots, a_{i, n_i})
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mi k
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a_{i, k} \in A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %mi M
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                    %mo ⊧
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %msub
                          %mi n
                          %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{x \in M: \mathbf{M} \models \phi_i(x, a_{i, 1}, \ldots, a_{i, n_i})\}
              has finitely many elements. Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mrow
                        %msub
                          %mi x
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi x
                          %mi k
                    %msub
                      %mi F
                      %mrow
                        %mi m
                        %mo ,
                        %mi ψ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi k
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %msub
                          %mi n
                          %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exists_{x_1, \ldots, x_k} F_{m, \psi}(x_1, \ldots, x_k) \wedge \psi(y, x_1, \ldots, x_k) \wedge \bigwedge_{i=1}^k \phi_i(x_i, a_{i, 1}, \ldots, a_{i, n_i})
            %p
              is a formula with parameters in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              that witnesses
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi acl
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
