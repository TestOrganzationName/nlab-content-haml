              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi acl
                    %annotation{:encoding => "application/x-tex"} acl
          %p
            As before, this notion of algebraic closure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi acl
                  %mo :
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} acl: P(M) \to P(M)
            can be restricted to a closure operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi acl
                    %mi X
                  %mo :
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} acl^X: P(X) \to P(X)
            for a subset
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
