                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} B_i \coloneqq \{u \in X: \mathbf{M} \models \phi(a_i, u) \wedge \psi(u)\}
            %p
