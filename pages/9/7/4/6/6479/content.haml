                    %annotation{:encoding => "application/x-tex"} \mathbf{T}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              (definable by the formula
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x = x
          .num_example
            %h6#examples_2 Examples
            %ol
              %li
                %p
                  Let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                  be an algebraically closed field. (Elimination of quantifiers, Chevalley’s theorem, etc.) Conclusion: ACF is a strongly minimal theory.
              %li
                %p Divisible torsionfree abelian groups.
              %li
                %p Non-example of dense linear orders.
          .num_theorem
            %h6#theorem Theorem
            %p
              %strong (Baldwin, Lachlan)
              The algebraic closure operator on a minimal set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a pregeometry.
          .proof
            %h6#proof_2 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \subseteq X
              and suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi acl
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi acl
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \in acl(A \cup \{b\}) - acl(A)
              for
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ,
                      %mi c
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} b, c \in X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi acl
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mi c
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in acl(A \cup \{c\})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi(c, b)
              is a formula with parameters from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                    %mo ⊧
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{M} \models \phi(c, b)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi card
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ∈
                      %mi X
                      %mo :
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                      %mo ⊧
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi n
                    %annotation{:encoding => "application/x-tex"} card(\{x \in X: \mathbf{M} \models \phi(x, b)\}) = n
              = succeed "," do
                %a.maruku-ref{:href => "#finclos"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \psi(w)
              be a formula that says
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi card
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ∈
                      %mi X
                      %mo :
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                      %mo ⊧
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi w
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi n
                    %annotation{:encoding => "application/x-tex"} card(\{x \in X: \mathbf{M} \models \phi(x, w)\}) = n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \psi(b)
              is satisfied in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} \mathbf{M}
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo ∈
                    %mi X
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                    %mo ⊧
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{y \in X: \mathbf{M} \models \phi(c, y) \wedge \psi(y)\}
              is finite, then since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              belongs to this set,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi(c, y) \wedge \psi(y)
              would witness
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi acl
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mi c
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in acl(A \cup \{c\})
              and we would be done. So suppose otherwise. Then this set is cofinite in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi card
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo ∈
                    %mi X
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                    %mo ⊧
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi m
                  %annotation{:encoding => "application/x-tex"} card(X - \{y \in X: \mathbf{M} \models \phi(c, y) \wedge \psi(y)\}) = m
            %p
              for some finite
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi(x)
              with parameters from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              that says
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi card
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo ∈
                    %mi X
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                    %mo ⊧
                    %mi ϕ
