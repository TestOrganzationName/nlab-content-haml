            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi acl
                %annotation{:encoding => "application/x-tex"} acl
            instead of
            = succeed "," do
