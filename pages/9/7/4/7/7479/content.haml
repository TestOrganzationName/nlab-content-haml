                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo →
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \Delta[1] := \mathbf{2} = \{0 \to 1\}
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              over the
              %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sierp
                  %annotation{:encoding => "application/x-tex"} Sierp
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Sierp
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi Set
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sh(Sierp) \simeq PSh(\Delta[1]) \simeq Set^{\Delta[1]}
                    \\,.
            %p
              Yet another description is that it is the
              %a.existingWikiWord{:href => "/nlab/show/Freyd+cover"} Freyd cover
              of
              = succeed "." do
                %strong Set
          .num_defn
            %h6#definition_3 Definition
            %p
              Similarly, the
              %strong
                Sierpinski
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              is the
              %a.existingWikiWord{:href => "/nlab/show/arrow+%28%E2%88%9E%2C1%29-category"} arrow (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %msup
                      %mi Grpd
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \infty Grpd^{\Delta[1]}
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %p
              Equivalently this is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[1]
              and equivalently the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
              on
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sierp
                    %annotation{:encoding => "application/x-tex"} Sierp
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Sierp
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi PSh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn ∞
                    %msup
                      %mi Grpd
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sh_{(\infty,1)}(Sierp)
                    \\simeq
                    PSh_{(\infty,1)}(\Delta[1])
                    \\simeq
                    \\infty Grpd^{\Delta[1]}
                    \\,.
          %h2#properties Properties
          %h3#presentation_and_homotopy_type_theory Presentation and Homotopy type theory
          %p
            Being a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            is
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
            by any of the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Delta[1], sSet]
          %p
            Specifically the
            %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
            of
            %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
            on the
            %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi Reedy
                %annotation{:encoding => "application/x-tex"} [\Delta[1], sSet]_{Reedy}
            provides a
            %a.existingWikiWord{:href => "/nlab/show/univalence"} univalent
            model for
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            in the Sierpinski
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed ")" do
              %a{:href => "#Shulman"} Shulman
          %h3#Cohesion Connectedness, locality, cohesion
          %p
            We discuss the connectedness, locality and cohesion of the Sierpinski topos. We do so relative to an arbitrary
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/base+topos"} base topos
            %a.existingWikiWord{:href => "/nlab/show/base+%28%E2%88%9E%2C1%29-topos"} base (∞,1)-topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/global+section+geometric+morphism"} global section geometric morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi I
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}^I \to \mathbf{H}
                  \\,.
          .num_prop
            %h6#proposition Proposition
            %p
              The Sierpinski topos is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"}> cohesive topos
                \.
            %p
              The Sierpinski
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo ⊣
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Disc
                    %mo ⊣
                    %mi Γ
                    %mo ⊣
                    %mi coDisc
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi I
                    %mover
                      %mover
                        %mover
                          %munder
                            %mo ←
                            %mi coDisc
                          %mover
                            %mo →
                            %mi Γ
                        %mover
                          %mo ←
                          %mi Disc
                      %mover
                        %mo →
                        %mi Π
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi \dashv \Disc \dashv \Gamma \dashv coDisc)
                    \:
                    \\mathbf{H}^I
                    \\stackrel{\overset{\Pi}{\to}}{\stackrel{\overset{Disc}{\leftarrow}}{\stackrel{\overset{\Gamma}{\to}}{\underset{coDisc}{\leftarrow}}}}
                    \\mathbf{H}
                    \\,.
          .proof
            %h6#proof Proof
            %p
              For the first statement, see the detailed discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
              = succeed "." do
                %em
                  %a{:href => "cohesive+topos#FamiliesOfSets"} here
            %p
              For the second statement, see the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              = succeed "." do
                %em
                  %a{:href => "cohesive+%28infinity%2C1%29-topos#CohesiveDiagramToposes"} here
          .num_remark
            %h6#remark Remark
            %p
              The fact that the Sierpienski
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            %ol
              %li
                %p
                  a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected (∞,1)-topos
              %li
                %p
                  an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} ∞-connected (∞,1)-topos
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/local+%28%E2%88%9E%2C1%29-topos"} local (∞,1)-topos
            %p
              all follow directly from the fact that it is the image, under
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/localic+reflection"} localic reflection
              %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
              (hence that it is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/n-localic+%28%E2%88%9E%2C1%29-topos"} 0-localic
              %a.existingWikiWord{:href => "/nlab/show/n-truncated"} (-1)-truncation
              being the
              %a.existingWikiWord{:href => "/nlab/show/frame"} frame
              of opens of the Sierpinski space).
            %p
              That space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sierp
                    %annotation{:encoding => "application/x-tex"} Sierp
            %ol
              %li
                %p
                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/contractible+topological+space"} contractible topological space
              %li
                %p
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/locally+contractible+topological+space"} locally contractible topological space
              %li
                %p
                  has a
                  %a.existingWikiWord{:href => "/nlab/show/focal+point"} focal point
            %p
              which implies the corresponding three properties of the Sierpinski
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          .num_remark
            %h6#remark_2 Remark
            %p
              By the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              every such may be thought of as a
              = succeed "," do
                %em fat point
              = succeed "." do
                %em cohesive blob
              %em is
              the Sierpinski space. This space can be thought of as being the abstract “point with open neighbourhood”.
          .num_remark
            %h6#remark_3 Remark
            %p
              Accordingly, the objects of the Sierpinski
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
              (relative to
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesion
              modeled on this: they are
              %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi P
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [P \to X]
              of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
              whose
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              are regarded as being
              = succeed "," do
                %a{:href => "cohesive+%28infinity%2C1%29-topos+--+structures#Homotopy"} geometrically contractible
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi P
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi([P \to X]) \simeq X
            %p and so in particular
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi Q
                    %mo →
                    %mo *
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi([Q \to *]) \simeq *
                    \\,.
            %p
              Hence these objects are
              %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoids"} discrete ∞-groupoids
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x : * \to X
              may be attached a contractible cohesive blob with inner structure given by the
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mi x
                      %mo :
                      %mo =
                      %mi P
                      %msub
                        %mo ×
                        %mi X
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} P_x := P \times_X \{x\}
            %p
              Accordingly, the
              %em underlying
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi P
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [P \to X]
              is the union
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi P
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi P
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma([P \to X]) \simeq P
            %p of the discrete base space and the inner structure of the fibers.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/discrete+object"} discrete object
              in the Sierpinski
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              is the bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mover
                      %mo →
                      %mi id
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    Disc(X) \simeq [X \stackrel{id}{\to} X]
            %p
              which is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with “no cohesive blobs attached”.
            %p
              Finally the
              %a.existingWikiWord{:href => "/nlab/show/codiscrete+object"} codiscrete object
              in the Sierpinski
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo →
                    %mo *
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    coDisc(X) \simeq [X \to *]
                    \\,,
            %p
              the structure where all of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is regarded as one single contractible cohesive ball.
            %p
              The
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Π
                      %mo ⊣
                      %mi Disc
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Pi \dashv Disc)
              %a.existingWikiWord{:href => "/nlab/show/unit"} adjunction unit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi id
                    %mo →
                    %mi Disc
                    %mi Π
                  %annotation{:encoding => "application/x-tex"}
                    i :  id \to Disc \Pi
            %p
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi P
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [P \to X]
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mo{:stretchy => "false"} [
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                            %mpadded{:width => "0"}
                              %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mo{:stretchy => "false"} [
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                            %mpadded{:width => "0"}
                              %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathllap{[}P &amp;\to&amp; X\mathrlap{]}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathllap{[}X &amp;\to&amp; X\mathrlap{]}
                    }
                    \\,.
            %p
              The
              = succeed "-counit" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Disc
                      %mo ⊣
                      %mi Γ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Disc  \dashv \Gamma)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mi Γ
                    %mo →
                    %mi id
                  %annotation{:encoding => "application/x-tex"} Disc \Gamma  \to id
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi P
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [P \to X]
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mo{:stretchy => "false"} [
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mi P
                            %mpadded{:width => "0"}
                              %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mo{:stretchy => "false"} [
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                            %mpadded{:width => "0"}
                              %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathllap{[}P &amp;\to&amp; P\mathrlap{]}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathllap{[}P &amp;\to&amp; X\mathrlap{]}
                    }
                    \\,.
            %p
              Hence the canonical
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Γ
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mi Π
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi Γ
                                  %mo{:stretchy => "false"} (
                                  %mi i
                                  %mo{:stretchy => "false"} )
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Γ
                            %mi Disc
                            %mi Π
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma &amp;&amp; \to &amp;&amp; \Pi
                    \\\
                    \&amp; {}_{\mathllap{\Gamma(i)}}\searrow &amp; &amp; \nearrow_{\mathrlap{\simeq}}
                    \\\
                    \&amp;&amp; \Gamma Disc \Pi
                    }
            %p
              from “points to pieces” is on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi P
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [P \to X]
              simply the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              itself
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo →
                    %mi Π
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi P
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Gamma \to \Pi)([P \to X]) = (P \to X)
                    \\,.
            %p Therefore
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
                  on those objects in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mi I
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}^I
                  for which “
                  %a{:href => "cohesive%20%28infinity,1%29-topos#PiecesHavePoints"}> pieces have points
                  ”, hence those for which
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                        %mo →
                        %mi Π
                      %annotation{:encoding => "application/x-tex"} \Gamma \to \Pi
                  is an
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28%E2%88%9E%2C1%29-category"} effective epimorphism
                  = succeed "-category" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
                  = succeed "-topos," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
                  = succeed "-category" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
                  %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid objects
                  in the ambient
                  = succeed "-topos;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
              %li
                %p
                  the full sub-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
                  \-category on the objects with “
                  %a{:href => "cohesive+topos#ObjectsWithOnePointPerCohesivePiece"}> one point per piece
                  ” is the ambient
                  = succeed "-topos" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
          %h3#cohesive_structures Cohesive structures
          %p
            We unwind what some of the canonical
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos+--+structures"} structures in a cohesive (∞,1)-topos
            are when realized in the Sierpinski
            = succeed "-topos." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            A group object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} [
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbf{B}[\hat G \to G]
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi I
                %annotation{:encoding => "application/x-tex"} \mathbf{H}^I
            is a morphism in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            of the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} = \mathbf{B}\hat G \to \mathbf{B}G
          %p
            The corresponding flat coefficient object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mo ♭
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} [
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} [
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbf{\flat} \mathbf{B}[\hat G \to G] \to \mathbf{B}[\hat G \to G]
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mover
                            %mi G
                            %mo{:stretchy => "false"} ^
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{\hat G} &amp;\to&amp; \mathbf{B} \hat G
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\mathbf{\hat G} &amp;\to&amp; \mathbf{G}
                  }
                  \\,.
          %p Hence the corresponding de Rham coefficient object is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} [
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mo *
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{\flat}_{dR} \mathbf{B}[\hat G \to G]
                  \=
                  [* \to \mathbf{B}A]
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} A \to \hat G \to G
            exhibits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat G
            has an
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p The corresponding Maurer-Cartan form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} [
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  [\hat G \to G] \to \mathbf{\flat}_{dR}\mathbf{B}[\hat G \to G]
          %p is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mi G
                            %mo{:stretchy => "false"} ^
                        %mtd
                          %mo →
                        %mtd
                          %mi G
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\hat G &amp;\to&amp; G
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  * &amp;\to&amp; \mathbf{B}A
                  }
          %p
            exhibiting the
            = succeed "-cocycle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \hat G \to G
          %h3#DifferentialCohesion Differential cohesion
          %p
            The leftmost adjoint,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
            %a{:href => "#Cohesion"} above
            itself possesses a left adjoint,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↦
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X \mapsto [0 \to X]
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}^{\Delta[1]}
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            to the
            %a.existingWikiWord{:href => "/nlab/show/base+topos"} base topos
            is the
            %a.existingWikiWord{:href => "/nlab/show/domain+cofibration"} domain cofibration
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mover
                    %munder
                      %mo →
                      %mi dom
                    %mover
                      %mo ↩
                      %mi const
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}^{\Delta[1]}
                  \\stackrel{\overset{const}{\hookleftarrow}}{\underset{dom}{\to}}
                  \\mathbf{H}
                  \\,.
          %p
            Conversely, we may think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbf{H}^{\Delta[1]}
            as being an “infinitesimal thickening” of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi i
                    %mo !
                  %mo ⊣
                  %msup
                    %mi i
                    %mo *
                  %mo ⊣
                  %msub
                    %mi i
                    %mo *
                  %mo ⊣
                  %msup
                    %mi i
                    %mo !
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mover
                    %mover
                      %mover
                        %munder
                          %mo ←
                          %mrow
                            %msup
                              %mo ⊥
                              %mo *
                        %mover
                          %mo ↪
                          %mi const
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mo ⊤
                            %mo *
                    %mover
                      %mo ↪
                      %mrow
                        %msub
                          %mo ⊤
                          %mo !
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  (i_! \dashv i^* \dashv i_* \dashv i^!)
                  \:
                  \\mathbf{H}
                  \\stackrel{\overset{\top_!}{\hookrightarrow}}{\stackrel{\overset{\top^*}{\leftarrow}}{\stackrel{\overset{const}{\hookrightarrow}}{\underset{\bot^*}{\leftarrow}}}}
                  \\mathbf{H}^{\Delta[1]}
          %p
            as exhibiting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbf{H}^{\Delta[1]}
            as an infinitesimal cohesive neighbourhood of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            (here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ⊥
                  %mo ,
                  %mo ⊤
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo{:stretchy => "false"} ]
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} (\bot, \top) : \Delta[0] \coprod \Delta[0] \to \Delta[1]
            denotes the endpoint inclusions, following the notation
            = succeed ")." do
              %a{:href => "http://ncatlab.org/nlab/show/cohesive+%28infinity,1%29-topos#CohesiveDiagramToposes"} here
          %p
            (See also the corresponding examples at
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Q-category"} Q-category
          #iInclusion.num_prop
            %h6#observation Observation
            %p
              We have for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo !
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi ∅
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i_!(X) \simeq [\emptyset \to X]
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [A \to B]
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}^{\Delta[1]}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi cod
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}(X, i^*[A \to B])
                    \\simeq
                    \\mathbf{H}(X, cod(A \to B))
                    \\simeq
                    \\mathbf{H}(X, B)
                    \\,,
            %p which is indeed naturally equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi ∅
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}^{\Delta[1]}([\emptyset \to X], [A \to B])
                    \\,.
          %p
            Therefore an object of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbf{H}^{\Delta[1]}
            given by a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi P
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [P \to X]
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            is regarded by the differential cohesion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ↪
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} i : \mathbf{H} \hookrightarrow \mathbf{H}^{\Delta[1]}
            as being an infinitesimal thickening of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            by the fibers of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            are “contractible cohesive thickenings” of the discrete object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is “discrete relative to
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p This is of course a very crude notion of infinitesimal extension. Notice for instance the following
          .num_prop
            %h6#proposition_2 Proposition
            %p
              With respect to the above differential cohesion
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo ↪
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} i : \mathbf{H} \hookrightarrow \mathbf{H}^{\Delta[1]}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphism"} formally étale morphism
          .proof
            %h6#proof_3 Proof
            %p
              By definition, given a morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f : X \to Y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi i
                              %mo !
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi i
                                  %mo !
                                %mi f
                          %mtd
                            %msub
                              %mi i
                              %mo !
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi i
                              %mo *
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi i
                                  %mo *
                          %mtd
                            %msub
                              %mi i
                              %mo *
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    i_! X &amp;\stackrel{i_! f}{\to}&amp; i_! Y
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    i_* X &amp;\stackrel{i_*}{\to}&amp; i_* Y
                    }
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            %p
              By prop.
              %a.maruku-ref{:href => "#iInclusion"}
              the above square diagram in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}^{\Delta[1]}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi ∅
                            %mo →
                            %mi X
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi ∅
                            %mo →
                            %mi Y
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mover
                              %mo →
                              %mi id
                            %mi X
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi Y
                            %mover
                              %mo →
                              %mi id
                            %mi Y
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [\emptyset \to X] &amp;\to&amp; [\emptyset \to Y]
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    [X \stackrel{id}{\to} X]
                    \&amp;\to&amp;
                    [Y \stackrel{id}{\to} Y]
                    }
                    \\,.
            %p
              Since
              = succeed "-pullbacks" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "-presheaves" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "-pullback" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}^{\Delta[1]}
              precisely if the “back and front sides”
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ∅
                          %mtd
                            %mo →
                          %mtd
                            %mi ∅
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\emptyset &amp;\to&amp; \emptyset
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\stackrel{f}{\to}&amp; Y
                    }
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi{:mathvariant => "normal"} id
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi{:mathvariant => "normal"} id
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\stackrel{f}{\to}&amp; Y
                    \\\
                    \\downarrow^{\mathrm{id}} &amp;&amp; \downarrow^{\mathrm{id}}
                    \\\
                    X &amp;\stackrel{f}{\to}&amp; Y
                    }
            %p
              are
              = succeed "-pullbacks" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %p
              The adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo !
                    %mo ∘
                    %msup
                      %mi i
                      %mo *
                    %mo ⊢
                    %msub
                      %mi i
                      %mo *
                    %mo ∘
                    %msup
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i_{!} \circ i^{\ast} \vdash i_{\ast} \circ i^{\ast}
              forms the
              %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ⊢
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \emptyset \vdash \ast
              for the Sierpinski topos.
          %h3#AsAClassifyingTopos As a classifying topos
          %p
            The Sierpinski topos is the
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            for
            %a.existingWikiWord{:href => "/nlab/show/subterminal+objects"} subterminal objects
            in
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            (see e.g.
            = succeed ")." do
              %a{:href => "#Johnstone77"} Johnstone 77, p. 117
          %p
            The generic subterminal inclusion in the Sierpinski topos is the unique inclusion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi ∅
                  %mo →
                  %mo *
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\emptyset \to \ast]
            into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo *
                    %mo →
                    %mo *
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\ast  \to \ast]
          %p The (non-full) inclusion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mn 1
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo *
                  %mo →
                  %msup
                    %mi S
                    %mn 0
                  %mo{:stretchy => "false"} }
                  %mo ⟶
                  %msup
                    %mi FinSet
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mo ↪
                  %mn ∞
                  %msubsup
                    %mi Grpd
                    %mi fin
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"}
                  \\Delta^1 = \{\ast \to S^0\} \longrightarrow FinSet^{\ast/} \hookrightarrow \infty Grpd_{fin}^{\ast/}
          %p
            induces via restriction and right
            %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            an
            %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                  %mover
                    %mo ↪
                    %mo ⟵
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mo *
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}^{\Delta^1} \stackrel{\longleftarrow}{\hookrightarrow}
                  \\mathbf{H}[X_\ast]
          %p
            of the Sierpinski topos into the
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mo *
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}[X_\ast]
            %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            if we refined the Sierpinski topos of bundles to the topos of bundles with sections).
          %p
            The pointed object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{H}^{\Delta^1}
            which is classified by this
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo *
                  %mo →
                  %msup
                    %mi S
                    %mn 0
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\ast \to S^0]
            (with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 0
                  %mo =
                  %mo *
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %mo *
                %annotation{:encoding => "application/x-tex"} S^0 = \ast \coprod \ast
            the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo *
                    %mo →
                    %mo *
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\ast \to \ast]
          %p In summary, the generic subterminal object and the generic pointed object fit into a sequence of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ∅
                        %mtd
                          %mo ↪
                        %mtd
                          %mo *
                        %mtd
                          %mo ⟶
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo ⟶
                        %mtd
                          %mo *
                        %mtd
                          %mo ⟶
                        %mtd
                          %msup
                            %mi S
                            %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\emptyset &amp;\hookrightarrow&amp; \ast &amp;\longrightarrow&amp; \ast
                  \\\
                  \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                  \\\
                  \\ast &amp;\longrightarrow&amp; \ast &amp;\longrightarrow&amp; S^0
                  }
          %h3#cohomology Cohomology
          %p
            According to the general idea of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi A
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X, A \in \mathbf{H}
            two
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are the connected components
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H(X,A) := \pi_0 \mathbf{H}(X,A)
                  \\,.
          %p
            Cohomology in the Sierpinski
            = succeed "-topos," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty, 1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}^{I}
            %a.existingWikiWord{:href => "/nlab/show/relative+cohomology"} relative cohomology
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p
            Indeed, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} i : Y \to X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi B
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} f : B \to A
            be two
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %strong relative cohomology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            relative to these morphisms is the connected components of the
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi Y
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi I
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mover
                    %mo →
                    %mi i
                  %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mi B
                  %mover
                    %mo →
                    %mi f
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H_{Y}^B(X,A) := \pi_0 \mathbf{H}^I(Y \stackrel{i}{\to} X\;,\; B \stackrel{f}{\to} A)
                  \\,.
          %p
            In terms of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi I
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}^I \to \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            (see there).
          %h2#references References
          %p The Sierpinski topos is mentioned around remarks A2.1.12, B3.2.11 (p.83, p.387f) in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"} Sketches of an Elephant
                  vol. I
          %p See also
          %ul
            %li#Johnstone77
              %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
              ,
              = succeed "," do
                %em Topos theory
              = succeed "," do
                %strong 10
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            of the Sierpinski
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li#Shulman
              %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
              ,
              %em The univalence axiom for inverse diagrams
              (
              %a{:href => "http://arxiv.org/abs/1203.3253"}> arXiv:1203.3253
              )
          %p
            Cohesion of the Sierpinski
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              ,
              %em
                %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+a+cohesive+topos"} differential cohomology in a cohesive topos
        .revisedby
