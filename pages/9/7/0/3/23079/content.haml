          %h2#idea Idea
          %p
            An
            %em idempotent monoid
            is a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            which is
            %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
            in that it “squares to itself” in the evident
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category-theoretic
            sense.
          %h2#definition Definition
          %p
            An
            %strong idempotent monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi μ
                  %mo ,
                  %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\mu,\eta)
            in a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a
            %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoid in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            whose multiplication morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %msub
                    %mo ⊗
                    %mi 𝒞
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mu\colon A\otimes_{\mathcal{C}}A\to A
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            Similarly, an
            %strong
              idempotent semigroup in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            (also called a
            = succeed ")" do
              %em
                non-unital idempotent monoid in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\mu)
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            an isomorphism.
          %p
            %strong Note.
            This is different from the usual algebraic notion of an idempotent monoid (namely, one in which
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⋅
                    %mi a
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a \cdot a = a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/idempotent+monoid+object"} idempotent monoid object
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category+with+diagonals"} monoidal category with diagonals
          %p
            We write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi IdemMon
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathsf{IdemMon}(\mathcal{C})
            for the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Mon
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathsf{Mon}(\mathcal{C})
            spanned by the idempotent monoids in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %h3#strict_idempotency Strict idempotency
          %p
            An idempotent monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi μ
                  %mo ,
                  %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\mu,\eta)
            or semigroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\mu)
            is
            %strong strict
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %msub
                    %mo ⊗
                    %mi 𝒞
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mu\colon A\otimes_{\mathcal{C}}A\to A
            is not only an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h2#properties Properties
          %h3#preservation_by_strong_monoidal_functors Preservation by strong monoidal functors
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
            (resp.
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/strict+monoidal+functor"} strict monoidal functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒞
                  %mo →
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} F\colon\mathcal{C}\to\mathcal{D}
            induces a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi IdemMon
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi IdemMon
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi IdemMon
                  %mo{:stretchy => "false"} (
                  %mi 𝒟
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \mathsf{IdemMon}(F)\colon\mathsf{IdemMon}(\mathcal{C})\to\mathsf{IdemMon}(\mathcal{D}),
          %p and hence “preserves” idempotent monoids (resp. strict idempotent monoids).
          %p Similarly, strong (strict) semigroupal functors (“non-unital strong monoidal functors”) “preserve” (strict) idempotent semigroups.
          %h3#as_strong_monoidal_functors_from_the_punctual_category As strong monoidal functors from the punctual category
          %p
            (Strict) idempotent monoids in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            are the same as (strict) strong monoidal functors from the punctual monoidal category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi pt
                  %annotation{:encoding => "application/x-tex"} \mathsf{pt}
          %p
            Similarly, (strict) idempotent semigroups in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            may be identified with (strict) strong semigroupal functors functors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %msup
                      %mi F
                      %mo ⊗
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} pt
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} (F,F^\otimes)\colon\pt\to\mathcal{C}
          %h3#as_strictly_unitary_strong_monoidal_functors_from_the_boolean_monoid As strictly unitary strong monoidal functors from the Boolean monoid
          %p
            (Strict) idempotent semigroups in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            are also the same as
            %em strictly unitary
            strong monoidal functors (resp. strict monoidal functors) from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔹
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi disc
                %annotation{:encoding => "application/x-tex"} \mathbb{B}_\mathsf{disc}
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔹
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %mo ∨
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{B}=(\{0,1\},\vee,1)
            is the “Boolean monoid”, the initial monoid with an idempotent element.
          %h2#examples Examples
          %ul
            %li
              %p
                An idempotent semigroup in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %msub
                          %mi A
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi disc
                        %mo ,
                        %msub
                          %mo ⋅
                          %mi A
                        %mo ,
                        %msub
                          %mn 1
                          %mi A
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \left(A_{\mathsf{disc}},\cdot_A,1_A\right)
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                an ordinary
                %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
                (in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Set"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi Set
                        %annotation{:encoding => "application/x-tex"} \mathsf{Set}
                %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
                %a.existingWikiWord{:href => "/nlab/show/element"} element
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a\in A
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi a
                          %mn 2
                        %mo =
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a^2=a
            %li
              %p
                An idempotent semigroup in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %msub
                          %mi{:mathvariant => "normal"} End
                          %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi disc
                        %mo ,
                        %msubsup
                          %mo ∘
                          %mrow
                            %mi X
                            %mo ,
                            %mi X
                            %mo ,
                            %mi X
                          %mi 𝒞
                        %mo ,
                        %msub
                          %mi{:mathvariant => "normal"} id
                          %mi X
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \left(\mathrm{End}_{\mathcal{C}}(X)_{\mathsf{disc}},\circ^{\mathcal{C}}_{X,X,X},\mathrm{id}_X\right)
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} End
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{End}_{\mathcal{C}}(X)
                the monoid of
                %a.existingWikiWord{:href => "/nlab/show/endomorphisms"} endomorphisms
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                at
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is an idempotent morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f\colon X\to X
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∘
                        %mi f
                        %mo =
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f\circ f=f
            %li
              %p
                An idempotent monoid in
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Ab
                        %mo ,
                        %msub
                          %mo ⊗
                          %mi ℤ
                        %mo ,
                        %mi ℤ
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \left(\mathsf{Ab},\otimes_{\mathbb{Z}},\mathbb{Z}\right)
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/solid+ring"} solid ring
            %li
              %p
                An idempotent monoid in an
                %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
                %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Fun
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo ,
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo ∘
                        %mo ,
                        %msub
                          %mi{:mathvariant => "normal"} id
                          %mi 𝒞
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \left(\mathsf{Fun}(\mathcal{C},\mathcal{C}),\circ,\mathrm{id}_\mathcal{C}\right)
                is an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent monad
            %li
              %p
                An idempotent monoid in the monoidal category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
