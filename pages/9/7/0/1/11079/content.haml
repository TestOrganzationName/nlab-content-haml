              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            %p Under this identification
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity morphisms
                  are precisely the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/identity+functions"} identity functions
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
                  are precisely the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
          #OppositeCategoryOfCartSp.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %p
              Write
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mi op
                  %annotation{:encoding => "application/x-tex"} {}^{op}
              for the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              (
              %a{:href => "geometry+of+physics+--+Categories+and+Toposes#OppositeCategory"}> this def.
              ) of
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              (Prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#CartSpCategory"}
            %p
              This is the category with the same objects as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CartSp
                    %annotation{:encoding => "application/x-tex"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo →
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_1} \to \mathbb{R}^{n_2}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi CartSp
                      %mi op
                  %annotation{:encoding => "application/x-tex"} CartSp^{op}
              is given by a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ←
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_1} \leftarrow \mathbb{R}^{n_2}
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CartSp
                    %annotation{:encoding => "application/x-tex"} CartSp
          %p
            We will be discussing below the idea of exploring smooth spaces by laying out abstract coordinate systems in them in all possible ways. The reader should begin to think of the sets that appear in the following definition as the
            %em set of ways
            of laying out a given abstract coordinate systems in a given space. This is discussed in more detail below in
            = succeed "." do
              %em
                %a{:href => "#SmoothSpaces"} Smooth spaces
          .num_defn
            %h6#definition_6 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo :
                    %msup
                      %mi CartSp
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} X : CartSp^{op} \to Set
              (a “
              %a.existingWikiWord{:href => "/nlab/show/presheaf"}> presheaf
              ”) is
            %ol
              %li
                %p
                  for each abstract coordinate system
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  a
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X(U)
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/coordinate+transformation"} coordinate transformation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                        %mo →
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} f : \mathbb{R}^{n_1} \to \mathbb{R}^{n_2}
                  a
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X(f) : X(\mathbb{R}^{n_1}) \to X(\mathbb{R}^{n_2})
            %p such that
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/identity"} identity
                  is respected
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi id
                            %mrow
                              %msup
                                %mi ℝ
                                %mi n
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msub
                            %mi id
                            %mrow
                              %mi X
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi ℝ
                                %mi n
                              %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} X(id_{\mathbb{R}^n}) = id_{X(\mathbb{R}^n)}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  is respected
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
