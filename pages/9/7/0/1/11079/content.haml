                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mn 2
                        %mo ∘
                        %msub
                          %mi f
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X(f_2)\circ X(f_1) = X(f_2 \circ f_1)
          #SmoothSetOfDifferentialPForms.num_example
            %h6#example_2 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
            %ol
              %li
                %p The following are equivalent:
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                      has a
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                  %li
                    %p
                      the unique
                      %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                            %mo →
                            %mo *
                          %annotation{:encoding => "application/x-tex"} \mathcal{C} \to \ast
                      to the
                      %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                      has a
                      %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo *
                            %munderover
                              %mo ⊥
                              %munder
                                %mo ⟶
                                %mrow
                              %mover
                                %mo ⟵
                                %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"}
                            \\ast
                            \\underoverset
                            {\underset{}{\longrightarrow}}
                            {\overset{}{\longleftarrow}}
                            {\bot}
                            \\mathcal{C}
                %p
                  Under this equivalence, the
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                  is identified with the image under the right adjoint of the unique object of the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
              %li
                %p Dually, the following are equivalent:
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                      has an
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                  %li
                    %p
                      the unique
                      %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                            %mo →
                            %mo *
                          %annotation{:encoding => "application/x-tex"} \mathcal{C} \to \ast
                      to the
                      %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                      has a
                      %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                            %munderover
                              %mo ⊥
                              %munder
                                %mo ⟶
                                %mrow
                              %mover
                                %mo ⟵
                                %mrow
                            %mo *
                          %annotation{:encoding => "application/x-tex"}
                            \\mathcal{C}
                            \\underoverset
                            {\underset{}{\longrightarrow}}
                            {\overset{}{\longleftarrow}}
                            {\bot}
                            \\ast
                %p
                  Under this equivalence, the
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                  is identified with the image under the left adjoint of the unique object of the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
          .proof
            %h6#proof Proof
            %p
              Since the unique
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              in the
              %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
              is
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              is directly the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of an
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
