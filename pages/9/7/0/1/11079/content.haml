                    %a.existingWikiWord{:href => "/nlab/show/derivations+of+smooth+functions+are+vector+fields"} vector fields are derivations of smooth functions
                  \.
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  a
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                  (example
                  = succeed ")," do
                    %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
                  %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} D \colon  C^\infty(X) \to C^\infty(X)
                  on the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C^\infty(X)
                  of
                  %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#AlgebraOfSmoothFunctionsOnCartesianSpaces"}
                  %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
                  with respect to a uniquely defined smooth
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/tangent+vector+field"} tangent vector field
                  %a.existingWikiWord{:href => "/nlab/show/tangent+vector+fields"} tangent vector fields
                  with
                  %a.existingWikiWord{:href => "/nlab/show/derivations"} derivations
                  from example
                  %a.maruku-ref{:href => "#TangentVectorFields"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi Γ
                                  %mi X
                                %mo{:stretchy => "false"} (
                                %mi T
                                %mi X
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mphantom
                                      %mi A
                                    %mo ≃
                                    %mphantom
                                      %mi A
                              %mtd
                                %mi Der
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi C
                                  %mn ∞
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mi v
                              %mtd
                                %mo ↦
                              %mtd
                                %msub
                                  %mi D
                                  %mi v
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\Gamma_X(T X)
                        \&amp;\overset{\phantom{A}\simeq\phantom{A}}{\longrightarrow}&amp;
                        Der(C^\infty(X))
                        \\\
                        v &amp;\mapsto&amp; D_v
                        }
                %p
                  is in fact an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                %p
                  (This follows directly from the
                  = succeed ".)" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Hadamard+lemma"} Hadamard lemma
          %p
            Actually all three statements in prop.
            %a.maruku-ref{:href => "#AlgebraicFactsOfDifferentialGeometry"}
            hold not just for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            (def./prop.
            %a.maruku-ref{:href => "#SmoothManifoldInsideDiffeologicalSpaces"}
            below; if only we generalize in the second statement from
            %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/projective+modules"} projective modules
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            and then bootstrap the theory of
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            and much more from that, which we do
            = succeed "." do
              %a{:href => "#FieldBundles"} below
          %h2#CoordinateSystemsLayerSem The category of abstract coordinate systems
          %p
            Here we make explicit the
            %em
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            formed by abstract coordinate systems (Prop.
            %a.maruku-ref{:href => "#CartSpCategory"}
            below) and mention some of its basic properties. This will serve the discussion of
            %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            as the
            %em
              %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
            on the category of abstract coordinate systems, in the next chapter
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+smooth+sets"} geometry of physics – smooth sets
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #CartSpCategory.num_prop
            %h6#propositions Propositions
            %p
              %strong
                (the
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
