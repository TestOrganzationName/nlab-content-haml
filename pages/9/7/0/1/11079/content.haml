                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/point"} point
          %p
            Hence
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            is (the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic category
            %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theory
            (a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
          %p
            This is called the
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+algebras"} smooth algebras
          .num_defn
            %h6#definition_7 Definition
            %p
              A
              = succeed "-preserving" do
                %a.existingWikiWord{:href => "/nlab/show/product"} product
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
