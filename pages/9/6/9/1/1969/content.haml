                                  %mi Δ
                                  %mi op
                            %msub
                              %mi Mor
                              %mi C
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi Γ
                              %mi p
                            %mi X
                            %mo ,
                            %msub
                              %mi Λ
                              %mi q
                            %mi Y
