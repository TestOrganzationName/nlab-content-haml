                            %mover
                              %mo ←
                              %mo ≃
                          %mtd
                            %msub
                              %mi Mor
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi Q
                            %mi X
                            %mo ,
                            %msub
                              %mi Λ
                              %mo •
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mo ≃
                        %mtr
                          %mtd
                          %mtd
