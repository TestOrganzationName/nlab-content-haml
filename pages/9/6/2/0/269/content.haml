          %h2#section_Definition Definition
          %p
          .num_defn
            %h6 Notation
            %p
              We make use of the notation of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+of+cubes"} category of cubes
          %p
          .num_defn
            %h6 Definition
            %p
              The
              %em category of cubical sets
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+co-completion"} free co-completion
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo □
                    %annotation{:encoding => "application/x-tex"} \square
          %p
          .num_remark
            %h6 Remark
            %p
              The free co-completion of a small category can be constructed as the category of
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaves
              of sets on this category. Thus we can also think of the category of cubical sets as the category of presheaves of sets on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo □
                    %annotation{:encoding => "application/x-tex"} \square
          %p
          .num_defn
            %h6 Notation
            %p
              We denote the category of cubical sets by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Set
                        %mrow
                          %msup
                            %mo □
                            %mi op
                    %annotation{:encoding => "application/x-tex"} \mathsf{Set}^{\square^{op}}
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %em cubical set
              is an object of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Set
                        %mrow
                          %msup
                            %mo □
                            %mi op
                    %annotation{:encoding => "application/x-tex"} \mathsf{Set}^{\square^{op}}
          %p
          .num_remark
            %h6 Remark
            %p
              When we think of the category of cubical sets as the category of presheaves of sets on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo □
                    %annotation{:encoding => "application/x-tex"} \square
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo □
                    %annotation{:encoding => "application/x-tex"} \square
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %em morphism
              of cubical sets is an arrow of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Set
                        %mrow
                          %msup
                            %mo □
                            %mi op
                    %annotation{:encoding => "application/x-tex"} \mathsf{Set}^{\square^{op}}
          %h2#idea Idea
          %p
            The definition is to be understood from the point of view of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/space+and+quantity"} space and quantity
            %em cubical set
            is a
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            characterized by the fact that, and the ways in which, it may be
            %em probed
            by mapping standard cellular
            %a.existingWikiWord{:href => "/nlab/show/cubes"} cubes
            into it: the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} S_n
            assigned by a cubical set to the standard
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/cube"} cube
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            is the set of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/cubes"} cubes
            in this space, hence the way of mapping a standard
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/cube"} cube
            into this spaces.
          %p
            Being a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo :
                    %msup
                      %mo □
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} S : \Box^{op} \to Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            also assigns maps between its sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} S_n
            of
            = succeed "-cubes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            The
            %strong face maps
            go from sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} S_{n+1}
            of
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} S_{n}
            of
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n=1
            the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 2
                %annotation{:encoding => "application/x-tex"} S_2
            of 2-cubes would be sent in four different ways by four different face maps to the set of
            = succeed "-cubes," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                            %mo →
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ⇓
                              %mi F
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi c
                          %mtd
                            %mo →
                          %mtd
                            %mi d
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                            %mo →
                          %mtd
                            %mi b
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\array{
                  a &amp;\to&amp; b
                  \\\
                  \\downarrow &amp;\Downarrow^F&amp; \downarrow
                  \\\
                  c &amp;\to&amp; d
                  }
                  \\right)
                  \\;\;
                  \\mapsto
                  \\;\;
                  \\left(
                  \\array{
                  a &amp;\to&amp; b
                  }
                  \\right)
          %p another one would send
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                            %mo →
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ⇓
                              %mi F
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi c
                          %mtd
                            %mo →
                          %mtd
                            %mi d
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi a
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi c
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\array{
                  a &amp;\to&amp; b
                  \\\
                  \\downarrow &amp;\Downarrow^F&amp; \downarrow
                  \\\
                  c &amp;\to&amp; d
                  }
                  \\right)
                  \\;\;
                  \\mapsto
                  \\;\;
                  \\left(
                  \\array{
                  a
                  \\\
                  \\downarrow
                  \\\
                  c
                  }
                  \\right)
                  \\,.
          %p
            On the other hand, the
            %strong degeneracy maps
            go the other way round and send sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} S_n
            of
            = succeed "-cubes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} S_{n+1}
            of
            = succeed "-cubes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            = succeed "-cube" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-cube" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n=1
            a degeneracy map may act by sending
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi b
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi Id
                          %mtd
                            %msup
                              %mo ⇓
                              %mi Id
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi Id
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi b
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\array{
                  a
                  \&amp;\stackrel{f}{\to}&amp;
                  b
                  }
                  \\right)
                  \\;\;
                  \\mapsto
                  \\;\;
                  \\left(
                  \\array{
                  a &amp;\stackrel{f}{\to}&amp; b
                  \\\
                  \\downarrow^{Id} &amp;\Downarrow^{Id}&amp; \downarrow^{Id}
                  \\\
                  a &amp;\stackrel{f}{\to}&amp; b
                  }
                  \\right)
                  \\,.
          %p
            Notice the
            = succeed "-labels," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                  %annotation{:encoding => "application/x-tex"} Id
            %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
            is thin (notice however that a cubical set by itself is not equipped with a notion of composition of cubes. If it were, we’d call it a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/cubical+%E2%88%9E-category"} cubical ∞-category
          %p
            In an ordinary cubical set all degeneracy maps act in the kind of way depicted above. One might also want to require a cubical set to contain “thin” cells between equal
            %em adjacent
            faces. These
            %strong extra degeneracy maps
            act by sending 1-cells to degenerate 2-cells of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi b
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi f
                          %mtd
                            %mo ⇓
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi Id
                        %mtr
                          %mtd
                            %mi b
                          %mtd
                            %mover
                              %mo →
                              %mi Id
                          %mtd
                            %mi b
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(\array{
                  a&amp;\stackrel{f}{\to}&amp;b
                  }\right)
                  \\;\;
                  \\mapsto
                  \\;\;
                  \\left(\array{
                  a &amp; \stackrel{f}{\to} &amp; b \\
                  \\downarrow^{f} &amp; \Downarrow &amp; \downarrow^{Id} \\
                  b &amp; \stackrel{Id}{\to} &amp; b
                  }\right)
                  \\,.
          %p
            If the cubical set has this additional property, one calls it a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+cubical+set"} cubical set with connection
          %h2#monoidal_structure Monoidal structure
          %p
            The strict monoidal structure of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo □
                %annotation{:encoding => "application/x-tex"} \square
            gives rise to a (non-strict) monoidal structure on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Set
                      %mrow
                        %msup
                          %mo □
                          %mi op
                  %annotation{:encoding => "application/x-tex"} \mathsf{Set}^{\square^{op}}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo □
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \square^{0}
            = succeed "." do
              %a.maruku-ref{:href => "#NotationFreeStandingNCube"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            when working with cubical sets or morphisms of cubical sets, we shall always refer to the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ⊗
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                %annotation{:encoding => "application/x-tex"} - \otimes -
            of this monoidal structure.
          %h2#notation Notation
          %h3#free_standing_cube_and_an_cube_of_a_cubical_set
            Free standing
            = succeed "-cube," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-cube" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          #NotationFreeStandingNCube.num_defn
            %h6#notation_2 Notation
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mo □
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Set
                      %mrow
                        %msup
                          %mo □
                          %mi op
                  %annotation{:encoding => "application/x-tex"} y : \square \rightarrow \mathsf{Set}^{\square^{op}}
              denote the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              functor. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n \geq 0
              be an integer. We denote the cubical set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi I
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y(I^{n})
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo □
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \square^{n}
          .num_defn
            %h6#terminology Terminology
            %p
              We refer to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo □
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \square^{n}
              as the
              = succeed "." do
                %em
                  free-standing
                  = succeed "-cube" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
          .num_defn
            %h6#terminology_2 Terminology
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a cubical set. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n \geq 0
              be an integer. By an
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-cube
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo □
                        %mi n
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \square^{n} \rightarrow X
          #NotationOneCubePictorial.num_defn
            %h6#notation_3 Notation
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              be a 1-cube of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi x
                      %mn 0
                    %mo →
                    %msub
                      %mi x
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f : x_{0} \rightarrow x_{1}
              or as follows.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi x
                              %mn 0
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %msub
                              %mi x
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{x_{0} &amp; \overset{f}{\rightarrow} &amp; x_{1}}
            %p
              In this case,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x_{0}
              is to be understood to be the
              = succeed "-cube" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \circ y(i_{0})
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x_{1}
              is to be understood to be the
              = succeed "-cube" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \circ y(i_{1})
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #NotationTwoCubePictorial.num_defn
            %h6#notation_4 Notation
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              be a 2-cube of
              = succeed "." do
