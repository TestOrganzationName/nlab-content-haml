                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/binary+dihedral+group"} binary dihedral group
                    %br/
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 2
                          %msub
                            %mi D
                            %mrow
                              %mn 2
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo −
                              %mn 2
                              %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} 2 D_{2(n-2)}
                  %td{:style => "text-align: left;"}
