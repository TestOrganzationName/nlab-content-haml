                \&amp;rbrack;
          .footnotes
            %hr/
            %ol
              %li#fn:1
                %p
                  A previous edit offered even more detail: “An alternative proof begins with the premise that each solution of the ordinary differential equation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ′
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} g' = 0
                  is locally constant. Suppose
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                      %annotation{:encoding => "application/x-tex"} c
                  is a complex number. As
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi exp
                          %mo ′
                          %mo =
                          %mi exp
                        %annotation{:encoding => "application/x-tex"} \exp' = \exp
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo −
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo ′
                          %mo =
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo −
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo −
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} (\exp(x) \exp(c - x))' = \exp(x) \exp(c - x) + \exp(x) (-\exp(c-x)) = 0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi exp
                      %annotation{:encoding => "application/x-tex"} \exp
                  (either
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} {\mathbb{R}}
                  or
                  = succeed ")," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} {\mathbb{C}}
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo −
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \exp(x)\exp(c - x) = \exp(0)\exp(c)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \exp(0) = 1
                  then yields
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo −
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \exp(x)\exp(c - x) = \exp(c)
                  = succeed ".\u201D" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi c
                          %mo =
                          %mi x
                          %mo +
                          %mi y
                        %annotation{:encoding => "application/x-tex"} c = x + y
                  %a{:href => "#fnref:1", :rev => "footnote"} ↩
