            by the equation
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi f
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} f(x + \epsilon) = f(x) + f'(x) \epsilon
          %p
            %strong Axiom of exponential function:
            %em
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} [
                    %mi ϵ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %msup
