                  %mi{:mathvariant => "normal"} or
                  %mspace{:width => "1em"}
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 0
                    %mi n
                  %mfrac
                    %mrow
                      %msup
                        %mi x
                        %mi i
                    %mrow
                      %mi i
                      %mo !
                %annotation{:encoding => "application/x-tex"} \left(1 + \frac{x}{n}\right)^{n} \quad \mathrm{or} \quad \sum_{i = 0}^{n} \frac{x^i}{i!}
          %p
            do not have a limit for all modulated Cantor real numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mi C
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}_C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_C
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
