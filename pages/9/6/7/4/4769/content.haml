                    %mi ϵ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi ϵ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \epsilon \in F[\epsilon]/\epsilon^2
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
