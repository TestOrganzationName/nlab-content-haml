                    %mo &lt;
                    %msup
                      %mrow
                        %mo (
                        %mn 1
                        %mo +
                        %mfrac
                          %mi x
                          %mi n
                        %mo )
                      %mi n
                    %mo −
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} -\epsilon \lt \left(1 + \frac{x}{n}\right)^{n} - \exp(x) \lt \epsilon
              (or equivalently,
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
