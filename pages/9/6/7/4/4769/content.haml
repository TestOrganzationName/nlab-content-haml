                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} -\epsilon \lt \left(\sum_{i = 0}^{n} \frac{x^i}{i!}\right) - \exp(x) \lt \epsilon
          %h2#exp_of_Lie_groups In Lie groups
          %p Note: this section is under repair.
          %p
            The classical exponential function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ℝ
                  %mo →
                  %msup
                    %mi ℝ
                    %mo *
                %annotation{:encoding => "application/x-tex"} \exp \colon \mathbb{R} \to \mathbb{R}^*
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ℂ
                  %mo →
                  %msup
                    %mi ℂ
                    %mo *
                %annotation{:encoding => "application/x-tex"} \exp \colon \mathbb{C} \to \mathbb{C}^*
            satisfies the fundamental property:
          .num_prop
            %h6#proposition Proposition
            %p
              The function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℂ
                    %mo →
                    %msup
                      %mi ℂ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \exp \colon \mathbb{C} \to \mathbb{C}^*
              is a homomorphism taking addition to multiplication:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(x + y) = \exp(x) \cdot \exp(y)
          .proof
            %h6#proof Proof
            %p
              A number of proofs may be given. One rests on the combinatorial
              %a.existingWikiWord{:href => "/nlab/show/binomial+theorem"} binomial identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi y
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi j
                        %mo +
                        %mi k
                        %mo =
                        %mi n
                    %mfrac
                      %mrow
                        %mi n
                        %mo !
                      %mrow
                        %mi j
                        %mo !
                        %mi k
                        %mo !
                    %msup
                      %mi x
                      %mi j
                    %msup
                      %mi y
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (x + y)^n = \sum_{j + k = n} \frac{n!}{j! k!} x^j y^k
            %p
              (which crucially depends on the fact that multiplication is
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"} commutative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi n
                                %mo ≥
                                %mn 0
                            %mfrac
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo +
                                %mi y
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mi n
                              %mrow
                                %mi n
                                %mo !
                          %mtd
                            %mo =
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi n
                                %mo ≥
                                %mn 0
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi j
                                %mo +
                                %mi k
                                %mo =
                                %mi n
                            %mfrac
                              %mn 1
                              %mrow
                                %mi j
                                %mo !
                            %mfrac
                              %mn 1
                              %mrow
                                %mi k
                                %mo !
                            %msup
                              %mi x
                              %mi j
                            %msup
                              %mi y
                              %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mo{:stretchy => "false"} (
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi j
                                %mo ≥
                                %mn 0
                            %mfrac
                              %mrow
                                %msup
                                  %mi x
                                  %mi j
                              %mrow
                                %mi j
                                %mo !
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi k
                                %mo ≥
                                %mn 0
                            %mfrac
                              %mrow
                                %msup
                                  %mi y
                                  %mi k
                              %mrow
                                %mi k
                                %mo !
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\sum_{n \geq 0} \frac{(x+y)^n}{n!} &amp; = &amp; \sum_{n \geq 0} \sum_{j + k = n} \frac1{j!} \frac1{k!} x^j y^k \\
                    \&amp; = &amp; (\sum_{j \geq 0} \frac{x^j}{j!}) \cdot (\sum_{k \geq 0} \frac{y^k}{k!}) \\
                    \&amp; = &amp; \exp(x) \cdot \exp(y)
                    }
            %p
              An alternative proof begins with the observation that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi exp
                  %annotation{:encoding => "application/x-tex"} f = \exp
              is the solution to the system
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ′
                      %mo =
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f' = f
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} f(0) = 1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %mi x
                    %mo ↦
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g_1 \colon x \mapsto f(x) f(y)
              is a solution to the system
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ′
                      %mo =
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g' = g
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g(0) = f(y)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 2
                      %mo{:lspace => "verythinmathspace"} :
                      %mi x
                      %mo ↦
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g_2 \colon x \mapsto f(x + y)
              = succeed ")," do
                %a{:href => "http://en.wikipedia.org/wiki/Picard%E2%80%93Lindel%C3%B6f_theorem"} here
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 1
                      %mo =
                      %msub
                        %mi g
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} g_1 = g_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x + y) = f(x)f(y)
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x, y
              %sup#fnref:1
                %a{:href => "#fn:1", :rel => "footnote"} 1
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            be its
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                    %mi M
                  %annotation{:encoding => "application/x-tex"} T_1 M
            %a.existingWikiWord{:href => "/nlab/show/identity+element"} identity element
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            may be equipped with the canonical left-invariant connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mi l
                %annotation{:encoding => "application/x-tex"} \Del_l
            or the canonical right-invariant connection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mi r
                  %annotation{:encoding => "application/x-tex"} \Del_r
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            relative to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mi l
                %annotation{:encoding => "application/x-tex"} \Del_l
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mi r
                %annotation{:encoding => "application/x-tex"} \Del_r
            are the same; we define this to be the
            = succeed "," do
              %strong
                natural Lie exponential map on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                at the identity
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                  %annotation{:encoding => "application/x-tex"} \exp
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                  %annotation{:encoding => "application/x-tex"} \exp
              is defined on all of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝔤
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \exp \colon \mathfrak{g} \to G
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+map"} smooth map
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℝ
                    %mo →
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \rho \colon \mathbb{R} \to \mathfrak{g}
              is a smooth homomorphism from the additive group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              (i.e., if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              is an
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X = \rho(1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo ∘
                    %msub
                      %mi ρ
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℝ
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \exp \circ \rho_X \colon \mathbb{R} \to G
              is a smooth homomorphism.
            %li
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                      %mo ∈
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} X, Y \in \mathfrak{g}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} [X, Y] = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝔤
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \exp \colon \mathfrak{g} \to G
              to the subspace spanned by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is a smooth homomorphism to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝔤
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \exp \colon \mathfrak{g} \to G
              is a homomorphism if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is abelian (e.g., if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a commutative Lie group).
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                  %annotation{:encoding => "application/x-tex"} \exp
              is
              %a.existingWikiWord{:href => "/nlab/show/surjection"} surjective
              (a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/regular+epimorphism"} regular epimorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is
              %a.existingWikiWord{:href => "/nlab/show/connected+space"} connected
              and
              %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
              (and also in some other situations, such as the classical cases where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} ]0,\infty[
              or
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{C} \setminus \{0\}
              %a{:href => "https://terrytao.wordpress.com/2011/06/25/two-small-facts-about-lie-groups/"} this post
              by Terence Tao, Proposition 1; see also the first comment which indicates an alternative proof based on the fact that
              %a.existingWikiWord{:href => "/nlab/show/maximal+tori"} maximal tori
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              are all conjugate to one another. Note also that the exponential map might not be surjective if the compactness assumption is dropped, as in the case of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %msub
                      %mi SL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G = SL_2(\mathbb{R})
              or
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi SL
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SL_2(\mathbb{C})
              %a{:href => "http://math.stackexchange.com/questions/643216/non-surjectivity-of-the-exponential-map-to-sl2-mathbbc"} here
              for instance.
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              that is both left and right invariant (see Tao’s post linked in the previous remark); then the Lie exponential map is the same as the Riemannian exponential map at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/matrix+Lie+group"} matrix Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                  %annotation{:encoding => "application/x-tex"} \exp
              is given by the classical series formula
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:series"} (1)
          %p (to be expanded on)
          %h2#logarithms Logarithms
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/logarithm"} logarithm
            is a
            %a.existingWikiWord{:href => "/nlab/show/local+section"} local section
            of an exponential map.
