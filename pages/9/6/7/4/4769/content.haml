          %h2#idea Idea
          %p
            The exponential
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            of classical
            %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
            given by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/series"} series
          #eq:series.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mi x
                  %mo ≔
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 0
                    %mn ∞
                  %mfrac
                    %mrow
                      %msup
                        %mi x
                        %mi i
                    %mrow
                      %mi i
                      %mo !
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \exp x \coloneqq \sum_{i = 0}^{\infty} \frac{x^i}{i!} ,
          %p
            is the solution of the
            %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ′
                  %mo =
                  %mi f
                %annotation{:encoding => "application/x-tex"} f' = f
          %p
            with initial value
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f(0) = 1
          %p
            It is also the limit of the following
            %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
            of
            %a.existingWikiWord{:href => "/nlab/show/polynomial+functions"} polynomial functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msup
                    %mrow
                      %mo (
                      %mn 1
                      %mo +
                      %mfrac
                        %mi x
                        %mi n
                      %mo )
                    %mi n
                %annotation{:encoding => "application/x-tex"} f_n(x) \coloneqq \left(1 + \frac{x}{n}\right)^n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mi x
                  %mo ≔
                  %munder
                    %mi lim
                    %mrow
                      %mi n
                      %mo →
                      %mn ∞
                  %msub
                    %mi f
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp x \coloneqq \lim_{n \to \infty} f_n(x)
          %p
            This classical function is defined on the
            %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            (or the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
          %ul
            %li
              by its nature, the argument of the function should be a
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/tangent+vector"} tangent vector
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R} \to \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/source"} source
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              is really the
              %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
              to the
              %a.existingWikiWord{:href => "/nlab/show/target"} target
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              at the point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mn 0
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \exp 0 = 1
            %li
              We need a
              %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
              to tell us what
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f'
              means.
          %p
            So in the end we have, for any
            %a.existingWikiWord{:href => "/nlab/show/point"} point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            on a
            %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            with an
            %a.existingWikiWord{:href => "/nlab/show/affine+connection"} affine connection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \Del
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi exp
                      %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi T
                      %mi p
                    %mi M
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \exp_p\colon T_p M \to M
            %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            in the
            %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi p
                    %mi M
                  %annotation{:encoding => "application/x-tex"} T_p M
          %p
            Note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            here comes from the initial value
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi exp
                      %mi p
                    %mn 0
                    %mo =
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \exp_p 0 = p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} p = 1
            when we work in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %mi p
                    %mi exp
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x \mapsto p \exp x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ′
                  %mo =
                  %mi f
                %annotation{:encoding => "application/x-tex"} f' = f
            takes this form.
          %p
            Classically, there are some other functions called ‘exponential’; given any nonzero real (or complex) number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %msup
                    %mi b
                    %mi x
                %annotation{:encoding => "application/x-tex"} x \mapsto b^x
            (or even
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %mi p
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi b
                      %mi x
                  %annotation{:encoding => "application/x-tex"} x \mapsto p\, b^x
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/natural+logarithm"} natural logarithm
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi b
                    %mi x
                %annotation{:encoding => "application/x-tex"} b^x
            in terms of the natural exponential map
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                  %annotation{:encoding => "application/x-tex"} \exp
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi b
                    %mi x
                  %mo ≔
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mi ln
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} b^x \coloneqq \exp (x \ln b) .
          %p
            So while
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            is traditionally called the ‘base’, it is really the number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ln
                  %mi b
                %annotation{:encoding => "application/x-tex"} \ln b
            that matters, or even better the operation of multiplication by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ln
                    %mi b
                  %annotation{:encoding => "application/x-tex"} \ln b
            %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
            of the real line (or complex plane), and every such endomorphism takes this form for some nonzero
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            (and some branch of the natural logarithm, in the complex case). So we see that this generalised exponential map is simply the
            %a.existingWikiWord{:href => "/nlab/show/composite"} composite
            of the natural exponential map after a linear endomorphism.
          %h2#definition Definition
          %p
            See also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/flow+of+a+vector+field"} flow of a vector field
          %h3#with_respect_to_an_affine_connection With respect to an affine connection
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \Del
            be an
            %a.existingWikiWord{:href => "/nlab/show/affine+connection"} affine connection
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            be a
            %a.existingWikiWord{:href => "/nlab/show/point"} point
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+equations"} differential equations
            %a.existingWikiWord{:href => "/nlab/show/maximal+partial+function"} maximally
            defined
            %a.existingWikiWord{:href => "/nlab/show/partial+function"} partial function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi exp
                    %mi p
                %annotation{:encoding => "application/x-tex"} \exp_p
            from the
            %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi p
                  %mi M
                %annotation{:encoding => "application/x-tex"} T_p M
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            such that:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %msub
                      %mi exp
                      %mi p
                    %mo =
                    %msub
                      %mi exp
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \Del \exp_p = \exp_p
              and
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi exp
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \exp_p(0) = p
              \.
          %p
            This function is the
            = succeed "." do
              %strong
                natural exponential map on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                at
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                relative to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∇
                    %annotation{:encoding => "application/x-tex"} \Del
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi exp
                      %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \exp_p\colon U \to M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is some
            %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi p
                    %mi M
                  %annotation{:encoding => "application/x-tex"} T_p M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is
            %span.newWikiWord
              complete
              %a{:href => "/nlab/new/complete+manifold"} ?
            (relative to
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \Del
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            will be all of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi p
                    %mi M
                  %annotation{:encoding => "application/x-tex"} T_p M
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be a
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            (or a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            be a point in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            may be equipped with the
            %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+connection"} Levi-Civita connection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mi lc
                  %annotation{:encoding => "application/x-tex"} \Del_{lc}
            %strong
              natural Riemannian exponential map on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            to be the natural exponential map on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            relative to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mi lc
                  %annotation{:encoding => "application/x-tex"} \Del_{lc}
          %p
            Given any
            %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi T
                      %mi p
                    %mi M
                    %mo →
                    %msub
                      %mi T
                      %mi p
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \phi\colon T_p M \to T_p M
            = succeed "," do
              %strong
                exponential map on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                at
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                relative to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∇
                    %annotation{:encoding => "application/x-tex"} \Del
                with logarithmic base
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %msub
                      %mi exp
                      %mi p
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \mapsto \exp_p \phi(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            corresponds to an exponential function whose logarithmic base is multiplication by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ln
                    %mi b
                  %annotation{:encoding => "application/x-tex"} \ln b
          %h3#via_geodesics Via geodesics
          %p
            Recall that a
            %a.existingWikiWord{:href => "/nlab/show/geodesic"} geodesic
            is a
            %a.existingWikiWord{:href => "/nlab/show/curve"} curve
            on a manifold whose
            %a.existingWikiWord{:href => "/nlab/show/velocity"} velocity
            is constant (as measured along that curve relative to a given affine connection). Working naïvely, we may write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo ′
                  %mo =
                  %mi v
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \gamma' = v ,
          %p
            pretend that this is a differential equation for a function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \gamma\colon \mathbb{R} \to \mathbb{R}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi p
                  %mi exp
                  %mi t
                  %mi x
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \gamma(t) = p \exp t x ,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is given by the initial value
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \gamma(0) = p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi exp
                      %mi p
                    %mi t
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \exp_p t x
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \Del
            be an
            %a.existingWikiWord{:href => "/nlab/show/affine+connection"} affine connection
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            be a
            %a.existingWikiWord{:href => "/nlab/show/point"} point
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %a.existingWikiWord{:href => "/nlab/show/tangent+vector"} tangent vector
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            at
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/maximal+geodesic"} maximal geodesic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                %annotation{:encoding => "application/x-tex"} \gamma
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            tangent to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \gamma(1)
            is defined (which it will be whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is
            %span.newWikiWord
              complete
              %a{:href => "/nlab/new/complete+manifold"} ?
            and may be in any case), we have
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi exp
                      %mi p
                    %mi x
                    %mo =
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} exp_p x = \gamma(1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi exp
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi γ
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp_p (t x) = \gamma(t)
            for sufficiently small
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
          %h2#in_real_algebras In real algebras
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            be any
            %a.existingWikiWord{:href => "/nlab/show/sequentially+Cauchy+complete"} sequentially Cauchy complete
            %a.existingWikiWord{:href => "/nlab/show/Archimedean+field"} Archimedean
            %a.existingWikiWord{:href => "/nlab/show/ordered+field"} ordered
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi ℝ
                  %mi{:mathvariant => "normal"} Alg
                  %mo →
                  %mi ℝ
                  %mi{:mathvariant => "normal"} Vect
                %annotation{:encoding => "application/x-tex"} F:\mathbb{R}\mathrm{Alg} \to \mathbb{R}\mathrm{Vect}
            be the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            which takes an
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to its underlying
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(A)
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            whose underlying
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(A)
            is finite-dimensional, each element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            could be expressed as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/linear+combination"} linear combination
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \exp:A \to A
            as either
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mi lim
                    %mrow
                      %mi n
                      %mo →
                      %mn ∞
                  %msup
                    %mrow
                      %mo (
                      %mn 1
                      %mo +
                      %mfrac
                        %mi x
                        %mi n
                      %mo )
                    %mi n
                %annotation{:encoding => "application/x-tex"} \exp(x) \coloneqq \lim_{n \to \infty} \left(1 + \frac{x}{n}\right)^n
          %p or
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mi lim
                    %mrow
                      %mi n
                      %mo →
                      %mn ∞
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 0
                    %mi n
                  %mfrac
                    %mrow
                      %msup
                        %mi x
                        %mi i
                    %mrow
                      %mi i
                      %mo !
                %annotation{:encoding => "application/x-tex"} \exp(x) \coloneqq \lim_{n \to \infty} \sum_{i = 0}^{n} \frac{x^i}{i!}
          %p
            since according to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+limit+theorem"} algebraic limit theorem
          %p
            In particular, this is how exponential functions are defined in
            %a.existingWikiWord{:href => "/nlab/show/Clifford+algebras"} Clifford algebras
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/matrix+algebras"} matrix algebras
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group+homomorphisms"} abelian group homomorphisms
          %h3#in_the_dual_numbers In the dual numbers
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/dual+number"} dual number
            real algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔻
                  %mo ≔
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %mi ϵ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi ϵ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{D} \coloneqq \mathbb{R}[\epsilon]/\epsilon^2
            has a notion of exponential function, which is the solution to the functional equation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo +
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(x + \epsilon) = \exp(x) (1 + \epsilon)
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \exp(0) = 1
          %h2#in_arbitrary_archimedean_ordered_fields  In arbitrary Archimedean ordered fields
          %p
            In general, Archimedean ordered fields which are not
            %a.existingWikiWord{:href => "/nlab/show/sequentially+Cauchy+complete"} sequentially Cauchy complete
            do not have an exponential function. Nevertheless, the exponential map is still guaranteed to be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/partial+function"} partial function
            %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff space
            and thus a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sequentially+Hausdorff+space"} sequentially Hausdorff space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            to ensure that the exponential partial function is actually a total function:
          %p
            %strong Axiom of exponential function:
            %em
              For all elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} x \in F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \exp(x) \in F
              such that for all positive elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∈
                      %msub
                        %mi F
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \epsilon \in F_+
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
              such that for all natural numbers
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mi N
                    %annotation{:encoding => "application/x-tex"} n \geq N
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo &lt;
                    %msup
                      %mrow
                        %mo (
                        %mn 1
                        %mo +
                        %mfrac
                          %mi x
                          %mi n
                        %mo )
                      %mi n
                    %mo −
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} -\epsilon \lt \left(1 + \frac{x}{n}\right)^{n} - \exp(x) \lt \epsilon
              (or equivalently,
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi ϵ
                      %mo &lt;
                      %mrow
                        %mo (
                        %msubsup
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi i
                            %mo =
                            %mn 0
                          %mi n
                        %mfrac
                          %mrow
                            %msup
                              %mi x
                              %mi i
                          %mrow
                            %mi i
                            %mo !
                        %mo )
                      %mo −
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} -\epsilon \lt \left(\sum_{i = 0}^{n} \frac{x^i}{i!}\right) - \exp(x) \lt \epsilon
          %p
            There is another axiom which uses the fact that derivatives of functions are well defined in the
            %a.existingWikiWord{:href => "/nlab/show/ordered+local+ring"} ordered local
            %a.existingWikiWord{:href => "/nlab/show/local+Artin+algebra"}
              Artin
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} [
                  %mi ϵ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi ϵ
                    %mn 2
