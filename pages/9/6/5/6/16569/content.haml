            hence also on representing objects
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi m
                        %mo +
                        %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mi m
                  %annotation{:encoding => "application/x-tex"} X_{m+1}\to X_m
            %strong arc space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn ∞
                  %mo =
                  %msub
                    %mi lim
                    %mi m
                  %msub
                    %mi X
                    %mi m
                %annotation{:encoding => "application/x-tex"} X_\infty = lim_m X_m
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and it comes along with natural projections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn ∞
                  %mo →
                  %msub
                    %mi X
                    %mi m
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} X_\infty\to X_m\to X
            (under some assumptions each of the maps is locally trivial).
          %h2#properties Properties
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a scheme of finite type over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            then there is a bijection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Sch
                  %mo{:stretchy => "false"} /
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %msub
                    %mi X
                    %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mo{:stretchy => "false"} (
                  %mi ind
                  %mo −
                  %mi Sch
                  %mo{:stretchy => "false"} /
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %msub
                    %mover
                      %mo ×
                      %mo{:stretchy => "false"} ^
                    %mrow
                      %mi Spec
                      %mi k
                  %mi Spec
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (Sch/k) (Y,X_\infty) \cong (ind-Sch/k) (Y\hat\times_{Spec k} Spec k[[t]],X)
          %p
            natural in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sch
                    %mo{:stretchy => "false"} /
                    %mi k
                  %annotation{:encoding => "application/x-tex"} Sch/k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %msub
                    %mover
                      %mo ×
                      %mo{:stretchy => "false"} ^
                    %mi k
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Y\hat\times_k k[[t]]
            is the formal completion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            along subscheme
            = succeed ".1" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %msub
                      %mo ×
                      %mrow
                        %mi Spec
                        %mi k
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} Y\times_{Spec k} \{0\}
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/singularity"} singularity
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/jet+space"} jet space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/motivic+integration"} motivic integration
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Greenberg+scheme"} Greenberg scheme
          %h2#literature Literature
          %p Early ideas appeared in
          %ul
            %li
              J. Nash Jr.,
              = succeed "," do
                %em Arc structure of singularities
          %p and its appearance in motivic integration stems from
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/M.+Kontsevich"}> M. Kontsevich
              , lecture on motivic integration, Orsay, December 7, 1995.
          %p For basic lectures see
          %ul
            %li
              M. Mustaţǎ,
              = succeed "," do
                %em Spaces of arcs in birational geometry
              %a{:href => "http://www.math.lsa.umich.edu/~mmustata/lectures_arcs.pdf"} pdf
            %li
              M. Popa, 571 Ch. 5.
              = succeed "," do
                %em Jet schemes and arc spaces
              %a{:href => "http://homepages.math.uic.edu/~mpopa/571/chapter5.pdf"} pdf
          %p Surveys:
          %ul
            %li
              %p
                Jan Denef, Francois Loeser,
                = succeed "," do
                  %em Geometry on arc spaces of algebraic varieties
                %a{:href => "http://arxiv.org/abs/math/0006050"} math.AG/0006050
            %li
              %p
                L. Ein, M. Mustaţǎ,
                = succeed "," do
                  %em Jet schemes and singularities
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=2483946"} MR2483946
            %li
              %p
                Tommaso de Fernex,
                = succeed "," do
                  %em The space of arcs of an algebraic variety
                %a{:href => "http://arxiv.org/abs/1604.02728"} arxiv/1604.02728
          %p On connections to combinatorics and representation theory:
          %ul
            %li
              Clemens Bruschek, Hussein Mourtada, Jan Schepers,
              = succeed "," do
                %em Arc spaces and the Rogers–Ramanujan identities
          %p Other papers
          %ul
            %li
              %p
                J. Denef, F. Loeser,
                = succeed "," do
                  %em Germs of arcs on singular algebraic varieties and motivic integration
            %li
              %p
                S Ishii, J Kollár,
                %em The Nash problem on arc families of singularities,
                Duke Math. J., 120 (2003) 601–620
                %a{:href => "http://arxiv.org/abs/math/0207171"} math.AG/0207171
            %li
              %p
                Shihoko Ishii,
                = succeed "," do
                  %em The arc space of a toric variety
                %a{:href => "http://dx.doi.org/10.1016/j.jalgebra.2003.12.015"} doi
                %a{:href => "http://arxiv.org/abs/math/0312324"} arxiv/0312324
            %li
              %p
                L Ein, R Lazarsfeld, M Mustaţǎ,
                = succeed "," do
                  %em Contact loci in arc spaces
                %a{:href => "http://arxiv.org/abs/math/0303268"} math.AG/0303268
            %li
              %p
                M Mustaţǎ,
                = succeed "," do
                  %em Jet schemes of locally complete intersection canonical singularities
                = succeed "," do
                  %em Singularities of pairs via jet schemes
            %li
              %p
                Cobo Pablos, H. and González Pérez, Pedro Daniel (2012) Motivic Poincaré series, toric singularities and logarithmic Jacobian ideals. Journal of algebraic geometry, 21 (3) 495-529
                %a{:href => "http://www.ams.org/journals/jag/2012-21-03/S1056-3911-2011-00567-5/S1056-3911-2011-00567-5.pdf"} pdf
            %li
              %p
                Dave Anderson, Alan Stapledon,
                = succeed "," do
                  %em Arc spaces and equivariant cohomology
            %li
              %p
                J. Nicaise,
                = succeed "," do
                  %em Arcs and resolution of singularities
            %li
              %p
                W. Veys,
                = succeed "," do
                  %em Arc spaces, motivic integration and stringy invariants
          %p See also Corollary 4.4 in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bhargav+Bhatt"}> Bhargav Bhatt
              ,
              = succeed "," do
                %em Algebraization and Tannaka duality
              %p
                Cambridge J. Math.
                = succeed ":" do
                  %strong 4
                %a{:href => "https://doi.org/10.4310/CJM.2016.v4.n4.a1"} doi
                %a{:href => "https://arxiv.org/abs/1404.7483"} arXiv:404.7483
          %p A formal version (ind-scheme) of free loop space for a complex algebraic variety containing the Kontsevich-Denef-Loeser arc scheme is studied in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mikhail+Kapranov"}> Mikhail Kapranov
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Eric+Vasserot"} Eric Vasserot
              = succeed "," do
                %em Vertex algebras and formal loop space
              %a{:href => "https://doi.org/10.1007/s10240-004-0023-9"} doi
              %a{:href => "https://arxiv.org/pdf/math/0107143.pdf"} arXiv:math/0107143
