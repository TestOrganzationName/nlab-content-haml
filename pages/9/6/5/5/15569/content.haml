                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi topol
                                  %mo .
                                  %mspace{:width => "thickmathspace"}
                                  %mi class
                          %mtd
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi Chern
                                  %mspace{:width => "thickmathspace"}
                                  %mi character
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi geometric
                            %mspace{:width => "thickmathspace"}
                            %mi bundles
                            %mspace{:width => "thickmathspace"}
                            %mi with
                            %mspace{:width => "thickmathspace"}
                            %mi flat
                            %mspace{:width => "thickmathspace"}
                            %mi connection
                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mi comparison
                          %mtd
                          %mtd
                            %mi shape
                            %mspace{:width => "thickmathspace"}
                            %mi of
                            %mspace{:width => "thickmathspace"}
                            %mi bundle
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;  connection\;forms\;on\;trivial\;bundles &amp;&amp; \stackrel{de\;Rham\;differential}{\longrightarrow} &amp;&amp; curvature\;forms
                    \\\
                    \&amp; \nearrow &amp; &amp; \searrow &amp; &amp; \nearrow_{\mathrlap{curvature}} &amp;&amp; \searrow^{\mathrlap{de\;Rham\;theorem}}
                    \\\
                    flat\;differential\;forms  &amp;&amp; &amp;&amp; geometric\;bundles\;with \;connection &amp;&amp; &amp;&amp; rationalized\;bundle
                    \\\
                    \&amp; \searrow &amp;  &amp; \nearrow &amp; &amp; \searrow^{\mathrlap{topol.\;class}} &amp;&amp; \nearrow_{\mathrlap{Chern\;character}}
                    \\\
                    \&amp;&amp; geometric\;bundles\;with\;flat\;connection &amp;&amp; \underset{comparison}{\longrightarrow} &amp;&amp; shape\;of\;bundle
                    }
            %p
              In particular, when applied to sheaves of spectra of the form considered in (
              %a{:href => "#BunkeGepner13"}> Bunke-Gepner 13
              ), which effectively embody the construction of
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
              that was proposed in (
              %a.existingWikiWord{:href => "/nlab/show/Quadratic+Functions+in+Geometry%2C+Topology%2C+and+M-Theory"}> Hopkins-Singer 02
              ), then the right part of the hexagon reproduces their defining decomposition as
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
              of
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+valued+differential+form"} L-∞ algebra valued differential form
              along the
              %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
              map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi E
                    %mo ∧
                    %mi H
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} E \to E \wedge H \mathbb{R}
              of plain
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              (see at
              = succeed ")." do
                %em
                  %a{:href => "differential+cohomology+diagram#HopkinsSingerCoefficients"} differential cohomology diagram – Hopkins-Singer coefficients
            %p
              In view of this it is natural to ask if there are more general sheaves of spectra than those proposed in (
              %a.existingWikiWord{:href => "/nlab/show/Quadratic+Functions+in+Geometry%2C+Topology%2C+and+M-Theory"}> Hopkins-Singer 02
              ,
              = succeed ")" do
                %a{:href => "#BunkeGepner13"} Bunke-Gepner 13
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
              %a.maruku-ref{:href => "#HexagonExactness"}
              in view of claim
              %a.maruku-ref{:href => "#Structures"}
              answers this in the most encompassing way:
              %em every
              sheaf of spectra on smooth manifolds, and in fact more generally every
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+type"} stable
              %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type"} cohesive homotopy type
              is meaningfully regarded as a
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
              theory, in that the axiomatics of
              %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
              provides a detailed decomposition of any such into data which behaves just right.
            %p
              It may therefore be useful to regard prop.
              %a.maruku-ref{:href => "#HexagonExactness"}
              as the differential refinement of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                        %annotation{:encoding => "application/x-tex"} \;\;\;
                    proposition
                    %a.maruku-ref{:href => "#HexagonExactness"}
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
                    \=
                    %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology theory
                    \=
                    %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type"} cohesive
                    spectrum
          %h3#twisted_differential_generalized_cohomology Twisted differential generalized cohomology
          %p
            More is true, also
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            is naturally encoded by the axiomatics of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+theory"} cohesive homotopy theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spectra
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spectra(\mathbf{H})
            of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+cohesive+%28%E2%88%9E%2C1%29-topos"} tangent cohesive (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} T\mathbf{H}
            over the point to general cohesive
            %a.existingWikiWord{:href => "/nlab/show/parameterized+spectrum"} parameterized spectrum
            objects:
          .num_prop
            %h6#proposition_6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %mi Spectra
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \hat E \in Spectra(\mathbf{H}) \hookrightarrow T\mathbf{H}
              a spectrum object, the canonical
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              of its
              %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-group"} automorphism ∞-group
              is exhibited by the universal
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat E
              %a.existingWikiWord{:href => "/nlab/show/fiber+%E2%88%9E-bundle"} fiber ∞-bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo [
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mover
                                %mi E
                                %mo{:stretchy => "false"} ^
                            %mtd
                              %mo →
                            %mtd
                              %mover
                                %mi E
                                %mo{:stretchy => "false"} ^
                              %mo{:stretchy => "false"} /
                              %mo{:stretchy => "false"} /
                              %mi Aut
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi E
                                %mo{:stretchy => "false"} ^
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi Aut
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi E
                                %mo{:stretchy => "false"} ^
                              %mo{:stretchy => "false"} )
                      %mo ]
                    %mo ∈
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left[
                    \\array{
                    \\hat E &amp;\to&amp; \hat E//Aut(\hat E)
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; \mathbf{B}Aut(\hat E)
                    }
                    \\right]
                    \\in
                    T \mathbf{H}
                    \\,.
          %p
            %a{:href => "#NSS12"} NSS 12
          .num_prop
            %h6#proposition_7 Proposition
            %p
              For any unstable
              %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type"} cohesive homotopy type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ↪
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H} \hookrightarrow T \mathbf{H}
              the
              %a.existingWikiWord{:href => "/nlab/show/mapping+stack"} mapping stack
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    [X,\hat E//Aut(\hat E)]
                    \\in
                    T \mathbf{H}
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/parameterized+spectrum"} bundle of spectra
              which over a twist
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Pic
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau \colon X \to Pic(\hat E)
              is the
              = succeed "-twisted" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat E
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            See
            %a{:href => "tangent+cohesion#Cohomology"} here
            for details and further discussion.
          %p
            So
            %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
            faithfully axiomatizes “inter-geometric” twisted differential generalized cohomology. In order to find also an “inter-geometric”
            %a.existingWikiWord{:href => "/nlab/show/Weil+uniformization+theorem"} Weil uniformization theorem
            for this we need however to add another axiom, one that makes
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+objects"} infinitesimal objects
            such as
            %a.existingWikiWord{:href => "/nlab/show/formal+disks"} formal disks
            appear explicitly.
          %h3#WeilUniformizationForTwistedDifferentialCohomology Weil uniformization for twisted differential generalized cohomology
          %p To that end, consider again first an example
          #ComplexAnalyticDifferentialCohesion.num_example
            %h6#example_2 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi reduced
                    %mo ⟵
                    %mi S
                    %mo ⟵
                    %msub
                      %mi S
                      %mi infinitesimal
                  %annotation{:encoding => "application/x-tex"} S_{reduced} \longleftarrow S \longleftarrow S_{infinitesimal}
              be one of the following fiber sequence of
              %a.existingWikiWord{:href => "/nlab/show/sites"} sites
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SmoothMfd
                        %mo ⟵
                        %mi FormalSmoothMfd
                        %mo ↩
                        %mi FormalPts
                      %annotation{:encoding => "application/x-tex"} SmoothMfd \longleftarrow FormalSmoothMfd \hookleftarrow FormalPts
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ComplexAnalyticMfd
                        %mo ⟵
                        %mi FormalComplexAnalyticMfd
                        %mo ↩
                        %mi FormalPts
                      %annotation{:encoding => "application/x-tex"} ComplexAnalyticMfd \longleftarrow FormalComplexAnalyticMfd \hookleftarrow FormalPts
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalPts
                  %annotation{:encoding => "application/x-tex"} FormalPts
              is the site of
              %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+points"} infinitesimally thickened points
              with the trivial topology;
            %p
              Under forming
              %a.existingWikiWord{:href => "/nlab/show/hypercomplete+%28%E2%88%9E%2C1%29-topos"} hypercomplete
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-sheaf (∞,1)-topos
              this yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi reduced
                          %mtd
                            %mo ↪
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi infinitesimal
                        %mtr
                          %mtd
                            %mi ComplexAnalytic
                            %mn ∞
                            %mi Grpd
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi FormalComplexAnalytic
                            %mn ∞
                            %mi Grpds
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Infinitesimal
                            %mn ∞
                            %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{H}_{reduced} &amp;\hookrightarrow&amp; \mathbf{H}
                    \&amp;\longrightarrow&amp; \mathbf{H}_{infinitesimal}
                    \\\
                    ComplexAnalytic\infty Grpd
                    \&amp; \longrightarrow &amp; FormalComplexAnalytic\infty Grpds
                    \&amp; \longrightarrow &amp;
                    Infinitesimal\infty Grpd
                    }
            %p
              Here the last item is essentially
              %a.existingWikiWord{:href => "/nlab/show/formal+moduli+problems"} formal moduli problems
              but without the condition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \Gamma(-) = \ast
              and without the condition of
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-presheaf+on+E-%E2%88%9E+rings"} Lurie-infinitesimal cohesion
              (beware the terminology clash), see at
              %a{:href => "differential+cohesive+%28infinity%2C1%29-topos#LieTheory"} differential cohesion – Lie theory
              for more on this.
          #TheDifferentialCohesion.num_prop
            %h6#proposition_8 Proposition
            %p
              In example
              %a.maruku-ref{:href => "#ComplexAnalyticDifferentialCohesion"}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi reduced
                    %mover
                      %mover
                        %mover
                          %mo ⟵
                          %mover
                            %mo ↪
                            %mrow
                        %mo ⟵
                      %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mover
                        %mover
                          %mo ↩
                          %mo ⟶
                        %mo ↩
                      %mo ⟶
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi infinitesimal
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}_{reduced}
                    \\stackrel{\hookrightarrow}{\stackrel{\longleftarrow}{\stackrel{\overset{}{\hookrightarrow}}{\longleftarrow}}}
                    \\mathbf{H}
                    \\stackrel{\longrightarrow}{\stackrel{\hookleftarrow}{\stackrel{\longrightarrow}{\hookleftarrow}}}
                    \\mathbf{H}_{infinitesimal}
            %p
              By going back and forth, the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
              on the left induces a further
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modalities"} adjoint modalities
              which we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℜ
                    %mo ⊣
                    %mi ℑ
                    %mo ⊣
                    %mi &amp;
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    (\Re \dashv \Im \dashv \&amp;)
                    
                    \\colon
                    \\mathbf{H} \to \mathbf{H}
            %p
              which we call
              %em
                %a.existingWikiWord{:href => "/nlab/show/reduction+modality"} reduction modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊣
                  %annotation{:encoding => "application/x-tex"} \dashv
              %em
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊣
                  %annotation{:encoding => "application/x-tex"} \dashv
              %em
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+flat+modality"} infinitesimal flat modality
              \.
            %p
              Moreover,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi infinitesimal
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{infinitesimal}
              satisfies
              %em
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+cohesion"} infinitesimal cohesion
              in that for all objects in here the
              %a.existingWikiWord{:href => "/nlab/show/points-to-pieces+transform"} points-to-pieces transform
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mo →
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \flat \to \Pi
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
          %table
            %thead
              %tr
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
