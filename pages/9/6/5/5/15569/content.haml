                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi a
                        %mn 0
                      %mo +
                      %msub
                        %mi a
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo −
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo +
                      %msub
                        %mi a
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo −
                      %mi x
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo +
                      %mi ⋯
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{C}[ [ (z-x) ] ] = \{ a_0 + a_1 (z-x) + a_2 (z-x)^2 + \cdots \}
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/ring+of+p-adic+numbers"} ring of p-adic numbers
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℚ
                        %mi p
                      %mo =
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi a
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi k
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi k
                      %mo +
                      %mi ⋯
                      %mo +
                      %msub
                        %mi a
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo +
                      %msub
                        %mi a
                        %mn 0
                      %mo +
                      %msub
                        %mi a
                        %mn 1
                      %mi p
                      %mo +
                      %msub
                        %mi a
                        %mn 2
                      %msup
                        %mi p
                        %mn 2
                      %mo +
                      %mi ⋯
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{Q}_p = \{ a_{-k} p^{-k} + \cdots + a_{-1} p^{-1} + a_0 + a_1 p + a_2 p^2 + \cdots  \}
              %p
                is analogous to the
                %a.existingWikiWord{:href => "/nlab/show/ring+of+functions"} ring of functions
                on the pointed formal disk
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo −
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} D - \{x\}
                %a.existingWikiWord{:href => "/nlab/show/Laurent+series"} Laurent series
                ring
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo −
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi a
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi k
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo −
                      %mi x
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi k
                      %mo +
                      %mi ⋯
                      %mo +
                      %msub
                        %mi a
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo −
                      %mi x
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo +
                      %msub
                        %mi a
                        %mn 0
                      %mo +
                      %msub
                        %mi a
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo −
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo +
                      %msub
                        %mi a
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo −
                      %mi x
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo +
                      %mi ⋯
                      %mo{:stretchy => "false"} }
                      %mo ;
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{C}((z-x)) = \{ a_{-k} (z-x)^{-k} + \cdots + a_{-1} (z-x)^{-1} + a_0 + a_1 (z-x) + a_2 (z-x)^2 + \cdots  \};
            %li
              %p
                the subring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ⊂
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[p^{-1}] \subset \mathbb{Q}
                of
                %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
                with denominator a power of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                is analogous to the subring of
                %a.existingWikiWord{:href => "/nlab/show/meromorphic+functions"} meromorphic functions
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                with possible poles at
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
          %p
            Notice that the
            %a.existingWikiWord{:href => "/nlab/show/cover"} cover
            of the
            %a.existingWikiWord{:href => "/nlab/show/complex+curve"} complex curve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            involved in the
            %a.existingWikiWord{:href => "/nlab/show/Weil+uniformization+theorem"} Weil uniformization theorem
            is exhibited by the following
            %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
            diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Σ
                          %mo −
                          %mo{:stretchy => "false"} {
                          %mi x
                          %mo{:stretchy => "false"} }
                      %mtr
                        %mtd
                        %mtd
                          %mo ↗
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mi D
                          %mo −
                          %mo{:stretchy => "false"} {
                          %mi x
                          %mo{:stretchy => "false"} }
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi Σ
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↗
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi D
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \Sigma-\{x\}
                  \\\
                  \&amp;  \nearrow &amp;&amp; \searrow
                  \\\
                  D-\{x\} &amp;&amp; &amp;&amp; \Sigma
                  \\\
                  \&amp; \searrow &amp;&amp; \nearrow
                  \\\
                  \&amp;&amp; D
                  }
          %p
            Indeed, in further support of this
            %a.existingWikiWord{:href => "/nlab/show/analogy"} analogy
            one may see that also the
            %a.existingWikiWord{:href => "/nlab/show/p-adic+integers"} p-adic integers
            together with the
            %a.existingWikiWord{:href => "/nlab/show/rational+functions"} rational functions
            form a “good enough cover” of the “
            %a.existingWikiWord{:href => "/nlab/show/F1"}> F1
            \-
            %a.existingWikiWord{:href => "/nlab/show/arithmetic+curve"}> arithmetic curve
            ”
            %a.existingWikiWord{:href => "/nlab/show/Spec%28Z%29"} Spec(Z)
            of this form. This is the statement of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/arithmetic+fracture+square"} arithmetic fracture square
          #ArithmeticFractureSquare.num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              are the
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              of all the
              %a.existingWikiWord{:href => "/nlab/show/p-adic+integers"} p-adic integers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi p
                        %mspace{:width => "thickmathspace"}
                        %mi prime
                    %msub
                      %mi ℤ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \underset{p\;prime}{\prod} \mathbb{Z}_p
              with the
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              over the
              %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
              of the former, hence there is a
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi ℚ
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↖
                        %mtr
                          %mtd
                            %mi ℚ
                            %msub
                              %mo ⊗
                              %mi ℤ
                            %mrow
                              %mo (
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                                %mrow
                                  %mi p
                                  %mspace{:width => "thickmathspace"}
                                  %mi prime
                              %msub
                                %mi ℤ
                                %mi p
                              %mo )
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi ℤ
                        %mtr
                          %mtd
                          %mtd
                            %mo ↖
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi p
                                %mspace{:width => "thickmathspace"}
                                %mi prime
                            %msub
                              %mi ℤ
                              %mi p
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathbb{Q}
                    \\\
                    \&amp; \swarrow &amp;&amp; \nwarrow
                    \\\
                    \\mathbb{Q}\otimes_{\mathbb{Z}}\left(\underset{p\;prime}{\prod} \mathbb{Z}_p \right) &amp;&amp; &amp;&amp; \mathbb{Z}
                    \\\
                    \&amp; \nwarrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; \underset{p\;prime}{\prod} \mathbb{Z}_p
                    }
                    \\,.
            %p
              Equivalently this is the
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              of the rationals with the
              %a.existingWikiWord{:href => "/nlab/show/integral+adeles"} integral adeles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔸
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}_{\mathbb{Z}}
              over the
              %a.existingWikiWord{:href => "/nlab/show/ring+of+adeles"} ring of adeles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔸
                      %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}_{\mathbb{Q}}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi ℚ
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↖
                        %mtr
                          %mtd
                            %msub
                              %mi 𝔸
                              %mi ℚ
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi ℤ
                        %mtr
                          %mtd
                          %mtd
                            %mo ↖
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi 𝔸
                              %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathbb{Q}
                    \\\
                    \&amp; \swarrow &amp;&amp; \nwarrow
                    \\\
                    \\mathbb{A}_{\mathbb{Q}} &amp;&amp; &amp;&amp; \mathbb{Z}
                    \\\
                    \&amp; \nwarrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; \mathbb{A}_{\mathbb{Z}}
                    }
                    \\,,
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/ring+of+adeles"} ring of adeles
              is the
              %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
              of the integral adeles
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔸
                        %mi ℚ
                      %mo =
                      %mi ℚ
                      %msub
                        %mo ⊗
                        %mi ℤ
                      %msub
                        %mi 𝔸
                        %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}_{\mathbb{Q}} = \mathbb{Q} \otimes_{\mathbb{Z}} \mathbb{A}_{\mathbb{Z}}
              = succeed ")" do
                %a{:href => "category+of+monoids#PushoutOfCommutativeMonoids"} here
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              diagram in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
              %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
              (for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              with the
              %a.existingWikiWord{:href => "/nlab/show/discrete+topology"} discrete topology
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔸
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}_{\mathbb{Z}}
              with its profinite/
              %a.existingWikiWord{:href => "/nlab/show/completion+of+a+ring"} completion
              topology).
          %p
            The statement of prop.
            %a.maruku-ref{:href => "#ArithmeticFractureSquare"}
            immediately lifts to flat finitely generated torsion free
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/completion+of+modules"} completion of modules
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            regarded as
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-modules"} ∞-modules
            over the
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}
          #SullivanArithmeticFracture.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (Sullivan
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/arithmetic+fracture+square"} arithmetic fracture square
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              the canonical square diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mi ℚ
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↖
                        %mtr
                          %mtd
                            %msub
                              %mrow
                                %mo (
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                                  %mi p
                                %msubsup
                                  %mi X
                                  %mi p
                                  %mo ∧
                                %mo )
                              %mi ℚ
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ↖
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi p
                            %msubsup
                              %mi X
                              %mi p
                              %mo ∧
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    
                    \&amp;&amp; X_{\mathbb{Q}}
                    \\\
                    \&amp; \swarrow &amp;&amp; \nwarrow
                    \\\
                    \\left(
                    \\prod_p X_p^{\wedge}
                    \\right)_{\mathbb{Q}}
                    \&amp;&amp;  &amp;&amp;
                    X
                    \\\
                    \&amp; \nwarrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; \prod_p X_p^\wedge
                    }
            %p
              formed by
              %a.existingWikiWord{:href => "/nlab/show/p-completion"} p-completion
              and
              %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
              of spectra is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              square (hence a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
              square).
          %p
            Moreover, the
            %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
            eventually relates the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+bundles"} moduli stack of bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bun
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Bun_{\Sigma}(G)
            realized via
            %a.existingWikiWord{:href => "/nlab/show/Weil+uniformization"} Weil uniformization
            with respect to such “fracture cover” to a
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+local+systems"} moduli stack of local systems
            (
            %a.existingWikiWord{:href => "/nlab/show/flat+connections"}> flat connections
            ) by identifying
            %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaves"} quasicoherent sheaves
            on one side with
            %a.existingWikiWord{:href => "/nlab/show/D-modules"} D-modules
            on the other
          %p
            “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi 𝒪
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Loc
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mrow
                    %msup
                      %mrow
                      %mi L
                    %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mo ≃
                  %mi 𝒟
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Bun
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{O}Mod(Loc_{\Sigma}({{}^L G}))
                  \\stackrel{\simeq}{\longrightarrow}
                  \\mathcal{D} Mod( Bun_{\Sigma}(G))
            ”
          %p
            Hence in order to systematize the implementation of such consideration in various flavors of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
          %ol
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"}> differential cohomology
                ;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/D-geometry"}> D-geometry
                \.
          %p
            Such an axiomatics we turn to now, recalling how it has implementations in
            %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher differential geometry
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+complex+analytic+geometry"} higher complex analytic geometry
            %a{:href => "#ArithmeticCohesion"} below
            we discuss how the axioms also have implementation in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+arithmetic+geometry"} E-∞ arithmetic geometry
            %a.existingWikiWord{:href => "/nlab/show/fracture+squares"} fracture squares
            and hence an “automorphic” incarnation of all
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stacks"} moduli ∞-stacks
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+gauge+fields"} higher gauge fields
          %h2#AxiomaticDifferentialCohomology
            %strong 2)
            Axiomatic twisted differential generalized cohomology
          %p
            The
            %a{:href => "LanglandsAndWeil"} above
            %a.existingWikiWord{:href => "/nlab/show/analogy"} analogy
            calls for being formalized. We need an axiomatics that allows to implement differential geometry in systematic analogy. Just as back in the old days there was established a systematic analogy
          %table
            %thead
              %tr
                %th
                  %a.existingWikiWord{:href => "/nlab/show/synthetic+geometry"} synthetic geometry
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+geometry"} Euclidean geometry
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/hyperbolic+geometry"} hyperbolic geometry
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/elliptic+geometry"} elliptic geometry
          %p for modern applications we need a systematic dictionary of the form
          %table
            %thead
              %tr
                %th
                  %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} higher synthetic differential geometry
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher differential geometry
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/higher+complex+analytic+geometry"} higher complex analytic geometry
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+arithmetic+geometry"} higher arithmetic geometry
          %p
            We will discuss here how this may be done via the axiomatics called
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+theory"} cohesive homotopy theory
            and
            %em
              %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
            in (
            %a{:href => "#Schreiber13"}> Schreiber 13
            ).
          %h3#differential_generalized_cohomology Differential generalized cohomology
          %p To that end, first consider the following flavors of geometry.
          #TheSites.num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              denote either of the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/sites"} sites
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SmoothMfd
                      %annotation{:encoding => "application/x-tex"} SmoothMfd
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ComplexAnalyticMfd
                      %annotation{:encoding => "application/x-tex"} ComplexAnalyticMfd
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/complex+analytic+manifolds"} complex analytic manifolds
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SuperMfd
                      %annotation{:encoding => "application/x-tex"} SuperMfd
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi FormalSmoothhMfd
                      %annotation{:encoding => "application/x-tex"} FormalSmoothhMfd
                  ,
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi FormalComplexAnalyticMfd
                        %annotation{:encoding => "application/x-tex"} FormalComplexAnalyticMfd
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi FormalSuperMfd
                      %annotation{:encoding => "application/x-tex"} FormalSuperMfd
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/formal+manifolds"} formal manifolds
              %li
                %p
                  any
                  %a.existingWikiWord{:href => "/nlab/show/site"} site
                  such that
                %ol
                  %li
                    %p
                      it has
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
                  %li
                    %p
                      every object is locally of
                      %a.existingWikiWord{:href => "/nlab/show/contractible+space"} contractible
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/etale+homotopy+type"} etale homotopy type
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} Hom(\ast, -)
                      preserves
                      = succeed "." do
                        %a.existingWikiWord{:href => "/nlab/show/split+hypercovers"} split hypercovers
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ≔
                    %msub
                      %mi Sh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi L
                      %mi lwhe
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H} \coloneqq Sh_\infty(S) \simeq L_{lwhe} sPSh(S)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              obtained from the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              by universally turning local (stalkwise)
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
              into actual
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
              (i.e. the
              %a.existingWikiWord{:href => "/nlab/show/hypercomplete+%28%E2%88%9E%2C1%29-topos"} hypercomplete
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
              over this site.
            %p Write specifically
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Smooth
                        %mn ∞
                        %mi Grpd
                        %mo ≔
                        %msub
                          %mi Sh
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi SmoothMfd
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Smooth \infty Grpd\coloneqq Sh_\infty(SmoothMfd)
                  –
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-groupoids
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ComplexAnalytic
                        %mn ∞
                        %mi Grpd
                        %mo ≔
                        %msub
                          %mi Sh
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi ComplexAnalyticMfd
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} ComplexAnalytic \infty Grpd\coloneqq Sh_\infty(ComplexAnalyticMfd)
                  –
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/complex+analytic+%E2%88%9E-groupoids"} complex analytic ∞-groupoids
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SmoothSuper
                        %mn ∞
                        %mi Grpd
                        %mo ≔
                        %msub
                          %mi Sh
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi SmoothSuperMfd
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SmoothSuper \infty Grpd\coloneqq Sh_\infty(SmoothSuperMfd)
                  –
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+super+%E2%88%9E-groupoids"} smooth super ∞-groupoids
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi FormalSmooth
                        %mn ∞
                        %mi Grpd
                        %mo ≔
                        %msub
                          %mi Sh
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi FormalSmoothMfd
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} FormalSmooth\infty Grpd \coloneqq Sh_\infty(FormalSmoothMfd)
                  –
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+%E2%88%9E-groupoid"} formal smooth ∞-groupoids
          #TheHomotopyTheoriesAreCohesive.num_prop
            %h6#proposition_3 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theories"} homotopy theories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              from example
              %a.maruku-ref{:href => "#TheSites"}
              have the property that there is an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
              of
              %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
              (
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functors"}> (∞,1)-functors
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mover
                        %mover
                          %mo ↩
                          %mo ⟶
                        %mo ↩
                      %mo ⟶
                    %mn ∞
                    %mi Grpd
                    %mo ≃
                    %msub
                      %mi L
                      %mi whe
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H} \stackrel{\longrightarrow}{\stackrel{\hookleftarrow}{\stackrel{\longrightarrow}{\hookleftarrow}}}
                    \\infty Grpd \simeq L_{whe} Top
            %p
              such that the top
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              preserves
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              and the bottom
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} fully faithful embedding
            %p
              By going back and forth this induces an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              of
              %a.existingWikiWord{:href => "/nlab/show/idempotent+%28%E2%88%9E%2C1%29-monads"} (∞,1)-comonads
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              which we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo ⊣
                    %mo ♭
                    %mo ⊣
                    %mo ♯
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi \dashv \flat \dashv \sharp) \colon \mathbf{H} \to \mathbf{H}
            %p
              and call, respectively:
              %em
                %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊣
                  %annotation{:encoding => "application/x-tex"} \dashv
              %em
                %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊣
                  %annotation{:encoding => "application/x-tex"} \dashv
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
          %p
            Following 1-categorical terminology proposed by
            %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"} William Lawvere
            (see at
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
          .num_defn
            %h6#definition Definition
            %p
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} Homotopy theories
              with the properties as in prop.
              %a.maruku-ref{:href => "#TheHomotopyTheoriesAreCohesive"}
              we call
              %em
                %span.newWikiWord
                  cohesive homotopy theories
                  %a{:href => "/nlab/new/cohesive+homotopy+theories"} ?
              (
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-toposes"}> cohesive (∞,1)-toposes
              ).
          %p
            It is commonplace that a single
            %a.existingWikiWord{:href => "/nlab/show/idempotent+%28%E2%88%9E%2C1%29-monad"} idempotent (∞,1)-monad
            such as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28%E2%88%9E%2C1%29-category"} localization
            of a homotopy theory, and that a sincle idempotent co-monad such as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♭
                %annotation{:encoding => "application/x-tex"} \flat
            is equivalently a co-localization.
          %p
            Lawvere argued since the 1990s (see
            = succeed ")" do
              %a{:href => "cohesive%20topos#References"} here
            %a.existingWikiWord{:href => "/nlab/show/adjoint+pairs"} adjoint pairs
            and more so of
            %a.existingWikiWord{:href => "/nlab/show/adjoint+triples"} adjoint triples
            of these on a category – “
            %a.existingWikiWord{:href => "/nlab/show/adjoint+modalities"}> adjoint modalities
            ” – is a remarkably expressive structure for axiomatizing
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
            = succeed ")" do
              %a{:href => "#Schreiber13"} Schreiber 13
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            this is considerably more so the case:
          #Structures.num_prop
            %h6#claim Claim
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Π
                      %annotation{:encoding => "application/x-tex"} \Pi
                  is naturally thought of as sending each
                  %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+type"} geometric homotopy type
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
                  to its
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Π
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \Pi X
                  of geometric paths inside it, equivalently to its
                  = succeed ";" do
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♭
                      %annotation{:encoding => "application/x-tex"} \flat
                  is naturally thought of as sending each
                  %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}G
                  of
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♭
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \flat\mathbf{B}G
                  of
                  = succeed ";" do
                    %strong
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi G
                          %annotation{:encoding => "application/x-tex"} G
                      \-
                      %a.existingWikiWord{:href => "/nlab/show/flat+%E2%88%9E-connections"} principal flat ∞-connections
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ♭
                          %mi{:mathvariant => "normal"} dR
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \flat_{\mathrm{dR}}G
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/counit+of+a+comonad"} counit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♭
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \flat \mathbf{B}G \to \mathbf{B}G
                  is naturally thought of as sending the moduli
                  = succeed "-stack" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                  = succeed ";" do
                    %strong
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi 𝔤
                          %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                      \-
                      %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+valued+differential+forms"} L-∞ algebra valued differential forms
              %li
                %p
                  the canonical map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi θ
