                  are moduli
                  = succeed "-stacks" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msub
                          %mi G
                          %mi conn
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn}
                  of non-flat
                  = succeed ";" do
                    %strong
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi G
                          %annotation{:encoding => "application/x-tex"} G
                      \-
                      %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-connections"} principal ∞-connections
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♯
                      %annotation{:encoding => "application/x-tex"} \sharp
                  serves to produce various more suble
                  = succeed "," do
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stacks"} moduli ∞-stacks
                %ul
                  %li
                    %p
                      given a
                      %a.existingWikiWord{:href => "/nlab/show/Hodge+filtration"} Hodge filtration
                      on
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mo ♭
                              %mi dR
                            %mi G
