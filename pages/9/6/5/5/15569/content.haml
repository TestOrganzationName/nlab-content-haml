                          %annotation{:encoding => "application/x-tex"} \Pi^{rel}_{dR}(X)
                      whose function spaces are
                      %a.existingWikiWord{:href => "/nlab/show/rationalizations"} rationalizations
                      of function spaces on
                      = succeed "." do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi X
                            %annotation{:encoding => "application/x-tex"} X
                  %li
                    %p
                      relative flat modality
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mo ♭
                              %mi rel
                          %annotation{:encoding => "application/x-tex"} \flat^{rel}
                      creates collections of
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/formal+disks"} formal disks
                  %li
                    %p
