          #PiInf.num_prop
            %h6#claim_2 Claim
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℑ
                  %annotation{:encoding => "application/x-tex"} \Im
              is naturally thought of as producing
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+space"} de Rham space
              objects. In particular:
            %ol
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo ∈
                        %mi Grp
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G \in Grp(\mathbf{H})
                  an
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
                  object then the
                  %a.existingWikiWord{:href => "/nlab/show/mapping+stack"} mapping stack
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Loc
                          %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mo{:stretchy => "false"} [
                        %mi ℑ
                        %mi Σ
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        Loc_\Sigma(G) \coloneqq [\Im \Sigma, \mathbf{B}G]
                %p
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
                  of
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/local+systems"} local systems
                  on any
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Σ
                          %mo ∈
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                        %annotation{:encoding => "application/x-tex"} \Sigma \in \mathbf{H}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaves"} quasicoherent sheaves
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℑ
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \Im X
                  are
                  %a.existingWikiWord{:href => "/nlab/show/D-modules"} D-modules
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
          .num_remark
            %h6#remark_2 Remark
            %p
              In terms of claim
              %a.maruku-ref{:href => "#PiInf"}
              then the statement of the
              %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
              is that there is a natural
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℑ
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Im[\Sigma, \mathbf{B}G]
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi ℑ
                      %mi Σ
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msup
                        %mrow
                        %mi L
                      %mi G
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\Im\Sigma, \mathbf{B}{}^L G]
          #relativecohesionmodalities.num_defn
            %h6#definition_2 Definition
            %p
              Since by prop.
              %a.maruku-ref{:href => "#TheDifferentialCohesion"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is cohesive also over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi infinitesimal
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}_{infinitesimal}
              %em relative
              modalities
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Π
                      %mi rel
                    %mo ⊣
                    %msup
                      %mo ♭
                      %mi rel
                    %mo ⊣
                    %msup
                      %mo ♯
                      %mi rel
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi infinitesimal
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi^{rel} \dashv \flat^{rel} \dashv \sharp^{rel})
                    \\;\colon\;
                    \\mathbf{H} \to \mathbf{H}_{infinitesimal} \to \mathbf{H}
            %p
              which we call the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/relative+shape+modality"} relative shape modality
              %em
                %a.existingWikiWord{:href => "/nlab/show/relative+flat+modality"} relative flat modality
              and
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/relative+sharp+modality"} relative sharp modality
          %p
            See (
            %a{:href => "#Schreiber13"}> Schreiber 13, 3.10.10
            ).
          .num_prop
            %h6#proposition_9 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ∈
                    %mi ComplexAnalyticMfd
                    %mo ↪
                    %mi ComplexAnalytic
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \Sigma\in ComplexAnalyticMfd \hookrightarrow ComplexAnalytic\infty Grpd
              then the relative flat modality, def.
              = succeed "," do
                %a.maruku-ref{:href => "#relativecohesionmodalities"}
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ♭
                      %mi rel
                    %mi Σ
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi x
                        %mo ∈
                        %mi Σ
                    %msub
                      %mi D
                      %mi x
                  %annotation{:encoding => "application/x-tex"}
                    \\flat^{rel} \Sigma \simeq \underset{x \in \Sigma}{\coprod} D_{x}
            %p
              of all
              %a.existingWikiWord{:href => "/nlab/show/formal+disks"} formal disks
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi x
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} D_x \hookrightarrow \Sigma
              around points
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} x \in \Sigma
          %p
            See (
            %a{:href => "#Schreiber13"}> Schreiber 13, 5.6.1.4
            ).
          .num_remark
            %h6#remark_3 Remark
            %p
              In summary, the
              %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesive
              structure is reflected in the existence of a triple of triples of operations that naturally exist on all objects in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
                %ul
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Π
                          %annotation{:encoding => "application/x-tex"} \Pi
                      gives
                      = succeed "/" do
                        %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo ♭
                          %annotation{:encoding => "application/x-tex"} \flat
                      gives underlying point sets and moduli for
                      = succeed "/" do
                        %a.existingWikiWord{:href => "/nlab/show/flat+%E2%88%9E-connections"} flat ∞-connections
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/local+systems"} local systems
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
