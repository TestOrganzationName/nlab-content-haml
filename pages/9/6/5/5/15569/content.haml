                      then this is a
                      %strong
                        %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+complex+structures"} moduli stack of complex structures
                      on
                      = succeed "." do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi Σ
                            %annotation{:encoding => "application/x-tex"} \Sigma
          %p
            This is quite a bit of structure, concisely axiomatized by the presence of the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+modalities"} adjoint modalities
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo ⊣
