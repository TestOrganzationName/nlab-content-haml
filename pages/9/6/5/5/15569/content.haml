                      induces
                      %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli stacks
                      for non-flat
                      %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connections"} ∞-connections
                      (via
                      %a.existingWikiWord{:href => "/nlab/show/differential+concretification"} differential concretification
                      of the naive mapping stacks);
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+cohesion"} infinitesimal cohesion
                %ul
                  %li
                    %p
                      relative shape modality
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
