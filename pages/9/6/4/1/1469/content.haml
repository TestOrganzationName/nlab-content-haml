                            ,
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/module+spectrum"} module spectrum
                            %a.existingWikiWord{:href => "/nlab/show/algebra+spectrum"} algebra spectrum
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebra"} A-∞ algebra
                      %ul
                        %li
                          %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+ring"}> A-∞ ring
                          ,
                          %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+space"} A-∞ space
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/C-%E2%88%9E+algebra"} C-∞ algebra
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"}> E-∞ ring
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+algebra"} E-∞ algebra
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-module"}> ∞-module
                            ,
                            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module+bundle"} (∞,1)-module bundle
                        %li
                          %p
