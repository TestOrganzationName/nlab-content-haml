              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} \mathbf{Z}
          .num_defn
            %h6#definition Definition
            %p
              The
              %strong mass
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              is the sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi q
                        %mo ′
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi O
                          %mrow
                            %mi q
                            %mo ′
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi Z
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \sum_{q'} \frac{1}{|O_{q'}(\mathbf{Z})|}
            %p
              taken over the positive-definite
              %a.existingWikiWord{:href => "/nlab/show/quadratic+forms"} quadratic forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} q'
              in the genus of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathbf{A}
            be the ring of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/adeles"} adeles
            %a.existingWikiWord{:href => "/nlab/show/locally+compact"} locally compact
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            containing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Q
                %annotation{:encoding => "application/x-tex"} \mathbf{Q}
            as a
            %a.existingWikiWord{:href => "/nlab/show/discrete"} discrete
            subring.
          .num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O_q(\mathbf{A})
              denote the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi q
                        %mstyle{:mathvariant => "bold"}
                          %mi A
                    %annotation{:encoding => "application/x-tex"} q_\mathbf{A}
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi A
                    %annotation{:encoding => "application/x-tex"} \mathbf{A}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi SO
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi O
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO_q(\mathbf{A}) \subset O_q(\mathbf{A})
              denote the subgroup of
              %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
              with
              %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
              1.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi SO
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SO_q(\mathbf{A})
            is a
            %a.existingWikiWord{:href => "/nlab/show/locally+compact"} locally compact
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            containing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi SO
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi Q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SO_q(\mathbf{Q})
            as a
            %a.existingWikiWord{:href => "/nlab/show/discrete"} discrete
            subgroup and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi SO
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                    %mo{:stretchy => "false"} ^
                  %mo ×
                  %mstyle{:mathvariant => "bold"}
                    %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SO_q(\hat{\mathbf{Z}} \times \mathbf{R})
            as a
            %a.existingWikiWord{:href => "/nlab/show/compact"} compact
            %a.existingWikiWord{:href => "/nlab/show/open"} open
            subgroup.
          .num_theorem
            %h6#theorem Theorem
            %p
              %strong> (Tamagawa-Weil reformulation of Siegel mass formula)
              \. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi{:mathvariant => "normal"} Tam
                  %annotation{:encoding => "application/x-tex"} \mu_{\mathrm{Tam}}
              denote the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Tamagawa+measure"} Tamagawa measure
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi{:mathvariant => "normal"} Tam
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi SO
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                    %mo{:stretchy => "false"} )
                    %mo \
                    %msub
                      %mi SO
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 2
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \mu_{\mathrm{Tam}}(SO_q(\mathbf{Q}) \backslash SO_q(\mathbf{A})) = 2.
            %p Equivalently,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi{:mathvariant => "normal"} Tam
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Spin
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                    %mo{:stretchy => "false"} )
                    %mo \
                    %msub
                      %mi Spin
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \mu_{\mathrm{Tam}}(Spin_q(\mathbf{Q})\backslash Spin_q(\mathbf{A})) = 1,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Spin
                      %mi q
                  %annotation{:encoding => "application/x-tex"} \Spin_q
              is the 2-fold universal cover of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi SO
                        %mi q
                    %annotation{:encoding => "application/x-tex"} SO_q
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              %strong>
                (Langlands-Lai-Kottwitz, “
                %a.existingWikiWord{:href => "/nlab/show/Weil+conjecture"}> Weil conjecture
                ”)
              \. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a semisimple simply-connected
              %a.existingWikiWord{:href => "/nlab/show/algebraic+group"} algebraic group
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Q
                    %annotation{:encoding => "application/x-tex"} \mathbf{Q}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi{:mathvariant => "normal"} Tam
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                    %mo{:stretchy => "false"} )
                    %mo \
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \mu_{\mathrm{Tam}}(G(\mathbf{Q})\backslash G(\mathbf{A})) = 1.
          %h3#FunctionFieldCase Function field case
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/smooth"} smooth
            %a.existingWikiWord{:href => "/nlab/show/projective+variety"} projective
            %a.existingWikiWord{:href => "/nlab/show/curve"} curve
            over the
            %a.existingWikiWord{:href => "/nlab/show/finite+field"} finite field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi q
                  %annotation{:encoding => "application/x-tex"} F_q
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mi X
                %annotation{:encoding => "application/x-tex"} K_X
            denote the
            %a.existingWikiWord{:href => "/nlab/show/function+field"} function field
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi x
                %annotation{:encoding => "application/x-tex"} O_x
            for the
            %a.existingWikiWord{:href => "/nlab/show/completion"} completion
            of the
            %a.existingWikiWord{:href => "/nlab/show/local+ring"} local ring
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mi x
                %annotation{:encoding => "application/x-tex"} K_x
            for its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fraction+field"} fraction field
          .num_defn
            %h6#definition_3 Definition
            %p
              The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/ring+of+adeles"} ring of adeles
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi X
                    %annotation{:encoding => "application/x-tex"} K_X
              is defined as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi A
                      %mi X
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi x
                      %mi res
                    %msub
                      %mi K
                      %mi x
                    %mo ⊂
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi x
                    %msub
                      %mi K
                      %mi x
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \mathbf{A}_X = \product^{res}_x K_x \subset \product_x K_x,
            %p
              i.e. the subgroup consisting of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi g
                      %mi x
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \{g_x\}_{x \in X}
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \in G(O_x)
              for all but finitely many
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{A}_X
            is a
            %a.existingWikiWord{:href => "/nlab/show/locally+compact"} locally compact
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            with
            %a.existingWikiWord{:href => "/nlab/show/discrete"} discrete
            subring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi X
                    %mo ⊂
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi A
                      %mi X
                  %annotation{:encoding => "application/x-tex"} K_X \subset \mathbf{A}_X
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 0
                %annotation{:encoding => "application/x-tex"} G_0
            be a semisimple simply-connected linear
            %a.existingWikiWord{:href => "/nlab/show/algebraic+group"} algebraic group
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi X
                  %annotation{:encoding => "application/x-tex"} K_X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi K
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %msub
                    %mi G
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G_0(K_X) \subset G_0(\mathbf{A})
            is a
            %a.existingWikiWord{:href => "/nlab/show/discrete"} discrete
            subgroup of the
            %a.existingWikiWord{:href => "/nlab/show/locally+compact"} locally compact
            group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G_0(\mathbf{A})
            %a.existingWikiWord{:href => "/nlab/show/Tamagawa+measure"} Tamagawa measure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G(\mathbf{A})
            in a similar way as usual, i.e. by choosing a
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            and multiplying the forms on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi K
                    %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G_0(K_x)
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x \in X
            ). Then the
            %a.existingWikiWord{:href => "/nlab/show/function+field"} function field
            version of
            %a.existingWikiWord{:href => "/nlab/show/Weil%27s+conjecture"} Weil's conjecture
            is
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              %strong> (Gaitsgory-Lurie, “Weil conjecture for function fields”)
              \. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth"} smooth
              %a.existingWikiWord{:href => "/nlab/show/projective+variety"} projective
              %a.existingWikiWord{:href => "/nlab/show/curve"} curve
              over the
              %a.existingWikiWord{:href => "/nlab/show/finite+field"} finite field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi q
                    %annotation{:encoding => "application/x-tex"} F_q
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi{:mathvariant => "normal"} Tam
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi K
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo \
                    %msub
                      %mi G
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi A
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \mu_{\mathrm{Tam}}(G_0(K_X)\backslash G_0(\mathbf{A}_X)) = 1.
          %p
            This was proved by
            %a.existingWikiWord{:href => "/nlab/show/Dennis+Gaitsgory"} Dennis Gaitsgory
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Jacob Lurie
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            of the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+G-principal+bundles"} moduli stack of G-principal bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bun
                    %mi G
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Bun_G(X)
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/function+field+analogy"} function field analogy
          #RelationToModuliStack.num_remark
            %h6#remark Remark
            %p
              Under the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/function+field+analogy"} function field analogy
              %a.existingWikiWord{:href => "/nlab/show/global+field"} global field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi X
                  %annotation{:encoding => "application/x-tex"} K_X
              such as a
              %a.existingWikiWord{:href => "/nlab/show/function+field"} function field
              or a
              %a.existingWikiWord{:href => "/nlab/show/number+field"} number field
              is interpreted as the field of
              %a.existingWikiWord{:href => "/nlab/show/global+sections"} global sections
              of the
              %a.existingWikiWord{:href => "/nlab/show/rational+functions"} rational functions
              on an
              %a.existingWikiWord{:href => "/nlab/show/arithmetic+curve"} arithmetic curve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              over a
              %a.existingWikiWord{:href => "/nlab/show/finite+field"} finite field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi q
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_q
              or “over
              = succeed "\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/field+with+one+element"} field with one element
              %a.existingWikiWord{:href => "/nlab/show/analogy"} analogy
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/ring+of+adeles"} ring of adeles
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔸
                          %mi X
                      %annotation{:encoding => "application/x-tex"} \mathbb{A}_X
                  is the ring of functions on all punctured
                  %a.existingWikiWord{:href => "/nlab/show/formal+disks"} formal disks
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  subject to the condition that all but at most finitely many of them extend to the un-punctured disk;
              %li
                %p
                  accordingly
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝔸
                          %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G(\mathbb{A}_X)
                  is the group of
                  = succeed "-valued" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi K
                          %mi X
                        %mo \
                        %msub
                          %mi 𝔸
                          %mi X
                      %annotation{:encoding => "application/x-tex"} K_{X}\backslash \mathbb{A}_{X}
                  is hence the quotient of such functions on punctured formal disks around finitely many points by the functions on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                  with these finitely many points removed; and similarly
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi K
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo \
                        %mi G
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝔸
                          %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G(K_X)\backslash G(\mathbb{A}_X)
                  is the quotient of group-valued such function;
              %li
                %p
                  the ring
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒪
                      %annotation{:encoding => "application/x-tex"} \mathcal{O}
                  is the ring of functions on all formal disks in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Σ
                        %annotation{:encoding => "application/x-tex"} \Sigma
              %li
                %p
                  hence the further double
                  %a.existingWikiWord{:href => "/nlab/show/quotient+stack"} quotient stack
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Bun
                          %mi G
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi G
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi K
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo \
                        %mi G
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝔸
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} /
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mi 𝒪
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Bun_G(X) = G(K_X)\backslash G(\mathbb{A}_X)//G(\mathcal{O})
                %p
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                  of
                  %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cocycles
                  with Cech coboundaries between them for
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
                  relative to
                  %a.existingWikiWord{:href => "/nlab/show/covers"} covers
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                  with patches being the complement of finitely many points and the formal disks around these points.
            %p
              For more on this see at
              = succeed "." do
                %em
                  %a{:href => "http://ncatlab.org/nlab/show/moduli+space+of+bundles#OverCurvesAndTheLanglandsCorrespondence"} moduli space of bundles – over curves
          %p
            First they proved a
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck-Lefschetz+trace+formula"} Grothendieck-Lefschetz trace formula
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Bun
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Bun_G(X)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Kai+Behrend"} Kai Behrend
          .num_theorem
            %h6#theorem_4 Theorem
            %p
              %strong>
                (Gaitsgory-Lurie, “Grothendieck-Lefschetz trace formula for
                = succeed "\u201D)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Bun
                          %mi G
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Bun_G(X)
              \. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth"} smooth
              %a.existingWikiWord{:href => "/nlab/show/projective+variety"} projective
              %a.existingWikiWord{:href => "/nlab/show/curve"} curve
              over the
              %a.existingWikiWord{:href => "/nlab/show/finite+field"} finite field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi q
                    %annotation{:encoding => "application/x-tex"} F_q
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi Bun
                          %mi G
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi F
                          %mi q
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi q
                          %mrow
                            %mi dim
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Bun
                              %mi G
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ≥
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mi{:mathvariant => "normal"} Tr
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Frob
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %msup
                      %mi H
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi Bun
                        %mo ¯
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Q
                      %mi ℓ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \frac{|Bun_G(X)(\mathbf{F}_q)|}{q^{\dim(Bun_G(X))}} = \sum_{i \ge 0} (-1)^i \mathrm{Tr}(Frob^{-1} \mid H^i(\overline{Bun}_G(X) ; \mathbf{Q}_\ell)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi Bun
                        %mo ¯
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \overline{Bun}_G(X)
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Bun
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Bun_G(X)
              to the
              %a.existingWikiWord{:href => "/nlab/show/algebraic+closure"} algebraic closure
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi F
                        %mi q
                    %annotation{:encoding => "application/x-tex"} \mathbf{F}_q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {\vert -\vert}
              denotes
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groupoid+cardinality"} groupoid cardinality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Frob
                    %mo :
                    %msub
                      %mover
                        %mi Bun
                        %mo ¯
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mover
                        %mi Bun
                        %mo ¯
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Frob : \overline{Bun}_G(X) \to \overline{Bun}_G(X)
              denotes the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Frobenius+map"} Frobenius map
          %p
            Then they proved the following result, via
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+Poincar%C3%A9+duality"} nonabelian Poincaré duality
            which provides a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local-global+principle"} local-global principle
          .num_theorem
            %h6#theorem_5 Theorem
            %p
              %strong> (Gaitsgory-Lurie)
              \. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth"} smooth
              %a.existingWikiWord{:href => "/nlab/show/projective+variety"} projective
              %a.existingWikiWord{:href => "/nlab/show/curve"} curve
              over the
              %a.existingWikiWord{:href => "/nlab/show/finite+field"} finite field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi q
                    %annotation{:encoding => "application/x-tex"} F_q
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ≥
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mi{:mathvariant => "normal"} Tr
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Frob
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %msup
                      %mi H
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi Bun
                        %mo ¯
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Q
                      %mi ℓ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mfrac
                      %mrow
                        %msup
                          %mi q
                          %mrow
                            %mi d
                            %mo ⋅
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mi κ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \sum_{i \ge 0} (-1)^i \mathrm{Tr}(Frob^{-1} \mid H^i(\overline{Bun}_G(X) ; \mathbf{Q}_\ell) = \prod_{x \in X} \frac{q^{d \cdot \deg(x)}}{|G(\kappa(x))|}
          %h2#references References
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Weil_conjecture_on_Tamagawa_numbers"} Weil conjecture on Tamagawa numbers
          %h3#work_of_gaitsgorylurie Work of Gaitsgory-Lurie
          %p
            A proof of the
            %a.existingWikiWord{:href => "/nlab/show/function+field"} function field
            case is discussed in
          %ul
            %li#GaitsgoryLurie
              %a.existingWikiWord{:href => "/nlab/show/Dennis+Gaitsgory"}> Dennis Gaitsgory
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Jacob Lurie
              = succeed "," do
                %em Nonabelian Poincaré Duality
              %em Weil’s conjecture for function fields
              (2014-2017) &amp;lbrack;“second draft:”
              %a{:href => "https://www.math.ias.edu/~lurie/papers/tamagawa.pdf"}> pdf
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/files/GaitsgoryLurie-WeilConjecture.pdf", :title => "pdf"} pdf
              = succeed "&rbrack;" do
                %a{:href => "https://www.math.ias.edu/~lurie/papers/tamagawa-abridged.pdf"} “first volume of expanded account” pdf
          %p The proof was announced in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              = succeed "," do
                %em Tamagawa Numbers via Nonabelian Poincaré Duality
              = succeed "," do
                %a{:href => "http://people.mpim-bonn.mpg.de/teichner/Older/FRG-3.html"} FRG Chern-Simons workshop
          %p and is outlined in the lecture notes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              = succeed "," do
                %em Tamagawa Numbers via Nonabelian Poincare Duality (282y)
              = succeed ")" do
                %a{:href => "http://www.math.harvard.edu/~lurie/282y.html"} web
          %p See also the shorter lecture notes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              = succeed "," do
                %em Tamagawa numbers via nonabelian Poincare duality
              = succeed "," do
                %a{:href => "http://www.math.ku.dk/english/research/conferences/2014/ytm2014"} Young Topologists Meeting 2014
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Aaron+Mazel-Gee"} Aaron Mazel-Gee
              = succeed "." do
                %a{:href => "http://math.berkeley.edu/~aaron/livetex/lurie-tamagawa-poincare.pdf"} pdf
          %h3#previous_work Previous work
          %p
            The idea of the relationship between
            %a.existingWikiWord{:href => "/nlab/show/Tamagawa+numbers"} Tamagawa numbers
            and
