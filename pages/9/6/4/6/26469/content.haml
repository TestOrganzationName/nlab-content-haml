                  %mi ℬ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} k:(X,\mathcal{A})\to(Y,\mathcal{B})
            such that for every
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
