              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi ℬ
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Y,\mathcal{B},q)
            be
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/probability+spaces"} probability spaces
            %a.existingWikiWord{:href => "/nlab/show/measurable+spaces"} measurable spaces
            equipped each with a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/probability+measure"} probability measure
            %strong measure-preserving kernel
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
