          %h2#references References
          %p See also:
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "https://en.m.wikipedia.org/wiki/Markov_kernel"} Markov kernel
          %p
            Discussion via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/F.+W.+Lawvere"}> F. W. Lawvere
                ,
                = succeed "," do
                  %em The Category of Probabilistic Mappings
                = succeed "." do
                  %a{:href => "https://ncatlab.org/nlab/files/lawvereprobability1962.pdf"} PDF
            %li
              %p
                Fredrik Dahlqvist, Vincent Danos, Ilias Garnier, and Alexandra Silva,
                = succeed "." do
                  %em Borel kernels and their approximation, categorically
                = succeed "." do
                  %a{:href => "https://arxiv.org/abs/1803.02651"} arXiv
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tobias+Fritz"}> Tobias Fritz
                ,
                = succeed "." do
                  %em A synthetic approach to Markov kernels, conditional independence and theorems on sufficient statistics
                = succeed "." do
                  %a{:href => "https://arxiv.org/abs/1908.07021"} arXiv:1908.07021
            %li#ergodic_dagger
              %p
                Noé Ensarguet,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paolo+Perrone"} Paolo Perrone
                = succeed "." do
