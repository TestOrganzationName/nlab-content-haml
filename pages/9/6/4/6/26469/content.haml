                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int_X k(B|x)\,p(d x) = q(B) .
          %h3#kernels_from_deterministic_functions Kernels from deterministic functions
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/identity"} identity
            function on a measurable set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\mathcal{A})
            defines a kernel as follows,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} |
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi δ
                    %mi x
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mn 1
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mi x
                            %mo ∈
                            %mi A
                            %mo ;
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mi x
                            %mo ∉
                            %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\delta(A|x) = \delta_x(A) = 1_A(x) = \begin{cases}
                  1 &amp; x\in A ; \\
                  0 &amp; x\notin A
                  \\end{cases}
          %p
            for every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x\in X
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#categories_of_markov_kernels"} below
          %p
            More generally, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi ℬ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f:(X,\mathcal{A})\to (Y,\mathcal{B})
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/measurable+function"} measurable function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi f
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi ℬ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \delta_f:(X,\mathcal{A})\to (Y,\mathcal{B})
            as follows,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi f
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} |
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi δ
                    %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mn 1
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ∈
                            %mi B
                            %mo ;
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ∉
                            %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\delta_f(B|x) = \delta_f(x)(B) = 1_{f^{-1}(B)}(x) = \begin{cases}
                  1 &amp; f(x)\in B ; \\
                  0 &amp; f(x)\notin B
                  \\end{cases}
          %p
            for every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x\in X
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} B\in\mathcal{B}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x)
            with probability one. This construction induces a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            from the category
            %a.existingWikiWord{:href => "/nlab/show/Meas"} Meas
            to the categories of kernels
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#categories_of_markov_kernels"} below
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/stochastic+map#stochastic_maps_from_deterministic_functions"} analogous construction for stochastic maps
          %p
            Every kernel in the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi f
                %annotation{:encoding => "application/x-tex"} \delta_f
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/zero-one+kernel"} zero-one kernel
          %p
            Note that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi ℬ
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f:(X,\mathcal{A},p)\to(Y,\mathcal{B},q)
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/measure-preserving+function"} measure-preserving function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi f
                %annotation{:encoding => "application/x-tex"} \delta_f
            is a measure-preserving kernel in the sense defined above.
          %h3#bayesian_inversion Bayesian inversion
          %p
            Given a measure-preserving Markov kernel
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi 𝒜
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi ℬ
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} k:(X,\mathcal{A},p)\to(Y,\mathcal{B},q)
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Bayesian+inverse"} Bayesian inverse
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is a Markov kernel
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi k
                    %mo †
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi ℬ
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} k^\dagger:(Y,\mathcal{B},q)\to(X,\mathcal{A},p)
            such that for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} B\in\mathcal{B}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi A
                  %mi k
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} |
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mi B
                  %msup
                    %mi k
                    %mo †
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} |
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int_A k(B|x)\,p(d x) = \int_B k^\dagger(A|y)\,q(d y) .
          %p
            The last formula can be seen as an instance of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Bayes%27+formula"} Bayes' formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} |
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} |
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  P(b|a)\,P(a) = P(a|b)\,P(b) .
          %p We have that
          %ul
            %li
              %p
                Every kernel between
                %a.existingWikiWord{:href => "/nlab/show/standard+Borel"} standard Borel
                spaces admits a Bayesian inverse;
            %li
              %p
                If a kernel
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi 𝒜
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi ℬ
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} k:(X,\mathcal{A},p)\to(Y,\mathcal{B},q)
                admits a Bayesian inverse
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi k
                          %mo †
                        %mo :
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi ℬ
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi 𝒜
                        %mo ,
                        %mi p
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} k^\dagger:(Y,\mathcal{B},q)\to(X,\mathcal{A},p)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi ℬ
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi 𝒜
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} h:(Y,\mathcal{B},q)\to(X,\mathcal{A},p)
                is a Bayesian inverse of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                if and only if it is
                = succeed "-almost" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi q
                      %annotation{:encoding => "application/x-tex"} q
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi k
                          %mo †
                      %annotation{:encoding => "application/x-tex"} k^\dagger
            %li
              %p
                Bayesian inverses, when they exist, depend crucially on the measure
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
            %li
              %p
                Bayesian inversion makes the category
                %a.existingWikiWord{:href => "/nlab/show/Krn"} Krn
                (see
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#categories_of_markov_kernels"} below
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/dagger+category"} dagger category
          %h2#regular_conditional_distributions Regular conditional distributions
          %p
            A Markov kernel can be seen as a
            %a.existingWikiWord{:href => "/nlab/show/probability+measure"} probability measure
            which depends
            %a.existingWikiWord{:href => "/nlab/show/measurable+function"} measurably
            on a parameter. Therefore, together with the idea of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/conditional+expectation"} conditional expectation
            %a.existingWikiWord{:href => "/nlab/show/conditional+probability"} conditional probability
            without incurring paradoxes. Let’s see how.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\mathcal{A},p)
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/probability+space"} probability space
            %a.existingWikiWord{:href => "/nlab/show/sigma-algebra"} sigma-algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                    %mo ⊆
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}\subseteq\mathcal{A}
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/conditional+expectation"} conditional expectation
                of an integrable function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi 𝒜
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} f:(X,\mathcal{A},p)\to\mathbb{R}
                given
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
                is a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔼
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo{:stretchy => "false"} |
                      %mi ℬ
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mi X
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{E}[f|\mathcal{B}]:X\to\mathbb{R}
                which is
                = succeed "-measurable" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℬ
                      %annotation{:encoding => "application/x-tex"} \mathcal{B}
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ∈
                        %mi ℬ
                      %annotation{:encoding => "application/x-tex"} B\in\mathcal{B}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mi B
                      %mi f
                      %mspace{:width => "thinmathspace"}
                      %mi d
                      %mi p
                      %mo =
                      %msub
                        %mo ∫
                        %mi B
                      %mi 𝔼
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo{:stretchy => "false"} |
                      %mi ℬ
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mi d
                      %mi p
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\int_B f \, d p = \int_B \mathbb{E}[f|\mathcal{B}] \, d p .
              %p
                (Such a function always exists by the
                = succeed ".)" do
                  %a.existingWikiWord{:href => "/nlab/show/Radon-Nikodym+theorem"} Radon-Nikodym theorem
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/conditional+probability"} conditional probability
                of an event (measurable subset)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
                is the conditional expectation of its indicator function:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℙ
                      %mo{:stretchy => "false"} [
                      %mi A
                      %mo{:stretchy => "false"} |
                      %mi ℬ
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mi 𝔼
                      %mo{:stretchy => "false"} [
                      %msub
                        %mn 1
                        %mi A
                      %mo{:stretchy => "false"} |
                      %mi ℬ
                      %mo{:stretchy => "false"} ]
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{P}[A|\mathcal{B}] = \mathbb{E}[1_A|\mathcal{B}] .
          %p
            Note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℙ
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo{:stretchy => "false"} |
                  %mi ℬ
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{P}[A|\mathcal{B}]
            is a function,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %mi ℙ
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo{:stretchy => "false"} |
                  %mi ℬ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  x\mapsto \mathbb{P}[A|\mathcal{B}](x)
          %p
            which is
            = succeed "-measurable" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
            %svg{:height => "51.764pt", :version => "1.2", :viewbox => "0 0 159.695 51.764", :width => "159.695pt", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
              %defs
                %g
                  %symbol{:id => "L9Df0RPtlT9rlQXQOb9uuX7Vlo4=-glyph0-0", :overflow => "visible"}
