                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (-) \times (-)
                  %a.existingWikiWord{:href => "/nlab/show/preserves+colimits"} preserves colimits
                  and hence
                  %a.existingWikiWord{:href => "/nlab/show/coends"} coends
                  in each variable,
              %li
