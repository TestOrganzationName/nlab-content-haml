          %p
            then functoriality of pull-push means that the
            %em two
            different ways to pull-push through the diagram coincide:
          %p Pull-pushing through the spans separately results in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi k
                    %mo *
                  %msup
                    %mi h
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mo *
                  %msup
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi k
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %munder
                    %mrow
                      %msup
                        %mi h
                        %mo *
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi g
                        %mo *
                    %mo ⏟
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi f
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (k_\ast h^\ast)
                  \\circ
                  (g_\ast f^\ast)
                  \\;=\;
                  k_\ast
                  \\,
                  \\underbrace{h^\ast \, g_\ast}
                  \\,
                  f^\ast
                  \\,,
          %p while pull-pushing through the composite span results in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mi p
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mi q
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo =
                  %msub
                    %mi k
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %munder
                    %mrow
                      %msub
                        %mi p
                        %mo *
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi q
                        %mo *
                    %mo ⏟
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi f
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (k p)_* (f q)^*
                  \=
                  k_*
                  \\,
                  \\underbrace{p_* \, q^*}
                  \\,
                  f^*
                  \\,.
          %p
            For these two operations to coincide, up to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          #eq:BCConditionInMotivationFromIntegralTransform.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi h
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi g
                    %mo *
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi p
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi q
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  h^\ast \, g_\ast
                  \\;\simeq\;
                  p_* \, q^*
          %p
            between the two ways of push-pulling along the sides of any
            %a.existingWikiWord{:href => "/nlab/show/pullback+square"} pullback square
