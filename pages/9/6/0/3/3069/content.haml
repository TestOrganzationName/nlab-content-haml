            %p
              (of the (strict)
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi^{-1}(c)
              into the
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} /
                      %mi c
                    %annotation{:encoding => "application/x-tex"} \phi/c
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/final+functor"} final functor
            %p
              (This has a simple argument in the case that the categories
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              are in fact
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              being an opfibration equivalently means that it is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isofibration"} isofibration
              = succeed "," do
                %a{:href => "isofibration#GrothIsIsoFibBetweenGroupoids"} this Exp.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              is also manifestly a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/full+functor"} full functor
              = succeed ".)" do
                %a{:href => "final+functor#FinalFunctorBetweenGroupoids"} this Prop.
            %p
              Therefore the
              %a{:href => "Kan+extension#PointwiseByConicalLimits"} pointwise formula
              for the
              %a.existingWikiWord{:href => "/nlab/show/left+Kan+extension"} left Kan extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mo !
                  %annotation{:encoding => "application/x-tex"} \phi_!
              is equivalently given by taking the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              over the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
            #eq:PointwiseLeftKanExtensionInOpfiberedCase.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mo !
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %munder
                        %mo ⟶
                        %mrow
                          %msup
                            %mi ϕ
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} {
                          %mi c
                          %mo{:stretchy => "false"} }
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_!(X)_c
                    \\;\simeq\;
                    \\underset
                    {\underset{\phi^{-1}\big(\{c\}\big)}{\longrightarrow}}
                    {\lim}
                    \\,
                    X
                    \\,.
            %p
              (2.) Since
              %a.maruku-eqref{:href => "#eq:StrictPullbackOfOpfibration"} (5)
              is a (strict) pullback of (strict) categories (i.e. an ordinary pullback of
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              of
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              and of
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              of
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %a.existingWikiWord{:href => "/nlab/show/images"} images
              and
              %a.existingWikiWord{:href => "/nlab/show/preimages"} preimages
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
