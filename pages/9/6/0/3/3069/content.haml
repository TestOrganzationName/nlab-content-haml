          %h2#idea Idea
          %p
            The
            = succeed "," do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Jon+Beck"}> Beck
                –
                %a.existingWikiWord{:href => "/nlab/show/Claude+Chevalley"} Chevalley
                condition
            %em Beck condition
            or the
            = succeed "," do
              %em Chevalley condition
            = succeed "s\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/base+change"} change of base
          %h2#motivation Motivation
          %p The Beck-Chevalley condition may be understood as a natural compatibility condition for
          %p
            %strong
              %a{:href => "#MotivationFromIntegralTransforms"} (1)
            %a.existingWikiWord{:href => "/nlab/show/integral+transforms"} integral transforms
            in
            %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
          %p
            %strong
              %a{:href => "#MotivationFromLogicAndTypeTheory"} (2)
            %a.existingWikiWord{:href => "/nlab/show/quantifiers"} quantifiers
            in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/formal+logic"} formal logic
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
