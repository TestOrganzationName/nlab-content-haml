                    \\begin{array}{l}
                    \\big(
                    (f \times id)_!
                    (pr_{\mathcal{X}})^\ast
                    \\mathscr{V}
                    \\big)_{(y,x')}
                    \\\
                    \\;=\;
                    \\int^{(x,x'_0)}
                    \\mathcal{Y}\big(f(x),y\big)
                    \\times
                    \\mathcal{X}'\big(x'_0,x'\big)
                    \\cdot
                    \\big(
                    (pr_{\mathcal{X}})^\ast\mathscr{V}_{x,x'_0}
                    \\big)
                    \\\
                    \\;=\;
                    \\int^{(x,x'_0)}
                    \\mathcal{Y}\big(f(x),y\big)
                    \\times
                    \\mathcal{X}'\big(x'_0,x'\big)
                    \\cdot
                    \\mathscr{V}_{x}
                    \\\
                    \\;=\;
                    \\int^{x'_0}
                    \\int^{x}
                    \\mathcal{Y}\big(f(x),y\big)
                    \\times
                    \\mathcal{X}'\big(x'_0,x'\big)
                    \\cdot
                    \\mathscr{V}_{x}
                    \\\
                    \\;\simeq\;
                    \\int^{x'_0}
                    \\mathcal{X}'\big(x'_0,x'\big)
                    \\cdot
                    \\int^{x}
                    \\mathcal{Y}\big(f(x),y\big)
                    \\cdot
                    \\mathscr{V}_{x}
                    \\\
                    \\;\simeq\;
                    \\int^{x}
                    \\mathcal{Y}\big(f(x), y\big)
                    \\cdot
                    \\mathscr{V}_{x}
                    \\\
                    \\;\simeq\;
                    \\big(
                    f_!
                    \\mathscr{V}
                    \\big)_y
                    \\\
                    \\;\simeq\;
                    \\big(
                    (pr_{\mathcal{Y}})^\ast
                    (
                    f_!
                    \\mathscr{V}
                    )
                    \\big)_{y,x'}
                    \\,,
                    \\end{array}
            %p
              where we used (apart from the definition of
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/precomposition"} precomposition
            %ol
              %li
                %p
                  the
                  = succeed "-expression" do
                    %a.existingWikiWord{:href => "/nlab/show/coend"} coend
                  %a.maruku-eqref{:href => "#eq:CoendFormulaForLeftKanExtension"} (8)
                  for the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/left+Kan+extension"} left Kan extension
              %li
