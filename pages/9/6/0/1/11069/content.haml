          %p
            Relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Mackey+functors"} Mackey functors
          %ul
            %li#KahnYamazaki11
              %a.existingWikiWord{:href => "/nlab/show/Bruno+Kahn"}> Bruno Kahn
              , Takao Yamazaki,
              = succeed "," do
