                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The concept of
            %strong dense subtopos
            generalizes the concept of a
            %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense subspace
            from topology to toposes. A
            %em
              %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
            is
            %em dense
            if it contains the
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∅
                %annotation{:encoding => "application/x-tex"} \varnothing
            of the ambient
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %msub
                    %mi ℰ
                    %mi j
                  %mo ↪
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} i:\mathcal{E}_j\hookrightarrow \mathcal{E}
            be a
            %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
            with corresponding
            %a.existingWikiWord{:href => "/nlab/show/Lawvere-Tierney+topology"} Lawvere-Tierney topology
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℰ
                    %mi j
                %annotation{:encoding => "application/x-tex"} \mathcal{E}_j
            is called
            %em dense
            if the following equivalent conditions hold:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo ∘
                      %mo ⊥
                      %mo =
                      %mo ⊥
                    %annotation{:encoding => "application/x-tex"} j\circ\bot=\bot
                (with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊥
                      %mo :
                      %mn 1
                      %mo →
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \bot: 1\to\Omega
                the classifying map of
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ∅
                        %mo ↣
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \emptyset\rightarrowtail 1
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                      %mo ↣
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \emptyset\rightarrowtail 1
                is
                = succeed "-closed." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                      %annotation{:encoding => "application/x-tex"} j
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \emptyset
                is a
                = succeed "-sheaf." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                      %annotation{:encoding => "application/x-tex"} j
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
                satisfies
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi ∅
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} i_\ast (\emptyset)\simeq\emptyset
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
                satisfies: from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi Z
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} i^\ast (Z)\simeq\emptyset
                follows
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Z
                        %mo ≃
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} Z\simeq\emptyset
          %p
            A topology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            satisfying these conditions is also called
            = succeed "." do
              %em dense
          %h3#remark Remark
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo ∘
                  %mo ⊥
                %annotation{:encoding => "application/x-tex"} j\circ\bot
            classifies the
            = succeed "-closure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ∅
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{\emptyset}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \emptyset
            whence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo ∘
                  %mo ⊥
                  %mo =
                  %mo ⊥
                %annotation{:encoding => "application/x-tex"} j\circ\bot = \bot
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ∅
                    %mo{:stretchy => "false"} ¯
                  %mo =
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \bar{\emptyset}=\emptyset
            i.e.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ↣
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \emptyset\rightarrowtail 1
            is
            = succeed "-closed." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is a
            = succeed "-sheaf" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            and subobjects of
            = succeed "-sheaves" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            = succeed "-closed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            = succeed "-sheaves," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \emptyset
            being a
            = succeed "-sheaf." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \emptyset
            is preserved by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i_\ast
          %p
            The equivalence between the last two formulations follows from the adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mo ⊣
                  %msub
                    %mi i
                    %mo *
                %annotation{:encoding => "application/x-tex"} i^\ast\dashv i_\ast
            and the
            %a.existingWikiWord{:href => "/nlab/show/strict+initial+object"} strictness
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \emptyset
            in a topos:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mrow
                      %msub
                        %mi i
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi ∅
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} id_{i_\ast(\emptyset)}
            corresponds under the adjunction to a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi ∅
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} i^\ast( i_\ast (\emptyset))\to \emptyset
            showing that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi ∅
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} i^\ast (i_\ast(\emptyset))\simeq\emptyset
            in general. Conversely,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi Z
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} id_{i^\ast (Z)}
            corresponds to a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo →
                  %msub
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Z\to i_\ast(i^\ast(Z))
            showing that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo ≃
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} Z\simeq\emptyset
            provided
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} i^\ast(Z)\simeq\emptyset
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} i_\ast(\emptyset)\simeq\emptyset
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/SGA4"} SGA4
            (p.430) another equivalent formulation is on offer, namely it suffices to check the last condition on
            %a.existingWikiWord{:href => "/nlab/show/subterminal+object"} subterminal objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            (because
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi ∅
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i_\ast(\emptyset)
            is a subterminal in general since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo *
                %annotation{:encoding => "application/x-tex"} i_\ast
            as a right adjoint preserves monos hence subterminals). An even more comprehensive list can be found in (
            %a{:href => "#Caramello12"}> Caramello 2012
            , p.9).
          %p
            The last two conditions make sense not only for embeddings: general
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphisms"} geometric morphisms
            fulfilling them are called
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dominant+geometric+morphism"} dominant
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %msub
                    %mi ℰ
                    %mi j
                  %mo ↪
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} i:\mathcal{E}_j\hookrightarrow\mathcal{E}
            is a dense subtopos is to say that the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is
            = succeed "." do
              %strong dominant
          %p
            Notice that there is also a certain
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
            on small categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            called the
            %a.existingWikiWord{:href => "/nlab/show/dense+topology"} dense topology
            whose corresponding
            %a.existingWikiWord{:href => "/nlab/show/Lawvere-Tierney+topology"} Lawvere-Tierney topology
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi 𝒞
                        %mi op
                %annotation{:encoding => "application/x-tex"} Set^{\mathcal{C}^{op}}
            is dense in the above sense, and coincides with the
            %a.existingWikiWord{:href => "/nlab/show/double+negation"} double-negation topology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo ¬
                %annotation{:encoding => "application/x-tex"} \neg\neg
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi 𝒞
                          %mi op
                  %annotation{:encoding => "application/x-tex"} Set^{\mathcal{C}^{op}}
          %h2#properties Properties
          %h3#some_basic_observations Some basic observations
          %p
            Of course, the composition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ∘
                  %mi j
                %annotation{:encoding => "application/x-tex"} k\circ j
            of dense inclusions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo ,
                  %mi k
                %annotation{:encoding => "application/x-tex"} j,k
            is again dense. Conversely, we have
          #dense_factors.num_prop
            %h6#proposition Proposition
            %p Given the following commutative diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi ℰ
                              %mi i
                          %mtd
                            %mover
                              %mo →
                              %mi j
                          %mtd
                            %mi ℰ
                        %mtr
                          %mtd
                          %mtd
                            %mi i
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↑
                            %mi k
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi ℰ
                              %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{E}_i &amp;\overset{j}{\to}&amp; \mathcal{E}
                    \\\
                    \&amp;{i}{\searrow}&amp; \uparrow k
                    \\\
                    \&amp; &amp; \mathcal{E}_k
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ,
                    %mi k
                  %annotation{:encoding => "application/x-tex"} i,j,k
              are subtopos inclusions. When
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is dense, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              are dense as well.
          %p
            %strong> Proof
            \: Suppose
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo =
                    %msup
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \emptyset =i^\ast (Z)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is an inclusion we have that the counit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo :
                  %msup
                    %mi k
                    %mo *
                  %msub
                    %mi k
                    %mo *
                  %mo →
                  %msub
                    %mi id
                    %mrow
                      %msub
                        %mi ℰ
                        %mi k
                %annotation{:encoding => "application/x-tex"} \epsilon:k^\ast k_\ast\to id_{\mathcal{E}_k}
            is a natural isomorphism whence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo =
                  %msup
                    %mi k
                    %mo *
                  %msub
                    %mi k
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Z= k^\ast k_\ast (Z)
            and therefore
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo =
                  %msup
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi k
                    %mo *
                  %msub
                    %mi k
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi i
                    %mo *
                  %msup
                    %mi k
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi k
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi j
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi k
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mo .
                %annotation{:encoding => "application/x-tex"} \emptyset =i^\ast(Z)=i^\ast(k^\ast k_\ast (Z))=i^\ast k^\ast (k_\ast (Z))=j^\ast(k_\ast(Z))\quad .
          %p
            From which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi k
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} k_\ast(Z)=\emptyset
            since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            is dense by assumption.
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo =
                  %msup
                    %mi k
                    %mo *
                  %msub
                    %mi k
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi k
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi ∅
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} Z=k^\ast k_\ast (Z)=k^\ast (\emptyset)=\emptyset
            since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi k
                    %mo *
                %annotation{:encoding => "application/x-tex"} k^\ast
            preserves colimits, in other words, we have shown that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is dense.
          %p
            But from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi k
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} k_\ast (Z)=\emptyset
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo =
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} Z=\emptyset
            follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is dense as well.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ▪
                %annotation{:encoding => "application/x-tex"} \qed
          %p
            Given two dense topologies
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} j_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mn 2
                %annotation{:encoding => "application/x-tex"} j_2
            on a topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mn 1
                  %mo ∨
                  %msub
                    %mi j
                    %mn 2
                %annotation{:encoding => "application/x-tex"} j_1\vee j_2
            is again dense.
          %p
            This follows from the general fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %msub
                        %mi j
                        %mn 1
                      %mo ∨
                      %msub
                        %mi j
                        %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_{j_1\vee j_2}(\mathcal{E})
            corresponds to the meet, i.e. the intersection of the corresponding subtoposes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %msub
                        %mi j
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo ∩
                  %msub
                    %mi Sh
                    %mrow
                      %msub
                        %mi j
                        %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_{j_1}(\mathcal{E})\cap Sh_{j_2}(\mathcal{E})
            in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/lattice+of+subtoposes"} lattice of subtoposes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ∅
                    %mi ℰ
                %annotation{:encoding => "application/x-tex"} \emptyset_\mathcal{E}
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} j_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mn 2
                %annotation{:encoding => "application/x-tex"} j_2
            dense.
          %p In other words, the intersection of two dense subtoposes is still dense!
          %p
            Somewhat surprisingly, this still holds if one takes the intersection of
            %em all
            dense subtoposes, as the next section details.
          %h3#double_negation Relation to double-negation topology
          %p
            For any topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %a{:href => "double+negation#DoubleNegationTopology"} double negation topology
            gives the
            %em smallest
            dense subtopos. This agrees with the
            %a{:href => "double+negation#double_negation_locale"} situation for locales
            but contrasts with the
            %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} situation for topological spaces
            where, in general, smallest dense subspaces do not exist.
          #smallest_dense_subtopos.num_prop
            %h6#proposition_2 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo ¬
                        %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} Sh_{\not\not}(\mathcal{E}) \hookrightarrow \mathcal{E}
              is the smallest dense subtopos.
          %p
            (
            %a{:href => "#Johnstone02"}> Johnstone, below Corollary 4.5.20
            )
          %p
            In fact, dense topologies are characterized by their relation to
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} \neg\neg
          #negdense.num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              be a topos. A topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              satisfies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ≤
                    %mo ¬
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} j\le\neg\neg
              , i.e.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is dense, iff
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℰ
                        %mi j
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo ¬
                          %mo ¬
                      %mo =
                      %msub
                        %mi ℰ
                        %mrow
                          %mo ¬
                          %mo ¬
                    %annotation{:encoding => "application/x-tex"} (\mathcal{E}_j)_{\not\not}=\mathcal{E}_{\not\not}
          %p
            (
            %a{:href => "#BlassScedrov83"}> Blass-Scedrov 1983
            , p.19,
            = succeed "," do
              %a{:href => "#Caramello12"} Caramello 2012
            = succeed ")." do
              %a{:href => "#boolean_subtopos"} double negation
          %p
            From this and the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            is trivially dense, follows:
          #prop_boolean.num_prop
            %h6#proposition_4 Proposition
            %p
              A topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is
              %a.existingWikiWord{:href => "/nlab/show/Boolean+topos"} Boolean
              iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              has exactly one dense subtopos, namely
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℰ
                        %mrow
                          %mo ¬
                          %mo ¬
                      %mo =
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\neg\neg}=\mathcal{E}
          %p
            Notice that, though these results prevent a topos from having more than one
            %em dense
            Boolean subtopos, nothing prevents a topos from having more than one
            %em Boolean
            subtopos e.g. the
            %a.existingWikiWord{:href => "/nlab/show/Sierpinski+topos"} Sierpinski topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mo →
                %annotation{:encoding => "application/x-tex"} Set^{\to}
            has two non trivial ones that complement each other in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/lattice+of+subtoposes"} lattice of subtoposes
            %a{:href => "#negdense"} above proposition
            just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℰ
                    %mi j
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo ¬
                      %mo ¬
                  %mo ≅
                  %msub
                    %mi ℰ
                    %mrow
                      %mo ¬
                      %mo ¬
                %annotation{:encoding => "application/x-tex"} (\mathcal{E}_j)_{\neg\neg}\cong\mathcal{E}_{\neg\neg}
            wouldn’t do.
          %h3#the_denseclosedfactorization The (dense,closed)-factorization
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            of
            %a.existingWikiWord{:href => "/nlab/show/elementary+toposes"} elementary toposes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"}
                  Sh_j(\mathcal{E}) \hookrightarrow \mathcal{E}
          %p factors as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msub
                    %mi Sh
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mi ext
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"}
                  Sh_j(\mathcal{E})
                  \\hookrightarrow
                  Sh_{c(ext(j))}(\mathcal{E})
                  \\hookrightarrow
                  \\mathcal{E}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ext
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ext(j)
            (the “exterior” of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            = succeed "-closure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ↣
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \emptyset \rightarrowtail 1
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi j
                    %mo{:stretchy => "false"} ¯
                  %mo ≔
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mi ext
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\bar j \coloneqq c(ext(j))
          %p
            the
            %a.existingWikiWord{:href => "/nlab/show/closed+subtopos"} closed topology
            corresponding to the
            %a.existingWikiWord{:href => "/nlab/show/subterminal+object"} subterminal object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ext
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ext(j)
          %p
            Here the first inclusion exhibits a dense subtopos and the second a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+subtopos"} closed subtopos
          %p
            This is the so called
            %em
              %a.existingWikiWord{:href => "/nlab/show/%28dense%2Cclosed%29-factorization"} (dense,closed)-factorization
            and implies e.g. that
            %em proper
            dense subtoposes aren’t closed.
          %p
            Dense inclusions participate also in the description of
            %a.existingWikiWord{:href => "/nlab/show/skeletal+geometric+morphism"} skeletal inclusions
            as the closure of
            %a.existingWikiWord{:href => "/nlab/show/open+subtopos"} open inclusions
            under composition with dense inclusions.
          %h3#parallels_topology Some parallels to topology
          %p
            The above terminology suggests to view a
            %em dense subtopos
            as one with an
            = succeed "." do
              %em empty exterior
          %p
            This analogy to topology is pursued further in (
            %a{:href => "#SGA4"}> SGA4
            , p.462) where a dense subtopos is characterized as a subtopos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_j(\mathcal{E})
            whose ‘exterior’
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ext
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ext(Sh_j(\mathcal{E}))
            (i.e. the
            %a.existingWikiWord{:href => "/nlab/show/open+subtopos"} open subtopos
            that corresponds to the
            %a.existingWikiWord{:href => "/nlab/show/subterminal+object"} subterminal object
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ext
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ext(j)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi Sh
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mi ext
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cl(Sh_j(\mathcal{E})):=Sh_{c(ext(j))}(\mathcal{E})
            (i.e. the
            %a.existingWikiWord{:href => "/nlab/show/closed+subtopos"} closed subtopos
            corresponding to
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ext
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ext(j)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
          %p Let’s have a look at some of the details:
          %p
            Due to the construction of
            %a.existingWikiWord{:href => "/nlab/show/open+subtopos"} open subtoposes
            we know that the objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ext
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ext(Sh_j(\mathcal{E}))
            have the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %mi ext
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X^{ext(j)}
            for some
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} X\in\mathcal{E}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %mi ext
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} X^{ext(j)}=1
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} X\in\mathcal{E}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ∅
                    %mo{:stretchy => "false"} ¯
                  %mo =
                  %mi ext
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \bar\emptyset =ext(j)\simeq \emptyset
            which means that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_j(\mathcal{E})
            is dense. By construction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cl(Sh_j(\mathcal{E}))
            is the
            %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ext
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ext(Sh_j(\mathcal{E}))
            in the lattice of subtoposes hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} Cl(Sh_j(\mathcal{E}))=\mathcal{E}
            in case the latter is trivial. This follows also directly from the description of objects in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cl(Sh_j(\mathcal{E}))
            as those objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} X\in\mathcal{E}
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi ext
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi ext
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X\times ext(j)\cong ext(j)
          %p
            E.g. let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_k(\mathcal{E})
            be a subtopos that has a trivial intersection with a non-trivial open subtopos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mi o
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_o(\mathcal{E})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_k(\mathcal{E})
            is contained in the (closed) complement of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mi o
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_o(\mathcal{E})
            hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Sh
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≠
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} Cl(Sh_k(\mathcal{E}))\neq \mathcal{E}
            and we see that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_k(\mathcal{E})
            cannot be dense: we have recuperated the familiar fact from point-set topology that a
            %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense subset
            intersects all non-trivial open sets non-trivially.
          %p Another easy result in this vein is
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %msub
                      %mi Sh
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} i:Sh_j(\mathcal{E})\hookrightarrow\mathcal{E}
              be a dense subtopos that is
              %a.existingWikiWord{:href => "/nlab/show/connected+object"} connected
              in the sense that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              is indecomposable: if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi Z
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} W\coprod Z=1
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} W=\emptyset
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} Z=\emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is connected as well.
          %p
            %strong> Proof
            \: Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %mi Y
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} X\coprod Y = 1
            be a decomposition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                %annotation{:encoding => "application/x-tex"} i^\ast
            is a left exact left adjoint, it preserves coproducts and the terminal object and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %msup
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i^\ast(X)\coprod i^\ast (Y)
            is therefore a decomposition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_j(\mathcal{E})
            hence trivial by assumption. Let’s say
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} i^\ast(X)\simeq\emptyset
            but
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_j(\mathcal{E})
            is dense and therefore we can conclude
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ≃
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} X\simeq\emptyset
            hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %mi Y
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} X\coprod Y = 1
            is trivial as well.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ▪
                %annotation{:encoding => "application/x-tex"} \qed
          %h3#example_i_twovalued_toposes Example I: two-valued toposes
          %p
            Presheaf toposes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi M
                        %mi op
                %annotation{:encoding => "application/x-tex"} Set^{M^{op}}
            of actions of a monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            are classical examples of toposes whose truth value objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            have exactly two global points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo →
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} 1\to\Omega
            without the toposes being necessarily Boolean. In fact they are Boolean precisely when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is a group.
          %p As the next proposition shows, they are also instances of toposes in which only the degenerate subtopos fails to be dense:
          .num_prop
            %h6#proposition_6 Proposition
            %p
              The non-degenerate subtoposes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_j(\mathcal{E})
              of a
              %a.existingWikiWord{:href => "/nlab/show/two-valued+topos"} two-valued topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              are precisely the dense subtoposes of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
          %p
            %strong> Proof
            \: Truth values
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo →
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} 1\to\Omega
            correspond precisely to subobjects of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "-closure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ext
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ext(j)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ↣
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \emptyset\rightarrowtail 1
            is either
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \emptyset
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_j(\mathcal{E})
            is dense, in the second, from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mn 1
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} X\times 1=1
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X\in Cl(Sh_j(\mathcal{E}))
            follows triviality.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ▪
                %annotation{:encoding => "application/x-tex"} \qed
          %p
            Combining this with the
            %a{:href => "#prop_boolean"} above
            shows that
            %em two-valued and Boolean toposes are opposite extremes
            when it comes to dense subtoposes and the following observation (cf.
            = succeed ";" do
              %a{:href => "#Caramello09"} Caramello (2009)
          .num_prop
            %h6#proposition_7 Proposition
            %p
              A topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              that is two-valued and Boolean has no non-trivial subtoposes.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ▪
                  %annotation{:encoding => "application/x-tex"} \qed
          %p In other words, two-valued Boolean toposes are atoms in the lattice of subtoposes. Notice that this applies e.g. to well-pointed toposes.
          %h3#example_ii_persistent_localizations Example II: persistent localizations
          %p
            Recall that a
            %a.existingWikiWord{:href => "/nlab/show/persistent+localization"} persistent localization
            is given by a
            %a.existingWikiWord{:href => "/nlab/show/Lawvere-Tierney+topology"} Lawvere-Tierney topology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            with the property that every
            = succeed "-separated" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            = succeed "-sheaf." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            = succeed "-sheaves" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            = succeed "-sheaves." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
          %p
            In particular, this applies to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ↣
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \emptyset\rightarrowtail 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is always a sheaf. Whence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \emptyset
            is a
            = succeed "-sheaf" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            = succeed "." do
              %strong persistent localizations are dense
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quality+type"} quality types
          %p
            This observation is due to
            = succeed "." do
              %a{:href => "#Johnstone96"} Johnstone (1996)
          %p
            By the
            %a{:href => "#prop_boolean"} above proposition
            it follows immediately that every persistent localization of a Boolean topos is trivial.
          %h3#relation_to_aufhebung Relation to Aufhebung
          %p
            Notice that, since the
            %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            corresponding to a subtopos is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact functor
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} \ast
            of the ambient topos. Moreover, the
            %a.existingWikiWord{:href => "/nlab/show/idempotent+comonad"} idempotent comonad
            and
            %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent monad
            constant on the
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint
            to each other (forming an
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∨
                  %annotation{:encoding => "application/x-tex"} \vee
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/modal+objects"} modal objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is depicted by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi L
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo ∨
                      %mtr
                        %mtd
                          %mi ∅
                        %mtd
                          %mo ⊣
                        %mtd
                          %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; L
                  \\\
                  \&amp;&amp; \vee
                  \\\
                  \\emptyset &amp;\dashv&amp; \ast
                  }
                  \\,.
          %p
            In view of this, the subtopos being dense says that not only
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
            %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
            that it participates in sits inside the subtopos.
            %a.existingWikiWord{:href => "/nlab/show/Lawvere"} Lawvere
            had proposed to call this situation
            %strong resolution
            or (a special minimal version of it)
            %em
              %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
            of the
            %a.existingWikiWord{:href => "/nlab/show/unity+of+opposites"} unity of opposites
            expressed by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ⊣
                  %mo *
                %annotation{:encoding => "application/x-tex"} \emptyset \dashv \ast
            (“
            %a.existingWikiWord{:href => "/nlab/show/becoming"}> becoming
            ”).
          %p
            In other words, for an
            %a.existingWikiWord{:href => "/nlab/show/level"} essential subtopos
            %em being dense is equivalent to resolve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ⊣
                  %mo *
                %annotation{:encoding => "application/x-tex"} \emptyset \dashv \ast
            in the Hegelian calculus of
            = succeed "!" do
              %a.existingWikiWord{:href => "/nlab/show/level+of+a+topos"} levels
          %h4#example_essential_subtoposes_of_the_topos_of_globular_sets Example: essential subtoposes of the topos of globular sets
          %p
            %a{:href => "#KRRZ11"} Kennett-Riehl-Roy-Zaks (2011)
            show that in the
            %a.existingWikiWord{:href => "/nlab/show/gros+topos"} gros topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi 𝒢
                        %mi op
                %annotation{:encoding => "application/x-tex"} Set^{\mathcal{G}^{op}}
            of reflexive
            %a.existingWikiWord{:href => "/nlab/show/globular+sets"} globular sets
            essential subtoposes correspond to
            %a.existingWikiWord{:href => "/nlab/show/n-truncation+modality"} dimensional truncations
            (plus the level
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi 𝒢
                          %mi op
                %annotation{:encoding => "application/x-tex"} {Set^{\mathcal{G}^{op}}}
            ‘at infinity’). Then
            %a.existingWikiWord{:href => "/nlab/show/level"} level
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n+1
            is the Aufhebung of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            starting from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ⊣
                  %mo *
                %annotation{:encoding => "application/x-tex"} \emptyset\dashv\ast
            at level
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi l
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{l}
            of a level
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi l
                %annotation{:encoding => "application/x-tex"} l
            resolves all the levels that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi l
                %annotation{:encoding => "application/x-tex"} l
            resolves. Therefore in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi 𝒢
                        %mi op
                %annotation{:encoding => "application/x-tex"} Set^{\mathcal{G}^{op}}
            all essential subtoposes (above 0) resolve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ⊣
                  %mo *
                %annotation{:encoding => "application/x-tex"} \emptyset\dashv\ast
            and hence are
            = succeed "!" do
              %em dense
