                            %a.existingWikiWord{:href => "/nlab/show/derived+stack"} derived stack
                  %h2#theorems Theorems
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Diaconescu%27s+theorem"} Diaconescu's theorem
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Barr%27s+theorem"} Barr's theorem
                  %div
                    %p
                      %a{:href => "/nlab/edit/topos+theory+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %ul
                %li
                  %a{:href => "#remark"} Remark
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#some_basic_observations"} Some basic observations
