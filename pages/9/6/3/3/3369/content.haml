                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/span"} span
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                    = succeed "s)" do
                      %a.existingWikiWord{:href => "/nlab/show/bi-brane"} bi-brane
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mi P
                              %mtr
                                %mtd
                                %mtd
                                  %mo ↙
