                    %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                    that assigns to each
                    %em path
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                        %annotation{:encoding => "application/x-tex"} P
                    between field configuration a
                    %em phase
                    ;
          %p
            In these terms the
            %strong kinematics of a classical field theory
            is a choice of
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi kin
                  %mo :
                  %msub
                    %mi Bord
                    %mi n
                  %mo →
                  %msub
                    %mi Fam
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  kin : Bord_n \to Fam_n(*)
          %p
            whereas the
            %strong dynamics of a classical field theory
            – the specificaton of an
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            on the given configuration spaces, is a lift of that to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Fam
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fam_n(C)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi Fam
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mrow
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mi S
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                          %mo ↗
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi Bord
                            %mi n
                        %mtd
                          %mover
                            %mo →
                            %mi kin
                        %mtd
                          %msub
                            %mi Fam
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; Fam_n(C)
                  \\\
                  \&amp; {}^{\exp(S(-))}\nearrow &amp; \downarrow
                  \\\
                  Bord_n &amp;\stackrel{kin}{\to}&amp;
                  Fam_n(*)
                  }
          %p
            To illustrate this: specifically, if we consider a
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            that is induced from a
            %strong target space
            geometry
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is a morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi Σ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi : \Sigma \to X
            %a.existingWikiWord{:href => "/nlab/show/gauge+field"} background field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo :
                    %mi X
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \nabla : X \to C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi conf
                    %mi X
                  %mo :
                  %msub
                    %mi Bord
                    %mi n
                  %mo →
                  %msub
                    %mi Fam
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  conf_X : Bord_n \to Fam_n(C)
          %p
            as given by homming a
            %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
            %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Σ
                      %mtr
                        %mtd
                        %mtd
                          %mo ↗
                        %mtd
                        %mtd
                          %mo ↖
                      %mtr
                        %mtd
                          %msub
                            %mi Σ
                            %mi in
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi Σ
                            %mi out
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \Sigma
                  \\\
                  \&amp; \nearrow &amp;&amp; \nwarrow
                  \\\
                  \\Sigma_{in} &amp;&amp;&amp;&amp; \Sigma_{out}
                  }
          %p
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to produce a
            %a.existingWikiWord{:href => "/nlab/show/span"} span
            of path and configuration spaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi Σ
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi Σ
                            %mi in
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} ]
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi Σ
                            %mi out
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; [\Sigma,X]
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  [\Sigma_{in},X] &amp;&amp;&amp;&amp; [\Sigma_{out},X]
                  }
          %p
            equipped with the
            %strong transgressed background field
            as the corresponding action functional
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi Σ
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi Σ
                            %mi in
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} ]
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi Σ
                            %mi out
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; [\Sigma, X]
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  [\Sigma_{in},X] &amp;&amp;&amp;&amp; [\Sigma_{out},X]
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp; C
                  }
                  \\,.
          %p
            With that in hand, the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of the given classical field theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi Bord
                    %mi n
                  %mo →
                  %msub
                    %mi Fam
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(S(-)) : Bord_n \to Fam_n(C)
            is its “pushforward to the point”, given by postcomposition with a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mo :
                  %msub
                    %mi Fam
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\int : Fam_n(C) \to C
          %p
            that over objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi P
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \exp(S(-)) : P \to C
            is given by taking
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi P
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %munder
                    %mi lim
                    %mo →
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (\exp(S(-)) : P \to C) \mapsto (\lim_\to \exp(S(-)))
          %p
            which in terms of
            = succeed "-notation" do
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi P
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mo ∫
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\exp(S(-)) : P \to C) \mapsto (\int \exp(S(-)))
                  \\,.
          %p
            Taking such a colimit may be thought of as forming the space of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/section"} section
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi P
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \exp(S(-)) : P \to C
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dan+Freed"}> Dan Freed
              ,
              %em Higher Algebraic Structures and Quantization
              (
              %a{:href => "http://arxiv.org/abs/hep-th/9212115"}> arXiv:hep-th/9212115
              \.
          %p A first more categorical formulation of this is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Simon+Willerton"} Simon Willerton
              %em The twisted Drinfeld double of a finite group via gerbes and finite groupoids
              (
              %a{:href => "http://arxiv.org/abs/math.QA/0503266"}> arXiv:math/0503266
              )
          %p
            What exactly the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mo :
                  %msub
                    %mi Fam
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \int : Fam_n(C) \to C
            does to
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            limits and colimits coincide. This is the case notably for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %mi Vect
                  %annotation{:encoding => "application/x-tex"} C = Vect
          %p
            The authors indicate in section 8 a general recursive procedure for defining higher categories of higher vector spaces, by iterating the bimodule-style definition of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/2-vector+space"} 2-vector space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %mi n
                    %mi Vect
                  %annotation{:encoding => "application/x-tex"} C = n Vect
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi Fam
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mo ∫
                        %mtd
                          %mi C
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mrow
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mi S
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                          %mo ↗
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi Bord
                            %mi n
                        %mtd
                          %mover
                            %mo →
                            %mi kin
                        %mtd
                          %msub
                            %mi Fam
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; Fam_n(C) &amp;\stackrel{\int}{\to}&amp; C
                  \\\
                  \&amp; {}^{\exp(S(-))}\nearrow &amp; \downarrow
                  \\\
                  Bord_n &amp;\stackrel{kin}{\to}&amp;
                  Fam_n(*)
                  }
          %p
            whose left bit is the kinematical and dynamical input given by a classical field theory, and whose composition to to the right is supposed to give the corresponding quantum field theory, which by the logic motivating the
            %a.existingWikiWord{:href => "/nlab/show/cobordism+hypothesis"} cobordism hypothesis
            is a functor
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo :
                    %msub
                      %mi Bord
                      %mi n
                    %mo →
                    %mi n
                    %mi Vact
                  %annotation{:encoding => "application/x-tex"} Z : Bord_n \to n Vact
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mi S
                  %mo =
                  %mo ∫
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi Bord
                    %mi n
                  %mover
                    %mo →
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi Fam
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mi Vect
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ∫
                  %mi n
                  %mi Vect
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Z_S  = \int \exp(S(-)) : Bord_n \stackrel{\exp(S(-))}{\to}
                  Fam_n(n Vect) \stackrel{\int}{\to} n Vect
                  \\,.
          %h2#3dCSFullyExtended 3d Chern-Simons as a fully extended TQFT
          %p
            A summary of the FHLT-argument about realizing 3d
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            as a fully
            %a.existingWikiWord{:href => "/nlab/show/extended+TQFT"} extended TQFT
            is given in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"}> Konrad Waldorf
              ,
              %em Chern-Simons theory and the categorified group ring
              (
              %a.existingWikiWord{:href => "/nlab/files/WaldorfTalbot2010.pdf", :title => "pdf"}> pdf
              )
          %p
            The following are some notes from a talk by
            %a.existingWikiWord{:href => "/nlab/show/Constantin+Teleman"} Constantin Teleman
            on joint work with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Dan+Freed"} Dan Freed
            = succeed "." do
              %a{:href => "http://maths-old.anu.edu.au/esi/2012/"} ESI Program on K-Theory and Quantum Fields (2012)
          %h3#cs_as_a_fully_extended_tqft CS as a fully extended TQFT
          %p Goals
          %ul
            %li
              %p
                i) describe
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
                for compact Lie groups as an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/extended+TQFT"} extended TQFT
            %li
              %p
                ii) relate to chiral
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/WZW+model"} WZW model
          %p approach related to:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kevin+Walker"}> Kevin Walker
                \: 3d Chern-Simons theory is best understood as a boundary condition for a 4d theory.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chris+Douglas"}> Chris Douglas
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Andre+Henriques"} Andre Henriques
                %em
                  %a.existingWikiWord{:href => "/nlab/show/conformal+nets"} conformal nets
                and their relation to CS theory
          %p
            construction is special case of
            %a.existingWikiWord{:href => "/nlab/show/Reshetikhin-Turaev+construction"} Reshetikhin-Turaev construction
            which to a
            %a.existingWikiWord{:href => "/nlab/show/modular+tensor+category"} modular tensor category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} \mathcal{B}
            assigns a 1-2-3
            %a.existingWikiWord{:href => "/nlab/show/extended+TQFT"} extended TQFT
            that assigns
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} \mathcal{B}
            to the
            %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
          %p
            So the goal here is to extend this down to the point, to a 0-1-2-3
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/extended+TQFT"} extended TQFT
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,3)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Bord
                    %mrow
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo ,
                      %mn 3
                    %mi String
                  %mo →
                  %mi some
                  %mspace{:width => "thickmathspace"}
                  %mi symm
                  %mspace{:width => "thickmathspace"}
                  %mi mon
                  %mo .
                  %mspace{:width => "thickmathspace"}
                  %mn 3
                  %mspace{:width => "thickmathspace"}
                  %mi category
                %annotation{:encoding => "application/x-tex"}
                  Bord^{String}_{0,1,2,3} \to some\;symm\;mon.\;3\; category
          %p
            the standard choice on the right is a 3-category of (multi)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fusion+categories"} fusion categories
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                are
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/fusion+categories"} fusion categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                are bimodule categories;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-morphisms"}> 2-morphisms
                \: bimodule homomorphism functors;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/n-morphisms"}> 3-morphisms
                \:
                %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
                of these.
          %p If this can be done, then
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi CS
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi T
                    %annotation{:encoding => "application/x-tex"} CS(*) = T
                ;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CS
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                    %annotation{:encoding => "application/x-tex"} CS(S^1) =
                %a.existingWikiWord{:href => "/nlab/show/Drinfeld+center"} Drinfeld center
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                (again an MTC)
          %p
            %span.newWikiWord
              Witt group
              %a{:href => "/nlab/new/Witt+group"} ?
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/modular+tensor+category"} modular tensor category
          %p
            %strong Theorem
            Given a
            %a.existingWikiWord{:href => "/nlab/show/modular+tensor+category"} modular tensor category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28infinity%2Cn%29-category"} symmetric monoidal 3-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒞
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathcal{C}_A
            containing the
            %a.existingWikiWord{:href => "/nlab/show/fusion+categories"} fusion categories
            and a
            %a.existingWikiWord{:href => "/nlab/show/fully+dualizable+object"} fully dualizable object
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %msub
                    %mi 𝒞
                    %mi A
                %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}_A
            which
            %a.existingWikiWord{:href => "/nlab/show/cobordism+hypothesis"} generates
            a 0-1-2-3
            %a.existingWikiWord{:href => "/nlab/show/extended+TQFT"} extended TQFT
            whose 1-2-3 part agrees with the
            %a.existingWikiWord{:href => "/nlab/show/Reshetikhin-Turaev+construction"} Reshetikhin-Turaev construction
            applied to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒞
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathcal{C}_A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            are formally constructed form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            by means of
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊗
                      %msup
                        %mi X
                        %mo ∨
                      %mo ≃
                      %mi A
                    %annotation{:encoding => "application/x-tex"} X \otimes X^\vee \simeq A
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mi A
                      %mo =
                      %mi FusionCat
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %msup
                        %mi X
                        %mo ∨
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_A = FusionCat[X, X^\vee]
          %p
            %strong Remarks
          %ul
            %li
              %p
                i) This is a theory for “
                %a.existingWikiWord{:href => "/nlab/show/string+structure"}> string structure
                ” manifolds in the sense that the
                %a.existingWikiWord{:href => "/nlab/show/first+Stiefel-Whitney+class"} first Stiefel-Whitney class
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi w
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} w_1
                and the
                %a.existingWikiWord{:href => "/nlab/show/first+Pontryagin+class"} first Pontryagin class
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} p_1
                are trivialized, but not necessarily
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi w
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} w_2
            %li
              %p ii) This is the universal extension: every other one factors through it.
              %p
                guess: there is some kind of an “algebraic extension” of fusion categories in which the equation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊗
                      %msup
                        %mi X
                        %mo ∨
                      %mo =
                      %mi A
                    %annotation{:encoding => "application/x-tex"} X \otimes X^\vee = A
                can be solved for any MTC
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
            %li
              %p
                iii) a choice of cube root wil be needed to construct the theory for a
                %a.existingWikiWord{:href => "/nlab/show/framed+manifold"} framed
                3-manifold
              %p
                change of framing:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ↦
                      %mo ×
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mfrac
                        %mrow
                          %mn 2
                          %mi π
                          %mi i
                          %mi c
                          %mi n
                        %mn 24
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} n \mapsto \times \exp(\frac{2 \pi i c n }{24})
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
                a “
                %a.existingWikiWord{:href => "/nlab/show/central+charge"}> central charge
                ”
          %p
            because string
            %a.existingWikiWord{:href => "/nlab/show/bordism+ring"} bordism group
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %mo =
                  %mn 3
                %annotation{:encoding => "application/x-tex"} dim = 3
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_3
            %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mn 3
                        %mtd
                          %msub
                            %mi ℤ
                            %mn 24
                      %mtr
                        %mtd
                          %mn 2
                        %mtd
                          %msub
                            %mi ℤ
                            %mn 2
                      %mtr
                        %mtd
                          %mn 1
                        %mtd
                          %msub
                            %mi ℤ
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  3 &amp; \mathbb{Z}_{24}
                  \\\
                  2 &amp; \mathbb{Z}_2
                  \\\
                  1 &amp; \mathbb{Z}_2
                  }
          %p for spin theories one would need categorical representations of this 3-groupoid, but at the moment not known.
          %p
            %strong Theorem
            (
            %a.existingWikiWord{:href => "/nlab/show/Kevin+Walker"}> Kevin Walker
            , in
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Jacob Lurie
          %ul
            %li
              %p
                i)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                generates an invertible 4d
                %a.existingWikiWord{:href => "/nlab/show/extended+TQFT"} extended TQFT
                for
                %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
                manifolds;
            %li
              %p
                ii)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is a valid boundary condition over itself;
          %p
            The 3d boundary theory in dim 1-2-3 is equivalent to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ReshTur
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ReshTur(A)
            after a choice of “bulking manifold”
          %p
            %strong Comments
            there is a symmetric monoidal 4-category whose
          %ul
            %li
              %p objects are bimodule tensor categories
            %li
              %p
                morphisms are bialgebra categories = tensor categories
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                with braided monoidal functors
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %msup
                        %mi B
                        %mi bop
                      %mo →
                      %mi DZ
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (B') \otimes B^{bop} \to DZ(T)
            %li
              %p 2-morphisms are bimodule categories
            %li
              %p 3-morphisms are functors respecting the structure;
            %li
              %p 4-morphisms are natural transformations between these.
          %p
            Invertibility of a TQFT
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⇔
                %annotation{:encoding => "application/x-tex"} \Leftrightarrow
            invertibility of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z(*)
          %p
            so then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mn 1
                %annotation{:encoding => "application/x-tex"} Z(S^1) \simeq 1
          %p
            %strong Lemma
            %a.existingWikiWord{:href => "/nlab/show/modular+tensor+categories"} modular tensor categories
            are invertible in this sense
          %p (4d anomaly theory) + (bulking manifold) = (3d standalone theory)
          %p
            %strong Result
            Have a 3d TQFT defined on the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Bord
                    %mrow
                      %mn 0
                      %mo −
                      %mn 1
                      %mo −
                      %mn 2
                      %mo −
                      %mn 3
                      %mo −
                      %mn 4
                    %mi String
                %annotation{:encoding => "application/x-tex"} Bord^String_{0-1-2-3-4}
            of manifolds which bound.
          %p So the final step in the construction of the full 0-1-2-3-4 theory is to extend from that to the full category of bordisms.
          %h3#boundary_conditions_wzw_theory Boundary conditions: WZW theory
          %p general metaphor:
          %ul
            %li
              %p
                TQFT
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ↔
                    %annotation{:encoding => "application/x-tex"} \leftrightarrow
                algebra
            %li
              %p
                boundary condition
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ↔
                    %annotation{:encoding => "application/x-tex"} \leftrightarrow
                bimodule
          %p other metaphor
          %ul
            %li
              %p
                TQFT
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
                determined by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Z(*)
            %li
              %p
                boundary condition
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo :
                      %mn 1
                      %mo →
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha : 1 \to Z(*)
                (left) or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo :
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \beta : Z(*) \to 1
                (right)
          %p
            For the 3d RT theory this yields for boundary conditions
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi DZ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} DZ(T)
          %p
            %strong Theorem
            (
            %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"}> Graeme Segal
            )
          %p Chiral WZW model is a conformal boundary for CS theory
          %p
            %strong Problem
            make this work down to the point
          %h2#related_references Related references
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dan+Freed"}> Dan Freed
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/4-3-2+8-7-6"} 4-3-2 8-7-6
          .property
            category:
            %a.category_link{:href => "/nlab/all_pages/reference"} reference
