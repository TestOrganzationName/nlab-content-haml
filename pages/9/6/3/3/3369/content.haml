                %li
                  %p “and so on”.
          %p
            For the application to
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            theories we want to be thinking of the data encoded by these
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
          %ul
            %li
              %p
                An
                %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Bord
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Bord_n
                is a piece of
                = succeed "-dimensional" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi Σ
                          %mtr
                            %mtd
                            %mtd
                              %mo ↗
                            %mtd
                            %mtd
                              %mo ↖
                          %mtr
                            %mtd
                              %msub
                                %mi Σ
