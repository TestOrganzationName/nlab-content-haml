                                          %mo{:stretchy => "false"} )
                                          %mi out
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mi C
                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          \&amp;&amp; P
                          \\\
