          %h2#idea Idea
          %p
            Quotient inductive types are
            %a.existingWikiWord{:href => "/nlab/show/higher+inductive+types"} higher inductive types
            with a
            %a.existingWikiWord{:href => "/nlab/show/0-truncation"} 0-truncation
            constructor.
          %h2#examples Examples
          %p
            All quotient inductive types described below are given together with some pseudo-
            %a.existingWikiWord{:href => "/nlab/show/Coq"} Coq
            code, which would implement that QIT if Coq supported QITs natively.
          %h3#integers Integers
          %p
            A definition of the set of
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            as a quotient inductive type.
          %pre
            %code
              :preserve
                Inductive int : Type :=
                | zero : int
                | succ : int -> int
                | pred : int -> int
                | sec : forall (x : int) pred succ x == x
                | ret : forall (x : int) succ pred x == x
                | contr1 : forall (x y : int) (p q : x == y), p == q.          %p Another definition of the integers as a quotient inductive type:
          %pre
            %code
              :preserve
                Inductive int : Type :=
                | zero : int
                | succ : int -> int
                | neg : int -> int
                | axiom1 : neg zero  == zero
                | axiom2 : forall (x : int) succ neg succ x == neg x
                | contr1 : forall (x y : int) (p q : x == y), p == q.          %h3#dyadic_rational_numbers Dyadic rational numbers
          %p
            A minimal inductive definition of the
            %a.existingWikiWord{:href => "/nlab/show/dyadic+rational+numbers"} dyadic rational numbers
            as a quotient inductive type:
          %pre
            %code
              :preserve
                Inductive dyadic : Type :=
                | zero : dyadic
                | succ : dyadic -> dyadic
                | pred : dyadic -> dyadic
                | act : nat -> dyadic -> dyadic
                | sec : forall (x : int) pred succ x == x
                | ret : forall (x : int) succ pred x == x
                | initfunc : forall (x : dyadic) act 0 x == succ x
                | funcsqrt : forall (n : nat) forall (x : dyadic) act (succ n) (act (succ n) x) == act n x
                | contr1 : forall (x y : dyadic) (p q : x == y), p == q.          %p
            A definition of the dyadic rationals as a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+midpoint+algebra"} symmetric midpoint algebra
          %pre
            %code
              :preserve
                Inductive dyadic : Type :=
                | zero : dyadic
                | succ : dyadic -> dyadic
                | neg : dyadic -> dyadic
                | mid : dyadic -> dyadic -> dyadic
                | inv : forall (x : dyadic) neg neg x == x
                | idem : forall (x : dyaduc) mid x x == x
                | comm : forall (x y : dyadic) mid x y == mid y x
                | medial : forall (w x y z : dyadic) mid (mid w x) (mid y z) = mid (mid w y) (mid x z)
                | neutr : forall (x : dyadic) mid (neg x) x == zero
                | distneg : forall (x y : dyadic) mid (neg x) (neg y) == neg mid x y
                | distsucc : forall forall (x y : dyadic) mid (succ x) (succ y) == succ mid x y
                | twicesucc : forall forall (x y : dyadic) mid (succ succ x) y == succ mid x y
                | contr1 : forall (x y : dyadic) (p q : x == y), p == q.          %h3#classically_extended_natural_numbers Classically extended natural numbers
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            of
            %a.existingWikiWord{:href => "/nlab/show/extended+natural+numbers"} extended natural numbers
            as it behaves in
            %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            as a quotient inductive type
          %pre
            %code
              :preserve
                Inductive extnat : Type :=
                | zero : extnat
                | succ : extnat -> extnat
                | inf : extnat
                | fixpoint : succ inf == inf
                | contr1 : forall (x y : int) (p q : x == y), p == q.          %h3#polynomial_rings_over_integers Polynomial rings over integers
          %p
            A definition of the
            %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
            over the integers with a set of indeterminants
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %pre
            %code
              :preserve
                Inductive intpoly (A: Type)  :=
                | indet : A -> (intpoly A)
                | zero : intpoly A
                | one : intpoly A
                | neg : (intpoly A) -> (intpoly A)
                | add : (intpoly A) -> (intpoly A) -> (intpoly A)
                | mult : (intpoly A) -> (intpoly A) -> (intpoly A)
                | alunital : forall (x : intpoly A) add zero x == x
                | arunital : forall (x : intpoly A) add x zero == x
                | aassoc : forall (x y z : intpoly A) add x (add y z) == add (add x y) z
                | acomm : forall (x y : intpoly A) add x y = add y x
                | alinv : forall (x : intpoly A) add (neg x) x == zero
                | arinv : forall (x : intpoly A) add x (neg x) == zero
                | ldist : forall (x y z : intpoly A) mult x (add y z) == add (mult x y) (mult x z)
                | rdist : forall (x y z : intpoly A) mult (add x y) z == add (mult x z) (mult y z)
                | mlunital : forall (x : intpoly A) mult one x == x
                | mrunital : forall (x : intpoly A) mult x one == x
                | massoc : forall (x y z : intpoly A) mult x (mult y z) == mult (mult x y) z
                | mcomm : forall (x y : intpoly A) mult x y = mult y x
                | contr1 : forall (x y : intpoly A) (p q : x == y), p == q.          %h3#quotients_of_sets Quotients of sets
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            of an
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/hProp"} hProp
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            %a.existingWikiWord{:href => "/nlab/show/hSet"} hSet
            or
            %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncated
            type:
          %pre
            %code
              :preserve
                Inductive quotient (A : Type) (R : A -> A -> hProp) : Type :=
                | proj : A -> quotient A R
                | relate : forall (x y : A), R x y -> proj x == proj y
                | contr1 : forall (x y : quotient A R) (p q : x == y), p == q.          %h3#sierpinski_space Sierpinski space
          %p
            A definition of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
          %pre
            %code
              :preserve
                Inductive sierpinski : Type :=
                | top : sierpinski
                | meet : sierpinski -> sierpinski -> sierpinski
                | meet-left-unital : forall (a : sierpinski) meet top a = a
                | meet-right-unital : forall (a : sierpinski) meet a top = a
                | meet-associative : forall (a b c : sierpinski) meet meet a b c = meet a meet b c
                | meet-commutative : forall (a b : sierpinski) meet a b = meet b a
                | meet-idempotent : forall (a : sierpinski) meet a a = a
                | bottom : sierpinski
                | join : sierpinski -> sierpinski -> sierpinski
                | join-left-unital : forall (a : sierpinski) join bottom a = a
                | join-right-unital : forall (a : sierpinski) join a bottom = a
                | join-associative : forall (a b c : sierpinski) join join a b c = join a join b c
                | join-commutative : forall (a b : sierpinski) join a b = join b a
                | join-idempotent : forall (a : sierpinski) join a a = a
                | meet-join-absorption : forall (a b : sierpinski) meet a join a b = a
                | join-meet-absorption : forall (a b : sierpinski) join a meet a b = a
                | sequence-join : (nat -> sierpinski) -> sierpinski
                | sequence-bounded-above : forall (n : nat) (s : nat -> sierpinski) meet s n sequence-join s = s n
                | sequence-least-upper-bound : forall (a : sierpinski) (s : nat -> sierpinski) (forall (n : nat) meet s n a = s n) -> (meet sequence-join s x = sequence-join s)
                | element-sequence-meet : (sierpinski) -> (nat -> sierpinski) -> (nat -> sierpinski)
                | p : forall (a : sierpinski) (s : nat -> sierpinski) element-sequence-meet a s n = meet a s n
                | distributive : forall (a : sierpinski) (s : nat -> sierpinski) meet a sequence-join s = sequence-join element-sequence-meet a s 
                | contr1 : forall (x y : int) (p q : x == y), p == q.          %h3#cumulative_hierarchy Cumulative hierarchy
          %p
            According to
            %a.existingWikiWord{:href => "/nlab/show/Homotopy+Type+Theory+--+Univalent+Foundations+of+Mathematics"} Homotopy Type Theory – Univalent Foundations of Mathematics
            the
            %a.existingWikiWord{:href => "/nlab/show/cumulative+hierarchy"} cumulative hierarchy
            of material sets could be constructed from a type universe as a quotient inductive type.
          %h3#cauchy_complete_real_numbers Cauchy complete real numbers
          %p
            According to
            %a.existingWikiWord{:href => "/nlab/show/Homotopy+Type+Theory+--+Univalent+Foundations+of+Mathematics"} Homotopy Type Theory – Univalent Foundations of Mathematics
            the
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+complete"} Cauchy complete
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            could be constructed from a type universe as a quotient
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inductive-inductive+type"} inductive-inductive type
          %h3#permutable_trees Permutable trees
          %p Altenkirch et al. gives the following definition of a permutable tree:
          %pre
            %code
              :preserve
                Inductive tree (A : Type) :=
                | leaf : tree A
                | node : (A -> tree A) -> tree A
                | mix : (forall (e : A -> A) isequiv(e)) -> (forall (e : A -> A) forall (f: A -> tree A) node f = node(f \circ e)
                | contr1 : forall (x y : tree A) (p q : x == y), p == q.          %h3#free_posets Free posets
          %p
            A definition of a
            %a.existingWikiWord{:href => "/nlab/show/free+object"} free
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            as a quotient inductive-inductive type:
          %pre
            %code
              :preserve
                Inductive poset (A: Type) :=
                | inj: A -> poset A
                | antisym: (forall x y : poset A) (x \leq y) -> (y \leq x) -> (x == y)
                | setcontr: forall (x y: poset A) (p q : x == y), p == q.
                
                Inductive \leq {poset A}: poset A -> poset A -> Type :=
                | refl: (forall x: poset A) x \leq x
                | trans: (forall x y z: poset A) (x \leq y) -> (y \leq z) -> (x \leq z)
                | pordercontr: forall (x y : poset A) (p q : x \leq y), p == q.          %h3#FreePointedOmegaCompletePartialOrders Free pointed omega-complete partial orders
          %p
            It is possible to define the
            %a.existingWikiWord{:href => "/nlab/show/free+object"} free
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            = succeed "-complete" do
              %a.existingWikiWord{:href => "/nlab/show/countable+ordinal"} omega
            %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
            on a 0-truncated type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as a quotient inductive type. They are usually abbreviated as free pointed
            = succeed "-cpos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            = succeed ")" do
              %a{:href => "#ADK2017"} Altenkirch, Danielsson, and Kraus 2017, §3.2
          %pre
            %code
              :preserve
                Inductive omegacpo (A: Type) :=
                | inj: A -> omegacpo A
                | bottom: omegacpo A
                | denumjoin: (exists a: nat -> omegacpo A) (forall n: nat) a n \leq a succ n
                | antisym: (forall x y : omegacpo A) (x \leq y) -> (y \leq x) -> (x == y)
                | setcontr: forall (x y: omegacpo A) (p q : x == y), p == q.
                
                Inductive \leq {omegacpo A}: omegacpo A -> omegacpo A -> Type :=
                | refl: (forall x: omegacpo A) x \leq x
                | trans: (forall x y z: omegacpo A) (x \leq y) -> (y \leq z) -> (x \leq z)
                | init: (forall x : omegacpo A) bottom \leq x
                | upperbound: (forall a: nat -> omegacpo A) ((forall n: nat) a n) \leq denumjoin a p
                | leastupper: (forall x : omegacpo A) ((forall a: nat -> omegacpo A) ((forall n: nat) a n) \leq x) -> (forall a: nat -> omegacpo A) denum a p \leq x)
                | pordercontr: forall (x y : poset A) (p q : x \leq y), p == q.          %p
            Examples include the
            %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} 1_\bot
