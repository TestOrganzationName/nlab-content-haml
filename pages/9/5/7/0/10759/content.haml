                  %annotation{:encoding => "application/x-tex"}
                    X \coloneqq \underset{\rightarrow}{\lim}_n X_n
            %p
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              of this sequence. (The sequence itself is
              = succeed ".)" do
                %em
                  the filtering on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %p
              Dually, a
              %em
                %a.existingWikiWord{:href => "/nlab/show/filtered+object+in+an+%28%E2%88%9E%2C1%29-category"} co-filtered object in an (∞,1)-category
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              together with a
              %a.existingWikiWord{:href => "/nlab/show/sequential+diagram"} sequential diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mo &lt;
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \colon (\mathbb{Z}, \lt) \to \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    X_{n-1} \to X_n \to X_{n+1} \to \cdots
            %p
              and an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28infinity%2C1%29-category"} equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≔
                    %msub
                      %munder
                        %mi lim
                        %mo ←
                      %mi n
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    X \coloneqq \underset{\leftarrow}{\lim}_n X_n
            %p
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              of this sequence. (The sequence itself is
              = succeed ".)" do
                %em
                  the co-filtering on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
          %p
            This appears as (
            %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"}> Higher Algebra, def. 1.2.2.9
            ). The notions are equivalent under replacing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            by its
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
          #FilteredObjectInModelCategory.num_remark
            %h6#remark Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presented
              by a sufficiently nice
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              (for instance a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              are computed by
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} homotopy colimits
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              over a cofibrant
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+functors"} projective model structure on functors
            %p
              Specifically, as discussed at
              %em
                %a{:href => "homotopy+limit#SequentialHocolims"} homotopy limit – Examples – Over sequential diagrams
              a cofibrant resolution of a
              %a.existingWikiWord{:href => "/nlab/show/sequential+diagram"} sequential diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo ,
                    %mo ≤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} (\mathbb{N}, \leq) \to C
              is a sequential diagram all whose whose objects are cofibrant and all whose morphisms are cofibrations in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mover
                      %mo →
                      %mi cof
                    %msub
                      %mi X
                      %mn 0
                    %mover
                      %mo →
                      %mi cof
                    %mi ⋯
                    %mo →
                    %msubsup
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                      %mi C
                    %mover
                      %mo →
                      %mi cof
                    %msubsup
                      %mi X
                      %mi n
                      %mi C
                    %mover
                      %mo →
                      %mi cof
                    %msubsup
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mi C
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\emptyset \stackrel{cof}{\to} X_0 \stackrel{cof}{\to} \cdots \to X^C_{n-1} \stackrel{cof}{\to} X_{n}^C \stackrel{cof}{\to} X_{n+1}^C \to \cdots
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi X
                      %mi n
                      %mi C
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X_n^C \in C
              denotes an object in the model category presenting the given object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi n
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X_n \in \mathcal{C}
            %p
              Moreover, in many
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
              that appear in practice the cofibrations are in particular
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+chain+complexes"} model structure on chain complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              in the abstract sense of
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
              is presented by a
              %a.existingWikiWord{:href => "/nlab/show/filtered+object"} filtered object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi C
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X^C \in C
              in the sense of plain
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            %p
              The intrinsic definition
              %a.maruku-ref{:href => "#GeneralizedFilteredObject"}
              makes manifest however that the
              = succeed "-aspect" do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          #ChainComplexInStableInfinityCategory.num_defn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/linearly+ordered+set"} linearly ordered set
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                \-chain complex
              in a
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi I
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    F \;\colon\; I^{\Delta[1]} \longrightarrow \mathcal{C}
            %p
              from the subposet of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I \times I
              on pairs of elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ≤
                      %mi j
                    %annotation{:encoding => "application/x-tex"} i \leq j
            %ol
              %li
                %p
                  for each
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi I
                        %annotation{:encoding => "application/x-tex"} n \in I
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} F(n,n) \simeq 0
                  is the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              %li
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ≤
                        %mi j
                        %mo ≤
                        %mi k
                      %annotation{:encoding => "application/x-tex"} i \leq j \leq k
                  the induced
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mo ,
                                %mi j
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo ⟶
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mo ,
                                %mi k
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mn 0
                                %mo ≃
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi j
                                %mo ,
                                %mi j
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo ⟶
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi j
                                %mo ,
                                %mi k
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp; F(i,j) &amp;\longrightarrow&amp; F(i,k)
                        \\\
                        \&amp; \downarrow &amp;&amp; \downarrow
                        \\\
                        0 \simeq &amp; F(j,j) &amp;\longrightarrow&amp; F(j,k)
                        }
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
                  square (hence equivalently, by
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/stable+%28infinity%2C1%29-category"} stability
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Gap
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi I
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Gap(I,\mathcal{C}) \hookrightarrow Func(I^{\Delta[1]}, \mathcal{C})
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
              of diagrams satisfying these conditions.
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra, def. 1.2.2.2
          #MoreSquaresArePushouts.num_remark
            %h6#remark_2 Remark
            %p
              The conditions in def.
              %a.maruku-ref{:href => "#ChainComplexInStableInfinityCategory"}
              imply by the
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              that also all squares
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo ,
                            %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo ,
                            %mi l
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo ,
                            %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo ,
                            %mi l
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F(i,k) &amp;\longrightarrow&amp; F(i,l)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    F(j,k) &amp;\longrightarrow&amp; F(j,l)
                    }
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≤
                    %mi k
                  %annotation{:encoding => "application/x-tex"} i \leq k
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %mi l
                  %annotation{:encoding => "application/x-tex"} k \leq l
              are
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
              squares.
          #ChainComplexInducedFromZComplex.num_defn
            %h6#definition_4 Definition
            %p
              Given a
              = succeed "-chain" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#ChainComplexInStableInfinityCategory"}
              %a.existingWikiWord{:href => "/nlab/show/sequential+diagram"} sequential diagram
              in the (
              %a.existingWikiWord{:href => "/nlab/show/triangulated+category"}> triangulated
              )
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28infinity%2C1%29-category"} homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mo ≤
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ⟶
                    %mi Ho
