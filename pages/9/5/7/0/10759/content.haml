              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} r \geq 1
              the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                  %annotation{:encoding => "application/x-tex"} E^r_{p,q}
              by the canonical
              %a{:href => "abelian+category#FactorizationOfMorphisms"} epi-mono factorization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi p
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo −
                    %mi r
                    %mo +
                    %mn 1
                    %mo ,
                    %mi q
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↠
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo ↪
                    %msub
                      %mi π
                      %mi p
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo ,
                    %mi q
                    %mo +
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_{p} X(q-r+1,q+1)
                    \\twoheadrightarrow
