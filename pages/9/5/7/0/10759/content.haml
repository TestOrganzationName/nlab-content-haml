                                  %mi π
                                  %mrow
                                    %mi p
                                    %mo +
                                    %mi q
                                %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi F
                              %mi p
