            %p
              restricts to an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence
              between the (∞,1)-category of
              = succeed "-chain" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mn ∞
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}\cup \{\infty\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ChainComplexInStableInfinityCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
