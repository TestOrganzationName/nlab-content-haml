          .num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              a good
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo =
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} = Ch_\bullet(\mathcal{A})
              the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+chain+complexes"} (∞,1)-category of chain complexes
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              = succeed "," do
                %a.maruku-ref{:href => "#FilteredObjectInModelCategory"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+complex"} spectral sequence of a filtered complex
          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"}> Higher Algebra, example 1.2.2.11
            ).
          .num_example
            %h6#example_3 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo =
                    %msup
                      %mi Spec
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} = Spec^{op}
              be the opposite (∞,1)-category of spectra, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              be the opposite category of abelian groups, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              be the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi K
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [K,-]
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is spectrum. Then condition (1) in Proposition
              %a.maruku-ref{:href => "#FiltrationSpectralSequence"}
              holds for all filtered objects if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+spectrum"} finite spectrum
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} Whitehead tower
              of a spectrum
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
              with target
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^*(K)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a finite spectrum.
          #SpectralSequenceOfASimplicialStableHomotopyType.num_example
            %h6#example_4 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object+in+an+%28%E2%88%9E%2C1%29-category"} simplicial object in an (∞,1)-category
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleta"} simplicial skeleta
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              give it the structure of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/filtered+object+in+an+%28%E2%88%9E%2C1%29-category"} filtered object in an (∞,1)-category
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+stable+homotopy+type"} spectral sequence of a filtered stable homotopy type
              has as its first page the
              %a.existingWikiWord{:href => "/nlab/show/Moore+complexes"} Moore complexes
              of the corresponding
              %a.existingWikiWord{:href => "/nlab/show/simplicial+objects"} simplicial objects
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            %p
              See at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+simplicial+stable+homotopy+type"} spectral sequence of a simplicial stable homotopy type
          %p
            As a special case of example
            %a.maruku-ref{:href => "#SpectralSequenceOfASimplicialStableHomotopyType"}
            we have:
          .num_example
            %h6#example_5 Example
            %p
              The
              = succeed "-based" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
              that approximates homotopy classes of maps between two spectra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              using a
              %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is a special case of the above spectral sequence, with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo =
                      %mi Spec
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}=Spec
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \pi=[X,-]
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mrow
                          %mo ∧
                          %mo •
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mn 1
                      %mo ∧
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} E^{\wedge\bullet+1}\wedge Y
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              for condition (1) in Proposition
              %a.maruku-ref{:href => "#FiltrationSpectralSequence"}
              to hold (see
              = succeed ")." do
                %a{:href => "#Bousfield"} Bousfield, Theorems 6.6 and 6.10
            %p
              See
              %em
                %a.existingWikiWord{:href => "/nlab/show/J-homomorphism+and+chromatic+homotopy"} J-homomorphism and chromatic homotopy
              for an exposition.
          %h3#CanonicalCosimplicialResolutionOfEInfinityAlgebras
            Canonical cosimplicial resolution of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          %p
            We discuss now the special case of coskeletally filtered totalizations coming from the canonical cosimplicial objects induced from
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+algebras"} E-∞ algebras
            (dual
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerves"} Cech nerves
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Sweedler+corings"} Sweedler corings
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Amitsur+complexes"} Amitsur complexes
          %p
            In this form this appears as (
            %a{:href => "#LurieLecture"}> Lurie 10, theorem 2
            ). A review is in (
            %a{:href => "#Wilson13"}> Wilson 13, 1.3
            ). For the analog of this in the traditional formulation see (
            %a{:href => "#Ravenel"}> Ravenel, ch. 3, prop. 3.1.2
            ).
          #FiltrationOfTotalizationByTotalizationOfCoskeleta.num_defn
            %h6#definition_10 Definition
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object+in+an+%28%E2%88%9E%2C1%29-category"} cosimplicial object in an (∞,1)-category
              with
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    Y \;\colon\; \Delta  \longrightarrow \mathcal{C}
            %p
              its
              %a.existingWikiWord{:href => "/nlab/show/totalization"} totalization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tot
                    %mi Y
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ←
                      %mi n
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Tot Y \simeq \underset{\leftarrow}{\lim}_n Y_n
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/filtered+object+in+an+%28infinity%2C1%29-category"} filtered
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralizedFilteredObject"}
              %a.existingWikiWord{:href => "/nlab/show/coskeleta"} coskeleta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tot
                    %mi Y
                    %mo →
                    %mi ⋯
                    %mo →
                    %mi Tot
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi cosk
                      %mn 2
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Tot
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi cosk
                      %mn 1
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Tot
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi cosk
                      %mn 0
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Tot Y
                    \\to
                    \\cdots
                    \\to
                    Tot (cosk_2 Y)
                    \\to
                    Tot (cosk_1 Y)
                    \\to
                    Tot (cosk_0 Y)
                    \\to 0
                    \\,.
          #SpectralSequenceOfSimplicialStableHomotopyType.num_defn
            %h6#definition_11 Definition
            %p
              The
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+stable+homotopy+type"} filtration spectral sequence
              = succeed "," do
                %a.maruku-ref{:href => "#FiltrationSpectralSequence"}
              %a.existingWikiWord{:href => "/nlab/show/totalization"} totalization
              by
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} coskeleta
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#FiltrationOfTotalizationByTotalizationOfCoskeleta"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+simplicial+stable+homotopy+type"} spectral sequence of a simplicial stable homotopy type
          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"}> Higher Algebra, prop. 1.2.4.5
            )
          #E2PageByMooreComplex.num_prop
            %h6#proposition_8 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+simplicial+stable+homotopy+type"} spectral sequence of a simplicial stable homotopy type
              has as first page/
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} E_1
              \-term the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
              of the
              %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
              associated with the
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+objects"} cosimplicial objects
              of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn 2
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo =
                    %msup
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi Tot
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi cosk
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo −
                        %mi q
                    %mi Tot
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E_2^{p,q}
                    \=
                    H^p(\pi_q(Tot (cosk_\bullet(Y))))
                    \\Rightarrow
                    \\pi_{p-q} Tot(Y)
                    \\,.
          %p
            By the discussion at
            %em
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Dold-Kan+correspondence"} ∞-Dold-Kan correspondence
            and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+stable+homotopy+type"} spectral sequence of a filtered stable homotopy type
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra, remark 1.2.4.4
            = succeed ")." do
              %a{:href => "#Wilson13"} Wilson 13, theorem 1.2.4
          .num_defn
            %h6#definition_12 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              be an
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be an
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+algebra"} E-∞ algebra
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⟶
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S \longrightarrow E
                    \\,.
            %p
              The
              %em
                canonical
                %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial object
              associated to this (the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Sweedler+coring"} Sweedler coring
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Amitsur+complex"} Amitsur complex
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo →
                    %mi 𝒞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^{\wedge^{\bullet+1}_S} \;\colon\; \Delta \to \mathcal{C}
                    \\,.
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-module"} ∞-module
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial object
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                    %msub
                      %mo ∧
                      %mi S
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo →
                    %mi 𝒞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^{\wedge^{\bullet+1}_S}\wedge_S X \;\colon\; \Delta \to \mathcal{C}
                    \\,.
          #FlatnessCondition.num_prop
            %h6#proposition_9 Proposition
            %p
              If
