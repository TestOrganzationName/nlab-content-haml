          #ExactCoupleForFilteredObject.num_defn
            %h6#definition_7 Definition
            %p
              For a cofiltered object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralizedFilteredObject"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi n
                    %mo ≔
                    %mi fib
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msub
                      %mi X
