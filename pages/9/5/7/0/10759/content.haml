                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo →
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                        %mo ,
                        %mi q
                        %mo −
                        %mi r
                      %mi r
                  %annotation{:encoding => "application/x-tex"}
                    d^r \;\colon\; E_{p,q}^r \to E_{p-1, q-r}^r
            %p
              to be the restriction of the
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi p
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo ,
                    %mi q
                    %mo +
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo −
                    %mi r
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_{p} X(q,q+r) \to \pi_{p-1} X(q-r, q)
            %p
              from the long exact sequence of remark
              = succeed "," do
                %a.maruku-ref{:href => "#LongExactSequencesOfHomotopyGroups"}
              = succeed "for" do
                %br/
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mi q
                      %mo −
                      %mi r
                    %annotation{:encoding => "application/x-tex"} i=q-r
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo =
                      %mi q
                    %annotation{:encoding => "application/x-tex"} j=q
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mi q
                      %mo +
                      %mi r
                    %annotation{:encoding => "application/x-tex"} k=q+r
          .num_prop
            %h6#proposition_6 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi d
                      %mi r
                    %mo ∘
                    %msup
                      %mi d
                      %mi r
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d^r\circ d^r = 0
              and there are natural (in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %mi r
                        %mo +
                        %mn 1
                    %mo ≅
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ker
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^{r+1}\cong \operatorname{ker}(d^r)/\operatorname{im}(d^r).
            %p
              Thus,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mo *
                        %mo ,
                        %mo *
                      %mi r
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ≥
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \{E^r_{*,*}\}_{r\geq 1}
              is a bigraded
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              in the
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 1
                    %mo =
                    %msub
                      %mi π
                      %mi p
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} fib
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi q
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi q
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "2em"}
                    %msup
                      %mi d
                      %mi r
                    %mo :
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo →
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                        %mo ,
                        %mi q
                        %mo −
                        %mi r
                      %mi r
                    %mo .
                  %annotation{:encoding => "application/x-tex"} E^1_{p,q} = \pi_p \operatorname{fib}(X_q\to X_{q+1}), \qquad d^r: E^r_{p,q}\to E^r_{p-1,q-r}.
          %p
            If
            %a.existingWikiWord{:href => "/nlab/show/sequential+limits"} sequential limits
            and
            %a.existingWikiWord{:href => "/nlab/show/sequential+colimits"} sequential colimits
            exist in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mo *
                      %mo ,
                      %mo *
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} E^\infty_{*,*}
            of this spectral sequence.
          %p
            On the other hand, the
            %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_\bullet (X)
            admits a
            %a.existingWikiWord{:href => "/nlab/show/filtered+object"} filtration
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi q
                  %msub
                    %mi π
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ker
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi π
                    %mi p
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi q
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_q \pi_p (X) = \operatorname{ker}(\pi_p (X)\to \pi_p(X_q))
          %p
            and we would like to compare
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mo *
                      %mo ,
                      %mo *
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} E^\infty_{*,*}
            with the
            %a.existingWikiWord{:href => "/nlab/show/associated+graded"} associated graded
            of this filtration. We say that
          #WeakAndStrongConvergence.num_defn
            %h6#definition_9 Definition
            %p
              The spectral sequence
              %strong converges weakly
              if there is a canonical isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn ∞
                    %mo ≅
                    %msub
                      %mi F
                      %mi q
                    %msub
                      %mi π
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi F
                      %mrow
                        %mi q
                        %mo −
                        %mn 1
                    %msub
                      %mi π
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^\infty_{p,q} \cong F_q\pi_p(X)/ F_{q-1}\pi_p(X)
            %p
              for every
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} p,q\in\mathbb{Z}
            %p
              We say that the spectral sequence
              %strong converges strongly
              if it converges weakly and if, in addition, the filtration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %msub
                      %mi π
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_\bullet\pi_p(X)
              is complete on both sides, that is:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %munder
                        %mi lim
                        %mo →
                      %mi q
                    %msub
                      %mi F
                      %mi q
                    %msub
                      %mi π
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ←
                      %mi q
                    %msup
                      %mi F
                      %mi q
                    %msub
                      %mi π
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\rightarrow}{\lim}_q F_q\pi_p (X)
                    \\simeq
                    \\pi_p(X)
                    \\simeq
                    \\underset{\leftarrow}{\lim}_q F^q\pi_p (X),
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo •
                  %annotation{:encoding => "application/x-tex"} F^\bullet
              is the cofiltration.
          .num_remark
            %h6#remark_8 Remark
            %p
              The meaning of the word
              %em canonical
              in def.
              %a.maruku-ref{:href => "#WeakAndStrongConvergence"}
              is somewhat subtle since, in general, there is no map from one side to the other. However, there always exists a canonical
              %em
                %a.existingWikiWord{:href => "/nlab/show/relation"} relation
              between the two, and we ask that this relation be an isomorphism (see
              = succeed ")." do
                %a{:href => "#HiltonStammbach"} Hilton-Stammbach, VIII.7
          #FiltrationSpectralSequence.num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %mi 𝒞
                    %mo →
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \pi:\mathcal{C}\to\mathcal{A}
              be a homological functor where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is an
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              which admits
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sequential+limits"} sequential limits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              be a filtered object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mo ←
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \underset{\leftarrow}{\lim} X_\bullet
              exists. Suppose further that:
            %ol
              %li
                For every
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ↦
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} fib
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo −
                          %mi r
                      %mo →
                      %msub
                        %mi X
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} r\mapsto \operatorname{fib}(X_{n-r}\to X_n)
                has a limit in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                and that limit is preserved by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                      %annotation{:encoding => "application/x-tex"} \pi
              %li
                For every
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mi r
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \pi_n(X_r)=0
                for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo ≫
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} r\gg 0
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mo *
                        %mo ,
                        %mo *
                      %mi r
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ≥
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \{E^r_{*,*}\}_{r\geq 1}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              converges strongly (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#WeakAndStrongConvergence"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 1
                    %mo =
                    %msub
                      %mi π
                      %mi p
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} fib
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi q
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi q
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %msub
                      %mi π
                      %mi p
                    %mo{:stretchy => "false"} (
                    %munder
                      %mi lim
                      %mo ←
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E_{p,q}^1
                    \=
                    \\pi_{p} \operatorname{fib}(X_q\to X_{q+1})
                    \\Rightarrow
                    \\pi_{p} (\underset{\leftarrow}{\lim} X_\bullet)
          %p
            There is also a dual statement in which limits are replaced by colimits, but it is in fact a special case of the proposition with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
