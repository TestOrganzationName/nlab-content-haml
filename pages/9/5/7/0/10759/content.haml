                  %mi π
                %annotation{:encoding => "application/x-tex"} \pi
            replaced by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi π
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \pi^{op}
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra, prop. 1.2.2.14
            = succeed ")." do
              %a{:href => "#Wilson13"} Wilson 13, theorem 1.2.1
