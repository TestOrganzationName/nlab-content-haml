            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/exact+couple"} exact couple
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi K
                              %mo •
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↖
                        %mtr
                          %mtd
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mo •
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                          %mtd
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mo •
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \pi_\bullet(K_\bullet)
                    \\\
                    \&amp; \swarrow &amp;&amp; \nwarrow
                    \\\
