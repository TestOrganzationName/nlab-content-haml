                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \pi_{p+q}X
                    \\\
                    \&amp; {}^{\mathllap{g}}\nearrow &amp;&amp; \searrow^{\mathrlap{f'}}
                    \\\
                    \\pi_{p+q} X(p)
                    \&amp;&amp;
                    \\stackrel{f}{\longrightarrow}
                    \&amp;&amp;
                    \\pi_{p+q} Y
                    }
            %p
              Using these relation we can now express
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn ∞
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo ≃
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_\infty^{p,q} \simeq im(f)
              as:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi E
                              %mn ∞
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
