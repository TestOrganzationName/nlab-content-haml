                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo ,
                            %mi p
                            %mo +
                            %mi r
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi δ
                                  %mi r
                          %mtd
                            %mi Σ
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo −
                            %mi r
                            %mo ,
                            %mi p
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F(p-2r,p) &amp;\longrightarrow&amp; F(p-2r,p+1) &amp;\longrightarrow&amp; 0
                    \\\
                    \\downarrow &amp;(c)&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    F(p-r,n) &amp;\longrightarrow&amp; F(p-r,p+1) &amp;\longrightarrow&amp; 0
                    \\\
                    \\downarrow &amp;(c)&amp; \downarrow &amp;(c)&amp; \downarrow
                    \\\
                    0 &amp;\longrightarrow&amp; F(p,p+r) &amp;\underset{\delta_r}{\longrightarrow}&amp; \Sigma F(p-r,p)
                    }
            %p
              where the squares labeled “c” are (co-)cartesian (
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pushouts"}> homotopy pushouts
              ). By the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the pushout, this induces a factorization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo ,
                            %mi p
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Σ
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo −
                            %mn 2
                            %mi r
                            %mo ,
                            %mi p
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi δ
                                    %mi r
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Σ
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo −
                            %mi r
                            %mo ,
                            %mi p
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F(p,p+1) &amp;\longrightarrow&amp; \Sigma F(p-2r,p)
                    \\\
                    \&amp; {}_{\mathllap{\delta_r}}\searrow &amp; \downarrow
                    \\\
                    \&amp;&amp; \Sigma F(p-r,p)
                    }
                    \\,.
            %p
              Pasting this in turn to the homotopy pushout that defines
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %msub
                      %mi δ
                      %mrow
                        %mi p
                        %mo −
                        %mi r
                  %annotation{:encoding => "application/x-tex"} \Sigma \delta_{p-r}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo ,
                            %mi p
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Σ
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo −
                            %mn 2
                            %mi r
                            %mo ,
                            %mi p
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi δ
                                    %mi r
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Σ
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo −
                            %mi r
                            %mo ,
                            %mi p
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi Σ
                                %msub
                                  %mi δ
                                  %mi r
                          %mtd
                            %msup
                              %mi Σ
                              %mn 2
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo −
                            %mn 2
                            %mi r
                            %mo ,
                            %mi p
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F(p,p+1) &amp;\longrightarrow&amp; \Sigma F(p-2r,p)  &amp;\longrightarrow&amp; 0
                    \\\
                    \&amp; {}_{\mathllap{\delta_r}}\searrow &amp; \downarrow &amp;(c)&amp; \downarrow
                    \\\
                    \&amp;&amp; \Sigma F(p-r,p) &amp;\underset{\Sigma \delta_{r}}{\longrightarrow}&amp;
                    \\Sigma^2 F(p-2r,p-1)
                    }
            %p
              and then suspending the result
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              times yields a diagram that exhibits a null-homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi r
                    %mo ∘
                    %msub
                      %mi δ
                      %mi r
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_{r}  \circ \delta_r \simeq 0
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              Next, to show the homology isomorphisms; consider for fixed
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                    %mo ,
                    %mi r
                  %annotation{:encoding => "application/x-tex"} p,q,r
              the usual abbreviation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ≔
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"}
                    C \coloneqq E_r^{p,q}
            %p
              for the
              = succeed "-relative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/chains"} chains
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo ≔
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi r
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo →
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi p
                        %mo −
                        %mi r
                        %mo ,
                        %mi q
                        %mo +
                        %mi r
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Z \coloneqq ker(d_r \colon E_r^{p,q} \to E_r^{p-r, q+r-1})
            %p
              for the
              = succeed "-relative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ≔
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi r
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi p
                        %mo +
                        %mi r
                        %mo ,
                        %mi q
                        %mo −
                        %mi r
                        %mo +
                        %mn 1
                    %mo →
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    B \coloneqq im(d_r \colon E_r^{p+r, q-r+1} \to E_r^{p,q})
            %p
              for the
              = succeed "-relative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %annotation{:encoding => "application/x-tex"} p,q
            %p
              We claim that the canonical maps induce a sequence of morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo −
                    %mi r
                    %mo −
                    %mn 1
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi ϕ
                    %mi Z
                    %mover
                      %mo →
                      %mrow
                        %mi ϕ
                        %mo ′
                    %mi Z
                    %mo{:stretchy => "false"} /
                    %mi B
                    %mover
                      %mo →
                      %mrow
                        %mi ψ
                        %mo ′
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi B
                    %mover
                      %mo →
                      %mi ψ
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo −
                    %mn 1
                    %mo ,
                    %mi p
                    %mo +
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_{p+q} X(p-r-1, p)
                    \\stackrel{\phi}{\to}
                    Z
                    \\stackrel{\phi'}{\to}
                    Z/B
                    \\stackrel{\psi'}{\to}
                    C/B
                    \\stackrel{\psi}{\to}
                    \\pi_{p+q} X(p-1, p+r)
            %p
              and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ′
                    %mo ∘
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi'\circ \phi
              is an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo ∘
                    %mi ϕ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \psi \circ \phi'
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              factorization in the
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo −
                    %mi r
                    %mo −
                    %mn 1
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_{p+q} X(p-r-1,p)
              is indeed in the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi r
                  %annotation{:encoding => "application/x-tex"} d_r
              consider the
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi π
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo −
                            %mi r
                            %mo −
                            %mn 1
                            %mo ,
                            %mi p
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi π
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                                %mo −
                                %mn 1
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo −
                            %mn 2
                            %mi r
                            %mo ,
                            %mi p
                            %mo −
                            %mi r
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %msub
                              %mi π
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo −
                            %mi r
                            %mo ,
                            %mi p
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi π
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                                %mo −
                                %mn 1
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo −
                            %mn 2
                            %mi r
                            %mo ,
                            %mi p
                            %mo −
                            %mi r
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msubsup
                              %mi E
                              %mi r
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi d
                                  %mi r
                          %mtd
                            %msubsup
                              %mi E
                              %mi r
                              %mrow
                                %mi p
                                %mo −
                                %mi r
                                %mo ,
                                %mi q
                                %mo +
                                %mi r
                                %mo −
                                %mn 1
                          %mtd
                          %mtd
                            %msub
                              %mi π
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                                %mo −
                                %mn 1
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo −
                            %mn 2
                            %mi r
                            %mo ,
                            %mi p
                            %mo −
                            %mi r
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi π
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                                %mo −
                                %mn 1
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo −
                            %mi r
                            %mo −
                            %mn 1
                            %mo ,
                            %mi p
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\pi_{p+q} X(p-r-1,p) &amp;\longrightarrow&amp; \pi_{p+q-1} X(p-2r, p- r-1)
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp; \searrow
                    \\\
                    \\pi_{p+q} X(p-r, p) &amp;\longrightarrow&amp; \pi_{p+q-1}X(p-2r, p-r)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    E_r^{p,q} &amp;\stackrel{d_r}{\longrightarrow}&amp; E_r^{p-r, q+r-1}
                    \&amp;&amp; \pi_{p+q-1} X(p - 2r, p-r)
                    \\\
                    \&amp;&amp; \downarrow &amp; \swarrow
                    \\\
                    \&amp;&amp; \pi_{p+q-1} X(p - r - 1, p - 1)
                    }
                    \\,.
            %p
              Since the bottom right morphism is a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              by construction, the claim is equivalently that the total composite from top-left to bottom right is zero. By commutativity of the diagram this factors through the composite from top-right to bottom-right. As indicated, this in turn factors through two consecutive morphisms of an
              = succeed "-square," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ≤
                      %mi j
                      %mo ≤
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (i \leq j \leq k)
              = succeed "-chain" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %p
              By a dual argument one has that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo −
                    %mn 1
                    %mo ,
                    %mi p
                    %mo +
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_{p+q}X(p-1, p+r)
              is in the
              %a.existingWikiWord{:href => "/nlab/show/coimage"} coimage
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi r
                    %annotation{:encoding => "application/x-tex"} d_r
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mo →
                        %mi ϕ
                      %mover
                        %mo →
                        %mrow
                          %mi ϕ
                          %mo ′
                      %mover
                        %mo →
                        %mrow
                          %mi ψ
                          %mo ′
                      %mover
                        %mo →
                        %mi ψ
                    %annotation{:encoding => "application/x-tex"} \stackrel{\phi}{\to}\stackrel{\phi'}{\to}\stackrel{\psi'}{\to}\stackrel{\psi}{\to}
            %p
              It now remains to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              (dually
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              will be a
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              = succeed "\u2026)" do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra, p. 41
          %p
            We can now consider the convergence of the spectral sequence of prop.
            = succeed "." do
              %a.maruku-ref{:href => "#ExistenceOfTheSpectralSequence"}
          #FilteringOnHomotopyGroups.num_defn
            %h6#definition_6 Definition
            %p
              Given a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/filtered+object+in+an+%28%E2%88%9E%2C1%29-category"} filtered object
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralizedFilteredObject"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ≃
                      %msub
                        %munder
                          %mi lim
                          %mo ⟶
                        %mi n
                      %msub
                        %mi X
                        %mi n
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \simeq \underset{\longrightarrow}{\lim}_n X_n \in \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/filtered+object"} filtering
              on its
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo •
                    %msub
                      %mi π
                      %mo •
                    %mi X
                  %annotation{:encoding => "application/x-tex"} F^\bullet \pi_\bullet X
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/images"} images
              of the homotopy groups of the
              %a.existingWikiWord{:href => "/nlab/show/strata"} strata
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi p
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mi X
                    %mo ≔
                    %mi im
                    %mrow
                      %mo (
                      %msub
                        %mi π
                        %mrow
                          %mi p
                          %mo +
                          %mi q
                      %msub
                        %mi X
                        %mi p
                      %mo →
                      %msub
                        %mi π
                        %mrow
                          %mi p
                          %mo +
                          %mi q
                      %mi X
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mi 𝒜
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F^p \pi_{p+q}X
                    \\coloneqq
                    im\left(
                    \\pi_{p+q} X_{p} \to \pi_{p+q} X
                    \\right)
                    \\,\,\,
                    \\in \mathcal{A}
                    \\,.
          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"}> Higher Algebra, p. 43
            )
          #ConvergenceOfTheSpectralSequence.num_prop
            %h6#proposition_4 Proposition
            %p
              Assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              admits all
              %a.existingWikiWord{:href => "/nlab/show/sequential+colimits"} sequential colimits
              and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              preserves these. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi n
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X \simeq \underset{\longrightarrow}{\lim}_n X_n
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/filtered+object+in+an+%28%E2%88%9E%2C1%29-category"} filtered object
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralizedFilteredObject"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo &lt;
                          %mn 0
                      %mo ≃
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} X_{n \lt 0} \simeq 0
              = succeed "," do
                %a.maruku-ref{:href => "#ExistenceOfTheSpectralSequence"}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn 1
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo =
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} cofib
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    E_1^{p,q}
                    \=
                    \\pi_{p+q} \operatorname{cofib}(X_{p-1}\to X_{p})
                    \\simeq \pi_q (C_p)
                    \\;\;\Rightarrow\;\;
                    \\pi_{p+q} X
                    \\,,
            %p
              where the first page is identified following remark
              = succeed "." do
                %a.maruku-ref{:href => "#FirstPageOfTheSpectralSequence"}
            %p
              In detail, for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} p,q \in \mathbb{Z}
              the
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi r
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo →
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi p
                        %mo −
                        %mi r
                        %mo ,
                        %mi q
                        %mo +
                        %mi r
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} d_r \colon E_r^{p,q} \to E_r^{p-r, q+r-1}
              vanish for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo &gt;
                      %mi p
                    %annotation{:encoding => "application/x-tex"} r \gt p
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              (in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn ∞
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo ≔
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mrow
                        %mi r
                        %mo &gt;
                        %mi p
                    %msub
                      %mi E
                      %mi r
                  %annotation{:encoding => "application/x-tex"}
                    E^{p,q}_\infty \coloneqq \underset{\longrightarrow}{\lim}_{r \gt p} E_r
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/associated+graded+object"} associated graded object
              of the filtered homotopy groups of def.
              = succeed ":" do
                %a.maruku-ref{:href => "#FilteringOnHomotopyGroups"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn ∞
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo ≃
                    %msup
                      %mi F
                      %mi p
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi F
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^{p,q}_\infty \simeq F^p \pi_{p+q}(X) / F^{p-1} \pi_{p+q}(X)
                    \\,.
          %p
            This is due to (
            %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"}> Higher Algebra, prop. 1.2.2.14
            ). A quick review is in (
            %a{:href => "#Wilson13"}> Wilson 13, theorem 1.2.1
            ).
          .proof
            %h6#proof_3 Proof
            %p
              The assumption
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo &lt;
                        %mn 0
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} X_{n \lt 0} \simeq 0
              implies that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} i,j \lt 0
              we have, by remark
              = succeed "," do
                %a.maruku-ref{:href => "#FromSequencesToZComplexes"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi cofib
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo →
                    %msub
                      %mi X
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi for
                    %mspace{:width => "thinmathspace"}
                    %mi i
                    %mo ,
                    %mi j
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    X(i,j) \simeq cofib(X_i \to X_j) \simeq 0 \;\;\;\; for\, i,j \lt 0
            %p
              and therefore it follows that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi E
                        %mi r
                        %mrow
                          %mi p
                          %mo −
                          %mi r
                          %mo ,
                          %mi q
                          %mo +
                          %mi r
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} E_r^{p-r,q+r-1}
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mrow
                          %mi p
                          %mo +
                          %mi q
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo −
                      %mn 2
                      %mi r
                      %mo ,
                      %mi p
                      %mo −
                      %mi r
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_{p+q} X(p-2r, p-r)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo &gt;
                      %mi p
                    %annotation{:encoding => "application/x-tex"} r \gt p
            %p The same assumption implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo −
                    %mi r
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi X
                      %mi p
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi for
                    %mspace{:width => "thinmathspace"}
                    %mi p
                    %mo &gt;
                    %mi r
                  %annotation{:encoding => "application/x-tex"}
                    X(p-r,p) \simeq X_p \;\;\;\; for\, p \gt r
            %p
              and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn ∞
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} E_\infty^{p,q}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn ∞
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo ≃
                    %mi im
                    %mrow
                      %mo (
                      %msub
                        %mi π
                        %mrow
                          %mi p
                          %mo +
                          %mi q
                      %msub
                        %mi X
                        %mi p
                      %mo →
                      %msub
                        %mi π
                        %mrow
                          %mi p
                          %mo +
                          %mi q
                      %mi Y
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    E_\infty^{p,q}
                    \\simeq
                    im\left(
                    \\pi_{p+q} X_p \to \pi_{p+q} Y
                    \\right)
            %p for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ≔
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi r
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo −
                    %mn 1
                    %mo ,
                    %mi p
                    %mo +
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Y \coloneqq \underset{\longrightarrow}{\lim}_r X(p-1,p+r)
                    \\,.
            %p
              We need to show that this image is the
              %a.existingWikiWord{:href => "/nlab/show/associated+graded+object"} associated graded object
              of the filtered homotopy groups.
            %p
              To that end, observe that the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequences"} homotopy fiber sequences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo +
                        %mi r
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo −
                    %mn 1
                    %mo ,
                    %mi p
                    %mo +
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X_{p-1} \to X_{p+r} \to X(p-1,p+r)
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              give a homotopy fiber sequence under the colimit over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %mo →
                    %mi X
                    %mo →
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X_{p-1} \to X \to Y
                    \\,.
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
              truncates on the left to read
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi F
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mrow
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %mi f
                        %mo ′
                    %msub
                      %mi π
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to F^{p-1} \pi_{p+q}(X) \stackrel{ker(f')}{\hookrightarrow} \pi_{p+q} X \stackrel{f'}{\to} \pi_{p+q}Y
                    \\,.
            %p
              By construction the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f'
              appearing here factors the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              whose image we need to compute as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi π
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi g
                            %mo ↗
                          %mtd
