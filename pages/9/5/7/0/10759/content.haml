                    %mi ℤ
                    %mo ,
                    %mo ≤
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
