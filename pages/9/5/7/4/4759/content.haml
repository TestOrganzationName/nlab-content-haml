                        %mi n
                        %mn 1
                      %mo ≤
                      %msub
                        %mi n
                        %mn 2
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n_1 \leq n_2 \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi i
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi n
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi n
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (B i)^\ast
                    \\;\colon\;
                    H^\bullet(B U(n_2))
                    \\longrightarrow
                    H^\bullet(B U(n_1))
            %p is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi i
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi c
                                %mi k
                            %mtd
                              %mi for
                              %mspace{:width => "thickmathspace"}
                              %mn 1
                              %mo ≤
                              %mi k
                              %mo ≤
                              %msub
                                %mi n
                                %mn 1
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (B i)^\ast(c_k)
                    \\;=\;
                    \\left\{
                    \\array{
                    c_k &amp; for \; 1 \leq k \leq n_1
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Kochman96"} Kochman 96, theorem 2.3.1
          .proof
            %h6#proof Proof
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} B U(1) \simeq \mathbb{C}P^\infty
              is the infinite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              = succeed ")" do
                %a{:href => "complex+projective+space#OrdinaryCohomologyOfComplexProjectiveSpace"} prop
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(B U(1)) \simeq \mathbb{Z}[ c_1 ]
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n-1
            %p
              Observe that the canonical map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(n-1) \to B U(n)
              has as
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} (2n-1)sphere
              (
              %a{:href => "classifying+space#SphereFibrationOverInclusionOfClassifyingSpaces"}> prop.
              ) hence there is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo −
                        %mn 1
                    %mo ⟶
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^{2n-1} \longrightarrow B U(n-1) \longrightarrow B U(n)
                    \\,.
            %p
              Consider the induced
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Thom-Gysin+sequence"} Thom-Gysin sequence
            %p
              In odd degrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi k
                    %mo +
                    %mn 1
                    %mo &lt;
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 2k+1 \lt 2n
              it gives the
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi H
                            %mrow
                              %mn 2
                              %mi k
                              %mo +
                              %mn 1
                              %mo −
                              %mn 2
                              %mi n
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mo ≃
                        %mn 0
                    %mo ⟶
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi i
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi H
                            %mrow
                              %mn 2
                              %mi k
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mo ≃
                        %mn 0
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    H^{2k}(B U(n-1))
                    \\longrightarrow
                    \\underset{\simeq 0}{\underbrace{H^{2k+1-2n}(B U(n))}}
                    \\longrightarrow
                    H^{2k+1}(B U(n))
                    \\overset{(B i)^\ast}{\longrightarrow}
                    \\underset{\simeq 0}{\underbrace{H^{2k+1}(B U(n-1))}}
                    \\to
                    \\cdots
                    \\,,
            %p
              where the right term vanishes by induction assumption, and the middle term since
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              vanishes in negative degrees. Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi for
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %mi k
                    %mo +
                    %mn 1
                    %mo &lt;
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"}
                    H^{2k+1}(B U(n)) \simeq 0 \;\;\; for \; 2k+1 \lt 2n
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi k
                    %mo +
                    %mn 1
                    %mo &gt;
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 2k+1 \gt 2n
              the Thom-Gysin sequence gives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                        %mo −
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi i
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi H
                            %mrow
                              %mn 2
                              %mi k
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mo ≃
                        %mn 0
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    H^{2k+1-2n}(B U(n))
                    \\longrightarrow
                    H^{2k+1}(B U(n))
                    \\overset{(B i)^\ast}{\longrightarrow}
                    \\underset{\simeq 0}{\underbrace{H^{2k+1}(B U(n-1))}}
                    \\to
                    \\cdots
                    \\,,
            %p
              where again the right term vanishes by the induction assumption. Hence
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exactness
              now gives that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                        %mo −
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^{2k+1-2n}(B U(n))
                    \\overset{}{\longrightarrow}
                    H^{2k+1}(B U(n))
            %p
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    H^{2k+1}(B U(n)) \simeq 0
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              Next consider the Thom Gysin sequence in degrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi k
                  %annotation{:encoding => "application/x-tex"} 2k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi H
                            %mrow
                              %mn 2
                              %mi k
                              %mo −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mo ≃
                        %mn 0
                    %mo ⟶
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo −
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi i
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi H
                            %mrow
                              %mn 2
                              %mi k
                              %mo +
                              %mn 1
                              %mo −
                              %mn 2
                              %mi n
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mo ≃
                        %mn 0
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    \\underset{\simeq 0}{\underbrace{H^{2k-1}(B U(n-1))}}
                    \\longrightarrow
                    H^{2k-2n}(B U(n))
                    \\longrightarrow
                    H^{2k}(B U(n))
                    \\overset{(B i)^\ast}{\longrightarrow}
                    H^{2k}(B U(n-1))
                    \\longrightarrow
                    \\underset{\simeq 0}{\underbrace{H^{2k +1 - 2n}(B U(n))}}
                    \\to
                    \\cdots
                    \\,.
            %p
              Here the left term vanishes by the induction assumption, while the right term vanishes by the previous statement. Hence we have a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo −
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi i
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    H^{2k-2n}(B U(n))
                    \\longrightarrow
                    H^{2k}(B U(n))
                    \\overset{(B i)^\ast}{\longrightarrow}
                    H^{2k}(B U(n-1))
                    \\to
                    0
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo •
                    %mo ≤
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \bullet\leq 2n
              this says
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi ℤ
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi c
                          %mi n
                        %mo ∪
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi H
                      %mrow
                        %mo •
                        %mo ≤
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi i
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi c
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo •
                        %mo ≤
                        %mn 2
                        %mi n
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    \\mathbb{Z}
                    \\overset{c_n \cup (-)}{\longrightarrow}
