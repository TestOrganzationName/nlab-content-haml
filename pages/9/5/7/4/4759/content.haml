            applied to these first Chern classes:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi i
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi σ
                    %mi k
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
