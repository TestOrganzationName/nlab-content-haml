          %h2#idea Idea
          %p
            The ordinary
            %em Chern classes
            are the
            %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral
            %a.existingWikiWord{:href => "/nlab/show/characteristic+classes"} characteristic classes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi i
                  %mo :
                  %mi B
                  %mi U
                  %mo →
                  %msup
                    %mi B
                    %mrow
                      %mn 2
                      %mi i
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  c_i : B U \to B^{2 i} \mathbb{Z}
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi U
                %annotation{:encoding => "application/x-tex"} B U
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
          %p
            Accordingly these are characteristic classes in
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            of
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} U
            %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            and hence of
            %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundle"} complex vector bundle
          %p
            The first Chern class is the unique characteristic class of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundles"} principal U(1)-bundles
          %p
            The analogous classes for the
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            are the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin+classes"} Pontryagin classes
          %p
            More generally, there are
            %em
              %a.existingWikiWord{:href => "/nlab/show/generalized+Chern+classes"} generalized Chern classes
            for any
            %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
            (
            %a{:href => "#Adams74"}> Adams 74
            ,
            = succeed ")." do
              %a{:href => "#Lurie10"} Lurie 10
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
              the
              %em
                %a.existingWikiWord{:href => "/nlab/show/universal+characteristic+classes"} universal
                Chern
                %a.existingWikiWord{:href => "/nlab/show/characteristic+classes"} classes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi i
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    c_i
                    \\;\in\;
                    H^{2i}
                    \\big(
                    B U(n), \mathbb{Z}
                    \\big)
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %a.existingWikiWord{:href => "/nlab/show/BU%28n%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B U(n)
              of the
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
              are the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+classes"} cohomology classes
              of
              %a.existingWikiWord{:href => "/nlab/show/BU%28n%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B U(n)
              in
              %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
              that are characterized as follows:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mn 0
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} c_0 = 1
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mi i
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} c_i = 0
                  if
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo &gt;
                          %mi n
                        %annotation{:encoding => "application/x-tex"} i \gt n
              %li
                %p
                  for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo =
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n = 1
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} c_1
                  is the canonical generator of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi H
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi ℤ
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi ℤ
                        %annotation{:encoding => "application/x-tex"} H^2(B U(1), \mathbb{Z})\simeq \mathbb{Z}
              %li
                %p
                  under pullback along the inclusion
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo :
                        %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} i : B U(n) \to B U(n+1)
                  we have
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi i
                            %mo *
                          %msubsup
                            %mi c
                            %mi i
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mo =
                          %msubsup
                            %mi c
                            %mi i
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} i^* c_i^{(n+1)} = c_i^{(n)}
              %li
                %p
                  under the inclusion
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi l
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo +
                        %mi l
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B U(k) \times B U(l) \to B U(k+l)
                  we have
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi i
                            %mo *
                          %msub
                            %mi c
                            %mi i
                          %mo =
                          %msubsup
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi j
                              %mo =
                              %mn 0
                            %mi i
                          %msub
                            %mi c
                            %mi i
                          %mo ∪
                          %msub
                            %mi c
                            %mrow
                              %mi j
                              %mo −
                              %mi i
                        %annotation{:encoding => "application/x-tex"} i^* c_i = \sum_{j = 0}^i c_i \cup c_{j-i}
            %p
              The corresponding
              %em total Chern class
              is the formal sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mo +
                    %msub
                      %mi c
                      %mn 1
                    %mo +
                    %msub
                      %mi c
                      %mn 2
                    %mo +
                    %mi ⋯
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi k
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    c
                    \\;\coloneqq\;
                    1 + c_1 + c_2 + \cdots
                    \\;\in\;
                    \\underset{k}{\prod}
                    H^{2k}
                    \\big(
                    B U(n)
                    \\big)
          %h2#properties Properties
          %h3#existence Existence
          #GeneratorsOfCohomologyOfBunChernClasses.num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              of the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %a.existingWikiWord{:href => "/nlab/show/BU%28n%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B U(n)
              (for the
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(n)
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              on generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi c
                      %mi k
                    %msubsup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo =
                        %mn 1
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{c_k\}_{k = 1}^{n}
              of degree 2, called the
              %em Chern classes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi c
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
