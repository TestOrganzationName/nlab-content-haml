                    \&amp; \;=\;
                    1
                    \\\
                    \&amp;
                    \\phantom{\;=\;}
                    +
                    \\underset{ \color{blue} = - p_1(\nabla) }{
                    \\underbrace{
                    \\frac
                    {\tr\big( (F_\nabla)^2 \big) }
                    { 8 \pi^2  }
                    }}
                    \\\
                    \&amp;
                    \\phantom{\;=\;}
                    +
                    \\underset{ \color{blue} = p_2(\nabla) }{
                    \\underbrace{
                    \\frac
                    {
                    \- 2
                    \\cdot
                    tr\big( (F_\nabla)^4 \big)
                    +
                    tr\big(  (F_\nabla)^2 \big)^2
                    }
                    {128 \pi^4}
                    }}
                    \\\
                    \\phantom{\;=\;}
                    +
                    \\cdots
                    \\end{aligned}
            %p
              Hence the first couple of
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+forms"} Pontrjagin forms
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi p
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mo ∇
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo −
                            %mfrac
                              %mrow
                                %mo{:lspace => "0em", :rspace => "thinmathspace"} tr
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi F
                                  %mo ∇
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 2
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mrow
                                %mn 8
                                %msup
                                  %mi π
                                  %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi p
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mo ∇
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mfrac
                              %mrow
                                %mi tr
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi F
                                  %mo ∇
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 2
                                %msup
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                  %mn 2
                                %mo −
                                %mn 2
                                %mo ⋅
                                %mi tr
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi F
                                  %mo ∇
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 4
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mrow
                                %mn 128
                                %msup
                                  %mi π
                                  %mn 4
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p_1(\nabla)
                    \&amp;
                    \\;=\;
                    \-
                    \\frac
                    {\tr\big( (F_\nabla)^2 \big) }
                    { 8 \pi^2  }
                    \\\
                    p_2(\nabla)
                    \&amp; \;=\;
                    \\frac
                    {
                    tr\big(  (F_\nabla)^2 \big)^2
                    \- 2
                    \\cdot
                    tr\big( (F_\nabla)^4 \big)
                    }
                    {128 \pi^4}
                    \\,.
                    \\end{aligned}
            %p
              (See also, e.g.,
              = succeed ")" do
                %a{:href => "#Nakahara03"} Nakahara 2003, Exp. 11.5
            %h5#euler_forms Euler forms
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                    %mi k
                  %annotation{:encoding => "application/x-tex"} n = 2k
              and with the
              %a.existingWikiWord{:href => "/nlab/show/curvature+form"} curvature form
              again regarded as a 2-form valued
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (2k) \times (2k)
              %a.existingWikiWord{:href => "/nlab/show/square+matrix"} square matrix
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo ∇
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi a
                    %msub
                      %mrow
                      %mi b
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mn 1
                        %mo ≤
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mo ≤
                        %mn 2
                        %mi k
                  %annotation{:encoding => "application/x-tex"}
                    F_{\nabla}
                    \\;=\;
                    \\big(
                    (F_{\nabla})^a{}_b
                    \\big)_{1 \leq a,b, \leq 2k}
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/Euler+form"} Euler form
              is its
              %a.existingWikiWord{:href => "/nlab/show/Pfaffian"} Pfaffian
              of this matrix, hence the following
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              over
              %a.existingWikiWord{:href => "/nlab/show/permutations"} permutations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma \in Sym(2k)
              with summands signed by the the
              %a.existingWikiWord{:href => "/nlab/show/signature+of+a+permutation"} signature
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sgn
                      %mo{:stretchy => "false"} (
                      %mi σ
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mo ±
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} sgn(\sigma) \in \{\pm 1\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi k
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mi π
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi k
                        %mo ⋅
                        %mi k
                        %mo !
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi σ
                    %mi sgn
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi k
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi k
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_{2k}(\nabla)
                    \\;=\;
                    \\frac
                    {(-1)^k}
                    { (4 \pi)^k \cdot k! }
                    \\underset{\sigma}{\sum}
                    sgn(\sigma)
                    \\cdot
                    (F_{\nabla})_{\sigma(1)\sigma(2)}
                    \\wedge
                    (F_{\nabla})_{\sigma(3)\sigma(4)}
                    \\wedge
                    \\cdots
                    \\wedge
                    (F_{\nabla})_{\sigma(2k-1)\sigma(2k)}
                    \\,.
            %p
              The first of these is, using the
              %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
              and the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+symbol"} Levi-Civita symbol
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %msup
                          %mi ϵ
                          %mrow
                            %mi a
                            %mi b
                            %mi c
                            %mi d
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mo ∇
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi a
                            %mi b
                        %mo ∧
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mo ∇
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi c
                            %mi d
                      %mrow
                        %mn 32
                        %msup
                          %mi π
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_4(\nabla)
                    \\;=\;
                    \\frac
                    { \epsilon^{ a b c d} (F_{\nabla})_{a b} \wedge (F_\nabla)_{c d}  }
                    {32 \pi^2}
            %p
              (See also, e.g.,
              = succeed ")" do
                %a{:href => "#Nakahara03"} Nakahara 2003, Exp. 11.7
          %h2#examples Examples
          %h3#ChernClassesOfLinearRepresentations Chern classes of linear representations
          %p
            Under the
            %a.existingWikiWord{:href => "/nlab/show/Atiyah-Segal+completion"} Atiyah-Segal completion
            map
            %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
            of a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            induce K-theory classes on the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
            %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
            themselves.
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class+of+a+linear+representation"} characteristic class of a linear representation
            for more.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chern+number"} Chern number
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chern+root"} Chern root
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+class"} Stiefel-Whitney class
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chern+insulator"} Chern insulator
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            field configurations with non-vanishing
            %a.existingWikiWord{:href => "/nlab/show/second+Chern+class"} second Chern class
            (and minimal energy) are called
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/instantons"} instantons
            %em
              %a.existingWikiWord{:href => "/nlab/show/instanton+number"} instanton number
            \. For more on this see at
            = succeed "." do
              %em
                %a{:href => "BPST-instanton#FromTheMathsToThePhysicsStory"} SU(2)-instantons from the correct maths to the traditional physics story
          %h2#references References
          %p Original articles:
          %ul
            %li#Hirzebruch56
              %p
                %a.existingWikiWord{:href => "/nlab/show/Friedrich+Hirzebruch"}> Friedrich Hirzebruch
                , Chapter 1, Section 4 of:
                = succeed "," do
                  %em Neue topologische Methoden in der Algebraischen Geometrie
                = succeed ")" do
                  %a{:href => "https://www.springer.com/de/book/9783662406052"} doi:10.1007/978-3-662-41083-7
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/A.+Grothendieck"}> A. Grothendieck
                ,
                = succeed "," do
                  %em La théorie des classes de Chern
                %strong 86
                (1958), p. 137–154, (
                %a{:href => "http://www.numdam.org/item?id=BSMF_1958__86__137_0"}> numdam:BSMF_1958__86__137_0
                )
          %p Textbook accounts:
          %ul
            %li#KobayashiNomizu63
              %p
                %a.existingWikiWord{:href => "/nlab/show/Shoshichi+Kobayashi"}> Shoshichi Kobayashi
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Katsumi+Nomizu"} Katsumi Nomizu
                = succeed "," do
                  %em Foundations of Differential Geometry, Volume 1
                = succeed "," do
                  %a{:href => "https://www.zuj.edu.jo/download/foundations-of-differential-geometry-vol-1-kobayashi-nomizu-pdf/"} web
                = succeed "," do
                  %a{:href => "https://www.wiley.com/en-us/Foundations+of+Differential+Geometry%2C+Volume+1-p-9780471157335"} ISBN:9780471157335
                = succeed ")" do
                  %a{:href => "https://en.wikipedia.org/wiki/Foundations_of_Differential_Geometry"} Wikipedia
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Werner+Greub"}> Werner Greub
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Stephen+Halperin"} Stephen Halperin
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ray+Vanstone"} Ray Vanstone
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Connections%2C+Curvature%2C+and+Cohomology"} Connections, Curvature, and Cohomology
                Academic Press (1973)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Milnor"}> John Milnor
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} James D. Stasheff
                = succeed "," do
                  %em Characteristic Classes
                = succeed "," do
                  %a{:href => "https://press.princeton.edu/books/paperback/9780691081229/characteristic-classes-am-76-volume-76"} ISBN:9780691081229
                = succeed "," do
                  %a{:href => "https://doi.org/10.1515/9781400881826"} doi:10.1515/9781400881826
                = succeed ")" do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/milnstas.pdf"} pdf
            %li#BottTu82
              %p
                %a.existingWikiWord{:href => "/nlab/show/Raoul+Bott"}> Raoul Bott
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Loring+Tu"} Loring Tu
                = succeed "," do
