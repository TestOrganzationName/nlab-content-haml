          %p
            See also at
            = succeed "." do
              %em
                %a{:href => "splitting+principle#ComplexVectorBundleAndTheirChernRoots"} splitting principle – Examples – Complex vector bundles and their Chern roots
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#Kochman96"} Kochman 96, theorem 2.3.2
            = succeed ")" do
              %a{:href => "#tomDieck08"} tom Dieck 08, theorem 19.3.2
          #FromBUnTOBU1nPullbackInCohomologyIsInjective.num_lemma
            %h6#lemma Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi ι
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B \iota_n \;\colon\; B (U(1)^n) \longrightarrow B U(n)
              be the canonical map. Then the induced pullback operation on
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi B
                      %msub
                        %mi ι
                        %mi n
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ;
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    B \iota_n
                    \\right)
                    \\;\colon\;
                    H^\bullet( B U(n); \mathbb{Z} )
                    \\longrightarrow
                    H^\bullet( B U(1)^n; \mathbb{Z} )
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/proof"} proof
            of lemma
            = succeed "," do
              %a.maruku-ref{:href => "#FromBUnTOBU1nPullbackInCohomologyIsInjective"}
            %a.existingWikiWord{:href => "/nlab/show/Serre+spectral+sequence"} Serre spectral sequence
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo →
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo →
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(n)/U(1)^n \to B U(1)^n \to B U(n)
            is indicated in (
            %a{:href => "#Kochman96"}> Kochman 96, p. 40
            ). A proof via
            %a.existingWikiWord{:href => "/nlab/show/Becker-Gottlieb+transfer"} transfer
            of the
            %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} U(n)/U(1)^n
            = succeed ")," do
              %a{:href => "#Dupont78"} Dupont 78, (8.28)
            %em
              %a.existingWikiWord{:href => "/nlab/show/splitting+principle"} splitting principle
            (
            %a{:href => "splitting+principle#InjectivityOfPullbackInCohomologyToBT"}> here
            ).
          #SplittingPrincipleForChernClasses.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \leq n \in \mathbb{N}
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi ι
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B \iota_n \;\colon\; B (U(1)^n) \longrightarrow B U(n)
              be the canonical map. Then the induced pullback operation on
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi i
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi c
                      %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    (B i_n)^\ast
                    \\;\colon\;
                    \\mathbb{Z}[c_1, \cdots, c_k]
                    \\longrightarrow
                    \\mathbb{Z}[(c_1)_1,\cdots (c_1)_n]
            %p
              and sends the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi k
                  %annotation{:encoding => "application/x-tex"} c_k
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GeneratorsOfCohomologyOfBunChernClasses"}
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/elementary+symmetric+polynomial"} elementary symmetric polynomial
              in the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              copies of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi i
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi c
                      %mi k
                    %mo ↦
                    %msub
                      %mi σ
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (B i_n)^\ast
                    \\;\colon\;
                    c_k \mapsto \sigma_k( (c_1)_1, \cdots, (c_1)_n )
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              First consider the case
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n = 1
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(1)
              is equivalently the infinite
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              is the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              on a single generator
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} c_1
              %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
              (
              %a{:href => "complex+projective+space#OrdinaryCohomologyOfComplexProjectiveSpace"}> prop.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(B U(1))
                    \\simeq
                    \\mathbb{Z}[ c_1 ]
                    \\,.
            %p
              Moreover,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi i
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} B i_1
              is the identity and the statement follows.
            %p
              Now by the
              %a.existingWikiWord{:href => "/nlab/show/K%C3%BCnneth+theorem"} Künneth theorem
              for ordinary cohomology (
              %a{:href => "K%C3%BCnneth+theorem#KunnethInOrdinaryCohomology"}> prop.
              ) the cohomology of the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              copies of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(1)
              is the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              generators
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(B U(1)^n)
                    \\simeq
                    \\mathbb{Z}[(c_1)_1, \cdots, (c_1)_n]
                    \\,.
            %p
              By prop.
              %a.maruku-ref{:href => "#GeneratorsOfCohomologyOfBunChernClasses"}
              the domain of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi i
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (B i_n)^\ast
              is the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              in the Chern classes
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi c
                        %mi i
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{c_i\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              copies of the first Chern class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi i
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi c
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (B i_n)^\ast
                    \\;\colon\;
                    \\mathbb{Z}[ c_1, \cdots, c_n ]
                    \\longrightarrow
                    \\mathbb{Z}[ (c_1)_1, \cdots, (c_1)_n ]
                    \\,.
            %p
              This allows to compute
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi i
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (B i_n)^\ast(c_k)
              by
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
            %p
              Consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
              and assume that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %msub
                        %mi i
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi σ
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (B i_{n-1})^\ast_{n-1}(c_k) = \sigma_k((c_1)_1, \cdots, (c_1)_{(n-1)})
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %msub
                        %mi i
                        %mi n
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi σ
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (B i_n)^\ast(c_k) = \sigma_k((c_1)_1,\cdots, (c_1)_n)
            %p
              Consider then the
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi B
                                %msub
                                  %mi i
                                  %mrow
                                    %mi n
                                    %mo −
                                    %mn 1
                          %mtd
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi B
                                  %msub
                                    %mi j
                                    %mover
                                      %mi t
                                      %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi B
                                  %msub
                                    %mi i
                                    %mover
                                      %mi t
                                      %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi n
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi B
                                %msub
                                  %mi i
                                  %mi n
                          %mtd
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    B U(1)^{n-1}
                    \&amp;\overset{ B i_{n-1} }{\longrightarrow}&amp;
                    B U(n-1)
                    \\\
                    {}^{\mathllap{B j_{\hat t}}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{B i_{\hat t}}}
                    \\\
                    B U(1)^n
                    \&amp;\underset{B i_n}{\longrightarrow}&amp;
                    B U(n)
                    }
            %p where both vertical morphisms are induced from the inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ↪
                    %msup
                      %mi ℂ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C}^{n-1} \hookrightarrow \mathbb{C}^n
            %p
              which omits the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
            %p
              Since two embeddings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mover
                            %mi t
                            %mo{:stretchy => "false"} ^
                          %mn 1
                    %mo ,
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mover
                            %mi t
                            %mo{:stretchy => "false"} ^
                          %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i_{\hat t_1}, i_{\hat t_2} \colon U(n-1) \hookrightarrow U(n)
              differ by
              %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
              with an element in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(n)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/inner+automorphism"} inner automorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mover
                            %mi t
                            %mo{:stretchy => "false"} ^
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} B i_{\hat t_1}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mrow
                        %msub
                          %mover
                            %mi i
                            %mo{:stretchy => "false"} ^
                          %mrow
                            %msub
                              %mi t
                              %mn 2
                  %annotation{:encoding => "application/x-tex"} B_{\hat i_{t_2}}
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopic
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %msub
                        %mi i
                        %mover
                          %mi t
                          %mo{:stretchy => "false"} ^
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi B
                      %msub
                        %mi i
                        %mover
                          %mi n
                          %mo{:stretchy => "false"} ^
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} (B i_{\hat t})^\ast = (B i_{\hat n})^\ast
              = succeed "." do
                %a.maruku-ref{:href => "#GeneratorsOfCohomologyOfBunChernClasses"}
            %p
              By that proposition,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi i
                      %mover
                        %mi t
                        %mo{:stretchy => "false"} ^
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (B i_{\hat t})^\ast
              is the identity on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mrow
                        %mi k
                        %mo &lt;
                        %mi n
                  %annotation{:encoding => "application/x-tex"} c_{k \lt n}
              and hence by induction assumption
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi B
                            %msub
                              %mi i
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi B
                            %msub
                              %mi i
                              %mover
                                %mi t
                                %mo{:stretchy => "false"} ^
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %msub
                              %mi c
                              %mrow
                                %mi k
                                %mo &lt;
                                %mi n
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi B
                            %msub
                              %mi i
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %msub
                              %mi c
                              %mrow
                                %mi k
                                %mo &lt;
                                %mi n
                        %mtr
                          %mtd
                            %mo =
                            %msub
                              %mi σ
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mover
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi c
                                  %mn 1
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi t
                              %mo ^
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi n
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (B i_{n-1})^\ast (B i_{\hat t})^\ast c_{k \lt n}
                    \&amp;=
                    (B i_{n-1})^\ast c_{k \lt n}
                    \\\
                    \=
                    \\sigma_k( (c_1)_1, \cdots, \widehat{(c_1)_t}, \cdots, (c_1)_n )
                    \\end{aligned}
                    \\,.
            %p
              Since pullback along the left vertical morphism sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi t
                  %annotation{:encoding => "application/x-tex"} (c_1)_t
              to zero and is the identity on the other generators, this shows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi i
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mrow
                        %mi k
                        %mo &lt;
                        %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi σ
                      %mrow
                        %mi k
                        %mo &lt;
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi t
                      %mo ^
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi t
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (B i_n)^\ast(c_{k \lt n})
                    \\simeq
                    \\sigma_{k\lt n}((c_1)_1, \cdots, \widehat{(c_1)_t}, \cdots, (c_1)_n)
                    \\;\;
                    mod (c_1)_t
                    \\,.
            %p
              This implies the claim for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo &lt;
                      %mi n
                    %annotation{:encoding => "application/x-tex"} k \lt n
            %p
              For the case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k = n
              the commutativity of the diagram and the fact that the right map is zero on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi n
                  %annotation{:encoding => "application/x-tex"} c_n
              by prop.
              %a.maruku-ref{:href => "#GeneratorsOfCohomologyOfBunChernClasses"}
              shows that the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi j
                      %mover
                        %mi t
                        %mo{:stretchy => "false"} ^
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi i
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %msub
                      %mi c
                      %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} (B j_{\hat t})^\ast (B i_n)^\ast c_n = 0
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ≤
                      %mi t
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 1 \leq t \leq n
              %a.maruku-ref{:href => "#FromBUnTOBU1nPullbackInCohomologyIsInjective"}
              the morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %msub
                        %mi i
                        %mi n
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} (B i_n)^\ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi i
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (B i_n)^\ast(c_n)
              is non-zero. Therefore for this to be annihilated by the morphisms that send
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi t
                  %annotation{:encoding => "application/x-tex"} (c_1)_t
              to zero, for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi t
                    %annotation{:encoding => "application/x-tex"} (c_1)_t
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi B
                            %msub
                              %mi i
                              %mi n
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mn 1
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mn 2
                            %mo ⊗
                            %mi ⋯
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi σ
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi n
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (B i_n)^{\ast}(c_n)
                    \&amp; = (c_1)_1 \otimes (c_1)_2 \otimes \cdots \otimes (c_1)_n
                    \\\
                    \&amp; = \sigma_n( (c_1)_1, \cdots, (c_1)_n )
                    \\end{aligned}
                    \\,.
            %p This completes the induction step.
          %h3#WhitneySumFormula Whitney sum formula
          #WhitneySumChernClasses.num_prop
            %h6#proposition_3 Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≤
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k\leq n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %mi k
                        %mo ,
                        %mi n
                        %mo −
                        %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_{k,n-k}
                    \\;\colon\;
                    B U(k) \times B U(n-k)
                    \\longrightarrow
                    B U(n)
            %p
              (which classifies the
              %a.existingWikiWord{:href => "/nlab/show/Whitney+sum"} Whitney sum
              of
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundles"} complex vector bundles
              of
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              with those of rank
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                    %annotation{:encoding => "application/x-tex"} n-k
              %a.existingWikiWord{:href => "/nlab/show/Chern+classes"} Chern classes
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#GeneratorsOfCohomologyOfBunChernClasses"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi μ
                      %mrow
                        %mi k
                        %mo ,
                        %mi n
                        %mo −
                        %mi k
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi t
                    %msub
                      %mi c
                      %mi i
                    %mo ⊗
                    %msub
                      %mi c
                      %mrow
                        %mi t
                        %mo −
                        %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (\mu_{k,n-k})^\ast(c_t)
                    \\;=\;
                    \\underoverset{i = 0}{t}{\sum} c_i \otimes c_{t-i}
                    \\,,
            %p
              where we take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 0
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} c_0 = 1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi j
                    %mo =
                    %mn 0
                    %mo ∈
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c_j = 0 \in H^\bullet(B U(r))
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo &gt;
                      %mi r
                    %annotation{:encoding => "application/x-tex"} j \gt r
            %p So in particular
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi μ
                      %mrow
                        %mi k
                        %mo ,
                        %mi n
                        %mo −
                        %mi k
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi c
                      %mi k
                    %mo ⊗
                    %msub
                      %mi c
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mu_{k,n-k})^\ast(c_n) \;=\; c_k \otimes c_{n-k}
                    \\,.
          %p
            e.g. (
            %a{:href => "#Kochman96"}> Kochman 96, corollary 2.3.4
            )
          .proof
            %h6#proof_3 Proof
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi μ
                                  %mrow
                                    %mi k
                                    %mo ,
                                    %mi n
                                    %mo −
                                    %mi k
                                  %mo *
                          %mtd
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo −
                            %mi k
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msubsup
                                    %mi μ
                                    %mi k
                                    %mo *
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi μ
                                    %mi k
                                    %mo *
                                  %mo ⊗
                                  %msubsup
                                    %mi μ
                                    %mrow
                                      %mi n
                                      %mo −
                                      %mi k
                                    %mo *
                        %mtr
                          %mtd
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                          %mtd
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi k
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi n
                                %mo −
                                %mi k
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    H^\bullet( B U(n) )
                    \&amp;\overset{\mu_{k,n-k}^\ast}{\longrightarrow}&amp;
                    H^\bullet( B U(k) ) \otimes H^\bullet( B U(n-k) )
                    \\\
                    {}^{\mathllap{\mu_k^\ast}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{ \mu_{k}^\ast \otimes \mu_{n-k}^\ast }}
                    \\\
                    H^\bullet( B U(1)^n )
                    \&amp;\simeq&amp;
                    H^\bullet( B U(1)^k ) \otimes H^\bullet( B U(1)^{n-k} )
                    }
                    \\,.
            %p
              This says that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi μ
                              %mi k
                              %mo *
                            %mo ⊗
                            %msubsup
                              %mi μ
                              %mrow
                                %mi n
                                %mo −
                                %mi k
                              %mo *
                            %mo{:stretchy => "false"} )
                            %msubsup
                              %mi μ
                              %mrow
                                %mi k
                                %mo ,
                                %mi n
                                %mo −
                                %mi k
                              %mo *
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mi t
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msubsup
                              %mi μ
                              %mi n
                              %mo *
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mi t
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi σ
                              %mi t
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi n
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (\mu_k^\ast \otimes \mu_{n-k}^\ast) \mu_{k,n-k}^\ast(c_t)
                    \&amp; =
                    \\mu^\ast_n(c_t)
                    \\\
                    \&amp; = \sigma_t((c_1)_1, \cdots, (c_1)_n)
                    \\end{aligned}
                    \\,,
            %p
              where the last equation is by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SplittingPrincipleForChernClasses"}
            %p
              Now the
              %a.existingWikiWord{:href => "/nlab/show/elementary+symmetric+polynomial"} elementary symmetric polynomial
              on the right decomposes as required by the left hand side of this equation as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi t
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi r
                        %mo =
                        %mn 0
                      %mi t
                    %msub
                      %mi σ
                      %mi r
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msub
                      %mi σ
                      %mrow
                        %mi t
                        %mo −
                        %mi r
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                        %mo +
                        %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_t((c_1)_1, \cdots, (c_1)_n)
                    \\;=\;
                    \\underoverset{r = 0}{t}{\sum}
                    \\sigma_r((c_1)_1, \cdots, (c_1)_{n-k})
                    \\cdot
                    \\sigma_{t-r}( (c_1)_{n-k+1}, \cdots, (c_1)_n )
                    \\,,
            %p
              where we agree with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
