            %li#Kochman96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochman"}> Stanley Kochman
                , section 2.3 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
            %li#tomDieck08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
                ,
                = succeed "," do
                  %em Algebraic topology
          %p
            With an eye towards
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/mathematical+physics"} mathematical physics
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mikio+Nakahara"}> Mikio Nakahara
                , Section 11.3 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Geometry%2C+Topology+and+Physics"} Geometry, Topology and Physics
                = succeed "," do
