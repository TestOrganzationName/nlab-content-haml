                = succeed ")" do
                  %a{:href => "http://alpha.sinp.msu.ru/~panov/LibBooks/GRAV/(Graduate_Student_Series_in_Physics)Mikio_Nakahara-Geometry,_Topology_and_Physics,_Second_Edition_(Graduate_Student_Series_in_Physics)-Institute_of_Physics_Publishing(2003).pdf"} pdf
            %li#RudolphSchmidt
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gerd+Rudolph"}> Gerd Rudolph
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Matthias+Schmidt"} Matthias Schmidt
                = succeed "," do
                  %em Differential Geometry and Mathematical Physics: Part II. Fibre Bundles, Topology and Gauge Fields
                = succeed ")" do
                  %a{:href => "https://link.springer.com/book/10.1007/978-94-024-0959-8"} doi:10.1007/978-94-024-0959-8
          %p A brief introduction is in chapter 23, section 7
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
              ,
              %em A concise course in algebraic topology
              (
              %a{:href => "http://www.math.uchicago.edu/~may/CONCISE/ConciseRevised.pdf"}> pdf
              )
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/Conner-Floyd+Chern+classes"} Conner-Floyd Chern classes
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
          %ul
            %li#Adams74
              %p
                %a.existingWikiWord{:href => "/nlab/show/Frank+Adams"}> Frank Adams
                , part II.2 and part III.10 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Stable+homotopy+and+generalised+homology"} Stable homotopy and generalised homology
            %li#Lurie10
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Chromatic+Homotopy+Theory"} Chromatic Homotopy Theory
                = succeed ")" do
                  %a{:href => "http://www.math.harvard.edu/~lurie/252xnotes/Lecture4.pdf"} pdf
                = succeed ")" do
                  %a{:href => "http://www.math.harvard.edu/~lurie/252xnotes/Lecture5.pdf"} pdf
          %p See also
          %ul
            %li#Dupont78
              %p
                Dupont,
                = succeed "," do
                  %em Curvature and characteristic classes
            %li
              %p
                Timothy Hosgood,
                = succeed "." do
                  %em Chern classes of coherent analytic sheaves: a simplicial approach
                = succeed "." do
