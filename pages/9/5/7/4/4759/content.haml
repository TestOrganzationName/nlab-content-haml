            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+principal+bundle"} connection
              on a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
