                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} (\eta (t v), \eta (u)) \in V
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_111.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo ×
                    %mi η
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mi X
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} (\pi \times \eta ) \colon T X \to V
              is a diffeomorphism, we can apply the inverse of this to that path, resulting in:
            .maruku-equation
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_112.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo ×
                    %mi η
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi T
                      %mrow
                        %mi η
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mi v
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\pi \times \eta )^{-1} (\eta (t v), \eta (u)) \in T_{\eta (t v)} X.
            %p
              This is a tangent vector moving along the curve
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_113.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta (t v)
              starting at
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_114.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              above
              = succeed "." do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_115.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            .maruku-equation
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_116.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi T
                    %mi X
                    %mo ,
                    %mspace{:width => "1em"}
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi s
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo ×
                    %mi η
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R} \times (-\epsilon ,\epsilon ) \to T X, \quad (s,t) \mapsto s \cdot (\pi \times \eta )^{-1} (\eta (t v), \eta (u)).
            %p
              The final step is to map this back down to
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_117.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              via
              = succeed ":" do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_118.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
            .maruku-equation
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_119.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo ×
                    %mi η
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (s,t) \mapsto \eta (s \cdot (\pi \times \eta )^{-1} (\eta (t v), \eta (u))).
            %p
              Let us write this as
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_120.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℝ
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \tau \colon \mathbb{R} \times (-\epsilon ,\epsilon ) \to X
              for short. We note that it is smooth, as it is a composition of smooth maps.
            %p
              It may aid the comprehension of this map if we describe it in the case of
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_121.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R} ^{2}
              with
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_122.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo =
                    %msub
                      %mo ∂
                      %mi x
                  %annotation{:encoding => "application/x-tex"} u = \partial _{x}
              and
              = succeed "." do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_123.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo =
                      %msub
                        %mo ∂
                        %mi y
                    %annotation{:encoding => "application/x-tex"} v = \partial _{y}
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_124.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
              is the map
              = succeed "." do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_125.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo −
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mi t
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (s,(1 - s)t)
            .maruku-equation
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_126.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mn 0
                        %mo{:stretchy => "false"} )
                    %mi τ
                    %mo =
                    %msub
                      %mrow
                        %mrow
                          %mo [
                          %mrow
                            %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                              %mtr
                                %mtd
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo −
                                  %mi s
                                  %mo{:stretchy => "false"} )
                                %mtd
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi t
                              %mtr
                                %mtd
                                  %mn 0
                                %mtd
                                  %mn 1
                          %mo ]
                        %mo |
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mn 0
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo [
                      %mrow
                        %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                      %mo ]
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    D_{(0,0)} \tau   = \left . \begin{bmatrix}   (1 - s) &amp; -t \\   0 &amp; 1 \end{bmatrix} \right |_{(0,0)} = \begin{bmatrix}   1 &amp; 0 \\   0 &amp; 1 \end{bmatrix}.
            %p
              At
              = succeed "," do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_127.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} s = 0
            .maruku-equation
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_128.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ↦
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo ×
                    %mi η
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    t \mapsto \eta   (0 \cdot (\pi \times \eta )^{-1} (\eta (t v), \eta (u))).
            %p
              Under
              = succeed "," do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_129.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_130.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              of the vector. Thus the path is
              = succeed "." do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_131.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ↦
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t \mapsto \eta (t v)
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_132.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi t
                  %annotation{:encoding => "application/x-tex"} \partial _{t}
              is
              = succeed "." do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_133.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
            %p
              At
              = succeed "," do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_134.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} t = 0
            .maruku-equation
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_135.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ↦
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo ×
                    %mi η
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    s \mapsto \eta (s \cdot (\pi \times \eta )^{-1}(x, \eta (u)))
            %p
              since
              = succeed "." do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_136.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \eta (0 v) = x
              = succeed "." do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_137.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ↦
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mi u
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} s \mapsto \eta (s u)
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_138.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi s
                  %annotation{:encoding => "application/x-tex"} \partial _{s}
              is
              = succeed "." do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_139.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
            %p
              Then the claim is that the image of
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_140.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi s
                    %mo +
                    %msub
                      %mo ∂
                      %mi t
                  %annotation{:encoding => "application/x-tex"} \partial _{s} + \partial _{t}
              will do for
              = succeed "." do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_141.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo +
                      %mi v
                    %annotation{:encoding => "application/x-tex"} u + v
              = succeed "." do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_142.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} f \colon X \to \mathbb{R}
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_143.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} f \circ \tau
              is smooth, and so we have that:
            .maruku-equation
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_144.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi s
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi s
                    %mo +
                    %msub
                      %mo ∂
                      %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi τ
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi s
                    %mo +
                    %msub
                      %mo ∂
                      %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f(u) + f(v) = (f \circ \tau )(\partial _{s}) + (f \circ \tau )(\partial _{t}) = (f \circ \tau )(\partial _{s} + \partial _{t}) = f(\tau _{*}(\partial _{s} + \partial _{t})).
            %p
              Hence
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_145.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi s
                    %mo +
                    %msub
                      %mo ∂
                      %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau _{*}(\partial _{s} + \partial _{t})
              is the sum
              = succeed "." do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_146.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo +
                      %mi v
                    %annotation{:encoding => "application/x-tex"} u + v
          %p Thus a locally additive space is modelled on vector spaces. This is not quite as strong as saying that it is a smooth manifold (even ignoring paracompactness and Hausdorff) since we do not know that the smooth structure on a tangent space is “the” smooth structure on a vector space.
          #sectione.num_section
          %h2#related_concepts.num_section Related Concepts
          %p
            A similar concept to this was devised and studied by Kriegl and Michor in
            = succeed "," do
              %a{:href => "#citeMR764972"} Mic84a
            = succeed "." do
              %a{:href => "#citeMR767683"} Mic84b
          %p
            Another concept that should be kept in mind with regard to the above is that of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+microbundle"} tangent microbundle
            of a topological manifold. This is an equivalence class of neighbourhoods of the diagonal. Thus one can say that a locally additive space is one for which the topological and smooth tangent bundles agree.
