                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_108.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_109.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-\epsilon ,\epsilon )
              for which
              = succeed "." do
                %math#mathml_70627b1c91cd3978f289ce8c4c1d29a936031e46_110.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mi v
                      %mo{:stretchy => "false"} )
