            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mtable{:columnalign => "center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi A
                      %mtr
                        %mtd
                          %mi B
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo →
                      %mi 𝟚
                  %mrow
                    %mo [
                    %mi B
                    %mo ≃
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi a
                          %mo{:lspace => "verythinmathspace"} :
                          %mi A
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi 𝟚
                      %mn 1
                      %mo )
                    %mo ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\begin{array}{c}
                  A
                  \\\
                  B
                  \\end{array}
                  \\right)
                  \\;\coloneqq\;
                  \\sum_{
                  f \colon
                  A \to \mathbb{2}
                  }
                  \\left[
                  B \simeq
                  \\left(
                  \\sum_{a \colon A}
                  f(a)
                  \=_\mathbb{2}
                  1
                  \\right)
                  \\right]
                  \\,,
          %p where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \sum_{(-)} (-)
                denotes the
                = succeed "-formation;" do
                  %a.existingWikiWord{:href => "/nlab/show/dependent+pair+type"} dependent pair type
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-)\to(-)
                denotes
                = succeed "-formation;" do
                  %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝟚
                    %annotation{:encoding => "application/x-tex"} \mathbb{2}
                denotes the finite type with two elements “
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
                ” and “
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
                ”;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi 𝟚
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-) =_\mathbb{2} (-)
                denotes its
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/identification+type"} identification type
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [-]
                denotes
                %a.existingWikiWord{:href => "/nlab/show/propositional+truncation"} propositional truncation
                (
                %a.existingWikiWord{:href => "/nlab/show/bracket+types"}> bracket types
                ).
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≃
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \simeq B
            is defined as the
            %a.existingWikiWord{:href => "/nlab/show/dependent+pair+type"} dependent pair type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi f
                        %mo :
                        %mi A
                        %mo →
                        %mi B
                    %mi{:mathvariant => "normal"} isEquiv
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{f:A \to B} \mathrm{isEquiv}(f)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mtable{:columnalign => "center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi A
                      %mtr
                        %mtd
                          %mi B
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo →
                      %mi 𝟚
                  %mo ∃
                  %mi g
                  %mo :
                  %mi B
                  %mo →
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi a
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi 𝟚
                    %mn 1
                    %mo )
                  %mo .
                  %mi{:mathvariant => "normal"} isEquiv
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\begin{array}{c}
                  A
                  \\\
                  B
                  \\end{array}
                  \\right)
                  \\;\coloneqq\;
                  \\sum_{
                  f \colon
                  A \to \mathbb{2}
                  }
                  \\exists g:B \to \left(
                  \\sum_{a \colon A}
                  f(a)
                  \=_\mathbb{2}
                  1
                  \\right).\mathrm{isEquiv}(g)
                  \\,,
          %p
            where given a type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
            the
            %a.existingWikiWord{:href => "/nlab/show/existential+quantifier"} existential quantifier
            is defined as the propositional truncation of the dependent pair type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mrow
                    %mo [
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ]
                %annotation{:encoding => "application/x-tex"} \exists x:A.B(x) \coloneqq \left[\sum_{x:A} B(x)\right]
          %p
            This definition can be translated directly into
            %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            notation as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mtable{:columnalign => "center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi A
                      %mtr
                        %mtd
                          %mi B
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo ∈
                  %msup
                    %mi 𝟚
                    %mi A
                  %mo{:stretchy => "false"} |
                  %mo ∃
                  %mi g
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo ∈
                  %mi A
                  %mo{:stretchy => "false"} |
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi 𝟚
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} }
                    %mi B
                  %mo .
                  %mi{:mathvariant => "normal"} isBijection
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\begin{array}{c}
                  A
                  \\\
                  B
                  \\end{array}
                  \\right)
                  \\;\coloneqq\;
                  \\{f \in \mathbb{2}^A \vert \exists g \in \{a \in A \vert f(a) =_\mathbb{2} 1\}^B.\mathrm{isBijection}(g)\}
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mi A
                %annotation{:encoding => "application/x-tex"} B^A
            is the
            %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
            with
            %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝟚
                %annotation{:encoding => "application/x-tex"} \mathbb{2}
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isBijection
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isBijection}(f)
            on the function set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msup
                    %mi B
                    %mi A
                %annotation{:encoding => "application/x-tex"} f \in B^A
            is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isBijection
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo ∀
                  %mi y
                  %mo ∈
                  %mi B
                  %mo .
                  %mo ∃
                  %mo !
                  %mi x
                  %mo ∈
                  %mi A
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi y
                %annotation{:encoding => "application/x-tex"} \mathrm{isBijection}(f) \coloneqq \forall y \in B.\exists!x \in A.f(x) = y
          %p
            This results in
            = succeed "." do
              %strong binomial sets
          %h3#locally_small_binomial_types Locally small binomial types
          %p
            There is an alternative way to express the second definition, by use of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/univalent+universe"} univalent universe
          %p We define the type of decidable embeddings as the type of functions whose fibers are decidable:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo ↪
                    %mi d
                  %mi B
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi b
                      %mo :
                      %mi B
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi a
                        %mo :
                        %mi A
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi B
                    %mi b
                    %mo )
                  %mo ∨
                  %mo ¬
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi a
                        %mo :
                        %mi A
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi B
                    %mi b
                    %mo )
                %annotation{:encoding => "application/x-tex"} A \hookrightarrow_d B \coloneqq \sum_{f:A \to B} \prod_{b:B} \left(\sum_{a:A} f(a) =_B b\right) \vee \neg \left(\sum_{a:A} f(a) =_B b\right)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U, \mathrm{El})
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/univalent+Tarski+universe"} univalent Tarski universe
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi A
                %annotation{:encoding => "application/x-tex"} U_A
            to be the type of all types in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            which are merely equivalent to
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi A
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi X
                      %mo :
                      %mi U
                  %mrow
                    %mo [
                    %mi A
                    %mo ≃
                    %mi{:mathvariant => "normal"} El
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ]
                %annotation{:encoding => "application/x-tex"} U_A \coloneqq \sum_{X:U} \left[A \simeq \mathrm{El}(X)\right]
          %p
            Then given
            %a.existingWikiWord{:href => "/nlab/show/essentially+small+type"}
              essentially
              = succeed "-small" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %mi B
                      %mo )
                    %mi U
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi X
                      %mo :
                      %msub
                        %mi U
                        %mi B
                  %mrow
                    %mo [
                    %mi{:mathvariant => "normal"} El
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ↪
                      %mi d
                    %mi A
                    %mo ]
                %annotation{:encoding => "application/x-tex"} \left(\begin{array}{c}A \\ B\end{array}\right)_U \coloneqq \sum_{X:U_B} \left[\mathrm{El}(X) \hookrightarrow_d A\right]
          %p
            One could also translate the above definition into
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/universe"} universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+sets"} small sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi A
                %annotation{:encoding => "application/x-tex"} U_A
            is defined to be the set of all small sets in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            which are in bijection with
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi A
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi X
                  %mo ∈
                  %mi U
                  %mo{:stretchy => "false"} |
                  %mo ∃
                  %mi i
                  %mo ∈
                  %msup
                    %mi X
                    %mi A
                  %mo .
                  %mo ∀
                  %mi x
                  %mo ∈
                  %mi X
                  %mo .
                  %mo ∃
                  %mo !
                  %mi a
                  %mo ∈
                  %mi A
                  %mo .
                  %mi a
                  %mo ∈
                  %msup
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
