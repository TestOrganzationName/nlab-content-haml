                    2 Cong_s(K) \hookrightarrow HDC(K)
                    \\,.
          #InclusionOfKernelsInCongruences.num_prop
            %h6#proposition Proposition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
