                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 2Cong_s(K)
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+sub-2-category"} full sub-2-category
              of that of hom-wise discrete internal categories, def.
              %a.maruku-ref{:href => "#HomWiseDiscreteInternalCategory"}
              on the 2-congruences, def.
              %a.maruku-ref{:href => "#2Congruence"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %msub
                      %mi Cong
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi HDC
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
