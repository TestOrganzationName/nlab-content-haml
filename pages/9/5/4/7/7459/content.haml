                    %mi Cong
                    %mi s
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 2 Cong_s(K)
            of 2-congruences, def.
