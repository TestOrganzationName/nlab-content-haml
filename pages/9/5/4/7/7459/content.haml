                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is an
              = succeed "-congruence." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is
              = succeed "-exact," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              has a quotient
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo :
                      %msub
                        %mi D
                        %mn 0
                      %mo →
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} q:D_0\to Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is the kernel of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo →
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D \to ker(Q)
              which is a weak equivalence. Thus, we can regard it either as an anafunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo →
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D\to ker(Q)
              or
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi D
                    %annotation{:encoding => "application/x-tex"} ker(Q)\to D
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mi Cong
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} n Cong(K)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              is essentially surjective, and hence an equivalence.
          %p Note that by working in the generality of 2-sites, this construction includes the previous one.
          .num_remark
            %h6#remark_8 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a finitely complete 2-category equipped with its minimal coverage, in which the covering families are those that contain a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/split+epimorphism"} split epimorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mi Cong
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi n
                    %msub
                      %mi Cong
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    n Cong(K) \simeq n Cong_s(K)
                    \\,.
          .proof
            %h6#proof_8 Proof
            %p
              This is immediate from the proof of Theorem
              = succeed "," do
                %a.maruku-ref{:href => "#regex"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %msub
                        %mi Cong
                        %mi s
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} n Cong_s(K)
          #nCongOnGroupoidsAndDiscretes.num_theorem
            %h6#theorem_6 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a 2-exact 2-category with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/core+in+a+2-category"} enough groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ≃
                    %mn 2
                    %mi Cong
                    %mo{:stretchy => "false"} (
                    %mi gpd
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    K\simeq 2 Cong(gpd(K))
                    \\,.
            %p
              Likewise, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is 2-exact and has enough discretes, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ≃
                    %mn 2
                    %mi Cong
                    %mo{:stretchy => "false"} (
                    %mi disc
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    K\simeq 2 Cong(disc(K))
                    \\,.
          .proof
            %h6#proof_9 Proof
            %p
              Define a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo →
                    %mn 2
                    %mi Cong
                    %mo{:stretchy => "false"} (
                    %mi gpd
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K\to 2Cong(gpd(K))
              by taking each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to the kernel of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %mi J
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} j:J\to A
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is eso and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              is groupoidal (for example, it might be the
              %a.existingWikiWord{:href => "/nlab/show/core"} core
              of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi Cong
                    %mo{:stretchy => "false"} (
                    %mi gpd
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 2Cong(gpd(K))
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} /
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi J
                    %mo ×
                    %mi J
                  %annotation{:encoding => "application/x-tex"} (j/j)\to J\times J
              is discrete, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} /
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (j/j)
              is also groupoidal. The same argument as in Theorem
              %a.maruku-ref{:href => "#nCongExidempotent"}
              shows that this functor is 2-fully-faithful for any regular 2-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              with enough groupoids, and essentially-surjective when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is 2-exact; thus it is an equivalence. The same argument works for discrete objects.
          %p In particular, the 2-exact 2-categories having enough discretes are precisely the 2-categories of internal categories and anafunctors in 1-exact 1-categories.
          %p
            Our final goal is to construct the
            = succeed "-exact" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          #almostExreg.num_theorem
            %h6#theorem_7 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a regular
              = succeed "-category," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mi Cong
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} n Cong(K)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %mi K
                    %mo →
                    %mi n
                    %mi Cong
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi:K\to n Cong(K)
              is regular, and moreover for any
              = succeed "-exact" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              it induces an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Reg
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mi Cong
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Reg
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} Reg(n Cong(K), L) \to Reg(K,L).
          .proof
            %h6#proof_10 Proof
            %p
              We already know that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mi Cong
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} n Cong(K)
              has finite limits and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              preserves finite limits. The rest is very similar to Theorem
              = succeed "." do
                %a.maruku-ref{:href => "#regex"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ←
                    %mi F
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \leftarrow F \to B
              is an equivalence as soon as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} F\to B
              is also a weak equivalence (its reverse span
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ←
                    %mi F
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} B\leftarrow F \to A
              then provides an inverse.) Also,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ←
                    %mi F
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \leftarrow F \to B
              is ff if and only if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi F
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi B
                              %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi F
                              %mn 0
                            %mo ×
                            %msub
                              %mi F
                              %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi B
                              %mn 0
                            %mo ×
                            %msub
                              %mi B
                              %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\array{F_1 &amp; \to &amp; B_1\\ \downarrow &amp;&amp; \downarrow \\
                    F_0\times F_0 &amp; \to &amp; B_0\times B_0}
            %p is a pullback.
            %p
              Now we claim that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ←
                    %mi F
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A\leftarrow F \to B
              is an anafunctor such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 0
                    %mo →
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} F_0\to B_0
              is eso, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is eso. For if we have a composition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi F
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi G
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi M
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi C
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ &amp;&amp;&amp;&amp; F \\
                    \&amp;&amp;&amp; \swarrow &amp;&amp; \searrow\\
                    \&amp;&amp; G &amp;&amp;&amp;&amp; M\\
                    \&amp; \swarrow &amp;&amp; \searrow &amp;&amp; \swarrow &amp;&amp; \searrow\\
                    A &amp;&amp;&amp;&amp; C &amp;&amp;&amp;&amp; B}
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is ff, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 0
                    %mo →
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} F_0\to B_0
              being eso implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 0
                    %mo →
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} M_0\to B_0
              is also eso; thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} M\to B
              is a weak equivalence and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is an equivalence. Moreover, by the construction of pullbacks in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mi Cong
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} n Cong(K)
            %p
              Now suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ←
                    %mi F
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \leftarrow F \to B
              is any anafunctor, and define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 0
                    %mo =
                    %msub
                      %mi F
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} C_0=F_0
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} C_1
              be the pullback of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
