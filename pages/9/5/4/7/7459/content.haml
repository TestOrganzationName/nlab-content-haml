              For any morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A\to B
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi(f)
              is the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(A)\to ker(B)
              that consists of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A\to B
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                      %mo :
                      %msup
                        %mi A
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                      %mo →
                      %msup
                        %mi B
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} f^{\mathbf{2}}: A^{\mathbf{2}} \to B^{\mathbf{2}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi(f)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi(g)
              is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %msup
                      %mi B
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} A\to B ^{\mathbf{2}}
              whose composites
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %msup
                      %mi B
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ⇉
                    %mspace{:width => "thickmathspace"}
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A\to B ^{\mathbf{2}} \;\rightrightarrows\; B
              are
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo →
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f\to g
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              is homwise fully faithful. And homwise essential-surjectivity follows from the essential uniqueness of thin structures, or equivalently a version of Prop 6.4 in [FBMF][].
          %p Moreover, we have:
          #regex.num_theorem
            %h6#theorem_2 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is an
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %msub
                      %mi Cong
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} n Cong_s(K)
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/regular+2-category"} regular
          .proof
            %h6#proof_4 Proof
            %p
              It is easy to see that a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} f:C\to D
              between
              = succeed "-congruences" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %msub
                      %mi Cong
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} n Cong_s(K)
              iff the square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi D
                              %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mn 0
                            %mo ×
                            %msub
                              %mi C
                              %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi D
                              %mn 0
                            %mo ×
                            %msub
                              %mi D
                              %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\array{C_1 &amp; \to &amp; D_1\\ \downarrow &amp;&amp; \downarrow\\
                    C_0\times C_0 &amp; \to &amp; D_0\times D_0}
            %p
              is a pullback in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
            %p
              We claim that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo :
                    %mi E
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} e:E\to D
              is a functor such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn 0
                    %mo :
                    %msub
                      %mi E
                      %mn 0
                    %mo →
                    %msub
                      %mi D
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} e_0:E_0\to D_0
              is split (that is,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn 0
                    %mi s
                    %mo ≅
                    %msub
                      %mn 1
                      %mrow
                        %msub
                          %mi D
                          %mn 0
                  %annotation{:encoding => "application/x-tex"} e_0 s\cong 1_{D_0}
              for some
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo :
                      %msub
                        %mi D
                        %mn 0
                      %mo →
                      %msub
                        %mi E
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} s:D_0\to E_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              is eso in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %msub
                        %mi Cong
                        %mi s
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} n Cong_s(K)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ≅
                    %mi f
                    %mi g
                  %annotation{:encoding => "application/x-tex"} e\cong f g
              for some ff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} f:C\to D
              as above, then we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 0
                    %mi s
                    %mo :
                    %msub
                      %mi D
                      %mn 0
                    %mo →
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} g_0 s:D_0 \to C_0
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 0
                      %msub
                        %mi g
                        %mn 0
                      %mi s
                      %mo ≅
                      %msub
                        %mi e
                        %mn 0
                      %mi s
                      %mo ≅
                      %msub
                        %mn 1
                        %mrow
                          %msub
                            %mi D
                            %mn 0
                    %annotation{:encoding => "application/x-tex"} f_0 g_0 s \cong e_0 s \cong 1_{D_0}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} C_1
              is a pullback induces a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} h:D\to C
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mn 0
                    %mo =
                    %msub
                      %mi g
                      %mn 0
                    %mi s
                  %annotation{:encoding => "application/x-tex"} h_0=g_0 s
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mi h
                      %mo ≅
                      %msub
                        %mn 1
                        %mi D
                    %annotation{:encoding => "application/x-tex"} f h\cong 1_D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an equivalence; thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              is eso.
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn 0
                    %mo :
                    %msub
                      %mi E
                      %mn 0
                    %mo →
                    %msub
                      %mi D
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} e_0:E_0\to D_0
              is split, then the same is true for any pullback of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo :
                    %mi E
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} e:E\to D
              along some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} k:C\to D
              is given by a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              where
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mn 0
                      %mo =
                      %msub
                        %mi E
                        %mn 0
                      %msub
                        %mo ×
                        %mrow
                          %msub
                            %mi D
                            %mn 0
                      %msub
                        %mi D
                        %mi iso
                      %msub
                        %mo ×
                        %mrow
                          %msub
                            %mi D
                            %mn 0
                      %msub
                        %mi C
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} P_0 = E_0 \times_{D_0} D_{iso} \times_{D_0} C_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi iso
                    %mo ↪
                    %msub
                      %mi D
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} D_{iso}\hookrightarrow D_1
              is the “object of isomorphisms” in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn 0
                    %mo →
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} P_0\to C_0
              has a splitting given by combining the splitting of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} e_0
              with the “identities” morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mn 0
                      %mo →
                      %msub
                        %mi D
                        %mi iso
                    %annotation{:encoding => "application/x-tex"} D_0\to D_{iso}
            %p
              Now suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi D
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} f:D\to E
              is any functor in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %msub
                        %mi Cong
                        %mi s
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} n Cong_s(K)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mn 0
                    %mo =
                    %msub
                      %mi D
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Q_0=D_0
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Q_1
              be the pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Q
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi E
                              %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi Q
                              %mn 0
                            %mo ×
                            %msub
                              %mi Q
                              %mn 0
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi f
                                  %mn 0
                                %mo ×
                                %msub
                                  %mi f
                                  %mn 0
                          %mtd
                            %msub
                              %mi E
                              %mn 0
                            %mo ×
                            %msub
                              %mi E
                              %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ Q_1 &amp; \to &amp; E_1 \\ \downarrow &amp;&amp; \downarrow\\
                    Q_0 \times Q_0 &amp; \overset{f_0\times f_0}{\to} &amp; E_0\times E_0}
            %p
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ≅
                    %mi m
                    %mi e
                  %annotation{:encoding => "application/x-tex"} f \cong m e
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo :
                    %mi D
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} e:D \to Q
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo :
                    %mi Q
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} m:Q\to E
              are the obvious functors. Moreover, clearly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              is ff, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              satisfies the condition above, so any pullback of it is eso. It follows that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              itself were eso, then it would be equivalent to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              is ff, the kernel of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is the same as the kernel of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              regular it remains only to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              is a quotient of that kernel. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mspace{:width => "thickmathspace"}
                    %mo ⇉
                    %mspace{:width => "thickmathspace"}
                    %mi D
                  %annotation{:encoding => "application/x-tex"} C \;\rightrightarrows\; D
              denotes
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ker(f)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is the comma object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} /
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f/f)
              and thus we can calculate
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 0
                    %mo =
                    %msub
                      %mi D
                      %mn 0
                    %msub
                      %mo ×
                      %mrow
                        %msub
                          %mi E
                          %mn 0
                    %msub
                      %mi E
                      %mn 1
                    %msub
                      %mo ×
                      %mrow
                        %msub
                          %mi E
                          %mn 0
                    %msub
                      %mi D
                      %mn 0
                    %mo ≅
                    %msub
                      %mi Q
                      %mn 1
                    %mo .
                  %annotation{:encoding => "application/x-tex"} C_0 = D_0\times_{E_0} E_1 \times_{E_0} D_0 \cong Q_1.
            %p
              Therefore, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi D
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} g:D\to X
              is equipped with an action by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ker(f)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Q
                        %mn 1
                      %mo =
                      %msub
                        %mi C
                        %mn 0
                      %mo →
                      %msub
                        %mi X
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} Q_1=C_0\to X_1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Q\to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is a quotient of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ker(f)
          .num_remark
            %h6#remark_6 Remark
            %p
              There are three “problems” with the 2-category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %msub
                        %mi Cong
                        %mi s
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} n Cong_s(K)
            %ol
              %li
                It is too big. It is not necessary to include every
                = succeed "-congruence" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
              %li
                It is too small. While it is regular, it is not
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/exact+2-category"} exact
              %li
                It doesn’t remember information about
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                is already regular, then passing to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %msub
                        %mi Cong
                        %mi s
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} n Cong_s(K)
                destroys most of the esos and quotients already present in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
          %p The solution to the first problem is straightforward.
          .num_defn
            %h6#definition_10 Definition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a 2-category with finite limits, define
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mrow
                        %mi reg
                        %mo{:stretchy => "false"} /
                        %mi lex
                    %mo ↪
                    %mn 2
                    %msub
                      %mi Cong
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    K_{reg/lex} \hookrightarrow 2 Cong_s(K)
            %p
              to be the sub-2-category of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %msub
                      %mi Cong
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 2 Cong_s(K)
              spanned by the 2-congruences which occur as kernels of morphisms in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
          .num_remark
            %h6#remark_7 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is an
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-congruence," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mrow
                        %mi reg
                        %mo{:stretchy => "false"} /
                        %mi lex
                  %annotation{:encoding => "application/x-tex"} K_{reg/lex}
              is contained in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %msub
                      %mi Cong
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} n Cong_s(K)
              and is an
              = succeed "-category." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              factors through
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mrow
                          %mi reg
                          %mo{:stretchy => "false"} /
                          %mi lex
                    %annotation{:encoding => "application/x-tex"} K_{reg/lex}
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              For any finitely complete 2-category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mrow
                        %mi reg
                        %mo{:stretchy => "false"} /
                        %mi lex
                  %annotation{:encoding => "application/x-tex"} K_{reg/lex}
              is
              = succeed "," do
                %span.newWikiWord
                  regular
                  %a{:href => "/nlab/new/refular+2-category"} ?
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %mi K
                    %mo →
                    %msub
                      %mi K
                      %mrow
                        %mi reg
                        %mo{:stretchy => "false"} /
                        %mi lex
                  %annotation{:encoding => "application/x-tex"} \Phi:K\to K_{reg/lex}
              induces an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Reg
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi K
                      %mrow
                        %mi reg
                        %mo{:stretchy => "false"} /
                        %mi lex
                    %mo ,
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Lex
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Reg(K_{reg/lex},L) \simeq Lex(K,L)
            %p
              for any regular 2-category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Reg
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Reg(-,-)
            denotes the 2-category of regular functors, transformations, and modifications between two regular 2-categories, and likewise
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Lex
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Lex(-,-)
            denotes the 2-category of finite-limit-preserving functors, transformations, and modifications between two finitely complete 2-categories.
          .proof
            %h6#proof_5 Proof
            %p
              It is easy to verify that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mrow
                        %mi reg
                        %mo{:stretchy => "false"} /
                        %mi lex
                  %annotation{:encoding => "application/x-tex"} K_{reg/lex}
              is closed under finite limits in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %msub
                        %mi Cong
                        %mi s
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 2 Cong_s(K)
              = succeed ";" do
                %a.maruku-ref{:href => "#regex"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi K
                    %mo →
                    %mi L
                  %annotation{:encoding => "application/x-tex"} F:K\to L
              is a lex functor where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is regular, we extend it to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mrow
                        %mi reg
                        %mo{:stretchy => "false"} /
                        %mi lex
                  %annotation{:encoding => "application/x-tex"} K_{reg/lex}
              by sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(f)
              to the quotient in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ker(F f)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is regular. It is easy to verify that this is regular and is the unique regular extension of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
          %p
            In particular, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular 1-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mrow
                      %mi reg
                      %mo{:stretchy => "false"} /
                      %mi lex
                %annotation{:encoding => "application/x-tex"} K_{reg/lex}
            is the ordinary regular completion of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Elephant"} Elephant
          %p
            To solve the second and third problems with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %msub
                      %mi Cong
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} n Cong_s(K)
          %h3#Exactness Exactness
          %p
            Let now the ambient
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            be equipped with the structure of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-site"} 2-site
            %a.maruku-ref{:href => "#2CongWithAnafunctors"}
            the 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi Cong
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 2Cong(K)
            whose objects are 2-congruences in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %a.existingWikiWord{:href => "/nlab/show/anafunctors"} anafunctors
            between these, with respect to the given 2-site structure.
          %p
            Notice that when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is a
            %a.existingWikiWord{:href => "/nlab/show/regular+2-category"} regular 2-category
            it comes with a canonical structure of a 2-site: its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/regular+coverage"} regular coverage
          .num_theorem
            %h6#theorem_4 Theorem
            %p
              For any
              %a.existingWikiWord{:href => "/nlab/show/subcanonical+topology"} subcanonical
              and finitely complete
              %a.existingWikiWord{:href => "/nlab/show/2-site"} 2-site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              (such as a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/regular+coverage"} regular coverage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi Cong
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 2Cong(K)
              from def.
              %a.maruku-ref{:href => "#2CongWithAnafunctors"}
            %ul
              %li
                %p is finitely complete;
              %li
                %p
                  contains
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 2
                          %msub
                            %mi Cong
                            %mi s
                          %mo{:stretchy => "false"} (
                          %mi K
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} 2Cong_s(K)
                  %a.maruku-ref{:href => "#2CongWithOrdinaryFunctors"}
                  as a homwise-full sub-2-category (that is,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %msub
