          %h2#Examples Examples
          %h3#ExamplesInGrpd
            In
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} Grpd
          %blockquote
            %p Under construction.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo :
                  %mo =
                %annotation{:encoding => "application/x-tex"} K :=
            %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            be the 2-category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
          %p We would like to see that the following statement is true:
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            of 2-congruences in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} Grpd
            is
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+2-categories"} equivalent
            to the 2-category
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi Cong
                  %mo{:stretchy => "false"} (
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Cat
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  2Cong(Grpd)
                  \\simeq
                  Cat
                  \\,.
          %p Let’s check:
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} Grpd
            as follows.
          %ul
            %li
              %p
                let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℂ
                        %mn 0
                      %mo :
                      %mo =
                      %mi Core
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}_0 := Core(C) \in Grpd
                be the
                %a.existingWikiWord{:href => "/nlab/show/core"} core
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
            %li
              %p
                let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℂ
                        %mn 1
                      %mo :
                      %mo =
                      %mi Core
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mrow
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}_1 := Core(C^{\Delta[1]}) \in Grpd
                be the core of the
                %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
            %li
              %p
                let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo ,
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi ℂ
                        %mn 1
                      %mo →
                      %msub
                        %mi ℂ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} (s,t) : \mathbb{C}_1 \to \mathbb{C}_0
                be image under
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Core
                      %mo :
                      %mi Cat
                      %mo →
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} Core : Cat \to Grpd
                of the endpoint evaluation
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo :
                  %msup
                    %mi C
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo →
                  %msup
                    %mi C
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                  %mo =
                  %mi C
                  %mo ×
                  %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C^{\Delta[0] \coprod \Delta[0] \to \Delta[1]}
                  \:
                  C^{\Delta[1]} \to C^{\Delta[0] \coprod \Delta[0]}
                  \=
                  C \times C
                  \\,.
          %p
            (Here we are using the canonical embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo ↪
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} \Delta \hookrightarrow Cat
            of the
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
          %p
            This is clearly a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
            %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            is trivially a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/conservative+morphism"} conservative morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℂ
                    %mn 1
                  %mo →
                  %msub
                    %mi ℂ
                    %mn 0
                  %mo ×
                  %msub
                    %mi ℂ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbb{C}_1 \to \mathbb{C}_0 \times \mathbb{C}_0
            is a
            %a.existingWikiWord{:href => "/nlab/show/discrete+morphism"} discrete morphism
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
          %p
            Since
            %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
            %a.existingWikiWord{:href => "/nlab/show/2-pullbacks"} 2-pullbacks
            in
            %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (s,t)
            is (under the
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            embedding
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo :
                    %mi Grpd
                    %mo ↪
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} N : Grpd \hookrightarrow sSet
            %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
            (by direct inspection, but also as a special case of standard facts about the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℂ
                    %mn 1
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mi ℂ
                        %mn 0
                  %msub
                    %mi ℂ
                    %mn 1
                  %mo ≃
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{C}_1 \times_{\mathbb{C}_0} \mathbb{C}_1
                  \\simeq
                  Core(C^{\Delta[2]})
                  \\,.
          %p
            Accordingly, let the internal composition in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            be induced by the given composition in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℂ
                    %mn 1
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mi ℂ
                        %mn 0
                  %msub
                    %mi ℂ
                    %mn 1
                  %mo ≃
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi ℂ
                    %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{C}_1 \times_{\mathbb{C}_0} \mathbb{C}_1
                  \\simeq
                  Core(C^{\Delta[2]})
                  \\stackrel{}{\to}
                  Core(C^{\Delta[1]})
                  \\simeq
                  \\mathbb{C}_1
                  \\,.
          %p
            This is clearly
            %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
            and
            %a.existingWikiWord{:href => "/nlab/show/unitality"} unital
            and hence makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            a hom-wise discrete category, def.
            = succeed "," do
              %a.maruku-ref{:href => "#HomWiseDiscreteInternalCategory"}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Grpd
          %p
            Observe next (for instance using the discussion and examples at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℂ
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi ℂ
                    %mn 0
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mo →
                  %msub
                    %mi ℂ
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ker(\mathbb{C}_0) =
                  ( \mathbb{C}_0^{\Delta[1]} \stackrel{\to}{\to} \mathbb{C}_0)
                  \\,.
          %p
            Notice that up to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of groupoids
            %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo :
                    %msub
                      %mi ℂ
                      %mn 0
                    %mo →
                    %msub
                      %mi ℂ
                      %mn 0
                    %mo ×
                    %msub
                      %mi ℂ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Delta : \mathbb{C}_0 \to \mathbb{C}_0 \times \mathbb{C}_0
          %p
            Therefore there is an evident
            %a.existingWikiWord{:href => "/nlab/show/internal+functor"} internal functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℂ
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} ker(\mathbb{C}_0) \to \mathbb{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℂ
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ker(\mathbb{C}_0)
            given by the inclusion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℂ
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msubsup
                    %mi ℂ
                    %mn 0
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo ≃
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo ↪
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  ker(\mathbb{C}_0)
                  \\simeq
                  \\mathbb{C}_0^{\Delta[1]}
                  \\simeq
                  Core(C)^{\Delta[1]}
                  \\hookrightarrow
                  Core(C^{\Delta[1]})
                  \\,,
          %p
            but which in the second version above simply reproduces the
            %a.existingWikiWord{:href => "/nlab/show/identity-assigning+morphism"} identity-assigning morphism
            of the internal category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
          %p
            It follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            is indeed a 2-congruence, def.
            = succeed "." do
              %a.maruku-ref{:href => "#2Congruence"}
          %p
            Conversely, given a 2-congruence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Grpd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            as follows:
          %p (…)
          .num_remark
            %h6#remark_9 Remark
            %p
              In the notation of the above proof, we can also form
              %em internally
              the
              %a.existingWikiWord{:href => "/nlab/show/core"} core
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℂ
                        %mn 0
                      %mover
                        %munder
                          %mo →
                          %mi id
                        %mover
                          %mo →
                          %mi id
                      %msub
                        %mi ℂ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}_0 \stackrel{\overset{id}{\to}}{\underset{id}{\to}} \mathbb{C}_0
            %p
              This means that the 2-congruences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              in the above proof are
              %a.existingWikiWord{:href => "/nlab/show/complete+Segal+spaces"} complete Segal spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C} : [n] \mapsto Core(C^{\Delta[n]})
                    \\,,
            %p
              hence are
              %a.existingWikiWord{:href => "/nlab/show/internal+categories+in+an+%28%E2%88%9E%2C1%29-category"} internal categories in an (∞,1)-category
              in the
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
          %h3#ExamplesInA2Comma1Category
            In a general
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,1)
          %p (…)
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/congruence"} congruence
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/n-congruence"} n-congruence
          %h2#references References
          %p The above material is taken from
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
              ,
              %em
                %a.existingWikiWord{:href => "/michaelshulman/show/2-congruence"} 2-congruence
          %p and
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
              ,
              %em
                %a.existingWikiWord{:href => "/michaelshulman/show/exact+completion+of+a+2-category"} exact completion of a 2-category
          %p Some lemmas are taken from
          %ul#Shulman07
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
              ,
              %em Framed bicategories and monoidal fibrations
              (
              %a{:href => "http://arxiv.org/abs/0706.1286"}> arXiv:0706.1286
              )
          %p and
          %ul#Fiore06
            %li
