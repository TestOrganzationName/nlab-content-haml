                  %mi X
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi Ω
                  %mi 𝒜
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} H^1\big(X;\, \Omega\mathcal{A}\big)
            %a.maruku-eqref{:href => "#eq:NonabelianCohomologyViaSimplicialMappings"} (41)
            may equivalently be computed as the special case of “differential” cohomology of
            %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"}
              smooth
              = succeed "-groupoids" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            with coefficients that happen to be non-differential (geometrically
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/discrete+object"} discrete
          #eq:NonabelianCohomologyViaSimplicialMappings.maruku-equation
            %span.maruku-eq-number (41)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi 𝒜
                          %mspace{:width => "thinmathspace"}
