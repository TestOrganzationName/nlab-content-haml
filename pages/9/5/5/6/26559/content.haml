                        %mi n
                        %mspace{:width => "thickmathspace"}
                        %mi factors
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge^\bullet \mathfrak{g} \,:=\, \underset{n \in \mathbb{N}}{\bigoplus}
                    \\,\underbrace{\mathfrak{g}^\ast \wedge \cdots \wedge \mathfrak{g}^\ast}_{n\;factors}
          #eq:LieAlgebrasAsDGCAlgebras.maruku-equation
            %span.maruku-eq-number (17)
            %code.maruku-mathml
          %div{:style => "margin: -30px 0px 20px 0px"}
            %img{:src => "/nlab/files/GeomPhys-LieAlgebraUnderCE.jpg", :width => "800px"}/
          %p
            One readily checks that this derivation squares to zero iff the bracket satisfies its
            = succeed "(!):" do
              %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtext
                    Jacobi identity for
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
