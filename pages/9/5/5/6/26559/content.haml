                %annotation{:encoding => "application/x-tex"} (\wedge^\bullet \mathfrak{g}^\ast, \mathrm{d}_{[-,-]})
            is known as the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} CE
