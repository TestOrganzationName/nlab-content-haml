                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+L-infinity+algebras"}
              Whitehead
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔩
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathfrak{l}\mathcal{A}
            of spaces:
          %div{:style => "margin: -30px 0px 0px 0px"}
            %img{:src => "/nlab/files/GeomPhys-FirstExamplesOfSullivanModels.jpg", :width => "900px"}/
          %div{:style => "margin: -40px 0px 20px -3px"}
            %img{:src => "/nlab/files/GeomPhys-FurtherExamplesOfSullivanModels.jpg", :width => "907px"}/
          %p
            Many of the
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+L-infinity+algebra"}
              Whitehead
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            of familar spaces do not have established names as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebras"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi L
