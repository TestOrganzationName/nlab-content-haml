            %a.maruku-ref{:href => "#SolutionSpaceViaGaussLaw"}
            this means:
          %p
          #SolutionsAsFlatForms.num_prop
            %h6 Proposition
            %p
              Given a higher gauge theory of Maxwell-type (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HigherMaxwellEquations"}
              %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
              given by graded-symmetric
              %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi P
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec P
              %a.maruku-eqref{:href => "#eq:EqHigherMaxwellEquations"} (6)
              its space of
              %a.existingWikiWord{:href => "/nlab/show/flux+densities"} flux densities
              solving the higher Maxwell equations is identified with the space of closed differential forms with coefficients in the
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
