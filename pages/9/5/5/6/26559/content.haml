                \&amp;rbrack;
            %li{:id => "AschieriJurčo04"}
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paolo+Aschieri"}> Paolo Aschieri
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Branislav+Jur%C4%8Do"} Branislav Jurčo
                = succeed "," do
                  %em
                    Gerbes, M5-Brane Anomalies and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn 8
                        %annotation{:encoding => "application/x-tex"} E_8
                    Gauge Theory
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/hep-th/0409200"} arXiv:hep-th/0409200
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1088/1126-6708/2004/10/068"} doi:10.1088/1126-6708/2004/10/068
            %li#AtiyahSegal04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"} Graeme Segal
                = succeed "," do
                  %em Twisted K-theory
                %strong 1
                3 (2004) &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/math/0407054"}> arXiv:math/0407054
                ,
                = succeed "," do
                  %a{:href => "http://iamm.su/en/journals/j879/?VID=10"} journal page
                = succeed "&rbrack;" do
                  %a{:href => "http://iamm.su/upload/iblock/45e/t1-n3-287-330.pdf"} published pdf
            %li#BandosBerkovitsSorokin98
              %p
