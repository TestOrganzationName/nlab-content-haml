                  %msup
                    %mi 𝔤
                    %mo *
                  %mo ∧
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} [-,-]^\ast \,:\,\mathfrak{g}^\ast \to \mathfrak{g}^\ast \wedge \mathfrak{g}^\ast
            which extends uniquely to a degree=1
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            on the graded
            %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %mi 𝔤
                    %mspace{:width => "thinmathspace"}
                    %mo :
                    %mo =
                    %mspace{:width => "thinmathspace"}
