                  \\,
                  \\widehat X{}^d
                  ,\,
                  \\mathcal{A}
                  \\,
                  \\big)
                  \\,,
          %p
            In components this is the
            = succeed "-presentation" do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+cohomology"} Čech cohomology
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
          %p
            On the other hand, if the target object is a smooth set such as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi dR
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ;
                  %mi 𝔞
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi clst
                %annotation{:encoding => "application/x-tex"} \Omega^1_{dR}(-;\mathfrak{a})_{clst}
            %a.maruku-eqref{:href => "#eq:ModuliSheafOfFlatDifferentialForms"} (32)
            then smooth simplicial maps out of the
            %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+groupoid"} Čech groupoid
            into it collapse to maps out of just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            itself.
          .float_right_image{:style => "margin: -50px 0px 10px 30px"}
            %img{:src => "/nlab/files/GeomPhys-ModulatingFluxesAndCharges-240206.jpg", :width => "280px"}/
          %p
            In summary so far, this means that flux densities as well as their local charges are now
            %em both
            “
            %a.existingWikiWord{:href => "/nlab/show/modulating+morphism"}> modulated
            ” by maps of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoids"}
                smooth
                = succeed "-groupoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
          %p
            In order to impose flux quantization – hence the condition that these
            = succeed "-flux" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            = succeed "-charges" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
          %p
            %br/
          %p
            %strong Higher deformations of flux densities.
            Recall
            %a.maruku-eqref{:href => "#eq:ConcordanceOfFlatDifferentialForms"} (20)
            that a
            %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
            in
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/concordance"} concordance
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
          %div{:style => "margin: -30px 0px 20px 0px"}
            %img{:src => "/nlab/files/GeomPhys-DeformationPathOfFluxDensities-240204.jpg", :width => "470px"}/
          %p
            Here
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %msubsup
                      %mi Δ
                      %mi geo
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} [0,1] \simeq \Delta^1_{geo}
            %a.existingWikiWord{:href => "/nlab/show/n-simplex"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              \-simplices
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi geo
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n_{geo}
          %div{:style => "margin: -30px 0px 20px 0px"}
            %img{:src => "/nlab/files/GeomPhys-SimpSetOfFluxDeformations-240208.jpg", :width => "850px"}/
          %p
            Since in each degree this is a set of plots of a
            %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
            of on-shell flux densities
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:ModuliSheafOfFlatDifferentialForms"} (32)
            = succeed "&rbrack;" do
              %a{:href => "#FSS23"} FSS23-Char, Def. 9.1
            = succeed "&rbrack;" do
              %a{:href => "#FSS23"} FSS23-Char, Prop. 5.10
            %em
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape
            or
            %em
              %a.existingWikiWord{:href => "/nlab/show/shape+via+cohesive+path+%E2%88%9E-groupoid"}
                smooth path
                = succeed "-groupoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
            of the moduli of flux densities:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                  %mspace{:width => "thinmathspace"}
                  %msubsup
                    %mi Ω
                    %mi{:mathvariant => "normal"} dR
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ;
                  %mi 𝔞
                  %msub
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mi clsd
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi SmoothSimpSet
                    %mi Kan
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\esh
                  \\,
                  \\Omega^1_{\mathrm{dR}}\big(
                  \-;
                  \\mathfrak{a}
                  \\big)_{clsd}
                  \\;\in\;
                  SmoothSimpSet_{Kan}
                  \\,.
          %p
            It is in this object that
            %a.existingWikiWord{:href => "/nlab/show/flux+densities"} flux densities
            become comparable to their charges:
          %p
            (1.) There is the evident inclusion of the smooth set of flux densities &amp;lbrack;
            %a{:href => "#FSS23Char"}> FSS23-Char (9.3)
            \&amp;rbrack;
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi{:mathvariant => "normal"} dR
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ;
                  %mi 𝔞
                  %msub
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mi clsd
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi η
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %msubsup
                    %mi Ω
                    %mi{:mathvariant => "normal"} dR
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ;
                  %mi 𝔞
                  %msub
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mi clsd
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^1_{\mathrm{dR}}\big(
                  \-;
                  \\mathfrak{a}
                  \\big)_{clsd}
                  \\xrightarrow{
                  \\;\;
                  \\eta^{\esh}
                  \\;\;
                  }
                  \\,
                  \\Omega^1_{\mathrm{dR}}\big(
                  \-;
                  \\mathfrak{a}
                  \\big)_{clsd}
                  \\,.
          %p
            (2.) Given an identification
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                  %mspace{:width => "thinmathspace"}
                  %mo ≃
                  %mspace{:width => "thinmathspace"}
                  %mi 𝔩
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathfrak{a} \,\simeq\, \mathfrak{l}\mathcal{A}
            with a
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+L-infinity+algebra"}
              Whitehead
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            (Prop.
            = succeed ")," do
              %a.maruku-ref{:href => "#SullivanTheorem"}
            %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+dg-algebraic+rational+homotopy+theory"} fundamental theorem of dg-algebraic rational homotopy theory
            %a.maruku-eqref{:href => "#eq:FundamentalTheoremOfRHT"} (24)
            furthermore says &amp;lbrack;
            %a{:href => "#FSS23Char"}> FSS23-Char, Lem. 9.1
            \&amp;rbrack; that we have a (homotopy-)equivalence to the
            = succeed "-rationalization" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mi ℝ
                  %mi 𝒜
