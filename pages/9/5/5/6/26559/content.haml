          %p
          .num_remark
            %h6 Remark
            %p
              %strong
                (Shortcoming of higher
                = succeed "-charge" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} U
                        %mo{:stretchy => "false"} (
                        %mn 1
