              sourced by
              %a.existingWikiWord{:href => "/nlab/show/M2-branes"} M2-branes
              obeys the equation
            #eq:M2FluxSourcedSourceByTwoM5Branes.maruku-equation
              %span.maruku-eq-number (16)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "right center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
