                      %mi Kan
                  %annotation{:encoding => "application/x-tex"} SmoothSimpSet_{Kan}
          %p
            This is important, because for any
            %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
