                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msup
                            %mi ℝ
                            %mi n
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi X
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mi f
                        %mtd
                          %mo ↦
                        %mtd
                          %msub
                            %mi f
                            %mo *
                          %msub
                            %mi id
                            %mrow
                              %msup
                                %mi ℝ
                                %mi n
                          %mspace{:width => "thinmathspace"}
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left.
                  \\begin{array}{l}
                  X \in SmoothSet
                  \\\
                  \\mathbb{R}^n \in CartSp
                  \\end{array}
                  \\;
                  \\right\}
                  \\;\;\;\;\;\;\;
                  \\vdash
                  \\;\;\;\;\;\;\;
                  \\array{
                  Hom\big(\mathbb{R}^n,\, X\big)
                  \&amp;\overset{\sim}{\longrightarrow}&amp;
                  Plot\big(\mathbb{R}^n,\, X\big)
                  \\\
                  f &amp;\mapsto&amp; f_\ast id_{\mathbb{R}^n}
                  \\,.
                  }
          %p
            But the category
            %a.existingWikiWord{:href => "/nlab/show/SmoothSet"} SmoothSet
            contains now much more than just ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/truncated+object+in+an+%28infinity%2C1%29-category"} 0-truncated
            %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli stacks
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/differential+n-forms"} differential n-forms
            clearly form a
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            over
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            and hence may be regarded as the plots of a
            %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi dR
                      %mi p
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi SmoothSet
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^p_{dR} \,\in\, SmoothSet
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Plot
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi dR
                    %mi p
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Ω
                    %mi dR
                    %mi p
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Plot\big(
                  \\mathbb{R}^n
                  ,\,
                  \\mathbf{\Omega}^p_{dR}
                  \\big)
                  \\;\;
                  \\coloneqq
                  \\;\;
                  \\Omega^p_{dR}(\mathbb{R}^n)
                  \\,.
          %p
            One checks that this is a moduli stack for differential forms on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi SmthMfd
                  %mo ↪
                  %mi SmthSet
                %annotation{:encoding => "application/x-tex"} X \in SmthMfd \hookrightarrow SmthSet
            we have a
            %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
          #eq:DifferentialFormsModulatedOnManifolds.maruku-equation
            %span.maruku-eq-number (31)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi SmthMfd
                  %mo ↪
                  %mi SmthSet
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi Hom
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi dR
                    %mi p
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Ω
                    %mi dR
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  X \in SmthMfd \hookrightarrow SmthSet
                  \\;\;\;\;\;\;\;
                  \\vdash
                  \\;\;\;\;\;\;\;
                  Hom\big(
                  X
                  ,\,
                  \\mathbf{\Omega}^p_{dR}
                  \\big)
                  \\;\simeq\;
                  \\Omega^p_{dR}(X)
          %p
            of the smooth maps from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi dR
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^p_{dR}
            with the actual smooth differential forms.
          %p
            Here it is useful to think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi dR
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^p_{dR}
            as a space which carries a
            %em
              universal differential
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ω
                    %mi p
                    %mi univ
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %msubsup
                    %mi Ω
                    %mi dR
                    %mi p
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi dR
                    %mi p
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} \omega_p^{univ} \,\in\, \Omega^p_{dR}\big(\mathbf{\Omega}^p_{dR}\big)
            (as befits a moduli stack of differential forms) such that every differential form on any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ω
                    %mi p
                    %mi univ
                %annotation{:encoding => "application/x-tex"} \omega_p^{univ}
            along a unique smooth map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi dR
                      %mi p
                  %annotation{:encoding => "application/x-tex"} X \to \mathbf{\Omega}^p_{dR}
          %p In fact, it makes sense to define differential forms on any smooth set by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi SmthSet
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Ω
                    %mi dR
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi Hom
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi dR
                    %mi p
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  X \,\in\, SmthSet
                  \\;\;\;\;\;\;\;
                  \\vdash
                  \\;\;\;\;\;\;
                  \\Omega^p_{dR}(X)
                  \\;\coloneqq\;
                  Hom\big(
                  X
                  ,\,
                  \\mathbf{\Omega}^p_{dR}
                  \\big)
          %p
            and then that universal differential form on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi dR
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^p_{dR}
            actually exists:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ω
                    %mi p
                    %mi univ
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi id
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi Hom
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi dR
                    %mi p
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi dR
                    %mi p
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≡
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Ω
                    %mi dR
                    %mi p
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi dR
                    %mi p
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\omega_p^{univ}
                  \\;\coloneqq\;
                  id
                  \\,\in\,
                  Hom\big(
                  \\mathbf{\Omega}^p_{dR}
                  ,\,
                  \\mathbf{\Omega}^p_{dR}
                  \\big)
                  \\;\equiv\;
                  \\Omega^p_{dR}\big(
                  \\mathbf{\Omega}^p_{dR}
                  \\big)
                  \\,.
          %p
            It is in this way that the category
            %a.existingWikiWord{:href => "/nlab/show/SmoothSet"} SmoothSet
            makes (0-truncated)
            %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli stacks
            exist in just the way they ought to (and higher moduli stacks exist similarly in the higher generalization of
            %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            to
            %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoids"} smooth infinity-groupoids
            that we turn to below).
          %p
            For the case at hand, it is now straightforward to further specialize this example: The (0-truncated) moduli stack of
            %a.existingWikiWord{:href => "/nlab/show/flat+L-infinity+algebra+valued+differential+forms"}
              flat
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            for a given
            %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
              \-algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            is the
            %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
            whose plots are just those differential forms on
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
          #eq:ModuliSheafOfFlatDifferentialForms.maruku-equation
            %span.maruku-eq-number (32)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi dR
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mtext -
                  %mo ;
                  %mi 𝔞
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi clsd
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mi SmthSet
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^1_{dR}(\text{-};\mathfrak{a})_{clsd}
                  \\;\in\;
                  SmthSet
          %p
            and in generalization of
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:DifferentialFormsModulatedOnManifolds"} (31)
          #eq:FlatDifferentialFormsModulatedOnManifolds.maruku-equation
            %span.maruku-eq-number (33)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi SmthMfd
                  %mo ↪
                  %mi SmthSet
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi Hom
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msubsup
                    %mi Ω
                    %mi dR
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mtext -
                  %mo ;
                  %mi 𝔞
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi clsd
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Ω
                    %mi dR
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X \in SmthMfd \hookrightarrow SmthSet
                  \\;\;\;\;\;\;\;
                  \\vdash
                  \\;\;\;\;\;\;\;
                  Hom\big(
                  X
                  ,\,
                  \\Omega^1_{dR}(\text{-};\mathfrak{a})_{clsd}
                  \\big)
                  \\;\simeq\;
                  \\Omega^p_{dR}(X)
                  \\,.
          %p
            %br/
          %p
            %strong Simplicial sets of moduli of charges.
          .float_right_image{:style => "margin: -35px 0px 20px 10px"}
            %img{:src => "/nlab/files/GeomPhys-HigherGaugeTransformationSimplices.jpg", :width => "300px"}/
          %p
            But independently of the differential geometry, the collection of fields in a
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+theory"} higher gauge theory
            is not really a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            with unambiguously distinct
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \Phi'
            of
            %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
            may be distinct and yet
            %a.existingWikiWord{:href => "/nlab/show/identification+type"} identified
            by
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformations"} gauge transformations
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %munderover
                      %mo ⟶
                      %mo ∼
                      %mi g
                    %mi Φ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \Phi \underoverset{\sim}{g}{\longrightarrow} \Phi'
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+fields"} higher gauge fields
            there is not really a set of such gauge transformations either, as any pair of them, in turn, may be distinct and yet
            %a.existingWikiWord{:href => "/nlab/show/identification+type"} identified
            by a
            %a.existingWikiWord{:href => "/nlab/show/gauge-of-gauge+transformation"} gauge-of-gauge transformation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
          .float_right_image{:style => "margin: -20px 0px 20px 10px"}
            %img{:src => "/nlab/files/GeomPhys-GlobularAmongSimplicial.jpg", :width => "170px"}/
          %p
            There are different equivalent ways to record systems of such
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+gauge+transformations"} higher gauge transformations
            %a.existingWikiWord{:href => "/nlab/show/globular+set"} globular
            or
            %a.existingWikiWord{:href => "/nlab/show/cubical+set"} cubical
            arrangement suggests itself but turns out to come with technical subtleties, while the “
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"}> simplicial
            ” arrangement indicated above turns out to be remarkably useful and has an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+theory"} extremely well-developed theory
            %a.existingWikiWord{:href => "/nlab/show/gauge-of-gauge+transformations"} gauge-of-gauge transformations
            are always taken to fill a
            %em
              %a.existingWikiWord{:href => "/nlab/show/triangle"} triangle
            of ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformations"} gauge transformations
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+transformations"} higher gauge transformations
            are taken to fill a
            %em
              %a.existingWikiWord{:href => "/nlab/show/tetrahedron"} tetrahedron
            of these, and generally an
            = succeed "-gauge" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/n-simplex"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  \-simplices
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/globular+set"} globular
          %p
            Hence (still disregarding its
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
            set of fields of a
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+theory"} higher gauge theory
            is, beyond the “0-simplices” of the nominal fields themselves, actually a system of sets of higher simplices of
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+transformations"} higher gauge transformations
            in any dimension, such that with any
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-simplices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            = succeed "-simplices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
          %div{:style => "margin: -20px 0px 20px 0px"}
            %img{:src => "/nlab/files/GeomPhys-SimplicialSetSchematics.jpg", :width => "900px"}/
          %p
            Hence — in the spirit
            %a.maruku-eqref{:href => "#eq:PlotsByCartesianSpaces"} (29)
            of generalized spaces defined by how to plot out probe-spaces inside them —, such
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            are those generalized spaces which are probe-able by the abstract
            %a.existingWikiWord{:href => "/nlab/show/cellular+simplices"} cellular simplices
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Delta^n
            forming the
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
            %a.existingWikiWord{:href => "/nlab/show/SimpSet"} SimpSet
            of simplicial sets is that of
            %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
            on
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SimpSet
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  SimpSet
                  \\;\coloneqq\;
                  PSh(\Delta)
                  \\,.
          %p
            For example, given a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            with
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            then the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills
              %a.existingWikiWord{:href => "/nlab/show/gauge+potentials"} gauge potentials
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 3
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^3
            – to be denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Plt
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mn 3
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Plt}(\mathbb{R}^3,\mathbf{B}G_{conn})
            for reasons discussed below – is the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            whose:
          .float_right_image{:style => "margin: -35px 0px 20px 30px"}
            %img{:src => "/nlab/files/GeomPhys-GroupoidOfYMFieldOnR3.jpg", :width => "400px"}/
          %p
            %em 0-Simplices
            are the YM
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gauge+potentials"} gauge potentials
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+differential+form"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              \-valued 1-forms
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi dR
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 3
                    %mo ;
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \Omega^1_{dR}(\mathbb{R}^3; \mathfrak{g})
          %p
            %em 1-Simplices
            are the smooth
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi ℝ
                    %mn 3
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} g \,\colon\, \mathbb{R}^3 \to G
            serving as
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformations"} gauge transformations
            between such
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/gauge+potentials"} gauge potentials
          %p
            %em 2-Simplices
            are uniquely filled whenever the gauge transformations around their boundary compose;
          %p
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n\geq 3
              \-Simplices
            are uniquely filled whenever their face
            = succeed "-simplices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
          .float_right_image{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/The2Horns.jpg", :width => "510px"}/
          %p
            That this example is indeed a
            %em
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            in that the gauge transformation 1-simplices have
            %a.existingWikiWord{:href => "/nlab/show/inverse+morphism"} inverses
            and
            %a.existingWikiWord{:href => "/nlab/show/composition"} composites
            (whenever composable) is witnessed by the fact that whenever one finds in this simplicial set a pair of 1-simplices that share a 0-simplex (jargon: a “
            %a.existingWikiWord{:href => "/nlab/show/horn"}> 2-horn
            ”
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Λ
                      %mi i
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \Lambda^2_i
          %p
            Similarly one defines the higher
            %a.existingWikiWord{:href => "/nlab/show/horns"} horns
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Λ
                    %mi i
                    %mi n
                  %mo ⊂
                  %msup
                    %mi Δ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Lambda^n_i \subset \Delta^n
            to be the sub-simplicial sets of a simplex missing the interior and the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ith
                %annotation{:encoding => "application/x-tex"} ith
            face, and then says that a simplicial set is an
            %em
              %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-groupoid
            (historical terminology:
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Λ
                    %mi i
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Lambda^n_i
            inside it may be completed to an images of
            = succeed ".:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n
          %div{:style => "margin: -30px 0px 20px 0px"}
            %img{:src => "/nlab/files/GeomPhys-KanCondition.jpg", :width => "500px"}/
          %p
            As an abstract class of examples: For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒴
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi SimpSet
                      %mi Kan
                  %annotation{:encoding => "application/x-tex"} \mathcal{X},\, \mathcal{Y} \,\in\, SimpSet_{Kan}
            %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-groupoid
            %a.existingWikiWord{:href => "/nlab/show/derived+hom-space"} of maps
            between them
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo ,
                    %mi 𝒴
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi SimpSet
                      %mi Kan
                  %annotation{:encoding => "application/x-tex"} Map(\mathcal{X},\mathcal{Y})\,\in\, SimpSet_{Kan}
            = succeed "-shaped" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n
            = succeed "-parameterized" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n
          #eq:MappingComplex.maruku-equation
            %span.maruku-eq-number (34)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Plt
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Δ
                    %mi n
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi 𝒳
                  %mo ,
                  %mi 𝒴
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi Hom
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Δ
                    %mi n
                  %mo ×
                  %mi 𝒳
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi 𝒴
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Plt\big(
                  \\Delta^n
                  ,\,
                  Map(\mathcal{X},\mathcal{Y})
                  \\big)
                  \\;\coloneqq\;
                  Hom\big(
                  \\Delta^n
                  \\times
                  \\mathcal{X}
                  ,\,
                  \\mathcal{Y}
                  \\big)
                  \\,,
          %p
            hence whose 0-simplices are the plain maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                  %mo →
                  %mi 𝒴
                %annotation{:encoding => "application/x-tex"} \mathcal{X} \to \mathcal{Y}
            and whose 1-simplices are
            %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
            between such maps.
          #eq:HomotopyEquivalenceOfSimplicialSets.maruku-equation
            %span.maruku-eq-number (35)
            %code.maruku-mathml
          .float_right_image{:style => "margin: -40px 0px 20px 10px"}
            %img{:src => "/nlab/files/GeomPhys-HomotopyEquivalence.jpg", :width => "400px"}/
          %p
            Hence a
            %em homotopy equivalence
            between
            %a.existingWikiWord{:href => "/nlab/show/infinity-groupoids"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-groupoids
            consiste of maps back and forth which are inverses
            %em up to homotopy
            (in that there exist homotopies
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ′
                %annotation{:encoding => "application/x-tex"} g'
            as shown).
          %blockquote
            %p
              (Beware that if one works with all simplicial sets instead of just the
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan-simplicial sets
              among them, as often done in the literature, then the relevant notion of equivalence is instead “
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"}> weak homotopy equivalence
              ”.)
          .float_right_image{:style => "margin: -40px 0px 20px 10px"}
            %img{:src => "/nlab/files/GeomPhys-GeometricSimplices.jpg", :width => "500px"}/
          %p
            As a more concrete class of examples: A
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            gives rise to an
            %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-groupoid
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi SimpSet
                      %mi Kan
                  %annotation{:encoding => "application/x-tex"} \esh X \,\in\, SimpSet_{Kan}
            %em
              %a.existingWikiWord{:href => "/nlab/show/path+infinity-groupoid"} path infinity-groupoid
            whose
            %a.existingWikiWord{:href => "/nlab/show/n-morphism"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              \-morphisms
            are the
            %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous
            images of the
            %em geometric
            = succeed "-simplices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Δ
                    %mi geo
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Delta^n_{geo}
            in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          #eq:SimplicialShape.maruku-equation
            %span.maruku-eq-number (36)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mi Plot
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi Δ
                          %mi n
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                        %mi X
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mtr
                      %mtd
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Hom
                          %mi Top
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %munder
                            %mrow
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                              %mover
                                %mi x
                                %mo{:stretchy => "false"} →
                              %mo ∈
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi ℝ
                                %mrow
                                  %mo ≥
                                  %mn 0
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %msup
                                    %mo ×
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                              %mspace{:width => "thinmathspace"}
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                              %mspace{:width => "thinmathspace"}
                              %mstyle{:displaystyle => "false"}
                                %msub
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                  %mi i
                                %msup
                                  %mi x
                                  %mi i
                                %mo =
                                %mn 1
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                            %mo ⏟
                          %mrow
                            %msubsup
                              %mi Δ
                              %mi geo
                              %mi n
                            %mphantom
                              %mrow
                                %msup
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %msup
                                      %mo{:stretchy => "false"} |
                                      %mo{:stretchy => "false"} |
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi X
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{l}
                  Plot\big(
                  \\Delta^n
                  ,\,
                  \\esh
                  X
                  \\big)
                  \\\
                  \\;\coloneqq\;
                  Hom_{Top}\Big(
                  \\;
                  \\underset{
                  \\Delta^n_{geo}
                  \\phantom{
                  \\vert^{\vert^{\vert}}
                  }
                  }{
                  \\underbrace{
                  \\big\{
                  \\vec x \in (\mathbb{R}_{\geq 0})^{\times^{n+1}}
                  \\,\big\vert\,
                  \\textstyle{\sum}_i x^i = 1
                  \\big\}
                  }
                  }
                  \\,
                  ,\,
                  X
                  \\Big)
                  \\,.
                  \\end{array}
          %p
            %br/
          #eq:HomeoToHomotopyType.maruku-equation
            %span.maruku-eq-number (37)
            %code.maruku-mathml
          .float_right_image{:style => "margin: -30px 0px 0px 15px"}
            %img{:src => "/nlab/files/GeomPhys-HomotopyType.jpg", :width => "300px"}/
          %p
            This
            = succeed "-construction" do
              %a.existingWikiWord{:href => "/nlab/show/path+infinity-groupoid"}
                path
                = succeed "-groupoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (the “
            %a.existingWikiWord{:href => "/nlab/show/cohesion"}> cohesion
            ” of its points as embodied by its system of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            %em
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \esh X
            under
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:HomotopyEquivalenceOfSimplicialSets"} (35)
            %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} classical fact
            of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            asserts (in particular) that every
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi SimpSet
                    %mi Kan
                %annotation{:encoding => "application/x-tex"} SimpSet_{Kan}
            is equivalently the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape
            %a.existingWikiWord{:href => "/nlab/show/path+infinity-groupoid"}
              path
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            of some topological space, which traditionally leads to some conflation of these different notion of “space”.
          %p
            Here we shall denote actual homotopy types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi SimpSet
                    %mi Kan
                %annotation{:encoding => "application/x-tex"} \mathcal{X} \,\in\, SimpSet_{Kan}
            by calligraphic symbols. In particular, it is homotopy types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            which determine flux quantization laws
            = succeed ":" do
              %a{:href => "#FluxQuantizationLawsAsNonabelianCohomology"} above
          %p
            The plain (as opposed to
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
            (
            %a{:href => "#NonabelianCohomology"}> above
            ) of a topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is an invariant of its
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/shape"} shape
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \esh X
            %a.maruku-eqref{:href => "#eq:SimplicialShape"} (36)
            formed by the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+mapping+complex"} simplicial mapping complex
            = succeed ":" do
              %a.maruku-eqref{:href => "#eq:MappingComplex"} (34)
          #eq:NonabelianCohomologyViaSimplicialMappings.maruku-equation
            %span.maruku-eq-number (38)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi 𝒜
                          %mspace{:width => "thinmathspace"}
                          %mo ∈
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi SimpSet
                            %mi Kan
                      %mtr
                        %mtd
                          %mi X
                          %mspace{:width => "thinmathspace"}
                          %mo ∈
                          %mspace{:width => "thinmathspace"}
                          %mi Top
                    %mspace{:width => "thickmathspace"}
                    %mo }
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi H
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi π
                    %mn 0
                  %mi Map
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                  %mi X
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi 𝒜
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\left.
                  \\begin{array}{l}
                  \\mathcal{A}
                  \\,\in\,
                  SimpSet_{Kan}
                  \\\
                  X \,\in\, Top
                  \\end{array}
                  \\;
                  \\right\}
                  \\;\;\;\;\;\;\;
                  \\vdash
                  \\;\;\;\;\;\;\;
                  H^1(X;\, \mathcal{A})
                  \\;\;
                  \\simeq
                  \\;\;
                  \\pi_0 Map\big(
                  \\esh X
                  ,\,
                  \\mathcal{A}
                  \\big)
                  \\,,
          %p
            where on the right
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_0(-)
            refers to the connected components of an
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi SimpSet
                    %mi Kan
                %annotation{:encoding => "application/x-tex"} \mathcal{X} \,\in\, SimpSet_{Kan}
            being the
            %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
            of the 0-simplices by the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            embodied by the 1-simplices:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mi 𝒳
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝒳
                      %mn 0
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} /
                    %msub
                      %mi 𝒳
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0
                    \\mathcal{X}
                    \\;\coloneqq\;
                    \\mathcal{X}_0\big/\mathcal{X}_1
          %p
            While above we saw that any cohomology class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi χ
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi H
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi 𝒜
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} [\chi] \,\in\, H^1\big(X;\, \mathcal{A}\big)
            may be understood as the
            %em total charge
            sourcing
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔩
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathfrak{l}\mathcal{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                  %mi X
                  %mo →
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \esh X \to \mathcal{A}
            as witnessing the
            = succeed "," do
              %em local charge
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi 𝔩
                  %mi 𝒜
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} H^1\big(X;\, \mathfrak{l}\mathcal{A}\big)
            but an actual locally defined flux density
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec B
          %p
            %br/
          %p
            %strong Smooth simplicial sets of deformations of flux densities.
            With the above discussion one has moduli for
          %ol
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/flux+densities"} flux densities
                with their
                %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometric
                nature, in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/SmoothSet"} SmoothSet
            %li
              %p
                local charges with their
                %a.existingWikiWord{:href => "/nlab/show/higher+gauge+theory"} higher gauge theoretic
                nature, in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/SimpSet"} SimpSet
          %p
            In order to discuss moduli for the full flux-quantized fields, one need to combine these two aspects into a category of
            %em smooth simplicial sets
            (smooth Kan-simplicial sets, to be precise).
          %p
            It is clear that these should be presheaves on
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            with values in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan-simplicial sets
            %em combined
            notion of equivalence:
            %em local
            equivalences as for
            %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            %a.maruku-eqref{:href => "#eq:SmoothSetsByLocalization"} (30)
            and
            %em homomotopy
            equivalences as for
            %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-groupoids
            = succeed ":" do
              %a.maruku-eqref{:href => "#eq:HomotopyEquivalenceOfSimplicialSets"} (35)
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                  %mo ,
                  %mi 𝒴
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi PSh
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi CartSp
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi SimpSet
                    %mi Kan
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{X}, \mathcal{Y} \,\in\, PSh\big(CartSp,\, SimpSet_{Kan}\big)
            a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi 𝒳
                  %mo →
                  %mi 𝒴
                %annotation{:encoding => "application/x-tex"} f \,\colon\, \mathcal{X} \to \mathcal{Y}
            is a
            %strong local homotopy equivalence
            (lheq) if it is a morphism that restricts to a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
            %a.maruku-eqref{:href => "#eq:HomotopyEquivalenceOfSimplicialSets"} (35)
            on all
            %a.existingWikiWord{:href => "/nlab/show/germs"} germs
            of plots, hence on all simplicial
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stalks"} stalks
          %p
            To regard these local homotopy equivalences as the actual equivalences of smooth simplicial sets means to pass to the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
            of the category of smooth simplicial sets at the local homotopy equivalences, to be denoted:
          #eq:SmoothInfinityGroupoids.maruku-equation
            %span.maruku-eq-number (39)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi SmthGrpd
                    %mn ∞
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mrow
                      %mspace{:width => "negativethinmathspace"}
                      %mi lheq
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi SmoothSimpSet
                    %mi Kan
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mrow
                      %mspace{:width => "negativethinmathspace"}
                      %mi lheq
                  %mspace{:width => "thinmathspace"}
                  %mi PSh
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi CartSp
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi SimpSet
                    %mi Kan
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  SmthGrpd_\infty
                  \\;\coloneqq\;
                  \\mathbf{L}^{\!lheq}
                  \\,
                  SmoothSimpSet_{Kan}
                  \\;\coloneqq\;
                  \\mathbf{L}^{\!lheq}
                  \\,
                  PSh\big(
                  CartSp
                  ,\,
                  SimpSet_{Kan}
                  \\big)
          %p
            and referred to as the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-topos
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"}
                  smooth
                  = succeed "-groupoids" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
          %p
            It is clear that, both,
            %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            as well as plain
            %a.existingWikiWord{:href => "/nlab/show/infinity-groupoids"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-groupoids
            are jointly contained in this larger category, the former as the objects which are constant on
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
            (the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/truncated+object+of+an+%28infinity%2C1%29-category"} 0-truncated objects
            %a.existingWikiWord{:href => "/nlab/show/CartSp"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} CartSp
            (the geometrically
            %a.existingWikiWord{:href => "/nlab/show/discrete+object"} discrete
            objects). This allows to put both flux densities as well as the (homotopy types of) charge classifying spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            on the same footing and hence relate them to each other fur the purpose of flux quantization, as previewed in the following diagrsm:
          %div{:style => "margin: -30px 0px 20px 0px"}
            %img{:src => "/nlab/files/GeomPhys-SmoothInfinityGroupoids-240207.jpg", :width => "600px"}/
          .float_right_image{:style => "margin: -30px 0px 20px 15px"}
            %img{:src => "/nlab/files/GeomPhys-CechGroupoid.jpg", :width => "520px"}/
          %p
            As an example of a local homotopy equivalence of smooth simplicial sets, consider a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi d
                %annotation{:encoding => "application/x-tex"} X^d
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %msup
                    %mi ℝ
                    %mi d
                  %mo ≃
                  %msub
                    %mi U
                    %mi j
                  %mover
                    %mo ↪
                    %mrow
                      %msub
                        %mi ι
                        %mi j
                  %mi X
                  %msub
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mrow
                      %mi j
                      %mo ∈
                      %mi J
                %annotation{:encoding => "application/x-tex"} \big\{\mathbb{R}^d \simeq U_j \xhookrightarrow{ \iota_j } X \big\}_{j \in J}
            a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
            %strong
              %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+groupoid"} Čech groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi X
                    %mo ^
                  %msup
                    %mrow
                    %mi d
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi SmoothSimpSet
