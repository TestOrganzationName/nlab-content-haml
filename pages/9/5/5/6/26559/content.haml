                  \\right\}
                  \\,.
          %p
            Hence the admissible flux quantization laws have classifying spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            whose
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+algebra"} Sullivan algebra
            looks as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔩
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi h
                    %mn 3
                  %mo ,
                  %msub
                    %mi h
                    %mn 7
                  %mo ,
                  %msub
                    %mi f
                    %mrow
                      %mn 2
                      %mo •
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} /
                  %mrow
                    %mo (
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi h
                            %mn 3
                          %mspace{:width => "thinmathspace"}
                          %mo =
                          %mspace{:width => "thinmathspace"}
                          %mn 0
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi f
                            %mrow
                              %mn 2
                              %mo •
                          %mspace{:width => "thinmathspace"}
                          %mo =
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi h
                            %mn 3
                          %mo ∧
                          %msub
                            %mi f
                            %mrow
                              %mn 2
                              %mo •
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 2
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  CE(\mathfrak{l}\mathcal{A})
                  \\;=\;
                  \\mathbb{R}[h_3, h_7, f_{2\bullet}]
                  \\Big/
                  \\left(
                  \\begin{array}{l}
                  \\mathrm{d}\, h_3 \,=\, 0
                  \\\
                  \\mathrm{d}\, f_{2\bullet}
                  \\,=\,
                  h_3 \wedge f_{2\bullet -2}
                  \\end{array}
                  \\right)
                  \\,.
          %p
            Now it so happens that a space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            with this property is given &amp;lbrack;
            %a{:href => "#FreedHopkinsTeleman07"}> Freed, Hopkins &amp; Teleman 2007, p. 6
            ;
            = succeed "&rbrack;" do
              %a{:href => "#BMSS19"} BMSS19, Lem. 2.31
            %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
            of the classifying space
            %a.existingWikiWord{:href => "/nlab/show/KU"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi KU
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} KU_0
            for
            %a.existingWikiWord{:href => "/nlab/show/complex+topological+K-theory"} complex topological K-theory
            in degree=0 by the
            %a.existingWikiWord{:href => "/nlab/show/group+action"} action
            of the
            %a.existingWikiWord{:href => "/nlab/show/projective+unitary+group"} projective unitary group
            %a.existingWikiWord{:href => "/nlab/show/PU%28H%29"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PU
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PU(\mathscr{H})
            on the essentially unique
            %a.existingWikiWord{:href => "/nlab/show/separable+Hilbert+space"} separably infinite-dimensional
            %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℋ
                  %annotation{:encoding => "application/x-tex"} \mathscr{H}
          #eq:ClassifyingSpaceForTwistedKTheory.maruku-equation
            %span.maruku-eq-number (44)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi KU
                    %mn 0
                  %mo ↪
                  %mover
                    %mover
                      %mrow
                        %msub
                          %mi KU
                          %mn 0
                        %mo ⫽
                        %mi PU
                        %mo{:stretchy => "false"} (
                        %mi.mathscript ℋ
                        %mo{:stretchy => "false"} )
                      %mo ⏞
                    %mi 𝒜
                  %mo ↠
                  %mi B
                  %mi PU
                  %mo{:stretchy => "false"} (
                  %mi.mathscript ℋ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  KU_0
                  \\hookrightarrow
                  \\overset{
                  \\mathcal{A}
                  }{
                  \\overbrace{
                  KU_0 \sslash PU(\mathscr{H})
                  }
                  }
                  \\twoheadrightarrow
                  B PU(\mathscr{H})
                  \\,,
          %p
            which we are displaying here in its canonical
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            exhibiting it as a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi KU
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} KU_0
            %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi PU
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ≃
                      %mi whe
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi B
                      %mn 3
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} B PU(\mathscr{H}) \;\underset{whe}{\simeq}\; B^3 \mathbb{Z}
          %blockquote
            %p
              To make this result plausible, notice first that one presentation for the K-theory classifying space is
              %a.existingWikiWord{:href => "/nlab/show/KU"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi KU
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} KU_0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≃
                      %mi ℤ
                      %mo ×
                      %mi B
                      %mi{:mathvariant => "normal"} U
                    %annotation{:encoding => "application/x-tex"} \simeq \mathbb{Z} \times B \mathrm{U}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi{:mathvariant => "normal"} U
                    %mo ≔
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi n
                    %mi B
                    %mi{:mathvariant => "normal"} U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B\mathrm{U} \coloneqq \underset{\longrightarrow}{lim}_n B\mathrm{U}(n)
              is the
              %a.existingWikiWord{:href => "/nlab/show/direct+limit"} direct limit
              over the ordinary
              %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unitary+groups"} unitary groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi KU
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} KU_0
              has one generator in every even degree. Second, notice that
              %em another
              presentation of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi KU
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} KU_0
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              %a.existingWikiWord{:href => "/nlab/show/Fredholm+operators"} Fredholm operators
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi.mathscript ℋ
                    %annotation{:encoding => "application/x-tex"} \mathscr{H}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} U
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{U}(\mathscr{H})
              manifestly
              %a.existingWikiWord{:href => "/nlab/show/group+action"} acts
              by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
              %a.existingWikiWord{:href => "/nlab/show/PU%28H%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PU
                      %mo{:stretchy => "false"} (
                      %mi.mathscript ℋ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PU(\mathscr{H})
              by the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/circle+group"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathrm{U}(1)
              %a.existingWikiWord{:href => "/nlab/show/center+of+a+group"} center
              still acts
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/effective+group+action"} effectively
              %a.existingWikiWord{:href => "/nlab/show/PU%28H%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PU
                      %mo{:stretchy => "false"} (
                      %mi.mathscript ℋ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PU(\mathscr{H})
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ≃
                        %mi whe
                      %mi B
                      %mi{:mathvariant => "normal"} U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mi B
                        %mn 2
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \underset{whe}{\simeq} B \mathrm{U}(1) \simeq B^2 \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi PU
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi B
                      %mn 3
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} B PU(\mathscr{H})  \simeq B^3 \mathbb{Z}
              has as Sullivan model a single closed generator in degree 3.
          .float_right_image{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/GeomPhys-TwistedKtheory.jpg", :width => "290px"}/
          %p
            Accordingly, the generalized
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology+theory"} nonabelian cohomology theory
            classified by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mspace{:width => "thinmathspace"}
                  %mo ≡
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi KU
                    %mn 0
                  %mo ⫽
                  %mi PU
                  %mo{:stretchy => "false"} (
                  %mi.mathscript ℋ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{A} \,\equiv\, KU_0 \sslash PU(\mathscr{H})
            decomposes over the
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary
            %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
            in degree 3, with fibers being the
            %em abelian
            %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology"} Whitehead-generalized cohomology
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            %em
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted
            cohomology theory:
            %em
              %a.existingWikiWord{:href => "/nlab/show/twisted+topological+K-theory"} twisted topological K-theory
            \&amp;lbrack;
            %a{:href => "#AtiyahSegal04"}> Atiyah &amp; Segal 2004, Def. 3.3
            ;
            = succeed ";" do
              %a{:href => "#FreedHopkinsTeleman07"} Freed, Hopkins &amp; Teleman 2007, (2.6)
            = succeed ";" do
              %a{:href => "#SS21-Bun"} SS21-Bun, Ex. 4.5.4
            = succeed "&rbrack;." do
              %a{:href => "#FSS23Char"} FSS23-Char, Ex. 3.4
            %a.maruku-eqref{:href => "#eq:ClassifyingSpaceForTwistedKTheory"} (44)
            is &amp;lbrack;
            %a{:href => "#FSS23Char"}> FSS23-Char, Prop. 10.1
            \&amp;rbrack; the
            %a.existingWikiWord{:href => "/nlab/show/twisted+Chern+character"} twisted
            %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
            (the archetypical example which gives its name to the more general “character map”).
          %p
            Therefore, choosing
            %a.maruku-eqref{:href => "#eq:ClassifyingSpaceForTwistedKTheory"} (44)
            as the flux quantization law for the unbounded RR-fields means to hypothesize/declare that
            %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
            flux and hence
            %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            charge is quantized in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/twisted+topological+K-theory"} twisted topological K-theory
            = succeed "-classes" do
              %a.existingWikiWord{:href => "/nlab/show/twisted+de+Rham+cohomology"} twisted de Rham cohomology
            %a.existingWikiWord{:href => "/nlab/show/twisted+Chern+character"} twisted
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
            %em
              %a.existingWikiWord{:href => "/nlab/show/D-brane+charge+quantization+in+topological+K-theory"} Hypothesis K
            (our terminology) originally due to
            = succeed ";" do
              %a{:href => "#MinasianMoore97"} Minasian &amp; Moore 1997
            = succeed "," do
              %a{:href => "#Witten98"} Witten 1998
            = succeed ";" do
              %a{:href => "#FreedHopkins00"} Freed &amp; Hopkins 2000
            %a{:href => "#BouwknegtMathai01"} Bouwknegt &amp; Mathai 2001
            and others.
          %p
          .num_remark
            %h6 Remark
            %p
              %strong (comparison to the literature)
              %br/
              The original motivation close to the above logic via the character map may be found in
              = succeed "," do
                %a{:href => "#Witten98"} Witten 1998
            %p
              When comparing to
              %a{:href => "#MinasianMoore97"} Minasian &amp; Moore 1997
              beware that these authors, and the literature following them, take the
              = succeed "-rational" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
              %em multiplied
              with the square root of the
              %a.existingWikiWord{:href => "/nlab/show/A-hat+genus"} A-hat genus
              of the
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              = succeed ");" do
                %a{:href => "#FreedHopkins00"} Freed &amp; Hopkins 2000, ftn. 12
              %a.existingWikiWord{:href => "/nlab/show/push-forward+in+generalized+cohomology"} push-forward
              \&amp;lbrack;
              %a{:href => "#BrodzkiMathaiRosenbergSzabo08"}> Brodzki, Mathai, Rosenberg &amp; Szabo 2008, §2
              \&amp;rbrack;.
          .float_right_image{:style => "margin: -30px 0px 5px 10px"}
            %img{:src => "/nlab/files/GeomPhys-DBraneAnnihilation-240210.jpg", :width => "340px"}/
          %p
            An influential argument why
            %em
              %a.existingWikiWord{:href => "/nlab/show/D-brane+charge+quantization+in+K-theory"} Hypothesis K
            %a.maruku-eqref{:href => "#eq:ClassifyingSpaceForTwistedKTheory"} (44)
            should be singled out among other compatible choices of RR-field flux quantization was the observation by
            %a{:href => "#Witten98"} Witten 1998, §3
            that the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            on
            %a.existingWikiWord{:href => "/nlab/show/virtual+vector+bundles"} virtual vector bundles
            which characterizes
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi KU
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} KU_0(X)
            on
            %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
            (see
            = succeed ")" do
              %a{:href => "topological+K-theory#KGroupByGrothendieckGroup"} there
            = succeed "\u201D)" do
              %a.existingWikiWord{:href => "/nlab/show/Sen%27s+conjecture"} Sen's conjecture
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            = succeed "-annihilation" do
              %a.existingWikiWord{:href => "/nlab/show/anti+D-brane"} anti D-brane
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tachyon+condensation"} tachyon condensation
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            but opposite
            %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+bundles"} Chan-Paton bundles
            on the
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            of
            %a.existingWikiWord{:href => "/nlab/show/coincident+brane"} coincident
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            should mutually annihilate.
          %p
            Beware that this is a heuristic argument: There is no string-theoretic computation which actually verifies this intuition &amp;lbrack;cf. commentary by
            = succeed "," do
              %a{:href => "D-brane+charge+quantization+in+K-theory#Erler13"} Erler 2013
            = succeed "&rbrack;." do
              %a{:href => "https://arxiv.org/pdf/1308.4400.pdf#page=33"} p. 32
            %a{:href => "#Witten98"} Witten 1998, ftn. 2
            already points out that on closer inspection it is less clear how the picture should work.
          %p
            This seems noteworthy in view of the fact that the starting point
            %a.maruku-eqref{:href => "#eq:SolutionSpaceForUnboundedRRRecalled"} (43)
            of
            %em Hypothesis K
            is a little shaky (as discussed after Ex.
            = succeed "):" do
              %a.maruku-ref{:href => "#MotionOfCoupledBRRFields"}
            %em Hypothesis K
            will have to receive corrections. This motivates having a closer look at the flux quantization of the M-theoretic avatar of the RR-fields: The C-field.
          %p
            %br/
          %h3#CFieldFluxQuantizationIn10d C-Field flux quantization in 11d
          %p
            Recalling the
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} C-field
            %a.existingWikiWord{:href => "/nlab/show/Gauss+law"} Gauss law
            (Ex.
            = succeed "," do
              %a.maruku-ref{:href => "#MotionOfSupergravityCField"}
            = succeed "):" do
              %a.maruku-ref{:href => "#SolutionSpaceViaGaussLaw"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SolSpace
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo {
                    %mspace{:width => "thickmathspace"}
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mi B
                            %mn 4
                          %mspace{:width => "thinmathspace"}
                          %mo ∈
                          %mspace{:width => "thinmathspace"}
                          %msubsup
                            %mi Ω
                            %mi dR
                            %mn 4
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi X
                            %mn 10
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msub
                            %mi B
                            %mn 7
                          %mspace{:width => "thinmathspace"}
                          %mo ∈
                          %mspace{:width => "thinmathspace"}
                          %msubsup
                            %mi Ω
                            %mi dR
                            %mn 7
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi X
                            %mn 10
                          %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext s.t.
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtable{:columnalign => "right center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi B
                            %mn 4
                        %mtd
                          %mo =
                        %mtd
                          %mn 0
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi B
                            %mn 7
                        %mtd
                          %mo =
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %msub
                            %mi B
                            %mn 4
                          %mo ∧
                          %msub
                            %mi B
                            %mn 4
                    %mspace{:width => "thickmathspace"}
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  SolSpace
                  \\;=\;
                  \\left\{
                  \\;
                  \\begin{array}{l}
                  B_4 \,\in\, \Omega^4_{dR}(X^{10})
                  \\\
                  B_7 \,\in\, \Omega^7_{dR}(X^{10})
                  \\end{array}
                  \\;\;\;
                  \\text{s.t.}
                  \\;\;\;
                  \\begin{array}{rcl}
                  \\mathrm{d}
                  \\,
                  B_4 &amp;=&amp; 0
                  \\\
                  \\mathrm{d}
                  \\,
                  B_7 &amp;=&amp;
                  \-\tfrac{1}{2}
                  B_4 \wedge B_4
                  \\end{array}
                  \\;
                  \\right\}
          %p
            its admissible flux quantization laws have a classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            whose
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+algebra"} Sullivan algebra
            is as follows
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔩
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi ℝ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %msub
                    %mi b
                    %mn 4
                  %mo ,
                  %msub
                    %mi b
                    %mn 7
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} /
                  %mrow
                    %mo (
                    %mtable{:columnalign => "right center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi b
                            %mn 4
                        %mtd
                          %mo =
                        %mtd
                          %mn 0
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi b
                            %mn 7
                        %mtd
                          %mo =
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %msub
                            %mi b
                            %mn 4
                          %mo ∧
                          %msub
                            %mi b
                            %mn 4
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  CE(\mathfrak{l}\mathcal{A})
                  \\;\;
                  \=
                  \\;\;
                  \\mathbb{R}\big[
                  b_4, b_7
                  \\big]
                  \\Big/
                  \\left(
                  \\begin{array}{rcl}
                  \\mathrm{d}
                  \\,
                  b_4 &amp;=&amp; 0
                  \\\
                  \\mathrm{d}
                  \\,
                  b_7 &amp;=&amp;
                  \-\tfrac{1}{2}
                  b_4 \wedge b_4
                  \\end{array}
                  \\right)
                  \\,.
          %p
            We discuss now two possible choices of such flux quantization laws
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            for the C-field that have been considered in the literature (here we denote them by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒜
                    %mrow
                      %msub
                        %mrow
                        %mi DFM
                %annotation{:encoding => "application/x-tex"} \mathcal{A}_{{}_{DFM}}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒜
                      %mrow
                        %msub
                          %mrow
                          %mi FSS
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}_{{}_{FSS}}
          %p
            Recall again that, besides these “evident” choices, there are an infinitude of admissible variant flux quantization laws which differ in their torsion-content. In the present case, any such choice is a hypothesis/definition concerning aspects of the elusive
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            remains missing), but also to understand how variant flux quantization laws would have to be chosen if the “evident” ones are deemed to have undesireable implications.
          %p
            %br/
          %p
            %strong DFM flux-quantization.
          %p
            If one takes the point of view that a higher
            = succeed "-flux" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{U}(1)
            %a.maruku-ref{:href => "#HigherCircleGaugePotentials"}
            is the most natural starting point, which naively would demand
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 4
                %annotation{:encoding => "application/x-tex"} G_4
            to be quantized in integral 4-cohomology with classifying space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mn 4
                    %mi ℤ
                    %mo ≡
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B^4 \mathbb{Z} \equiv K(\mathbb{Z}, 4)
            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup-square
            of this 4-class be trivialized in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational cohomology
          .float_right_image{:style => "margin: -30px 0px -5px 10px"}
            %img{:src => "/nlab/files/GeomPhys-CupSquareClassifying-240210.jpg", :width => "460px"}/
          %p
            In terms of
            %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
            this means to pass to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒜
                      %mrow
                        %msub
                          %mrow
                          %mi DFM
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}_{{}_{DFM}}
            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup-square
            %a.existingWikiWord{:href => "/nlab/show/cohomology+operation"} cohomology operation
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral 4-cohomology
            = succeed "):" do
              %a{:href => "#FSS23"} FSS23-Char, §1, §5
          #eq:HomotopyFiberOfCupSquare.maruku-equation
            %span.maruku-eq-number (45)
            %code.maruku-mathml
          %div{:style => "margin: -20px 0px 20px 10px"}
            %img{:src => "/nlab/files/GeomPhys-TheDFMModel-240210.jpg", :width => "800px"}/
          %p
            This flux quantization law is essentially that considered in
            = succeed "," do
              %a{:href => "#DiaconescuFreedMoore03"} Diaconescu, Freed &amp; Moore 2003
            %a.existingWikiWord{:href => "/nlab/show/first+fractional+Pontrjagin+class"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} [
                    %mi T
                    %msup
                      %mi X
                      %mi d
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \tfrac{1}{2}p_1[T X^d]
            is
            %a.existingWikiWord{:href => "/nlab/show/even+number"} even
            (the desired half-integral shift by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} \tfrac{1}{2}\big(\tfrac{1}{2}p_1\big)
            is essentially added “by hand” by these authors and thus falls out of the systematics of flux quantization as discussed here).
          %p
            While this DFM-model manifestly enforces quantization of charges of singular
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/M5-branes"} M5-branes
            %a.existingWikiWord{:href => "/nlab/show/M2-branes"} M2-branes
            (“
            %a.existingWikiWord{:href => "/nlab/show/Page+charge"}> Page charge
            ”) would be quantized in this model (but see the claim by
            = succeed ")." do
              %a{:href => "#Moore04"} Moore 2004, §5
          %p
            %br/
          %p
            %strong FSS flux-quantization.
          %p
            Another perspective is to regard the baseline of all flux quantization to be that classified by the
            %em point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒜
                    %mn 0
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} \mathcal{A}_0 = \ast
            (for the entirely trivial higher gauge theory) and to obtain non-trivial classifying spaces from this maximally unbiased starting point by iterated
            %a.existingWikiWord{:href => "/nlab/show/cell+attachment"} cell attachment
            in the sense of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
          %p
            The
            %em minimal
            choice of C-field flux quantization in this sense, requiring the minimum number 1 of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cell+attachments"} cell attachments
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒜
                    %mrow
                      %msub
                        %mrow
                        %mi FSS
                  %mspace{:width => "thinmathspace"}
                  %mo ≡
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi S
                    %mn 4
                %annotation{:encoding => "application/x-tex"} \mathcal{A}_{{}_{FSS}} \,\equiv\, S^4
            to be the (
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of) the
            %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
            (which is a valid choice of C-field flux quantization, by the examples explained
            = succeed ")." do
              %a{:href => "#TotalFluxInNonabelianDeRhamCohomology"} above
          %p
            Since the generalized
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology+theory"} nonabelian cohomology theory
            classified by the (
            %span.newWikiWord
              homotop types
              %a{:href => "/nlab/new/homotop+types"} ?
            of)
            %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
            is known as
            %em
              %a.existingWikiWord{:href => "/nlab/show/Cohomotopy"} Cohomotopy
            (being the
            %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
            to the “nonabelian homology theory” given by forming
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
          %p (…)
          %p
            %br/
          %h3#BFieldFluxQuantizationIn6d B-Field flux quantization in 6d
          %p (…)
          %p
            %br/
          %h3#BFieldFluxQuantizationIn6d Green-Schwarz mechanicm in 10d &amp; 6d
          %p (…)
          %p
            %br/
          %h2#references References
          %ul
            %li#Abrikosov57a
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexei+Abrikosov"}> Alexei Abrikosov
                ,
                = succeed "," do
                  %em On the Magnetic properties of superconductors of the second group
                %strong 5
                (1957) 1174-1182; Zh. Eksp. Teor. Fiz.
