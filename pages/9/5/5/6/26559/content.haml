                    %mi n
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{R}^n
                  \\;\mapsto\;
                  Plots\big(
                  \\mathbb{R}^n
                  ,\,
                  X
                  \\big)
          %p
            of
            %em plotting out
            probe spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            inside the would-be space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant functor
            to
            %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
            (a “
            %a.existingWikiWord{:href => "/nlab/show/presheaf"}> presheaf
            ”)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Plots
