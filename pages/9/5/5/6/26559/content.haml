            of any charge quantization law is
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+type"} rationally
            characterized by its
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+L-infinity+algebra"}
              Whitehead
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔩
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathfrak{l}\mathcal{A}
            (essentially the “Quillen model” of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
