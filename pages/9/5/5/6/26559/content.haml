              and Ex.
              = succeed "," do
                %a.maruku-ref{:href => "#MotionOfSupergravityCField"}
          %p More generally:
          %p
          #AbelianWhiteheadGeneralizedDiffCohomology.num_remark
            %h6 Example
            %p
              %strong
                (abelian
                %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology"} Whitehead-generalized
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
