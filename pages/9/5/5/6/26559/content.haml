            %strong Total flux in non-abelian de Rham cohomology.
            While, with Prop.
            = succeed "," do
              %a.maruku-ref{:href => "#SolutionsAsFlatForms"}
            %a.existingWikiWord{:href => "/nlab/show/Gauss+law"} Gauss law
            of the given
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+theory"} higher gauge theory
            of Maxwell-type constrains the
            %a.existingWikiWord{:href => "/nlab/show/flux+densities"} flux densities
            on any
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi d
                  %mo ↪
                  %msup
                    %mi X
                    %mi D
                %annotation{:encoding => "application/x-tex"} X^d \hookrightarrow X^D
            to constitute a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/flat+L-infinity-algebra+valued+differential+form"}
                flat
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
          %p
            We should, therefore, regard as the
            %em total flux
            that aspect of the
            %a.existingWikiWord{:href => "/nlab/show/flux+densities"} flux densities
            which is
            %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            under choice of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+surfaces"} Cauchy surfaces
          %p
            But since the
            %a.existingWikiWord{:href => "/nlab/show/Gauss+law"} Gauss law
            is (by Prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#SolutionSpaceViaGaussLaw"}
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} restriction
            to the Cauchy surface of the
            %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
            (on the duality-symmetric flux densities of Def.
            = succeed ")," do
              %a.maruku-ref{:href => "#HigherMaxwellEquations"}
            %a.maruku-ref{:href => "#SolutionsAsFlatForms"}
            shows that this invariant aspect is the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
            of flux densities under
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/concordance"} concordance
          #eq:ConcordanceOfFlatDifferentialForms.maruku-equation
            %span.maruku-eq-number (20)
            %code.maruku-mathml
          %div{:style => "margin: -20px 0px 20px 10px"}
            %img{:src => "/nlab/files/GeomPhys-CauchyEvolutionOfGaussLawData-240204.jpg", :width => "760px"}/
          %p
          #NonabelianDeRhamCohomology.num_defn
            %h6 Definition
            %p
              (
              %strong
                %a.existingWikiWord{:href => "/nlab/show/non-abelian+de+Rham+cohomology"} non-abelian de Rham cohomology
              \&amp;lbrack;
              %a{:href => "#FSS23"}> FSS23-Char, Def. 6.3
              \&amp;rbrack;)
              %br/
              Given an
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
                \-algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              and a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi d
                    %annotation{:encoding => "application/x-tex"} X^d
              %a.existingWikiWord{:href => "/nlab/show/flat+L-infinity+algebra+valued+differential+forms"}
                closed
                = succeed "-valued" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔞
                      %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi B
                        %mo{:stretchy => "false"} →
                      %mn 0
                    %mo ,
                    %msub
                      %mover
                        %mi B
                        %mo{:stretchy => "false"} →
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi Ω
                      %mi dR
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi X
                      %mi d
                    %mo ;
                    %mi 𝔞
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi clsd
                  %annotation{:encoding => "application/x-tex"} \vec B_0, \vec B_1 \,\in\, \Omega^1_{dR}\big(X^d;\mathfrak{a}\big)_{clsd}
              %a.maruku-eqref{:href => "#eq:FlatLInfinityAlgebraValuedDifferentialForms"} (19)
              are
              %em cohomologous
              iff they are
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/concordance"} concordant
              %a.existingWikiWord{:href => "/nlab/show/flat+L-infinity+algebra+valued+differential+forms"}
                closed
                = succeed "-valued" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔞
                      %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec F
              on the
              %a.existingWikiWord{:href => "/nlab/show/cylinder"} cylinder
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi d
                  %annotation{:encoding => "application/x-tex"} X^d
              whose restriction (
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"}> pullback
              ) to the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi B
                          %mo{:stretchy => "false"} →
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \vec B_k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi B
                        %mo{:stretchy => "false"} →
                      %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo ∼
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mover
                        %mi B
                        %mo{:stretchy => "false"} →
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi Ω
                      %mi dR
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi X
                      %mi d
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi 𝔞
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi clsd
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext with
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi B
                                %mo{:stretchy => "false"} →
                              %mn 1
                            %mspace{:width => "thinmathspace"}
                            %mo =
                            %mspace{:width => "thinmathspace"}
                            %msubsup
                              %mi ι
                              %mn 1
                              %mo *
                            %mover
                              %mi F
                              %mo{:stretchy => "false"} →
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi B
                                %mo{:stretchy => "false"} →
                              %mn 0
                            %mspace{:width => "thinmathspace"}
                            %mo =
                            %mspace{:width => "thinmathspace"}
                            %msubsup
                              %mi ι
                              %mn 0
                              %mo *
                            %mover
                              %mi F
                              %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\vec B_0
                    \\;\sim\;
                    \\vec B_1
                    \\;\;\;\;\;\;
                    \\Leftrightarrow
                    \\;\;\;\;\;\;
                    \\exists
                    \\;\;
                    \\vec F
                    \\,\in\,
                    \\Omega^1_{dR}\big(
                    X^d \times [0,1]
                    ;\,
                    \\mathfrak{a}
                    \\big)_{clsd}
                    \\;\;\;
                    \\text{with}
                    \\;\;\;
                    \\left\{
                    \\begin{array}{l}
                    \\vec B_1 \,=\, \iota_1^\ast \vec F
                    \\\
                    \\vec B_0 \,=\, \iota_0^\ast \vec F
                    \\end{array}
                    \\right.
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
              by this
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              is
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              %em
                %a.existingWikiWord{:href => "/nlab/show/nonabelian+de+Rham+cohomology"} nonabelian de Rham cohomology
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi d
                    %annotation{:encoding => "application/x-tex"} X^d
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi dR
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi X
                      %mi d
                    %mo ;
                    %mi 𝔞
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi dR
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi X
                      %mi d
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi 𝔞
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi clsd
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} /
                    %mspace{:width => "negativethinmathspace"}
                    %mo ∼
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^1_{dR}\big(
                    X^d;\mathfrak{a}
                    \\big)
                    \\;\coloneqq\;
                    \\Omega^1_{dR}\big(
                    X^d
                    ;\,
                    \\mathfrak{a}
                    \\big)_{clsd}
                    \\Big/
                    \\!
                    \\sim
                    \\,.
            %p
          %p
          .num_remark
            %h6 Remark
            %p
              %strong (flux conservation)
              %br/
            .float_right_image{:style => "margin: -40px 20px 20px 20px"}
              %img{:src => "/nlab/files/GeomPhys-TotalFluxInNonabDeRhamCohom-240129.jpg", :width => "320px"}/
            %p
              Regarding the image of flux densities in non-abelian de Rham cohomology as expressing their
              %em total flux
              it follows immediately that:
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                  %annotation{:encoding => "application/x-tex"} \;\;\;\;\;
              %em Total flux is conserved under time evolution.
            %p
          %p
            %br/
          %p
          .num_remark
            %h6 Remark
            %p
              %strong (nonabelian de Rham cohomology as dg-homotopy classes)
              %br/
              For comparison to the flux quantization rules discussed
              %a{:href => "#FluxQuantizationLawsAsNonabelianCohomology"} below
              it is useful to understand this equivalently &amp;lbrack;
              %a{:href => "#FSS23"}> FSS23-Char, Thm. 6.5
              \&amp;rbrack; as the set of dg-homotopy classes of the corresponding dgc-homomorphisms:
            %div{:style => "margin: -30px 0px 20px 0px"}
              %img{:src => "/nlab/files/GeomPhys-NonabDeRhamAsHomotopyClasses-240129b.jpg", :width => "680px"}/
            %p
          %p
            %br/
          %p
          .num_remark
            %h6 Example
            %p
              (
              %a{:href => "#FSS23"}> FSS23-Char, Prop. 6.4
              )
              %br/
              In the case of ordinary electromagnetism and abelian higher gauge fields, hence for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                    %mo =
                    %msup
                      %mi b
                      %mi n
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a} = b^n \mathfrak{u}(1)
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/line+Lie+n-algebra"}
                  line Lie
                  = succeed "-algebra" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n+1)
              %a.maruku-ref{:href => "#NonabelianDeRhamCohomology"}
              reduces to the ordinary notions:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Ω
                          %mi dR
                          %mn 1
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi X
                          %mi d
                        %mo ;
                        %msup
                          %mi b
                          %mi n
                        %mi ℝ
                        %msub
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mi clsd
                        %mspace{:width => "thinmathspace"}
                        %mo ≃
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi Ω
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi X
                          %mi d
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi clsd
                      %annotation{:encoding => "application/x-tex"} \Omega^1_{dR}\big(X^d; b^n\mathbb{R}\big)_{clsd} \,\simeq\, \Omega^{n+1}(X^d)_{clsd}
                  are ordinary
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/closed+differential+forms"} closed differential forms
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/concordance"} concordance
                  between these is the
                  %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
                  relation in the ordinary
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi H
                          %mi dR
                          %mn 1
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi X
                          %mi d
                        %mo ;
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi b
                          %mi n
                        %mi ℝ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ≃
                        %mspace{:width => "thinmathspace"}
                        %msubsup
                          %mi H
                          %mi dR
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi X
                          %mi d
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} H^1_{dR}\big(X^d;\, b^n \mathbb{R}\big) \,\simeq\, H^{n+1}_{dR}\big(X^d\big)
                  is ordinary
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            %p
              and since the latter also gives the
              %a.existingWikiWord{:href => "/nlab/show/periods"} periods
              of closed differential forms, this recovers indeed the usual notion of total (integrated) flux.
            %p Concretely, with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi q
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mrow
                        %msup
                          %mi S
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi dR
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ⟶
                      %mrow
                        %msubsup
                          %mi p
                          %mrow
                            %msup
                              %mi S
                              %mn 2
                          %mo *
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi dR
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi ℝ
                      %mn 3
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi dR
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi ℝ
                      %mn 3
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi b
                    %mi ℝ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    F_2
                    \\;\coloneqq\;
                    q
                    \\mathrm{dvol}_{S^2}
                    \\;\in\;
                    \\Omega^2_{dR}\big(S^2\big)
                    \\;\overset{p^\ast_{S^2}}{\longrightarrow}\;
                    \\Omega^2_{dR}\big(\mathbb{R}^3 \setminus \{0\}\big)
                    \\;\simeq\;
                    \\Omega^1_{dR}\big(\mathbb{R}^3 \setminus \{0\}
                    ;\,
                    b\mathbb{R}
                    \\big)
            %p
              the flux density around a
              %a.existingWikiWord{:href => "/nlab/show/magnetic+monopole"} magnetic monopole
              of charge
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:MagneticMonopoleSchematics"} (1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi H
                              %mi dR
                              %mn 2
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi ℝ
                              %mn 3
                            %mo ∖
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo ≃
                          %mtd
                            %msubsup
                              %mi H
                              %mi dR
                              %mn 2
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi S
                              %mn 2
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo ≃
                          %mtd
                            %mi ℝ
                        %mtr
                          %mtd
                            %msub
                              %mi F
                              %mn 2
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                            %msub
                              %mi F
                              %mn 2
                            %mspace{:width => "thinmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mo ∫
                              %mrow
                                %msup
                                  %mi S
                                  %mn 2
                            %msub
                              %mi F
                              %mn 2
                            %mpadded{:width => "0"}
                              %mrow
                                %mo =
                                %mi q
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    H^2_{dR}\big(
                    \\mathbb{R}^3 \setminus \{0\}
                    \\big)
                    \&amp;\simeq&amp;
                    H^2_{dR}\big(
                    S^2
                    \\big)
                    \&amp;\simeq&amp;
                    \\mathbb{R}
                    \\\
                    F_2
                    \&amp;\mapsto&amp;
                    \\big[ F_2\,  \big]
                    \&amp;\mapsto&amp;
                    \\int_{S^2} F_2
                    \\mathrlap{
                    \= q
                    \\,.
                    }
                    }
            %p
          %p
            %br/
          %p
            With
            %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            flux densities thus understood as cocycles in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+de+Rham+cohomology"} nonabelian de Rham cohomology
            = succeed "-ful" do
              %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion
            = succeed "-theories:" do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
          %p
            %br/
          %h3#FluxQuantizationLawsAsNonabelianCohomology Flux quantization laws as Nonabelian cohomology
          %p
            We explain how the
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+de+Rham+cohomology"} nonabelian de Rham cohomology
            of the previous subsection receives
            %em character maps
            from generalized
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
            theories whose
            %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            have compatible rational
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+L-infinity+algebra"}
              Whitehead
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔩
                  %mi 𝒜
                  %mo ≃
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \mathfrak{l}\mathcal{A} \simeq \mathfrak{a}
            — whence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            encodes a flux quantization law for Bianchi identities characterized by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            = succeed "-character" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %em charge quanta
            which source given total flux.
          %p
            %br/
          %p#ClassifyingSpacesForGeneralizedCohomology
            %strong Classifying spaces for generalized cohomology.
            It is a classical fact of
            %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
            – which may have remained somewhat underappreciated in
            %a.existingWikiWord{:href => "/nlab/show/mathematical+physics"} mathematical physics
            – that reasonable
            %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology+theory"} generalized
            %a.existingWikiWord{:href => "/nlab/show/cohomology+theories"} cohomology theories
            have
            %em classifying spaces
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
            with the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mi Maps
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi 𝒜
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} \pi_0 Maps\big(-, \mathcal{A}\big)
            of
            %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            (it is only the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            %a.maruku-eqref{:href => "#eq:HomeoToHomotopyType"} (37)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            that matters here).
          %p
            The archetypical examples are
            %em
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spaces"} Eilenberg-MacLane spaces
            like
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(\mathbb{Z},n)
            which classify
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            ranges, these EM-spaces happen to be
            %a.existingWikiWord{:href => "/nlab/show/loop+spaces"} loop spaces
            of each other,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Ω
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\mathbb{Z},n) \simeq \Omega K(\mathbb{Z}, n+1)
          .float_right_image{:style => "margin: -40px 0px 20px 10px"}
            %img{:src => "/nlab/files/GeomPhys-ClassifyingSpacesForCohomology.jpg", :width => "400px"}/
          %p#NonabelianCohomology
            Generalizing from this classical example, one considers
            %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology+theories"} Whitehead-generalized cohomology theories
            which
            %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} are classified by
            any sequences of
            %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi E
                    %mi n
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                %annotation{:encoding => "application/x-tex"} \{E_n\}_{n \in \mathbb{N}}
            equipped with
            %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi n
                    %mo ≃
                    %mi Ω
                    %msub
                      %mi E
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} E_n \simeq \Omega E_{n+1}
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
                of spaces
          %p
            This implies that each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi n
                %annotation{:encoding => "application/x-tex"} E_n
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinite-loop+space"} infinite-loop space
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/abelian+infinity-group"}
                abelian
                = succeed "-groups" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
          %p
            The maybe most familiar example of such
            %em abelian
            generalized cohomology is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            %a.existingWikiWord{:href => "/nlab/show/KU"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi KU
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} KU_0
            may be identified with the space of
            %a.existingWikiWord{:href => "/nlab/show/Fredholm+operators"} Fredholm operators
            on an infinite-dimensional
            %a.existingWikiWord{:href => "/nlab/show/separable"} separable
            %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
          %p
            While
            %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology+theory"} Whitehead-generalized cohomology theory
            has received so much attention that it is now widely understood as the default or even the exclusive meaning of “generalized cohomology”, historically long preceding it is the
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory"} Chern-Weil theory
            %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} B G
            of
            %a.existingWikiWord{:href => "/nlab/show/compact+Lie+groups"} compact Lie groups
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            Unless
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            happens to be
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
            itself, this
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
            does not assign abelian
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/pointed+set"} pointed
                cohomology sets
          %p
            In this vein one may observe &amp;lbrack;
            %a{:href => "#FSS23"}> FSS23-Char, §2
            \&amp;rbrack; that (the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of)
            %em every
            connected space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            is equivalently the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            of an
            %a.existingWikiWord{:href => "/nlab/show/infinity-group"} infinity-group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \Omega \mathcal{A}
            %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
            regarded as an
            %a.existingWikiWord{:href => "/nlab/show/A-infinity+space"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
              \-space
            under concatenation of loops), so that homotopy classes of maps into
            %em any
            connected space are examples of an evident generalization of Chern-Weil-style
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
          %p
            A fundamental and historical example of such “truly-generalized”
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
            is
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cohomotopy"} CoHomotopy
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy types
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spheres"} spheres
          %p
            Notice that “generalized nonabelian cohomology” is really “not necessarily abelian”: It subsumes all the other cases: For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mo •
                %annotation{:encoding => "application/x-tex"} E_\bullet
            a
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ≃
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi H
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %mi Ω
                  %msub
                    %mi E
                    %mi n
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  E^n(X) \,\simeq\, H^1\big(X;\, \Omega E_n\big)
                  \\,.
          %p
            %br/
          %p
            %strong Character maps on generalized cohomology.
            Moreover, it is classical that, over smooth manifolds, reasonable cohomology theories have their non-
            %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion
            content reflected in
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            via
            = succeed ":" do
              %em character maps
          %ul
            %li
              %p
                on
                %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
                this is
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/de+Rham+theorem"} de Rham theorem
            %li
              %p
                on ordinary
                %a.existingWikiWord{:href => "/nlab/show/non-abelian+cohomology"} non-abelian cohomology
                this is the
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
            %li
              %p
                on
                %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
                this is the
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
            %li
              %p
                on any
                %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology"} Whitehead-generalized cohomology
                this is the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Chern-Dold+character"} Chern-Dold character
          #eq:ExamplesOfCharacterMaps.maruku-equation
            %span.maruku-eq-number (21)
            %code.maruku-mathml
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/GeomPhys-CharacterMaps.jpg", :width => "900px"}/
          %p
            The nonabelian character in the generality of generalized non-abelian cohomology, such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cohomotopy"} CoHomotopy
            = succeed "&rbrack;," do
              %a{:href => "#FSS23"} FSS23-Char, Def. IV.2
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+dg-algebraic+rational+homotopy+theory"} fundamental theorem of dg-algebraic rational homotopy theory
          %p
            The key point is that
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            characterizes the non-
            %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion
            content of (the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of) a (classifying) space by an
            = succeed "-approximation" do
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
                \-algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔩
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathfrak{l}\mathcal{A}
            to its
            %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
            %a.existingWikiWord{:href => "/nlab/show/infinity-group"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \Omega \mathcal{A}
          %p
          #SullivanTheorem.num_prop
            %h6 Proposition
            %p
              %strong
                (Quillen-Sullivan-Whitehead
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} L_\infty
              \&amp;lbrack;cf.
              = succeed "&rbrack;)" do
                %a{:href => "#FSS23"} FSS23-Char, Prop. 4.23, 5.6 &amp; 5.13
              %br/
            %p
              For a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
