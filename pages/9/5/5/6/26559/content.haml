                              %mn 2
                    %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  SolSpace
                  \\;=\;
                  \\left\{
                  \\begin{array}{l}
                  H_3 \,\in\, \Omega^3_{dR}(X^9)
                  \\\
                  F_{2\bullet}
                  \\,\in\,
                  \\Omega^{2\bullet}_{dR}(X^9)
                  \\end{array}
                  \\;\text{s.t.}\;
                  \\begin{array}{l}
                  \\mathrm{d}\, H_3 \,=\, 0
                  \\\
                  \\mathrm{d}\, F_{2\bullet} \,=\,
                  H_3 \wedge F_{2\bullet -2}
