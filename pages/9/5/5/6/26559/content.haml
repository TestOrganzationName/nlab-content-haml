            %p and denote by
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi θ
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %msubsup
                          %mi Ω
                          %mi dR
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi X
                          %mn 11
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \theta \,\in\, \Omega^1_{dR}(X^{11})
                  any fiberwise
                  %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
                  along the fibers (i.e. an
                  %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"} Ehresmann connection
                  form),
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 2
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %msubsup
                          %mi Ω
                          %mi dR
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi X
                          %mn 10
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F_2 \,\in\, \Omega^2_{dR}(X^{10})
                  the corresponding (
                  %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"}> first
                  )
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/characteristic+form"} characteristic form
                  %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
                  form whose
                  %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mn 11
                      %annotation{:encoding => "application/x-tex"} X^{11}
                  is
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mi θ
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi p
                          %mo *
                        %msub
                          %mi F
                          %mn 2
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\mathrm{d} \theta
                        \\;=\;
                        p^\ast F_2
                        \\,.
            %p
              Assuming that all flux densities are
              = succeed "-inavariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+reduction"} KK-modes
              %a.existingWikiWord{:href => "/nlab/show/basic+differential+form"} basic
              component (a differential form on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mn 10
                    %annotation{:encoding => "application/x-tex"} X^{10}
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pulled back
              along the projection
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/wedge+product"} wedge product
              of a
              %a.existingWikiWord{:href => "/nlab/show/basic+differential+form"} basic differential form
              with the
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              on the
              = succeed "-fibers:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
            #eq:KKComponentsOfCFieldFlux.maruku-equation
              %span.maruku-eq-number (5)
              %code.maruku-mathml
            %div{:style => "margin: -20px 0px 20px 10px"}
              %img{:src => "/nlab/files/GeomPhys-DDReductionOfCFieldFlux.jpg", :width => "330px"}/
            %p
              This is the process of “
              %a.existingWikiWord{:href => "/nlab/show/double+dimensional+reduction"}> double dimensional reduction
              ” – called this way since both spacetime dimension is reduced by
              %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+reduction"} Kaluza-Klein reduction
              on a fiber space, but also the degrees of densities of fluxes “through the fiber space” are decreased – known as part of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/duality+between+M-theory+and+type+IIA+string+theory"} duality between M-theory and type IIA string theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} H_3
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} H_7
              are interpreted as those of the
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
              and the component flux densities
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} F_4
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 6
                  %annotation{:encoding => "application/x-tex"} F_6
              (and
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} F_2
              %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/type+IIA+supergravity"} type IIA supergravity
            %p
              Here the flux density
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} F_2
              %a.existingWikiWord{:href => "/nlab/show/D6-brane"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mn 6
                    %annotation{:encoding => "application/x-tex"} D_6
                \-brane
              sources, is a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathcolor => "orange"}
                      %mtext gravitational
                  %annotation{:encoding => "application/x-tex"} \color{orange}\text{gravitational}
              flux from the 11d point of view: If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mn 10
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 6
                        %mo ,
                        %mn 1
                    %mo ×
                    %msub
                      %mi ℝ
                      %mrow
                        %mo &gt;
                        %mn 0
                    %mo ×
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X^{10} \,=\, \mathbb{R}^{6,1} \times \mathbb{R}_{\gt 0} \times S^2
              is the spacetime domain around a flat singular
              %a.existingWikiWord{:href => "/nlab/show/D6-brane"} D6-brane
              (cf.
              = succeed ")," do
                %a{:href => "#TheDistinctionBetweenSingularAndSolitonicBranes"} above
              %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mn 11
                  %annotation{:encoding => "application/x-tex"} X^{11}
              (a multiple of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/complex+Hopf+fibration"} complex Hopf fibration
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/KK-monopole"} KK-monopole
          %p
            This transmutation, under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+compactification"} Kaluza-Klein compactification
            %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
            in lower dimensions is a major subtlety in choosing
            %a.existingWikiWord{:href => "/nlab/show/flux+quantization"} flux quantization
            laws: Since these laws apply to higher gauge fields but not directly to the field of gravity, there may appear new possibilities for flux quantization after
            %a.existingWikiWord{:href => "/nlab/show/KK-reduction"} KK-reduction
            to lower dimensions which do not come from flux quantization in higher dimensions.
          %p
            %br/
          %h3#EquationsOfMotionOfFlux Equations of motion of higher flux
          %p
            As we now turn to the
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            for
            %a.existingWikiWord{:href => "/nlab/show/flux+densities"} flux densities
            (the analogs of
            %a.existingWikiWord{:href => "/nlab/show/Maxwell%27s+equations"} Maxwell's equations
            for
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic
            flux), the key move towards identifying possible
            %a.existingWikiWord{:href => "/nlab/show/flux+quantization+laws"} flux quantization laws
            (
            %a{:href => "#FluxQuantizationLaws"}> below
            ) is to arrange these equations, equivalently, as:
          %ol
            %li
              %p
                a purely
                %em
                  %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cohomological
                system of
                %a.existingWikiWord{:href => "/nlab/show/differential+equations"} differential equations
                known as higher
                = succeed ";" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
            %li
              %p
                a purely
                %em
                  %a.existingWikiWord{:href => "/nlab/show/geometry"} geometric
                system of
                %a.existingWikiWord{:href => "/nlab/show/linear+equations"} linear equations
                expressing a
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Hodge+duality"} Hodge self-duality
          %p
            the point being that the first item is entirely “
            %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"}> algebro-topological
            ” (
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"}> homotopy-theoretic
            ), while dependency on geometry, namely on the
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+metric"} metric
            (the
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
            of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
          %p
            It turns out &amp;lbrack;
            %a{:href => "#SS23-FQ"}> SS23-FQ
            \&amp;rbrack; that from such
            = succeed "," do
              %em duality-symmetric laws of flux
            %a.existingWikiWord{:href => "/nlab/show/canonical+phase+space"} canonical phase space
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+gauge+theory"} higher gauge theory
            %a.existingWikiWord{:href => "/nlab/show/flux+quantization"} flux-quantization structure
            may be obtained straightforwardly,
            %em without
            going through the traditional and thorny route of
            %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST-
            %a.existingWikiWord{:href => "/nlab/show/BV+formalism"} BV analysis
            based on an
            %a.existingWikiWord{:href => "/nlab/show/stationary+action+principle"} stationary action principle
            given by a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/GeomPhys-PhaseSpaceFromEOMsSchematics-240125.jpg", :width => "860px"}/
          %p
            This move of isolating “pre-metric flux equations” supplemented by a “constitutive” duality constraint has a curious status in the literature. On the one hand, it is elementary and immediate as an equivalent re-formulation of the usual form of (higher) Maxwell-type equations of motion, and as such has been highlighted a century ago &amp;lbrack;
            %a{:href => "pre-metric+electromagnetism#Kottler22a"}> Kottler (1922a)
            ,
            = succeed "," do
              %a{:href => "pre-metric+electromagnetism#Kottler22b"} (1922b)
            = succeed "," do
              %a{:href => "pre-metric+electromagnetism#Cartan24"} Cartan (1924) §80
            = succeed "&rbrack;" do
              %a{:href => "pre-metric+electromagnetism#Dantzig34"} Dantzig (1934)
            = succeed "," do
              %a{:href => "pre-metric+electromagnetism#HehlObukhov03"} Hehl &amp; Obukhov (2003)
            = succeed "," do
              %a{:href => "pre-metric+electromagnetism#Delphenich05a"} Delphenich (2005a)
            = succeed "&rbrack;" do
              %a{:href => "pre-metric+electromagnetism#Delphenich05a"} (2005b)
            %a{:href => "pre-metric+electromagnetism#HehlItinObukhov16"} Hehl, Itin &amp; Obukhov 2016
            and
            = succeed ")." do
              %a{:href => "pre-metric+electromagnetism#DelphenichBook"} Delphenich (202x)
          %p
            While the broader community does not seem to have taken much note of “premetric electromagnetism” as such, we notice that just the same perspective is evidently what in
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            and
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            is called “duality-symmetric” &amp;lbrack;
            %a{:href => "#BandosBerkovitsSorokin98"}> Bandos, Berkovits &amp; Sorokin 1998
            \&amp;rbrack; or “democratic” &amp;lbrack;
            %a{:href => "#MkrtchyanValach23"}> Mkrtchyan &amp; Valach 2023
            \&amp;rbrack; formulations of fluxes in supergravity (see Examples
            %a.maruku-ref{:href => "#MotionOfSupergravityCField"}
            and
            %a.maruku-ref{:href => "#MotionOfCoupledBRRFields"}
            below).
          %p
          #HigherMaxwellEquations.num_defn
