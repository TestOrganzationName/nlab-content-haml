            %div{:style => "margin: -30px 0px 20px 0px"}
              %img{:src => "/nlab/files/GeomPhys-GaussLawAsFlatnessCondition-240129.jpg", :width => "900px"}/
            %p
          %p
          #SolutionSpaceOfElectromagnetism.num_remark
            %h6 Example
            %p
              The characteristic
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mi b
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \mathfrak{u}(1) \oplus b \mathfrak{u}(1)
              of two copies of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/line+Lie+2-algebra"} line Lie 2-algebra
              %a.maruku-ref{:href => "#SolutionsAsFlatForms"}
              corresponds to:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi SolSpace
                      %mi EM
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi dR
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi X
                      %mn 3
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi b
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi b
