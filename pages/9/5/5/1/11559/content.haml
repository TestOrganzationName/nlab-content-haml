                %li
                  %a{:href => "#homotopy_type_of_the_spectrum_"}
                    Homotopy type of the spectrum
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Ell
                        %annotation{:encoding => "application/x-tex"} Ell
              %li
