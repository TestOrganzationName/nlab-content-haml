          %h2#idea Idea
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mover
                    %mo ↪
                    %mi ι
                  %mi G
                %annotation{:encoding => "application/x-tex"} H \xhookrightarrow{\iota} G
            there is the evident
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ι
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi Rep
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %mi Rep
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \iota^\ast \,\colon\, Rep(G) \xrightarrow{\;} Rep(H)
            sending any
            %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            to its
            %a.existingWikiWord{:href => "/nlab/show/restricted+representation"} restricted representation
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.existingWikiWord{:href => "/nlab/show/adjoints"} adjoints
            to this construction are given by forming left/right
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/induced+representations"} induced representations
          %p
            But one may also ask, for any
            %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo ∈
                  %mi Rep
                  %mo{:stretchy => "false"} (
                  %mi H
