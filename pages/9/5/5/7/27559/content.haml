                %use{:x => "63.166387", "xlink:href" => "#CRgN4_9iXD6R2bzE6bxVPn5ZG68=-glyph2-2", :y => "59.106547"}
          %p
            Specifically when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mover
                    %mo →
                    %mi ι
                  %mi G
                %annotation{:encoding => "application/x-tex"} H \xrightarrow{\iota} G
            is a
            %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
            inclusion and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            %em relative
            to the given irrep of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            — either on the nose or at least as
            %a.existingWikiWord{:href => "/nlab/show/projective+representations"} projective representations
            (
            %a{:href => "#Isaacs76"}> Isaacs 1976
            )
          %h2#properties Properties
          %h3#ExtensionAlongNormalSubgroupInclusions Extensions along normal subgroup inclusions
          %p Consider
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mover
                        %mo ↪
                        %mi ι
                      %mi G
                    %annotation{:encoding => "application/x-tex"} N \xhookrightarrow{\iota} G
                a
                %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
                inclusion,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo ∈
                      %mi Rep
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \rho \in Rep(N)
                an
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/linear+representation"} representation
          %p It is immediate but important that:
          %p
          .num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              to admit any extension to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              it is necessary that the
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+class"} isomorphism class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi ρ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\rho]
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              is
              %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
              under the
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi Rep
                          %mo{:stretchy => "false"} (
                          %mi H
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi g
                        %mtd
                          %mi Rep
                          %mo{:stretchy => "false"} (
                          %mi H
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi ρ
                        %mtd
                          %mo ↦
                        %mtd
                          %mi ρ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi g
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %msup
                            %mi g
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    Rep(H) &amp;\overset{(-)^g}{\longrightarrow}&amp; Rep(H)
                    \\\
                    \\rho &amp;\mapsto&amp; \rho\big(g(-)g^{-1}\big)
                    \\end{array}
            %p
              by all elements
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} g \in G
            #eq:InvariantRepresentation.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi ρ
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msup
                      %mi ρ
                      %mi g
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{ g \in G }{\forall}
                    \\;\;\;
                    [\rho] = \big[\rho^g\big]
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              Consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ρ
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{\rho}
              any extension and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
              any element. Then the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ρ
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{\rho}
              is a
              = succeed "-representation" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              implies for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi N
                  %annotation{:encoding => "application/x-tex"} n \in N
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mover
                            %mi ρ
                            %mo ^
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mover
                            %mi ρ
                            %mo ^
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi g
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                        %mtd
                          %mover
                            %mi ρ
                            %mo ^
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mover
                            %mi ρ
                            %mo ^
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mover
                            %mi ρ
                            %mo ^
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi g
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mover
                            %mi ρ
                            %mo ^
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi g
                          %mi n
                          %msup
                            %mi g
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mi ρ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi g
                          %mi n
                          %msup
                            %mi g
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %msup
                            %mi ρ
                            %mi g
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccl}
                    \\widehat{\rho}(g)
                    \\circ \rho(n) \circ
                    \\widehat{\rho}(g^{-1})
                    \&amp;=&amp;
                    \\widehat{\rho}(g)
                    \\circ \widehat{\rho}(n) \circ
                    \\widehat{\rho}(g^{-1})
                    \\\
                    \&amp;=&amp;
                    \\widehat{\rho}\big(g n g^{-1}\big)
                    \\\
                    \&amp;=&amp;
                    \\rho\big(g n g^{-1}\big)
                    \\\
                    \&amp;=&amp;
                    \\rho^g(n)
                    \\,.
                    \\end{array}
            %p
              But this says equivalently that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ρ
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widehat{\rho}(g)
              is an
              %a.existingWikiWord{:href => "/nlab/show/intertwiner"} intertwiner
              which constitutes an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of representations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %munderover
                      %mo →
                      %mrow
                        %mo ∼
                      %mrow
                        %mover
                          %mi ρ
                          %mo ^
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi ρ
                      %mi g
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\rho \xrightarrow[\sim]{ \widehat{\rho}(g) } \rho^g
                    \\,,
            %p
              and hence that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi ρ
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                      %msup
                        %mi ρ
                        %mi g
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %annotation{:encoding => "application/x-tex"} [\rho] = \big[\rho^g\big]
          %p Now assume in addition that
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/algebraically+closed+field"} algebraically closed field
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
                is an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible representation
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
                is
                = succeed "-invariant" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.maruku-eqref{:href => "#eq:InvariantRepresentation"} (1)
          %p
          #ExtensionOfInvariantNormalIrrepByProjectiveReps.num_prop
            %h6 Proposition
            %p
              There always exists a
              %em projective
              extension of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              in the sense of a
              %a.existingWikiWord{:href => "/nlab/show/projective+representation"} projective representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ρ
                      %mo ˜
                    %mo ∈
                    %mi PRep
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widetilde{\rho} \in PRep(G)
              satisfying, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi N
                  %annotation{:encoding => "application/x-tex"} n \in N
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} g \in G
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mover
                          %mi ρ
                          %mo ^
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo =
                        %mspace{:width => "thinmathspace"}
                        %mi ρ
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \widehat{\rho}(n) \,=\, \rho(n)
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mover
                          %mi ρ
                          %mo ^
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mover
                          %mi ρ
                          %mo ^
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mover
                          %mi ρ
                          %mo ^
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \widehat{\rho}(g n) = \widehat{\rho}(g) \circ \widehat{\rho}(n)
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mover
                          %mi ρ
                          %mo ^
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mover
                          %mi ρ
                          %mo ^
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mover
                          %mi ρ
                          %mo ^
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \widehat{\rho}(n g) = \widehat{\rho}(n) \circ \widehat{\rho}(g)
                  ,
            %p
              and any
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ρ
                      %mo ^
                    %mo ,
                    %mover
                      %mi ρ
                      %mo ^
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \widehat{\rho}, \widehat{\rho}'
              of such differ only by a function on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with values in the
              %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} k^{\times}
              and depending only on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cosets"} cosets
            #eq:DifferenceOfProjectiveExtensions.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi G
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %msup
                      %mi k
                      %mo ×
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mu
                    \\,\colon\,
                    G \xrightarrow{\;} G/N \xrightarrow{\;} k^\times
                    \\,,
            %p in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ρ
                      %mo ˜
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi ρ
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widetilde{\rho}'(-)
                    \\;=\;
                    \\widetilde{\rho}(-)
                    \\cdot
                    \\mu(-)
                    \\,.
            %p
          (
          %a{:href => "#Isaacs76"}> Isaacs 1976 Thm. 11.2
          )
          %p
          #ExtensionOfInvariantNormalIrrepByActualRep.num_prop
            %h6 Proposition
            %p
              Given any projective extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ρ
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} \widetilde{\rho}
              according to Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ExtensionOfInvariantNormalIrrepByProjectiveReps"}
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} 2-cocycle
              in the
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi α
                      %mo ˜
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi G
                    %mo ×
                    %mi G
                    %mo ⟶
                    %msup
                      %mi k
                      %mo ×
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext s.t.
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∀
                      %mrow
                        %msub
                          %mi g
                          %mi i
                        %mo ∈
                        %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi ρ
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mover
                      %mi ρ
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi ρ
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mover
                      %mi α
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\widetilde{\alpha} \,\colon\,
                    G \times G
                    \\longrightarrow
                    k^{\times}
                    \\,,
                    \\;\;\;\;\;\;\;\;\;\;
                    \\text{s.t.}
                    \\;\;\;\;\;\;\;\;\;\;
                    \\underset{g_i \in G}{\forall}
                    \\;\;
                    \\widetilde{\rho}(g_1)
                    \\circ
                    \\widetilde{\rho}(g_1)
                    \\;=\;
                    \\widetilde{\rho}(g_1 g_2)
                    \\cdot
                    \\widetilde{\alpha}(g_1, g_2)
                    \\,,
            %p
              comes from a 2-cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              on the
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi α
                      %mo ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo ×
                    %mi G
                    %mo ↠
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi α
                    %msup
                      %mi k
                      %mo ×
                  %annotation{:encoding => "application/x-tex"}
                    \\widetilde{\alpha}
                    \\;\colon\;
                    G \times G
                    \\twoheadrightarrow
                    (G/N) \times (G/N)
                    \\xrightarrow{ \alpha }
                    k^{\times}
            %p
              whose
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
              class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi H
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi k
                      %mo ×
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    [\alpha] \,\in\, H^2\big(G/N;\, k^\times\big)
            %p
              depends only on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi ρ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\rho]
              (is independent of the choice of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi ρ
                        %mo ˜
                    %annotation{:encoding => "application/x-tex"} \widetilde{\rho}
            %p
              Finally,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              admits an actual extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ρ
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{\rho}
              iff that class is trivial,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi α
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} [\alpha] = 0
          (
          %a{:href => "#Isaacs76"}> Isaacs 1976 Thm. 11.7
          )
          %p
          .num_remark
            %h6 Remark
            %p
              It follows moreover that if an extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ρ
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{\rho}
              exists, then this is unique up to multiplication with (the pullback to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              of) a
              %a.existingWikiWord{:href => "/nlab/show/group+character"} group character
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi N
                  %annotation{:encoding => "application/x-tex"} G/N
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:DifferenceOfProjectiveExtensions"} (2)
