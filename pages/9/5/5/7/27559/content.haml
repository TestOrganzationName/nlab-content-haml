          %h2#references References
          %p Monographs:
          %ul
            %li#Isaacs76
              %p
                %a.existingWikiWord{:href => "/nlab/show/I.+Martin+Isaacs"}> I. Martin Isaacs
                \: around Thm. 11.7 in:
                = succeed "," do
                  %em Character theory of finite groups
                = succeed "&rbrack;" do
                  %a{:href => "https://bookstore.ams.org/view?ProductCode=CHEL/359.H"} ISBN:978-0-8218-4229-4
            %li#Navarro18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gabriel+Navarro"}> Gabriel Navarro
                , sections 5 &amp; 6 of:
                = succeed "," do
                  %em Character Theory and the McKay Conjecture
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/9781108552790"} doi:10.1017/9781108552790
          %p Further discussion:
          %ul
            %li
              %p
                Peter Schmid:
                = succeed "," do
                  %em Extending irreducible representations of normal subgroups
                %strong 94
                1 (1985) 30-51 [
                %a{:href => "https://doi.org/10.1016/0021-8693(85)90203-0"}> doi:10.1016/0021-8693(85)90203-0
                ]
            %li
              %p
                G. Karpilovsky:
                = succeed "," do
                  %em On extension of characters from normal subgroups
                %strong 27
                (1984) 7-9 &amp;lbrack;
                %a{:href => "https://doi.org/10.1017/S0013091500022057"}> doi:10.1017/S0013091500022057
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://www.cambridge.org/core/services/aop-cambridge-core/content/view/B051526AE20F219C468AFBF1D9546E43/S0013091500022057a.pdf/on_extension_of_characters_from_normal_subgroups.pdf"} pdf
            %li
              %p
                Qiang Huang:
                = succeed "," do
                  %em Extension of irreducible characters from normal subgroups
                %strong 27
                2 (1990) &amp;lbrack;
                %a{:href => "https://doi.org/10.1080/03081089008818001"}> doi;10.1080/03081089008818001
                \&amp;rbrack;
            %li
