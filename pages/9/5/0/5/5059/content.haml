                    %mrow
                      %mi α
                      %mi β
                  %msub
                    %mi Z
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi a
                        %mi p
                %annotation{:encoding => "application/x-tex"}
                  \\{Q_\alpha, Q_\beta\}
                  \\;=\;
