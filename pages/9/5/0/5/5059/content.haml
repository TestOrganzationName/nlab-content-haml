            %li
              %p
                Makoto Sakaguchi, Hyeonjoon Shin, Kentaroh Yoshida,
                = succeed "," do
                  %em
                    Semiclassical Analysis of M2-brane in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi AdS
                            %mn 4
                          %mo ×
                          %msup
                            %mi S
                            %mn 7
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi ℤ
                            %mi k
                        %annotation{:encoding => "application/x-tex"} AdS_4 \times S^7 / \mathbb{Z}_k
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1007.3354"} arXiv:1007.3354
          %p
            For the
            %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            and the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
          %ul
            %li#Claus98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Piet+Claus"}> Piet Claus
                ,
                = succeed "," do
                  %em
                    Super M-brane actions in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi adS
                            %mn 4
                          %mo ×
                          %msup
                            %mi S
                            %mn 7
                        %annotation{:encoding => "application/x-tex"} adS_4 \times S^7
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi adS
                            %mn 7
                          %mo ×
                          %msup
                            %mi S
                            %mn 4
                        %annotation{:encoding => "application/x-tex"} adS_7 \times S^4
                %strong 59
                (1999) 066003 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/hep-th/9809045"}> arXiv:hep-th/9809045
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1103/PhysRevD.59.066003"} doi:10.1103/PhysRevD.59.066003
            %li
              %p
                Makoto Sakaguchi, Kentaroh Yoshida,
                = succeed "," do
                  %em
                    Open M-branes on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi AdS
                            %mrow
                              %mn 4
                              %mo{:stretchy => "false"} /
                              %mn 7
                          %mo ×
                          %msup
                            %mi S
                            %mrow
                              %mn 7
                              %mo{:stretchy => "false"} /
                              %mn 4
                        %annotation{:encoding => "application/x-tex"} AdS_{4/7} \times S^{7/4}
                    Revisited
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0405109"} arXiv:hep-th/0405109
          %h3#selfdual_strings_in_6d Self-dual strings in 6d
          %p
            Discussion of the
            %a.existingWikiWord{:href => "/nlab/show/self-dual+string"} self-dual string
            in 6d as a Green-Schwarz-type sigma model includes
          %ul
            %li
              Par Arvidsson, Erik Flink,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mans+Henningson"} Mans Henningson
              = succeed "," do
                %em
                  Supersymmetric coupling of a self-dual string to a
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (2,0)
                  tensor multiplet background
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/0309244"} arXiv:hep-th/0309244
          %h3#ReferencesSupergravityBackgroundEquationsOfMotion General curved backgrounds and Supergravity background equations of motion
          %p
            The consistency of the Green-Schwarz action functional for the superstring in a
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background
            should be equivalent to the background satiyfying the
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
          %ul
            %li#BergshoeffSezginTownsend86
              %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
              = succeed "," do
                %em
                  Superstring actions in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo =
                        %mn 3
                        %mo ,
                        %mn 4
                        %mo ,
                        %mn 6
                        %mo ,
                        %mn 10
                      %annotation{:encoding => "application/x-tex"} D = 3, 4, 6, 10
                  curved superspace
              = succeed ")" do
                %a{:href => "http://inspirehep.net/record/223138/?ln=en"} spire
          %p and for the supermembrane due to
          %ul
            %li#BergshoeffSezginTownsend87
              %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
              = succeed "," do
                %em Supermembranes and eleven dimensional supergravity
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mike+Duff"} Mike Duff
              %em
                %a.existingWikiWord{:href => "/nlab/show/The+World+in+Eleven+Dimensions"} The World in Eleven Dimensions
              69-72 (
              %a{:href => "http://inspirehep.net/record/248230?ln=en"}> spire
              )
          %p
            with a quick re-derivation using that the
            %a.existingWikiWord{:href => "/nlab/show/torsion+constraints+in+supergravity"} torsion constraint in 11d supergravity
            already imples the sugra equations of motion is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"}> Paul Howe
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
              = succeed "," do
                %em The supermembrane revisited
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/0412245"} arXiv:hep-th/0412245
          %p
            These authors amplify the role of closed
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+2)
            = succeed "-brane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            in a curved backround in terms of the
            %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
            on p. 7-8, amounting to the statment that the 4-form field strength has to be the pullback of the cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ψ
                    %mo ¯
                  %mo ∧
                  %msup
                    %mi e
                    %mi a
                  %mo ∧
                  %msup
                    %mi e
                    %mi b
                  %mo ∧
                  %msup
                    %mi Γ
                    %mrow
                      %mi a
                      %mi b
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \overline{\psi}\wedge e^a \wedge e^b \wedge \Gamma^{a b} \psi
            plus the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            and has to be closed.
          %p
            That the
            %a.existingWikiWord{:href => "/nlab/show/heterotic+supergravity"} heterotic supergravity
            equations of motion are sufficient for the 3-form super field strength
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            to be closed was first argued in
          %ul
            %li#Nilsson81
              %a.existingWikiWord{:href => "/nlab/show/Bengt+Nilsson"}> Bengt Nilsson
              ,
              = succeed "," do
                %em Simple 10-dimensional supergravity in superspace
              = succeed ")" do
                %a{:href => "http://inspirehep.net/record/164253?ln=de"} spire
          %p and the computation there was highlighted and a little simplified around p. 17 of
          %ul
            %li#Witten86
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
              ,
              = succeed "," do
                %em Twistor-like transform in ten dimensions
              = succeed ")" do
                %a{:href => "http://inspirehep.net/record/214192/?ln=en"} spire
          %p A more comprehensive result arguing that the heterotic supergravity equations of motion of the background are not just sufficient but also necessary for (and hence equivalent to) the heterotic GS-string on that background being consistent was then claimed in
          %ul
            %li#ShapiroTaylor87
              %a.existingWikiWord{:href => "/nlab/show/Joel+Shapiro"}> Joel Shapiro
              , Cyrus Taylor,
              = succeed "," do
                %em Superspace supergravity from the superstring
              %strong 186
              1 (1987) &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0370-2693(87)90514-4"}> doi:10.1016/0370-2693(87)90514-4
              \&amp;rbrack;
          %p
            Discussion of this with the heterotic gauge-field included (hence including the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+anomaly+cancellation"} Green-Schwarz anomaly cancellation
          %ul
            %li#AtickDharRatra86
              %a.existingWikiWord{:href => "/nlab/show/Joseph+Atick"}> Joseph Atick
              , Avinash Dhar, Bharat Ratra,
              = succeed "," do
                %em
                  Superspace Formulation of Ten-dimensional
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} N=1
                  Supergravity Coupled to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} N=1
                  Super Yang-Mills Theory
              = succeed "," do
                %a{:href => "https://inspirehep.net/record/219734"} spire
              = succeed ")" do
                %a{:href => "http://ccdb5fs.kek.jp/cgi-bin/img/allpdf?198602074"} pdf
          %p
            Similar arguments for the
            %a.existingWikiWord{:href => "/nlab/show/type+II+string"} type II string
            in
            %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
            appeared in
          %ul
            %li#GHMNT85
              %a.existingWikiWord{:href => "/nlab/show/Marcus+Grisaru"}> Marcus Grisaru
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"} Paul Howe
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bengt+Nilsson"} Bengt Nilsson
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi N
                        %mo =
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} N=2
                  \-Superstring in a supergravity background
              = succeed ")" do
                %a{:href => "http://inspirehep.net/record/17010"} spire
          %p
            and for GS sigma-model
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            in
          %ul
            %li#CGNSW97
              %a.existingWikiWord{:href => "/nlab/show/Martin+Cederwall"}> Martin Cederwall
              , Alexander von Gussich,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bengt+Nilsson"} Bengt Nilsson
              = succeed "," do
                %em The Dirichlet Super-p-Branes in Ten-Dimensional Type IIA and IIB Supergravity
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/9611159"} arXiv:hep-th/9611159
          %p
            That the
            %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            is consistent on backgrounds of
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            that satisfy their equations of motion is discussed in (
            %a{:href => "#BergshoeffSezginTownsend87"}> Bergshoeff-Sezgin-Townsend 87
            ).
          %p The role of the 4-form here is also amplified around (2.29) in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Igor+Bandos"}> Igor Bandos
              , Carlos Meliveo,
              %em Supermembrane interaction with dynamical D=4 N=1 supergravity. Superfield Lagrangian description and spacetime equations of motion
              (
              %a{:href => "https://arxiv.org/abs/arXiv:1205.5885"}> arXiv:1205.5885
              )
          %p and in section 2.2 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Igor+Bandos"}> Igor Bandos
              , Carlos Meliveo,
              %em Three form potential in (special) minimal supergravity superspace and supermembrane supercurrent
              (
              %a{:href => "http://arxiv.org/abs/1107.3232"}> arXiv:1107.3232
              )
          %p following
          %ul
            %li#OvrutWaldram97
              %a.existingWikiWord{:href => "/nlab/show/Burt+Ovrut"}> Burt Ovrut
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Waldram"} Daniel Waldram
              = succeed "," do
                %em Membranes and Three-form Supergravity
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/9704045"} arXiv:hep-th/9704045
          %p See also
          %ul
            %li
              Bernard de Wit, Kasper Peeters, Jan Plefka,
              = succeed "," do
                %em Superspace Geometry for Supermembrane Backgrounds
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/9803209"} arXiv:hep-th/9803209
          %p
            All this is actually subsumed by imposing the
            %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
            of the corresponding
            %a.existingWikiWord{:href => "/nlab/show/supergravity+Lie+3-algebra"} supergravity Lie 3-algebra
            etc. in “rheonomic parameterization”, of the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/D%27Auria-Fr%C3%A9+formulation+of+supergravity"} D'Auria-Fré formulation of supergravity
            = succeed "," do
              %a{:href => "#AFFFTT98"} AFFFTT 98, section 3.1
            = succeed ")." do
              %a{:href => "#FreGrassi07"} Fré-Grassi 07
          %p
            Discussion including also the
            %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
            background includes
          %ul
            %li
              R. R. Metsaev,
              %em Type IIB Green-Schwarz superstring in plane wave Ramond-Ramond background
              (
              %a{:href => "http://arxiv.org/abs/hep-th/0112044"}> arXiv:hep-th/0112044
              )
          %div
            %h3#ReferencesMicroscopicAdSCFTViapBraneSigmaModesl
              Microscopic AdS/CFT via
              = succeed "-brane" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            %p
              Over a decade before the
              %a{:href => "AdS-CFT+correspondence#ReferencesOriginModernAdSCFTDUality"} modern formulation
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+correspondence"} AdS-CFT correspondence
            .float_right_image{:style => "margin: -20px 0px 0px 15px"}
              %img{:src => "/nlab/files/pBraneNearBlackBrane-240624.jpg", :width => "400px"}/
            %p
              %a.existingWikiWord{:href => "/nlab/show/immersion"} Immersing
              the
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
              of a
              %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
              %a.existingWikiWord{:href => "/nlab/show/super+p-brane"}
                super
                = succeed "-brane" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
              (hence a “light”
              %a.existingWikiWord{:href => "/nlab/show/brane"} brane
              without
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/backreaction"} backreaction
              %a.existingWikiWord{:href => "/nlab/show/near+horizon+geometry"} near horizon geometry
              (an
              %a.existingWikiWord{:href => "/nlab/show/anti+de+Sitter+spacetime"} AdS
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
              solution) of its own
              %a.existingWikiWord{:href => "/nlab/show/black+brane"} black brane
              incarnation (hence the “heavy” incarnation of the same brane, causing
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/backreaction"} backreaction
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
              fluctuations (after
              %a.existingWikiWord{:href => "/nlab/show/super-diffeomorphism"} super-diffeomorphism
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixing
              %a.existingWikiWord{:href => "/nlab/show/superconformal+field+theory"} superconformal field theory
              (exhibited by
              %a.existingWikiWord{:href => "/nlab/show/superconformal+multiplets"} superconformal multiplets
              such as “
              %em>
                %a.existingWikiWord{:href => "/nlab/show/supersingletons"} supersingletons
              ”) [graphics from
              = succeed "]." do
                %a.existingWikiWord{:href => "/schreiber/show/Holographic+M-Brane+Super-Embeddings"} GSS24
            %p
              The original observation for the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            %ul
              %li#BDPS87
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Michael+Duff"} Michael Duff
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Christopher+Pope"} Christopher Pope
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
                  = succeed "," do
                    %em Supersymmetric Supermembrane Vacua and Singletons
                  %strong 199
                  (1987) 69-74 [
                  %a{:href => "https://doi.org/10.1016/0370-2693(87)91465-1"}> doi:10.1016/0370-2693(87)91465-1
                  ,
                  = succeed "]" do
                    %a{:href => "https://inspirehep.net/literature/250244"} InSpire:250244
              %li#BlencoweDuff88
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Miles+P.+Blencowe"}> Miles P. Blencowe
