                    Superstring. Part I
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0901.4937"} arXiv:0901.4937
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"}> John Schwarz
                ,
                %em
                  The
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi AdS
                          %mn 5
                        %mo ×
                        %msup
                          %mi S
                          %mn 5
                      %annotation{:encoding => "application/x-tex"} AdS_5 \times S^5
                  Superstring
                (
