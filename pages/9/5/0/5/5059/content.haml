            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"}> Pietro Fré
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pietro+Antonio+Grassi"} Pietro Antonio Grassi
                %em
                  Pure Spinor Formalism for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Osp
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} |
                        %mn 4
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Osp(N|4)
                  backgrounds
                (
                %a{:href => "http://arxiv.org/abs/0807.0044"}> arXiv:0807.0044
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Riccardo+D%27Auria"}> Riccardo D'Auria
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"} Pietro Fré
                %em
                  Superstrings on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
