                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mn 5
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \frac{SU(2,2 \vert 5)}{Spin(4,1)\times SO(5)}
          %ul
            %li#MetsaevTseytlin98
              %a.existingWikiWord{:href => "/nlab/show/Ruslan+Metsaev"}> Ruslan Metsaev
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Arkady+Tseytlin"} Arkady Tseytlin
              = succeed "," do
                %em
                  Type IIB superstring action in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi AdS
                          %mn 5
                        %mo ×
                        %msup
                          %mi S
                          %mn 5
                      %annotation{:encoding => "application/x-tex"} AdS_5 \times S^5
                  background
              = succeed ":109-126," do
                %strong B533
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9805028"} arXiv:hep-th/9805028
          %p However, a supersymmetric trivialization of this cocycle seems to have been obtained in
          %ul
            %li#RoibanSiegel00
              Radu Roiban,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Warren+Siegel"} Warren Siegel
              = succeed "," do
