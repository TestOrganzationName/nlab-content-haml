              ]
          %p
            \&amp;lbrack;
            %a{:href => "http://arxiv.org/abs/hep-th/9908045"}> arXiv:hep-th/9908045
            \&amp;rbrack;
          %ul
            %li#GKW
              %a.existingWikiWord{:href => "/nlab/show/Joaquim+Gomis"}> Joaquim Gomis
              , Kiyoshi Kamimura,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+West"} Peter West
