                  from Supergravity
                (
                %a{:href => "http://arxiv.org/abs/0808.1282"}> arXiv:0808.1282
                )
            %li
              %p
                D. V. Uvarov,
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi AdS
                            %mn 4
                          %mi x
                          %mi ℂ
                          %msup
                            %mi P
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} AdS_4 x \mathbb{C}P^3
                    superstring in the light-cone gauge
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0906.4699"} arXiv:0906.4699
          %p
            For the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
          %ul
            %li#deWitPeetersPlefkaSevrin98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bernard+de+Wit"}> Bernard de Wit
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kasper+Peeters"} Kasper Peeters
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jan+Plefka"} Jan Plefka
                = succeed "," do
                  %em
                    The M-Theory Two-Brane in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi AdS
                            %mn 4
                          %mo ×
                          %msup
                            %mi S
                            %mn 7
                        %annotation{:encoding => "application/x-tex"} AdS_4 \times S^7
                    and
