            = succeed "-branes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/soliton"} solitonic
            incarnation as
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/black+branes"} black branes
            %a.existingWikiWord{:href => "/nlab/show/anti-de+Sitter+spacetime"} anti-de Sitter spacetime
            and carry
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/conformal+field+theories"} conformal field theories
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+duality"} AdS-CFT duality
          %p This phenomenon is indeed a consequence of the fundamental Green-Schwarz branes:
          %p
            Consider a 1/2-
            %a.existingWikiWord{:href => "/nlab/show/BPS+state"} BPS state
            solution of
            %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Σ
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \phi \colon \Sigma \to X
            of the corresponding fundamental
            = succeed "-brane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            into the asymptotic AdS boundary of the given 1/2 BPS spacetime
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixing
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetric
            %a.existingWikiWord{:href => "/nlab/show/conformal+field+theory"} conformal field theory
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            as in the
            %a.existingWikiWord{:href => "/nlab/show/AdS-CFT"} AdS-CFT
            dictionary:
          %table
            %thead
              %tr
                %th
                  fundamental
                  = succeed "-brane" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
