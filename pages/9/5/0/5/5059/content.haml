                )
          %h4#ReferencesAdS4Background
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi AdS
                    %mn 4
                %annotation{:encoding => "application/x-tex"} AdS_4
            and
