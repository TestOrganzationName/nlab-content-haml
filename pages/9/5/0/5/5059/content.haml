                %annotation{:encoding => "application/x-tex"} AdS_7
          %p
            For the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/superstring"} superstring
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gleb+Arutyunov"}> Gleb Arutyunov
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sergey+Frolov"} Sergey Frolov
                = succeed "," do
                  %em
                    Superstrings on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi AdS
