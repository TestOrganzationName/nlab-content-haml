                          %mtext symmetries
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\left\{
                  \\array{
                  X &amp;&amp; \overset{=}{\longrightarrow} &amp;&amp; X
                  \\\
                  \&amp; {}_{\mathllap{\hat C}}\searrow
                  \&amp;\swArrow&amp;
                  \\swarrow_{\mathrlap{\hat C}}
                  \\\
                  \&amp;&amp; \mathbf{B}^{p+1}(\mathbb{R}/_{\hbar} \mathbb{Z})
                  }
                  \\right\}
                  \&amp;\longrightarrow&amp;
