                    %semantics
                      %mrow
                        %msub
                          %mi AdS
                          %mn 5
                        %mo ×
                        %msup
                          %mi S
                          %mn 5
                      %annotation{:encoding => "application/x-tex"} AdS_5 \times S^5
                  supertwistor space
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/0010104"} arXiv:hep-th/0010104
          %p
            see
            = succeed "," do
              %a{:href => "#HatsudaSakaguchi02"} Hatsuda-Sakaguchi 02, around (1.2) and (2.6)
            %a{:href => "#HatsudaSakaguchi01"} Hatsuda-Sakaguchi 01, around (1.2)
          %p
            (amplified in
            = succeed ")." do
              %a{:href => "https://arxiv.org/abs/1808.04470"} arxiv:1808.04470, p. 5 and equation (5.5)
          %p See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gleb+Arutyunov"}> Gleb Arutyunov
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sergey+Frolov"} Sergey Frolov
                = succeed "," do
                  %em
                    Foundations of the
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi AdS
                            %mn 5
                          %mi x
