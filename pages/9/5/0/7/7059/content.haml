              %a.existingWikiWord{:href => "/nlab/show/CQTS"} CQTS
              (Jan 2023) &amp;lbrack;video:
              = succeed "&rbrack;" do
                %a{:href => "https://nyu.zoom.us/rec/play/uk0LXy5ub2YUpJPhYq5p7GvpZ2I8_CZaWHSpWvZgwuUyHeWjXgUj2AQd21K1WSJo90V5DrE0BVhl7NuB.QbyHhtPHaJVQUj2A?continueMode=true&_x_zm_rtaid=Xyx9WZFLQzyRzu0Oh-2mNQ.1675318497581.13147cc7929a947e978b29124a207f98&_x_zm_rhtaid=938"} rec
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/parametricity"} parametricity
            in cohesive homotopy type theory:
          %ul
            %li#Aberle24
              %a.existingWikiWord{:href => "/nlab/show/C.B.+Aberl%C3%A9"}> C.B. Aberlé
