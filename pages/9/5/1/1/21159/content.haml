              %ul
                %li
                  %a{:href => "#general"} General
                %li
                  %a{:href => "#FlavorOnSingleHeteroticM5BranesReferences"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
