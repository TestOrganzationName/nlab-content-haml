                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SU(2)
                    \-flavor symmetry on heterotic M5-branes
          %h2#idea Idea
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/instanton"} instanton
            in plain
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            on a 4-
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi K
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 4
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K^{(4)}
            necessarily has a
            %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
            characteristic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/radius"} radius
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of instantons the would-be point of vanishing characteristc radius corresponds to a
            %a.existingWikiWord{:href => "/nlab/show/singularity"} singularity
            which is unphysical, in that it is not part of the
            %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/theory+%28physics%29"} theory
          %p
            But also the
            %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
            of
            %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
            admits
            = succeed "-configurations" do
              %a.existingWikiWord{:href => "/nlab/show/instanton"} instanton
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+instantons"} Yang-Mills instantons
            on the
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
            4-manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi K
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 4
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K^{(4)}
            to a
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 6
                    %mo +
                    %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (6+4)
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/product+manifold"} product manifold
            %a.existingWikiWord{:href => "/nlab/show/spacetimes"} spacetimes
          #eq:ProductSpacetime.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 9
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Q
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 5
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ×
                  %msup
                    %mi K
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 4
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  X^{(9+1)} \;\simeq\; Q^{(5+1)} \times K^{(4)}
          %p
            along the
            %a.existingWikiWord{:href => "/nlab/show/projection+map"} projection map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Q
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 5
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ×
                    %msup
                      %mi K
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi pr
                          %mn 2
                    %msup
                      %mi K
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q^{(5+1)} \times K^{(4)} \overset{pr_2}{\longrightarrow} K^{(4)}
          %p
            Therefore it makes sense to ask if, after embedding
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+instantons"} Yang-Mills instantons
            into
            %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
            this way, the
            %a.existingWikiWord{:href => "/nlab/show/singularity"} singularity
            in the moduli space of instantons becomes part of the phase space of the theory (now that
            = succeed "-effects" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+gravity"} quantum gravity
            = succeed "." do
              %em small instantons
          %p
            %strong In HET-O.
            A circumstantial but widely accepted argument (
            %a.existingWikiWord{:href => "/nlab/show/folklore"}> folklore
            ) due to
            %a{:href => "#Witten96"} Witten 96
            says that this is indeed the case, and that these
            %em small instantons
            in
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/SemiSpin%2832%29"} SemiSpin(32)
            %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
            are identified with heterotic
            %a.existingWikiWord{:href => "/nlab/show/NS5-branes"} NS5-branes
            %a.existingWikiWord{:href => "/nlab/show/wrapped+brane"} wrapped
            on the
            = succeed "-factor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Q
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 5
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q^{(5+1)}
            %a.maruku-eqref{:href => "#eq:ProductSpacetime"} (1)
            and carrying an exotic
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Sp%281%29"} Sp(1)
            %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
            on their worldvolume, identified with the
            = succeed "-structure" do
              %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
          %p
            Indeed, solutions of
            %a.existingWikiWord{:href => "/nlab/show/heterotic+supergravity"} heterotic supergravity
            involving
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
            %a.existingWikiWord{:href => "/nlab/show/radius"} radius
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+instantons"} Yang-Mills instantons
            had been interpreted as
            %a.existingWikiWord{:href => "/nlab/show/black+brane"} black
            %a.existingWikiWord{:href => "/nlab/show/NS5-branes"} NS5-branes
            of non-vanishing “thickness” in
            = succeed "." do
              %a{:href => "#Strominger90"} Strominger 90
            = succeed ")" do
              %a{:href => "#Witten96"} Witten 96, top of p. 9
          %p
            More precisely, this
            = succeed "-gauge" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sp(1)
            %a.existingWikiWord{:href => "/nlab/show/non-perturbative+effect"} non-perturbative effect
            invisible in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/perturbative+string+theory"} perturbative string theory
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/SemiSpin%2832%29"} SemiSpin(32)
            %a.existingWikiWord{:href => "/nlab/show/E8"} E8
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ×
                %annotation{:encoding => "application/x-tex"} \times
            = succeed "-gauge" do
              %a.existingWikiWord{:href => "/nlab/show/E8"} E8
            %a.existingWikiWord{:href => "/nlab/show/perturbative+string+theory"} perturbative
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
          %p
            There this interpretation of small instantons as
            %a.existingWikiWord{:href => "/nlab/show/wrapped+brane"} wrapped
            5-branes really pertains to
            %a.existingWikiWord{:href => "/nlab/show/M5-branes"} M5-branes
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/heterotic+M-theory"} heterotic M-theory
          %p
            %strong> In F-theory
            \. Under
            %a.existingWikiWord{:href => "/nlab/show/duality+between+F-theory+and+heterotic+string+theory"} duality between F-theory and heterotic string theory
            the argument of
            %a{:href => "#Witten96"} Witten 96
            was claimed to be confirmed in
            = succeed "," do
              %a{:href => "#AspinwallGross96"} Aspinwall-Gross 96
            = succeed "." do
              %a{:href => "#AspinwallMorrison97"} Aspinwall-Morrison 97
          %p
            %strong In Type I.
            On the other hand, under
            %a.existingWikiWord{:href => "/nlab/show/duality+between+type+I+and+heterotic+string+theory"} duality between type I and heterotic string theory
            one expects to see
            %a.existingWikiWord{:href => "/nlab/show/duality+in+string+theory"} dually
            as a phenomenon visible in perturbative
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+I+string+theory"} type I string theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/D5-D9-brane+bound+states"} D5-D9-brane bound states
            %a.existingWikiWord{:href => "/nlab/show/Dp-D%28p%2B4%29-brane+bound+states"} Dp-D(p+4)-brane bound states
            are argued to exhibit instantons in the
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            gauge theory of the
            = succeed "-brane," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
