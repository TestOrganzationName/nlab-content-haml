            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/k-tuply+monoidal+%28n%2Cr%29-category"} category
            %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
            to identify
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
