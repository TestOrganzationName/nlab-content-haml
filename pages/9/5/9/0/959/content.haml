                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+n-type"} homotopy n-types
          %h2#definitions Definitions
          %h3#categorytheoretic Category-theoretic
          %p
            Invoking the delooping hypothesis, we define a
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              \-tuply groupal
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            to be a
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+k)
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalent
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo &lt;
                    %mi k
                  %annotation{:encoding => "application/x-tex"} j \lt k
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            = succeed "-morphisms." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (j-k)
            = succeed "-groupoid." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+k)
          %p
            The given point serves as an equivalence between
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-1)
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n,r)
            %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-category"} category
            for these), so there is nothing to say if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ≤
                  %mn 0
                %annotation{:encoding => "application/x-tex"} k \leq 0
            except that the category is pointed. Thus we may as well assume that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k \geq 0
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stabilization+hypothesis"} stabilisation hypothesis
            = succeed "-tuply" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo &gt;
                  %mi n
                  %mo +
                  %mn 2
                %annotation{:encoding => "application/x-tex"} k \gt n + 2
            may be reinterpreted as an
            = succeed "-tuply" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+2)
            = succeed "-groupoid." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k \geq 0
          %h3#homotopytheoretic Homotopy-theoretic
          %p
            Invoking the homotopy hypothesis, we define a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/k-tuply+monoidal+n-groupoid"} k-tuply monoidal n-groupoid
            to be an
            = succeed ":" do
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi k
                    %annotation{:encoding => "application/x-tex"} E_k
                \-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-type
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            which is a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+n-type"} homotopy n-type
            and which is equipped with an action by the
            %a.existingWikiWord{:href => "/nlab/show/little+n-cubes+operad"} little k-cubes
            %a.existingWikiWord{:href => "/nlab/show/operad"} operad
            (or some operad equivalent to it). The
            = succeed "-tuply" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %span.newWikiWord
              grouplike
              %a{:href => "/nlab/new/grouplike+topological+monoid"} ?
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi k
                  %annotation{:encoding => "application/x-tex"} E_k
            = succeed "." do
              %span.newWikiWord
                spaces
                %a{:href => "/nlab/new/E-k-space"} ?
          %p
            It is a classical theorem of homotopy theory that grouplike
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi k
                  %annotation{:encoding => "application/x-tex"} E_k
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
            = succeed ")." do
              %em The Geometry of Iterated Loop Spaces
          %h3#special_cases Special cases
          %p
