                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                            %mo ×
                            %mi I
                            %mo ×
                            %mi Y
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; &amp; X \times Y &amp; &amp; &amp; &amp; X \times Y &amp; &amp;
                    \\\
                    \&amp; \mathllap{\pi_1} \swarrow &amp; &amp; \searrow \mathrlap{i_0} &amp; &amp; \mathllap{i_1} \swarrow &amp; &amp; \searrow \mathrlap{\pi_2} &amp;
                    \\\
                    X &amp; &amp; &amp; &amp; X \times I \times Y &amp; &amp; &amp; &amp; Y
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} i_0
              is the inclusion
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mn 0
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x, y) \mapsto (x, 0, y)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} i_1
              is the inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mn 1
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x, y) \mapsto (x, 1, y)
          %p
            (This in turn, by the discussion at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
            of the two projections
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ←
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \leftarrow X \times Y \to Y
          %p
            Intuitively,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⋆
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \star Y
            is the union of all line segments connecting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            when these are placed in general position in an ambient
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
          %p
            The join is
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} associative
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ,
                  %mi Z
                %annotation{:encoding => "application/x-tex"} X, Y, Z
            is the union of 2-
            %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
            whose vertices lie in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ,
                  %mi Z
                %annotation{:encoding => "application/x-tex"} X, Y, Z
            respectively when these are placed in general position. Thus the join endows
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
            with a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            structure whose unit is the empty space.
          %h2#milnors_join_construction Milnor’s join construction
          %p
            There is another topology on the join of spaces, due to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/John+Milnor"} John Milnor
            %em
              %a.existingWikiWord{:href => "/nlab/show/Milnor+construction"} Milnor construction
            of
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundles"} universal principal bundles
            (
            %a{:href => "#Milnor1956"}> Milnor 1956, section 2
            ):
          #MilnorJoin.num_defn
            %h6#definition_3 Definition
            %p
              Milnor’s join
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⋆
                      %mo ¯
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \overline{\star} Y
              has the same underlying set as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⋆
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \star Y
              and the
              %a.existingWikiWord{:href => "/nlab/show/coarsest+topology"} coarsest topology
              which makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mover
                      %mo ⋆
                      %mo ¯
                    %mi Y
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} t \colon X \overline{\star} Y \to [0,1]
              (given on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi I
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times I \times Y
              by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi t
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi t
                    %annotation{:encoding => "application/x-tex"} (x,t,y)\mapsto t
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              on
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi t
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \pi_1 \colon t^{-1}([0,1)) \to X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi t
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \pi_2 \colon t^{-1}((0,1]) \to Y
              continuous.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p\colon X \to S
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p\colon Y \to S
              are spaces over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %em fibrewise join
              or
              %em Whitney sum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mover
                        %mo ⋆
                        %mo ¯
                      %mi S
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \overline{\star}_S Y
              is the space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ∈
                      %mi X
                      %mover
                        %mo ⋆
                        %mo ¯
                      %mi Y
                      %mo :
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ⇒
                      %mi p
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{ x \in X \overline{\star} Y : t(x) \in (0,1) \implies p(\pi_1(x))=q(\pi_2(y)) \}
          %p
            The inclusions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↪
                  %mi X
                  %mover
                    %mo ⋆
                    %mo ¯
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \hookrightarrow X \overline{\star} Y
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo ↪
                  %mi X
                  %mover
                    %mo ⋆
                    %mo ¯
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y \hookrightarrow X \overline{\star} Y
            are
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Hurewicz+cofibration"} closed Hurewicz cofibrations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi t
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} t^{-1}[[0,1)]
            deforms onto
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi t
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} t^{-1}[(0,1]]
            deforms onto
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          %p
          .num_prop
            %h6 Proposition
            %p
              The identity map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⋆
                    %mi Y
                    %mo →
                    %mi X
                    %mover
                      %mo ⋆
                      %mo ¯
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \star Y \to X \overline{\star} Y
              is a homotopy equivalence. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              are compact, then it is a homeomorphism.
          (See
          = succeed ")" do
            %a{:href => "#FG2004"} Fritsch–Golasiński 2004, section 1
          %p
          #FibrewiseJoinOfFibrationsIsFibration.num_prop
            %h6 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p \colon X \to S
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} q \colon Y \to S
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hurewicz+fibration"} Hurewicz fibrations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mover
                        %mo ⋆
                        %mo ¯
                      %mi S
                    %mi Y
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} X \overline{\star}_S Y \to S
          (See
          = succeed "," do
            %a{:href => "#Hall1965"} Hall 1965
          = succeed ")" do
            %a{:href => "#Lemmens1970"} Lemmens 1970, theorem I
          %h2#examples Examples
          .num_example
            %h6#example Example
            %p
              The join of any topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with the
              %a.existingWikiWord{:href => "/nlab/show/point"} point
              is the
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
              on
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⋆
                    %mn 1
                    %mo =
                    %mi C
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \star 1 =  C X
                    \\,.
          #JoinWith0Sphere.num_example
            %h6#example_2 Example
            %p
              The join of any topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with the
              %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} S^0
              is the
              %a.existingWikiWord{:href => "/nlab/show/suspension"} (unreduced) suspension
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⋆
                    %msup
                      %mi S
                      %mn 0
                    %mo ≅
                    %mi S
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \star S^0 \cong S X
                    \\,.
          .num_example
            %h6#example_3 Example
            %p
              The join of
              %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              with each other is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi m
                    %mo ⋆
                    %msup
                      %mi S
                      %mi n
                    %mo ≅
                    %msup
                      %mi S
                      %mrow
                        %mi m
                        %mo +
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    S^m \star S^n \cong S^{m+n+1}
          .num_example
            %h6#example_4 Example
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %msup
                        %mi S
                        %mn 1
                      %mo ,
                      %mi Y
                      %mo =
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} X = S^1, Y = S^1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to consist of
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo +
                    %mi b
                    %mi i
                  %annotation{:encoding => "application/x-tex"} a + b i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              to consist of quaternions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mi j
                    %mo +
                    %mi d
                    %mi k
                  %annotation{:encoding => "application/x-tex"} c j + d k
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi a
                        %mn 2
                      %mo +
                      %msup
                        %mi b
                        %mn 2
                      %mo =
                      %mn 1
                      %mo =
                      %msup
                        %mi c
                        %mn 2
                      %mo +
                      %msup
                        %mi d
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} a^2 + b^2 = 1 = c^2 + d^2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              are in general position in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℍ
                    %mo ≅
                    %msup
                      %mi ℝ
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \mathbb{H} \cong \mathbb{R}^4
              with respect to each other, and the quotient map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi I
                    %mo ×
                    %mi Y
                    %mo →
                    %msup
                      %mi S
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} X \times I \times Y \to S^3
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo +
                    %mi b
                    %mi i
                    %mo ,
                    %mi t
                    %mo ,
                    %mi c
                    %mo +
                    %mi d
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msup
                      %mi t
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo +
                    %mi b
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mi t
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo +
                    %mi d
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a + b i, t, c + d i) \mapsto t^{1/2}(a + b i) + (1 - t)^{1/2}(c + d i)
            %p
              is an explicit realization of the
              %a.existingWikiWord{:href => "/nlab/show/unit+sphere"} unit sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} S^3
              as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⋆
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \star Y
          .num_example
            %h6#example_5 Example
            %p
              For a topological group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/Milnor+construction"} Milnor construction
              of the total space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi G
                  %annotation{:encoding => "application/x-tex"} E G
              of the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying bundle
              is an iterated join, i.e., the colimit of a diagram of inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %mi G
                    %mover
                      %mo ⋆
                      %mo ¯
                    %mi G
                    %mo →
                    %mi G
                    %mover
                      %mo ⋆
                      %mo ¯
                    %mi G
                    %mover
                      %mo ⋆
                      %mo ¯
                    %mi G
                    %mo →
                    %mi …
                  %annotation{:encoding => "application/x-tex"} G \to G \overline{\star} G \to G \overline{\star} G \overline{\star} G \to \ldots
            %p
              where the identity element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is used to embed each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mrow
                        %mover
                          %mo ⋆
                          %mo{:stretchy => "false"} ¯
                        %mi n
                  %annotation{:encoding => "application/x-tex"} G^{\bar \star n}
              into its successor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi G
                        %mrow
                          %mover
                            %mo ⋆
                            %mo{:stretchy => "false"} ¯
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G^{\bar \star (n+1)}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            %p
              The same idea applies to a general space
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "-space" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/associahedron"} Stasheff operad
              %a.existingWikiWord{:href => "/nlab/show/Hopf+construction"} Hopf construction
              giving the first stage of the iteration.
          .num_example
            %h6#example_6 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p \colon X \to Y
              is a fibration, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              factors as a
              %a.existingWikiWord{:href => "/nlab/show/Hurewicz+cofibration"} Hurewicz cofibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↪
                    %mi X
                    %msub
                      %mover
                        %mo ⋆
                        %mo ¯
                      %mi Y
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \hookrightarrow X \overline{\star}_Y Y
              followed by an
              %a.existingWikiWord{:href => "/nlab/show/acyclic+fibration"} acyclic
              %a.existingWikiWord{:href => "/nlab/show/Hurewicz+fibration"} Hurewicz fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mover
                        %mo ⋆
                        %mo ¯
                      %mi Y
                    %mi Y
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \overline{\star}_Y Y \to Y
              by proposition
              = succeed ":" do
                %a.maruku-ref{:href => "#FibrewiseJoinOfFibrationsIsFibration"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ↪
                    %mi X
                    %msub
                      %mover
                        %mo ⋆
                        %mo ¯
                      %mi Y
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y \hookrightarrow X \overline{\star}_Y Y
              and retraction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mover
                        %mo ⋆
                        %mo ¯
                      %mi Y
                    %mi Y
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \overline{\star}_Y Y \to Y
              exhibit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              as a strong deformation retract of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %msub
                        %mover
                          %mo ⋆
                          %mo ¯
                        %mi Y
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \overline{\star}_Y Y
            %p
              (This fact is used in Strøm’s construction of his
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/Str%C3%B8m+model+structure"} model structure on topological spaces
          %h2#related_concepts Related concepts
          %ul
