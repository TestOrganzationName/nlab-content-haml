            and a point of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            (with some suitable topology).
          %h2#definition Definition
          #PushoutJoin.num_defn
            %h6#definition_2 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} I \coloneqq [0,1]
              for the unit
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/interval"} interval
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X,Y
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %a.existingWikiWord{:href => "/nlab/show/join"} join
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⋆
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \star Y
              is the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of the
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                            %mo ×
                            %mi Y
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                            %mo ×
                            %mi Y
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi π
                                  %mn 1
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                          %mtd
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi i
                                  %mn 1
                            %mo ↙
