              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi,h)
              of a group homomorphism and an element of the domain.
            %p
              We claim that the
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-functor"} (2,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
              takes such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi,h)
              to the homomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ad
                        %mrow
                          %msup
                            %mi h
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                      %mo ∘
                      %mi ϕ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi G
                      %mo ⟶
                      %mi H
                    %annotation{:encoding => "application/x-tex"} Ad_{h^{-1}} \circ \phi \;\colon\; G \longrightarrow H
              %a.maruku-ref{:href => "#piAs2Functor"}
              this functor as forming loops:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
