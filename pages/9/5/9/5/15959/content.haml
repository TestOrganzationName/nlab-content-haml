            %p
              But since, by the previous argument, the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
              takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo ,
                    %msub
                      %mi h
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi_1,h_1)
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ad
                        %mrow
                          %msubsup
                            %mi h
                            %mn 1
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                      %mo ∘
                      %msub
                        %mi ϕ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} Ad_{h_1^{-1}} \circ \phi_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo ,
                    %msub
                      %mi h
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi_1,h_1)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo ,
                    %msub
                      %mi h
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi_2,h_2)
              are taken to the same group homomorphism by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ad
                      %mrow
                        %msubsup
                          %mi h
                          %mn 2
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mo ∘
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo =
                    %msub
                      %mi Ad
                      %mrow
                        %msup
                          %mi h
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo ⋅
                        %msubsup
                          %mi h
                          %mn 1
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mo ∘
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo =
                    %msub
                      %mi Ad
                      %mrow
                        %msubsup
                          %mi h
                          %mn 1
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mo ∘
                    %msub
                      %mi ϕ
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ad_{h_2^{-1}} \circ \phi_2
                    \=
                    Ad_{h^{-1}\cdot h_1^{-1}}\circ \phi_2
                    \=
                    Ad_{h_1^{-1}} \circ \phi_1
                    \\,.
            %p
              This establishes that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
              is also an equivalence on all
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hom-groupoids"} hom-groupoids
          %p
            This proof also shows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}(-)
            is in fact the inverse equivalence:
          #1GroupsEquivalentToPointedConnected1Types.num_cor
            %h6#corollary Corollary
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%282%2C1%29-categories"} equivalence of (2,1)-categories
              between pointed connected groupoids and plain groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grp
                    %mover
                      %munder
                        %mo ⟶
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                      %munderover
                        %mo ⟵
                        %mo ≃
                        %mrow
                          %msub
                            %mi π
                            %mn 1
                          %mo =
                          %msub
                            %mi Ω
                            %mo *
                    %msubsup
                      %mi Grpd
                      %mrow
                        %mo ≥
                        %mn 1
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    Grp
                    \\stackrel{\underoverset{\simeq}{\pi_1 = \Omega_\ast}{\longleftarrow}}{\underset{\mathbf{B}}{\longrightarrow}}
                    Grpd^{\ast/}_{\geq 1}
            %p
              given by forming
              %a.existingWikiWord{:href => "/nlab/show/loop+space+objects"} loop space objects
              and by forming deloopings.
          %h5#topological_and_lie_groups Topological and Lie groups
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/smooth+group"} smooth group
          %h4#2groups 2-Groups
          %p
            With the above perspective on ordinary groups, it is now essentially clear what
            %a.existingWikiWord{:href => "/nlab/show/infinity-groups"} higher groups
            in
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            are to be. We discuss this in full generality below, but of course it serves to highlight the first higher case, that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-groups"} 2-groups
          %p
            The idea is clear: where a group is equivalently a pointed connected
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+1-type"} homotopy 1-type
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            in that it is the
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            of such a pointed connected type, a
            %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
            is equivalently a pointed connected
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+2-type"} homotopy 2-type
            %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            in that it is its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
          %p
            In general this means that a
            %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
            is a
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            that is equipped with the structure of a group for which the usual axioms (
            %a.existingWikiWord{:href => "/nlab/show/associativity"}> associativity
            ,
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/inverses"} inverses
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherent
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/weak+2-groups"} weak 2-groups
          %p
            But it turns out that in this low degree there is not too much space for such weakening to happen. Indeed, every
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            %a.existingWikiWord{:href => "/nlab/show/homotopy+2-type"} homotopy 2-type
            has a model by a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/strict+2-groupoid"} strict 2-groupoid
            = succeed "." do
              %em
                %a{:href => "homotopy+hypothesis#For2Groupoids"} homotopy hypothesis – for homotopy 2-types
            %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
            is equivalent to one which is a
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            equipped with strict group structure, where the axioms hold “on the nose”. The algebraic data encoded by such is known as a
            %em
              %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
            of groups.
          %h5#discrete Discrete
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
          %h5#braided_and_abelian Braided and abelian
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/braided+2-group"} braided 2-group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/symmetric+2-group"} symmetric 2-group
          %h4#SimplicialGroups Simplicial groups
          %h5#discrete_2 Discrete
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
          %h5#abelian Abelian
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
          %h5#topological_and_lie_simplicial_groups Topological and Lie simplicial groups
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+space"} simplicial topological space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+simplicial+topological+spaces"} geometric realization of simplicial topological spaces
          %h4#chain_complexes_and_spectra Chain complexes and Spectra
          %h5#chain_complexes_and_the_doldkan_correspondence Chain complexes and the Dold-Kan correspondence
          %p
            At
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+homotopy+types"} geometry of physics – homotopy types
            is discussed how the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            allows to think of
            %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            in non-negative degree as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
            %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
            underlying
            %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+groups"} simplicial abelian groups
            which are
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            to the chain complexes, via the
            %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complex"} normalized chain complex
            operation, see the section
            = succeed "." do
              %em
                %a{:href => "geometry%20of%20physics%20--%20homotopy%20types#DoldKanCorrespondence"} geometry of physics – homotopy types – Dold-Kan correspondence
          %p
            But by the discussion
            %a{:href => "#SimplicialGroups"} above
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+groups"} simplicial groups
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+%E2%88%9E-groups"} abelian ∞-groups
          %p (…)
          %h5#spectra_and_the_stable_doldkan_correspondence Spectra and the stable Dold-Kan correspondence
          %p
            While, under the
            = succeed "," do
              %span.newWikiWord
                Dold-Kan correspondences
                %a{:href => "/nlab/new/Dold-Kan+correspondences"} ?
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+%E2%88%9E-groups"} abelian ∞-groups
            %a.existingWikiWord{:href => "/nlab/show/abelian+%E2%88%9E-groups"} abelian ∞-groups
            is the concept called
            %em
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+types"} stable homotopy types
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/stable+Dold-Kan+correspondence"} stable Dold-Kan correspondence
          %h4#group_cohomology Group cohomology
          %h5#discrete_group_cohomology Discrete group cohomology
          %p
            One of the remarkable conceptual simplifications brought about by general
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            pertains to the general concept of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            %a.existingWikiWord{:href => "/nlab/show/derived+hom+space"} (infinity,1)-categorical hom spaces
            in a suitable
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"} (infinity,1)-topos
          %p
            Specifically for the case of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                  %mo ∈
                  %mi KanCplx
                %annotation{:encoding => "application/x-tex"}
                  (\mathbf{B}^n A)_\bullet \in KanCplx
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            underlying the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            which is the image of the
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} A[-1]
            concentrated on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            under the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi DK
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi Ch
                    %mrow
                      %mo •
                      %mo ≥
                      %mn 0
                  %mo{:stretchy => "false"} (
                  %mi Ab
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mo ≃
                  %mi sAb
                  %mover
                    %mo ⟶
                    %mi forget
                  %mi KanCplx
                %annotation{:encoding => "application/x-tex"} DK \colon Ch_{\bullet \geq 0}(Ab)\stackrel{\simeq}{\longrightarrow} sAb \stackrel{forget}{\longrightarrow} KanCplx
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                  %mo ≔
                  %mi DK
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\mathbf{B}^n A)_\bullet
                  \\coloneqq
                  DK(A[-n])
                  \\,.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                  %mo ∈
                  %mi KanCplx
                %annotation{:encoding => "application/x-tex"}
                  (\mathbf{B}G)_\bullet \in KanCplx
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            of the
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                  %mover
                    %mo ⟶
                    %mo ⟶
                  %mo *
                %annotation{:encoding => "application/x-tex"} G\stackrel{\longrightarrow}{\longrightarrow} \ast
            ).
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+homotopy+types"} geometry of physics – homotopy types
            for detailed discussion of these two constructions.
          .num_prop
            %h6#propositiondefinition Proposition/Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              in
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is equivalently a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbf{B}G)_\bullet \longrightarrow (\mathbf{B}^n A)_\bullet
                    \\,.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              between two such morphisms is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
              between two such cocycles.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
              %a.existingWikiWord{:href => "/nlab/show/cohomology+group"} group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of cocycles modulo coboundaries, hence is the connected components of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi Grp
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
