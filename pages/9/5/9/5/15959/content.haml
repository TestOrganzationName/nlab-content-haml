                          %mtd
                            %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                            %msub
                              %mo ⇙
                              %mi h
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi ϕ
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \ast
                    \\\
                    \&amp; \swarrow &amp;\swArrow_{h}&amp; \searrow
                    \\\
                    \\mathbf{B}G
                    \&amp;&amp;
                    \\underset{\mathbf{B}\phi}{\longrightarrow}
                    \&amp;&amp;
                    \\mathbf{B}H
                    }
            %p
              where the
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              is equivalently just the choice of an element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
