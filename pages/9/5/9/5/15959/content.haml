          #SkeletalRepresentativesForConnectedGroupoids.num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Grp
                      %mrow
                        %mo ≥
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} Grp_{\geq 1}
              of connected groupoids is equivalent to its
              %a.existingWikiWord{:href => "/nlab/show/full+sub-%28infinity%2C1%29-category"} full sub-(2,1)-category
              on those objects of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a group.
          .proof
            %h6#proof Proof
            %p
              Given a connected groupoid
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x\in X
              and consider the canonical inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}\pi_1(X,x) \longrightarrow X
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
              and by assumption of connectedness it is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
          #HomsBetweenBGs.num_prop
            %h6#proposition_2 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoids"} hom-groupoids
              between connected groupoids with fundamental groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.existingWikiWord{:href => "/nlab/show/action+groupoids"} action groupoids
              of the set of group
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G \to H
              %a.existingWikiWord{:href => "/nlab/show/action"} acted
              on by
              %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
              with elements of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
