                    \\longrightarrow
                    Grp(\pi_1(X,x), \pi_1(Y,y))
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hom-groupoids"} hom-groupoids
              %a.maruku-ref{:href => "#SkeletalRepresentativesForConnectedGroupoids"}
              it is sufficient to check this for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X = \mathbf{B}G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi H
                  %annotation{:encoding => "application/x-tex"} Y = \mathbf{B}H
              with their canonical basepoints, hence to check that for any two groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ,
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G,H
              the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
