          %p
            Introducing the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
            construction
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \overline{W}G
          %ul
            %li#MacLane54
              %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
              ,
              = succeed "," do
                %em Constructions simpliciales acycliques
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/MacLaneConstructionsSimplicialesAcycliques.pdf", :title => "pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/homotopy+2-types"} homotopy 2-types
            (N.B. their 3-type is the modern 2-type)
          %ul
            %li#WhiteheadMacLane50
              (with
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/J.+H.+C.+Whitehead"} J. H. C. Whitehead
              = succeed "," do
                %em On the 3-type of a complex
              %strong 36
              (1950) 41-48
          %p
            On
            = succeed ":" do
