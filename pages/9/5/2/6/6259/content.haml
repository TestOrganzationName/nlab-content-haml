                %a.existingWikiWord{:href => "/nlab/show/Pietro+Grassi"} Pietro Grassi
              %em Self-Dual Forms in Supergeometry I: The Chiral Boson
              (
              %a{:href => "https://arxiv.org/abs/2012.10243"}> arXiv:2012.10243
              )
          %h3#for_the_m5sigma_model For the M5-sigma model
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            description of the (single) M5-brane of
            = succeed "-type" do
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+action+functional"} Green-Schwarz action functional
          %ul
            %li#BLNPST97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Igor+Bandos"}> Igor Bandos
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kurt+Lechner"} Kurt Lechner
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexei+Nurmagambetov"} Alexei Nurmagambetov
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paolo+Pasti"} Paolo Pasti
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dmitri+Sorokin"} Dmitri Sorokin
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mario+Tonin"} Mario Tonin
                = succeed "," do
                  %em Covariant Action for the Super-Five-Brane of M-Theory
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9701149"} arXiv:hep-th/9701149
            %li#PST97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paolo+Pasti"}> Paolo Pasti
                ,
                %a.existingWikiWord{:href => "/nlab/show/Dmitri+Sorokin"} Dmitri Sorokin
                and M. Tonin,
                = succeed "," do
                  %em Covariant Action for a D=11 Five-Brane with the Chiral Field
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9701037"} arXiv:hep-th/9701037
          %p following
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"}> Paul Townsend
                , section 3.3 of
                = succeed "," do
                  %em D-branes from M-branes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9512062"} arXiv:hep-th/9512062
              %p
                (which did not yet have the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Hopf-Wess-Zumino+term"} Hopf-Wess-Zumino term
          %p
            and following the non-covariant form of the
            %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+field"} self-duality mechanism
            (
            %a.existingWikiWord{:href => "/nlab/show/Perry-Schwarz+action"}> Perry-Schwarz action
            ) of
          %ul
            %li#PerrySchwarz96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Malcolm+Perry"}> Malcolm Perry
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
                = succeed "," do
