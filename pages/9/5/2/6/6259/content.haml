                \:
                %a.existingWikiWord{:href => "/nlab/show/11-dimensional+Chern-Simons+theory"} 11-dimensional Chern-Simons theory
                (of
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
                which are
                %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
                in (
                %a.existingWikiWord{:href => "/nlab/show/twisted+differential+K-theory"}> twisted differential
                )
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/complex+K-theory"} complex K-theory
                %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
                on its boundary (or that of the space-filling
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/D9-brane"} D9-brane
                = succeed ")." do
                  %a{:href => "#BelovMooreII"} Belov-Moore 06b
          %h4#ConformalStructureFromPolarization Conformal structure from polarization
          %p
            We indicate why
            %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+theory"} higher dimensional Chern-Simons theory
            is – if holographically related to anything – holographically related to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual higher gauge theory
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            of
            %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+theory"} higher dimensional Chern-Simons theory
            in
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 4
                  %mi k
                  %mo +
                  %mn 3
                %annotation{:encoding => "application/x-tex"} 4k+3
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo ×
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \Sigma \times \mathbb{R}
            can be identified with the space of
            %a.existingWikiWord{:href => "/nlab/show/curvature"} flat
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi k
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 2k+1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"} presymplectic form
            on this space is given by the pairing
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi δ
                  %msub
                    %mi B
                    %mn 1
                  %mo ,
                  %mi δ
                  %msub
                    %mi B
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msub
                    %mo ∫
                    %mi Σ
                  %mi δ
                  %msub
                    %mi B
                    %mn 1
                  %mo ∧
                  %mi δ
                  %msub
                    %mi B
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  (\delta B_1, \delta B_2) \mapsto
                  \\int_\Sigma \delta B_1 \wedge \delta B_2
          %p
            obtained as the
            %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            of the
            %a.existingWikiWord{:href => "/nlab/show/wedge+product"} wedge product
            of the two forms.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
            of the theory requires that we choose a
            %a.existingWikiWord{:href => "/nlab/show/polarization"} polarization
            of the
            %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
            of this space (split the space of forms into “
            %a.existingWikiWord{:href => "/nlab/show/canonical+coordinates"}> canonical coordinates
            ” and their “
            %a.existingWikiWord{:href => "/nlab/show/canonical+momenta"}> canonical momenta
            ”).
          %p
            One way to achieve this is to choose a
            %a.existingWikiWord{:href => "/nlab/show/conformal+structure"} conformal structure
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                  %mo :
                  %msup
                    %mi Ω
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Ω
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\star : \Omega^{2k+1}(\Sigma) \to \Omega^{2k+1}(\Sigma)
          %p provides the polarization by splitting into self-dual and anti-self-dual forms:
          %p
            notice that (by
            %a{:href => "Hodge+star+operator#eq:HodgeSquareOnRiemannian"} this Formula
            formulas at
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                  %mo ⋆
                  %mi B
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mn 4
                      %mi k
                      %mo +
                      %mn 3
                      %mo{:stretchy => "false"} )
                  %mi B
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\star \star B = (-1)^{(2k+1)(4k+3)} B
                  \= - B
                  \\,.
          %p
            Therefore it provides a
            %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex structure
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \Omega^{2k+1}(\Sigma) \otimes \mathbb{C}
          %p We see that the symplectic structure on the space of forms can equivalently be rewritten as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mo ∫
                            %mi X
                          %msub
                            %mi B
                            %mn 1
                          %mo ∧
                          %msub
                            %mi B
                            %mn 2
                        %mtd
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo ∫
                            %mi X
                          %msub
                            %mi B
                            %mn 1
                          %mo ∧
                          %mo ⋆
                          %mo ⋆
                          %msub
                            %mi B
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\int_X B_1 \wedge B_2
                  \&amp; = - \int_X B_1 \wedge \star \star B_2
                  \\end{aligned}
                  \\,.
          %p
            Here on the right now the
            %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge inner product
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mn 1
                %annotation{:encoding => "application/x-tex"} B_1
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                  %msub
                    %mi B
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \star B_2
            appears, which is invariant under applying the Hodge star to both arguments.
          %p
            We then decompose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^{2k+1}(\Sigma)
            into the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ±
                    %mi i
                  %annotation{:encoding => "application/x-tex"} \pm i
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/eigenspace"} eigenspace
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ∈
                  %msup
                    %mi Ω
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B \in \Omega^{2k+1}(\Sigma)
            is
            %em imaginary self-dual
            if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                  %mi B
                  %mo =
                  %mi i
                  %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\star B = i B
          %p
            and
            %em imaginary anti-self-dual
            if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                  %mi B
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi i
                  %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\star B = - i B
                  \\,.
          %p
            Then for imaginary self-dual
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mn 1
                %annotation{:encoding => "application/x-tex"} B_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mn 2
                %annotation{:encoding => "application/x-tex"} B_2
            we find that the symplectic pairing is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi B
                            %mn 1
                          %mo ,
                          %msub
                            %mi B
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi i
                          %msub
                            %mo ∫
                            %mi X
                          %msub
                            %mi B
                            %mn 1
                          %mo ∧
                          %mo ⋆
                          %msub
                            %mi B
                            %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi i
                          %msub
                            %mo ∫
                            %mi X
                          %mo{:stretchy => "false"} (
                          %mo ⋆
                          %msub
                            %mi B
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %mo ⋆
                          %mo{:stretchy => "false"} (
                          %mo ⋆
                          %msub
                            %mi B
                            %mn 2
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mi i
                          %msub
                            %mo ∫
                            %mi X
                          %msub
                            %mi B
                            %mn 1
                          %mo ∧
                          %mo ⋆
                          %msub
                            %mi B
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  (B_1, B_2)
                  \&amp;=
                  \-i \int_X B_1 \wedge \star B_2
                  \\\
                  \&amp; =
                  \-i \int_X (\star B_1) \wedge \star (\star B_2)
                  \\\
                  \&amp; =
                  +i \int_X B_1 \wedge \star B_2
                  \\end{aligned}
                  \\,.
          %p
            Therefore indeed the symplectic pairing vanishes on the self-dual and on the anti-selfdual forms. Evidently these provide a decomposition into
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+subspaces"} Lagrangian subspaces
          %p
            (See also at
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Serre+duality"} Serre duality
          %p
            Therefore a
            %a.existingWikiWord{:href => "/nlab/show/state"} state
            of higher Chern-Simons theory on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            may locally be thought of as a function of the self-dual forms on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %a.existingWikiWord{:href => "/nlab/show/correlator"} correlator
            of a
            %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual higher gauge theory
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          %h3#PartitionFunction Partition function
          %p
            By the above discussion (…) the
            %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
            of self-dual higher gauge theory is given by (a multiple of) the unique
            %a.existingWikiWord{:href => "/nlab/show/holomorphic+section"} holomorphic section
            of a
            %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
            of the
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            classified by the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/secondary+intersection+pairing"} secondary intersection pairing
            = succeed "," do
              %a{:href => "#Witten96"} Witten 96
            = succeed ")." do
              %a{:href => "#HopkinsSinger"} Hopkins-Singer
          %h3#cohomological_description Cohomological description
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/moduli+spaces"} moduli spaces
                of
                %a.existingWikiWord{:href => "/nlab/show/line+n-bundles+with+connection"} line n-bundles with connection
                on
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %table
              %thead
                %tr
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+object"} Calabi-Yau n-fold
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/line+n-bundle"} line n-bundle
                  %th
                    moduli of
                    %a.existingWikiWord{:href => "/nlab/show/line+n-bundles"} line n-bundles
                  %th
                    moduli of
                    = succeed "/degree-0" do
                      %a.existingWikiWord{:href => "/nlab/show/flat+infinity-connection"} flat
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/Artin-Mazur+formal+group"} Artin-Mazur formal group
                    of
                    %a.existingWikiWord{:href => "/nlab/show/deformation+theory"} deformation moduli
                    of
                    %a.existingWikiWord{:href => "/nlab/show/line+n-bundles"} line n-bundles
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/modular+functor"}> modular functor
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual higher gauge theory
                    of
                    %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+theory"} higher dimensional Chern-Simons theory
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} n = 0
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/unit"} unit
                    in
                    %a.existingWikiWord{:href => "/nlab/show/structure+sheaf"} structure sheaf
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"}> multiplicative group
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/formal+multiplicative+group"} formal multiplicative group
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/complex+K-theory"} complex K-theory
                  %td{:style => "text-align: left;"}
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo =
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n = 1
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
                  %td{:style => "text-align: left;"}
