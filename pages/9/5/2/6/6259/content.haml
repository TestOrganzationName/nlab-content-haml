                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Picard+group"}> Picard group
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/Picard+scheme"} Picard scheme
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Jacobian"} Jacobian
                  %td{:style => "text-align: left;"}
