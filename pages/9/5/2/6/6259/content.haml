                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Brauer+group"} Brauer group
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/intermediate+Jacobian"} intermediate Jacobian
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/formal+Brauer+group"} formal Brauer group
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/K3+cohomology"} K3 cohomology
                  %td{:style => "text-align: left;"}
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo =
                          %mn 3
                        %annotation{:encoding => "application/x-tex"} n = 3
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+3-fold"} Calabi-Yau 3-fold
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/line+3-bundle"} line 3-bundle
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/intermediate+Jacobian"} intermediate Jacobian
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+cohomology"} CY3 cohomology
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/7d+Chern-Simons+theory"}> 7d Chern-Simons theory
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/intermediate+Jacobian"} intermediate Jacobian
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
          %h2#examples Examples
          %h3#ChiralBosonin2d Chiral boson in 2d (on the string)
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} k = 0
            the self-dual theory abelian is that of a
            %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            on a real-2-dimensional surface
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \mathbf{d}\phi
            is self-dual. For any
            %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex structure
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+torus"} complex torus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            a “chiral” boson, in the sense of a chiral half of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/WZW+model"} WZW model
          %p
            Original discussion is due to
            = succeed "," do
              %a{:href => "#Srivastava89"} Srivastava 1989
            = succeed "." do
              %a{:href => "#GGR92"} GGR 1992
            = succeed "." do
              %a{:href => "#Witten96"} Witten 96, section 2
            %a{:href => "#GBMNV"} GBMNV
            = succeed "," do
              %a{:href => "#MiaoMüller-Kirsten00"} Miao &amp; Müller-Kirsten 2000
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/AdS3-CFT2+and+CS-WZW+correspondence"} AdS3-CFT2 and CS-WZW correspondence
          %h3#chiral_2form_in_6d_on_the_m5brane Chiral 2-form in 6d (on the M5-brane)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            theory of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/6d+%282%2C0%29-superconformal+QFT"} 6d (2,0)-superconformal QFT
            %a{:href => "AdS-CFT#AdS7CFT6"} AdS7-CFT6 holographic
            description by 7-dimensional Chern-Simons theory is due to (
            %a{:href => "#Witten96"}> Witten 96
            ).
          %div
            %h3#relation_between_5d_maxwell_theory_and_selfdual_3forms_in_6d Relation between 5d Maxwell theory and self-dual 3-forms in 6d
            %p
              Consider 5d- and 6d-dimensional
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              equipped with global
              %a.existingWikiWord{:href => "/nlab/show/orthonormal+basis"} orthonormal
              %a.existingWikiWord{:href => "/nlab/show/coordinate+charts"} coordinate charts
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi x
                        %mi κ
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{x^\kappa\}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi x
                        %mi α
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{x^\alpha\}
              %a.existingWikiWord{:href => "/nlab/show/isometry"} isometric
              %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds"} embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 4
                                %mo ,
                                %mn 1
                          %mtd
                            %mover
                              %mo ↪
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %msub
                                  %mi ι
                                  %mn 5
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 5
                                %mo ,
                                %mn 1
                        %mtr
                          %mtd
                            %mi κ
                            %mo =
                          %mtd
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo ,
                            %mn 2
                            %mo ,
                            %mn 3
                            %mo ,
                            %mn 4
                            %mphantom
                              %mo ,
                        %mtr
                          %mtd
                            %mi α
                            %mo =
                          %mtd
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo ,
                            %mn 2
                            %mo ,
                            %mn 3
                            %mo ,
                            %mn 4
                            %mo ,
                          %mtd
                          %mtd
                            %mn 5
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;
                    \\mathbb{R}^{4,1}
                    \&amp;\overset{\;\;\;\iota_5\;\;\;}{\hookrightarrow}&amp;
                    \\mathbb{R}^{5,1}
                    \\\
                    \\kappa = &amp;   0, 1, 2, 3, 4\phantom{,}
                    \\\
                    \\alpha = &amp; 0, 1, 2, 3, 4, &amp;&amp; 5
                    }
            %p
              With this notation, the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
              along this embedding is notationally implicit.
            %p
              Now any
              %a.existingWikiWord{:href => "/nlab/show/differential+3-form"} differential 3-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} H_3
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 5
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{5,1}
              decomposes as
            #eq:5dDecompositionof3Form.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi F
                      %mo ^
                    %mo ∧
                    %mi d
                    %msup
                      %mi x
                      %mn 5
                    %mo +
                    %mover
                      %mi H
                      %mo ^
                  %annotation{:encoding => "application/x-tex"}
                    H_3
                    \\;=\;
                    \\widehat{F} \wedge d x^{5}
                    +
                    \\widehat{H}
            %p for unique differential forms of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msub
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %msub
                          %mi κ
                          %mn 1
                        %msub
                          %mi κ
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi κ
                    %mo ,
                    %msup
                      %mi x
                      %mn 5
                    %mo{:stretchy => "false"} )
                    %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi κ
                          %mn 1
                    %mo ∧
                    %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi κ
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat F
                    \\;=\;
                    \\tfrac{1}{2}\hat F_{\kappa_1 \kappa_2}(x^\kappa, x^5)
                    d x^{\kappa_1} \wedge d x^{\kappa_2}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi H
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mn 3
                          %mo !
                    %msub
                      %mover
                        %mi H
                        %mo ^
                      %mrow
                        %msub
                          %mi κ
                          %mn 1
                        %msub
                          %mi κ
                          %mn 2
                        %msub
                          %mi κ
                          %mn 3
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi κ
                    %mo ,
                    %msup
                      %mi x
                      %mn 5
                    %mo{:stretchy => "false"} )
                    %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi κ
                          %mn 1
                    %mo ∧
                    %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi κ
                          %mn 2
                    %mo ∧
                    %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi κ
                          %mn 3
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{H}
                    \\;=\;
                    \\tfrac{1}{3!} \widehat{H}_{\kappa_1 \kappa_2 \kappa_3}(x^\kappa, x^5)
                    d x^{\kappa_1} \wedge d x^{\kappa_2} \wedge d x^{\kappa_3}
                    \\,.
            %p
              In the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} H_3
              has vanishing
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
              along the
              = succeed "-direction," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mn 5
                    %annotation{:encoding => "application/x-tex"} x^5
            #eq:VanishingLieDerivateiveAlongx5.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mn 5
                    %msub
                      %mi H
                      %mn 3
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}_5 H_3 \;=\; 0
            %p
              then also these components forms do not depend on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mn 5
                  %annotation{:encoding => "application/x-tex"} x^5
              are actualls
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullbacks
              of differential forms on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 4
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{4,1}
            %p
              In terms of this decomposition, the 6d
              %a.existingWikiWord{:href => "/nlab/show/Hodge+dual"} Hodge dual
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} H_3
              is equivalently given by the 5d
              %a.existingWikiWord{:href => "/nlab/show/Hodge+duals"} Hodge duals
              of these components as (best seen by the relation to
              %a.existingWikiWord{:href => "/nlab/show/Hodge+pairing"} Hodge pairing
              according to
              = succeed ")" do
                %a{:href => "Hodge+star+operator#HodgePairing"} this Prop.
            #eq:6dHodgeDualityInTermsOf5d.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋆
                      %mn 6
                    %msub
                      %mi H
                      %mn 3
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mo ⋆
                      %mn 5
                    %mover
                      %mi H
                      %mo ^
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ∧
                    %mi d
                    %msup
                      %mi x
                      %mn 5
                    %mo −
                    %msub
                      %mo ⋆
                      %mn 5
                    %mover
                      %mi F
                      %mo ^
                  %annotation{:encoding => "application/x-tex"}
                    \\star_6 H_3
                    \\;=\;
                    \\big( \star_5 \widehat{H}\big) \wedge d x^{5}
                    \-
                    \\star_5 \widehat{F}
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
              squares to unity in the special case that it is applied to differential 3-forms on 6d Minkowski spacetime (by
              = succeed ")" do
                %a{:href => "Hodge+star+operator#HodgeStarFollowedByHodgeStar"} this Prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋆
                      %mn 6
                    %msub
                      %mo ⋆
                      %mn 6
                    %msub
                      %mi H
                      %mn 3
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %msub
                      %mi H
                      %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    \\star_6 \star_6 H_3 \;=\; + H_3
            %p
              we may ask for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} H_3
              to he
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hodge+duality"} Hodge self-dual
              %a.maruku-eqref{:href => "#eq:6dHodgeDualityInTermsOf5d"} (3)
              this means equivalently that its 5d components are 5d Hodge duals of each other:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi H
                      %mn 3
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ⋆
                      %mn 6
                    %msub
                      %mi H
                      %mn 3
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ⇔
                      %mrow
                        %msub
                          %mi H
                          %mn 3
                        %mo =
                        %mover
                          %mi F
                          %mo ^
                        %mo ∧
                        %mi d
                        %msup
                          %mi x
                          %mn 5
                        %mo +
                        %mover
                          %mi H
                          %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mover
                      %mi H
                      %mo ^
                    %mo =
                    %msub
                      %mo ⋆
                      %mn 5
                    %mover
                      %mi F
                      %mo ^
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    H_3
                    \\;=\;
                    \\star_{6} H_3
                    \\big)
                    \\;\;\;
                    \\overset{
                    H_3 = \widehat{F} \wedge d x^5 + \widehat{H}
                    }{
                    \\Leftrightarrow
                    }
                    \\;\;\;
                    \\big(
                    \\widehat{H} = \star_5 \widehat{F}
                    \\big)
                    \\,.
            %p
              It follows that if there is no
              = succeed "-dependence" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mn 5
                    %annotation{:encoding => "application/x-tex"} x^5
              %a.maruku-eqref{:href => "#eq:VanishingLieDerivateiveAlongx5"} (2)
              then the condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} H_3
              be a
              %a.existingWikiWord{:href => "/nlab/show/closed+differential+form"} closed
              and
              %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual 3-form
              is equivalent to its 5d components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{F}
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mover
                      %mi H
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{H}
              ) being the (dual)
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
              %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
              satisfying the
              %a.existingWikiWord{:href => "/nlab/show/Maxwell+equations"} Maxwell equations
              of
              %a.existingWikiWord{:href => "/nlab/show/D%3D5+Maxwell+theory"} D=5 Maxwell theory
              (without
              %a.existingWikiWord{:href => "/nlab/show/source+fields"} source
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/conserved+current"} current
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                                %mi d
                                %msub
                                  %mi H
                                  %mn 3
                                %mo =
                                %mn 0
                            %mtr
                              %mtd
                              %mtd
                                %msub
                                  %mo ⋆
                                  %mn 6
                                %msub
                                  %mi H
                                  %mn 3
                                %mo =
                                %msub
                                  %mi H
                                  %mn 3
                        %mo }
                      %mstyle{:mathcolor => "blue"}
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mphantom
                              %mi A
                          %mrow
                            %mtext D=6 self-dual 3-form theory
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ⇔
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %msub
                              %mi ℒ
                              %mn 5
                            %msub
                              %mi H
                              %mn 3
                            %mo =
                            %mn 0
                        %mrow
                          %mrow
                            %msub
                              %mi H
                              %mn 3
                            %mo =
                            %mover
                              %mi F
                              %mo ^
                            %mo ∧
                            %mi d
                            %msup
                              %mi x
                              %mn 5
                            %mo +
                            %mi ⋯
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                                %mi d
                                %mover
                                  %mi F
                                  %mo ^
                                %mo =
                                %mn 0
                            %mtr
                              %mtd
                              %mtd
                                %mi d
                                %msub
                                  %mo ⋆
                                  %mn 5
                                %mover
                                  %mi F
                                  %mo ^
                                %mo =
                                %mn 0
                      %mstyle{:mathcolor => "blue"}
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mphantom
                              %mi A
                          %mrow
                            %mtext D=5 Maxwell theory
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    \\color{blue}
                    {
                    {\phantom{A}}
                    \\atop
                    {\text{D=6 self-dual 3-form theory}}
                    }
                    }{
                    \\left.
                    \\array{
                    \&amp;
                    d H_3 = 0
                    \\\
                    \&amp;
                    \\star_6 H_3 = H_3
                    }
                    \\right\}
                    }
                    \\;\;\;
                    \\overset{
                    {\mathcal{L}_{5} H_3 = 0}
                    \\atop
                    {H_3 = \widehat{F}\wedge d x^5 + \cdots}
                    }{
                    \\Leftrightarrow
                    }
                    \\;\;\;
                    \\underset{
                    \\color{blue}
                    {
                    {\phantom{A}}
                    \\atop
                    \\text{D=5 Maxwell theory}
                    }
                    }{
                    \\left\{
                    \\array{
                    \&amp;
                    d \widehat{F} = 0
                    \\\
                    \&amp;
                    d \star_5 \widehat{F} = 0
                    }
                    \\right.
                    }
            %p
              This may be summarized as saying that the massless part of the
              %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+reduction"} Kaluza-Klein reduction
              of
              %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual 3-form theory
              from 6d to 5d is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/D%3D5+Maxwell+theory"} D=5 Maxwell theory
            %p
              Essentially this relation underlies the formulation of the
              %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
              via the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Perry-Schwarz+Lagrangian"} Perry-Schwarz Lagrangian
          %h3#RRFieldsin10d RR-Fields in 10d (on the “9-brane”)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
            in
            %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
            (by the idea of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/K-theory+classification+of+D-brane+charge"} K-theory classification of D-brane charge
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            in (
            %a.existingWikiWord{:href => "/nlab/show/differential+K-theory"}> differential
            )
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            (cf. at
            %em
              %a.existingWikiWord{:href => "/nlab/show/pre-metric+electromagnetism"} pre-metric electromagnetism
            the
            = succeed ")." do
              %em
                %a{:href => "pre-metric+electromagnetism#RRFieldInGravitationalBackground"} section on RR-fields
          %p
            The proper discussion of these fields hence involves generalizing the above story from
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            and
            %a.existingWikiWord{:href => "/nlab/show/principally+polarized+variety"} principally polarized
            %a.existingWikiWord{:href => "/nlab/show/intermediate+Jacobians"} intermediate Jacobians
            to an analog in
            %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology"} Whitehead-generalized cohomology
            such as
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            and an appropriate generalized form of intermediate Jacobians (cf.
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hodge-filtered+differential+cohomology"} Hodge-filtered differential cohomology
          %p
            (Of course one may, as a warmup, “approximate” K-theory classes on a 10-manifold by integral cohomology lifts of the degree-5 component of their
            %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
            and hence discuss that as abelian self-dual higher gauge theory in dimension 10. This is discussed in (
            %a{:href => "#Witten99"}> Witten 99, section 4
            )).
          %p
            The relevant analog of the
            %a.existingWikiWord{:href => "/nlab/show/intermediate+Jacobian"} intermediate Jacobian
            for K-theory on a 10-manifold is naturally taken to be
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mi ℤ
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  K(X)\otimes_{\mathbb{Z}} \mathbb{R}/ K(X)
          %p
            (where the action is via the
            = succeed "/realification" do
              %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo →
                    %mi K
                    %mo ⊗
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} K \to K \otimes \mathbb{R}
          %p
            This is proposed and discussed in (
            %a{:href => "#Witten99"}> Witten 99, section 4.3
            ,
            = succeed "," do
              %a{:href => "#MooreWitten99"} Moore-Witten 99, section 3
            = succeed "," do
              %a{:href => "#MW00"} DMW 00, section 7.1
            = succeed "," do
              %a{:href => "#BelovMooreII"} Belov-Moore 06b, section 5
            = succeed "):" do
              %a{:href => "#MSP11"} MPS 11
          %p
            where for ordinary cohomology the (
            %a.existingWikiWord{:href => "/nlab/show/quadratic+refinement"} quadratic refinement
            of the)
            %a.existingWikiWord{:href => "/nlab/show/intersection+product"} intersection product
            (=
            %a.existingWikiWord{:href => "/nlab/show/Deligne-Beilinson+cup+product"} Deligne-Beilinson cup product
            followed by
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+ordinary+differential+cohomology"} fiber integration in ordinary differential cohomology
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+structure"} symplectic structure
            %a.existingWikiWord{:href => "/nlab/show/polarized+variety"} polarization
            of the intermediate Jacobian, here it is tensoring of
            %a.existingWikiWord{:href => "/nlab/show/Dirac+operators"} Dirac operators
            followed by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+differential+K-theory"} fiber integration in differential K-theory
            %a.existingWikiWord{:href => "/nlab/show/index+of+a+Dirac+operator"} index
            map in K-theory.
          %p
            See at
            = succeed "." do
              %em
                %a{:href => "intermediate+Jacobian#ForComplexKTheory"} intermediate Jacobian – For complex K-theory
