                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/elliptic+cohomology"} elliptic cohomology
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/3d+Chern-Simons+theory"}> 3d Chern-Simons theory
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/WZW+model"} WZW model
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo =
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} n = 2
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/K3+surface"} K3 surface
                  %td{:style => "text-align: left;"}
