                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9806062"} arXiv:hep-th/9806062
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mans+Henningson"}> Mans Henningson
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bengt+Nilsson"} Bengt Nilsson
                %em Holomorphic factorization of correlation functions in (4k+2)-dimensional (2k)-form gauge theory
                (
                %a{:href => "http://arxiv.org/abs/hep-th/9908107"}> arXiv:hep-th/9908107
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mans+Henningson"}> Mans Henningson
                ,
                %em
                  The quantum Hilbert space of a chiral two-form in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
