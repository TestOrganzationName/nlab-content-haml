          %h2#references References
          %h3#general General
          %p Original articles on the general issue include
          %ul
            %li#HenneauxTeitelboim88
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+Henneaux"}> Marc Henneaux
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Claudio+Teitelboim"} Claudio Teitelboim
                = succeed "," do
                  %em
                    Dynamics of chiral (self-dual)
                    = succeed "-forms" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
                %strong 206
                4 (1988) 650-654 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0370-2693(88)90712-5"}> doi:10.1016/0370-2693(88)90712-5
                \&amp;rbrack;
            %li#PastiSorokinTonin06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paolo+Pasti"}> Paolo Pasti
                ,
                = succeed "," do
