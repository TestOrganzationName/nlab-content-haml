            %li#BelovMooreI
              %p
                Dmitriy Belov,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Greg+Moore"} Greg Moore
                %em Holographic Action for the Self-Dual Field
                \&amp;lbrack;
                %a{:href => "http://arxiv.org/abs/hep-th/0605038"}> arXiv:hep-th/0605038
                \&amp;rbrack;
          %p Surveys include
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Greg+Moore"}> Greg Moore
                ,
                = succeed "," do
                  %em A Minicourse on Generalized Abelian Gauge Theory, Self-Dual Theories, and Differential Cohomology
                = succeed ")" do
                  %a{:href => "http://www.physics.rutgers.edu/~gmoore/SCGP-Minicourse.pdf"} pdf
            %li#Szabo12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Szabo"}> Richard Szabo
                ,
