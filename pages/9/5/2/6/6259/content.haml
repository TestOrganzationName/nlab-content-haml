                %em World-Volume Action of the M Theory Five-Brane
                (
                %a{:href => "http://arxiv.org/abs/hep-th/9701166"}> arXiv:hep-th/9701166
                )
          %p
            Discussion in the
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/superembedding+approach"} superembedding approach
          %ul
            %li#HoweSezgin97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+S.+Howe"}> Paul S. Howe
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi D
                          %mo =
                          %mn 11
                        %annotation{:encoding => "application/x-tex"} D=11
                    ,
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo =
                          %mn 5
                        %annotation{:encoding => "application/x-tex"} p=5
                %strong 394
                (1997) 62-66 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9611008"}> arXiv:hep-th/9611008
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/S0370-2693(96)01672-3"} doi:10.1016/S0370-2693(96)01672-3
            %li#Sorokin99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dmitri+Sorokin"}> Dmitri Sorokin
                , Section 5.2 of
                = succeed "," do
                  %em Superbranes and Superembeddings
                %strong 329
                (2000) 1-101 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/hep-th/9906142"}> arXiv:hep-th/9906142
                \&amp;rbrack;
          %p
            Amplification that the resulting B-field on the M5-brane is
            %em not naively
            self-dual:
          %ul
            %li#HoweSezginWest97
              %a.existingWikiWord{:href => "/nlab/show/Paul+S.+Howe"}> Paul S. Howe
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+C.+West"} Peter C. West
              = succeed "," do
                %em The six-dimensional self-dual tensor
              %strong 400
              3–4 (1997) 255-259 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/S0370-2693(97)00365-1"}> doi:10.1016/S0370-2693(97)00365-1
              \&amp;rbrack;
          %p Discussion of the equivalence of these superficially different action functionals is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Igor+Bandos"}> Igor Bandos
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kurt+Lechner"} Kurt Lechner
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alexei+Nurmagambetov"} Alexei Nurmagambetov
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paolo+Pasti"} Paolo Pasti
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dmitri+Sorokin"} Dmitri Sorokin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mario+Tonin"} Mario Tonin
              = succeed "," do
                %em On the equivalence of different formulations of the M Theory five–brane
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/9703127"} arXiv:hep-th/9703127
          %h3#for_ordinary_higher_gauge_fields__ordinary_differential_cohomology
            For ordinary
            = succeed "-higher" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
          %p
            Self-duality for higher abelian gauge fields (in
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
          %p Original reference on self-dual/chiral fields include
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Xavier+Bekaert"}> Xavier Bekaert
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Marc+Henneaux"} Marc Henneaux
                = succeed "," do
                  %em
                    Comments on Chiral
                    = succeed "-Forms" do
