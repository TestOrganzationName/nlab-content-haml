                      %annotation{:encoding => "application/x-tex"} U \in T
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ∈
                      %mi T
                    %annotation{:encoding => "application/x-tex"} V \in T
                such that for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} a \in S
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} b \in S
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %msub
                          %mo ∼
                          %mi U
                        %mi b
                      %annotation{:encoding => "application/x-tex"} a \sim_U b
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %msub
                          %mo ∼
                          %mi V
                        %mi b
                      %annotation{:encoding => "application/x-tex"} a \sim_V b
            %li
              %p
                For every element
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ∈
                        %mi T
                      %annotation{:encoding => "application/x-tex"} U \in T
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ∈
                      %mi T
                    %annotation{:encoding => "application/x-tex"} V \in T
                such that for all elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} a \in S
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} b \in S
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %msub
                        %mo ∼
                        %mi U
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a \sim_U b
                or
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ¬
                        %mo{:stretchy => "false"} (
                        %mi a
                        %msub
                          %mo ∼
                          %mi V
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \neg (a \sim_V b)
          %p Examples of these structures include
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/uniformly+locally+decomposable+spaces"} uniformly locally decomposable spaces
                satisfy all 7 axioms.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/uniform+spaces"} uniform spaces
                satisfy axioms 1-6
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quasiuniformly+locally+decomposable+spaces"} quasiuniformly locally decomposable spaces
                satisfy axioms 1, 2, and 4-7
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quasiuniform+spaces"} quasiuniform spaces
                satisfy axioms 1, 2, and 4-6
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/preuniform+spaces"} preuniform spaces
                satisfy axioms 1-3
            %li
              %p
                %span.newWikiWord
                  quasipreuniform spaces
                  %a{:href => "/nlab/new/quasipreuniform+spaces"} ?
                satisfy axioms 1 and 2
          %h3#euclidean_spaces  Euclidean spaces
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ordered+integral+domain"} ordered integral domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
            %a.existingWikiWord{:href => "/nlab/show/rank"} rank
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            with
            %a.existingWikiWord{:href => "/nlab/show/basis"} basis
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo :
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} X:\mathrm{Fin}(n) \to V
            and
            %a.existingWikiWord{:href => "/nlab/show/positive+definite"} positive definite
            %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear
            %a.existingWikiWord{:href => "/nlab/show/inner+product+space"} inner product
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo :
                    %mi V
                    %mo ×
                    %mi V
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \langle -, -\rangle:V \times V \to R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi X
                    %mi i
                  %mo ,
                  %msub
                    %mi X
                    %mi j
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %msubsup
                    %mi δ
                    %mi i
                    %mi j
                %annotation{:encoding => "application/x-tex"} \langle X_i, X_j \rangle = \delta_i^j
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi δ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo :
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"} \delta_{(-)}^{(-)}:\mathrm{Fin}(n) \times \mathrm{Fin}(n) \to R
            is the
            %a.existingWikiWord{:href => "/nlab/show/Kronecker+delta"} Kronecker delta
            indexed by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Fin}(n)
          %p
            We define the Euclidean premetric
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %msub
                    %mo ∼
                    %mi ϵ
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \sim_\epsilon b
            indexed by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} a \in V
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} b \in V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo ∈
                  %msub
                    %mi R
                    %mo +
                %annotation{:encoding => "application/x-tex"} \epsilon \in R_+
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %msub
                    %mo ∼
                    %mi ϵ
                  %mi b
                  %mo ≔
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 0
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} ⟨
                  %mi a
                  %mo −
                  %mi b
                  %mo ,
                  %msub
                    %mi X
                    %mi i
                  %msup
                    %mo{:stretchy => "false"} ⟩
                    %mn 2
                  %mo &lt;
                  %msup
                    %mi ϵ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} a \sim_\epsilon b \coloneqq \sum_{i = 0}^{n - 1} \langle a - b, X_i\rangle^2 \lt \epsilon^2
          %p
            which makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
          %h3#convergence Convergence
          %p
            Every
            = succeed "-premetric" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/generalised+sequential+space"} generalised sequential space
            with the convergence relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo →
                  %mi b
                %annotation{:encoding => "application/x-tex"} x \to b
            between sequences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            true if and only if for all elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi T
                  %annotation{:encoding => "application/x-tex"} U \in T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
            such that for all natural numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mi N
                  %annotation{:encoding => "application/x-tex"} n \geq N
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi n
                    %msub
                      %mo ∼
                      %mi U
                    %mi b
                  %annotation{:encoding => "application/x-tex"} x_n \sim_U b
          %p
            Given a
            = succeed "-premetric" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mo ∼
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (S, \sim)
            and a sequence
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi ℕ
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{N} \to S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo :
                  %mi T
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} M:T \to \mathbb{N}
            such that for all elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                  %mi T
                %annotation{:encoding => "application/x-tex"} U \in T
            and for all natural numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo ≥
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} m \geq M(\epsilon)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} n \geq M(\epsilon)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi m
                    %msub
                      %mo ∼
                      %mi U
                    %msub
                      %mi x
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x_m \sim_U x_n
          %p
            A
            = succeed "-premetric" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/sequentially+complete"} sequentially complete
            if every
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequence"} Cauchy sequence
            has a unique limit. A
            = succeed "-premetric" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/regularly+sequentially+complete"} regularly sequentially complete
            if every sequence with a modulus of Cauchy convergence has a unique limit.
          %p
            All this could be generalised to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/nets"} nets
            = succeed "-premetric" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/generalised+net+space"} generalised net space
            with the convergence relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo →
                  %mi b
                %annotation{:encoding => "application/x-tex"} x \to b
            between nets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            true if and only if for all elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                  %mi T
                %annotation{:encoding => "application/x-tex"} U \in T
            and
            %a.existingWikiWord{:href => "/nlab/show/directed+sets"} directed sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo ∈
                  %mi I
                %annotation{:encoding => "application/x-tex"} N \in I
            such that for all elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mi N
                  %annotation{:encoding => "application/x-tex"} n \geq N
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi n
                    %msub
                      %mo ∼
                      %mi U
                    %mi b
                  %annotation{:encoding => "application/x-tex"} x_n \sim_U b
          %h2#see_also See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/premetric+space"} premetric space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richman+premetric+space"} Richman premetric space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+structure"} Cauchy structure
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
          %h2#references References
          %ul
            %li#Booij20
              %a.existingWikiWord{:href => "/nlab/show/Auke+Booij"}> Auke Booij
              ,
              %em Analysis in Univalent Type Theory
              (2020) &amp;lbrack;
