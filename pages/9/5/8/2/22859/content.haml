                    %mo ,
                    %mi Δ
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (!A, \Delta, \epsilon)
              is a
              %a.existingWikiWord{:href => "/nlab/show/cocommutative+comonoid"} cocommutative comonoid
              in
