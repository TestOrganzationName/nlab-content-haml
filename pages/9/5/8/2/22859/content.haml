            %p It expresses that the second differential of a function is invariant by permutation of the two variables with respect to we differentiate successively.
            %h3#examples_2 Examples
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              is a field, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Vect
                      %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} Vect_{\mathbb{K}}
              is a codifferential category.
            %ul
              %li
                We define
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} S(A) = Sym(A)
                %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} symmetric algebra
                of the vector space
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
              %li It is a commutative algebra as usual.
              %li
                The unit
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \rightarrow Sym(A)
                of the monad is just the injection
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ↦
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x \mapsto x
              %li
                The multiplication
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sym(Sym(A)) \rightarrow Sym(A)
                of the monad is given on pure tensors by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi x
                          %mn 1
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi s
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mo ⊗
                          %mi s
                        %msubsup
                          %mi x
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊠
                          %mi s
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mo ⊠
                          %mi s
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi x
                          %mn 1
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi s
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mo ⊗
                          %mi s
                        %msubsup
                          %mi x
                          %mrow
                            %msub
                              %mi n
                              %mi p
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ↦
                        %msubsup
                          %mi x
                          %mn 1
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi s
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mo ⊗
                          %mi s
                        %msubsup
                          %mi x
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mo .
                        %mo .
                        %mo .
                        %mo ⊗
                        %msubsup
                          %mi x
                          %mn 1
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi s
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mo ⊗
                          %mi s
                        %msubsup
                          %mi x
                          %mrow
                            %msub
                              %mi n
                              %mi p
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (x_{1}^{(1)} \otimes_{s} ... \otimes_{s} x_{n_{1}}^{(1)}) \boxtimes_{s} ... \boxtimes_{s}  (x_{1}^{(p)} \otimes_{s} ... \otimes_{s} x_{n_{p}}^{(p)}) \mapsto x_{1}^{(1)} \otimes_{s} ... \otimes_{s} x_{n_{1}}^{(1)} \otimes ... \otimes x_{1}^{(p)} \otimes_{s} ... \otimes_{s} x_{n_{p}}^{(p)}
              %li
                The deriving transformation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi A
                    %annotation{:encoding => "application/x-tex"} Sym(A) \rightarrow Sym(A) \otimes A
                is defined on pure tensors by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mn 1
                        %msub
                          %mo ⊗
                          %mi s
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mo ⊗
                          %mi s
                        %msub
                          %mi x
                          %mi n
                        %mo ↦
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mn 1
                            %mo ≤
                            %mi k
                            %mo ≤
                            %mi n
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 1
                        %msub
                          %mo ⊗
                          %mi s
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mo ⊗
                          %mi s
                        %msub
                          %mi x
                          %mrow
                            %mi k
                            %mo −
                            %mn 1
                        %msub
                          %mo ⊗
                          %mi s
                        %msub
                          %mi x
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                        %msub
                          %mo ⊗
                          %mi s
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mo ⊗
                          %mi s
                        %msub
                          %mi x
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %msub
                          %mi x
                          %mi k
                      %annotation{:encoding => "application/x-tex"} x_{1} \otimes_{s} ... \otimes_{s} x_{n} \mapsto \underset{1 \le k \le n}{\sum}(x_{1} \otimes_{s} ... \otimes_{s} x_{k-1} \otimes_{s} x_{k+1} \otimes_{s} ... \otimes_{s} x_{n}) \otimes x_{k}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                      %mo ,
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} X,Y,Z
                is a basis of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi X
                          %mn 2
                        %mo +
                        %mi YZ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 2
                        %mi X
                        %mo ⊗
                        %mi X
                        %mo +
                        %mi Y
                        %mo ⊗
                        %mi Z
                        %mo +
                        %mi Z
                        %mo ⊗
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} d(X^{2}+YZ) = 2X \otimes X + Y \otimes Z + Z \otimes Y
            %p
              The free
              = succeed "-ring" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\infty}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              provides a structure of codifferential category on
              = succeed "." do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Vect
                          %mi ℝ
                      %annotation{:encoding => "application/x-tex"} Vect_{\mathbb{R}}
            %h2#differential_categories_vs_codifferential_categories Differential categories vs codifferential categories
            %p
              The deriving transformation in a codifferential category is a natural transformation of type
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo !
                      %mi A
                      %mo →
                      %mo !
                      %mi A
                      %mo ⊗
                      %mi A
                    %annotation{:encoding => "application/x-tex"} !A \rightarrow !A \otimes A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mn 2
                      %mo +
                      %mi YZ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 2
                      %mi X
                      %mo ⊗
                      %mi X
                      %mo +
                      %mi Y
                      %mo ⊗
                      %mi Z
                      %mo +
                      %mi Z
                      %mo ⊗
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} d(X^{2}+YZ) = 2X \otimes X + Y \otimes Z + Z \otimes Y
            %p
              It would seem more natural to have a deriving transformation of type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo !
                    %mi A
                    %mo →
                    %mo !
                    %mi A
                    %mo ⊗
                    %msup
                      %mi A
                      %mo *
                  %annotation{:encoding => "application/x-tex"} !A \rightarrow !A \otimes A^{*}
              and to require the category to be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%2A-autonomous"} *-autonomous
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mn 2
                      %mo +
                      %mi YZ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 2
                      %mi X
                      %mo ⊗
                      %mi dX
                      %mo +
                      %mi Y
                      %mo ⊗
                      %mi dZ
                      %mo +
                      %mi Z
                      %mo ⊗
                      %mi dY
                    %annotation{:encoding => "application/x-tex"} d(X^{2}+YZ) = 2X \otimes dX + Y \otimes dZ + Z \otimes dY
              %a.existingWikiWord{:href => "/nlab/show/graded+codifferential+category"} graded codifferential category
              can help to enlighten why the type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo !
                    %mi A
                    %mo →
                    %mo !
                    %mi A
                    %mo ⊗
                    %mi A
                  %annotation{:encoding => "application/x-tex"} !A \rightarrow !A \otimes A
              is in fact more natural. If we start with an element of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi th
                  %annotation{:encoding => "application/x-tex"} (n+1)^{th}
              symmetric power
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi A
                  %annotation{:encoding => "application/x-tex"} S_{n+1}A
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/homogeneous+polynomial"} homogeneous polynomial
              of degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n+1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi n
                    %mi A
                    %mo ⊗
                    %mi A
                  %annotation{:encoding => "application/x-tex"} S_{n}A \otimes A
              and not of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mi n
                      %mi A
                      %mo ⊗
                      %msup
                        %mi A
                        %mo *
                    %annotation{:encoding => "application/x-tex"} S_{n}A \otimes A^{*}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
              (symmetrized) elements of type
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              elements (with a symmetrization performed on the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              first here) and not
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n-1
              (here it would be
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              elements together with a “minus” element in
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mo *
                    %annotation{:encoding => "application/x-tex"} A^*
            %p
              If we wish to obtain a more natural typing, we need to use differential categories. In a differential category, the differential of a smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo !
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} !A \rightarrow B
              is given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ;
                      %mi f
                      %mo :
                      %mo !
                      %mi A
                      %mo ⊗
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} d;f:!{A} \otimes A \rightarrow B
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%2A-autonomous+category"} *-autonomous category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo !
                    %mi A
                    %mo →
                    %mi B
                    %mo ⅋
                    %msup
                      %mi A
                      %mo *
                  %annotation{:encoding => "application/x-tex"} !A \rightarrow B \parr A^*
              using the dual tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⅋
                  %annotation{:encoding => "application/x-tex"} \parr
              defined by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⅋
                      %mi B
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi A
                        %mo *
                      %mo ⊗
                      %msup
                        %mi B
                        %mo *
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} A \parr B = (A^* \otimes B^*)^*
            %p
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/differential+linear+logic"} differential linear logic
            %li
              %p
