                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mi R
                  %annotation{:encoding => "application/x-tex"} Alg_R
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %msub
                      %mi Vect
                      %mi R
                  %annotation{:encoding => "application/x-tex"} 2Vect_R
              (see at
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/2-vector+space"} 2-vector space
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/2-module"} 2-module
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebras
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  are
                  %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
                  over
                  = succeed "-algebras;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                  are bimodule homomorphisms.
          .num_remark
            %h6#remark Remark
            %p
              This may be understood as the 2-category of (generalized)
              %a.existingWikiWord{:href => "/nlab/show/2-vector+bundles"} 2-vector bundles
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spec
                      %mi R
                    %annotation{:encoding => "application/x-tex"} Spec R
              %a.existingWikiWord{:href => "/nlab/show/Isbell+duality"} formally dual
              %a.existingWikiWord{:href => "/nlab/show/space"} space
              whose
              %a.existingWikiWord{:href => "/nlab/show/function+algebra"} function algebra
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal 2-category
          .num_defn
            %h6#definition_2 Definition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Br
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Alg
                      %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Br}(R) \coloneqq Core(Alg_R)
            %p
              be its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Picard+3-group"} Picard 3-group
              %a.existingWikiWord{:href => "/nlab/show/infinity-group"} 3-group
              inside (which is hence a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/braided+3-group"} braided 3-group
              %a.existingWikiWord{:href => "/nlab/show/core"} core
              on the invertible objects, hence the
              %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are algebras which are invertible up to
                  %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"} Morita equivalence
                  under tensor product;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  are
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Morita+equivalences"} Morita equivalences
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                  are invertible bimodule homomorphisms.
          .num_remark
            %h6#remark_2 Remark
            %p
              This may be understood as the 2-groupoid of (generalized)
              %a.existingWikiWord{:href => "/nlab/show/line+2-bundles"} line 2-bundles
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mi R
                  %annotation{:encoding => "application/x-tex"} Spec R
              (for instance
              %a.existingWikiWord{:href => "/nlab/show/holomorphic+line+2-bundles"} holomorphic line 2-bundles
              in the case of
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/higher+complex+analytic+geometry"} higher complex analytic geometry
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/2-vector+bundles"} 2-vector bundles
          .num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Br
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Br}(R)
              are the following:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi Br
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_0(\mathbf{Br}(R))
                  is the Brauer group of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi Br
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_1(\mathbf{Br}(R))
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Picard+group"} Picard group
                  of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi Br
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_2(\mathbf{Br}(R))
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
          %p
            See for instance (
            %a{:href => "#Street"}> Street
            ).
          .num_example
            %h6#example Example
            %p
              Analogous statements hold for (non-commutative)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/superalgebras"} superalgebras
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/graded+algebras"} graded algebras
              = succeed "." do
                %em
                  %a{:href => "super+algebra#Picard2Groupoid"} superalgebra – Picard 3-group, Brauer group
          %h3#RelationToEtaleCohomology Relation to étale cohomology
          %p
            The Brauer group of a
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            %a.existingWikiWord{:href => "/nlab/show/torsion"} torsion
            subgroup of the second
            %a.existingWikiWord{:href => "/nlab/show/etale+cohomology"} etale cohomology
            group of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mi R
                %annotation{:encoding => "application/x-tex"} Spec R
            with values in the
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔾
                    %mi m
                %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Br
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msubsup
                    %mi H
                    %mi et
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi 𝔾
                    %mi m
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Br(X) \hookrightarrow H^2_{et}(X, \mathbb{G}_m)
                  \\,.
          %p
            This was first stated in (
            %a{:href => "#Grothendieck68"}> Grothendieck 68
            ) (see also
            %a{:href => "#Grothendieck64"} Grothendieck 64, prop. 1.4
            and see at
            = succeed ")." do
              %em
                %a{:href => "algebraic+line+n-bundle#Properties"} algebraic line n-bundle – Properties
            = succeed ")." do
              %a{:href => "#Milne"} Milne, chapter IV
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
            is in (
            %a{:href => "#Giraud"}> Giraud
            ).
          %p
            A theorem stating conditions under which the Brauer group is precisely the
            %a.existingWikiWord{:href => "/nlab/show/torsion"} torsion
            subgroup of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi et
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi 𝔾
                    %mi m
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^2_{et}(X, \mathbb{G}_m)
            is due to (
            %a{:href => "#Gabber"}> Gabber
            ), see also the review in (
            %a{:href => "#deJong"}> de Jong
            ). For more details and more literature on this see (
            %a{:href => "#Bertuccioni"}> Bertuccioni
            ).
          %p This fits into the following pattern
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi H
                        %mi et
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ,
                      %msub
                        %mi 𝔾
                        %mi m
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi R
                        %mo ×
                    %annotation{:encoding => "application/x-tex"} H^0_{et}(R, \mathbb{G}_m) = R^\times
                (
                %a.existingWikiWord{:href => "/nlab/show/group+of+units"}> group of units
                )
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi H
                        %mi et
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ,
                      %msub
                        %mi 𝔾
                        %mi m
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Pic
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^1_{et}(R, \mathbb{G}_m) = Pic(R)
                (
                %a.existingWikiWord{:href => "/nlab/show/Picard+group"}> Picard group
                \: iso classes of invertible
                = succeed "-modules)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi H
                        %mi et
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ,
                      %msub
                        %mi 𝔾
                        %mi m
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi tor
                      %mo =
                      %mi Br
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^2_{et}(R, \mathbb{G}_m)_{tor} = Br(R)
                (
                %a.existingWikiWord{:href => "/nlab/show/Brauer+group"}> Brauer group
                \:
                %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"} Morita equivalence
                classes of
                %a.existingWikiWord{:href => "/nlab/show/Azumaya+algebras"} Azumaya algebras
                over
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Brauer+stack"} Brauer stack
          %p
            It is therefore natural to regard all of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi et
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %msub
                    %mi 𝔾
                    %mi m
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^2_{et}(R, \mathbb{G}_m)
            as the “actual” Brauer group. This has been called the “
            %a.existingWikiWord{:href => "/nlab/show/bigger+Brauer+group"}> bigger Brauer group
            ” (
            %a{:href => "#Taylor82"}> Taylor 82
            ,
            = succeed "," do
              %a{:href => "#CaenepeelGrandjean98"} Caenepeel-Grandjean 98
            = succeed ")." do
              %a{:href => "#HeinlothSchoeer08"} Heinloth-Schöer 08
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/formal+Brauer+group"} formal Brauer group
            = succeed "-version" do
              %a.existingWikiWord{:href => "/nlab/show/formal+geometry"} formal geometry
          %h3#RelationToDerivedEtaleCohomology Relation to derived étale cohomology
          %p
            More generally, this works for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            a (connective)
            %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring"} E-infinity ring
            (the following is due to
            = succeed "," do
              %a{:href => "#AntieauGepner12"} Antieau-Gepner 12
            %a{:href => "#Haugseng14"} Haugseng 14
            for more).
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_1(R)
            be its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinity-group+of+units"} infinity-group of units
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/connective+spectrum"} connective
            %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower"} Postnikov stage
            of the
            %a.existingWikiWord{:href => "/nlab/show/Picard+group"} Picard
            %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"} infinity-groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pic
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mi R
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ×
                %annotation{:encoding => "application/x-tex"}
                  Pic(R) \coloneqq Mod(R)^\times
          %p is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi et
                          %msub
                            %mi GL
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi Pic
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B}_{et} GL_1(-) &amp;\to&amp; Pic(-)
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; \mathbb{Z}
                  }
                  \\,,
          %p
            where the top morphism is the inclusion of locally free
            = succeed "-modules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %p
            So
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi et
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^1_{et}(R, GL_1)
            is not equal to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mi Pic
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0 Pic(R)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi et
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi components
                        %mi of
                        %mi R
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} H^0_{et}(R, \mathbb{Z}) = \prod_{components of R} \mathbb{Z}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Mod
                    %mi R
                %annotation{:encoding => "application/x-tex"} Mod_R
            be the
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} (infinity,1)-category
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/module+spectra"} modules
          %p
            There is a notion of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Mod
                      %mi R
                  %annotation{:encoding => "application/x-tex"} Mod_R
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/enriched+%28infinity%2C1%29-category"} enriched (infinity,1)-category
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "-categories\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi Cat
                    %mi R
                  %mo ≔
                  %msub
                    %mi Mod
                    %mi R
                %annotation{:encoding => "application/x-tex"} Cat_R \coloneqq Mod_R
            \-modules in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-categories"} presentable (infinity,1)-categories
          %p
            Forming module
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functor"} (infinity,1)-functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Alg
                    %mi R
                  %mover
                    %mo →
                    %mi Mod
                  %msub
                    %mi Cat
                    %mi R
                %annotation{:encoding => "application/x-tex"}
                  Alg_R \stackrel{Mod}{\to} Cat_R
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %msub
                    %mo ′
                    %mi R
                  %mo ↪
                  %msub
                    %mi Cat
                    %mi R
                %annotation{:encoding => "application/x-tex"} Cat'_R \hookrightarrow Cat_R
            for the image of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} Mod
            %a.existingWikiWord{:href => "/nlab/show/Brauer+group"} Brauer
            %a.existingWikiWord{:href => "/nlab/show/infinity-group"} infinity-group
            to be
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Br
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi Cat
                  %msub
                    %mo ′
                    %mi R
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ×
                %annotation{:encoding => "application/x-tex"}
                  Br(R) \coloneqq (Cat'_R)^\times
          %p
            One shows (
            %a{:href => "#AntieauGepner12"}> Antieau-Gepner 12
            ) that this is exactly the Azumaya
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %p
            %strong Theorem
            (B. Antieau, D. Gepner)
          %ol
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                a connective
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} E_\infty
                ring, any Azumaya
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is étale locally trivial: there is an
                %a.existingWikiWord{:href => "/nlab/show/etale+topology"} etale cover
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo →
                      %mi S
                    %annotation{:encoding => "application/x-tex"} R \to S
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %msub
                          %mo ∧
                          %mi R
                        %mi S
                        %mover
                          %mo →
                          %mrow
                            %mi Morita
                            %mo ≃
                        %mi S
                      %annotation{:encoding => "application/x-tex"} A \wedge_R S \stackrel{Morita \simeq}{\to} S
              %p
                (Think of this as saying that an Azumaya
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                = succeed "-2-bundle)." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi GL
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} GL_1(R)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Br
                      %mo :
                      %msubsup
                        %mi CAlg
                        %mi R
                        %mrow
                          %mo ≥
                          %mn 0
                      %mo →
                      %msub
                        %mi Gpd
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} Br : CAlg_R^{\geq 0} \to Gpd_\infty
                is a sheaf for the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/etale+cohomology"} etale cohomology
          %p
            %strong Corollary
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Br
                    %annotation{:encoding => "application/x-tex"} Br
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/connected+object+in+an+%28infinity%2C1%29-topos"} connected
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Br
                        %mo ≃
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi et
                        %mi Ω
                        %mi Br
                      %annotation{:encoding => "application/x-tex"} Br \simeq \mathbf{B}_{et} \Omega Br
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi Ω
                      %mi Br
                      %mo ≃
                      %mi Pic
                    %annotation{:encoding => "application/x-tex"} \Omega Br \simeq Pic
                , hence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Br
                      %mo ≃
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi et
                      %mi Pic
                    %annotation{:encoding => "application/x-tex"} Br \simeq \mathbf{B}_{et} Pic
          %p
            %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower"} Postnikov tower
            for
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_1(R)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi for
                  %mspace{:width => "thickmathspace"}
                  %mi n
                  %mo &gt;
                  %mn 0
                  %mo :
                  %msub
                    %mi π
                    %mi n
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi π
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  for\; n \gt 0: \pi_n GL_1(S) \simeq \pi_n
          %p
            hence for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} R \to S
            étale
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mi S
                  %mo ≃
                  %msub
                    %mi π
                    %mi n
                  %mi R
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mi R
                  %msub
                    %mi π
                    %mn 0
                  %mi S
                %annotation{:encoding => "application/x-tex"}
                  \\pi_n S \simeq \pi_n R \otimes_{\pi_0 R} \pi_0 S
          %p
            This is a
            %a.existingWikiWord{:href => "/nlab/show/quasi-coherent+sheaf"} quasi-coherent sheaf
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mi R
                %annotation{:encoding => "application/x-tex"} \pi_0 R
            of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi N
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde N
            (quasicoherent sheaf associated with a module), for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            an
            = succeed "-module." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \pi_0 R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi et
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mn 0
                  %mi R
                  %mo ,
                  %mover
                    %mi N
                    %mo{:stretchy => "false"} ˜
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                  %mo ;
                  %mi for
                  %mi p
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  H_{et}^1(\pi_0 R, \tilde N) = 0; for p \gt 0
          %p
            For every
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-sheaf"} (infinity,1)-sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinity-groups"} infinity-groups
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi et
                    %mi p
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mn 0
                  %mi R
                  %mo ;
                  %msub
                    %mover
                      %mi π
                      %mo{:stretchy => "false"} ˜
                    %mi q
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %msub
                    %mi π
                    %mrow
                      %mi q
                      %mo −
                      %mi p
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H_{et}^p(\pi_0 R; \tilde \pi_q G) \Rightarrow \pi_{q-p} G(R)
          %p
            (the second argument on the left denotes the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qth
                %annotation{:encoding => "application/x-tex"} qth
            Postnikov stage). From this one gets the following.
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi π
                          %mo{:stretchy => "false"} ˜
                        %mn 0
                      %mi Br
                      %mo ≃
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \tilde \pi_0 Br \simeq *
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi π
                          %mo{:stretchy => "false"} ˜
                        %mn 1
                      %mi Br
                      %mo ≃
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \tilde \pi_1 Br \simeq \mathbb{Z}
                ;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi π
                          %mo{:stretchy => "false"} ˜
                        %mn 2
                      %mi Br
                      %mo ≃
                      %msub
                        %mover
                          %mi π
                          %mo{:stretchy => "false"} ˜
                        %mn 1
                      %mi Pic
                      %mo ≃
                      %msub
                        %mi π
                        %mn 0
                      %msub
                        %mi GL
                        %mn 1
                      %mo ≃
                      %msub
                        %mi 𝔾
                        %mi m
                    %annotation{:encoding => "application/x-tex"} \tilde \pi_2 Br \simeq \tilde \pi_1 Pic \simeq \pi_0 GL_1 \simeq \mathbb{G}_m
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi π
                          %mo{:stretchy => "false"} ˜
                        %mi n
                      %mi Br
                    %annotation{:encoding => "application/x-tex"} \tilde \pi_n Br
                is quasicoherent for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo &gt;
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n \gt 2
          %p
            there is an
            %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %msubsup
                    %mi H
                    %mi et
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mn 0
                  %mi R
                  %mo ,
                  %msub
                    %mi 𝔾
                    %mi m
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi π
                    %mn 0
                  %mi Br
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi H
                    %mi et
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mn 0
                  %mi R
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  0 \to
                  H_{et}^2(\pi_0 R, \mathbb{G}_m)
                  \\to \pi_0 Br(R)
                  \\to H_{et}^1(\pi_0 R, \mathbb{Z})
                  \\to 0
          %p
            (notice the inclusion
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Br
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 0
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msubsup
                      %mi H
                      %mi et
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 0
                    %mi R
                    %mo ,
                    %msub
                      %mi 𝔾
                      %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Br(\pi_0 R) \hookrightarrow H_{et}^2(\pi_0 R, \mathbb{G}_m)
          %p
            this is
            %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split exact
            and so computes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mi Br
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_0 Br(R)
            for connective
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %p
            Now some more on the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is not connective.
          %p
            Suppose there exists
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mover
                    %mo →
                    %mi ϕ
                  %mi S
                %annotation{:encoding => "application/x-tex"} R \stackrel{\phi}{\to} S
            which is a faithful
            %a.existingWikiWord{:href => "/nlab/show/Galois+extension"} Galois extension
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
          %p
            %strong Examples
          %ol
            %li
              %p
                (real into complex
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/K-theory+spectrum"} K-theory spectrum
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi KO
                      %mo →
                      %mi KU
                    %annotation{:encoding => "application/x-tex"} KO \to KU
                (this is
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo →
                      %mi tmf
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \to tmf(3)
          %p
            Give
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} R \to S
            %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Gl
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi fib
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Pic
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi fib
                  %mi Pic
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Pic
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Br
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi fib
                  %mi Br
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Br
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  Gl_1(R/S) \stackrel{fib}{\to} GL_1(R) \to GL_1(S)
                  \\to
                  Pic(R/S) \stackrel{fib}{\to} Pic(R) \to Pic(S)
                  \\to
                  Br(R/S) \stackrel{fib}{\to} Br(R) \to Br(S) \to \cdots
          %p
            %strong Theorem
            (descent theorems) (Tyler Lawson, David Gepner) Given
            = succeed "-Galois" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mover
                    %mo →
                    %mo ≃
                  %msup
                    %mi S
                    %mi hG
                %annotation{:encoding => "application/x-tex"} R \stackrel{\simeq}{\to} S^{hG}
            (
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fixed+points"}> homotopy fixed points
            )
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Mod
                        %mi R
                      %mover
                        %mo →
                        %mo ≃
                      %msubsup
                        %mi Mod
                        %mi S
                        %mi hG
                    %annotation{:encoding => "application/x-tex"} Mod_R \stackrel{\simeq}{\to} Mod_S^{hG}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Alg
                        %mi R
                      %mover
                        %mo →
                        %mo ≃
                      %msubsup
                        %mi Alg
                        %mi S
                        %mi hG
                    %annotation{:encoding => "application/x-tex"} Alg_R \stackrel{\simeq}{\to} Alg_S^{hG}
          %p it follows that there is a homotopy fixed points spectral sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %msub
                    %mi π
                    %mo •
                  %msup
                    %mi Σ
                    %mi n
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %msub
                    %mi π
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi n
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H^p(G, \pi_\bullet \Sigma^n GL_1(S))
                  \\Rightarrow
                  \\pi_{-n} GL_1(S)
          %p
            %strong Conjecture
            The spectral sequence gives an Azumaya
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KO
                  %annotation{:encoding => "application/x-tex"} KO
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            which is a nontrivial element in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Br
                  %mo{:stretchy => "false"} (
                  %mi KO
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Br(KO)
            but becomes trivial in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Br
                    %mo{:stretchy => "false"} (
                    %mi KU
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Br(KU)
