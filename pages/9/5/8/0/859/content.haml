          %h2#definitions Definitions
          %p
            If a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/action"} acts
            on a group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            (on the left, say) by group
            %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo :
                  %mi G
                  %mo →
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\rho : G \to Aut(\Gamma)
                  \\,,
          %p
            then there is a
            %strong semidirect product
            group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ⋊
                  %mspace{:width => "thinmathspace"}
                  %mi G
                %annotation{:encoding => "application/x-tex"} \Gamma \rtimes \, G
            whose underlying set is the
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ×
                  %mi G
                %annotation{:encoding => "application/x-tex"} \Gamma \times  G
            but whose multiplication is twisted by
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi δ
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi δ
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi h
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (\delta,h)(\gamma,g)= (\delta \rho(h)(\gamma) , h g)
          %p
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo ,
                    %mi γ
                    %mo ∈
                    %mi Γ
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi h
                    %mo ,
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \delta, \gamma \in \Gamma,\; h,g \in G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo
                    %mi h
                  %mi γ
                  %mo ≔
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ^h \gamma \coloneqq \rho(h)(\gamma)
            denotes the result of acting with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            on the left on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
          %p
            If the twist is trivial, then this reduces to just the
            %a.existingWikiWord{:href => "/nlab/show/direct+product+group"} direct product group
            construction, whence the name.
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi Γ
                  %mo ⋊
                  %mspace{:width => "thinmathspace"}
                  %mi G
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} p:\Gamma \rtimes \, G \to G
            ,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi g
                  %annotation{:encoding => "application/x-tex"} (\gamma, g) \to g
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            of this can be identified with a
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            satisfies
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mi h
                    %mo{:stretchy => "false"} )
                    %msup
                      %mspace{:width => "thinmathspace"}
                      %mi h
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d(h g) = (d h) \,^h (d g)
          %h3#interior_semidirect_products Interior semidirect products
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            be any group. A decomposition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            as an
            %strong internal
            semidirect product consists of a
            %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            and a
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            can be written uniquely in the form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \gamma g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo ∈
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \gamma \in \Gamma
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
          %p
            The internal and external concepts are equivalent. In particular, any (external) semidirect product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ⋊
                  %mi G
                %annotation{:encoding => "application/x-tex"} \Gamma \rtimes G
            is an internal semidirect product of the
            %a.existingWikiWord{:href => "/nlab/show/images"} images
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            in it.
          %h3#right_semidirect_products Right semidirect products
          %p
            The definitions above are not symmetric in left and right; since the first definition begins with a left action, we may call it a
            %em left
            semidirect product. Then a
            %strong right
            semidirect product is given by an action on the right, or internally by the requirement that every element can be written in the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} g \gamma
          %p
            However, right and left semidirect products are equivalent. Essentially, this is because any left action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msup
                    %mrow
                    %mi h
                  %mi g
                %annotation{:encoding => "application/x-tex"} (h,g) \mapsto {}^h{g}
            defines a right action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msup
                    %mi g
                    %mi h
                  %mo ≔
                  %msup
                    %mrow
                    %mrow
                      %msup
                        %mi h
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                  %mi g
                %annotation{:encoding => "application/x-tex"} (g,h) \mapsto g^h \coloneqq {}^{h^{-1}}g
            and vice versa.
          %h3#as_a_left_adjoint As a left adjoint
          %p
            Consider the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GrpActions
                %annotation{:encoding => "application/x-tex"} GrpActions
            with
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ,
                      %mi Γ
                      %mo ,
                      %mi ρ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (G,\Gamma,\rho)
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
                are
                %a.existingWikiWord{:href => "/nlab/show/groups"} groups
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo :
                      %mi G
                      %mo →
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Aut
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \rho: G \to \Aut(\Gamma)
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/group+homomorphisms"} group homomorphisms
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ,
                      %mi Γ
                      %mo ,
                      %mi ρ
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ′
                      %mo ,
                      %mi Γ
                      %mo ′
                      %mo ,
                      %mi ρ
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (G,\Gamma,\rho) \to (G',\Gamma',\rho')
                are
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/equivariant"} equivariant
                pairs of morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi G
                      %mo →
                      %mi G
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} f: G \to G'
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo :
                        %mi Γ
                        %mo →
                        %mi Γ
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} h: \Gamma \to \Gamma'
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ρ
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} h(\rho(g)(\gamma)) = \rho'(f(g))(h(\gamma))
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} g \in G
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mo ∈
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \gamma \in \Gamma
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mi Arr
                  %mo{:stretchy => "false"} (
                  %mi Grp
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi GrpActions
                %annotation{:encoding => "application/x-tex"} U: Arr(Grp) \to GrpActions
            from the
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
            %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi G
                  %mo →
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} f\colon G \to \Gamma
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mi Γ
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (G,\Gamma,\rho)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo :
                  %mi G
                  %mo →
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \rho: G \to Aut(\Gamma)
            is given by conjugation, i.e.
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mi γ
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \rho(g)(\gamma) \coloneqq f(g) \gamma f(g)^{-1}
          %p
            Now, its
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint+functor"} left adjoint functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GrpActions
                  %mo →
                  %mi Arr
                  %mo{:stretchy => "false"} (
                  %mi Grp
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GrpActions \to Arr(Grp)
            maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mi Γ
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (G,\Gamma,\rho)
            to the
            %a.existingWikiWord{:href => "/nlab/show/inclusion"} inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ↪
                    %mi Γ
                    %msub
                      %mo ⋊
                      %mi ρ
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G \hookrightarrow \Gamma \rtimes_\rho G
          %p
            One can also compose this with the left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtext cod
                  %mo :
                  %mi Arr
                  %mo{:stretchy => "false"} (
                  %mi Grp
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Grp
                %annotation{:encoding => "application/x-tex"} \text{cod} : Arr(Grp) \to Grp
            to exhibit the semidirect product as a left adjoint
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GrpActions
                    %mo →
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"} GrpActions \to Grp
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            to the self-conjugation action
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %mtext Aut
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \to \text{Aut}(G)
          %h3#as_a_grothendieck_construction As a Grothendieck construction
          %p
            Writing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔹
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbb{B} G
            for the
            %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
            of the
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            — with a single
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} \ast
            and the
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            as its
            %a.existingWikiWord{:href => "/nlab/show/hom+set"} hom set
            – define a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝔹
                  %mi G
                  %mo →
                %annotation{:encoding => "application/x-tex"} F \colon \mathbb{B}G \to
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            to send that single object to the delooping groupoid of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ↦
                    %mi 𝔹
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} * \mapsto \mathbb{B}\Gamma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo →
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \to Aut(\Gamma)
            according to the given
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
          %p
            Then the delooping of the semidirect product group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ⋊
                  %mi G
                %annotation{:encoding => "application/x-tex"} \Gamma \rtimes G
            arises as the
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            of this functor:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔹
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo ⋊
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ∫
                    %mrow
                      %mi 𝔹
                      %mi G
                  %mi F
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{B}( \Gamma \rtimes G)
                  \\;\simeq\;
                  \\int_{\mathbb{B}G}F
          %h3#semidirect_products_of_groupoids Semidirect products of groupoids
          %p
            It is useful to generalise this to the case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo =
                  %msub
                    %mi π
                    %mn 1
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Gamma = \pi_1 X
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a (left)
            = succeed "-space." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            So if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi Ob
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X=Ob(\Gamma)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ⋊
                  %mspace{:width => "thinmathspace"}
                  %mi G
                %annotation{:encoding => "application/x-tex"} \Gamma \rtimes \, G
            has object set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo →
                  %mi x
                %annotation{:encoding => "application/x-tex"} y \to x
            is a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\gamma,g)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo :
                  %mi y
                  %mo →
                  %mi g
                  %mi x
                %annotation{:encoding => "application/x-tex"}
                  \\gamma: y \to
                  g x
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi δ
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi δ
                  %msup
                    %mspace{:width => "thinmathspace"}
                    %mi h
                  %mi γ
                  %mo ,
                  %mi h
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\delta,h)(\gamma,g)= (\delta \, ^h \gamma, h g)
          %p
            if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi z
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} (\delta, h): z \to y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo :
                  %mi z
                  %mo →
                  %mi h
                  %mi y
                %annotation{:encoding => "application/x-tex"} \delta: z \to h y
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            is a discrete groupoid, and so identified with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⋊
                  %mspace{:width => "thinmathspace"}
                  %mi G
                %annotation{:encoding => "application/x-tex"} X \rtimes \, G
            which is the
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            of the action. In this case the projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi X
                  %mo ⋊
                  %mspace{:width => "thinmathspace"}
                  %mi G
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} p: X \rtimes \, G \to G
            is a covering morphism of groupoids, i.e. any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∈
                  %mi G
                %annotation{:encoding => "application/x-tex"} g \in G
            has a unique lifting with given initial point. Note that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} Y \to X
            is a covering map of spaces, then the induced morphism of fundamental groupoids is a covering morphism of groupoids. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo :
                  %mi H
                  %mo →
                  %msub
                    %mi π
                    %mn 1
                  %mi X
                %annotation{:encoding => "application/x-tex"} q: H \to \pi_1 X
            is a covering morphism of groupoids, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            admits a universal covering map, then there is a topology on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo =
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Y=Ob(H)
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ≅
                    %msub
                      %mi π
                      %mn 1
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} H \cong \pi_1 Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is equivalent to the category of covering morphisms of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \pi_1 X
          %p
            The utility of the more general construction is that there is notion of orbit groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi G
                %annotation{:encoding => "application/x-tex"} \Gamma //G
            (identify any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                %annotation{:encoding => "application/x-tex"} \gamma
            and
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo
                      %mi g
                    %mi γ
                  %annotation{:encoding => "application/x-tex"}
                    ^g
                    \\gamma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo ⋊
                  %mspace{:width => "thinmathspace"}
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi N
                %annotation{:encoding => "application/x-tex"} (\Gamma \rtimes \, G)/N
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            is the
            %a.existingWikiWord{:href => "/nlab/show/normal+closure"} normal closure
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ⋊
                  %mspace{:width => "thinmathspace"}
                  %mi G
                %annotation{:encoding => "application/x-tex"} \Gamma \rtimes \, G
            of all elements
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mi x
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1_x,g)
          %h2#properties Properties
          %h3#as_split_group_extensions As split group extensions
          %p
            Semidirect product groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo ⋊
                    %mi ρ
                  %mi G
                %annotation{:encoding => "application/x-tex"} A \rtimes_\rho G
            are precisely the split
            %a.existingWikiWord{:href => "/nlab/show/group+extensions"} group extensions
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %em
                %a{:href => "group+extension#SplitExtensionsAndSemidirectProductGroups"} group extension – split extensions and semidirect product groups
          %h2#examples Examples
          %h3#the_automorphisms_on_the_circle_group The automorphisms on the circle group
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} U(1) = \mathbb{R}/\mathbb{Z}
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi ℤ
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Aut(U(1)) \simeq \mathbb{Z}_2
                  \\,,
          %p
            where the nontrivial element in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
            acts on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            by multiplication with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} -1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ρ
                    %mi aut
                  %mo :
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \rho_{aut} : U(1) \times \mathbb{Z}_2 \to U(1)
            for the automorphism
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/action"} action
            %a.existingWikiWord{:href => "/nlab/show/group+extension"} group extension
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ↪
                    %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⋊
                    %mrow
                      %msub
                        %mi ρ
                        %mi aut
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo →
                  %msub
                    %mi ℤ
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  U(1) \stackrel{}{\hookrightarrow} U(1) \rtimes_{\rho_{aut}} \mathbb{Z}_2
                  \\to \mathbb{Z}_2
          %p where the group operation is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mi mod
                  %mspace{:width => "thickmathspace"}
                  %mi ℤ
                  %mo ,
                  %msub
                    %mi σ
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mi mod
                  %mspace{:width => "thickmathspace"}
                  %mi ℤ
                  %mo ,
                  %msub
                    %mi σ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo +
                  %msub
                    %mi σ
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi mod
                  %mspace{:width => "thickmathspace"}
                  %mi ℤ
                  %mo ,
                  %msub
                    %mi σ
                    %mn 1
                  %mo +
                  %msub
                    %mi σ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (c_1 \; mod \; \mathbb{Z}, \sigma_1)
                  \\cdot
                  (c_2\; mod \; \mathbb{Z}, \sigma_2)
                  \=
                  (c_1 + \sigma_1(c_2) \; mod \; \mathbb{Z}, \sigma_1 + \sigma_2)
                  \\,.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/direct+product+of+groups"} direct product of groups
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/bicrossed+product"} bicrossed product
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/free+product+of+groups"} free product of groups
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/central+product+of+groups"} central product of groups
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/semidirect+product+Lie+algebra"} semidirect product Lie algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivariant+group"} equivariant group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/crossed+homomorphism"} crossed homomorphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/crossed+product+algebra"} crossed product algebra
                (Hopf algebraic smash product)
          %h2#references References
          %p A general survey is in
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "http://en.wikipedia.org/wiki/Semi-direct_product"} Semidirect product
          %p Lecture notes include
          %ul
            %li
              Patrick Morandi,
              %em Semidirect products
              (
              %a{:href => "http://sierra.nmsu.edu/morandi/notes/semidirect.pdf"}> pdf
              )
          %p See also:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/R.+Brown"}> R. Brown
                ,
                = succeed "," do
                  %em Topology and groupoids
            %li
