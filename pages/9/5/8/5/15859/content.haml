                  %semantics
                    %mrow
                      %mi M
                      %mover
                        %mo →
                        %mi q
                      %msub
                        %mi M
                        %mi f
                      %mover
                        %mo →
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                      %mi L
                    %annotation{:encoding => "application/x-tex"} M\overset{q}{\to}M_f\overset{\hat{f}}{\to}L
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mi f
                    %annotation{:encoding => "application/x-tex"} M_f
                a
                = succeed "-model" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕋
                      %annotation{:encoding => "application/x-tex"} \mathbb{T}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                        %mo ∈
                        %mi 𝔸
                      %annotation{:encoding => "application/x-tex"} \hat{f}\in \mathbb{A}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mover
                        %mo →
                        %mi r
                      %mi P
                      %mover
                        %mo →
                        %mi p
                      %mi L
                    %annotation{:encoding => "application/x-tex"} M\overset{r}{\to}P\overset{p}{\to}L
                factors with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi gh
                      %mo =
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} gh=\hat{f}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hq
                      %mo =
                      %mi r
                    %annotation{:encoding => "application/x-tex"} hq=r
                for a unique
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo :
                        %msub
                          %mi M
                          %mi f
                        %mo →
                        %mi P
                      %annotation{:encoding => "application/x-tex"} h:M_f\to P
          %p
            The sub-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔸
                  %mo −
                  %mi 𝔗𝔬𝔭
                %annotation{:encoding => "application/x-tex"} \mathbb{A}-\mathfrak{Top}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕋
                  %mo −
                  %mi 𝔗𝔬𝔭
                %annotation{:encoding => "application/x-tex"} \mathbb{T}-\mathfrak{Top}
            for such an admissible class has 1-cells
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (p,f)
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi 𝔸
                  %annotation{:encoding => "application/x-tex"} f\in \mathbb{A}
          %h3#theorem Theorem
          %div
            %p
              %em
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕊
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕋
                    %annotation{:encoding => "application/x-tex"} \mathbb{T}
                be finitely presented geometric theories such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕋
                    %annotation{:encoding => "application/x-tex"} \mathbb{T}
                is a quotient theory of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕊
                      %annotation{:encoding => "application/x-tex"} \mathbb{S}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔸
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}
                be an admissible class of morphisms of
                = succeed "-models." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕋
                      %annotation{:encoding => "application/x-tex"} \mathbb{T}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔸
                      %mo −
                      %msub
                        %mi 𝔗𝔬𝔭
                        %mi N
                      %mo →
                      %mi 𝕊
                      %mo −
                      %msub
                        %mi 𝔗𝔬𝔭
                        %mi N
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}-\mathfrak{Top}_N\to \mathbb{S}-\mathfrak{Top}_N
                has a right adjoint
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spec
                        %mo :
                        %mi 𝕊
                        %mo −
                        %msub
                          %mi 𝔗𝔬𝔭
                          %mi N
                        %mo →
                        %mi 𝔸
                        %mo −
                        %msub
                          %mi 𝔗𝔬𝔭
                          %mi N
                      %annotation{:encoding => "application/x-tex"} Spec:\mathbb{S}-\mathfrak{Top}_N\to \mathbb{A}-\mathfrak{Top}_N
          %h3#example Example
          %p
            The classical example is given by the
            %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theories
            of
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative rings
            and
            %a.existingWikiWord{:href => "/nlab/show/local+ring"} local rings
            with the factorization given by the class of local morphisms and appropriate rings of fractions as the local factors. The right adjoint maps a commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            basically to the pair consisting of the sheaf topos on the Zariski spectrum of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and the structure sheaf of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (cf. Johnstone 1977b).
          %h3#remark Remark
          %p
            In the context of his work with C. Lair on ‘locally free diagrams’
            %a.existingWikiWord{:href => "/nlab/show/Ren%C3%A9+Guitart"} R. Guitart
            interprets the ‘almost-freeness’ of the spec construction as an ‘almost-algebraicity’ of topology (See Guitart 2008 and the references therein).
          %h2#related_concepts Related concepts
          %p
            %em
              %a.existingWikiWord{:href => "/nlab/show/spectrum+of+a+commutative+ring"} spectrum of a commutative ring
          %p
            %em
              %a.existingWikiWord{:href => "/nlab/show/locally+algebra-ed+topos"} locally algebra-ed topos
          %p
            %em
              %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
          %p
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theory
          %p
            %em
              %a.existingWikiWord{:href => "/nlab/show/ringed+topos"} ringed topos
          %p
            %em
              %a.existingWikiWord{:href => "/nlab/show/Structured+Spaces"} Structured Spaces
          %p
            %em
              %a.existingWikiWord{:href => "/nlab/show/formally+etale+morphisms"} formally etale morphisms
          %h2#references References
          %p The original article is reprinted as
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Julian+Cole"}> Julian Cole
              ,
              = succeed "," do
                %em The bicategory of topoi and spectra
              = succeed ")" do
                %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/25/tr25abs.html"} TAC
          %p
            Besides this, Johnstone’s article (
            %a{:href => "#Johnstone77a"}> 1977a
            ), the book of Johnstone (
            %a{:href => "#Johnstone77b"}> 1977b
            ), on which the above exposition is based, is a good source for this material. Bunge (1981), Bunge and Reyes (1981) apply the results in a model-theoretic context. See also the short remark in Caramello (2014, p.55).
          %p
            %a.existingWikiWord{:href => "/nlab/show/Michel+Coste"}> M. Coste
            ‘s (1979) take on admissible maps flows in Coste-Michon (1981) via the 4-yoga (cf.
            = succeed ")" do
              %a{:href => "#quote"} above
          %p
            For a glimpse of
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"} A. Joyal
            %em spectrum
            (of a ring) see Lurie (2009).
          %ul#Dubuc
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marta+Bunge"}> M. Bunge
                ,
                %em Sheaves and Prime Model Extensions
                , J. Algebra
                %strong 68
                (1981) pp.79-96.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marta+Bunge"}> M. Bunge
                ,
                %a.existingWikiWord{:href => "/nlab/show/Gonzalo+E.+Reyes"} G. E. Reyes
                ,
                %em Boolean spectra and model completions
                , Fund.Math.
                %strong 113
                (1981) pp.165-173. (
                %a{:href => "http://matwbn.icm.edu.pl/ksiazki/fm/fm113/fm113115.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Olivia+Caramello"}> O. Caramello
                ,
                %em Topos-theoretic background
                , ms. 2014. (
                %a{:href => "http://www.oliviacaramello.com/Unification/ToposTheoreticPreliminariesOliviaCaramello.pdf"}> pdf
                )
            %li
              %p
