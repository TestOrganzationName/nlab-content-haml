          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+graded+category"} differential graded category
          %p
            A
            %strong twisted complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
          %ul
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/graded+set"} graded set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi E
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \{E_i\}_{i \in \mathbb{Z}}
                of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi i
                    %annotation{:encoding => "application/x-tex"} E_i
                are not the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
            %li
              %p
                a set of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi q
                        %mrow
                          %mi i
                          %mi j
                      %mo :
                      %msub
                        %mi E
                        %mi i
                      %mo →
                      %msub
                        %mi E
                        %mi j
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                          %mo ∈
                          %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \{q_{i j} : E_i \to E_j \}_{i,j \in \mathbb{Z}}
                such that
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi deg
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi q
                            %mrow
                              %mi i
                              %mi j
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi i
                          %mo −
                          %mi j
                          %mo +
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} deg(q_{i j}) = i-j+1
                    ;
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mo ∀
                          %mi i
                          %mo ,
                          %mi j
                          %mo :
                          %mspace{:width => "thickmathspace"}
                          %mi d
                          %msub
                            %mi q
                            %mrow
                              %mi i
                              %mi j
                          %mo +
                          %msub
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mi k
                          %msub
                            %mi q
                            %mrow
                              %mi k
                              %mi j
                          %mo ∘
                          %msub
                            %mi q
                            %mrow
                              %mi i
                              %mi k
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \forall i,j : \; d q_{i j} + \sum_{k} q_{k j}\circ q_{i k} = 0
                    \.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/differential+graded+category"} differential graded category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PreTr
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PreTr(C)
            of twisted complexes in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has as objects twisted complexes and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PreTr
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mo •
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi E
                  %msub
                    %mo ′
                    %mo •
                  %mo ,
                  %mi q
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi k
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi l
                      %mo +
                      %mi j
                      %mo −
                      %mi i
                      %mo =
                      %mi k
                  %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mi i
                  %mo ,
                  %mi E
                  %msub
                    %mo ′
                    %mi j
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi l
                %annotation{:encoding => "application/x-tex"}
                  PreTr(C)((E_\bullet, q), (E'_\bullet, q'))^k
                  \=
                  \\coprod_{l + j - i = k} C(E_i, E'_j)^l
          %p
            with differential given on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mi i
                  %mo ,
                  %mi E
                  %msub
                    %mo ′
                    %mi j
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi l
                %annotation{:encoding => "application/x-tex"} f \in C(E_i, E'_j)^l
            given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi f
                  %mo =
                  %msub
                    %mi d
                    %mi C
                  %mi f
                  %mo +
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi m
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi q
                    %mrow
                      %mi j
                      %mi m
                  %mo ∘
                  %mi f
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi l
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo −
                      %mi m
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mi f
                  %mo ∘
                  %msub
                    %mi q
                    %mrow
                      %mi m
                      %mi i
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d f = d_C f + \sum_m (q_{j m}\circ  f + (-1)^{l(i-m+1)} f \circ q_{m i})
                  \\,.
          %p
            The construction of categories of twisted complexes is functorial in that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} F : C \to C'
            a dg-functor, there is a dg-functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PreTr
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi PreTr
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi PreTr
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  PreTr(F) : PreTr(C) \to PreTr(C')
                  \\,.
          %p etc.
          %h2#properties Properties
          %p
            Passing from a
            %a.existingWikiWord{:href => "/nlab/show/dg-category"} dg-category
            to its category of twisted complexes is a step towards enhancing it to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pretriangulated+dg-category"} pretriangulated dg-category
