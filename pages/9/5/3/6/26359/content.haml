                %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
                that mimic that of the
                %a.existingWikiWord{:href => "/nlab/show/negative+type"} negative
                %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
