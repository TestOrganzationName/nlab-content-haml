          %h2#idea Idea
          %p
            %strong Iterated localizations
            are,
            = succeed "," do
              %em to a first approximation
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            right
            %a.existingWikiWord{:href => "/nlab/show/orthogonal"} orthogonal
            to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/conservative+functors"} conservative functors
            %a.existingWikiWord{:href => "/nlab/show/class"} class
            of functors obtained from factoring any functor as some functor followed by a conservative functor.
          %p
            For the correct statement one needs to regard
            %a.existingWikiWord{:href => "/nlab/show/Cat"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Cat
                  %annotation{:encoding => "application/x-tex"} \mathbf{Cat}
            as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/canonical+model+structure+on+Cat"} as a model category
          %h2#definition Definition
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            of
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \subset Mor(C)
            %a.existingWikiWord{:href => "/nlab/show/localization+of+a+category"} localization category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} C[S^{-1}]
            which is
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal
            in the sense that every functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
