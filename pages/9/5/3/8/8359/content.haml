          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#Details"} Details
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The
            %em
              Friedmann–
              %a.existingWikiWord{:href => "/nlab/show/Georges+Lema%C3%AEtre"}> Lemaître
              –Robertson–
              %a.existingWikiWord{:href => "/nlab/show/Arthur+Walker"} Walker
              models
            (often
            = succeed ")" do
              %em FRW-models
            %a.existingWikiWord{:href => "/nlab/show/model+%28physics%29"} models
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cosmology"} cosmology
            %a.existingWikiWord{:href => "/nlab/show/solutions"} solutions
            to
            %a.existingWikiWord{:href => "/nlab/show/Einstein%27s+equations"} Einstein's equations
            describing a spatially homogeneous and isotropic expanding or contracting
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %a.existingWikiWord{:href => "/nlab/show/model+%28in+theoretical+physics%29"} models
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cosmology"} cosmology
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/standard+model+of+cosmology"} standard model of cosmology
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/inhomogeneous+cosmology"} inhomogeneous cosmology
          %h2#Details Details
          %p
            The plain FRW model parameterizes a homogenous and isotropic
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            after
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
            %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixing
            with a single parameter
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ↦
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t \mapsto a(t)
            %em scale factor of the universe
            depending on coordinate time
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            (fixed by some gauge condition).
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            of the FRW model are then
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 2
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi a
                        %mo ˙
                      %mo{:stretchy => "false"} /
                      %mi a
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo =
                      %mn 2
                      %mi ρ
                      %mo −
                      %mi k
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi a
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} H^2 \coloneqq (\dot a / a)^2 = 2 \rho - k/a^2
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi a
                        %mo ¨
                      %mo{:stretchy => "false"} /
                      %mi a
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} (
                      %mi ρ
                      %mo +
                      %mn 3
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \ddot a/ a = -(\rho + 3 p)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi ρ
                        %mo ˙
                      %mo +
                      %mn 3
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi ρ
                      %mo +
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \dot \rho + 3 H(\rho + p ) = 0
          %p where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ≔
                      %mover
                        %mi a
                        %mo ˙
                      %mo{:stretchy => "false"} /
                      %mi a
                    %annotation{:encoding => "application/x-tex"} H \coloneqq \dot a/a
                is called the
                = succeed ";" do
                  %span.newWikiWord
                    Hubble parameter
                    %a{:href => "/nlab/new/Hubble+parameter"} ?
            %li
              %p and
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                    is the
                    %a.existingWikiWord{:href => "/nlab/show/pressure"} pressure
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ρ
                        %annotation{:encoding => "application/x-tex"} \rho
                    is the
                    %a.existingWikiWord{:href => "/nlab/show/density"} density
              %p
                of a “perfect fluid” of
                %a.existingWikiWord{:href => "/nlab/show/matter"} matter
                and
                %a.existingWikiWord{:href => "/nlab/show/radiation"} radiation
                filling the universe.
          %p Moreover, the ratio
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ≔
                    %mi p
                    %mo{:stretchy => "false"} /
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} w \coloneqq p/\rho
          %p
            is part of the experimental/phenomenological input into the model, which describes which
            %em kind
            of matter/radiation is assumed to fill
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
          %table
            %thead
              %tr
                %th w
                %th source of energy-density filling spacetime
            %tbody
              %tr
                %td{:style => "text-align: left;"} 1/3
                %td{:style => "text-align: left;"} radiation or relativistic matter
              %tr
                %td{:style => "text-align: left;"} 0
                %td{:style => "text-align: left;"}
                  dust
                  %a.existingWikiWord{:href => "/nlab/show/matter"} matter
              %tr
                %td{:style => "text-align: left;"} 1
                %td{:style => "text-align: left;"} stiff fluid
              %tr
                %td{:style => "text-align: left;"} -1
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/cosmological+constant"} cosmological constant
          %p The first equation may be rewritten as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo ≔
                  %msub
                    %mi Ω
                    %mi R
                  %mo +
                  %msub
                    %mi Ω
                    %mi M
                  %mo +
                  %msub
                    %mi Ω
                    %mi Λ
                  %mo =
                  %mn 1
                  %mo +
                  %mfrac
                    %mi k
                    %mrow
                      %msup
                        %mi a
                        %mn 2
                      %msup
                        %mi H
                        %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\Omega \coloneqq \Omega_R + \Omega_M + \Omega_\Lambda
                  \=
                  1 + \frac{k}{a^2 H^2}
          %p
            where the
            %em density parameter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            consists of the contribution
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ω
                        %mi R
                      %mo =
                      %mn 2
                      %mfrac
                        %mrow
                          %msub
                            %mi ρ
                            %mi r
                        %mrow
                          %msup
                            %mi a
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} \Omega_R = 2 \frac{\rho_r}{a^2}
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/radiation"} radiation
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ω
                        %mi M
                      %mo =
                      %mn 2
                      %mfrac
                        %mrow
                          %msub
                            %mi ρ
                            %mi r
                        %mrow
                          %msup
                            %mi a
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} \Omega_M = 2 \frac{\rho_r}{a^2}
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/matter"} matter
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ω
                        %mi Λ
                      %mo =
                      %mfrac
                        %mi Λ
                        %mrow
                          %msup
                            %mi a
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} \Omega_\Lambda =  \frac{\Lambda}{a^2}
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/cosmological+constant"} cosmological constant
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hubble%27s+law"} Hubble's law
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/big+bang"} big bang
            %li
              %p
