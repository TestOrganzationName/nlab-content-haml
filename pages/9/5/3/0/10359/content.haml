                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\{-,-\} \;\colon\; C^\infty(X)\otimes C^\infty(X) \longrightarrow C^\infty(X)
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
            induced by the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bivector"} Poisson bivector
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo ≔
                    %msup
                      %mi ω
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi \coloneqq \omega^{-1}
          %p For notational simplicity we will restrict attention to the special case that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %msup
                    %mi ℝ
                    %mn 2
                  %mo ≃
                  %msup
                    %mi T
                    %mo *
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  X = \mathbb{R}^2 \simeq T^\ast \mathbb{R}
          %p
            with canonical
            %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo ,
                  %mi p
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℝ
                    %mn 2
                  %mo ⟶
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  q,p \;\colon\; \mathbb{R}^2 \longrightarrow \mathbb{R}
          %p and symplectic form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi q
                  %mo ∧
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi p
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\omega = \mathbf{d}q \wedge \mathbf{d}p
                  \\,.
          %p The general case of the following discussion is a straightforward generalization of this, which is just notationally more inconvenient.
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ≔
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} I \coloneqq [0,1]
            for the standard
            %a.existingWikiWord{:href => "/nlab/show/interval"} interval
            regarded as a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} with boundary
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi X
                  %mo ≔
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  P X \coloneqq [I, X]
          %p
            canonically exists as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            this structure canonically refines to that of a
            %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+manifold"} Fréchet manifold
            (see at
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/manifold+structure+of+mapping+spaces"} manifold structure of mapping spaces
            %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi P
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T P X
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bivector"} Poisson bivector
            as a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo ∈
                    %msup
                      %mi Γ
                      %mrow
                        %mo ∧
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi P
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi \in \Gamma^{\wedge 2}(T P X)
          %p
            Among the
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi X
                %annotation{:encoding => "application/x-tex"} P X
            are the
            %a.existingWikiWord{:href => "/nlab/show/evaluation+maps"} evaluation maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ev
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mi X
                  %mo ×
                  %mi I
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi I
                  %mover
                    %mo ⟶
                    %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  ev \;\colon\; P X \times I = [I,X] \times I \stackrel{}{\longrightarrow} X
          %p
            whose components we denote, as usual, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %mi I
                %annotation{:encoding => "application/x-tex"} t \in I
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi q
                  %mo ∘
                  %msub
                    %mi ev
                    %mi t
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mi X
                  %mo ⟶
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  q(t) \coloneqq q \circ ev_t \;\colon\; P X \longrightarrow \mathbb{R}
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi p
                  %mo ∘
                  %msub
                    %mi ev
                    %mi t
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mi X
                  %mo ⟶
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  p(t) \coloneqq p \circ ev_t \;\colon\; P X \longrightarrow \mathbb{R}
                  \\,.
          %p
            Generally for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f \colon X \to \mathbb{R}
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi f
                    %mo ∘
                    %msub
                      %mi ev
                      %mi t
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(t) \coloneqq f \circ ev_t \in C^\infty(P X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi I
                  %mo ↪
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(X) \times I \hookrightarrow C^\infty(P X)
                  \\,.
          %p Similarly we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi q
                    %mo ˙
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mi X
                  %mo ⟶
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\dot q(t) \;\colon\; P X \longrightarrow \mathbb{R}
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi q
                    %mo ˙
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mi X
                  %mo ⟶
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\dot q(t) \;\colon\; P X \longrightarrow \mathbb{R}
          %p
            obtained by
            %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ↦
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} t \mapsto q(t)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ↦
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t \mapsto p(t)
          %h3#hamiltonian_evolution Hamiltonian evolution
          %p Let now
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo ×
                  %mi I
                  %mo ⟶
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  H \;\colon\; X \times I \longrightarrow \mathbb{R}
          %p
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mi X
                  %mo ×
                  %mi I
                  %mover
                    %mo ⟶
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ev
                      %mo ,
                      %mi id
                      %mo{:stretchy => "false"} )
                  %mi X
                  %mo ×
                  %mi X
                  %mover
                    %mo ⟶
                    %mi H
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H
                  \\;\colon\;
                  P X \times I
                  \\stackrel{(ev,id)}{\longrightarrow}
                  X \times X
                  \\stackrel{H}{\longrightarrow}
                  \\mathbb{R}
                  \\,.
          %p
            Hence for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %mi I
                %annotation{:encoding => "application/x-tex"} t \in I
            we write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mi X
                  %mo ×
                  %mo{:stretchy => "false"} {
                  %mi t
                  %mo{:stretchy => "false"} }
                  %mover
                    %mo ⟶
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ev
                      %mo ,
                      %mi id
                      %mo{:stretchy => "false"} )
                  %mi X
                  %mo ×
                  %mo{:stretchy => "false"} {
                  %mi t
                  %mo{:stretchy => "false"} }
                  %mover
                    %mo ⟶
                    %mi H
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  H(t)
                  \\;\colon\;
                  P X \times \{t\}
                  \\stackrel{(ev, id)}{\longrightarrow}
                  X \times \{t\}
                  \\stackrel{H}{\longrightarrow}
                  \\mathbb{R}
          %p
            for the function that assigns to a trajectors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi I
                  %mo ⟶
                  %mi X
                %annotation{:encoding => "application/x-tex"} (q(-),p(-)) \colon I \longrightarrow X
            its
            %a.existingWikiWord{:href => "/nlab/show/energy"} energy
            at (time) parameter value
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
          %p
            Define then the
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange density
            induced by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            to be the functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi EL
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mi X
                  %mo ⟶
                  %msup
                    %mi ℝ
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  EL(t)
                  \\;\colon\;
                  P X
                  \\longrightarrow
                  \\mathbb{R}^2
          %p with components
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi EL
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi q
                              %mo ˙
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mfrac
                              %mrow
                                %mo ∂
                                %mi H
                              %mrow
                                %mo ∂
                                %mi p
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mover
                              %mi p
                              %mo ˙
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mfrac
                              %mrow
                                %mo ∂
                                %mi H
                              %mrow
                                %mo ∂
                                %mi p
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  EL(t)
                  \=
                  \\left(
                  \\array{
                  \\dot q(t) - \frac{\partial H}{\partial p}(t)
                  \\\
                  \\dot p(t) + \frac{\partial H}{\partial p}(t)
                  }
                  \\right)
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi I
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \gamma \colon I \to X
            on which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi EL
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} EL(t)
            vanishes for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %mi I
                %annotation{:encoding => "application/x-tex"} t \in I
            are equivalently those
          %ul
            %li
              %p
                for which the
                %a.existingWikiWord{:href => "/nlab/show/tangent+vector"} tangent vector
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi γ
                        %mo ˙
                      %mo ∈
                      %msub
                        %mi T
                        %mi γ
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \dot \gamma \in T_{\gamma}X
                is a
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector
                for
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
            %li
              %p
                which satisfy
                %a.existingWikiWord{:href => "/nlab/show/Hamilton%27s+equations"} Hamilton's equations
                %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} of motion
                for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
          %p
            Since the
            %a.existingWikiWord{:href => "/nlab/show/differential+equations"} differential equations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi EL
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} EL = 0
            have a unique solution for given initial data
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (q(0), p(0))
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo {
                    %mi γ
                    %mo ∈
                    %mi P
                    %mi X
                    %mo{:stretchy => "false"} |
                    %msub
                      %mo ∀
                      %mrow
                        %mi t
                        %mo ∈
                        %mi I
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi EL
                      %mi γ
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo }
                  %mover
                    %mo ⟶
                    %mrow
                      %mi γ
                      %mo ↦
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\left\{
                  \\gamma \in P X | \forall_{t \in I}\; EL_\gamma(t) = 0
                  \\right\}
                  \\stackrel{\gamma \mapsto \gamma(0)}{\longrightarrow}
                  X
          %p
            is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            (an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            of
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+spaces"} smooth spaces
          %h3#TheOffShellPoissonBracketOnSpaceOfPathsInSymplecticManifold The off-shell Poisson bracket
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Poly
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Poly(P X) \hookrightarrow C^\infty(P X)
          %p
            for the
            %span.newWikiWord
              subalgebra
              %a{:href => "/nlab/new/subalgebra"} ?
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            on
            %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
            which are
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
            %li
              %p
                of
                %a.existingWikiWord{:href => "/nlab/show/integrals"} integrals
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
            %li
              %p
                of the smooth functions in the image of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi I
                      %mo ↪
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(X) \times I \hookrightarrow C^\infty(P X)
            %li
              %p
                and all their
                %a.existingWikiWord{:href => "/nlab/show/derivatives"} derivatives
                along
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
          %p
            Define a
            %a.existingWikiWord{:href => "/nlab/show/bilinear+function"} bilinear function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Poly
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi Poly
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi Poly
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\{-,-\}
                  \\;\colon\;
                  Poly(P X) \otimes Poly(P X)
                  \\longrightarrow Poly(P X)
          %p
            as the unique function which is a
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            in both arguments and moreover is a solution to the
            %a.existingWikiWord{:href => "/nlab/show/differential+equations"} differential equations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msub
                        %mi t
                        %mn 2
                  %mrow
                    %mo {
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo }
                  %mo =
                  %mrow
                    %mo {
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi H
                      %mrow
                        %mo ∂
                        %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\partial}{\partial t_2}
                  \\left\{f(t_1), q(t_2)\right\}
                  \=
                  \\left\{
                  f(t_1), \frac{\partial H}{\partial p}(t_2)
                  \\right\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msub
                        %mi t
                        %mn 2
                  %mrow
                    %mo {
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo }
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mrow
                    %mo {
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi H
                      %mrow
                        %mo ∂
                        %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\partial}{\partial t_2}
                  \\left\{f(t_1), p(t_2)\right\}
                  \=
                  \-
                  \\left\{
                  f(t_1), \frac{\partial H}{\partial q}(t_2)
                  \\right\}
          %p subject to the initial conditions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\{f(t), q(t)\} = \{f,q\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\{f(t), p(t)\} = \{f,p\}
          %p
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} t \in I
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            This bracket directly inherits skew-symmetry and the
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
            from the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \omega)
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Poly
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Poly(P X)
            with the structure of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Poly
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Poly(P X)
            as an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mi Poly
                    %mrow
                      %mo (
                      %mi P
                      %mi X
                      %mo )
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo }
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %msub
                    %mi P
                    %mn 1
                  %mi Alg
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  Poly\left(P X\right),
                  \\;
                  \\left\{
                  \-,-
                  \\right\}
                  \\right)
                  \\;\;\;
                  \\in P_1 Alg
          %p
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
            %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
          %h3#the_symplectic_leaves The symplectic leaves
          %p
            Observe that by construction of the off-shell Poisson bracket, specifically by the
            %a.existingWikiWord{:href => "/nlab/show/differential+equations"} differential equations
            defining it, the
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi EL
                %annotation{:encoding => "application/x-tex"} EL
            generate a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+reduction"} Poisson ideal
          %p For instance
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %msub
                                  %mi t
                                  %mn 2
                            %mrow
                              %mo {
                              %mi f
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi t
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi q
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi t
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo }
                          %mtd
                            %mo =
                          %mtd
                            %mrow
                              %mo {
                              %mi f
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi t
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi H
                                %mrow
                                  %mo ∂
                                  %mi p
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi t
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo }
                        %mtr
                          %mtd
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %msub
                                  %mi t
                                  %mn 2
                            %mrow
                              %mo {
                              %mi f
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi t
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi p
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi t
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo }
                          %mtd
                            %mo =
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mrow
                              %mo {
                              %mi f
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi t
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi H
                                %mrow
                                  %mo ∂
                                  %mi q
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi t
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo }
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %mrow
                      %mo {
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi t
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi EL
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mo =
                    %mn 0
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\array{
                  \\frac{\partial}{\partial t_2}
                  \\left\{f(t_1), q(t_2)\right\}
                  \&amp;=&amp;
                  \\left\{
                  f(t_1), \frac{\partial H}{\partial p}(t_2)
                  \\right\}
                  \\\
                  \\frac{\partial}{\partial t_2}
                  \\left\{f(t_1), p(t_2)\right\}
                  \&amp;=&amp;
                  \-
                  \\left\{
                  f(t_1), \frac{\partial H}{\partial q}(t_2)
                  \\right\}
                  }
                  \\right)
                  \\;\;\;
                  \\Leftrightarrow
                  \\;\;\;
                  \\left(
                  \\left\{
                  f(t_1), \;
                  EL(t)
                  \\right\}
                  \=
                  0
                  \\right)
                  \\,.
          %p
            Moreover, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi EL
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{EL(t) = 0\}
            are
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+reduction"} Poisson reduction
            defined by this Poisson idea is the subspace of those
            %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            which are solutions of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hamilton%27s+equations"} Hamilton's equations
          %p
            As remarked above, the initial value map canonically identifies this on-shell trajectory space with the original
            %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            manifold
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} t = 0
            %a.existingWikiWord{:href => "/nlab/show/zero+locus"} zero locus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi EL
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} EL = 0
            the off-shell Poisson bracket becomes
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic
          %p
            All this clearly remains true with the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi EL
                %annotation{:encoding => "application/x-tex"} EL
            replaced by the function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi EL
                    %mo −
                    %mi J
                  %annotation{:encoding => "application/x-tex"} EL - J
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J \in C^\infty(I)
            any function of the (time) parameter (since
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi J
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \{J,-\} = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            hence defines a symplectic subspace
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo {
                    %mi γ
                    %mo ∈
                    %mi P
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∀
                      %mrow
                        %mi t
                        %mo ∈
                        %mi I
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi EL
                      %mi γ
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi J
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\left\{
                  \\gamma \in P X
                  \\;|\;
                  \\forall_{t \in I}\; EL_\gamma(t) = J
                  \\right\}
          %p
            of the off-shell Poisson structure on trajectory space. Hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mi O
                    %mi X
                    %mo ,
                    %mrow
                      %mo {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo }
                    %mo )
                %annotation{:encoding => "application/x-tex"} \left(O X, \left\{-,-\right\}\right)
            has a
            %a.existingWikiWord{:href => "/nlab/show/foliation"} foliation
            by
            %a.existingWikiWord{:href => "/nlab/show/symplectic+leaves"} symplectic leaves
            with the
            %a.existingWikiWord{:href => "/nlab/show/leaf+space"} leaf space
            being the
            %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(I)
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            on the interval.
          %p
            Notice that changing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi EL
                  %mo ↦
                  %mi EL
                  %mo −
                  %mi J
                %annotation{:encoding => "application/x-tex"} EL \mapsto EL - J
            corresponds changing the time-dependent
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ↦
                  %mi H
                  %mo −
                  %mi J
                  %mi q
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H \mapsto H - J q
                  \\,.
          %p
            Such a term linear in the
            %a.existingWikiWord{:href => "/nlab/show/canonical+coordinates"} canonical coordinates
            (the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/source"} source
                term
            %a.existingWikiWord{:href => "/nlab/show/action+functionals"} action functionals
            with such
            %a.existingWikiWord{:href => "/nlab/show/source"} source
            terms added serve as
            %a.existingWikiWord{:href => "/nlab/show/integrands"} integrands
            of
            %a.existingWikiWord{:href => "/nlab/show/generating+functions"} generating functions
            for
            %a.existingWikiWord{:href => "/nlab/show/correlators"} correlators
            in
            %a.existingWikiWord{:href => "/nlab/show/statistical+mechanics"} statistical mechanics
            and in
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
          %h3#BoundaryFieldTheoryInterpretation Boundary field theory interpretation
          %p Hence in conclusion we find the following statement:
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/trajectory"} trajectory
            space (history space) of a
            %a.existingWikiWord{:href => "/nlab/show/mechanical+system"} mechanical system
            carries a natural
            %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson structure
            whose
            %a.existingWikiWord{:href => "/nlab/show/symplectic+leaves"} symplectic leaves
            are the subspaces of those trajectories which satisfy the
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            with a fixed
            %a.existingWikiWord{:href => "/nlab/show/source"} source
            term and hence whose symplectic
            %a.existingWikiWord{:href => "/nlab/show/leaf+space"} leaf space
            is the space of possible sources.
          %p
            Notice what becomes of this statement as we consider the the
            %a.existingWikiWord{:href => "/nlab/show/2d+Chern-Simons+theory"} 2d Chern-Simons theory
            induced by the off-shell Poisson bracket (the
            %a.existingWikiWord{:href => "/nlab/show/non-perturbative+field+theory"} non-perturbative
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma-model"} Poisson sigma-model
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            is the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SG
                  %mrow
                    %mo (
                    %mi P
                    %mi X
                    %mo ,
                    %mrow
                      %mo {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo }
                    %mo )
                %annotation{:encoding => "application/x-tex"} SG\left(P X, \left\{-,-\right\}\right)
            induced by the Poisson structure.
          %p
            By the discussion at
            %a.existingWikiWord{:href => "/nlab/show/motivic+quantization"} motivic quantization
            in the section
            = succeed "," do
              %em
                %a{:href => "motivic%20quantization#PoissonManifoldAtTheBoundaryOf2dChernSimonsTheory"} The Poisson manifold at the boundary of the 2d Chern-Simons theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mi P
                    %mi X
                    %mo ,
                    %mrow
                      %mo {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo }
                    %mo )
                %annotation{:encoding => "application/x-tex"} \left(P X, \left\{-,-\right\}\right)
            defines a
            %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
            (in the sense of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum field theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2d+Chern-Simons+theory"} 2d Chern-Simons theory
            %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi P
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                        %mtd
                          %msub
                            %mo ⇙
                            %mi ξ
                        %mtd
                        %mtd
                          %mi SG
                          %mrow
                            %mo (
                            %mi P
                            %mi X
                            %mo ,
                            %mrow
                              %mo {
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo }
                            %mo )
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mi χ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi ρ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi KU
                          %mi Mod
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; P X
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  \\ast &amp;&amp; \swArrow_{\xi} &amp;&amp; SG\left(P X, \left\{-,-\right\}\right)
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow_{\mathrlap{\chi}}
                  \\\
                  \&amp;&amp; \mathbf{B}^2 U(1)
                  \\\
                  \&amp;&amp; \downarrow^{\mathrlap{\rho}}
                  \\\
                  \&amp;&amp; KU Mod
                  }
                  \\,.
          %p
            Notice that the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
            is a version of the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+leaf"} symplectic
            %a.existingWikiWord{:href => "/nlab/show/leaf+space"} leaf space
            of the given
            %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
            (its
            %a.existingWikiWord{:href => "/nlab/show/0-truncation"} 0-truncation
            is exactly the leaf space). Hence in the case of the off-shell Poisson bracket, the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
            is the space of
            %em
              %a.existingWikiWord{:href => "/nlab/show/source+field"} sources
            of a mechanical system. At the same time it is the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            of the
            %a.existingWikiWord{:href => "/nlab/show/2d+Chern-Simons+theory"} 2d Chern-Simons theory
            of which the mechanical system is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            of the
            %a.existingWikiWord{:href => "/nlab/show/bulk+field+theory"} bulk field theory
            are identified with the
            %a.existingWikiWord{:href => "/nlab/show/sources"} sources
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Fields
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                        %mtd
                          %msub
                            %mo ⇙
                            %mrow
                        %mtd
                        %mtd
                          %mi Sources
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mrow
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Phases
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; Fields
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  \\ast &amp;&amp; \swArrow_{} &amp;&amp; Sources
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow_{\mathrlap{}}
                  \\\
                  \&amp;&amp; Phases
                  }
                  \\,.
          %p Such a relation
          %table
            %thead
              %tr
                %th
                  %a.existingWikiWord{:href => "/nlab/show/bulk+field+theory"} bulk field theory
                %th
                  %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/source"} source
          %p
            between bulk fields and boundary sources is the characteristic feature of what is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/holographic+principle"} holographic principle
            in its realization as the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+correspondence"} AdS-CFT correspondence
          %h2#references References
          %p
            The off-shell extension of the
            %a.existingWikiWord{:href => "/nlab/show/Peierls+bracket"} Peierls bracket
            is observed in section II of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Don+Marolf"}> Don Marolf
              ,
              %em Poisson Brackets on the Space of Histories
              Annals of Physics Volume 236, Issue 2, December 1994, Pages 374-391 (
              %a{:href => "http://arxiv.org/abs/hep-th/9308141"}> arXiv:hep-th/9308141
              )
          %p The observation that the off-shell bracket has a symplectic foliation by the level sets of the Euler-Lagrange functions appears on the top of p. 4 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Romeo+Brunetti"}> Romeo Brunetti
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Klaus+Fredenhagen"} Klaus Fredenhagen
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pedro+Ribeiro"} Pedro Ribeiro
              %em Algebraic Structure of Classical Field Theory I: Kinematics and Linearized Dynamics for Real Scalar Fields
              (
              %a{:href => "http://arxiv.org/abs/1209.2148"}> arXiv:1209.2148
              )
          %p All this and the interpretation of the resulting symplectic foliation as a foliation by source terms has been highlighted by
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Igor+Khavkine"}> Igor Khavkine
              , personal communication
