            with
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
          #eq:SullivanModelX.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
