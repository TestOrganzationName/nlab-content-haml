                      %msup
                        %mi S
                        %mn 2
                  %mo ∧
                  %msub
                    %mi vol
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{S^2} vol_3
                  \\;=\;
                  \- vol_{S^2} \wedge vol_{S^2}
                  \\,.
          %p
            See also
            = succeed "." do
              %a{:href => "#FelixHalperinThomas00"} Félix-Halperin-Thomas 00, Example 1 on p. 178
          %h2#references References
          %p
            Under the general relation between the Sullivan model and the original Quillen model of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
          %ul
            %li#Quillen69
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> Daniel Quillen
              , section I.5 of
              = succeed "," do
                %em Rational Homotopy Theory
              = succeed ")" do
                %a{:href => "https://www.jstor.org/stable/1970725"} jstor:1970725
          %p It is made fully explicit in
          %ul
            %li#AndrewsArkowitz78
              %a.existingWikiWord{:href => "/nlab/show/Peter+Andrews"}> Peter Andrews
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Martin+Arkowitz"} Martin Arkowitz
              = succeed "," do
                %em Sullivan’s Minimal Models and Higher Order Whitehead Products
              %strong 30
              5 (1978) 961-982 &amp;lbrack;
              %a{:href => "https://doi.org/10.4153/CJM-1978-083-6"}> doi:10.4153/CJM-1978-083-6
              \&amp;rbrack;
          %p where the result is attributed to
          %ul
            %li#DeligneGriffithsMorganSullivan75
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Phillip+Griffiths"} Phillip Griffiths
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Morgan"} John Morgan
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dennis+Sullivan"} Dennis Sullivan
              = succeed "," do
                %em Real homotopy theory of Kähler manifolds
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/BF01389853"} doi:10.1007/BF01389853
          %p (which however just touches on it in passing)
          %p and in
          %ul
            %li
              Francisco Belchí,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urtzi+Buijs"} Urtzi Buijs
              = succeed "," do
                %em
                  Higher order Whitehead products and
