                            %mi π
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi ℚ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi α
                          %mo ,
                          %mi β
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ↦
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mi v
                          %mo ∧
                          %mi w
                          %mspace{:width => "thickmathspace"}
                          %mo ↦
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %msub
                                %mi n
                                %mi α
                              %mo ⋅
                              %msub
                                %mi n
                                %mi β
                          %mi α
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi w
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi α
                          %mo{:stretchy => "false"} (
                          %mi w
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  V^\ast
                  \\wedge
                  V^\ast
                  \&amp;\overset{\Phi}{\longrightarrow}&amp;
                  Hom_{Ab}
                  \\big(
                  \\pi_\bullet(X) \wedge \pi_\bullet(X)
                  ,
                  \\mathbb{Q}
                  \\big)
                  \\\
                  (\alpha, \beta)
                  \&amp;\mapsto&amp;
                  \\Big(
                  v \wedge w
                  \\;\mapsto\;
                  (-1)^{ n_\alpha \cdot n_\beta }
                  \\alpha(v)\cdot \beta(w)
                  +
                  \\beta(v)\cdot \alpha(w)
                  \\Big)
                  }
          %p
            where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            are assumed to be of homogeneous degree
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi α
                    %mo ,
                    %msub
                      %mi n
                      %mi β
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n_\alpha, n_\beta \in \mathbb{N}
          %p
            (Notice that the usual normalization factor of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 1/2
            is
            %em not
            included on the right. This normalization follows
            = succeed ".)" do
              %a{:href => "#AndrewsArkowitz78"} Andrews-Arkowitz 78, above Thm. 6.1
          %p Finally, write
          #eq:PojectionToBinary.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Sym
                    %mo •
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi V
                    %mo *
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⟶
                  %msup
                    %mi V
                    %mo *
                  %mo ∧
                  %msup
                    %mi V
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  [-]_2
                  \\;\colon\;
                  Sym^\bullet\big(V^\ast\big)
                  \\longrightarrow
                  V^\ast \wedge V^\ast
          %p
            for the linear projection on quadratic polynomials in the graded
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} symmetric algebra
          %h2#statement Statement
          #CoBinarySullivanDifferentialIsWhiteheadProduct.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/co-binary+Sullivan+differential+is+Whitehead+product"}> co-binary Sullivan differential is Whitehead product
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected topological space
              of rational
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
              with Sullivan differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi X
                  %annotation{:encoding => "application/x-tex"} d_X
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:SullivanModelX"} (1)
            %p
              Then the co-binary component
              %a.maruku-eqref{:href => "#eq:PojectionToBinary"} (3)
              of the Sullivan differential equals the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              %a.existingWikiWord{:href => "/nlab/show/linear+dual+map"} linear dual map
              of the
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+product"} Whitehead product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi X
                  %annotation{:encoding => "application/x-tex"} [-,-]_X
              on the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi d
                      %mi X
                    %mi α
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msubsup
                      %mo{:stretchy => "false"} ]
                      %mi X
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [d_X \alpha]_2
                    \\;=\;
                    [-,-]_X^\ast
                    \\,.
            %p
              More explicitly, the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi V
                              %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msub
                                  %mo{:stretchy => "false"} ]
                                  %mn 2
                                %mo ∘
                                %msub
                                  %mi d
                                  %mi X
                          %mtd
                            %msup
                              %mi V
                              %mo *
                            %mo ∧
                            %msup
                              %mi V
                              %mo *
                        %mtr
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mo =
                          %mtd
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mi Φ
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi Ab
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi ℚ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi Hom
                                  %mi Ab
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mo{:stretchy => "false"} [
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo ,
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msub
                                  %mo{:stretchy => "false"} ]
                                  %mi X
                                %mo ,
                                %mspace{:width => "thickmathspace"}
                                %mi ℚ
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %msub
                              %mi Hom
                              %mi Ab
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mspace{:width => "thickmathspace"}
                            %mi ℚ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    V^\ast
                    \&amp;\overset{ [-]_2\circ d_X }{\longrightarrow}&amp;
                    V^\ast \wedge V^\ast
                    \\\
                    \\big\downarrow^{ \mathrlap{=} }
                    \&amp;&amp;
                    \\big\downarrow^{ \mathrlap{\Phi} }
                    \\\
                    Hom_{Ab}
                    \\big(
                    \\pi_\bullet(X),
                    \\mathbb{Q}
                    \\big)
                    \&amp;
                    \\underset{
                    Hom_{Ab}\big(
                    [-,-]_X
                    ,
                    \\;
                    \\mathbb{Q}
                    \\big)
                    }{
                    \\longrightarrow
                    }
                    \&amp;
                    Hom_{Ab}
                    \\big(
                    \\pi_\bullet(X)
                    \\wedge
                    \\pi_\bullet(X),
                    \\;
                    \\mathbb{Q}
                    \\big)
                    }
                    \\,,
            %p
              where the wedge product on the right is normalized as in
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:WedgeProductNormalization"} (2)
          %p
            (
            %a{:href => "#AndrewsArkowitz78"}> Andrews-Arkowitz 78, Thm. 6.1
            , see also
            = succeed ")" do
              %a{:href => "#FelixHalperinThomas00"} Félix-Halperin-Thomas 00, Prop. 13.16
          %p
            %br/
          %h2#examples Examples
          %h3#HopfFibrations Hopf fibrations
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %msup
                    %mi S
                    %mn 2
                %annotation{:encoding => "application/x-tex"} X = S^2
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
            %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            of its
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            (
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+of+spheres"}> of spheres
            , as it were):
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi id
                        %mrow
                          %msup
                            %mi S
                            %mn 2
                      %mo ∈
                      %msub
                        %mi π
                        %mn 2
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} id_{S^2} \in \pi_2\big( S^2 \big)
                (represented by the
                %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 2
                        %mo →
                        %msup
                          %mi S
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} S^2 \to S^2
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mi ℂ
                      %mo ∈
                      %msub
                        %mi π
                        %mn 3
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msup
                        %mi S
                        %mn 3
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} h_{\mathbb{C}} \in \pi_3\big(  S^3 \big)
                (represented by the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/complex+Hopf+fibration"} complex Hopf fibration
          %p Then the Whitehead product satisfies
          #eq:WhiteheadProductOf2Sphere.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %msub
                    %mi id
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi id
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 2
                  %mo ⋅
                  %msub
                    %mi h
                    %mi ℂ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\big[
                  id_{S^2},
                  \\;
                  id_{S^2}
                  \\big]
                  \\;=\;
                  2 \cdot h_{\mathbb{C}}
                  \\,.
          %p
            (by
            = succeed ")." do
              %a{:href => "Whitehead+product#WhiteheadProductCorrespondingToComplexHopfFibration"} this Example
          %p Now let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi vol
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi vol
                    %mrow
                      %msup
                        %mi S
                        %mn 3
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mi CE
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi 𝔩
                  %msup
                    %mi S
                    %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  vol_{S^2},\; vol_{S^3}
                  \\;\in\;
                  CE\big( \mathfrak{l}S^2 \big)
          %p
            be the two generators of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rational+n-sphere"} Sullivan model of the 2-sphere
            %em normalized
            such that they correspond to the
            %a.existingWikiWord{:href => "/nlab/show/volume+forms"} volume forms
            of the
            %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
            and (after
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
            along the
            %a.existingWikiWord{:href => "/nlab/show/complex+Hopf+fibration"} complex Hopf fibration
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi ℂ
                  %annotation{:encoding => "application/x-tex"} h_{\mathbb{C}}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/3-sphere"} 3-sphere
          %p
            This means that the
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan differential
            is
          #eq:GenericDifferentialForSullivanModelOf2Sphere.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                  %msub
                    %mi vol
                    %mrow
                      %msup
                        %mi S
                        %mn 3
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi c
                  %mo ⋅
                  %msub
                    %mi vol
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                  %mo ∧
                  %msub
                    %mi vol
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                %annotation{:encoding => "application/x-tex"}
                  d_{S^2} vol_{S^3}
                  \\;=\;
                  c \cdot
                  vol_{S^2} \wedge vol_{S^2}
          %p
            for some
            %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational number
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} c \in \mathbb{Q}
          %p
            Notice that with the normalization in
            %a.maruku-eqref{:href => "#eq:WedgeProductNormalization"} (2)
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi Φ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi vol
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo ,
                          %msub
                            %mi vol
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi id
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo ∧
                          %msub
                            %mi id
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mn 2
                              %mo ⋅
                              %mn 2
                          %msub
                            %mi vol
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi id
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ⋅
                          %msub
                            %mi vol
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi id
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo +
                          %msub
                            %mi vol
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi id
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ⋅
                          %msub
                            %mi vol
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi id
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\Phi(vol_{S^2}, vol_{S^2})\big(  id_{S^2} \wedge id_{S^2} \big)
                  \&amp; =
                  (-1)^{2 \cdot 2}
                  vol_{S^2}\big( id_{S^2}\big)
                  \\cdot
                  vol_{S^2}\big( id_{S^2}\big)
                  +
                  vol_{S^2}\big( id_{S^2}\big)
                  \\cdot
                  vol_{S^2}\big( id_{S^2}\big)
                  \\\
                  \&amp; =
                  2
                  \\end{aligned}
          %p
            Therefore Prop.
            %a.maruku-ref{:href => "#CoBinarySullivanDifferentialIsWhiteheadProduct"}
            gives
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                          %msub
                            %mi vol
                            %mrow
                              %msup
                                %mi S
                                %mn 3
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mo{:stretchy => "false"} ]
                                %mn 2
                              %mo ∘
                              %msub
                                %mi d
                                %mrow
                                  %msup
                                    %mi S
                                    %mn 2
                        %mtd
                          %mi c
                          %mo ′
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi vol
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo ⊗
                          %msub
                            %mi vol
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mpadded{:width => "0"}
                              %mi Φ
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                          %msub
                            %mi h
                            %mi ℍ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msubsup
                                %mo{:stretchy => "false"} ]
                                %mi X
                                %mo *
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                          %msub
                            %mi id
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo ∧
                          %msub
                            %mi id
                            %mrow
                              %msup
                                %mi S
                                %mn 2
                          %mo ↦
                          %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\big\{
                  vol_{S^3}
                  \\big\}
                  \&amp;\overset{[-]_2\circ d_{S^2}}{\longrightarrow}&amp;
                  c' \cdot ( vol_{S^2} \otimes vol_{S^2} )
                  \\\
                  \\big\downarrow
                  \&amp;&amp;
                  \\big\downarrow^{\mathrlap{\Phi}}
                  \\\
                  \\big\{
                  h_{\mathbb{H}}
                  \\big\}
                  \&amp;\overset{ [-,-]_X^\ast }{\longrightarrow}&amp;
                  \\big\{
                  id_{S^2} \wedge id_{S^2}
                  \\mapsto
                  2
                  \\big\}
                  }
          %p
            where in the bottom row we used the Whitehead product
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:WhiteheadProductOf2Sphere"} (4)
          %p
            Hence
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} c = 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                  %msub
                    %mi vol
                    %mn 3
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %msub
                    %mi vol
