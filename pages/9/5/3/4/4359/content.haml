          #ClosedIrreducible.num_defn
            %h6#definition_2 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %strong irreducible
              if it is
              %a.existingWikiWord{:href => "/nlab/show/inhabited"} inhabited
              and not the
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              of two closed proper (i.e. smaller) subspaces. In other words,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is irreducible if whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} F_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F_2
              are closed subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %msub
                      %mi F
                      %mn 1
                    %mo ∪
                    %msub
                      %mi F
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    F = F_1 \cup F_2
            %p
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 1
                    %mo =
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F_1 = F
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 2
                      %mo =
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F_2 = F
          %p
            Equivalently this may be expressed in terms of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
          #OpenSubsetVersionOfClosedIrreducible.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \tau)
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi τ
                    %mo ⊂
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P \in \tau \subset P(X)
              be a proper
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ≔
                    %mi X
                    %mo \
                    %mi P
                  %annotation{:encoding => "application/x-tex"} F \coloneqq X\backslash P
              is an
              %a.existingWikiWord{:href => "/nlab/show/inhabited"} inhabited
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is
              %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subspace"} irreducible
              in the sense of def.
              %a.maruku-ref{:href => "#ClosedIrreducible"}
              precisely if whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %msub
                      %mi U
                      %mn 2
                    %mo ∈
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} U_1,U_2 \in \tau
              are open subsets with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ∩
                    %msub
                      %mi U
                      %mn 2
                    %mo ⊂
                    %mi P
                  %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 \subset P
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ⊂
                    %mi P
                  %annotation{:encoding => "application/x-tex"} U_1 \subset P
              or
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %mi P
                    %annotation{:encoding => "application/x-tex"} U_2 \subset P
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo \
                    %mi P
                    %mspace{:width => "thinmathspace"}
                    %mtext irreducible
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %munder
                        %mo ∀
                        %mrow
                          %msub
                            %mi U
                            %mn 1
                          %mo ,
                          %msub
                            %mi U
                            %mn 2
                          %mo ∈
                          %mi τ
                      %mrow
                        %mo (
                        %mrow
                          %mo (
                          %msub
                            %mi U
                            %mn 1
                          %mo ∩
                          %msub
                            %mi U
                            %mn 2
                          %mo ⊂
                          %mi P
                          %mo )
                        %mspace{:width => "thickmathspace"}
                        %mo ⇒
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo (
                          %msub
                            %mi U
                            %mn 1
                          %mo ⊂
                          %mi P
                          %mspace{:width => "thickmathspace"}
                          %mtext or
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi U
                            %mn 2
                          %mo ⊂
                          %mi P
                          %mo )
                        %mo )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    X \backslash P \,\text{irreducible}
                    \\;\Leftrightarrow\;
                    \\left(
                    \\underset{U_1, U_2 \in \tau}{\forall }
                    \\left(
                    \\left(
                    U_1 \cap U_2 \subset P
                    \\right)
                    \\;\Rightarrow\;
                    \\left(U_1 \subset P \;\text{or}\; U_2 \subset P\right)
                    \\right)
                    \\right)
          .proof
            %h6#proof Proof
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi i
                    %mo ⊂
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F_i \subset F
              may be exhibited as the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi i
                    %mo =
                    %mi F
                    %mo \
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    F_i = F \backslash U_i
            %p
              for some open subset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ∈
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} U_i \in \tau
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ∩
                    %msub
                      %mi U
                      %mn 2
                    %mo ⊂
                    %mi P
                  %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 \subset P
              is equivalent to the condition that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 1
                      %mo ∪
                      %msub
                        %mi F
                        %mn 2
                      %mo =
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F_1 \cup F_2 = F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⋆
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\star)
              in the following sequence of equations:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi F
                              %mn 1
                            %mo ∪
                            %msub
                              %mi F
                              %mn 2
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo \
                            %msub
                              %mi U
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ∪
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo \
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mi X
                              %mo \
                              %mo{:stretchy => "false"} (
                              %mi P
                              %mo ∪
                              %msub
                                %mi U
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mo ∪
                            %mrow
                              %mo (
                              %mi X
                              %mo \
                              %mi P
                              %mo ∪
                              %msub
                                %mi U
                                %mn 2
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                            %mo \
                            %mo{:stretchy => "false"} (
                            %mi P
                            %mo ∪
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %mo ∩
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mover
                              %mo =
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo ⋆
                                %mo{:stretchy => "false"} )
                            %mi X
                            %mo \
                            %mi P
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi F
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    F_1 \cup F_2
                    \&amp; =
                    (F \backslash U_1) \cup (F \backslash U_2)
                    \\\
                    \&amp;
                    \= \left( X \backslash (P \cup U_1) \right) \cup \left( X \backslash P \cup U_2 \right)
                    \\\
                    \&amp; = X \backslash ( P \cup (U_1 \cap U_2)  )
                    \\\
                    \&amp; \stackrel{(\star)}{=}   X \backslash P
                    \\\
                    \&amp; = F
                    \\end{aligned}
                    \\,.
            %p
              Similarly, the condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi P
                  %annotation{:encoding => "application/x-tex"} U_i \subset P
              is equivalent to the condition that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi i
                      %mo =
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F_i = F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⋆
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\star)
              in the following sequence of equalities:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi F
                              %mi i
                          %mtd
                            %mo =
                            %mi F
                            %mo \
                            %msub
                              %mi U
                              %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                            %mo \
                            %mo{:stretchy => "false"} (
                            %mi P
                            %mo ∪
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mover
                              %mo =
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo ⋆
                                %mo{:stretchy => "false"} )
                            %mi X
                            %mo \
                            %mi P
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi F
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    F_i &amp;= F \backslash U_i
                    \\\
                    \&amp; = X \backslash ( P \cup U_i )
                    \\\
                    \&amp; \stackrel{(\star)}{=} X \backslash P
                    \\\
                    \&amp; =
                    F
                    \\end{aligned}
                    \\,.
            %p Under these equivalences, the two conditions are manifestly the same.
          %p Yet another equivalent characterization is in terms of frame homomorphisms:
          %p In the following we write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %msub
                    %mi τ
                    %mo *
                  %mo =
                  %mrow
                    %mo {
                    %mi ∅
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\ast \coloneqq (\{1\}, \tau_\ast = \left\{ \emptyset, \{1\}\right\})
          %p
            for the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/point"} point
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
          #FrameHomomorphismsToPointAreIrrClSub.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              between the
              %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subspaces"} irreducible closed subspaces
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              and the
              %a.existingWikiWord{:href => "/nlab/show/frame"} frame
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \tau_X
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \tau_\ast
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi Frame
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi τ
                              %mi X
                            %mo ,
                            %msub
                              %mi τ
                              %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mrow
                          %mtd
                            %mi IrrClSub
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi ϕ
                          %mtd
                            %mo ↦
                          %mtd
                            %mi X
                            %mo \
                            %msub
                              %mi U
                              %mi ∅
                            %mo{:stretchy => "false"} (
                            %mi ϕ
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom_{Frame}(\tau_X, \tau_\ast)
                    \&amp;\underoverset{\simeq}{}{\longrightarrow}&amp;
                    IrrClSub(X)
                    \\\
                    \\phi
                    \&amp;\mapsto&amp;
                    X \backslash U_\emptyset(\phi)
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_\emptyset(\phi)
              is the
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              of all elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %msub
                      %mi τ
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U \in \tau_x
              such that
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \phi(U) = \emptyset
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mo ∪
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi U
                            %mo ∈
                            %msub
                              %mi τ
                              %mi X
                        %mrow
                          %mrow
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi ∅
                    %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_{\emptyset}(\phi)
                    \\coloneqq
                    \\underset{{U \in \tau_X} \atop {\phi(U) = \emptyset} }{\cup}
                    U
                    \\,.
          %p
            See also (
            %a.existingWikiWord{:href => "/nlab/show/Stone+Spaces"}> Johnstone 82, II 1.3
            ).
          .proof
            %h6#proof_2 Proof
            %p
              First we need to show that the function is well defined in that given a frame homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi τ
                      %mi X
                    %mo →
                    %msub
                      %mi τ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \phi \colon \tau_X \to \tau_\ast
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo \
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \backslash U_\emptyset(\phi)
              is indeed an irreducible closed subspace.
            %p To that end observe that:
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\ast)
              %em
                If there are two elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ,
                      %msub
                        %mi U
                        %mn 2
                      %mo ∈
                      %msub
                        %mi τ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} U_1, U_2 \in \tau_X
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ∩
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %msub
                        %mi U
                        %mi ∅
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 \subset U_{\emptyset}(\phi)
                then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ⊂
                      %msub
                        %mi U
                        %mi ∅
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U_1 \subset U_{\emptyset}(\phi)
                or
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 2
                        %mo ⊂
                        %msub
                          %mi U
                          %mi ∅
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U_2 \subset U_{\emptyset}(\phi)
            %p This is because
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %mo ∩
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ⊂
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi ∅
                            %mo{:stretchy => "false"} (
                            %mi ∅
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi ∅
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\phi(U_1) \cap \phi(U_2)
                    \&amp; =
                    \\phi(U_1 \cap U_2)
                    \\\
                    \&amp; \subset \phi(U_{\emptyset}(\emptyset))
                    \\\
                    \&amp; =
                    \\emptyset
                    \\end{aligned}
                    \\,,
            %p
              (where the first equality holds because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              preserves finite intersections, the inclusion holds because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              respects inclusions, and the second equality holds because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              preserves arbitrary unions). But in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mo *
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi ∅
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \tau_\ast = \{\emptyset, \{1\}\}
              the intersection of two open subsets is empty precisely if at least one of them is empty, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \phi(U_1) = \emptyset
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \phi(U_2) = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ⊂
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_1 \subset U_{\emptyset}(\phi)
              or
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %msub
                        %mi U
                        %mi ∅
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U_2 \subset U_{\emptyset}(\phi)
            %p
              Now according to prop.
              %a.maruku-ref{:href => "#OpenSubsetVersionOfClosedIrreducible"}
              the condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\ast)
              identifies the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo \
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \backslash U_{\emptyset}(\phi)
              as an
              %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subspace"} irreducible closed subspace
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau)
            %p
              Conversely, given an irreducible closed subset
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo \
                      %msub
                        %mi U
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} X \backslash U_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ∅
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thinmathspace"}
                              %mtext if
                              %mspace{:width => "thinmathspace"}
                              %mi U
                              %mo ⊂
                              %msub
                                %mi U
                                %mn 0
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} {
                              %mn 1
                              %mo{:stretchy => "false"} }
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thinmathspace"}
                              %mtext otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi
                    \\;\colon\;
                    U
                    \\mapsto
                    \\left\{
                    \\array{
