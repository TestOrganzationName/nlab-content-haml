          %h2#idea Idea
          %p
            A
            %em pullback in a derivator
            is the generalization to the context of a
            %a.existingWikiWord{:href => "/nlab/show/derivator"} derivator
            of the notion of
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            in ordinary category theory. Viewing a derivator as the “shadow” of an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            in an
            = succeed "-category." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo □
                %annotation{:encoding => "application/x-tex"} \square
            denote the category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi a
                        %mtd
                          %mo →
                        %mtd
                          %mi b
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi c
                        %mtd
                          %mo →
                        %mtd
                          %mi d
                %annotation{:encoding => "application/x-tex"} \array{a &amp; \to &amp; b \\ \downarrow &amp; &amp; \downarrow \\ c &amp; \to &amp; d}
          %p
            that is the “free-living
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/commutative+square"} commutative square
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            be the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo □
                %annotation{:encoding => "application/x-tex"} \square
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ,
                    %mi c
                    %mo ,
                    %mi d
                  %annotation{:encoding => "application/x-tex"} b,c,d
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo{:lspace => "verythinmathspace"} :
                    %mi L
                    %mo →
                    %mo □
                  %annotation{:encoding => "application/x-tex"} u\colon L\to \square
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            be a
            %a.existingWikiWord{:href => "/nlab/show/derivator"} derivator
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mo □
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X\in D(\square)
            be a commutative square in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            = succeed "," do
              %strong pullback square
            = succeed "," do
              %strong cartesian
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msub
                    %mi u
                    %mo *
                  %msup
                    %mi u
                    %mo *
                  %mi X
                %annotation{:encoding => "application/x-tex"} X\to u_* u^* X
            of the
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi u
                    %mo *
                  %mo ⊣
                  %msub
                    %mi u
                    %mo *
                %annotation{:encoding => "application/x-tex"} u^*\dashv u_*
            is an isomorphism. Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful"} fully faithful
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo *
                  %annotation{:encoding => "application/x-tex"} u_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo ∈
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Y\in D(L)
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≅
                    %msub
                      %mi u
                      %mo *
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X\cong u_* Y
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is merely a prederivator, then we can phrase the same definition by saying that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            has the
            %a.existingWikiWord{:href => "/nlab/show/free+object"} universal property
            that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo *
                  %msup
                    %mi u
                    %mo *
                  %mi X
                %annotation{:encoding => "application/x-tex"} u_* u^* X
            would, if the whole functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo *
                %annotation{:encoding => "application/x-tex"} u_*
            existed.
          %p
            The dual notion, of course, is a
            %strong pushout
            or
            %strong cocartesian
            square.
          %h2#properties Properties
          %h3#Pasting Pasting law
          %p
            Using properties of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+exact+squares"} homotopy exact squares
          .un_lemma
            %h6#lemma Lemma
            %p Given a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                            %mo →
                          %mtd
                            %mi b
                          %mtd
                            %mo →
                          %mtd
                            %mi c
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi d
                          %mtd
                            %mo →
                          %mtd
                            %mi e
                          %mtd
                            %mo →
                          %mtd
                            %mi f
                  %annotation{:encoding => "application/x-tex"}
                    \\array{a &amp; \to &amp; b &amp; \to &amp; c \\
                    \\downarrow &amp; &amp; \downarrow &amp; &amp; \downarrow \\
                    d &amp; \to &amp; e &amp; \to &amp; f }
            %p
              in which the right-hand square
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi bcef
                  %annotation{:encoding => "application/x-tex"} bcef
              is a pullback, then the left-hand square
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi abde
                  %annotation{:encoding => "application/x-tex"} abde
              is a pullback if and only if the outer rectangle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi acdf
                  %annotation{:encoding => "application/x-tex"} acdf
              is a pullback.
          %p
            The following proof should be compared and contrasted with the
            %a{:href => "http://ncatlab.org/nlab/show/pullback#Pasting"} standard proof
            for pullbacks in 1-categories, and the
            %a{:href => "http://ncatlab.org/nlab/show/%28infinity%2C1%29-pullback#QuasiCatPastingLaw"} quasi-categorical proof
            for pullbacks in
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .proof
            %h6#proof Proof
            %p
              First of all, by “a diagram” in a derivator, we mean an object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(X)
              for some suitable category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the category consisting of two commutative squares, as pictured above. We’ll write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi abcdef
                  %annotation{:encoding => "application/x-tex"} abcdef
              for this
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cdef
                  %annotation{:encoding => "application/x-tex"} cdef
              for its lower-right L-shaped subcategory, and so on. We leave the verification of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+exact+square"} homotopy exactness
              of all squares to the reader.
            %p Firstly, since the squares
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi cef
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi bcef
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi cdef
                          %mtd
                            %munder
                              %mo →
                              %mrow
                          %mtd
                            %mi abcdef
                    %mspace{:width => "2em"}
                    %mi and
                    %mspace{:width => "2em"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi cdf
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi acdf
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi cdef
                          %mtd
                            %munder
                              %mo →
                              %mrow
                          %mtd
                            %mi abcdef
                  %annotation{:encoding => "application/x-tex"}
                    \\array{cef &amp; \overset{}{\to} &amp; bcef\\
                    \\downarrow &amp;&amp; \downarrow\\
                    cdef &amp; \underset{}{\to} &amp; abcdef} \qquad and \qquad
                    \\array{cdf &amp; \overset{}{\to} &amp; acdf\\
                    \\downarrow &amp;&amp; \downarrow\\
                    cdef&amp; \underset{}{\to} &amp; abcdef}
            %p
              are exact, if we start from a
              = succeed "-diagram" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cdef
                    %annotation{:encoding => "application/x-tex"} cdef
              = succeed "-diagram," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi abcdef
                    %annotation{:encoding => "application/x-tex"} abcdef
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cdef
                  %annotation{:encoding => "application/x-tex"} cdef
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi abcdef
                  %annotation{:encoding => "application/x-tex"} abcdef
              is equivalent to first extending to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi bcdef
                  %annotation{:encoding => "application/x-tex"} bcdef
              and then to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi abcdef
                    %annotation{:encoding => "application/x-tex"} abcdef
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi bde
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi abde
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi bcdef
                          %mtd
                            %munder
                              %mo →
                              %mrow
                          %mtd
                            %mi abcdef
                  %annotation{:encoding => "application/x-tex"}
                    \\array{bde &amp; \overset{}{\to} &amp; abde\\
                    \\downarrow &amp;&amp; \downarrow\\
                    bcdef &amp; \underset{}{\to} &amp; abcdef}
            %p is exact, the left-hand square in such an extension must also be a pullback.
            %p
              Now if we start with an
              = succeed "-diagram," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi abcdef
                    %annotation{:encoding => "application/x-tex"} abcdef
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "-diagram" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cdef
                    %annotation{:encoding => "application/x-tex"} cdef
              = succeed "-diagram." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi abcdef
                    %annotation{:encoding => "application/x-tex"} abcdef
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo{:lspace => "verythinmathspace"} :
                    %mi cdef
                    %mo →
                    %mi abcdef
                  %annotation{:encoding => "application/x-tex"} u\colon cdef \to abcdef
              is the inclusion, then this results in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mo *
                      %msup
                        %mi u
                        %mo *
                      %mi F
                    %annotation{:encoding => "application/x-tex"} u_\ast u^\ast F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mo →
                    %msub
                      %mi u
                      %mo *
                    %msup
                      %mi u
                      %mo *
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \eta \colon F \to u_\ast u^\ast F
              (the unit of the adjunction
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi u
                        %mo *
                      %mo ⊣
                      %msub
                        %mi u
                        %mo *
                    %annotation{:encoding => "application/x-tex"} u^\ast \dashv u_\ast
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi cdef
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi cdef
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi cdef
                          %mtd
                            %munder
                              %mo →
                              %mrow
                          %mtd
                            %mi abcdef
                  %annotation{:encoding => "application/x-tex"}
                    \\array{cdef &amp; \overset{}{\to} &amp; cdef \\
                    \\downarrow &amp;&amp; \downarrow\\
                    cdef &amp; \underset{}{\to} &amp; abcdef}
            %p
              is exact, the counit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mo *
                    %msub
                      %mi u
                      %mo *
                    %mi G
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} u^\ast u_\ast G \to G
              is an isomorphism for any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo =
                      %msup
                        %mi u
                        %mo *
                      %mi F
                    %annotation{:encoding => "application/x-tex"} G=u^\ast F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mo *
                    %mi F
                    %mo →
                    %msup
                      %mi u
                      %mo *
                    %msub
                      %mi u
                      %mo *
                    %msup
                      %mi u
                      %mo *
                    %mi F
                  %annotation{:encoding => "application/x-tex"} u^\ast F \to u^\ast u_\ast u^\ast F
              is also an isomorphism — i.e. the components of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mo →
                    %msub
                      %mi u
                      %mo *
                    %msup
                      %mi u
                      %mo *
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \eta\colon F \to u_\ast u^\ast F
              at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              are isomorphisms. Now if the right-hand square of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is a pullback, then the restrictions of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo *
                    %msup
                      %mi u
                      %mo *
                    %mi F
                  %annotation{:encoding => "application/x-tex"} u_\ast u^\ast F
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi bcef
                  %annotation{:encoding => "application/x-tex"} bcef
              are both pullback squares; hence since the
              = succeed "-components" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cef
                    %annotation{:encoding => "application/x-tex"} cef
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              are isomorphisms, so is the
              = succeed "-component." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is a pullback, then we can play the same game with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi abde
                  %annotation{:encoding => "application/x-tex"} abde
              to show that the
              = succeed "-component" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is an isomorphism, while if the outer rectangle is a pullback, we can play it with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi acdf
                    %annotation{:encoding => "application/x-tex"} acdf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              itself is an isomorphism, since all of its components are — and thus the remaining square in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is also a pullback, since we have shown that it is so in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mo *
                      %msup
                        %mi u
                        %mo *
                      %mi F
                    %annotation{:encoding => "application/x-tex"} u_\ast u^\ast F
          %h3#Detection Detection Lemma
          %p
            The following lemma, which detects when squares occurring in a Kan extension are pullbacks or pushouts, is due to
            = succeed ";" do
              %a{:href => "#Franke"} Jens Franke
            = succeed "." do
              %a{:href => "#Groth"} Groth
          #CartesianSquareDetection.num_lemma
            %h6#lemma_2 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi K
                    %mo →
                    %mi J
                  %annotation{:encoding => "application/x-tex"} f\colon K\to J
              be any functor and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mo □
                    %mo →
                    %mi J
                  %annotation{:encoding => "application/x-tex"} i\colon \square \to J
              be injective on objects, with lower vertex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi z
                    %annotation{:encoding => "application/x-tex"} i(1,1) = z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              is not in the image of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo ∖
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi z
                  %annotation{:encoding => "application/x-tex"} \Gamma \to (J \setminus z)/z
              is a nerve equivalence (such as if it has an adjoint). Then for any derivator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              and any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo ∈
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Y\in D(K)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %msub
                      %mi f
                      %mo !
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} i^* f_! Y
              is cocartesian.
          .proof
            %h6#proof_2 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mo =
                    %msub
                      %mi j
                      %mo !
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ¯
                      %mo !
                  %annotation{:encoding => "application/x-tex"} f_! = j_! \bar{f}_!
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                    %mo{:lspace => "verythinmathspace"} :
                    %mi K
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo ∖
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \bar{f}\colon K\to (J\setminus z)
              is induced by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo ∖
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi J
                  %annotation{:encoding => "application/x-tex"} j\colon (J\setminus z) \to J
              is the inclusion, it suffices to suppose that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi J
                      %mo ∖
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K = (J\setminus z)
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+exact+square"} homotopy exact
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Γ
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo ∖
                            %mi z
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo □
                          %mtd
                            %mo →
                          %mtd
                            %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ \Gamma &amp;\to &amp; (J\setminus z) \\
                    \\downarrow &amp;&amp; \downarrow\\
                    \\square &amp;\to &amp; J}
            %p
              Exactness is trivial at all objects of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo □
                  %annotation{:encoding => "application/x-tex"} \square
              except
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Γ
                          %mtd
                            %mo →
                          %mtd
                            %mi Γ
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo ∖
                            %mi z
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo ,
                                %mn 1
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mo □
                          %mtd
                            %mo →
                          %mtd
                            %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ \Gamma &amp;\to&amp; \Gamma &amp;\to &amp; (J\setminus z) \\
                    \\downarrow &amp; \swArrow &amp; \downarrow &amp;&amp; \downarrow\\
                    \\ast &amp;\underset{(1,1)}{\to} &amp;\square &amp;\to &amp; J}
            %p
              The left-hand square is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/comma+square"} comma square
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi J
                    %mo ←
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo ∖
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \ast \to J \leftarrow (J\setminus z)
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi J
                      %mo ∖
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi z
                    %annotation{:encoding => "application/x-tex"} (J \setminus z)/z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo ∖
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi z
                  %annotation{:encoding => "application/x-tex"} \Gamma \to (J \setminus z)/z
              which is assumed a nerve equivalence; hence it is also homotopy exact.
