                            %mrow
                            %mrow
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mrow
                              %mi t
                              %mo ∘
                              %msub
                                %mi pr
                                %mn 3
                      %mtr
                        %mtd
                          %mi pr
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mi Obj
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mi s
                          %mo ↖
                        %mtd
                        %mtd
                          %msub
                            %mo ↗
                            %mi λ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi S
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; S {}_\lambda \times_s Mor(C) {}_t \times_s Mor(C)
                  \\\
                  \&amp; {}^{}\swarrow &amp;&amp; \searrow^{t \circ pr_3}
                  \\\
                  pr &amp;&amp;\downarrow &amp;&amp; Obj(C)
                  \\\
                  \&amp; {}^{s}\nwarrow &amp;&amp; \nearrow_{\lambda}
                  \\\
                  \&amp;&amp;
                  S
                  }
                  \\,.
          %p
            The
            %strong action property
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            in the above description, says precisely that these two morphisms coincide.
          %p Abstractly this says that
          %ul
            %li
              %p
                a (small)
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                is a
                %a.existingWikiWord{:href => "/nlab/show/monad"} monad
                in
                %a.existingWikiWord{:href => "/nlab/show/span"} spans
                in
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/action"} action
                of a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                on a
                %a.existingWikiWord{:href => "/nlab/show/set"} set
                is an
                %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
                for this
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/monad"} monad
          .query
            %p
              Generalizing this slightly, it should be possible to associate an action of a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              on a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi c
                        %mo ∈
                        %msub
                          %mi C
                          %mn 0
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \coprod_{c\in C_0}\rho(c)
              to a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo :
                    %mi C
                    %mo →
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Cat
                  %annotation{:encoding => "application/x-tex"} \rho:C\rightarrow \Cat
              with the expectation, that this then is just a module for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              as a monad.
