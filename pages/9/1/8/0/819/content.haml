                  \\\
                  \&amp;&amp; Mor(C)
                  \&amp;&amp;&amp;&amp;
                  Mor(C)
                  \\\
                  \&amp;
                  {}^s\swarrow
                  \&amp;&amp; \searrow^t
                  \&amp;&amp;
                  {}^s\swarrow
                  \&amp;&amp; \searrow^t
                  \\\
                  Obj(C)
                  \&amp;&amp;&amp;&amp;
                  Obj(C)
                  \&amp;&amp;&amp;&amp;
                  Obj(C)
                  }
          %p
            and the composition operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∘
                %annotation{:encoding => "application/x-tex"} \circ
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a morphism from this composed span to the original span
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                          %msub
                            %mrow
                            %mi t
                          %msub
                            %mo ×
                            %mi s
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mrow
                              %mi s
                              %mo ∘
                              %msub
