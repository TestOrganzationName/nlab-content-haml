                  \\\
                  \&amp; {}^{s \circ pr_1}\swarrow &amp;&amp; \searrow^{t \circ pr_2}
                  \\\
                  Obj(C) &amp;&amp;\downarrow^{\circ}&amp;&amp; Obj(C)
                  \\\
                  \&amp; {}^{s}\nwarrow &amp;&amp; \nearrow_{t}
                  \\\
                  \&amp;&amp;
                  Mor(C)
                  }
                  \\,.
          %p
            In total this gives us two different ways to map the total span with tip
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %msub
                    %mrow
                    %mi λ
                  %msub
                    %mo ×
                    %mi s
                  %mi Mor
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %msub
                    %mrow
                    %mi t
                  %msub
                    %mo ×
                    %mi s
                  %mi Mor
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S {}_\lambda \times_s Mor(C) {}_t \times_s Mor(C)
            obtained by composing the anchor map span with two copies of the span of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            back to the anchor map span
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi S
                          %msub
                            %mrow
                            %mi λ
                          %msub
                            %mo ×
                            %mi s
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                          %msub
                            %mrow
                            %mi t
                          %msub
                            %mo ×
                            %mi s
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
