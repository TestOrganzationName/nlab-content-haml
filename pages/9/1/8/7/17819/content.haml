                %li
                  %a{:href => "#abstract_clones_from_presentations_of_algebraic_theories"} Abstract clones from presentations of algebraic theories
                %li
                  %a{:href => "#algebraic_theories_from_abstract_clones"} Algebraic theories from abstract clones
                %li
                  %a{:href => "#lawvere_theories_and_abstract_clones"} Lawvere theories and abstract clones
              %li
                %a{:href => "#algebras_of_abstract_clones_and_connection_with_finitary_monads"} Algebras of abstract clones and connection with finitary monads
              %li
                %a{:href => "#monadicity_of_the_category_of_abstract_clones"} Monadicity of the category of abstract clones
              %li
