                        \\\
                        \&amp; {}_{\mathrlap{\Phi_i}}\searrow &amp;&amp; \swarrow_{\mathrlap{\Phi_j}}
                        \\\
                        \&amp;&amp; X
                        }
            %p
              Finally, given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X_2
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              between them
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
