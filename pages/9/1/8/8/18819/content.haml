          .proof
            %h6#proof_4 Proof
            %p
              This follows by an analogous argument as in example
              = succeed "," do
                %a.maruku-ref{:href => "#SyntheticTangentVectorFields"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hadamard+lemma"} Hadamard lemma
          %p
            While in
            %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+smooth+manifolds"} infinitesimally thickened Cartesian spaces
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#InfinitesimallyThickendSmoothManifold"}
            %a.existingWikiWord{:href => "/nlab/show/infinitesimals"} infinitesimals
            to any
            %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
            order may exist, in
            %a.existingWikiWord{:href => "/nlab/show/formal+smooth+sets"} formal smooth sets
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#FormalSmoothSet"}
          #InfinitesimalNeighbourhood.num_example
            %h6#example_19 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"}> infinitesimal neighbourhood
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/formal+smooth+sets"} formal smooth sets
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FormalSmoothSet"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \hookrightarrow X
              a sub-formal smooth set. Then the
              %em
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              to arbitrary infinitesimal order of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/formal+smooth+set"} formal smooth set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi X
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} N_X Y
              whose plots are those plots of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ×
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi f
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^n \times Spec(A) \overset{f}{\longrightarrow} X
            %p
              such that their
              %a.existingWikiWord{:href => "/nlab/show/reduced+object"} reduction
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ReductionAndInfinitesimalShape"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ×
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi f
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^n \hookrightarrow \mathbb{R}^n \times Spec(A) \overset{f}{\longrightarrow} X
            %p
              factors through a plot of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
          %p
            This allows to grasp the restriction of
            %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
            to the
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
            of a
            %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %a.existingWikiWord{:href => "/nlab/show/phase+spaces"} phase spaces
            = succeed "." do
              %a{:href => "#PhaseSpace"} below
          #FieldHistoriesOnInfinitesimalNeighbourhoodOfSubmanifoldOfSpacetime.num_defn
            %h6#definition_9 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
                on
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
                of
                %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} S \hookrightarrow \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} N_\Sigma(S) \hookrightarrow \Sigma
              for its
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#InfinitesimalNeighbourhood"}
            %p
              Then the
              = succeed "," do
                %em
                  set of field histories restricted to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
            #eq:SpaceOfFieldHistoriesInHigherCodimension.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi N
                          %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi N
                          %mi Σ
                        %mi S
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{S}(E) \coloneqq \Gamma_{N_\Sigma(S)}( E\vert_{N_\Sigma S} ) \in \mathbf{H}
            %p
              is the set of section of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              restricted to the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N_\Sigma(S)
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#InfinitesimalNeighbourhood"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            We close the discussion of
            %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} infinitesimal differential geometry
            by explaining how we may recover the concept of
            %em
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            inside the more general
            %a.existingWikiWord{:href => "/nlab/show/formal+smooth+sets"} formal smooth sets
            (def./prop.
            %a.maruku-ref{:href => "#SmoothManifoldInsideDiffeologicalSpaces"}
            below). The key point is that the presence of
            %a.existingWikiWord{:href => "/nlab/show/infinitesimals"} infinitesimals
            in the theory allows an intrinsic definition of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphisms"} local diffeomorphisms
            %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphism"} formally étale morphism
            (def.
            %a.maruku-ref{:href => "#FormalSmoothSetLocalDiffeomorphism"}
            and example
            %a.maruku-ref{:href => "#AbstractLocalDiffeomorphismsOfCartesianSpaces"}
            below). It is noteworthy that the only role this concept plays in the development of
            %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
            below is that
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            admit
            %a.existingWikiWord{:href => "/nlab/show/triangulations"} triangulations
            by smooth
            %a.existingWikiWord{:href => "/nlab/show/singular+simplices"} singular simplices
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#SingularSimplicesInCartesianSpaces"}
            %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber
            %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
            is well defined over manifolds.
          #FormalSmoothSetLocalDiffeomorphism.num_defn
            %h6#definition_10 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphism"} local diffeomorphism
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/formal+smooth+sets"} formal smooth sets
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X,Y
              be
              %a.existingWikiWord{:href => "/nlab/show/formal+smooth+sets"} formal smooth sets
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FormalSmoothSet"}
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              between them is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphism"} local diffeomorphism
              or
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphism"} formally étale morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mi et
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \overset{et}{\longrightarrow} Y
                    \\,,
            %p
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              if for each
              %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+smooth+manifold"} infinitesimally thickened Cartesian space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InfinitesimallyThickendSmoothManifold"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ×
                    %mi 𝔻
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \times \mathbb{D}
              we have a natural identification between the
              = succeed "-plots" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ×
                      %mi 𝔻
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \times \mathbb{D}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with those
              = succeed "-plots" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                      %mi n
                      %mo ×
                      %mi 𝔻
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n n\times \mathbb{D}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              whose
              %a.existingWikiWord{:href => "/nlab/show/reduction+modality"} reduction
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ReductionAndInfinitesimalShape"}
              = succeed "-plot" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              of
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
