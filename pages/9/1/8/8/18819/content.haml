                      %mrow
                        %mi Φ
                        %mo ∈
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Phi \in X(\mathbb{R}^n)
                  a plot of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} X_1
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
