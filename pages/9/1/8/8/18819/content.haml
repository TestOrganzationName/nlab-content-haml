                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %em actual
              smooth functions into
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof_5 Proof
            %p
              This is the statement of the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              over the
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+spaces"} super Cartesian spaces
          %p
            We do not need to consider here
            %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
            more general than the
            %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+spaces"} super Cartesian spaces
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#SuperCartesianSpace"}
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            according to def./prop.
            = succeed ":" do
              %a.maruku-ref{:href => "#SmoothManifoldInsideDiffeologicalSpaces"}
          #SuperSmoothManifolds.num_defn
            %h6#definitionproposition_2 Definition/Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/supermanifolds"}> supermanifolds
                )
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              super-dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℕ
                    %mo ×
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} (b,s) \in \mathbb{N} \times \mathbb{N}
              is
            %ul
              %li
                a
                %a.existingWikiWord{:href => "/nlab/show/super+smooth+set"} super smooth set
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
