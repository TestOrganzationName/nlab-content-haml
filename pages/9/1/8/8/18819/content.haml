                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi Φ
                              %mi u
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U \times \Sigma &amp;\overset{\Phi_{(-)}(-)}{\longrightarrow}&amp; E
                    \\\
                    (u,x) &amp;\mapsto&amp; \Phi_u(x)
                    }
            %p
              such that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} u \in U
              we have
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∘
                      %msub
                        %mi Φ
                        %mi u
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi id
                        %mi Σ
                    %annotation{:encoding => "application/x-tex"} p \circ \Phi_{u}(-) = id_\Sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
