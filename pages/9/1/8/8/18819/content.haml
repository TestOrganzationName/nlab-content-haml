          %p
            (
            %a{:href => "synthetic+differential+supergeometry#Yetter88"}> Yetter 88
            )
          %p
            Basing
            %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            on
            %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+sets"} super formal smooth sets
            is an instance of the general approach to
            %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            called
            %em
              %a.existingWikiWord{:href => "/nlab/show/functorial+geometry"} functorial geometry
            or
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supergeometry"} geometry of physics – supergeometry
          %p
            In direct generalization of example
            %a.maruku-ref{:href => "#SmoothManifoldsAreDiffeologicalSpaces"}
            we have:
          #SuperSmoothSetSuperCartesianSpaces.num_example
            %h6#example_23 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+spaces"} super Cartesian spaces
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+sets"} super smooth sets
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperCartesianSpace"}
              %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth set
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo ∈
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ×
                    %mi 𝔻
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi \in X(\mathbb{R}^n \times \mathbb{D})
              to the algebra homomorphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ×
                      %mi 𝔻
                      %mo{:stretchy => "false"} )
                      %mo ←
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi b
                          %mo{:stretchy => "false"} |
                          %mi s
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^n \times \mathbb{D}) \leftarrow C^\infty(\mathbb{R}^{b\vert s})
            %p
              Under this identification, morphisms between
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+spaces"} super Cartesian spaces
              are in
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              with their morphisms regarded as
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth sets
            %p
              Stated more
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+theory"} abstractly
              %em
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              over a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/subcanonical+site"} subcanonical site
          %p
            Similarly, in direct generalization of prop.
            %a.maruku-ref{:href => "#CartSpYpnedaLemma"}
            we have:
          #SuperCartSpYpnedaLemma.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (plots of a
                %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth set
                really are the
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                into the smooth smooth set)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth set
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
