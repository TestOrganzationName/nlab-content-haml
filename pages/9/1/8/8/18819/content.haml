                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              which is the
              %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensored
              with the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ≔
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                    %mo ⊗
                    %mi 𝔤
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E \coloneqq T^\ast \Sigma \otimes \mathfrak{g}
                    \\,.
            %p
              This is the
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi a
                      %mi μ
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ( a_\mu^\alpha )
                    \\,.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of this bundle is a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra-valued+differential+1-form"} Lie algebra-valued differential 1-form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                    %mo ⊗
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A \in \Gamma_\Sigma(T^\ast \Sigma \otimes \mathfrak{g}) = \Omega^1(\Sigma, \mathfrak{g})
                    \\,.
            %p with components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi a
                      %mi μ
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi A
                      %mi μ
                      %mi α
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A^\ast(a_\mu^\alpha) = A^\alpha_\mu
                    \\,.
            %p
              This is called a
              %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
              for
              %em
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills
                %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
              (at least if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
              %a.maruku-ref{:href => "#YangMillsLagrangian"}
              below).
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo =
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} = \mathbb{R}
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/line+Lie+algebra"} line Lie algebra
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#Electromagnetism"}
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo =
                    %mi 𝔰𝔲
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} = \mathfrak{su}(3)
              this is a
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
              history for the
              %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
              of the
              %a.existingWikiWord{:href => "/nlab/show/strong+nuclear+force"} strong nuclear force
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quantum+chromodynamics"} quantum chromodynamics
          %p
            For readers familiar with the concepts of
            %em
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            and
            %em
              %a.existingWikiWord{:href => "/nlab/show/connections+on+a+bundle"} connections on a bundle
            we include the following example
            %a.maruku-ref{:href => "#YangMillsFieldInInstantonSector"}
            which generalizes the
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+field"} Yang-Mills field
            over
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            from example
            %a.maruku-ref{:href => "#YangMillsFieldOverMinkowski"}
            to the situation over general
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spacetimes"} spacetimes
          #YangMillsFieldInInstantonSector.num_example
            %h6#example_5 Example
            %p
              %strong
                (general
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+field"} Yang-Mills field
                in fixed
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/instanton"} topological sector
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              be any
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              with
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              denoted
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mover
                      %mo →
                      %mi is
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} P \overset{is}{\to} \Sigma
              be a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \nabla_0
              a chosen
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
              on it, to be called the
              %a.existingWikiWord{:href => "/nlab/show/background+field"} background
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills
              field.
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
              %em
                in the
                %a.existingWikiWord{:href => "/nlab/show/instanton"} topological sector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product of vector bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ≔
                    %mrow
                      %mo (
                      %mi P
                      %msubsup
                        %mo ×
                        %mi G
                        %mi ad
                      %mi 𝔤
                      %mo )
                    %msub
                      %mo ⊗
                      %mi Σ
                    %mrow
                      %mo (
                      %msup
                        %mi T
                        %mo *
                      %mi Σ
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    E \coloneqq \left(P \times^{ad}_G \mathfrak{g}\right) \otimes_\Sigma \left( T^\ast \Sigma \right)
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+bundle"} adjoint bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              and the
              %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            %p
              With the choice of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∇
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \nabla_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              uniquely decomposes as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo =
                    %msub
                      %mo ∇
                      %mn 0
                    %mo +
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\nabla = \nabla_0 + A
                    \\,,
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A \in \Gamma_\Sigma(E)
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of the above
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+field"} Yang-Mills
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#Electromagnetism"}
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+field"} Yang-Mills field
            (def.
            = succeed "," do
              %a.maruku-ref{:href => "#YangMillsFieldOverMinkowski"}
            = succeed ")" do
              %a.maruku-ref{:href => "#YangMillsFieldInInstantonSector"}
            %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
            as
            %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
            are the basic examples of
            %em
              %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
            (we consider this in more detail below in
            = succeed ")." do
              %em
                %a{:href => "#GaugeSymmetries"} Gauge symmetries
            %em
              %a.existingWikiWord{:href => "/nlab/show/higher+gauge+fields"} higher gauge fields
            with
            %a.existingWikiWord{:href => "/nlab/show/differential+n-forms"} differential n-forms
            as
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
          #BField.num_example
            %h6#example_6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            %p
              On
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product of vector bundles
              of the
              %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              with itself
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ≔
                    %msubsup
                      %mo ∧
                      %mi Σ
                      %mn 2
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E \coloneqq \wedge^2_\Sigma T^\ast \Sigma
                    \\,.
            %p
              This is a
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
              coordinates
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mrow
                        %mi μ
                        %mi ν
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (b_{\mu \nu})
              subject to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mrow
                        %mi μ
                        %mi ν
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %msub
                      %mi b
                      %mrow
                        %mi ν
                        %mi μ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    b_{\mu \nu} \;=\; - b_{\nu \mu}
                    \\,.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of this bundle, hence a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
              %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentialnForms"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mo ∧
                      %mi Σ
                      %mn 2
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi Ω
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    B \in \Gamma_\Sigma(\wedge^2_\Sigma T^\ast \Sigma) = \Omega^2(\Sigma)
            %p
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#NonFiniteDimensionalGeometry
            %strong
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
          %p
            Given any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
            as a “
            %a.existingWikiWord{:href => "/nlab/show/smooth+set"}> smooth set
            ” itself, a smooth
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            apply (such as for the discussion of
            %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            and
            %a.existingWikiWord{:href => "/nlab/show/states"} states
            %a{:href => "#Observables"} below
            ). Notably we need to be talking about
            %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
          %p
            However, a
            %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
            does not in general carry the structure of a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %a.existingWikiWord{:href => "/nlab/show/infinite+dimensional+manifold"} infinite dimensional manifold
            only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is a
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact space
            (see at
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/manifold+structure+of+mapping+spaces"} manifold structure of mapping spaces
            %a.existingWikiWord{:href => "/nlab/show/infinite+dimensional+manifold"} infinite dimensional manifold
            structure, inspection shows that this is more
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            than actually needed for the discussion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
            %em smooth family
            of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            = succeed "," do
