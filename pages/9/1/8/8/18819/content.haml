                  %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
              of
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DiffeologicalSpace"}
            #eq:SpaceOfFieldHistories.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi DiffeologicalSpaces
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_\Sigma(E) \in DiffeologicalSpaces
            %p
              by declaring that a smooth family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi_{(-)}
              of field histories, parameterized over any
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is a smooth function out of the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              manifold of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                            %mo ×
                            %mi Σ
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi Φ
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
