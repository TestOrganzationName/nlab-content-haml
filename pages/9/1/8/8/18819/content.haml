                        \&amp; \swarrow &amp;&amp; \searrow
                        \\\
                        U_i &amp;&amp; &amp;&amp; U_j
                        \\\
                        \&amp; {}_{\mathrlap{\Phi_i}}\searrow &amp;&amp; \swarrow_{\mathrlap{\Phi_j}}
                        \\\
