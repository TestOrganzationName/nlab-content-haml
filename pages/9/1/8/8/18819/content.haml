                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X
                    \\\
                    \&amp; {}^{\mathllap{\tilde v}}\nearrow &amp; \downarrow^{\mathrlap{id}}
                    \\\
