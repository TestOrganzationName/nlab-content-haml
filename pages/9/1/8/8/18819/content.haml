                        \\,.
            %p
              (Stated more
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+theory"} abstractly
              %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
              are the
              %a.existingWikiWord{:href => "/nlab/show/concrete+sheaves"} concrete sheaves
              on the
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              of
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              from def.
              = succeed ".)" do
                %a.maruku-ref{:href => "#DifferentiablyGoodOpenCover"}
          %p
            For more background on
            %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
            see also
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+smooth+sets"} geometry of physics – smooth sets
          #SmoothManifoldsAreDiffeologicalSpaces.num_example
            %h6#example_7 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
              %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DiffeologicalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo ∈
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi \in X(\mathbb{R}^n)
              to the ordinary
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi ℝ
                        %mi n
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Phi \colon \mathbb{R}^n \to X
            %p
              Under this identification, a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi s
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi s
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; (X_1)_s \to (X_2)_s
              between the underlying sets of two
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              in the ordinary sense precisely if it is a smooth function in the sense of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
            %p
              Stated more
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+theory"} abstractly
              %em
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              over a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/subcanonical+site"} subcanonical site
            %p
              More generally, the same construction makes every
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
          #DiffeologicalSpaceOfFieldHistories.num_example
            %h6#example_8 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological
                = succeed ")" do
