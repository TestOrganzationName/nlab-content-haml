            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/possible+worlds"} possible
                field histories)
            %p
              After we give the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
