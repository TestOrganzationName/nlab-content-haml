                  of morphisms of
                  %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+sets"} super smooth sets
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
                  %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+spaces"} super Cartesian spaces
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mi b
                            %mo{:stretchy => "false"} |
                            %mi s
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{b\vert s}
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SuperCartesianSpace"}
                  %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth sets
                  via example
                  %a.maruku-ref{:href => "#SuperSmoothSetSuperCartesianSpaces"}
                  into
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                %ol
                  %li
                    %p
                      for every plot
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi ℝ
                              %mi n
                            %mo ×
                            %mi 𝔻
                            %mo →
                            %mi X
                          %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \times \mathbb{D} \to X
                      there is a
