              any
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperCartesianSpace"}
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi SmoothSet
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{SmoothSet}(\mathbb{R}^n , X) \overset{\simeq}{\longrightarrow} X(\mathbb{R}^n)
            %p
              from the set of homomorphisms of super smooth sets from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ×
                    %mi 𝔻
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \times \mathbb{D}
              (regarded as a super smooth set via example
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperSmoothSetSuperCartesianSpaces"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ×
                      %mi 𝔻
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \times \mathbb{D}
