                  %a.existingWikiWord{:href => "/nlab/show/formal+smooth+sets"} formal smooth sets
                  via example
                  = succeed "," do
                    %a.maruku-ref{:href => "#SmoothManifoldsAreDiffeologicalSpaces"}
                  %a.maruku-ref{:href => "#SmoothSetsDiffeologicalSpaces"}
                  and example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#FormalSmoothSetsIncludedSmoothSet"}
                  = succeed "," do
