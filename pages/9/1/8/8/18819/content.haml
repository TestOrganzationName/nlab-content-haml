                    %annotation{:encoding => "application/x-tex"} id_{\mathbb{R}^n \times \mathbb{D}}
            %p
              This function is a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            %p
              This says that the plots of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              into being as declaring the
              %em would-be
              smooth functions into
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
