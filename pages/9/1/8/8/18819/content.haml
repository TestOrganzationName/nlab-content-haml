                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/bosonic+modality"} bosonic
                  part of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  according to def./prop.
                  = succeed "." do
                    %a.maruku-ref{:href => "#SmoothManifoldInsideDiffeologicalSpaces"}
          %p
            Finally we have the evident generalization of the smooth moduli space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mo •
                %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^\bullet
            of
            %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            from example
            %a.maruku-ref{:href => "#UniversalSmoothModuliSpaceOfDifferentialForms"}
            to
            %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
          #ModuliOfSDifferentialForms.num_example
            %h6#example_24 Example
            %p
              %strong
                (universal
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth
                %a.existingWikiWord{:href => "/nlab/show/moduli+spaces"} moduli spaces
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi M
                  %annotation{:encoding => "application/x-tex"} n \in \mathbf{M}
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi SuperSmoothSet
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\Omega}^n \;\in\; SuperSmoothSet
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/super+smooth+set"} super smooth set
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperSmoothSetSuperCartesianSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi SuperCartSp
                  %annotation{:encoding => "application/x-tex"} U \in SuperCartSp
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperCartesianSpace"}
              %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentialFormOnSuperCartesianSpaces"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\Omega}^n(U) \;\coloneqq\; \Omega^n(U)
            %p
              and whose maps of plots is given by
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
              of super differential forms.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              on
              %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
              applied plot-wise yields a morpism of super smooth sets
            #eq:SuperUniversalDeRhamDifferential.maruku-equation
              %span.maruku-eq-number (10)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi n
                    %mo ⟶
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d \;\colon\; \mathbf{\Omega}^n \longrightarrow \mathbf{\Omega}^{n+1}
                    \\,.
            %p
              As before in def.
              %a.maruku-ref{:href => "#DifferentialFormsOnDiffeologicalSpaces"}
              we then define for any
              %a.existingWikiWord{:href => "/nlab/show/super+smooth+set"} super smooth set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SuperSmoothSet
                  %annotation{:encoding => "application/x-tex"} X \in SuperSmoothSet
              its set of differential
              = succeed "-forms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi SuperSmoothSet
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^n(X)
                    \\;\coloneqq\;
                    Hom_{SuperSmoothSet}(X,\mathbf{\Omega}^n)
            %p
              and we define the
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              on these to be given by postcomposition with
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:SuperUniversalDeRhamDifferential"} (10)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #FermionicBosonicFields.num_defn
            %h6#definition_15 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/bosonic+fields"} bosonic fields
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/fermionic+fields"} fermionic fields
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo ⟶
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\longrightarrow} \Sigma
              with total space a
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperCartesianSpace"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperSmoothManifolds"}
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
            %ul
              %li
                %p
                  the even-graded
                  %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                  are called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/bosonic+field"} bosonic
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              %li
                %p
                  the odd-graded
                  %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                  are called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/fermionic+field"} fermionic
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
            %p
              In components, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi Σ
                    %mo ×
                    %mi F
                  %annotation{:encoding => "application/x-tex"} E = \Sigma \times F
              is a
              %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"} trivial bundle
              with
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              a
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperCartesianSpace"}
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϕ
                      %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi^a)
              and odd-graded
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ψ
                        %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\psi^A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \phi^a
              are called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/bosonic+field"} bosonic
              field coordinates, and the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ψ
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \psi^A
              are called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/fermionic+field"} fermionic
              field coordinates.
          %p
            What is crucial for the discussion of
            %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
            is the following immediate
            %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometric
            analog of the smooth structure on the
            %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            from example
            = succeed ":" do
              %a.maruku-ref{:href => "#DiffeologicalSpaceOfFieldHistories"}
          #SupergeometricSpaceOfFieldHistories.num_example
            %h6#example_25 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/super+smooth+set"} supergeometric
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a super-
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              = succeed ")." do
                %a.maruku-ref{:href => "#FermionicBosonicFields"}
            %p
              Then the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super formal smooth set
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi SuperSmoothSet
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_\Sigma(E) \in SuperSmoothSet
            %p
              whose plots
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi_{(-)}
              for a given
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              and
              %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔻
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperCartesianSpace"}
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ≔
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ×
                    %mi 𝔻
                  %annotation{:encoding => "application/x-tex"} U \coloneqq \mathbb{R}^n \times \mathbb{D}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} U \times \Sigma
              regarded as
              %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth sets
              according to example
              %a.maruku-ref{:href => "#SuperSmoothSetSuperCartesianSpaces"}
              are defined to be the
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              of
              %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth set
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                            %mo ×
                            %mi Σ
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi Φ
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U \times \Sigma &amp;\overset{\Phi_{(-)}(-)}{\longrightarrow}&amp; E
                    }
            %p
              which make the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi Φ
                                    %mrow
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi fb
                        %mtr
                          %mtd
                            %mi U
                            %mo ×
                            %mi Σ
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi pr
                                  %mn 2
                          %mtd
                            %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; E
                    \\\
                    \&amp; {}^{\mathllap{\Phi_{(-)}(-)}}\nearrow &amp; \downarrow^{\mathrlap{fb}}
                    \\\
                    U \times \Sigma &amp;\underset{pr_2}{\longrightarrow}&amp; \Sigma
                    }
                    \\,.
            %p
              Explicitly, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is a
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi Σ
                    %mo ×
                    %mi F
                  %annotation{:encoding => "application/x-tex"} E = \Sigma \times F
              a
              %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"} trivial
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              with
              %a.existingWikiWord{:href => "/nlab/show/field+fiber"} field fiber
              a
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              = succeed ")" do
                %a.maruku-ref{:href => "#FermionicBosonicFields"}
              %a.existingWikiWord{:href => "/nlab/show/formal+duality"} dually
              that a plot
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi_{(-)}
              of the super smooth set of field histories is a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebras"} supercommutative superalgebras
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SupercommutativeSuperalgebra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ×
                            %mi Σ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟵
                              %mrow
                                %msup
                                  %mrow
                                    %mo (
                                    %msub
                                      %mi Φ
                                      %mrow
                                        %mo{:stretchy => "false"} (
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %mo{:stretchy => "false"} )
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                                    %mo )
                                  %mo *
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
