          %h2#references References
          %p
            In the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+J.+Simms"}> David J. Simms
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Nicholas+Woodhouse"} Nicholas Woodhouse
                = succeed "," do
                  %em Observables
                = succeed "," do
                  %em Lectures on Geometric Quantization
                = succeed "," do
                  %strong 53
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/3-540-07860-6_4"} doi:10.1007/3-540-07860-6_4
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexandre+Kirillov"}> Alexandre Kirillov
                , §1.1 in:
                = succeed "," do
                  %em Geometric quantization
                = succeed "," do
                  %em Dynamical systems IV
                = succeed "," do
                  %strong 4
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-662-06793-2_2"} doi:10.1007/978-3-662-06793-2_2
          %p
            In the
            %a.existingWikiWord{:href => "/nlab/show/AQFT"} algebraic
            formulation of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nikolay+Bogolyubov"}> Nikolay Bogolyubov
                , A. A. Logunov, A. I. Oksak, I. T. Todorov, G. G. Gould:
                %em Algebra of Observables and State Space
                \&amp;lbrack;
                %a{:href => "https://doi.org/10.1007/978-94-009-0491-0_6"}> doi:10.1007/978-94-009-0491-0_6
                \&amp;rbrack;, Chapter in:
                = succeed "," do
                  %em General principles of quantum field theory
                = succeed "," do
                  %strong 10
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-94-009-0491-0"} doi:10.1007/978-94-009-0491-0
            %li#Gleason09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Gleason"}> Jonathan Gleason
                ,
                %em
                  The
                  = succeed "-algebraic" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^*
                (2009) &amp;lbrack;
                %a.existingWikiWord{:href => "/nlab/files/Gleason09.pdf", :title => "pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/GleasonAlgebraic.pdf", :title => "pdf"} pdf
            %li#Gleason11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Gleason"}> Jonathan Gleason
                ,
                = succeed "," do
                  %em
                    From Classical to Quantum: The
                    = succeed "-Algebraic" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi F
                              %mo *
                          %annotation{:encoding => "application/x-tex"} F^\ast
                = succeed "," do
                  %em
                    %a{:href => "http://www.math.uchicago.edu/~may/VIGRE/VIGREREU2011.html"} VIGRE REU 2011
                = succeed "," do
                  %a{:href => "https://www.math.uchicago.edu/~may/VIGRE/VIGRE2011/REUPapers/Gleason.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/GleasonFAlgebraic.pdf", :title => "pdf"} pdf
          %p
            Careful discussion of local gauge invariant observables in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/general+relativity"} general relativity
          %ul
            %li#Khavkine14
              %a.existingWikiWord{:href => "/nlab/show/Igor+Khavkine"}> Igor Khavkine
              \:
              = succeed "," do
                %em Local and gauge invariant observables in gravity
              %strong 32
              185019, (2015) &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1503.03754"}> arXiv:1503.03754
              ,
              = succeed "," do
                %a{:href => "http://cqgplus.com/2015/09/16/local-and-gauge-invariant-observables-in-gravity/"} CQG+
              %a{:href => "http://www.science.unitn.it/~moretti/convegno/khavkine.pdf"} pdf slides
              for talk at
              %em
                %a{:href => "http://www.science.unitn.it/~moretti/convegno/convegno.html"} Operator and Geometric Analysis on Quantum Theory
              Levico Terme, Italy, September 2014)&amp;rbrack;
          %p
            showing that, while there are no globally defined local gauge invariant observables, they do exist on an
            %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            of the space of field configuration and form something like a
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            of observables (but, hence, one without
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/global+sections"} global sections
          %p
            Careful discussion of observables in abelian
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            (
            %a.existingWikiWord{:href => "/nlab/show/electromagnetism"}> electromagnetism
            ) is in
          %ul
            %li#BeniniSchenkelSzabo15
              %a.existingWikiWord{:href => "/nlab/show/Marco+Benini"}> Marco Benini
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Schenkel"} Alexander Schenkel
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Richard+Szabo"} Richard Szabo
              %em Homotopy colimits and global observables in Abelian gauge theory
              (
              %a{:href => "http://arxiv.org/abs/1503.08839"}> arXiv:1503.08839
              )
