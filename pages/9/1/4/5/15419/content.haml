                                %mo =
                                %mn 2
                              %annotation{:encoding => "application/x-tex"} dim = 2
                          \:
                          %a.existingWikiWord{:href => "/nlab/show/K3+surface"} K3 surface
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/generalized+Calabi-Yau+manifold"} generalized Calabi-Yau manifold
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#Formalizations"} Formalizations
              %li
                %a{:href => "#Overview"} Overview
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            There is a noticeable
            %a.existingWikiWord{:href => "/nlab/show/analogy"} analogy
            between phenomena (
            %a.existingWikiWord{:href => "/nlab/show/theorems"}> theorems
            ) in the theory of
            %a.existingWikiWord{:href => "/nlab/show/number+fields"} number fields
            and those in the theory of
            %a.existingWikiWord{:href => "/nlab/show/function+fields"} function fields
            over
            %a.existingWikiWord{:href => "/nlab/show/finite+fields"} finite fields
            (
            %a{:href => "#Weil39"}> Weil 39
            ,
            = succeed "," do
              %a{:href => "#Iwasaw69"} Iwasawa 69
            = succeed ")," do
              %a{:href => "#MazurWiles83"} Mazur-Wiles 83
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/global+fields"} global fields
            %a.existingWikiWord{:href => "/nlab/show/number+theory"} number theory
            dually as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+analytic+geometry"} complex analytic geometry
            %a.existingWikiWord{:href => "/nlab/show/complex+curves"} complex curves
            (e.g.
            = succeed ")." do
              %a{:href => "#Frenkel05"} Frenkel 05
          %p
            At a very basic level the analogy may be plausible from the fact that both the
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            as well as the
            %a.existingWikiWord{:href => "/nlab/show/polynomial+rings"} polynomial rings
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_q[x]
            (over
            %a.existingWikiWord{:href => "/nlab/show/finite+fields"} finite fields
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi q
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_q
            %a.existingWikiWord{:href => "/nlab/show/principal+ideal+domains"} principal ideal domains
            with
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
            %a.existingWikiWord{:href => "/nlab/show/quotients"} quotients
            being finite rings and with infinitely many
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/prime+ideals"} prime ideals
            %a.existingWikiWord{:href => "/nlab/show/arithmetic"} arithmetic
            over these rings is similar. Since
            %a.existingWikiWord{:href => "/nlab/show/number+fields"} number fields
            are the
            %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
            %a.existingWikiWord{:href => "/nlab/show/field+extensions"} field extensions
            of the
            %a.existingWikiWord{:href => "/nlab/show/field+of+fractions"} field of fractions
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            %a.existingWikiWord{:href => "/nlab/show/function+fields"} function fields
            are just the finite-dimensional field extensions of the fields of fractions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_q(x)
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi q
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_q[x]
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/entire+function"} entire
            %a.existingWikiWord{:href => "/nlab/show/holomorphic+functions"} holomorphic functions
            on the
            %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
            are, while not quite an principal ideal domain, still a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/B%C3%A9zout+domain"} Bézout domain
            %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            the
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            and the
            %a.existingWikiWord{:href => "/nlab/show/polynomial+rings"} polynomial rings
            over
            %a.existingWikiWord{:href => "/nlab/show/finite+fields"} finite fields
            are only Bézout domains as well.
          %p
            But the analogy ranges much deeper than this similarity alone might suggest. For instance (
            %a{:href => "#Weil39"}> Weil 39
            ) defined an invariant of a
            %a.existingWikiWord{:href => "/nlab/show/number+field"} number field
            – the
            = succeed "\u2013" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/genus+of+a+number+field"} genus of a number field
            %a.existingWikiWord{:href => "/nlab/show/genus+of+a+curve"} genus
            of the
            %a.existingWikiWord{:href => "/nlab/show/algebraic+curve"} algebraic curve
            on which a given
            %a.existingWikiWord{:href => "/nlab/show/function+field"} function field
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+functions"} rational functions
            %a.existingWikiWord{:href => "/nlab/show/Riemann-Roch+theorem"} Riemann-Roch theorem
            for
            %a.existingWikiWord{:href => "/nlab/show/algebraic+curves"} algebraic curves
            extend to
            %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
            (
            %a{:href => "#Neukirch92"}> Neukirch 92, chapter II, prop.(3.6)
            ).
          %p
            Another notable part of the analogy is the fact that there are natural analogs of the
            %a.existingWikiWord{:href => "/nlab/show/Riemann+zeta+function"} Riemann zeta function
            in all three columns of the analogy. This aspect has found attention notably through the lens of regarding
            %a.existingWikiWord{:href => "/nlab/show/number+fields"} number fields
            as
            %a.existingWikiWord{:href => "/nlab/show/rational+functions"} rational functions
            on “
            %a.existingWikiWord{:href => "/nlab/show/arithmetic+curves"} arithmetic curves
            over the would-be
            %a.existingWikiWord{:href => "/nlab/show/field+with+one+element"} field with one element
            = succeed "\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
          %p
            The analogy between
            %a.existingWikiWord{:href => "/nlab/show/p-adic+numbers"} p-adic numbers
            and
            %a.existingWikiWord{:href => "/nlab/show/Laurent+series"} Laurent series
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_p
            is strengthened by (
            %a{:href => "#FontaineWinterberger79"}> Fontaine-Winterberger 79
            ), which shows that the absolute
            %a.existingWikiWord{:href => "/nlab/show/Galois+groups"} Galois groups
            of the
            %a.existingWikiWord{:href => "/nlab/show/perfect+field"} perfection
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_p((t))
            and of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℚ
                    %mi p
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi p
                    %mfrac
                      %mn 1
                      %mrow
                        %msup
                          %mi p
                          %mn ∞
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}_p[p^{\frac{1}{p^\infty}}]
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            = succeed ")." do
              %a{:href => "#Hartl06"} Hartl 06
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/perfectoid+spaces"} perfectoid spaces
          %p
            It is also the function field analogy which induces the conjecture of the
            %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
            by analogy from the number-theoretic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Langlands+correspondence"} Langlands correspondence
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+bundles"} moduli stack of bundles
            over a
            %a.existingWikiWord{:href => "/nlab/show/complex+curve"} complex curve
            is analogous in absolute
            %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
            to the
            %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
            of the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            with coefficients in the
            %a.existingWikiWord{:href => "/nlab/show/ring+of+adeles"} ring of adeles
            of a number field, on which
            %a.existingWikiWord{:href => "/nlab/show/unramified"} unramified
            %a.existingWikiWord{:href => "/nlab/show/automorphic+representations"} automorphic representations
            are functions. Under this analogy the
            %a.existingWikiWord{:href => "/nlab/show/Weil+conjecture+on+Tamagawa+numbers"} Weil conjecture on Tamagawa numbers
            may be regarded as giving the
            %a.existingWikiWord{:href => "/nlab/show/groupoid+cardinality"} groupoid cardinality
            of the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+bundles"} moduli stack of bundles
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
          %p
            In summary then the analogy says that the theories of
            %a.existingWikiWord{:href => "/nlab/show/number+fields"} number fields
            and of
            %a.existingWikiWord{:href => "/nlab/show/function+fields"} function fields
            both look much like a
            = succeed "-version" do
              %a.existingWikiWord{:href => "/nlab/show/global+analytic+geometry"} global analytic geometry
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+curves"} complex curves
          %h2#Formalizations Formalizations
          %p
            To date the function field analogy remains just that, an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/analogy"} analogy
            = succeed ")." do
              %a{:href => "#vdGeer05"} v.d. Geer et al 05
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Arakelov+geometry"}> Arakelov geometry
                ;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/global+analytic+geometry"}> global analytic geometry
                \.
            %li
              %p
                geometry “over
                = succeed "\u201D." do
                  %a.existingWikiWord{:href => "/nlab/show/F1"} F1
          %p
            Regarding the last point, in particular
            %a.existingWikiWord{:href => "/nlab/show/Borger%27s+absolute+geometry"} Borger's absolute geometry
            (
            %a{:href => "#Borger09"}> Borger 09
            ) makes precise the analogy between
            %a.existingWikiWord{:href => "/nlab/show/Spec%28Z%29"} Spec(Z)
            and the
            %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
            = succeed "/" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi z
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[z]
            = succeed "-ring" do
              %a.existingWikiWord{:href => "/nlab/show/entire+holomorphic+function"} entire holomorphic function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_{\mathbb{C}}
            by interpreting the analog of the canonical
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %mi z
                %annotation{:encoding => "application/x-tex"} \frac{\partial}{\partial z}
            on the latter two as the
            %a.existingWikiWord{:href => "/nlab/show/Fermat+quotient"} Fermat quotient
            operation, and more generally by interpreting the lift of this to arithmetic spaces over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {Spec}(\mathbb{Z})
            as lifts of
            %a.existingWikiWord{:href => "/nlab/show/Frobenius+homomorphisms"} Frobenius homomorphisms
            as given by
            %a.existingWikiWord{:href => "/nlab/show/Lambda-ring"} Lambda-ring
            structures. See at
            %em
              %a{:href => "Borger%27s+absolute+geometry#Motivation"} Borger’s absolute geometry – Motivation
            for more on this.
          %p
            In this context the analogy between geometry over
            %a.existingWikiWord{:href => "/nlab/show/number+fields"} number fields
            and over
            %a.existingWikiWord{:href => "/nlab/show/function+fields"} function fields
            is made precise by showing (
            %a{:href => "#Borger09"}> Borger 09, section 7
            ) that for any smooth connected curve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi 𝔽
                    %mi q
                %annotation{:encoding => "application/x-tex"} S/\mathbb{F}_q
            over a
            %a.existingWikiWord{:href => "/nlab/show/finite+field"} finite field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi q
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_q
            the standard
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            of (“big”)
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Spec(S/\mathbb{F}_q)\longrightarrow Spec(\mathbb{F}_q)
          %p
            factors through an alternative base topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Spec
                    %mo ˜
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \widetilde Spec(\mathbb{F}_q)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mover
                    %mi Spec
                    %mo ˜
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Spec(S/\mathbb{F}_q)\longrightarrow \widetilde Spec(\mathbb{F}_q) \longrightarrow Spec(\mathbb{F}_q)
          %p
            which, while different from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spec(\mathbb{F}_q)
            is “close” to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spec(\mathbb{F}_q)
            in some precise sense, but which has the advantage that its construction does exist for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} q = 1
            in that there is directly analogous
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mover
                    %mi Spec
                    %mo ˜
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Spec(\mathbb{Z}) \longrightarrow \widetilde Spec(\mathbb{F}_1)
                  \\,,
          %p
            where the notation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Spec
                    %mo ˜
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \widetilde Spec(\mathbb{F}_1)
            here stands for Borger’s the topos over
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lambda-rings"} Lambda-rings
            %em
              %a.existingWikiWord{:href => "/nlab/show/Borger%27s+absolute+geometry"} Borger's absolute geometry
            for the actual details.
          %h2#Overview Overview
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/function+field+analogy"} function field analogy
            %table
              %thead
                %tr
                  %th
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/number+fields"} number fields
                    (“
                    %a.existingWikiWord{:href => "/nlab/show/function+fields"} function fields
                    of
                    %a.existingWikiWord{:href => "/nlab/show/curves"} curves
                    over
                    = succeed "\u201D)" do
                      %a.existingWikiWord{:href => "/nlab/show/F1"} F1
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/function+fields"} function fields
                    of
                    %a.existingWikiWord{:href => "/nlab/show/curves"} curves
                    over
                    %a.existingWikiWord{:href => "/nlab/show/finite+fields"} finite fields
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝔽
                            %mi q
                        %annotation{:encoding => "application/x-tex"} \mathbb{F}_q
                    (
                    %a.existingWikiWord{:href => "/nlab/show/arithmetic+curves"}> arithmetic curves
                    )
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/Riemann+surfaces"}> Riemann surfaces
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/complex+curves"} complex curves
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/affine+line"} affine
                      and
