              %a.existingWikiWord{:href => "/nlab/show/holomorphic+function"} holomorphic function
              on the
              %a.existingWikiWord{:href => "/nlab/show/upper+half-plane"} upper half-plane
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                    %mo ↪
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    f : (\mathbb{R}^2)_+ \hookrightarrow \mathbb{C}
            %p (complex numbers with strictly positive imaginary part)
            %p such that
            %ol
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo =
                        %mrow
                          %mo (
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi a
                                %mtd
                                  %mi b
                              %mtr
                                %mtd
                                  %mi c
                                %mtd
                                  %mi d
                          %mo )
                        %mo ∈
                        %msub
                          %mi SL
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A = \left( \array{a &amp; b \\ c&amp; d}\right) \in SL_2(\mathbb{Z})
                  acting by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo :
                        %mi τ
                        %mo ↦
                        %mo =
                        %mfrac
                          %mrow
                            %mi a
                            %mi τ
                            %mo +
                            %mi b
                          %mrow
                            %mi c
                            %mi τ
                            %mo +
                            %mi d
                      %annotation{:encoding => "application/x-tex"} A : \tau \mapsto = \frac{a \tau + b }{c \tau + d}
                  we have
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi τ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mi τ
                        %mo +
                        %mi d
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi w
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        f(A(\tau)) = (c \tau + d)^w f(\tau)
                %p
                  (notice that for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo =
                        %mrow
                          %mo (
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mn 1
                                %mtd
                                  %mn 1
                              %mtr
                                %mtd
                                  %mn 0
                                %mtd
                                  %mn 1
                          %mo )
                      %annotation{:encoding => "application/x-tex"} A = \left( \array{1 &amp; 1 \\ 0&amp; 1}\right)
                  then
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi τ
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi τ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} f(\tau + 1) = f(\tau)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  has at worst a pole at
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{0\}
                  (for
                  %em weak
                  modular forms this condition is relaxed)
                %p
                  it follows that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo =
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f = f(q)
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi q
                        %mo =
                        %msup
                          %mi e
                          %mrow
                            %mn 2
                            %mi π
                            %mi i
                            %mi τ
                      %annotation{:encoding => "application/x-tex"} q = e^{2 \pi i \tau}
                  is a meromorphic funtion on the open disk.
              %li
                %p
                  %strong integrality
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ˜
                        %mo{:stretchy => "false"} (
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msubsup
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi k
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi N
                          %mn ∞
                        %msub
                          %mi a
                          %mi k
                        %mo ⋅
                        %msup
                          %mi q
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \tilde f(q) = \sum_{k = -N}^\infty a_k \cdot q^k
                  then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi a
                          %mi k
                        %mo ∈
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} a_k \in \mathbb{Z}
          %p
            More generally there is such a definition for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{Z})
            replaced by any other arithmetic subgroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ⊂
                  %mi SL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma \subset SL(2,\mathbb{R})
            (e.g.
            = succeed ")," do
              %a{:href => "#Litt"} Litt, def.1
            = succeed "." do
              %span.newWikiWord
                modular curves
                %a{:href => "/nlab/new/modular+curves"} ?
          %h3#as_functions_on_lattices As functions on lattices
          %p
            The reference for this definition is
            = succeed "." do
              %a{:href => "#Calegari13"} Calegari13
          %p
            A modular form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            of weight
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            is a function on lattices
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                  %mo =
                  %mi ℤ
                  %mo +
                  %mi τ
                  %mi ℤ
                  %mo ⊂
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \Lambda=\mathbb{Z}+\tau\mathbb{Z}\subset \mathbb{C}
            such that
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo +
                      %mi τ
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(\mathbb{Z}+\tau\mathbb{Z})
                is holomorphic as a function of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi μ
                      %mi Λ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi μ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi k
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi Λ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(\mu \Lambda)=\mu^{-k} f(\Lambda)
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo ∈
                      %msup
                        %mi ℂ
                        %mo ×
                    %annotation{:encoding => "application/x-tex"} \mu\in\mathbb{C}^{\times}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo +
                      %mi τ
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(\mathbb{Z}+\tau\mathbb{Z})
                is bounded as
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi τ
                        %mo →
                        %mi i
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \tau\to i\infty
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo +
                  %mi τ
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"} f(\mathbb{Z}+\tau\mathbb{Z})\to 0
            as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo →
                    %mi i
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \tau\to i\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cusp+form"} cusp form
          %h3#as_functions_on_elliptic_curves_together_with_a_choice_of_differential As functions on elliptic curves together with a choice of differential
          %p
            Again the reference for this definition is
            = succeed "." do
              %a{:href => "#Calegari13"} Calegari13
          %p
            Since
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curves"} elliptic curves
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            can be defined in terms of lattices, the previous definition can also be expressed as follows.
          %p
            A modular form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            of weight
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            is a function on pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E,\omega)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is an elliptic curve and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %msubsup
                      %mi Ω
                      %mi E
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega\in H^{0}(E,\Omega_{E}^{1})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi μ
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi μ
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi k
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(E,\mu\omega)=\mu^{-k}f(E,\omega)
          %p
            and such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                  %mo +
                  %mi τ
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(\mathbb{C}/\mathbb{Z}+\tau\mathbb{Z})
            is bounded as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo →
                    %mi i
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \tau\to i\infty
          %h3#AsSections As sections of a line bundle over the moduli stack
          %p
            More abstractly, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℳ
                    %mi ell
                %annotation{:encoding => "application/x-tex"} \mathcal{M}_{ell}
            the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+elliptic+curves"} moduli stack of elliptic curves
            (or rather its
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Deligne-Mumford+compactification"} Deligne-Mumford compactification
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %msub
                    %mi ℳ
                    %mi ell
                %annotation{:encoding => "application/x-tex"} A \to \mathcal{M}_{ell}
            the corresponding universal bundle, write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} /
                      %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \Omega^1_{A/S}
            for the
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            of fiberwise
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differential+forms"} Kähler differential forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            for the 0-
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of this line bundle. Then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo ≔
                  %msup
                    %mi e
                    %mo *
                  %msubsup
                    %mi Ω
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} /
                      %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\omega \coloneqq e^\ast \Omega^1_{A/S}
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            over the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+elliptic+curves"} moduli stack of elliptic curves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ω
                      %mrow
                        %mo ⊗
                        %mi k
                  %annotation{:encoding => "application/x-tex"} \omega^{\otimes k}
            %a.existingWikiWord{:href => "/nlab/show/cusp+forms"} cusp forms
            of weight
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            are the differentials on the corresponding modular curve.
          %h3#ForCongruenceSubgroups For congruence subgroups
          %p
            Similarly one considers modular forms for
            %a.existingWikiWord{:href => "/nlab/show/congruence+subgroups"} congruence subgroups
            of the full
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/modular+group"} modular group
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/elliptic+curves+with+level+structure"} elliptic curves with level structure
          %h3#AsAutomorphicForms As automorphic forms
          %p
            Instead of regarding, as
            = succeed "," do
              %a{:href => "#AsSections"} above
            %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            of a
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            on a
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/upper+half+plane"} upper half plane
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/M%C3%B6bius+group"} projective
            %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{R})
            = succeed "," do
              %a{:href => "Martin13"} Martin 13, section 2
            = succeed ")." do
              %a{:href => "#Litt"} Litt, section 2
          %p
            As such these functions are then invariant under the
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of the
            %a.existingWikiWord{:href => "/nlab/show/modular+group"} modular
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi SL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{Z})\hookrightarrow SL(2,\mathbb{R})
            and hence are really functions on the
            %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi SL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{R})/SL(2,\mathbb{Z})
            (for forms on moduli of elliptic curves) or more generally
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo \
                  %mi SL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma \backslash SL(2,\mathbb{Z})
            (for forms on more general
            = succeed ")." do
              %span.newWikiWord
                modular curves
                %a{:href => "/nlab/new/modular+curves"} ?
          %p
            This generalizes to the case of other
            %a.existingWikiWord{:href => "/nlab/show/congruence+subgroups"} congruence subgroups
            (as
            = succeed ")." do
              %a{:href => "ForCongruenceSubgroups"} above
            %a.existingWikiWord{:href => "/nlab/show/coset+spaces"} coset spaces
            like this are called
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/automorphic+forms"} automorphic forms
          %p
            For the history of the terminology “modular form”/“automorphic form” see also
            = succeed "." do
              %a{:href => "http://mathoverflow.net/a/124785/381"} this MO comment
          %h2#properties Properties
          %h3#action_by_hecke_operators Action by Hecke operators
          %p
            Modular forms can be acted on by Hecke operators (related to
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Hecke+correspondence"} Hecke correspondence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi n
                %annotation{:encoding => "application/x-tex"} T_{n}
            acts on a modular form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi n
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi Λ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi Λ
                      %mo ′
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi Λ
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T_{n}f(\Lambda)=\sum_{\Lambda'}f(\Lambda')
          %p
            where the sum runs over all lattices
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \Lambda'
            which are index
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            subgroups of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
            %em Hecke eigenform
            or simply
            = succeed "." do
              %em eigenform
          %p
            A modular form which vanishes at the cusps (equivalently, whose zeroth Fourier coefficient is equal to
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %em cuspidal
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cusp+form"} cusp form
            %em normalized
            if its first Fourier coefficient is equal to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi n
                %annotation{:encoding => "application/x-tex"} T_{n}
            is exactly the
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Hecke operators were first developed by
            %a.existingWikiWord{:href => "/nlab/show/Louis+Mordell"} Louis Mordell
            to study the conjectures of
            %a.existingWikiWord{:href => "/nlab/show/Srinivasa+Ramanujan"} Srinivasa Ramanujan
            on the tau function (the Fourier coefficients of the modular discriminant). They were later developed by (and named after)
            %a.existingWikiWord{:href => "/nlab/show/Erich+Hecke"} Erich Hecke
            who used them to study
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-functions"} L-functions
          %h3#analytic_continuation_of_lfunctions Analytic continuation of L-functions
          %p
            Given a cusp form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            of weight
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            with Fourier expansion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %mn ∞
                  %msub
                    %mi a
                    %mi n
                  %msup
                    %mi e
                    %mrow
                      %mn 2
                      %mi π
                      %mi i
                      %mi n
                      %mi z
                %annotation{:encoding => "application/x-tex"} f(z)=\sum_{n=1}^{\infty}a_{n}e^{2\pi i n z}
          %p
            we can associate to it its L-function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L(f,s)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %mn ∞
                  %msub
                    %mi a
                    %mi n
                  %msup
                    %mi n
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi s
                %annotation{:encoding => "application/x-tex"} L(f,s)=\sum_{n=1}^{\infty}a_{n}n^{-s}
          %p
            Alternatively the L-function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L(f,s)
            can be defined via the
            %a.existingWikiWord{:href => "/nlab/show/Mellin+transform"} Mellin transform
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi s
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn ∞
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi iy
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi y
                    %mi s
                  %msup
                    %mi d
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \Lambda(f,s)=(2\pi)^{-s}\Gamma(s)L(f,s)=\int_{0}^{\infty}f(iy)y^{s}d^{\times}
          %p
            The L-function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L(f,s)
            has an analytic continuation to all of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
          %p
            This is important for instance to formulate conjectures such as the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Birch+and+Swinnerton-Dyer+conjecture"} Birch and Swinnerton-Dyer conjecture
            %a.existingWikiWord{:href => "/nlab/show/Hasse-Weil+L-function"} Hasse-Weil L-function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L(E,s)
            of an elliptic curve at a value of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            where it is originally not defined (the series only converges for
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo &gt;
                    %mn 3
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} s \gt 3/2
            %a.existingWikiWord{:href => "/nlab/show/modularity+theorem"} modularity theorem
            tells us that this Hasse-Weil L-function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L(E,s)
            is equal to the L-function of some cusp form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %h3#relation_to_galois_representations Relation to Galois representations
          %p
            Modular forms can be used to construct
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Galois+representations"} Galois representations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            normalized eigenforms this is the Eichler-Shimura construction discussed in
            = succeed "." do
              %a{:href => "#DiamondShurman05"} DiamondShurman05, chapter 9
            = succeed "," do
              %a{:href => "#Deligne71"} Deligne71
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            comes from the work of
            = succeed "." do
              %a{:href => "#DeligneSerre74"} DeligneSerre74
          %p
            The problem of whether a Galois representation comes from some modular form is part of the problem of
            = succeed "." do
              %em modularity
            %a.existingWikiWord{:href => "/nlab/show/modularity+theorem"} modularity theorem
            of
            %a{:href => "#TaylorWiles95"} TaylorWiles95
            and
            = succeed "." do
              %a{:href => "#BreuilConradDiamondTaylor2001"} BreuilConradDiamondTaylor2001
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Wiles%27+proof+of+Fermat%27s+last+theorem"} Wiles' proof of Fermat's last theorem
          %p
            On a more general level, as modular forms are a special case of automorphic forms, their relation to Galois representations is part of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Langlands+program"} Langlands program
          %h3#relation_of__to_the_elliptic_genus
            Relation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi MF
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} MF_0(2)
            to the elliptic genus
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msub
                    %mi SL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma_0(2) \hookrightarrow SL_2(\mathbb{Z})
            for the
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            of the
            %a.existingWikiWord{:href => "/nlab/show/modular+group"} modular group
            on those elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mi c
                          %mtd
                            %mi d
                    %mo )
                %annotation{:encoding => "application/x-tex"} \left(\array{a &amp; b \\ c &amp; d}\right)
            for which
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mi mod
                    %mspace{:width => "thinmathspace"}
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} c = 0\, mod\, 2
          %p
            A modular function for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma_0(2)
            is a
            %a.existingWikiWord{:href => "/nlab/show/meromorphic+function"} meromorphic function
            on the
            %a.existingWikiWord{:href => "/nlab/show/upper+half+plane"} upper half plane
            which transforms as a modular form under the action of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi SL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_0(2) \hookrightarrow SL_2(\mathbb{Z})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi MF
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Γ
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} MF_\bullet(\Gamma_0(2))
            for the ring of these.
          %p There is a natural isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi MF
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Γ
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mi ϵ
                  %mo ,
                  %mi δ
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  MF_\bullet(\Gamma_0(2)) \simeq \mathbb{C}[\epsilon, \delta]
          %p
            (see at
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/elliptic+genus"} elliptic genus
          %p
            (
            %a{:href => "#LandweberRavenelStong93"}> Landweber-Ravenel-Stong 93, theorem 1.5 and sections 5.3, 5.8
            )
          %h3#relation_to_elliptic_cohomology Relation to elliptic cohomology
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            the
            %a.existingWikiWord{:href => "/nlab/show/elliptic+cohomology+theory"} elliptic cohomology theory
            associated to the
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mn 2
                      %mi n
                  %mo ≃
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo ⊗
                      %mi n
                %annotation{:encoding => "application/x-tex"}
                  E_{2n} \simeq \omega(C)^{\otimes n}
          %p
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            is the line bundle from
            = succeed ")" do
              %a{:href => "#AsSections"} above
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                  %mo ≃
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  E_{2n+1}\simeq 0
                  \\,.
          %h2#examples Examples
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eisenstein+series"} Eisenstein series
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/j-invariant"} j-invariant
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Weierstrass+sigma-function"} Weierstrass sigma-function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dedekind+eta+function"} Dedekind eta function
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/modular+group"} modular group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"}> elliptic curve
                ,
                %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+elliptic+curves"} moduli stack of elliptic curves
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hecke+correspondence"} Hecke correspondence
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacobi+form"} Jacobi form
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/elliptic+genus"}> elliptic genus
                ,
                %a.existingWikiWord{:href => "/nlab/show/Witten+genus"} Witten genus
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/topological+modular+form"}> topological modular form
                ,
                %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/p-adic+modular+form"} p-adic modular form
            %li
              %p
                generalization to functions on moduli of higher dimensional
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/abelian+varieties"} abelian varieties
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hilbert+modular+form"} Hilbert modular form
                %a.existingWikiWord{:href => "/nlab/show/Siegel+modular+forms"} Siegel modular forms
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/modularity+theorem"} modularity theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rankin-Cohen+bracket"} Rankin-Cohen bracket
          %h2#references References
          %p A basic and handy reference is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
              ,
              = succeed "," do
                %em Courbes elliptiques: formulaire d’apres J. Tate
              = succeed "," do
                %em Modular functions of one variable
              = succeed ")" do
                %a{:href => "http://modular.math.washington.edu/Tables/antwerp/deligne/"} web
          %p Textbook accounts:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Pierre+Serre"}> Jean-Pierre Serre
                , chapter VII of:
                = succeed "," do
                  %em A Course in Arithmetic
                = succeed "," do
                  %strong 7
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/978-1-4684-9884-4"} doi:10.1007/978-1-4684-9884-4
                = succeed "&rbrack;" do
                  %a{:href => "https://www.math.purdue.edu/~jlipman/MA598/Serre-Course%20in%20Arithmetic.pdf"} pdf
            %li
              %p
                N. Koblitz,
                = succeed "," do
                  %em Introduction to Elliptic Curves and Modular Forms
                %strong 97
                Springer (1984, 1993)
            %li#HirzebruchGergerJung92
              %p
                %a.existingWikiWord{:href => "/nlab/show/Friedrich+Hirzebruch"}> Friedrich Hirzebruch
                , Thomas Berger, Rainer Jung, Appendix I of:
                = succeed "," do
                  %em Manifolds and Modular Forms
                = succeed "," do
                  %strong 20
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/978-3-663-10726-2"} doi:10.1007/978-3-663-10726-2
                = succeed "&rbrack;" do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/hirzjung.pdf"} pdf
            %li#DiamondShurman05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fred+Diamond"}> Fred Diamond
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jerry+Shurman"} Jerry Shurman
                = succeed "," do
                  %em A First Course in Modular Forms
                = succeed "," do
                  %strong 228
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/978-0-387-27226-9"} doi:10.1007/978-0-387-27226-9
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Stein"}> William Stein
                \:
                = succeed "," do
                  %em Modular Forms, a Computational Approach
                = succeed "," do
                  %strong 79
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1090/gsm/079"} doi:10.1090/gsm/079
            %li
              %p
                Max Koecher, Aloys Krieg:
                = succeed "," do
                  %em Elliptische Funktionen und Modulformen
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-540-49325-9"} doi:10.1007/978-3-540-49325-9
          %p Lecture notes and reviews:
          %ul
            %li#Hain08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Hain"}> Richard Hain
                , section 4 of:
                %em Lectures on Moduli Spaces of Elliptic Curves
                \&amp;lbrack;
                %a{:href => "http://arxiv.org/abs/0812.1803"}> arXiv:0812.1803
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
                , section 10 of
                %a{:href => "http://www.math.uiuc.edu/~rezk/512-spr2001-notes.pdf"} pdf
            %li#Litt
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Litt"}> Daniel Litt
                ,
                %em Automorphic forms notes, part I
                (
                %a{:href => "http://math.stanford.edu/~dlitt/Talks/automorphicformspt1.pdf"}> pdf
                )
            %li
              %p
                Jan Hendrik Bruinier, Gerard van der Geer,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/G%C3%BCnter+Harder"} Günter Harder
                = succeed "," do
                  %em The 1-2-3 of modular forms
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nora+Ganter"}> Nora Ganter
                ,
                %em
                  %a{:href => "http://www.ms.unimelb.edu.au/~nganter/talbot/index.html"} Topological modular forms literature list
            %li#Martin13
              %p
                Kimball Martin,
                = succeed "," do
                  %em A brief overview of modular and automorphic forms
                %a{:href => "http://www2.math.ou.edu/~kmartin/papers/mfs.pdf"} pdf
            %li#Calegari13
              %p
                Frank Calegari,
                = succeed "," do
                  %em Congruences between modular forms
                %a{:href => "https://swc-math.github.io/aws/2013/2013CalegariLectureNotes.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joachim+Wehler"}> Joachim Wehler
                \:
                %em Modular Forms and Elliptic Curves
                (2021) &amp;lbrack;
                %a{:href => "https://www.mathematik.uni-muenchen.de/~wehler/ModularFormsScript.pdf"}> pdf
                \&amp;rbrack;
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "http://en.wikipedia.org/wiki/Modular_form"} Modular form
          %p
            Introduction in relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eric+D%27Hoker"}> Eric D'Hoker
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Justin+Kaidi"} Justin Kaidi
              %em Lectures on modular forms and strings
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2208.07242"}> arXiv:2208.07242
              \&amp;rbrack;
          %p The work of Erich Hecke:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Erich+Hecke"}> Erich Hecke
                ,
                = succeed "," do
                  %em Über Modulfunktionen und die Dirichletschen Reihen mit Eulerscher Produktentwicklung. I.
                %strong 114
                (1937) 1–28 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF01594160"}> doi:10.1007/BF01594160
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Erich+Hecke"}> Erich Hecke
                ,
                = succeed "," do
                  %em Über Modulfunktionen und die Dirichletschen Reihen mit Eulerscher Produktentwicklung. II.
                %strong 114
                (1937) 316–351 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF01594180"}> doi:10.1007/BF01594180
                \&amp;rbrack;
          %p
            The construction of Galois representations associated to normalized eigenforms of weight
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} \geq 2
            comes from
          %ul
            %li#Deligne71
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
              ,
              = succeed "," do
                %em Formes modulaires et représentations l-adiques
          %p
            The construction of Galois representations from weight
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            modular forms comes from
          %ul
            %li#DeligneSerre74
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"} Pierre Deligne
              and
              %a.existingWikiWord{:href => "/nlab/show/Jean-Pierre+Serre"} Jean-Pierre Serre
              %em Formes modulaires de poids 1
              Ann. Sci. Ecole Norm. Sup. (4), 7:507–530 (1975), 1974.
          %p References related to the modularity theorem are
          %ul
            %li#TaylorWiles95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Taylor"}> Richard Taylor
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andrew+Wiles"} Andrew Wiles
                = succeed "," do
                  %em Ring-Theoretic Properties of Certain Hecke Algebras
                %strong 141
                3 (1995) 553-572
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://doi.org/10.2307/2118560"} doi:10.2307/2118560
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li#BreuilConradDiamondTaylor2001
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christophe+Breuil"}> Christophe Breuil
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Brian+Conrad"} Brian Conrad
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Fred+Diamond"} Fred Diamond
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Richard+Taylor"} Richard Taylor
                = succeed "," do
                  %em
                    On the modularity of elliptic curves over
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi Q
                          %annotation{:encoding => "application/x-tex"} \mathbf{Q}
                %strong 14
                4 (2001) 843–939
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://doi.org/10.1090/S0894-0347-01-00370-8"} doi:10.1090/S0894-0347-01-00370-8
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
          %p
            Original discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/elliptic+genera"} elliptic genera
            and
            %a.existingWikiWord{:href => "/nlab/show/elliptic+cohomology"} elliptic cohomology
            includes
          %ul
            %li#LandweberRavenelStong93
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Landweber"}> Peter Landweber
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Douglas+Ravenel"} Douglas Ravenel
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Robert+Stong"} Robert Stong
                = succeed "," do
                  %em Periodic cohomology theories defined by elliptic curves
                %a.existingWikiWord{:href => "/nlab/show/Haynes+Miller"} Haynes Miller
                et. al. (eds.),
                = succeed "," do
                  %em The Cech centennial: A conference on homotopy theory
                = succeed ")" do
                  %a{:href => "http://www.math.sciences.univ-nantes.fr/~hossein/GdT-Elliptique/Landweber-Ravenel-Stong.pdf"} pdf
            %li#Landweber88
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Landweber"}> Peter Landweber
                ,
                = succeed "," do
                  %em Elliptic Cohomology and Modular Forms
                = succeed "," do
                  %em Elliptic Curves and Modular Forms in Algebraic Topology
                %strong 1326
                (1988) 55-68 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BFb0078038"}> doi:10.1007/BFb0078038
                \&amp;rbrack;
          %p Reviewed in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Kefeng+Liu"}> Kefeng Liu
              ,
              = succeed "," do
                %em Modular forms and topology
              = succeed ")" do
                %a{:href => "http://citeseerx.ist.psu.edu/viewdoc/summary?doi=10.1.1.130.9779"} citeseer
