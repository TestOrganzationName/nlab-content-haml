                    \\;\simeq\;
                    f \otimes id_{c_2}
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout-product axiom
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalModelCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              preserves acyclic cofibrations. (This is why one speaks of a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+bifunctor"} Quillen bifunctor
              = succeed ")." do
                %a{:href => "#Hovey99"} Hovey 99, prop. 4.3.1
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ⊗
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \otimes^L
              exists.
            %p
