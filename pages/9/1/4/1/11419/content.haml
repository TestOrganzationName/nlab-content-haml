                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "-argument," do
                %a.existingWikiWord{:href => "/nlab/show/Lefschetz+trace+formula"} Lefshetz fixed point
          %h2#Examples Examples
          %h3#ComplexVectorBundleAndTheirChernRoots Complex vectors bundles and their Chern roots
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = U(n)
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            %a.existingWikiWord{:href => "/nlab/show/universal+characteristic+classes"} universal characteristic classes
            are the
            %a.existingWikiWord{:href => "/nlab/show/Chern+classes"} Chern classes
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi k
                    %mo ∈
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c_k \in H^\bullet(B U(n), \mathbb{Z})
            %em
              %a{:href => "Chern+class#SplittingPrinciple"}> Chern class – Properties – Splitting principle and Chern roots
              \. the universal splitting principle here says that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi i
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo{:stretchy => "false"} (
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi k
                  %msub
                    %mi c
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo +
                  %msub
                    %mi x
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mi ⋯
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo +
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (B i)^\ast(\sum_k c_k) = (1 + x_1) \cdots (1+ x_n)
                  \\,,
          %p
            where the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi i
                  %mo ∈
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x_i \in H^\bullet(B U(1)^n , \mathbb{Z})
            are the universal characteristic classes of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/maximal+torus"} maximal torus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            incarnations of the universal
            %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
            (equivalently: the
            %a{:href => "group+character#RelationToChernRootsAndSplittingPrinciple"} weights
            of the
            %a.existingWikiWord{:href => "/nlab/show/group+characters"} group characters
            of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(n)
            %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundle"} complex vector bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                %annotation{:encoding => "application/x-tex"} \xi
            of
            %a.existingWikiWord{:href => "/nlab/show/rank"} rank
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            over a space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            when pulled back to its
            %a.existingWikiWord{:href => "/nlab/show/flag+space"} flag space
            bundle decomposes as a
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            of
            %a.existingWikiWord{:href => "/nlab/show/complex+line+bundles"} complex line bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ζ
                    %mi i
                %annotation{:encoding => "application/x-tex"} \zeta_i
            and has
            %a.existingWikiWord{:href => "/nlab/show/Chern+classes"} Chern classes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi k
                %annotation{:encoding => "application/x-tex"} c_k
            expressed in terms of the
            %a.existingWikiWord{:href => "/nlab/show/first+Chern+classes"} first Chern classes
            of these line bundles as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi k
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi p
                    %mo *
                  %mi ξ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi σ
                    %mi k
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ζ
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi c
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ζ
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  c_k(p^\ast \xi ) = \sigma_k(c_1(\zeta_1), \cdots, c_n(\zeta_n))
                  \\,.
          %p This case is typically the default meaning of the “splitting principle”.
          %p
            For the
            %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} special unitary group
            the situation is the same, only that here the splitting is into a sum of line bundles whose
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            is constrained to be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivializable
          %h3#linear_representations_and_brauer_induction Linear representations and Brauer induction
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Brauer+induction+theorem"} Brauer induction theorem
            may be regarded as the splitting principle for
            %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
            (
            %a{:href => "#Symonds91"}> Symonds 91
            ), see also at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/characteristic+classes+of+linear+representations"} characteristic classes of linear representations
          %h3#RealVectorBundles Real vector bundles
          %p
            Under the
            %em
              %a{:href => "Pontryagin+class#FurtherRelationToChernClasses"} Relation between Pontryagin classes and Chern classes
            the above translates into a splitting principle also for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+vector+bundles"} real vector bundles
          %h3#genera_and_hirzebruch_characteristic_series Genera and Hirzebruch characteristic series
          %p
            The basic theorem of
            %a.existingWikiWord{:href => "/nlab/show/Hirzebruch+series"} Hirzebruch series
            expresses
            %a.existingWikiWord{:href => "/nlab/show/genera"} genera
            via the splitting principle. The Hirzebruch characteristic series
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mi ϕ
                %annotation{:encoding => "application/x-tex"} K_\phi
            is a
            %a.existingWikiWord{:href => "/nlab/show/series"} series
            in a single variable
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x = c_1(L)
            %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
            of the universal
            %a.existingWikiWord{:href => "/nlab/show/complex+line+bundle"} complex line bundle
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(1)
          %p
            The Hirzebruch formula for the value of the
            %a.existingWikiWord{:href => "/nlab/show/genus"} genus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            on an
            %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi K
                    %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  \\phi(X) = \langle K_\phi(T X), [X]\rangle
          %p
            denotes the pairing of that class of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            with the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+class"} fundamental class
            which under the splitting principle pulls back on the
            %a.existingWikiWord{:href => "/nlab/show/flag+space"} flag space
            bundle to the class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi k
                  %msub
                    %mi K
                    %mi ϕ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_k K_\phi(x_k)
            of the corresponding direct sum of line bundles.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Snaith%27s+theorem"} Snaith's theorem
          %h2#references References
          %ul
            %li#May
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                ,
                = succeed "," do
                  %em A note on the splitting principle
                = succeed "," do
                  %a{:href => "http://www.math.uchicago.edu/~may/PAPERS/Split.pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/j.topol.2005.02.007"} doi:10.1016/j.topol.2005.02.007
            %li
              %p
                Marcelo Aguilar,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Samuel+Gitler"} Samuel Gitler
                = succeed "," do
                  %em Algebraic topology from a homotopical viewpoint
                = succeed ")" do
                  %a{:href => "http://tocs.ulb.tu-darmstadt.de/106999419.pdf"} toc pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"} Michael Hopkins
                (notes by
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/Akhil+Mathew"} Akhil Mathew
                = succeed "," do
                  %em Spectra and stable homotopy theory
                = succeed "," do
                  %a{:href => "http://math.uchicago.edu/~amathew/256y.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/HopkinsMathewStableHomotopyTheory.pdf", :title => "pdf"} pdf
          %p
            Discussion in the derivation of
            %a.existingWikiWord{:href => "/nlab/show/Chern+classes"} Chern classes
            and
            %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+classes"} Stiefel-Whitney classes
            includes
          %ul
            %li#Kochmann96
              %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochmann"}> Stanley Kochmann
              , section 2.3 of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
          %p See also
          %ul
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "https://en.wikipedia.org/wiki/Splitting_principle"} Splitting principle
            %li
              %p
                %em Notes on the splitting principle
                (
                %a{:href => "http://www.math.sunysb.edu/~azinger/mat566/splitting.pdf"}> pdf
                )
            %li#Dupont78
              %p
                Johan L. Dupont,
                = succeed "," do
                  %em Curvature and Characteristic Classes
                %strong 640
                (1978) doi:
                %a{:href => "http://dx.doi.org/10.1007/BFb0065364"}> 10.1007/BFb0065364
                \.
          %p
            Discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
            and their
            %a.existingWikiWord{:href => "/nlab/show/generalized+Chern+classes"} generalized Chern classes
            includes
          %ul
            %li
              %p
                %a{:href => "#Kochmann96"} Kochmann 96, section 4.3
            %li#TamakiKono06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dai+Tamaki"}> Dai Tamaki
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Akira+Kono"} Akira Kono
                = succeed "," do
                  %em Generalized Cohomology
                = succeed ")" do
                  %a{:href => "https://bookstore.ams.org/mmono-230"} ISBN: 978-0-8218-3514-2
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                , lecture 4 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Chromatic+Homotopy+Theory"} Chromatic Homotopy Theory
                = succeed ")" do
                  %a{:href => "http://www.math.harvard.edu/~lurie/252xnotes/Lecture4.pdf"} pdf
          %p
            More expository discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/characteristic+classes"} characteristic classes
            with applications in
            %a.existingWikiWord{:href => "/nlab/show/mathematical+physics"} mathematical physics
            is in
          %ul
            %li#Zhang11
              %a.existingWikiWord{:href => "/nlab/show/Yang+Zhang"}> Yang Zhang
              ,
              = succeed "," do
                %em A brief introduction to characteristic classes from the differentiable viewpoint
          %p
            The generalization to a splitting principle for
            %a.existingWikiWord{:href => "/nlab/show/twisted+vector+bundles"} twisted vector bundles
            (
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"}> twisted cohomology
            ) is discussed (in terms of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe+modules"} bundle gerbe modules
          %ul
            %li#Tomoda07
              %a.existingWikiWord{:href => "/nlab/show/Atsushi+Tomoda"}> Atsushi Tomoda
              ,
              = succeed "," do
                %em On the splitting principle of bundle gerbe modules
              = succeed "," do
                %a{:href => "https://projecteuclid.org/euclid.ojm/1174324334"} Euclid
              = succeed ")" do
                %a{:href => "http://ton.prosou.nu/official/ryousi2005.pdf"} pdf
          %p
            For
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+classes+of+linear+representations"} characteristic classes of linear representations
          %ul
            %li#Symonds91
              %a.existingWikiWord{:href => "/nlab/show/Peter+Symonds"}> Peter Symonds
              ,
              = succeed "," do
                %em A splitting principle for group representations
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/BF02566643"} doi:10.1007/BF02566643
