                        %annotation{:encoding => "application/x-tex"} H^\bullet(B G,R)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi T
                        %mo ,
                        %mi R
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H^\bullet(B T, R)
                  (via
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi B
                          %msup
                            %mi i
                            %mo *
                        %annotation{:encoding => "application/x-tex"} B i^\ast
                  %a.existingWikiWord{:href => "/nlab/show/free+module"} free
                  on the cohomology of
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi T
                        %annotation{:encoding => "application/x-tex"} G/T
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi T
                        %mo ,
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msup
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi G
                        %mo ,
                        %mi R
                        %mo{:stretchy => "false"} )
