                    c \in H^\bullet(B G,R)
            %p
              are the
              %a.existingWikiWord{:href => "/nlab/show/universal+characteristic+classes"} universal characteristic classes
              of
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              (hence by
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory"} Chern-Weil theory
              the
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomials"} invariant polynomials
              of the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              has
              = succeed "-0)," do
                %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
              %a.maruku-ref{:href => "#GeneralizedSplittingPrinciple"}
              gives the following way to express the characteristic classes of
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by
              %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi c
                      %mn 1
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msubsup
                      %mi c
                      %mn 1
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi i
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi c
                  %annotation{:encoding => "application/x-tex"}
                    (c_1^1, \cdots, c_1^n) \coloneqq (B i)^\ast c
            %p
              of characteristic classes – hence
              %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern classes
              – of just circle bundles (
              %a.existingWikiWord{:href => "/nlab/show/line+bundles"}> line bundles
              ):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi g
                      %mn 1
                      %mo *
                    %msubsup
                      %mi c
                      %mn 1
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msubsup
                      %mi g
                      %mi n
                      %mo *
                    %msubsup
                      %mi c
                      %mn 1
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p^\ast (c(P)) \simeq (g_1^\ast c_1^1, \cdots, g_n^\ast c_1^n)
                    \\,.
            %p
              (Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p^\ast
              is injective, this is a genuine characterization of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
