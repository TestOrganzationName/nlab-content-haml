              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion subgroup
            %p Then
            %ol
              %li
                %p
                  The
                  = succeed "-module" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi H
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mi G
                          %mo ,
                          %mi R
