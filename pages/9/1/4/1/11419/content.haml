          %h2#SplittingPrinciple Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
            %em splitting principle
            for a
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} B G
            for some
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            (
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of some
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-classifying" do
              %a.existingWikiWord{:href => "/nlab/show/torus"} torus
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi T
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mi f
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  B (T^n) \overset{f}{\longrightarrow} B G
          %p
            such that the induced
            %a.existingWikiWord{:href => "/nlab/show/pullback+in+cohomology"} pullback
            of
            %a.existingWikiWord{:href => "/nlab/show/cohomology+rings"} cohomology rings
            is an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi B
                  %msup
                    %mi T
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  f^\ast \;\colon\; H^\bullet(B G) \hookrightarrow H^\bullet(B T^n)
                  \\,,
          %p
            hence allowing to view the cohomology of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
            in terms of that of plain
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/torus"} torus
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
          %p
            In particular for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a classical
            %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
            such as the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            %a.existingWikiWord{:href => "/nlab/show/Chern+classes"} Chern classes
            of
            %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundles"} complex vector bundles
            as algebraic expressions in just
            %a.existingWikiWord{:href => "/nlab/show/first+Chern+classes"} first Chern classes
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+line+bundles"} complex line bundles
          %h2#statement Statement
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
            %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
            and write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo ≃
                  %mi T
                  %mover
                    %mo ↪
                    %mi i
                  %mi G
                %annotation{:encoding => "application/x-tex"} U(1)^n \simeq T \stackrel{i}{\hookrightarrow} G
            for a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/maximal+torus"} maximal torus
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected topological space
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classified
            by a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \colon X \to B G
          %p
            Then consider the
            %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi T
                %annotation{:encoding => "application/x-tex"} G/T
            and the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi T
                  %annotation{:encoding => "application/x-tex"} G/T
            %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} Y\to X
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            in the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Y
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi g
                                %mn 1
                              %mo ,
                              %mi ⋯
                              %mo ,
                              %msub
                                %mi g
                                %mi n
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mi B
                          %mi T
                        %mtd
                          %mo ≃
                          %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi n
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %msup
                            %mrow
                            %mpadded{:width => "0"}
                              %mi p
                        %mtd
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %msup
                            %mrow
                            %mpadded{:width => "0"}
                              %mrow
                                %mi B
                                %mi i
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo ⟶
                            %mi g
                        %mtd
                          %mi B
                          %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Y
                  \&amp;\stackrel{(g_1,\cdots, g_n)}{\longrightarrow}&amp;
                  B T
                  \&amp; \simeq B U(1)^n
                  \\\
                  \\big\downarrow {}^{\mathrlap{p}}
                  \&amp;&amp;
                  \\big\downarrow {}^{\mathrlap{B i}}
                  \\\
                  X &amp;\stackrel{g}{\longrightarrow}&amp; B G
                  }
                  \\,.
          %p
            This diagram shows that the pullback of the
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is equivalently a
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "-principal" do
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi g
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g_1, \cdots, g_n)
          %p That this is a useful splitting is the content of:
          #GeneralizedSplittingPrinciple.num_theorem
            %h6#theorem Theorem
            %p
              %strong (generalized splitting principle)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              in which a
              %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is a
              %a.existingWikiWord{:href => "/nlab/show/unit"} unit
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi G
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_\bullet(B G,\mathbb{Z})
              has a
              = succeed "-" do
