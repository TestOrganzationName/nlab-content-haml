                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} |
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi T
                      %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} \chi(G/T) = | N(T)/T |
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
