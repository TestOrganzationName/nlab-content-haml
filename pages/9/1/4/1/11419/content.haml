                        %msup
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi T
                        %mo ,
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        H^\bullet(B T,R)\simeq H^\bullet(B G,R) \otimes H^\bullet(G/T, R)
                        \\,;
              %li
                %p Analogously there is an isomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi H
