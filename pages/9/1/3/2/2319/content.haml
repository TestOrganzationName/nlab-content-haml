                    %a.existingWikiWord{:href => "/nlab/show/orthogonal+structure"}> orthogonal structure
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/vielbein"}> vielbein
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
                  %td{:style => "text-align: left;"}
                %tr
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} ↓
                        %annotation{:encoding => "application/x-tex"} \downarrow
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                        %annotation{:encoding => "application/x-tex"} \mathbf{B}GL
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  %td{:style => "text-align: left;"}
            %p
              (all hooks are
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequences"} homotopy fiber sequences
          %h2#references References
          %h3#general_2 General
          %p Original references:
          %ul
            %li#Milnor1963
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Milnor"}> John Milnor
                \:
                = succeed "," do
                  %em Spin Structures on Manifolds
                %strong 9
                (1963) 198-203 &amp;lbrack;
                %a{:href => "http://doi.org/10.5169/seals-38784"}> doi:10.5169/seals-38784
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Milnor-SpinStructures.pdf", :title => "pdf"} pdf
            %li#Atiyah71
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
                \:
                = succeed "," do
                  %em Riemann surfaces and spin structures
                = succeed "&rbrack;" do
                  %a{:href => "https://www.numdam.org/item/?id=ASENS_1971_4_4_1_47_0"} numdam:ASENS_1971_4_4_1_47_0
              %blockquote
                %p
                  (spin structures on
                  %a.existingWikiWord{:href => "/nlab/show/Riemann+surface"} Riemann
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/surfaces"} surfaces
          %p Monographs:
          %ul
            %li#LawsonMichelson1989
              %p
                %a.existingWikiWord{:href => "/nlab/show/H.+Blaine+Lawson"}> H. Blaine Lawson
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Marie-Louise+Michelsohn"} Marie-Louise Michelsohn
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Spin+geometry"} Spin geometry
                = succeed "," do
                  %a{:href => "https://press.princeton.edu/books/hardcover/9780691085425/spin-geometry-pms-38-volume-38"} ISBN 9780691085425
                = succeed "&rbrack;" do
                  %a{:href => "https://www.jstor.org/stable/j.ctt1bpmb28"} jstor:j.ctt1bpmb28
            %li#Friedrich97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Friedrich"}> Thomas Friedrich
                \:
                = succeed "," do
                  %em Dirac operators in Riemannian geometry
                %strong 25
                AMS (1997)
          %p
            Concerning the action of
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
            on spin structures:
          %ul
            %li
              L. Dąbrowski,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Roberto+Percacci"} Roberto Percacci
              = succeed "," do
                %em Spinors and diffeomorphisms
              %strong 106
              4 (1986) 691-704 &amp;lbrack;
              %a{:href => "https://projecteuclid.org/journals/communications-in-mathematical-physics/volume-106/issue-4/Spinors-and-diffeomorphisms/cmp/1104115859.full"}> euclid:cmp/1104115859
              \&amp;rbrack;
          %p
            and specifically concerning the action of the
            %a.existingWikiWord{:href => "/nlab/show/modular+group"} modular group
            %a.existingWikiWord{:href => "/nlab/show/SL%282%2CZ%29"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi SL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SL_2(\mathbb{Z})
            on spin structures over
            %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/surfaces"} surfaces
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Luis+Alvarez-Gaum%C3%A9"}> Luis Alvarez-Gaumé
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gregory+Moore"} Gregory Moore
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                = succeed "," do
                  %em Theta functions, modular invariance, and strings
                %strong 106
                (1986) 1–40 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF01210925"}> doi:10.1007/BF01210925
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://projecteuclid.org/journals/communications-in-mathematical-physics/volume-106/issue-1/Theta-functions-modular-invariance-and-strings/cmp/1104115581.full"} eculid:cmp/1104115581
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Oscar+Randal-Williams"} Oscar Randal-Williams
                = succeed "&lbrack;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mspace{:width => "thickmathspace"}
                      %annotation{:encoding => "application/x-tex"} \;
                = succeed "&rbrack;" do
                  %a{:href => "https://mathoverflow.net/a/72770/381"} MO:a/72770
          %p
            Discussion of the full
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            of spin structures:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Johannes+Ebert"}> Johannes Ebert
              ,
              = succeed "," do
                %em Characteristic classes of spin surface bundles: Applications of the Madsen-Weiss theory
              = succeed ")" do
                %a{:href => "http://wwwmath.uni-muenster.de/wwwmath.uni-muenster.de/u/jeber_02/papers/thesis.pdf"} pdf
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/lifting+bundle+gerbes"} lifting bundle gerbes
            for spin structures:
          %ul
            %li#MurraySinger03
              %a.existingWikiWord{:href => "/nlab/show/Michael+Murray"}> Michael Murray
              , Michael Singer,
              %em Gerbes, Clifford modules and the index theorem
              (
              %a{:href => "http://arxiv.org/abs/math/0302096"}> arXiv:math/0302096
              )
          %h3#over_lorentzian_manifolds_2 Over Lorentzian manifolds
          %p
            Concerning spin structures on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lorentzian+manifolds"} Lorentzian manifolds
          %ul
            %li#Geroch68
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Geroch"}> Robert Geroch
                \:
                = succeed "," do
                  %em Spinor Structure of Space‐Times in General Relativity. I
                %strong 9
                (1968) 1739–1744 &amp;lbrack;
                %a{:href => "https://doi.org/10.1063/1.1664507"}> doi:10.1063/1.1664507
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Geroch-SpinorStructureI.pdf", :title => "pdf"} pdf
            %li#Geroch70
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Geroch"}> Robert Geroch
                \:
                = succeed "," do
                  %em Spinor Structure of Space‐Times in General Relativity. II
                %strong 11
                (1970) 343–348 &amp;lbrack;
                %a{:href => "https://doi.org/10.1063/1.1665067"}> doi:10.1063/1.1665067
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Geroch-SpinorStructureII.pdf", :title => "pdf"} pdf
            %li#Lee73
              %p
                Kotik Kai Lee:
                = succeed "," do
                  %em Global spinor fields in space-time
                %strong 4
                (1973) 421–433 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF01215402"}> doi:10.1007/BF01215402
                \&amp;rbrack;
            %li#Lee75
              %p
                Kotik Kai Lee:
                = succeed "," do
                  %em Comments on the Spinor Structure of Space-Time
                %strong 18
                3 (1975) 437-438 &amp;lbrack;
                %a{:href => "https://doi.org/10.4153/CMB-1975-083-1"}> doi:10.4153/CMB-1975-083-1
                \&amp;rbrack;
          %h3#over_spheres Over spheres
          %p
            For the case of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
          %ul
            %li#Nowaczyk15
              %p
                Nikolai Nowaczyk, Theorem A.6.6 in:
                %em Dirac Eigenvalues of higher Multiplicity
                (
                %a{:href => "https://arxiv.org/abs/1501.04045"}> arXiv:1501.04045
                )
            %li#Gutt86
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simone+Gutt"}> Simone Gutt
                \:
                = succeed "," do
                  %em Killing spinors on spheres and projective spaces
                = succeed "," do
                  %em Spinors in Geometry and Physics – Trieste 11-13 September 1986
                = succeed "," do
                  %a{:href => "https://doi.org/10.1142/9789814541510"} doi:10.1142/9789814541510
                = succeed "&rbrack;" do
                  %a{:href => "https://books.google.ae/books?id=d14GCwAAQBAJ&lpg=PA243&ots=_tH_He8UFg&dq=%22spin%20structure%20on%20spheres%22&pg=PA243#v=onepage&q=%22spin%20structure%20on%20spheres%22&f=false"} GBooks, p. 243
          %h3#over_surfaces_2 Over surfaces
          %p
            Discussion of spin structures on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/surfaces"} surfaces
          %ul
            %li
              %p
                %a{:href => "#Atiyah71"} Atiyah 1971
            %li#Johnson80
              %p
                Dennis Johnson,
                = succeed "." do
                  %em Spin structures and quadratic forms on surfaces
          %p
            See also
            = succeed "." do
              %a{:href => "http://mathoverflow.net/a/136425/381"} this MO comment
          %h3#on_khler_manifolds On Kähler manifolds
          %p
            Discussion of spin structure on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifolds"} Kähler manifolds
          %ul
            %li#Hitchin74
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nigel+Hitchin"}> Nigel Hitchin
                ,
                = succeed "," do
                  %em Harmonic spinors
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christian+B%C3%A4r"}> Christian Bär
                ,
                %em On harmonic spinors
                (
                %a{:href => "http://www.actaphys.uj.edu.pl/vol29/pdf/v29p0859.pdf"}> pdf
                )
          %p
            A textbook account is in (
            %a{:href => "#Friedrich97"}> Friedrich 97, section 3.4
            )
          %p A survey is also at
          %ul
            %li
              %p
                %em
                  %a{:href => "http://amathew.wordpress.com/2013/06/23/theta-characteristics-and-framings/"} Theta characteristics and framings
            %li
              %p
                %em Spin manifolds
                (
                %a{:href => "http://empg.maths.ed.ac.uk/Activities/Spin/Lecture4.pdf"}> pdf
                )
          %h3#on_orbifolds On orbifolds
          %p
            Spin structures on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/orbifolds"} orbifolds
          %ul
            %li
              %p
                Daniel J. Acosta,
                = succeed "," do
                  %em A Furuta-like inequality for spin orbifolds and the minimal genus problem
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/S0166-8641(00)00030-4"} doi:10.1016/S0166-8641(00)00030-4
            %li
              %p
                Chongying Dong,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kefeng+Liu"} Kefeng Liu
                %em On orbifold elliptic genus
                (
                %a{:href => "https://webusers.imj-prg.fr/~xiaonan.ma/mypubli/dlm02.pdf"}> pdf
                ), p. 87-105 In:
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alejandro+Adem"} Alejandro Adem
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jack+Morava"} Jack Morava
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yongbin+Ruan"} Yongbin Ruan
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Orbifolds+in+Mathematics+and+Physics"} Orbifolds in Mathematics and Physics
                = succeed ")" do
                  %a{:href => "https://bookstore.ams.org/conm-310"} ams:conm-310
            %li
              %p
                Florin Belgun, Nicolas Ginoux, Hans-Bert Rademacher,
                = succeed "," do
                  %em A Singularity Theorem for Twistor Spinors
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/math/0409136"} arXiv:math/0409136
                = succeed ")" do
                  %a{:href => "http://www.numdam.org/item/AIF_2007__57_4_1135_0"} numdam:AIF_2007__57_4_1135_0
          %h3#in_quantum_anomaly_cancellation In quantum anomaly cancellation
          %p
            Discussions of spin structures as
            %a.existingWikiWord{:href => "/nlab/show/anomaly+cancellation"} anomaly cancellation
            for the
            %a.existingWikiWord{:href => "/nlab/show/spinning+particle"} spinning particle
            (see also the references hereuantum mechanics#ReferencesRelationToMorseTheory) at
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/supersymmetric+quantum+mechanics"} supersymmetric quantum mechanics
          %ul
            %li#Witten85
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                , p. 65-68 in:
                = succeed "," do
                  %em Global anomalies in string theory
                = succeed "," do
                  %em
                    %a{:href => "https://inspirehep.net/conferences/965785?ui-citation-summary=true"} Symposium on Anomalies, Geometry, Topology
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/files/WittenGlobalAnomaliesInStringTheory.pdf", :title => "pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://inspirehep.net/literature/214913"} spire:214913
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Luis+Alvarez-Gaum%C3%A9"}> Luis Alvarez-Gaumé
                , p. 165 of:
                = succeed "," do
                  %em Supersymmetry and the Atiyah-Singer index theorem
                %strong 90
                2 (1983) 161-173 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF01205500"}> doi:10.1007/BF01205500
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://projecteuclid.org/journals/communications-in-mathematical-physics/volume-90/issue-2/Supersymmetry-and-the-Atiyah-Singer-index-theorem/cmp/1103940278.full"} euclid
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Friedan"}> Daniel Friedan
                , P. Windey,
                = succeed "," do
                  %em Supersymmetric derivation of the Atiyah-Singer index and the chiral anomaly
                %strong 235
                (1984) 395 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0550-3213(84)90506-6"}> doi:10.1016/0550-3213(84)90506-6
                \&amp;rbrack;
        .revisedby
