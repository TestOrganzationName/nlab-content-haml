              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi B
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mover
                              %mi g
                              %mo{:stretchy => "false"} ^
                          %mo ↗
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi g
                        %mtd
                          %mi B
                          %mi S
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; B Spin(n)
                  \\\
                  \&amp; {}^{\hat g}\nearrow &amp; \downarrow
                  \\\
                  X &amp;\stackrel{g}{\to}&amp;
                  B S O(n)
                  }
          %p
            Spin structures derive their name from the fact that their existence on a space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            make the
            %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} quantum anomaly
            for spinning particles propagating on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            vanish. See there.
          %h2#Definition Definition
          %p
            Let
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo →
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{Z}_2 \to Spin(n) \to SO(n)
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            %a.existingWikiWord{:href => "/nlab/show/group+extension"} group extension
            of the
            %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} special orthogonal group
            in
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Lorentzian+signature"} Lorentzian signature
          %h3#topological Topological
          .num_defn
            %h6#definition_2 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %mo ˜
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo →
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\widetilde{SO(n)} \coloneqq [\mathbb{Z}_2 \to Spin(n)]
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+groups"} smooth groups
              induced by the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+extension"} group extension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}\mathbb{Z}_2 \coloneqq [\mathbb{Z}_2 \to 1]
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
              given by shifting up the
              %a.existingWikiWord{:href => "/nlab/show/group+of+order+two"} group of order two
              in degree. Finally write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mrow
                                %mi SO
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                              %mo ˜
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi SO
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\widetilde{SO(n)}
                    \\\
                    \\downarrow
                    \\\
                    SO(n)
                    }
            %p
              for the canonical morphism of
              %a.existingWikiWord{:href => "/nlab/show/crossed+modules"} crossed modules
              which is the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
              morphism in degree-1 and the defining projection in degree 0, and write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi w
                        %mo{:stretchy => "false"} ˜
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mrow
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %mo ˜
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo →
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde{\mathbf{w}}_2
                    \\;\colon\;
                    \\widetilde{SO(n)}
                    \=
                    [\mathbb{Z}_2 \to Spin(n)]
                    \\longrightarrow
                    [\mathbb{Z}_2 \to 1]
                    \=
                    \\mathbf{B}\mathbb{Z}_2
            %p
              for the canonical morphism of
              %a.existingWikiWord{:href => "/nlab/show/crossed+modules"} crossed modules
              which is the identity in degree 1 and the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
              map in degree 0.
          #SmoothSWMap.num_prop
            %h6#proposition Proposition
            %p
              In the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/span"} span
              %a.existingWikiWord{:href => "/nlab/show/zig-zag"} zig-zag
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mrow
                                %mi SO
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                              %mo ˜
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi w
                                    %mn 2
                                %mo{:stretchy => "false"} ˜
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msub
                              %mi ℤ
                              %mn 2
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi SO
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\widetilde{SO(n)} &amp;\stackrel{\tilde{\mathbf{w}_2}}{\longrightarrow}&amp;
                    \\mathbf{B}\mathbb{Z}_2
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    SO(n)
                    }
            %p
              the left leg is a
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+groupoids"} smooth groupoids
              (under the identification of
              %a.existingWikiWord{:href => "/nlab/show/crossed+modules"} crossed modules
              with
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/strict+2-groups"} strict 2-groups
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              it presents a morphism of
              %a.existingWikiWord{:href => "/nlab/show/smooth+2-groupoids"} smooth 2-groupoids
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi w
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{w}_2 \;\colon\; \mathbf{B}SO(n) \longrightarrow \mathbf{B}^2 \mathbb{Z}_2
            %p
              from the universal
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
              of smooth
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SO
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SO(n)
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              to that of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{Z}_2
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundles"} principal 2-bundles
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              \-
              %a.existingWikiWord{:href => "/nlab/show/bundle+gerbes"}> bundle gerbes
              ). The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of this map in
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}Spin(n)
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              regarded as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+group"} smooth group
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+cohesive+%E2%88%9E-groupoids"} geometric realization of cohesive ∞-groupoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                    %mo ⟶
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} {\vert - \vert} \colon Smooth\infty Grpd \longrightarrow \infty Grpd
              this maps ti the universal
              %a.existingWikiWord{:href => "/nlab/show/second+Stiefel-Whitney+class"} second Stiefel-Whitney class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi w
                        %mn 2
                      %mo{:stretchy => "false"} |
                    %mo ≃
                    %msub
                      %mi w
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\vert \mathbf{w}_2\vert}
                    \\simeq
                    w_2
                    \\;\colon\;
                    B SO(n) \longrightarrow K(\mathbb{Z}_2,2)
                    \\,.
          %p
            This is discussed in (
            %a{:href => "#dcct"}> dcct, section 5.1
            ).
          .proof
            %h6#proof Proof
            %p
              One checks that the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi w
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{w}_2
              in
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}Spin(n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(n)
              the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              regarded as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+group"} smooth group
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
              as discussed there. Moreover, by the general discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid+--+structures"} smooth ∞-groupoid – structures
              this homotopy fiber is preseved under
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+cohesive+%E2%88%9E-groupoids"} geometric realization of cohesive ∞-groupoids
              so that the homotopy fiber of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi w
                        %mn 2
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {\vert \mathbf{w}_2 \vert}
              is the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B Spin(n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}(\mathbb{Z}_2,2)
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected"} connected
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi w
                        %mn 2
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {\vert \mathbf{w}_2 \vert}
              as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi w
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} w_2
          #TangentBundleModulatingMap.num_remark
            %h6#remark Remark
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              is modulated by a map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_X \colon X \longrightarrow \mathbf{B}SO(n)
                    \\,.
            %p
              Postcomposition with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi w
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{w}_2
              from prop.
              %a.maruku-ref{:href => "#SmoothSWMap"}
              gives a map in
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi w
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi τ
                          %mi X
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi w
                          %mn 2
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %msub
                      %mi ℤ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{w}_2(\tau_X)
                    \\;\colon\;
                    X \stackrel{\tau_X}{\longrightarrow}
