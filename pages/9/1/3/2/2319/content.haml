                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^2(-,\mathbb{Z}_2)
