                                  %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi z
                              %mn 2
                            %msub
                              %mo ∂
                              %mrow
                                %msub
                                  %mi z
                                  %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    z_1 \partial_{z_1}
                    \&amp;  =
                    z_2^{-1} \frac{\partial z_2}{\partial z_1 } \partial_{z_2}
                    \\\
                    \&amp; = z_2^{-1} (- z_1^{-2}) \partial_{z_2}
                    \\\
                    \&amp; = - z_2 \partial_{z_2}
                    \\end{aligned}
            %p
              and hence continues canonically to a well-defined vector field on all of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S^2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi k
                  %annotation{:encoding => "application/x-tex"} L_k
              is the rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              line bundle on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
              given by the
              %a.existingWikiWord{:href => "/nlab/show/clutching+construction"} clutching construction
              by the transition function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi z
                        %mi k
                    %annotation{:encoding => "application/x-tex"} z^k
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi z
                        %mn 1
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                    %annotation{:encoding => "application/x-tex"} z_1^{a_1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi z
                      %mn 2
                      %mrow
                        %msub
                          %mi a
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} z_2^{a_2}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi i
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a_i \geq 0
              satisfying
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi z
                      %mn 2
                      %mrow
                        %msub
                          %mi a
                          %mn 2
                    %mo =
                    %msubsup
                      %mi z
                      %mn 2
                      %mi k
                    %msubsup
                      %mi z
                      %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mi a
                          %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    z_2^{a_2} = z_2^{k} z_2^{-a_1}
            %p and hence for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %mo +
                    %msub
                      %mi a
                      %mn 2
