          %h3#OverLorentzianManifolds Over Lorentzian manifolds
          %p
          #GerochTheorem.num_prop
            %h6 Proposition
            %p
              %strong (Geroch’s theorem)
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/Lorentzian+manifold"} Lorentzian manifold
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension+of+a+manifold"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo +
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 1+3
              admits a spin structure if and only if it admits a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/framed+manifold"} framing
              %br/
          %p
            This is due to
            %a{:href => "#Geroch68"} Geroch 1968
            for the case of non-
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            spacetimes (as
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/4-manifolds"} 4-manifolds
            = succeed "." do
              %a{:href => "#Geroch70"} Geroch 1970
            = succeed "," do
              %a{:href => "#Lee73"} Lee 1973
            = succeed "." do
              %a{:href => "#Lee75"} 1975
          %p
          .num_remark
            %h6 Remark
            %p
              For the special case of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/globally+hyperbolic+spacetimes"} globally hyperbolic spacetimes
              %a.maruku-ref{:href => "#GerochTheorem"}
              is implied by the yet stronger statement that every
              %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
              %a.existingWikiWord{:href => "/nlab/show/3-manifold"} 3-manifold
              admits a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/framed+manifold"} framing
              = succeed "." do
                %a{:href => "framed+manifold#Examples3Manifolds"} there
          %h3#OverARiemannSurface Over surfaces
          %p
            Over a
            %a.existingWikiWord{:href => "/nlab/show/Riemann+surface"} Riemann surface
            spin structures correspond to
            %a.existingWikiWord{:href => "/nlab/show/square+roots"} square roots
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/canonical+bundle"} canonical bundle
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Theta+characteristic"} Theta characteristic
          %p
          #SpinStructuresOnClosedSurfaces.num_prop
            %h6 Proposition
            %p
              On the
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
              %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
              %a.existingWikiWord{:href => "/nlab/show/surface"} surface
              of
              %a.existingWikiWord{:href => "/nlab/show/genus+of+a+surface"} genus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} g \in \mathbb{N}
              there exist precisely
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 2
                      %mrow
                        %mn 2
                        %mi g
                  %annotation{:encoding => "application/x-tex"} 2^{2g}
              distinct spin structures.
          .proof
            %h6 Proof
            %p
              By the general classification of spin structures of Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ClassificationOfSpinStructures"}
              %a{:href => "surface#OrdinaryHomologyOfClosedOriented"} there
              and using the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
          %p
            Cf.
            = succeed "," do
              %a{:href => "#Atiyah71"} Atiyah 1971
            = succeed "." do
              %a{:href => "#LawsonMichelson1989"} Lawson &amp; Michelson 1989 Ex. 2.6
          %p
            Also
            = succeed "." do
              %a{:href => "#Johnson80"} Johnson 1980
          %h3#on_spheres
            On
            = succeed "-spheres" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
          #OnThe2Sphere.num_remark
            %h6 Example
            %p
            %p
              The 2-
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
              is famously a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Riemann+sphere"} Riemann sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
              with two copies of the
              %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
              with
              %a.existingWikiWord{:href => "/nlab/show/coordinate"} coordinate
              transition functions on the overlap
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{C} - \{0\}
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi z
                      %mn 2
                    %mo =
                    %msubsup
                      %mi z
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    z_2 = z_1^{-1}
                    \\,.
            %p
              The 2-sphere is moreover a
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifold"} Kähler manifold
              and of course
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.maruku-ref{:href => "#SpinstructureOnCompactKaehlerIsSquareRootOfCanonical"}
              a spin structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mrow
                        %msup
                          %mi Ω
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 0
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Line
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sqrt{\Omega^{1,0}} \in \mathbf{Line}_{\mathbb{C}}(S^2)
              of the
              %a.existingWikiWord{:href => "/nlab/show/canonical+line+bundle"} canonical line bundle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mrow
                          %mn 1
                          %mo ,
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} \Omega^{1,0}
            %p
              Now hermitian
              %a.existingWikiWord{:href => "/nlab/show/complex+line+bundles"} complex line bundles
              on the 2-sphere are classified by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} H^2(S^2, \mathbb{Z}) \simeq \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/clutching+construction"} clutching construction
              a line bundle given by two trivializing sections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 1
                    %mo ,
                    %msub
                      %mi σ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \sigma_1, \sigma_2
              of the trivial line bundle on the coordinate patch
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              has class the
              %a.existingWikiWord{:href => "/nlab/show/winding+number"} winding number
              of the transition function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ↪
                    %mi ℂ
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi s
                          %mn 2
                        %msubsup
                          %mi s
                          %mn 1
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %msup
                      %mi ℂ
                      %mo ×
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^1 \hookrightarrow \mathbb{C} - \{0\}
                    \\stackrel{s_2 s_1^{-1}}{\to} \mathbb{C}^\times
                    \\,.
            %p
              Now the canonical section of the holomorphic 1-form bundle on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              is simply the canonical 1-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi z
                  %annotation{:encoding => "application/x-tex"} d z
              itself. By the above
              %a.existingWikiWord{:href => "/nlab/show/coordinate+charts"} coordinate charts
              we have on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{C} - \{0\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi z
                      %mn 2
                    %mo =
                    %mi d
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi z
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msubsup
                      %mi z
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 2
                    %mi d
                    %msub
                      %mi z
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    d z_2 = d (z_1^{-1}) = - z_1^{-2} d z_1
            %p and so the transition function of the canonical bundle in this local trivialization is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mi z
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℂ
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo →
                    %msup
                      %mi ℂ
                      %mo ×
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \- z^{-2} \colon \mathbb{C}-\{0\} \to \mathbb{C}^\times
                    \\,.
            %p
              This has winding number
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ±
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \pm 2
              %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
              of the holomorphic 1-form bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \Omega^{1,0}
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo ±
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} c_1(\Omega^{1,0}) =  \pm 2
              (the sign being an arbitrary convention, determined by the identification
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} H^2(S^2, \mathbb{Z}) \simeq \mathbb{Z}
            %p
              And so it follows that there is a unique spin structure, namely given by choosing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mrow
                        %msup
                          %mi Ω
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 0
                  %annotation{:encoding => "application/x-tex"} \sqrt{\Omega^{1,0}}
              to be the line bundle on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
              with first Chern class
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ±
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \pm 1
            %p
              To construct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mrow
                        %msup
                          %mi Ω
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 0
                  %annotation{:encoding => "application/x-tex"} \sqrt{\Omega^{1,0}}
              by local sections analogous to how we got
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \Omega^{1,0}
              from the two sections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi z
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} d z_1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %msub
                        %mi z
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} d z_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo −
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{C} - [0,\infty)
              and consider one of the two
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi z
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mi d
                    %msub
                      %mi z
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} z_1^{-1/2} d z_1
              as a local section of the trivial complex line bundle. Do the same on the other patch. Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi z
                              %mn 2
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                                %mo{:stretchy => "false"} /
                                %mn 2
                            %mi d
                            %msub
                              %mi z
                              %mn 2
                          %mtd
                            %mo =
                            %msubsup
                              %mi z
                              %mn 1
                              %mrow
                                %mn 1
                                %mo{:stretchy => "false"} /
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msubsup
                              %mi z
                              %mn 1
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 2
                            %mi d
                            %msub
                              %mi z
                              %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msubsup
                              %mi z
                              %mn 1
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mrow
                              %mo (
                              %msubsup
                                %mi z
                                %mn 1
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                                  %mo{:stretchy => "false"} /
                                  %mn 2
                              %msub
                                %mi dz
                                %mn 1
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    z_2^{-1/2} d z_2
                    \&amp;=
                    z_1^{1/2} (-z_1^{-2} d z_1)
                    \\\
                    \&amp;=  -z_1^{-1}\left(z_1^{-1/2} dz_1\right)
                    \\end{aligned}
                    \\,.
            %p
              This is well defined also over the cut and so we can patch the cut with any small neighbourhood with any section chosen over it and conclude that these sections are the local sections locally trivializing a bundle of class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ±
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \pm 1
              and hence that of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msqrt
                        %mrow
                          %msup
                            %mi Ω
                            %mrow
                              %mn 1
                              %mo ,
                              %mn 0
                    %annotation{:encoding => "application/x-tex"} \sqrt{\Omega^{1,0}}
            %p
              Notice also that the canonical vector field on the first patch given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi z
                      %mn 1
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi z
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} z_1 \partial_{z_1}
              transforms on the overlap to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi z
                              %mn 1
                            %msub
                              %mo ∂
                              %mrow
                                %msub
                                  %mi z
                                  %mn 1
                          %mtd
                            %mo =
                            %msubsup
                              %mi z
                              %mn 2
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mfrac
                              %mrow
                                %mo ∂
                                %msub
                                  %mi z
                                  %mn 2
                              %mrow
                                %mo ∂
                                %msub
                                  %mi z
                                  %mn 1
                            %msub
                              %mo ∂
                              %mrow
                                %msub
                                  %mi z
                                  %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi z
                              %mn 2
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msubsup
                              %mi z
                              %mn 1
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 2
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ∂
                              %mrow
