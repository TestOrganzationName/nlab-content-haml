                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            yields
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ×
                    %mrow
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi G
                    %mi k
                  %mo ≃
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Spec(K)\times_{Spec (k)} G_k \simeq G
                  \\,.
          %p
            Typically one requires that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is also defined over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-ification" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "-form." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %h2#examples Examples
          %h3#MultiplicativeAndCircleGroup Multiplicative group and circle group
          %p
            Consider the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo ↪
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{R} \hookrightarrow \mathbb{C}
            of the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            into the
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %msub
                    %mi 𝔾
                    %mi m
                  %mo =
                  %msup
                    %mi ℂ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} G = \mathbb{G}_m = \mathbb{C}^\times
            be the
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative group
            hence the
            %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
          %p
            Then one
            = succeed "-form," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/real+form"} real form
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔾
                    %mi m
                %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
            is given by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^\times
            %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo =
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S^1 = U(1)
          %p
            To see this, realize
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℂ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \mathbb{C}^\times
            as the group of 2x2
            %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
            with entries in the
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            which are diagonal and of unit
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mi y
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi with
                  %mspace{:width => "thickmathspace"}
                  %mi x
                  %mi y
                  %mo =
                  %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\array{
                  x &amp; 0
                  \\\
                  0 &amp; y
                  }
                  \\right)
                  \\;\;\; with
                  \\;
                  x y = 1
                  \\,.
          %p
            The same prescription over the real numbers yields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^\times
            and exhibits it as a real form of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^\times
          %p On the other hand, realize the circle group as the group of 2x2 real matrices of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mi y
                        %mtr
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi y
                          %mtd
                            %mi x
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi with
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi x
                    %mn 2
                  %mo +
                  %msup
                    %mi y
                    %mn 2
                  %mo =
                  %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\array{
                  x &amp; y
                  \\\
                  \-y &amp; x
                  }
                  \\right)
                  \\;\;\;\;\;
                  with
                  \\;
                  x^2 + y^2 = 1
                  \\,.
          %p
            One checks that over the complex numbers this is isomorphic to the previous group of diagonal matrices, with the
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            being given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mi y
                        %mtr
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi y
                          %mtd
                            %mi x
                    %mo )
                  %mo ↦
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi x
                            %mo +
                            %mi i
                            %mi y
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mi x
                            %mo −
                            %mi i
                            %mi y
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\array{
                  x &amp; y
                  \\\
                  \-y &amp; x
                  }
                  \\right)
                  \\mapsto
                  \\left(
                  \\array{
                  x + i y &amp; 0
                  \\\
                  0 &amp; x- i y
                  }
                  \\right)
                  \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#eom"} eom
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/relation+between+compact+Lie+groups+and+reductive+algebraic+groups"} relation between compact Lie groups and reductive algebraic groups
          %h2#references References
          %ul
            %li
              %p
                David Herzog,
                = succeed "," do
                  %em Forms of algebraic groups
                = succeed "," do
                  %a{:href => "http://www.jstor.org/stable/2034264"} JSTOR
