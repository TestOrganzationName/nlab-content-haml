          %h2#definition Definition
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 4
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 4n
