          %hr/
          %h1#20090331 2009-03-31
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs
                \:
              %ul
                %li
                  %p
                    started adding comments on embeddings at
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
                %li
                  %p
                    following
                    = succeed "\u2018s" do
                      %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} Mike
                    %a.existingWikiWord{:href => "/nlab/show/sheafification+in+a+Lawvere-Tierney+topos"} sheafification in a Lawvere-Tierney topos
                    over to
                    %a.existingWikiWord{:href => "/nlab/show/Lawvere-Tierney+topology"} Lawvere-Tierney topology
                %li
                  %p
                    have (started) a discussion with
                    %a.existingWikiWord{:href => "/nlab/show/David+Roberts"} David Roberts
                    on the relation between internal
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/anafunctor"} anafunctor
                    %a.existingWikiWord{:href => "/davidroberts/show/comments+on+chapter+2"} comments on chapter 2
                %li
                  %p
                    incorporated in part
                    = succeed "\u2018s" do
                      %a.existingWikiWord{:href => "/nlab/show/Zoran+Skoda"} Zoran
                    %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
                    of non-set-valued presheaves and created an entry on the
                    %a.existingWikiWord{:href => "/nlab/show/IPC-property"} IPC-property
                    in the course of that
                %li
                  %p
                    started
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/Sheaves+in+Geometry+and+Logic"} Sheaves in Geometry and Logic
                %li
                  %p
                    created
                    %a.existingWikiWord{:href => "/nlab/show/dense+monomorphism"} dense monomorphism
                    (thanks to
                    %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} Mike
                    for the relation to
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/local+isomorphism"} local isomorphism
                    %a.existingWikiWord{:href => "/nlab/show/sheafification+in+a+Lawvere-Tierney+topos"} sheafification in a Lawvere-Tierney topos
                %li
                  %p
                    created
                    %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-essentially+surjective+functor"} (infinity,1)-essentially surjective functor
                    and
                    %span.newWikiWord
                      (infinity,1)-fully faithful functor
                      %a{:href => "/nlab/new/%28infinity%2C1%29-fully+faithful+functor"} ?
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike
                \:
              %ul
                %li
                  %p
                    Mentioned at
                    %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
                    that the definition is redundant. If I had time I would fix it myself.
                %li
                  %p
                    We are having an interesting discussion at
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
                    = succeed ")" do
                      %a{:href => "http://www.cheng.staff.shef.ac.uk/pssl88/"} PSSL88
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs
                \:
              %ul
                %li
                  %p
                    created
                    %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
                    and
                    %a.existingWikiWord{:href => "/nlab/show/presheaf+on+open+subsets"} presheaf on open subsets
                    to satisfy links at
                    %a.existingWikiWord{:href => "/nlab/show/Categories+and+Sheaves"} Categories and Sheaves
                %li
                  %p
                    fixed and expanded
                    %a.existingWikiWord{:href => "/nlab/show/local+isomorphism"} local isomorphism
                    and used that to create
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
                    %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+of+%28infinity%2C1%29-sheaves"} (infinity,1)-category of (infinity,1)-sheaves
                    and
                    %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
                %li
                  %p
                    created
                    %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
                    and
                    %a.existingWikiWord{:href => "/nlab/show/cobase+change"} cobase change
                %li
                  %p
                    started listing
                    = succeed "\u2018s" do
                      %a.existingWikiWord{:href => "/nlab/show/Zoran+Skoda"} Zoran
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/additive+and+abelian+categories"} additive and abelian categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"}> Tim
                \:
              %ul
                %li
                  Last night I continued my ‘lexicon’ with an entry on
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/differential+graded+vector+space"} differential graded vector space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Zoran+%C5%A0koda"}> Zoran Škoda
                \: Created
                %a.existingWikiWord{:href => "/nlab/show/suspended+category"} suspended category
                and
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+exact+category"} Quillen exact category
          %h1#20090330 2009-03-30
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Roberts"}> David Roberts
                \:
              %ul
                %li
                  Asked question about Grothendieck’s tame topology at
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/nice+topological+space"} nice topological space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs
                \:
              %ul
                %li
                  %p
                    QUESTION: came across MacLane’s
                    %em Foundations for Categories and Sets
                    where it it argued that neither standared set/class set theory nor
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/Grothendieck+universe"} Grothendieck universe
                    %em schools
                    is introduced instead – can anyone comment on that in the light of our discussion at
                    = succeed "?" do
                      %a.existingWikiWord{:href => "/nlab/show/Grothendieck+universe"} Grothendieck universe
                %li
                  %p
                    added an “Idea” section to
                    %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
                    and split off
                    %a.existingWikiWord{:href => "/nlab/show/derived+functor+on+a+derived+category"} derived functor on a derived category
                    from that in order to discuss the special homological algebra aspects of derived functors separately – but incomplete for the moment
                %li
                  %p
                    created
                    %a.existingWikiWord{:href => "/nlab/show/null+system"} null system
                %li
                  %p
                    created
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
                %li
                  %p
                    agreed at
                    %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
                    and
                    %a.existingWikiWord{:href => "/nlab/show/filtrant+category"} filtrant category
                %li
                  %p
                    created
                    %a.existingWikiWord{:href => "/nlab/show/homology"} homology
                %li
                  %p
                    expanded
                    %a.existingWikiWord{:href => "/nlab/show/differential+object"} differential object
                    and created
                    %a.existingWikiWord{:href => "/nlab/show/differential"} differential
                    just to satisfy links
                %li
                  %p
                    created
                    %a.existingWikiWord{:href => "/nlab/show/matrix+calculus"} matrix calculus
                    and
                    %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"}> Tim
                \:
              %ul
                %li
                  I have tried to edit
                  %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
                  somewhat along the lines that my query suggested but taking in ideas from
                  %a.existingWikiWord{:href => "/nlab/show/Zoran+%C5%A0koda"} Zoran's
                  query at that entry.
                %li
                  I have added some background material on
