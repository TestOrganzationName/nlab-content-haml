            is a formal
            %a.existingWikiWord{:href => "/nlab/show/Laurent+series"} Laurent series
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo ≥
                      %mi m
                  %msub
                    %mi a
                    %mi k
                  %msup
                    %mi t
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} /
                      %mi r
                  %mspace{:width => "2em"}
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(t) = \sum_{k \geq m} a_k t^{k/r} \qquad (1)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            is a positive
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            is an integer, and each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi k
                %annotation{:encoding => "application/x-tex"} a_k
            belongs to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℕ
                    %mo ⋅
                %annotation{:encoding => "application/x-tex"} \mathbb{N}_{\cdot}
            is the
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            of positive integers ordered by divisibility (so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is the least element), then the field of Puiseux series is the
            %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
            of the diagram of fields
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msub
                    %mi ℕ
                    %mo ⋅
                  %mo →
                  %mi Field
                %annotation{:encoding => "application/x-tex"} F: \mathbb{N}_{\cdot} \to Field
          %p
            where each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(n)
            is the field of
            %a.existingWikiWord{:href => "/nlab/show/Laurent+series"} Laurent series
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K((t))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(m) \to F(n)
            (in case
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:stretchy => "false"} |
                    %mi n
                  %annotation{:encoding => "application/x-tex"} m|n
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(t)
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi t
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} /
                        %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(t^{n/m})
          %p
            The field of Puiseux series carries a
            %a.existingWikiWord{:href => "/nlab/show/valuation+ring"} valuation
            whose values are in the ordered group of
            %a.existingWikiWord{:href => "/nlab/show/rational+number"} rationals
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℚ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{Q}, +)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(t)
            as in (1),
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} v(f)
            is the least exponent
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} /
                  %mi r
                %annotation{:encoding => "application/x-tex"} k/r
            for which
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi k
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a_k \neq 0
          %h2#puiseuxnewton_expansions Puiseux-Newton expansions
          %p
            Puiseux series were in essence considered by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Isaac+Newton"} Isaac Newton
            %a.existingWikiWord{:href => "/nlab/show/Newton%27s+method"} Newton's method
            of approximating roots. Here is a sample theorem:
          #Puiseux.num_theorem
            %h6#theorem Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is
              %a.existingWikiWord{:href => "/nlab/show/algebraically+closed+field"} algebraically closed
              and has
              %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
              0, then the field of Puiseux series over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is the algebraic closure of the field of Laurent series over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
          .proof
            %h6#proof_sketch Proof (sketch)
            %p
              It is enough to show that every degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              of the field of Laurent series
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K((x))
              is of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mi n
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K((x^{1/n}))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} K[ [x] ]
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi x
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mi n
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} K[ [x^{1/n}] ]
            %p
              Generally speaking, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be a complete DVR (
              %a.existingWikiWord{:href => "/nlab/show/valuation+ring"}> discrete valuation ring
              ) with maximal ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔪
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}_A
              and residue class field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mi A
                    %annotation{:encoding => "application/x-tex"} k_A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              be its field of fractions. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be a degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              extension of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              be the integral closure of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is also a complete DVR. We may write the ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔪
                      %mi A
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}_A B
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔪
                      %mi B
                      %mi e
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}_B^e
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              is the
              = succeed "," do
                %em ramification index
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %msub
                      %mi deg
                      %mi F
                    %mi E
                    %mo =
                    %msub
                      %mi rank
                      %mi A
                    %mi B
                    %mo =
                    %msub
                      %mi rank
                      %mrow
                        %mi A
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi 𝔪
                          %mi A
                    %mi B
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi 𝔪
                      %mi A
                    %mi B
                    %mo =
                    %msub
                      %mi dim
                      %mrow
                        %msub
                          %mi k
                          %mi A
                    %mi B
                    %mo{:stretchy => "false"} /
                    %msubsup
                      %mi 𝔪
                      %mi B
                      %mi e
                    %mo =
                    %mi e
                    %mo ⋅
                    %msub
                      %mi dim
                      %mrow
                        %msub
                          %mi k
                          %mi A
                    %msub
                      %mi k
                      %mi B
                  %annotation{:encoding => "application/x-tex"} n = deg_F E = rank_A B = rank_{A/\mathfrak{m}_A} B/\mathfrak{m}_A B = dim_{k_A} B/\mathfrak{m}_B^e = e \cdot dim_{k_A} k_B
            %p
              where the last equation holds because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔪
                      %mi B
                      %mi i
                    %mo{:stretchy => "false"} /
                    %msubsup
                      %mi 𝔪
                      %mi B
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                    %mo ≅
                    %msub
                      %mi k
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}_B^i/\mathfrak{m}_B^{i+1} \cong k_B
              as
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mi B
                    %annotation{:encoding => "application/x-tex"} k_B
              = succeed "-modules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mi A
                    %annotation{:encoding => "application/x-tex"} k_A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi K
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A = K[ [x] ]
              where
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mi A
                      %mo =
                      %mi K
                    %annotation{:encoding => "application/x-tex"} k_A = K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dim
                      %mrow
                        %msub
                          %mi k
                          %mi A
                    %msub
                      %mi k
                      %mi B
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} dim_{k_A} k_B = 1
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is algebraically closed, and therefore
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo =
                      %mi n
                    %annotation{:encoding => "application/x-tex"} e = n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mi B
                      %mo =
                      %msubsup
                        %mi 𝔪
                        %mi B
                        %mi n
                    %annotation{:encoding => "application/x-tex"} (x)B = \mathfrak{m}_B^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi u
                    %msup
                      %mi π
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x = u \pi^n
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              generates the maximal ideal of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              is a unit of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %p
              The residue class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ¯
                    %mo ∈
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \bar{u} \in K
              has an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi n
                      %mi th
                  %annotation{:encoding => "application/x-tex"} n^{th}
              root (again by algebraic closure); in fact a simple root since
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi char
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} char(K) = 0
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hensel%27s+lemma"} Hensel's lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi n
                      %mi th
                  %annotation{:encoding => "application/x-tex"} n^{th}
              root of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi n
                    %mi π
                  %annotation{:encoding => "application/x-tex"} u^{1/n} \pi
              is thus an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi n
                      %mi th
                  %annotation{:encoding => "application/x-tex"} n^{th}
              root of
              = succeed "," do
