                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} String_S(X) \simeq \mathbf{H}(X, \mathbf{B}^2 U(1))
                %p
                  In particular the set of
                  = succeed "es" do
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
                  set
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 0
                        %msub
                          %mi String
                          %mi S
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msup
                          %mi H
                          %mn 3
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\pi_0 String_S(X) \simeq H^3(X, \mathbb{Z})
                        \\,.
          .proof
            %h6#proof_2 Proof
            %p
              Apply the
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              for
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
