                          %mtd
                            %mo →
                          %mtd
                            %mi B
                            %mi Spin
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    String &amp;\to&amp; \hat P &amp;\to&amp; {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    Spin &amp;\to&amp; P &amp;\to&amp;  B^2 U(1) &amp;\to&amp; {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    {*} &amp;\to&amp; X &amp;\to&amp; B String(n) &amp;\to&amp; B Spin(n)
                    }
            %p
              This uses repeatedly the
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              for
              = succeed "-pullbacks." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %msup
                      %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P \to B^2 U(1)
              appears by decomposing the homotopy pullback of the point along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi B
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to B Spin(n)
              into a homotopy pullback first along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi String
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B String(n) \to B Spin(n)
              and then along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi B
                    %mi String
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to B String(n)
              using the given String structure. This is the
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              for a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
              on the total space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              of the
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                    %annotation{:encoding => "application/x-tex"} Spin
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            %p The rest of the diagram is constructed in order to prove the following:
            %ul
              %li
                The class in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 3
                      %mo{:stretchy => "false"} (
