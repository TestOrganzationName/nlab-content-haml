                    String(X) &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{H}(X, \mathbf{B}Spin(n))
                    \&amp;\stackrel{\frac{1}{2}\mathbf{p}_1}{\to}&amp;
                    \\mathbf{H}(X, \mathbf{B}^3 U(1))
                    }
                    \\,.
          .proof
            %h6#proof Proof
            %p
              By definition of the
              %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
              we have the
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi String
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi Spin
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mrow
                            %msub
                              %mi p
                              %mn 1
                        %mfrac
                          %mn 1
                          %mn 2
                      %mo →
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mn 3
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B} String \to \mathbf{B}Spin \stackrel{\frac{1}{2}} \mathbf{p_1}{\to} \mathbf{B}^3 U(1)
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,-)
              preserves every
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
          #FiberOverSpinStructure.num_defn
            %h6#definition_3 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S : X \to \mathbf{B} Spin(n)
              we say that the
              %strong string structures extending this spin-structure
              is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi String
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} String_S(X)
              of the projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi String
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} String(X) \to Spin(X)
              from observation
              = succeed ":" do
                %a.maruku-ref{:href => "#StringStructuresAsObstructions"}
          %h3#twisted_and_differential_string_structures Twisted and differential string structures
          %p (…)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            of string structures is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo :
                  %mi Top
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℬ
                  %mi Spin
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Top
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mi ℬ
                    %mn 4
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{2}p_1 : Top(X, \mathcal{B}Spin) \to Top(X, \mathcal{B}^4 \mathbb{Z})
          %p
            over the trivial cocycle. Followowing the general logic of
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            the 2-groupoids over a nontrivial cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %mi X
                  %mo →
                  %msup
                    %mi ℬ
                    %mn 4
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} c : X \to \mathcal{B}^4 \mathbb{Z}
            may be thought of as that of
            %em twisted
            string structures.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \frac{1}{2}p_1
            refines to the
            %a.existingWikiWord{:href => "/nlab/show/smooth+first+fractional+Pontryagin+class"} smooth first fractional Pontryagin class
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mn 1
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Spin
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \frac{1}{2}\mathbf{p}_1 : \mathbf{B}Spin \to \mathbf{B}^3 U(1)
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/differential+string+structure"} differential string structure
          %p (…)
          %h2#properties Properties
          %h3#choices_of_string_structures Choices of string structures
          #ChoicesOfSpinStructures.num_prop
            %h6#observation_2 Observation
            %p
              The space of choices of string structures extending a given spin structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              are as follows
            %ul
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mfrac
                          %mn 1
                          %mn 2
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi p
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                        %mo ≠
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} [\frac{1}{2}\mathbf{p}_1(S)] \neq 0
                  it is empty:
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi String
                            %mi S
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} String_S(X) \simeq \emptyset
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mfrac
                          %mn 1
                          %mn 2
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi p
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} [\frac{1}{2}\mathbf{p}_1(S)] = 0
                  it is
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi String
                            %mi S
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi X
