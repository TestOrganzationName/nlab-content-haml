            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            with
            %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
            given by a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Spin+group"} Spin group
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            to which the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            is
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
            is a lift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi g
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat g
            of the classifying map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi X
                  %mo →
                  %mi ℬ
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g : X \to \mathcal{B} Spin(n)
            through the third nontrivial step
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                  %mi String
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℬ
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{B}String(n) \to \mathcal{B}Spin(n)
            in the
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} Whitehead tower
            of
            %a.existingWikiWord{:href => "/nlab/show/BO%28n%29"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
