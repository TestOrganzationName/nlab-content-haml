                  %mo ,
                  %mi π
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\pi)
            a Poisson vector space, hence a
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi V
                %annotation{:encoding => "application/x-tex"} X = V
            equipped with a constant (translating invariant)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bivector"} Poisson bivector
            %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
            yields the
            %a.existingWikiWord{:href => "/nlab/show/Moyal+quantization"} Moyal quantization
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
