                  %annotation{:encoding => "application/x-tex"} X/\mathcal{F}
          %p
            (
            %a{:href => "#EH"}> EH, example 6.1
            )
          %h3#MoyalQuantizationofPoissonVectorSpace Moyal quantization of Poisson vector space
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
