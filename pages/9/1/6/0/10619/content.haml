            %p Under the given assumption the two outermost morphisms shown are zero, and hence the sequence truncates as claimed.
            %p
          %h3#TheDiagrammaticEInvariant The refined e-invariant
          %p
          #EFluxesAreCocycleInCofiberTheory.num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be a
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ,
                      %mi d
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n,d \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              that sends
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              consisting of
            %ol
              %li
                %p
                  the stable class
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                        %msubsup
                          %mi G
                          %mi n
                          %mi 𝕊
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                      %annotation{:encoding => "application/x-tex"} \big[ G^{\mathbb{S}}_n (c) \big]
                  of a map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo +
                            %mi d
                            %mo −
                            %mn 1
                        %mover
                          %mo ⟶
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %mi c
                            %mspace{:width => "thickmathspace"}
                        %msup
                          %mi S
                          %mi n
                      %annotation{:encoding => "application/x-tex"} S^{n+d-1} \overset{\;c\;}{\longrightarrow} S^n
              %li
                %p
                  the class of a trivialization
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi H
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                          %mi E
                        %mspace{:width => "negativethinmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H^E_{n-1}\!(c)
                  of its
                  %a.existingWikiWord{:href => "/nlab/show/d-invariant"} d-invariant
                  in
                  = succeed "-cohomology" do
