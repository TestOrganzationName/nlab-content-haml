            a map out of an
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/odd+integer"} odd
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
            %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi KU
                %annotation{:encoding => "application/x-tex"} E = KU
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+topological+K-theory"} complex topological K-theory
          %p
            %br/
          %h3#AsAnExtensionOfAdamsOperationModules As an extension of generalized Adams-operation modules
          #EInvariantAsExtensionClassInECohomology.num_defn
            %h6#definition_2 Definition
            %p
              %strong (e-invariant as extension class in E-cohomology)
            %p
              Writing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi f
                  %annotation{:encoding => "application/x-tex"} C_f
              for the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Y
                    %mover
                      %mo ⟶
                      %mrow
                    %msub
                      %mi C
                      %mi f
                    %mover
                      %mo ⟶
                      %mrow
                    %mi Σ
                    %mi X
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    X
                    \\overset{f}{\longrightarrow}
                    Y
                    \\overset{}{\longrightarrow}
                    C_f
                    \\overset{}{\longrightarrow}
                    \\Sigma X
                    \\to
                    \\cdots
                    \\,,
            %p
              this implies that the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+in+cohomology"} long exact sequence in cohomology
              corresponding to the pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi C
                      %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y, C_f)
              truncates to a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of the form
            #eq:TheShortExactSequenceInETheory.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi f
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    E^\bullet(\Sigma X)
                    \\overset{}{\longrightarrow}
                    E^\bullet(C_f)
                    \\overset{}{\longrightarrow}
                    E^\bullet(Y)
                    \\to
                    0
                    \\,.
            %p
              This is hence an
              %a.existingWikiWord{:href => "/nlab/show/algebra+extension"} extension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^\bullet(Y)
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^\bullet(\Sigma X)
              in any
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              in which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/E-Steenrod+algebra"} E-Steenrod algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi KU
                  %annotation{:encoding => "application/x-tex"} E = KU
              take the category of
              %a.existingWikiWord{:href => "/nlab/show/graded+abelian+groups"} graded abelian groups
              equipped with
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Adams+operations"} Adams operations
            %p
              Thus this short exact sequence defines an element in the
              %a.existingWikiWord{:href => "/nlab/show/Ext+group"} Ext group
              formed in this category
            #eq:GeneraleInvariantAsElementOfExtGroup.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    e(f)
                    \\;\in\;
                    Ext^1\big(
                    E^\bullet(Y),
                    \\,
                    E^\bullet(\Sigma X)
                    \\big)
            %p
              and this is the
              %em e-invariant
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              seen in
              = succeed "-theory." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
          %p
            (
            %a{:href => "#Adams66"}> Adams 66, Section 3, p. 27
            , review includes
            = succeed ")." do
              %a{:href => "#BL09"} BL 09, Sec. 2
          %p
            %br/
          %h2#for_
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi KU
                %annotation{:encoding => "application/x-tex"} E = KU
          %h3#AsAnExtensionOfComplexTopologicalKTheoryWithAdamsOperations As an extension of K-groups with Adams operations
          %p
            We discuss this in more detail for the case of
            %a.existingWikiWord{:href => "/nlab/show/complex+topological+K-theory"} complex topological K-theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi KU
                  %annotation{:encoding => "application/x-tex"} E = KU
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mo •
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mn 1
                  %mo →
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi n
                %annotation{:encoding => "application/x-tex"} f \;\colon\; S^{2(n + \bullet)-1} \to S^{2n}
            a map between
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/spheres"} spheres
            %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational number
            %a.existingWikiWord{:href => "/nlab/show/modulo"} modulo
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/Q%2FZ"} Q/Z
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mi ℂ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi π
                    %mo •
                    %mi s
                  %mover
                    %mo ⟶
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %mi ℚ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  e_{\mathbb{C}}
                  \\;\colon\;
                  \\pi^s_{\bullet}
                  \\overset{\;\;\;\;\;}{\longrightarrow}
                  \\mathbb{Q}/\mathbb{Z}
          %p
            on
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
            (Def.
            %a.maruku-ref{:href => "#eInvariantInComplexTopologicalKtheoryAsRationalNumberModuloIntegers"}
            below).
          %p
            We follow
            = succeed "." do
              %a{:href => "#HopkinsMathew12"} Hopkins-Mathew 12, Lecture 11
          %p
            %br/
          %h4#abelian_groups_with_adams_operations Abelian groups with Adams operations
          #AbelianGroupWithAdamsOperations.num_defn
            %h6#definition_3 Definition
            %p
              %strong (abelian group with Adams operations)
            %p
              We say that an
              %em abelian group with Adams operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi A
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi ψ
                      %mi A
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \big(A,\{\psi_A^k\}_{k \in \mathbb{N}}\big)
              is an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              equipped with an
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo ,
                    %mo ⋅
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{N}, \cdot)
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphisms"} group homomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ψ
                      %mi A
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo →
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext for all
                    %mspace{:width => "thickmathspace"}
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    \\psi_A^k \;\colon\; A \to A
                    \\,,
                    \\;\;\;\;\;\;\;
                    \\text{for all}
                    \\;
                    k \in \mathbb{N}
            %p such that
            #eq:ActionPropertyOfAbstractAdamsOperations.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ψ
                      %mi A
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                    %mo ∘
                    %msubsup
                      %mi ψ
                      %mi A
                      %mrow
                        %msub
                          %mi k
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi ψ
                      %mi A
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                        %mo ⋅
                        %msub
                          %mi k
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext for all
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi k
                      %mn 1
                    %mo ,
                    %msub
                      %mi k
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi ℕ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\psi_A^{k_1}
                    \\circ
                    \\psi_A^{k_2}
                    \\;=\;
                    \\psi_A^{ k_1 \cdot k_2 }
                    \\,,
                    \\;\;\;\;\;\;\;\;\;
                    \\text{for all}
                    \\;
                    k_1, k_2 \,\in\, \mathbb{N}
                    \\,.
            %p
              Moreover, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi A
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi ψ
                      %mi A
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi A
                    %mo ′
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi ψ
                      %mrow
                        %mi A
                        %mo ′
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \big(A,\{\psi_A^k\}_{k \in \mathbb{N}}\big), \, \big(A',\{\psi_{A'}^k\}_{k \in \mathbb{N}}\big)
              two abelian groups with Adams operations, a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              between them is a
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
              (a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo →
                    %mi A
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \phi \;\colon\; A \to A'
              that respects these operations, hence such that the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+square"} squares commute
            #eq:HomomorphismOfAbelianGroupsWithAdamsOperations.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mi ϕ
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi A
                            %mo ′
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msubsup
                                    %mi ψ
                                    %mi A
                                    %mi k
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi ψ
                                    %mrow
                                      %mi A
                                      %mo ′
                                    %mi k
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mi ϕ
                                %mspace{:width => "thickmathspace"}
