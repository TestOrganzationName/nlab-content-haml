          %p
          #DiagrammaticecInvariantTakesIntegerLattiveValues.num_lemma
            %h6 Lemma
            %p
              The values of the refined e-invariant from Def.
              %a.maruku-ref{:href => "#LiftedEInvariantDiagrammatically"}
              for fixed
              %a.existingWikiWord{:href => "/nlab/show/Cohomotopy"} Cohomotopy
              class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi c
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [c]
              form an integer lattice inside the rational numbers:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi e
                        %mo ^
                      %mi{:mathvariant => "normal"} KU
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:stretchy => "false"} [
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msubsup
                      %mi H
                      %mrow
                        %mn 2
                        %mi d
                        %mo −
                        %mn 1
                      %mi{:mathvariant => "normal"} KU
                    %mspace{:width => "negativethinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mo −
                    %msub
                      %mover
                        %mi e
                        %mo ^
                      %mi{:mathvariant => "normal"} KU
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:stretchy => "false"} [
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msup
                      %mi H
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %msubsup
                      %mrow
                      %mrow
                        %mn 2
                        %mi d
                        %mo −
                        %mn 1
                      %mi{:mathvariant => "normal"} KU
                    %mspace{:width => "negativethinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat e_{\mathrm{KU}}
                    \\Big(
                    [c],
                    \\big[
                    H^{\mathrm{KU}}_{2d-1}\!(c)
                    \\big]
                    \\Big)
                    \-
                    \\widehat e_{\mathrm{KU}}
                    \\Big(
                    [c],
                    \\big[
                    {H}^\prime{}^{\mathrm{KU}}_{2d-1}\!(c)
                    \\big]
                    \\Big)
                    \\;\in\;
                    \\mathbb{Z}
            %p
