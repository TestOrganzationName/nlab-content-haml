            %p
              equipped with a homotopy from its image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                  %annotation{:encoding => "application/x-tex"} \partial
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
            %p This implies the claim, by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mi Maps
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %msup
                      %mi Σ
                      %mrow
                        %mi n
                        %mo +
                        %mi d
                        %mo −
                        %mn 1
                    %mi 𝕊
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi Σ
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi 𝕊
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi d
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0
                    Maps
                    \\Big(
                    \\Sigma^{n+d - 1}\mathbb{S}
                    \\,,\,
                    \\Sigma^{n-1} (E/\mathbb{S})
                    \\Big)
                    \\;\simeq\;
                    (E/\mathbb{S})_{d}
                    \\,.
            %p
              %br/
            %p
              %strong Second,
              to see that this map is realized as claimed (the following construction is close to the proof of
              = succeed "):" do
                %a{:href => "MUFr#ConnerFloyd66"} Conner-Floyd 66, Theorem 16.2
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mi d
                        %mo −
                        %mn 1
                    %mover
                      %mo ⟶
                      %mi c
                    %msup
                      %mi S
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi π
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mi d
                        %mo −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \big[ S^{n + d - 1} \overset{c}{\longrightarrow} S^{n} \big] \;\in\; \pi^n\big(S^{n+d-1}\big)
              be a given class in Cohomotopy. We need to produce a map of the form
            %svg{:height => "104.872", :viewbox => "0 0 184.91 104.872", :width => "184.91", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
