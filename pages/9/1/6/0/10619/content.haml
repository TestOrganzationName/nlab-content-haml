                            %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    0
                    \\to
                    \&amp;
                    \\Omega^U_{\bullet+1}
                    \&amp;
                    \\overset{i}{\longrightarrow}
                    \&amp;
                    \\Omega^{U,fr}_{\bullet+1}
                    \&amp;
                    \\overset{\partial}{
                    \\longrightarrow
                    }
                    \&amp;
