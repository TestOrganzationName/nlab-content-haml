                                %mi U
                                %mo ,
                                %mi fr
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ∂
                          %mtd
                            %msubsup
                              %mi Ω
                              %mo •
                              %mi fr
                          %mtd
                            %mo ≃
                          %mtd
                            %msubsup
                              %mi π
                              %mo •
                              %mi s
                        %mtr
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mi Td
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mi Td
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mrow
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mi e
                        %mtr
                          %mtd
                            %mn 0
                            %mo →
                          %mtd
                            %mi ℤ
                          %mtd
                            %mover
                              %mo ↪
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi ℚ
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mspace{:width => "thickmathspace"}
