            %li
              %p
                The rear morphisms are pushforward along the projection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi i
                      %mi E
                      %mo{:stretchy => "false"} /
                      %mi 𝕊
                    %annotation{:encoding => "application/x-tex"} E \xrightarrow{i} E/\mathbb{S}
                = succeed "and" do
                  %br/
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
