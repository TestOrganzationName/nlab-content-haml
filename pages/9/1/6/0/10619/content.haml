                                %mi k
                                %mrow
                                  %mi n
                                  %mo +
                                  %mi n
                                  %mo ′
                            %mtd
                              %mo ⋅
                            %mtd
                              %mi ch
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi V
                                %mrow
                                  %mn 2
                                  %mo{:stretchy => "false"} (
                                  %mi n
                                  %mo +
                                  %mi n
                                  %mo ′
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mi ev
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi C
                      %mi f
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mi n
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi C
                      %mi f
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\psi^k_H
                    \\;\;\colon\;\;
                    \\left\{
                    \\array{
                    ch
                    \\big(
                    V_{2 n}
                    \\big)
                    \-
                    e(f)
                    \\cdot
                    ch
                    \\big(
                    V_{2(n + n')}
                    \\big)
                    \&amp;
                    \\mapsto
                    \&amp;
                    k^{n }
                    \&amp;
                    \\cdot
                    \&amp;
                    \\big(
                    ch
                    (
                    V_{2 n}
                    )
                    \-
                    e(f)
                    \\cdot
                    ch
                    (
                    V_{2(n + n')}
                    )
                    \\big)
                    \\\
                    ch
                    (
                    V_{2(n+n')}
                    )
                    \&amp;
                    \\mapsto
                    \&amp;
                    k^{n + n'}
                    \&amp;
                    \\cdot
                    \&amp;
                    ch
                    (
                    V_{2 (n + n')}
                    )
                    }
                    \\right.
                    \\;\;\;\;
                    \\in
                    \\;
                    H^{ev}\big( C_f; \, \mathbb{Q} \big)/H^{2(n+n')}\big( C_f; \, \mathbb{Z} \big)
                    \\,.
            %p
              Here, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mrow
                        %mn 2
                        %mi n
                  %annotation{:encoding => "application/x-tex"} V_{2n}
              is well defined modulo addition
              %a.maruku-eqref{:href => "#eq:DependenceOfDegree2nGeneratorOnChoiceOfSplitting"} (12)
              of integral multiples of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mrow
                          %mn 2
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mi n
                          %mo ′
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V_{2(n+n')}
            #eq:ChernCharacterOnCofiverSpaceOfGeneratorofTopCell.maruku-equation
              %span.maruku-eq-number (16)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ch
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi V
                      %mrow
                        %mn 2
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mi n
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mi n
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi C
                      %mi f
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    ch\big( V_{2(n+n')} \big)
                    \\;=\;
                    1
                    \\,\in\,
                    \\mathbb{Z}
                    \\,\simeq\,
                    H^{2(n+n')}\big( C_f;\, \mathbb{Z} \big)
                    \\,,
            %p
              this expression
              %a.maruku-eqref{:href => "#eq:EigenvectorsOfAdamsOperationsAfterPassageThroughChernCharacter"} (15)
              is well-defined in
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary
              %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational cohomology
              in even degrees
              %a.existingWikiWord{:href => "/nlab/show/modulo"} modulo
              %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
              in top degree.
            %p
              But since the
              %a.existingWikiWord{:href => "/nlab/show/eigenvectors"} eigenvectors
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ψ
                      %mi H
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \psi^k_H
              to
              %a.existingWikiWord{:href => "/nlab/show/eigenvalue"} eigenvalue
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi r
                  %annotation{:encoding => "application/x-tex"} k^r
              are precisely the ordinary cohomology classes in homogeneous degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi r
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi C
                      %mi f
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ⊂
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi H
                      %mi ev
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi C
                      %mi f
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} H^{2r}\big( C_f;\, \mathbb{Q} \big) \,\subset\, H^{ev}\big( C_f;\, \mathbb{Q} \big)
              (see
              = succeed ")," do
                %a{:href => "Adams+operations+compatible+with+the+Chern+character#eq:AdamsOperationOnOrdinaryCohomologyInDegree2r"} there
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ch
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi V
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mi ch
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi V
                            %mrow
                              %mn 2
                              %mi n
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo −
                          %mi e
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi ch
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi V
                            %mrow
                              %mn 2
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo +
                              %mi n
                              %mo ′
                              %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo ⏟
                      %mrow
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi H
                          %mrow
                            %mn 2
                            %mi n
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mi C
                          %mi f
                        %mo ;
                        %mspace{:width => "thinmathspace"}
                        %mi ℚ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mi e
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi ch
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi V
                            %mrow
                              %mn 2
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo +
                              %mi n
                              %mo ′
                              %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %mo ⏟
                      %mrow
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi H
                          %mrow
                            %mn 2
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo +
                            %mi n
                            %mo ′
                            %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mi C
                          %mi f
                        %mo ;
                        %mspace{:width => "thinmathspace"}
                        %mi ℚ
                        %mo{:stretchy => "false"} /
                        %mi ℤ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    ch
                    \\big(
                    V_{2n}
                    \\big)
                    \\;\;=\;\;
                    \\underset{
                    \\in \; H^{2n}\big( C_f; \, \mathbb{Q} \big)
                    }{
                    \\underbrace{
                    ch
                    \\big(
                    V_{2n}
                    \\big)
                    \-
                    e(f)
                    \\cdot
                    ch
                    \\big(
                    V_{2(n+n')}
                    \\big)
                    }
                    }
                    \\;+\;
                    \\underset{
                    \\in \; H^{2(n + n')}\big( C_f; \, \mathbb{Q}/\mathbb{Z} \big)
                    }{
                    \\underbrace{
                    e(f)
                    \\cdot
                    ch
                    \\big(
                    V_{2(n+n')}
                    \\big)
                    \\,.
                    }
                    }
            %p
              (See also
              = succeed ".)" do
                %a{:href => "#ConnerFloyd66"} Conner-Floyd 66, p. 100
            %p
              The evaluation of this cohomology class on the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+class"} fundamental class
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi f
                  %annotation{:encoding => "application/x-tex"} C_f
              picks out the
              %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ch
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi V
                        %mrow
                          %mn 2
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mi n
                          %mo ′
                          %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} ch\big( V_{2(n+n')} \big)
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:ChernCharacterOnCofiverSpaceOfGeneratorofTopCell"} (16)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msub
                          %mi C
                          %mi f
                    %mi ch
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi V
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi e
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi ℚ
                    %mo{:stretchy => "false"} /
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{C_f}
                    ch
                    \\big(
                    V_{2n}
                    \\big)
                    \\;=\;
                    e(f)
                    \\;\;\;
                    \\in
                    \\;
                    \\mathbb{Q}/\mathbb{Z}
                    \\,,
            %p and hence the claim follows.
          %p
          #eRInvariantIsNotInGeneralTopDegreeChernCharacter.num_remark
            %h6 Remark
            %p
              The analogue statement of Prop.
              %a.maruku-ref{:href => "#QModZValuedEInvariantIsTopDegreeCoefficientOfChernCharacterOnCofiberSpace"}
              for the
              = succeed "-invariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi ℝ
                    %annotation{:encoding => "application/x-tex"} e_{\mathbb{R}}
              = succeed ")" do
                %a.maruku-ref{:href => "#eRInvariantInTermsOfAdamsOperations"}
              = succeed ":" do
                %em fail
            %p
              The
              = succeed "-invariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi ℝ
                    %annotation{:encoding => "application/x-tex"} e_{\mathbb{R}}
              = succeed ")" do
                %a.maruku-ref{:href => "#eRInvariantInTermsOfAdamsOperations"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              times the top degree coefficient of the
              %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mi{:mathvariant => "normal"} O
                    %mo →
                    %mi K
                    %mi{:mathvariant => "normal"} U
                  %annotation{:encoding => "application/x-tex"} K \mathrm{O} \to K \mathrm{U}
              (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+character"} Pontrjagin character
              = succeed "):" do
                %a{:href => "#Adams66"} Adams 66 (7.3)
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} c = 1
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mi n
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mspace{:width => "thinmathspace"}
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mi mod
                        %mspace{:width => "thinmathspace"}
                        %mn 8
                      %annotation{:encoding => "application/x-tex"} (n + n') = \,0\, mod \, 8
                  (here they coincide)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo =
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                      %annotation{:encoding => "application/x-tex"} c = \tfrac{1}{2}
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mi n
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mspace{:width => "thinmathspace"}
                        %mn 4
                        %mspace{:width => "thinmathspace"}
                        %mi mod
                        %mspace{:width => "thinmathspace"}
                        %mn 8
                      %annotation{:encoding => "application/x-tex"} (n + n') = \,4\, mod \, 8
                  (here the
                  = succeed "-invariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi e
                            %mi ℝ
                        %annotation{:encoding => "application/x-tex"} e_{\mathbb{R}}
            %p
              Similarly (
              %a{:href => "#Adams66"}> Adams 66 Prop. 7.14
              ):
            %ul
              %li
                %p
                  the
                  = succeed "-invariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi e
                            %mi ℝ
                        %annotation{:encoding => "application/x-tex"} e_{\mathbb{R}}
                  = succeed "-invariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi e
                            %mi ℂ
                        %annotation{:encoding => "application/x-tex"} e_{\mathbb{C}}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ′
                          %mo =
                          %mspace{:width => "thinmathspace"}
                          %mn 0
                          %mspace{:width => "thinmathspace"}
                          %mi mod
                          %mspace{:width => "thinmathspace"}
                          %mn 8
                        %annotation{:encoding => "application/x-tex"} n' = \,0\, mod \, 8
              %li
                %p
                  but equals
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msub
                          %mi e
                          %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \tfrac{1}{2}e_{\mathbb{C}}
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo +
                        %mi n
                        %mo ′
                        %mo =
                        %mspace{:width => "thinmathspace"}
                        %mn 4
                        %mspace{:width => "thinmathspace"}
                        %mi mod
                        %mspace{:width => "thinmathspace"}
                        %mn 8
                      %annotation{:encoding => "application/x-tex"} n + n' = \,4\, mod \, 8
                  \.
            %p
              This means that the
              = succeed "-invariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi ℝ
                    %annotation{:encoding => "application/x-tex"} e_{\mathbb{R}}
              %em finer
              than the
              = succeed "-invariant." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi ℂ
                    %annotation{:encoding => "application/x-tex"} e_{\mathbb{C}}
          %p
            %br/
          %h3#AsACobordismInvariantOfManifoldsWithBoundary As a cobordism invariant of U-manifolds with framed boundary
          %p
            We discuss how the
            %a.existingWikiWord{:href => "/nlab/show/e-invariant"} e-invariant
            in its
            = succeed "-incarnation" do
              %a.existingWikiWord{:href => "/nlab/show/Q%2FZ"} Q/Z
            = succeed ")" do
              %a.maruku-ref{:href => "#eInvariantInComplexTopologicalKtheoryAsRationalNumberModuloIntegers"}
            %a.existingWikiWord{:href => "/nlab/show/cobordism+theory"} cobordism theory
            (
            %a{:href => "#ConnerFloyd66"}> Conner-Floyd 66
            ).
          %p
            This is Prop.
            %a.maruku-ref{:href => "#EInvariantIsToddClassOnCoboundingUFrManifold"}
            below; but first to recall some background:
          .num_remark
            %h6#remark_2 Remark
            %p
              In generalization to how the
              %a.existingWikiWord{:href => "/nlab/show/U-bordism+ring"} U-bordism ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mrow
                        %mn 2
                        %mi k
                      %mi U
                  %annotation{:encoding => "application/x-tex"} \Omega^U_{2k}
              is
              %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} represented
              by
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
              of
              %a.existingWikiWord{:href => "/nlab/show/maps"} maps
              into the
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/MU"} MU
              %a.existingWikiWord{:href => "/nlab/show/%28U%2Cfr%29-bordism+ring"} (U,fr)-bordism ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mrow
                        %mn 2
                        %mi k
                      %mrow
                        %mi U
                        %mo ,
                        %mi fr
                  %annotation{:encoding => "application/x-tex"} \Omega^{U,fr}_{2k}
              is represented by maps into the
              %a.existingWikiWord{:href => "/nlab/show/quotient+spaces"} quotient spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi MU
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
                  %annotation{:encoding => "application/x-tex"} MU_{2k}/S^{2k}
              (for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
                    %mo =
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℂ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℂ
                      %mi k
                    %msub
                      %mo ×
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi MU
                      %mrow
                        %mn 2
                        %mi k
                  %annotation{:encoding => "application/x-tex"} S^{2k} = Th(\mathbb{C}^{k}) \to Th( \mathbb{C}^k \times_{U(k)} E U(k) ) = MU_{2k}
              the canonical inclusion):
            #eq:InTermsOfHomotopyGroupsOfQuotientedThomSpace.maruku-equation
              %span.maruku-eq-number (17)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mo •
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ,
                        %mi fr
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 2
                        %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi MU
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext for any
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %mi k
                    %mo ≥
                    %mo •
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{(U,fr)}_\bullet
                    \\;=\;
                    \\pi_{\bullet + 2k}
                    \\big(
                    MU_{2k}/S^{2k}
                    \\big)
                    \\,,
                    \\;\;\;\;\;
                    \\text{for any}
                    \\;
                    2k \geq \bullet + 2
                    \\,.
          %p
            (
            %a{:href => "#ConnerFloyd66"}> Conner-Floyd 66, p. 97
            )
          .num_remark
            %h6#remark_3 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/bordism+rings"} bordism rings
              for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/MU"} MU
              %a.existingWikiWord{:href => "/nlab/show/MUFr"} MUFr
              and
              %a.existingWikiWord{:href => "/nlab/show/MFr"} MFr
              sit in a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of the form
            #eq:ShortExactSequenceOfUFrBordismRings.maruku-equation
              %span.maruku-eq-number (18)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                      %mi U
                    %mover
                      %mo ⟶
                      %mi i
                    %msubsup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                      %mrow
                        %mi U
                        %mo ,
                        %mi fr
                    %mover
                      %mo ⟶
                      %mo ∂
                    %msubsup
                      %mi Ω
                      %mo •
                      %mi fr
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    \\Omega^U_{\bullet+1}
                    \\overset{i}{\longrightarrow}
                    \\Omega^{U,fr}_{\bullet+1}
                    \\overset{\partial}{
                    \\longrightarrow
                    }
                    \\Omega^{fr}_\bullet
                    \\to
                    0
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is the evident inclusion, while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                  %annotation{:encoding => "application/x-tex"} \partial
              is restriction to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            %p
              (By
              %a{:href => "MUFr#AShortExactSequenceOfUFrBordismRings"} this Prop.
              at
              = succeed ".)" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/MUFr"} MUFr
            %p
              In particular, this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                  %annotation{:encoding => "application/x-tex"} \partial
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/surjective+function"} surjective
              = succeed "-manifold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Fr
                    %annotation{:encoding => "application/x-tex"} Fr
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28U%2Cfr%29-manifold"} (U,fr)-manifold
          #EInvariantIsToddClassOnCoboundingUFrManifold.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/e-invariant+is+Todd+class+of+cobounding+%28U%2Cfr%29-manifold"}> e-invariant is Todd class of cobounding (U,fr)-manifold
                )
            %p
              Evaluation of the
              %a.existingWikiWord{:href => "/nlab/show/Todd+class"} Todd class
              on
              %a.existingWikiWord{:href => "/nlab/show/%28U%2Cfr%29-manifolds"} (U,fr)-manifolds
              yields
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              which are
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              on actual
              = succeed "-manifolds." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              %a.maruku-eqref{:href => "#eq:ShortExactSequenceOfUFrBordismRings"} (18)
              that assigning to
              = succeed "-manifolds" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Fr
                    %annotation{:encoding => "application/x-tex"} Fr
              = succeed "-manifolds" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi fr
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (U,fr)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Q%2FZ"} Q/Z
            %p
              Under the
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+isomorphism"} Pontrjagin-Thom isomorphism
              between the
              %a.existingWikiWord{:href => "/nlab/show/framed+bordism+ring"} framed bordism ring
              and the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+group+of+spheres"} stable homotopy group of spheres
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi π
                        %mo •
                        %mi s
                    %annotation{:encoding => "application/x-tex"} \pi^s_\bullet
              %a.existingWikiWord{:href => "/nlab/show/Adams+e-invariant"} Adams e-invariant
              in
              = succeed ":" do
                %a{:href => "#TheEInvariantAsAnElementOfQModZ"} its Q/Z-incarnation
            #eq:ToddClassesOnShortExactSequenceOfUFrBordismRings.maruku-equation
              %span.maruku-eq-number (19)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
