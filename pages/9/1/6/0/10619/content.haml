            %p
              Here the two identifications shown in magenta we may
              %em choose to be the canonical ones
              from Remark
              = succeed "." do
                %a.maruku-ref{:href => "#CanonicalSplittingOfCofiberOfPeriodicRationalCohomology"}
            %p
              From this, and using again
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi{:mathvariant => "normal"} Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{Ext}^1(-,\mathbb{Q}) = 0
              together with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi{:mathvariant => "normal"} Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi A
                    %mo ⊕
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi{:mathvariant => "normal"} Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msup
                      %mi{:mathvariant => "normal"} Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Ext}^1(-, A \oplus B )
                    \\simeq
                    \\mathrm{Ext}^1(-,A) \oplus \mathrm{Ext}^1(-,B)
              (by
              = succeed ")," do
                %a{:href => "Ext#ExtCompatibleWithDirectSumsAndProducts"} this Prop.
