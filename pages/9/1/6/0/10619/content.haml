                %use{:x => "343.943", "xlink:href" => "#pOcdY706P02inT4TxexSEtmDb34=-glyph-5-4", :y => "61.536"}
            %p
              which is induced in the same fashion from the inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mi ℚ
                      %mo ↪
                      %msup
                        %mi H
                        %mi{:mathvariant => "normal"} ev
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} H\mathbb{Q} \hookrightarrow H^{\mathrm{ev}}\mathbb{Q}
            %p
              Both of these splittings are hence characterized by the fact that their corresponding retraction (see
              = succeed ")" do
                %a{:href => "split+exact+sequence#InAbelianCategory"} there
              = succeed "." do
                %em
                  projection onto rational cohomology in degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} 2(n+d)
            %p
          %p
          #CofiberECohomologyAsExtensionOfStableCohomotopyByECohomology.num_lemma
            %h6 Lemma
            %p
              (Cofiber
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "-cohomology)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              a
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a space, assume that the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/Boardman+homomorphism"} Boardman homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝕊
                      %mo ˜
                    %msup
                      %mrow
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %msubsup
                          %mi β
                          %mi X
                          %mo •
                        %mspace{:width => "thickmathspace"}
                    %msup
                      %mover
                        %mi E
                        %mo ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\widetilde {\mathbb{S}}{}^\bullet(X) \xrightarrow{ \;\beta^\bullet_X\; }
                    \\widetilde E^\bullet(X)
              is
              %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero
              in degrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n + 1
              – for instance in that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ≃
                      %msup
                        %mi S
                        %mrow
                          %mi k
                          %mo ≥
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} X \simeq S^{k \geq 2}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
              and the groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo ˜
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi π
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widetilde E^0(S^k) = \pi_k(E)
              have no
              %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion
              – then the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+operations"} cohomology operations
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mi E
                    %annotation{:encoding => "application/x-tex"} i^E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \partial^E
              form a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
