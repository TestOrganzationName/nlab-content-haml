            %p
              Then: This function respects the canonical fibrations of both sides over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{d-1}
              %a.existingWikiWord{:href => "/nlab/show/lift"} lift
              through the boundary map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                    %annotation{:encoding => "application/x-tex"} \partial
            %p
          %p
            See also
            %a{:href => "d-invariant#EFluxesAreCocycleInCofiberTheory"} this Prop.
            at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/d-invariant"} d-invariant
          %p
          .proof
            %h6 Proof
            %p
            %p
              %strong> First
              , here is a quick formal argument to see that
              %em some
              such map does exist:
            %p
