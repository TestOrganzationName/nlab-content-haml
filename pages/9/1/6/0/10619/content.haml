          %h2#idea Idea
          %p
            The
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              \-invariant
            (
            %a{:href => "#Adams66"}> Adams 66, Sections 3,7
            , short for “extension invariant”, see Def.
            %a.maruku-ref{:href => "#EInvariantAsExtensionClassInECohomology"}
            below) is the second in a sequence of homotopy invariants of “stable maps”, i.e. of
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            in the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            (in particular: of
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
            %a.existingWikiWord{:href => "/nlab/show/Ext-groups"} Ext-groups
            between the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/homology+groups"} homology groups
            %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
            of the
            %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            and
            %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            of the map, with respect to some suitable choice of
            %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology+theory"} Whitehead-generalized cohomology theory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            The previous invariant in the sequence is the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/d-invariant"} d-invariant
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/f-invariant"} f-invariant
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"} [X,Y]_\bullet
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo ⟶
                    %mi f
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \overset{f}{\longrightarrow} Y
            be morphism in the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            out of a
            %a.existingWikiWord{:href => "/nlab/show/finite+spectrum"} finite spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (for instance the image under
            %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \Sigma^\infty
            of a morphism in the
            %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
            of
            %a.existingWikiWord{:href => "/nlab/show/pointed+homotopy+types"} pointed homotopy types
            out of a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/finite+CW-complex"} finite CW-complex
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
            %a.existingWikiWord{:href => "/nlab/show/d-invariant"} d-invariant
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            vanishes, hence such that pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f^\ast \;\colon\; E^\bullet(Y) \to E^\bullet(X)
            in
            = succeed "-cohomology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero morphism
          %p
            The archetypical example is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi n
                      %mo −
                      %mn 1
                  %mo →
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi n
