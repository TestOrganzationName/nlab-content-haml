                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %msup
                    %mi Ψ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} |\Psi^{(A)}\rangle
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %msup
                    %mi Ψ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} |\Psi^{(B)}\rangle
            respectively. The combined state of the system may be described by a single state vector
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msup
                      %mi Ψ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi AB
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} |
                    %msup
                      %mi Ψ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟩
                    %mo ⊗
                    %mo{:stretchy => "false"} |
                    %msup
                      %mi Ψ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} |\Psi^{(AB)}\rangle=|\Psi^{(A)}\rangle \otimes |\Psi^{(B)}\rangle
          %p
            As an example, suppose that in the basis
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} |
                    %mn 0
                    %mo{:stretchy => "false"} ⟩
                    %mo ,
                    %mo{:stretchy => "false"} |
                    %mn 1
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{|0\rangle ,|1\rangle\}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msup
                      %mi Ψ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mfrac
                      %mn 1
                      %msqrt
                        %mn 2
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} |
                      %mn 0
                      %mo{:stretchy => "false"} ⟩
                      %mo +
                      %mo{:stretchy => "false"} |
                      %mn 1
                      %mo{:stretchy => "false"} ⟩
                      %mo )
                  %annotation{:encoding => "application/x-tex"} |\Psi^{(A)}\rangle = \frac{1}{\sqrt{2}}\left(|0\rangle +|1\rangle\right)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            being in state
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mn 0
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} |0\rangle
            with probability 1/2 and state
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mn 1
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} |1\rangle
            with probability 1/2. Suppose further that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msup
                      %mi Ψ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} |
                    %mn 0
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} |\Psi^{(B)}\rangle = |0\rangle
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %msup
                    %mi Ψ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi AB
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mo{:stretchy => "false"} |
                  %msup
                    %mi Ψ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟩
                  %mo ⊗
                  %mo{:stretchy => "false"} |
                  %msup
                    %mi Ψ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mfrac
                    %mn 1
                    %msqrt
                      %mn 2
                  %mrow
                    %mo (
                    %mo{:stretchy => "false"} |
                    %mn 0
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mo{:stretchy => "false"} |
                    %mn 1
                    %mo{:stretchy => "false"} ⟩
                    %mo )
                  %mo ⊗
                  %mo{:stretchy => "false"} |
                  %mn 0
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mfrac
                    %mn 1
                    %msqrt
                      %mn 2
                  %mrow
                    %mo (
                    %mo{:stretchy => "false"} |
                    %mn 00
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mo{:stretchy => "false"} |
                    %mn 10
                    %mo{:stretchy => "false"} ⟩
                    %mo )
                %annotation{:encoding => "application/x-tex"} |\Psi^{(AB)}\rangle=|\Psi^{(A)}\rangle \otimes |\Psi^{(B)}\rangle=\frac{1}{\sqrt{2}}\left(|0\rangle +|1\rangle\right)\otimes|0\rangle=\frac{1}{\sqrt{2}}\left(|00\rangle +|10\rangle\right)
            \.
          %p
            Such a state is said to be a
            %strong product state
            because it is “factorable” or equivalently separable, i.e. it can be formed from some combination of individual states in the basis.
          %p Compare the above example to the state
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %msup
                    %mi Ψ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi AB
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mfrac
                    %mn 1
                    %msqrt
                      %mn 2
                  %mrow
                    %mo (
                    %mo{:stretchy => "false"} |
                    %mn 00
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mo{:stretchy => "false"} |
                    %mn 11
                    %mo{:stretchy => "false"} ⟩
                    %mo )
                %annotation{:encoding => "application/x-tex"} |\Psi^{(AB)}\rangle=\frac{1}{\sqrt{2}}\left(|00\rangle +|11\rangle\right)
            \.
          %p
            This state is not a product state since it cannot be formed from any combination of individual states in the given basis. Such a state is known as an
            %strong entangled state
            because it is said to be
            %em non-factorable
            or
            = succeed "." do
              %em non-separable
            %a.existingWikiWord{:href => "/nlab/show/pure+states"} pure states
            rather than
            %a.existingWikiWord{:href => "/nlab/show/mixed+states"} mixed states
            because they cannot be broken down further. However, there is also a notion of entanglement for mixed states.
          %h2#properties Properties
          %h3#locc_and_slocc LOCC and SLOCC
          %p
            The following refers to (
            %a{:href => "#CoeckeKissinger"}> Coecke-Kissinger
            ).
          %p
            Often if
            = succeed "s" do
              %span.newWikiWord
                multi-party state
                %a{:href => "/nlab/new/multi-party+state"} ?
          .num_defn
            %h6#definition_2 Definition
            %p
              Two states
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Ψ
                    %mo{:stretchy => "false"} ⟩
                    %mo ,
                    %mo{:stretchy => "false"} |
                    %mi Φ
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %mo ⨂
                    %msub
                      %mi H
                      %mi i
                  %annotation{:encoding => "application/x-tex"} |\Psi\rangle,|\Phi\rangle \in \bigotimes H_i
              are said to be equivalent up to local operations with classical communication (LOCC) if they can be inter-converted by a protocol involving any number of steps where (i) one party applies a local unitary operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %msub
                      %mi H
                      %mi i
                    %mo →
                    %msub
                      %mi H
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U : H_i \rightarrow H_i
              or (ii) one party sends some classical information to another.
          %p Such a protocol is reversible, so since protocols compose, this generates an equivalence relation. While this removes a good deal of redundancy from the study of entanglement, it is often useful to use an even more course-grained relation.
          .num_defn
            %h6#definition_3 Definition
            %p
              Two states
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Ψ
                    %mo{:stretchy => "false"} ⟩
                    %mo ,
                    %mo{:stretchy => "false"} |
                    %mi Φ
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %mo ⨂
                    %msub
                      %mi H
                      %mi i
                  %annotation{:encoding => "application/x-tex"} |\Psi\rangle,|\Phi\rangle \in \bigotimes H_i
              are said to be equivalent up to stochastic LOCC (SLOCC) if they can be inter-converted
              %em with some non-zero probability
              a protocol involving any number of steps where (i) one party applies a an
              %em arbitrary
              local operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %msub
                      %mi H
                      %mi i
                    %mo →
                    %msub
                      %mi H
                      %mi i
                  %annotation{:encoding => "application/x-tex"} L : H_i \rightarrow H_i
              or (ii) one party sends some classical information to another.
          %p
            An example of a local stochastic operation is as follows. Suppose Alice and Bob share a state
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi Ψ
                  %mo{:stretchy => "false"} ⟩
                  %mo ∈
                  %msub
                    %mi H
                    %mi A
                  %mo ⊗
                  %msub
                    %mi H
                    %mi B
                %annotation{:encoding => "application/x-tex"} |\Psi\rangle \in H_A \otimes H_B
            and Alice wishes to perform some operation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mn 0
                  %mo{:stretchy => "false"} ⟩
                  %mo ∈
                  %msup
                    %mi ℂ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} |0\rangle \in \mathbb{C}^2
            and performs a unitary operation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %msup
                    %mi ℂ
                    %mn 2
                  %mo ⊗
                  %msub
                    %mi H
                    %mn 1
                  %mo →
                  %msup
                    %mi ℂ
                    %mn 2
                  %mo ⊗
                  %msub
                    %mi H
                    %mn 1
                %annotation{:encoding => "application/x-tex"} U : \mathbb{C}^2 \otimes H_1 \rightarrow \mathbb{C}^2 \otimes H_1
          %p
            on her qubit as well as her part of the state
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Ψ
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} |\Psi\rangle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mn 0
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} |0\rangle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo :
                  %msub
                    %mi H
                    %mi A
                  %mo →
                  %msub
                    %mi H
                    %mi A
                %annotation{:encoding => "application/x-tex"} L : H_A \rightarrow H_A
            and if she gets outcome
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mn 1
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} |1\rangle
            she has performed
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ′
                    %mo :
                    %msub
                      %mi H
                      %mi A
                    %mo →
                    %msub
                      %mi H
                      %mi A
                  %annotation{:encoding => "application/x-tex"} L' : H_A \rightarrow H_A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is then the probability of getting the outcome of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mn 0
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} |0\rangle
            when she performed her measurement.
          .num_theorem
            %h6#theorem Theorem
            %p Two states are SLOCC-equivalent iff they can be inter-converted by applying arbitrary invertible local operations (ILOs).
          %p
            Its easy to show using the Schur decomposition that there are only two SLOCC-equivalence classes in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mn 2
                    %mo ⊗
                    %msup
                      %mi ℂ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^2 \otimes \mathbb{C}^2
            %a.existingWikiWord{:href => "/nlab/show/Bell+state"} Bell state
            class. Perhaps more surprising is the following result to to Dur, Vidal, and Cirac. [2]
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              Any genuine tripartite state |
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi Ψ
                  %annotation{:encoding => "application/x-tex"} \Psi
              \&gt;
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∈
                    %msup
                      %mi ℂ
                      %mn 2
                    %mo ⊗
                    %msup
                      %mi ℂ
                      %mn 2
                    %mo ⊗
                    %msup
                      %mi ℂ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \in \mathbb{C}^2 \otimes \mathbb{C}^2 \otimes \mathbb{C}^2
              is SLOCC-equivalent to either |W&gt; or |GHZ&gt;;.
          %p By genuine, they mean a state that is not a product of smaller states. The two states are defined as:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi W
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mo{:stretchy => "false"} |
                  %mn 100
                  %mo{:stretchy => "false"} ⟩
                  %mo +
                  %mo{:stretchy => "false"} |
                  %mn 010
                  %mo{:stretchy => "false"} ⟩
                  %mo +
                  %mo{:stretchy => "false"} |
                  %mn 001
                  %mo{:stretchy => "false"} ⟩
                  %mspace{:width => "2em"}
                  %mspace{:width => "2em"}
                  %mo{:stretchy => "false"} |
                  %mi GHZ
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mo{:stretchy => "false"} |
                  %mn 000
                  %mo{:stretchy => "false"} ⟩
                  %mo +
                  %mo{:stretchy => "false"} |
                  %mn 111
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  |W\rangle = |100\rangle + |010\rangle + |001\rangle
                  \\qquad\qquad
                  |GHZ\rangle = |000\rangle + |111\rangle
          %p
            Each of these states yields the structure of a commutative
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+algebra"} Frobenius algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi GHZ
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} |GHZ\rangle
            yields a special CFA and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi W
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} |W\rangle
            yields an “anti-special” CFA. This structure serves to uniquely identity these states (up to SLOCC) in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^2
