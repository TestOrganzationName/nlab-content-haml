          %h2#idea Idea
          %p
            While in
            %a.existingWikiWord{:href => "/nlab/show/classical+mechanics"} classical mechanics
            a (
            %a.existingWikiWord{:href => "/nlab/show/pure+state"}> pure
            )
            %a.existingWikiWord{:href => "/nlab/show/state"} state
            is an
            %a.existingWikiWord{:href => "/nlab/show/generalized+element"} element
            of an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            a pure state is an element of an object in a non-cartesian
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            (say of
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+spaces"} Hilbert spaces
            %a.existingWikiWord{:href => "/nlab/show/physical+system"} physical system
            may not come from a pair of states of the two
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/subsystems"} subsystems
            %a.existingWikiWord{:href => "/nlab/show/sum"} sum
            – a
            %em
              %a.existingWikiWord{:href => "/nlab/show/superposition"} superposition
            – of such. These non-classical combinations of states of subsystems are called
            = succeed "." do
              %em entangled states
          %h2#definition Definition
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            a
            %a.existingWikiWord{:href => "/nlab/show/state"} state
            of a
            %a.existingWikiWord{:href => "/nlab/show/physical+system"} physical system
            is represented by a
            %a.existingWikiWord{:href => "/nlab/show/vector"} vector
            in some (
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"}> Hilbert
            \-)
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.existingWikiWord{:href => "/nlab/show/subsystems"} subsystems
            with state spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 1
                %annotation{:encoding => "application/x-tex"} H_1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} H_2
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo =
                    %msub
                      %mi H
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi H
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} H = H_1 \otimes H_2
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            gives a
            %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %msub
                    %mi H
                    %mn 1
                  %mo ×
                  %msub
                    %mi H
                    %mn 2
                  %mo →
                  %msub
                    %mi H
                    %mn 1
                  %mo ⊗
                  %msub
                    %mi H
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  p : H_1 \times H_2 \to H_1 \otimes H_2
          %p
            which sends a pair of states
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ψ
                    %mn 1
                  %mo ,
                  %msub
                    %mi ψ
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\psi_1, \psi_2)
            to their tensor product
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi ψ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \psi_1 \otimes \psi_2
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            are called
            %strong product states
            or
            = succeed "." do
              %strong separable states
            %strong entangled state
            is a state which is
            %em not
            a product state. Such a state corresponds to
            = succeed "." do
              %strong non-simple tensors
          %h2#examples Examples
          %p
            Consider two
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+systems"} quantum systems
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
