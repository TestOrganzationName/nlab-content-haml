          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be a
              %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small category
              with all small
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is called
              %strong tiny
              or
              %strong
                small-
                %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective
              (
              %a{:href => "#Kelly82"}> Kelly 1982, §5.5
              ) if the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} E(e, -) \colon E \to Set
              %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/small+colimits"} small colimits
              %strong absolutely presentable
              if the functor preserves all colimits.
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              a
              %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} e \in E
              is called tiny if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} E(e,-) \colon E \to V
              preserves all small colimits.
          .num_remark
            %h6#remark Remark
            %p
              Since being an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              is a “colimit-property” (a morphism is epic iff its
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              with itself consists of identities), if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              is tiny then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E(e,-)
              preserves epimorphisms, which is to say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              is
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective
              (with respect to epimorphisms). This is presumably the origin of the term “small-projective”, i.e. the corepresentable functor preserves small colimits instead of just a certain type of finite one.
          #Atomic.num_defn
            %h6#definition_3 Definition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed
              and the
              %a.existingWikiWord{:href => "/nlab/show/inner+hom"} inner hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi e
                  %annotation{:encoding => "application/x-tex"} (-)^e
              has a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              (and hence preserves all colimits),
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              is called (internally)
              %strong atomic
              or
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+object"} infinitesimal
          %p
            (See for instance
            = succeed ".)" do
              %a{:href => "#Lawvere97"} Lawvere 97
          .num_remark
            %h6#remark_2 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              in def.
              %a.maruku-ref{:href => "#Atomic"}
              is sometimes called an “
              %a.existingWikiWord{:href => "/nlab/show/amazing+right+adjoint"}> amazing right adjoint
              ”, particularly in the context of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
          .num_remark
            %h6#remark_3 Remark
            %p
              Various terminological discrepancies in the literature hinge on the distinction between internal notions and external notions. Thus, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is a
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
              with small colimits, we may say
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi Ob
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e \in Ob(E)
              is
              %em internally
              tiny if the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi e
                    %mo :
                    %mi E
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} (-)^e: E \to E
              preserves small colimits. Relatedly, the word “atomic” has been used in both an external sense where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi E
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} E(e, -): E \to Set
              has a right adjoint, as in Bunge’s thesis, and in an internal sense, as when Lawvere refers to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              as an a.t.o.m. (“amazingly tiny object model”) if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi e
                    %mo :
                    %mi E
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} (-)^e: E \to E
              has a right adjoint. But under certain hypotheses, the two notions coincide; see for instance Proposition
              = succeed "." do
                %a.maruku-ref{:href => "#coincide"}
          #InSheafToposTinyImpliesAtomic.num_prop
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
          .proof
            %h6#proof Proof
            %p
              Clearly any externally atomic object is tiny. For the converse, use a dual form of the special
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
              (SAFT):
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
              %a.existingWikiWord{:href => "/nlab/show/well-powered+category"} co-well-powered
              (because for any object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/epimorphisms"} epimorphisms
              with domain
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              are in natural bijection with
              %a.existingWikiWord{:href => "/nlab/show/internal+equivalence+relations"} internal equivalence relations
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi X
                      %mo ,
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hom(X \times X, \Omega)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              has a
              %a.existingWikiWord{:href => "/nlab/show/generating+set"} generating set
              (namely, the set of associated
              %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
              of
              %a.existingWikiWord{:href => "/nlab/show/representables"} representables
              coming from a small
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              presentation for
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/cocontinuous+functor"} cocontinuous functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} E \to C
              has a right adjoint, provided that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is locally small; then apply this to the case
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo =
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} C = Set
          %p
            Clearly the statement and the proof of Proposition
            %a.maruku-ref{:href => "#InSheafToposTinyImpliesAtomic"}
            carry over when “external” is replaced by “internal” throughout.
          %h2#properties Properties
          %h3#general General
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Any
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of a tiny object is tiny, since
              %a.existingWikiWord{:href => "/nlab/show/split+idempotent"} splitting of idempotents
              is an
              %a.existingWikiWord{:href => "/nlab/show/absolute+colimit"} absolute colimit
              (see also
              = succeed ")." do
                %a{:href => "#Kelly82"} Kelly, prop. 5.25
          %h3#InCategoriesOfModulesOverRings In categories of modules over rings
          %p
            The notion of tiny object is clearly highly dependent on the base of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enrichment
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} modules
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ab
                      %mi R
                  %annotation{:encoding => "application/x-tex"} Ab^R
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            %a.existingWikiWord{:href => "/nlab/show/finitely+generated+module"} finitely generated
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/projective+modules"} projective modules
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is tiny (the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi Ab
                    %mi R
                  %mo →
                  %mi Ab
                %annotation{:encoding => "application/x-tex"} \hom(R, -): Ab^R \to Ab
            preserves
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ab
                  %annotation{:encoding => "application/x-tex"} Ab
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            under finite direct sums and retracts, which are absolute
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ab
                  %annotation{:encoding => "application/x-tex"} Ab
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+completion"} Cauchy completion
          %p
            On the other hand, when the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ab
                    %mi R
                %annotation{:encoding => "application/x-tex"} Ab^R
            is considered as a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            %em no
            tiny objects. In fact this is true for any Set-enriched category with a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a tiny object. The morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"} X \to 0
            induces a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(X,X) \to Hom(X,0)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom(X,-)
            preserves the zero object, as an empty colimit). Thus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} Hom(X,X) = \emptyset
            in contradiction to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi X
                    %mo ∈
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} id_X \in Hom(X,X)
          %h3#in_presheaf_categories In presheaf categories
          .num_example
            %h6#example Example
            %p
              In a
              %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
              every
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              is a tiny object:
            %p
              since colimits of presheaves are computed objectwise (see
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/limits+and+colimits+by+example"} limits and colimits by example
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              we have for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              a
              %a.existingWikiWord{:href => "/nlab/show/representable"} representable
              functor and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi J
                    %mo →
                    %mi PSh
                  %annotation{:encoding => "application/x-tex"} F : J \to PSh
              a diagram that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %munder
                      %mi lim
                      %mo →
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %munder
                      %mi lim
                      %mo →
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mi lim
                      %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(U, \lim_\to F) \simeq (\lim_\to F)(U) \simeq \lim_\to F(U)
            %p
              where now the last
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              is in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %p
            Thus, in a presheaf category, any
            %a.existingWikiWord{:href => "/nlab/show/retract"} retract
            of a representable functor is tiny. In fact the converse also holds:
          #representables.num_prop
            %h6#proposition_3 Proposition
            %p
              The tiny objects in a
              %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
              are precisely the
              %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functor
          %p
            This is for instance (
            %a{:href => "#BorceuxDejean"}> BorceuxDejean, prop 2
            ). For instance, the only tiny object in
            %a.existingWikiWord{:href => "/nlab/show/G-set"} G-set
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            itself with its regular action.
          %p
            Thus, if the domain category is
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+complete+category"} Cauchy complete
            (has
            = succeed "s)," do
              %a.existingWikiWord{:href => "/nlab/show/split+idempotent"} split idempotent
            %a.existingWikiWord{:href => "/nlab/show/Karoubi+envelope"} Karoubi envelope
            of a category can be defined to consist of the tiny presheaves on it. See
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+complete+category"} Cauchy complete category
            for more on this.
          #coincide.num_prop
            %h6#proposition_4 Proposition
            %p
              For presheaves on a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              with finite products, the notions of externally tiny object and internally tiny object coincide.
          .proof
            %h6#proof_2 Proof
            %p
              Without loss of generality, we may assume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is Cauchy complete (note that the Cauchy completion of a category with finite products again has finite products), so that tiny presheaves coincide with representable functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(-, c)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              denote the presheaf category. Given that the empty product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              is tiny, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi Ob
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e \in Ob(E)
              is internally tiny, then the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi E
                    %mo →
                    %mi Set
                    %mo =
                    %mrow
                      %mo (
                      %mi E
                      %mover
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi e
                      %mi E
                      %mover
                        %mo →
                        %mrow
                          %mi E
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mi Set
                      %mo )
                  %annotation{:encoding => "application/x-tex"} E(e, -): E \to Set = \left(E \stackrel{(-)^e}{\to} E \stackrel{E(1,-)}{\to} Set \right)
            %p
              is cocontinuous, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              is externally tiny.
            %p
              In the other direction, recall how exponentials
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mi F
                  %annotation{:encoding => "application/x-tex"} G^F
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E = PSh(C)
              are constructed: we have the formula
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi F
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} G^F(c) = E(C(-, c) \times F, G).
            %p
              In particular, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is externally tiny, hence a representable
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi c
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(-, c')
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi c
                    %mo ×
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ×
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G^F(c) = E(C(-, c) \times C(-, c'), G) \cong E(C(-, c \times c'), G) \cong G(c \times c')
            %p
              where the last isomorphism is by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(C)
              are computed pointwise, whereby evaluation functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ev
                      %mi c
                    %mo :
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} ev_c: PSh(C) \to Set
              preserve colimits, we see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi c
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mo :
                    %mi G
                    %mo ↦
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ×
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-)^{C(-, c')}: G \mapsto G(- \times c')
              preserves colimits, so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F = C(-, c')
              is internally tiny. The amazing right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              in this case takes a presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              to the presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi H
                  %annotation{:encoding => "application/x-tex"} R H
              that takes an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              to the set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mi H
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi E
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ×
                      %mi c
                      %mo ′
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (R H)(d) = E(C(- \times c', d), H)
          %p
            (Compare the result
            = succeed ".)" do
              %a{:href => "https://ncatlab.org/nlab/show/internally+projective+object#enough"} here
          %p
            In the context of
            %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            we say, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            of
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                  %mover
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi f
                            %mo *
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mo !
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  Set \stackrel{\overset{f_!}{\to}}{\stackrel{\overset{f^*}{\leftarrow}}{\underset{f_*}{\to}}}
                  [C,Set]
          %p
            is an
            %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
            of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Set
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f : Set \to [C,Set]
            %strong
              %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} essential point
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [C,Set]
          %p
            By the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
            this is equivalently simply a single functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} f^* : [C, Set] \to Set
            that preserves all small
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Topos
                    %mi ess
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi LRFunc
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Topos_{ess}(Set,[C,Set])
                  \\simeq
                  LRFunc([C,Set], Set)
                  \\subset
                  Func([C,Set], Set)
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of the
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            on functors that have a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            and a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
          .num_prop
            %h6#proposition_5 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              there is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi C
                      %mo ¯
                    %mo :
                    %mo =
                    %mi TinyObjects
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Topos
                      %mi ess
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{C} := TinyObjects([C,Set]) \simeq Topos_{ess}(Set, [C,Set])^{op}
            %p
              of the tiny objects of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [C,Set]
              with the category of essential points of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [C,Set]
          .proof
            %h6#proof_3 Proof
            %p
              We first exhibit a
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Topos
                        %mi ess
                      %mo{:stretchy => "false"} (
                      %mi Set
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo ↪
                      %mover
                        %mi C
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} Topos_{ess}(Set,[C,Set])^{op} \hookrightarrow \overline{C}
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mrow
                            %msub
                              %mi f
                              %mo *
                        %mover
                          %mo ←
                          %mrow
                            %msup
                              %mi f
                              %mo *
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mo !
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Set \stackrel{\overset{f_!}{\to}}{\stackrel{\overset{f^*}{\leftarrow}}{\underset{f_*}{\to}}} [C,Set]
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                  %annotation{:encoding => "application/x-tex"} f_!
              is
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              and thus preserves all small
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              and because every
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} S \in Set
              is the colimit over itself of the singleton set we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mi S
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %msub
                      %mi f
                      %mo !
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f_! S \simeq \coprod_{s \in S} f_!(*)
            %p
              is fixed by a choice of
              %a.existingWikiWord{:href => "/nlab/show/copresheaf"} copresheaf
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mo =
                    %msub
                      %mi f
                      %mo !
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F := f_!(*) \in [C, Set]
                    \\,.
            %p
              The
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mo !
                      %mo ⊣
                      %msup
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f_! \dashv f^*)
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              then implies that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} H \in [C,Set]
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi H
                    %mo ≃
                    %mi Set
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %msup
                      %mi f
                      %mo *
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo !
                    %mo *
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f^* H \simeq Set(*, f^* H) \simeq [C,Set](f_! *, H)
                    \\simeq [C,Set](F,H)
                    \\,.
            %p
              naturally in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Set
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f^*(-) \simeq [C,Set](F,-) : Set \to [C,Set]
                    \\,.
            %p
              By assumption this has a further right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                  %annotation{:encoding => "application/x-tex"} f_!
              and hence preserves all
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              %a.existingWikiWord{:href => "/nlab/show/tiny+object"} tiny object
              it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F \in [C,Set]
              is a tiny object. By prop.
              %a.maruku-ref{:href => "#CauchyComplIsFullSubcatOnTinyObjects"}
              this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              belongs to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi C
                        %mo ¯
                      %mo ⊂
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \overline{C} \subset [C,Set]
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⇒
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \Rightarrow g
              between
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphisms"} geometric morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mi Set
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f,g : Set \to [C,Set]
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/geometric+transformation"} geometric transformation
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo ⇒
                      %msup
                        %mi g
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^* \Rightarrow g^*
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ⇒
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [C,Set](F,-) \Rightarrow [C,Set](G,-)
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              these are in bijection with morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G \to H
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [C,Set]
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Topos
                        %mi ess
                      %mo{:stretchy => "false"} (
                      %mi Set
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo ⊂
                      %mover
                        %mi C
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} Topos_{ess}(Set,[C,Set])^{op} \subset \overline{C}
            %p
              The converse inclusion is now immediate by the same arguments: since the objects in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi C
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{C}
              are precisely the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/tiny+object"} tiny object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F \in [C,Set]
              each of them corresponds to a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} [C,Set](F,-) : [C,Set] \to Set
              that has a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              of an essential geometric morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi Set
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} f : Set \to [C,Set]
          %h3#AtomsInALocalTopos In a local topos
          #SliceOverAtomicObject.num_prop
            %h6#proposition_6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              in any
              %a.existingWikiWord{:href => "/nlab/show/local+topos"} local topos
              is atomic.
            %p
              In particular for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              a
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              an object, the
              %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/X}
              is
              %a.existingWikiWord{:href => "/nlab/show/local+topos"} local
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is atomic.
          %p
            This is discuss at
            = succeed "." do
              %a{:href => "local+geometric+morphism#LocalOverTopoes"} local geometric morphism – Local over-toposes
          %h3#AtomsInACohesiveTopos In a cohesive topos
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ∫
                  %mo ⊣
                  %mo ♭
                  %mo ⊣
                  %mo ♯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\int \dashv \flat \dashv \sharp)
            for its
            %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            of
            %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊣
                %annotation{:encoding => "application/x-tex"} \dashv
            %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊣
                %annotation{:encoding => "application/x-tex"} \dashv
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos+--+structures"} cohesive (∞,1)-topos – structures
          .num_defn
            %h6#definition_4 Definition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              is called
              %em geometrically contractible
              if its
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∫
                      %mi X
                      %mo ≃
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \int X \simeq \ast
          #InCohesionAtomicObjectIsGeometricallyContractible.num_prop
            %h6#proposition_7 Proposition
            %p
              Over the
              %a.existingWikiWord{:href => "/nlab/show/base+%28%E2%88%9E%2C1%29-topos"} base (∞,1)-topos
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              is geometrically contractible.
          .proof
            %h6#proof_4 Proof
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflection
              of the
              %a.existingWikiWord{:href => "/nlab/show/discrete+objects"} discrete objects
              it will be sufficient to show that for all
              %a.existingWikiWord{:href => "/nlab/show/discrete+objects"} discrete objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mn ∞
                    %mi Grpd
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} S \in \infty Grpd \hookrightarrow \mathbf{H}
              we have an
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo [
                      %mo ∫
                      %mi X
                      %mo ,
                      %mi S
                      %mo ]
                    %mo ≃
                    %mi S
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left[\int X , S\right] \simeq S
                    \\,.
            %p
              Now notice that, by the discussion at
              = succeed "," do
                %em
                  %a{:href => "limit+in+a+quasi-category#Tensoring"} ∞-tensoring
              %a.existingWikiWord{:href => "/nlab/show/discrete+object"} discrete object
              here is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              indexed by itself of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              constant on the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo →
                      %mi S
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S \simeq \underset{\rightarrow}{\lim}_S \ast
                    \\,.
            %p Using this we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mrow
                              %mo [
                              %mo ∫
                              %mi X
                              %mo ,
                              %mi S
                              %mo ]
                          %mtd
                            %mo ≃
                            %mrow
                              %mo [
                              %mi X
                              %mo ,
                              %mo ♭
                              %mi S
                              %mo ]
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mrow
                              %mo [
                              %mi X
                              %mo ,
                              %mo ♭
                              %msub
                                %munder
                                  %mi lim
                                  %mo →
                                %mi S
                              %mo *
                              %mo ]
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mrow
                              %mo [
                              %mi X
                              %mo ,
                              %msub
                                %munder
                                  %mi lim
                                  %mo →
                                %mi S
                              %mo ♭
                              %mo *
                              %mo ]
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %munder
                                %mi lim
                                %mo →
                              %mi S
                            %mrow
                              %mo [
                              %mi X
                              %mo ,
                              %mo ♭
                              %mo *
                              %mo ]
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %munder
                                %mi lim
                                %mo →
                              %mi S
                            %mrow
                              %mo [
                              %mi X
                              %mo ,
                              %mo *
                              %mo ]
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %munder
                                %mi lim
                                %mo →
                              %mi S
                            %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi S
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\left[\int X, S\right]
                    \&amp;\simeq
                    \\left[
                    X, \flat S
                    \\right]
                    \\\
                    \&amp; \simeq
                    \\left[
                    X, \flat \underset{\rightarrow}{\lim}_S \ast
                    \\right]
                    \\\
                    \&amp; \simeq
                    \\left[
                    X, \underset{\rightarrow}{\lim}_S \flat  \ast
                    \\right]
                    \\\
                    \&amp; \simeq
                    \\underset{\rightarrow}{\lim}_S
                    \\left[
                    X, \flat  \ast
                    \\right]
                    \\\
                    \&amp; \simeq
                    \\underset{\rightarrow}{\lim}_S
                    \\left[
                    X, \ast
                    \\right]
                    \\\
                    \&amp; \simeq
                    \\underset{\rightarrow}{\lim}_S
                    \\ast
                    \\\
                    \&amp; \simeq
                    S
                    \\end{aligned}
                    \\,.
            %p
              where we applied, in order of appearance: the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo ∫
                      %mo ⊣
                      %mo ♭
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\int \dashv \flat)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                  %annotation{:encoding => "application/x-tex"} \flat
              is also
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              (hence the existence of the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is atomic, then again the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                  %annotation{:encoding => "application/x-tex"} \flat
              is right adjoint, that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
              is the terminal object and finally again the
              = succeed "-tensoring." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          #SliceOfCohesionOverAtomIsCohesive.num_prop
            %h6#proposition_8 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              be a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              over
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              be an atomic object. Then the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/X}
              sits by an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
              over
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              whose leftmost adjoint preserves the terminal object.
          .proof
            %h6#proof_5 Proof
            %p
              By the discussion at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+geometric+morphism"} étale geometric morphism
              %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
              comes with an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mover
                      %mover
                        %mover
                          %munder
                            %mrow
                            %mrow
                          %mover
                            %mo ⟶
                            %mrow
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                                %mi X
                        %mover
                          %mo ←
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mi X
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mover
                        %mover
                          %munder
                            %mo ←
                            %mi CoDisc
                          %mover
                            %mo ⟶
                            %mi Γ
                        %mover
                          %mo ←
                          %mi Disc
                      %mover
                        %mo ⟶
                        %mi Π
                    %mn ∞
                    %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}_{/X}
                    \\stackrel{\overset{\sum_X}{\longrightarrow}}{\stackrel{\overset{(-)\times X}{\leftarrow}}{\stackrel{\overset{\prod_X}{\longrightarrow}}{\underset{}{}}}}
                    \\mathbf{H}
                    \\stackrel{\overset{\Pi}{\longrightarrow}}{\stackrel{\overset{Disc}{\leftarrow}}{\stackrel{\overset{\Gamma}{\longrightarrow}}{\underset{CoDisc}{\leftarrow}}}}
                    \\infty Grpd
                    \\,.
            %p
              The bottom composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo ∘
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \Gamma\circ \prod_X
              has an extra right adjoint by prop
              = succeed "." do
                %a.maruku-ref{:href => "#SliceOverAtomicObject"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo ∘
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \Pi \circ \sum_X
              preserves the terminal object by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#InCohesionAtomicObjectIsGeometricallyContractible"}
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/atom"} atom
                (in a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/atomic+category"} atomic category
          %h2#references References
          %p
            The term
            %em small projective object
            is used in:
          %ul
            %li#Kelly82
              %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"}> Max Kelly
              , section 5.5. of:
              = succeed "," do
                %em Basic concepts of enriched category theory
              = succeed "," do
                %strong 64
              %strong 10
              (2005) 1-136 &amp;lbrack;
              %a{:href => "https://www.cambridge.org/de/academic/subjects/mathematics/logic-categories-and-sets/basic-concepts-enriched-category-theory?format=PB&isbn=9780521287029"}> ISBN:9780521287029
              ,
              = succeed "," do
                %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/10/tr10abs.html"} tac:tr10
              = succeed "&rbrack;" do
                %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/10/tr10.pdf"} pdf
          %p
            Tiny objects in presheaf categories (
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+complete+categories"}> Cauchy completion
            ) are discussed in
          %ul
            %li#BorceuxDejean
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"} Francis Borceux
                and D. Dejean,
                %em Cauchy completion in category theory
                Cahiers Topologie Géom. Différentielle Catégoriques, 27:133–146, (1986) &amp;lbrack;
                %a{:href => "http://www.numdam.org/item?id=CTGDC_1986__27_2_133_0"}> numdam:CTGDC_1986__27_2_133_0
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Yetter"}> David Yetter
                \:
                = succeed "," do
                  %em On right adjoints to exponential functors
                %strong 45
                3 (1987) 287-304 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0022-4049(87)90077-6"}> doi:10.1016/0022-4049(87)90077-6
                \&amp;rbrack;
          %p The term “atomic object” or rather “a.t.o.m” is suggested in
          %ul
            %li#Lawvere97
              %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"}> William Lawvere
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Toposes+of+laws+of+motion"} Toposes of laws of motion
              (1997)
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/modal+type+theory"} modal type theory
            for tiny objects:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mitchell+Riley"}> Mitchell Riley
                ,
                %em A Type Theory with a Tiny Object
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2403.01939"}> arXiv:2403.01939
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mitchell+Riley"}> Mitchell Riley
                \:
                = succeed "," do
                  %em Tiny Objects in Type Theory
                %a{:href => "CQTS#RileyTinyApr2024"} talk at
                = succeed "," do
                  %em
                    %a{:href => "CQTS#RunningHoTT2024"} Running HoTT 2024
                %a.existingWikiWord{:href => "/nlab/show/CQTS"} CQTS
                @ NYU Abu Dhabi (Apr 2024) &amp;lbrack;slides:
                %a.existingWikiWord{:href => "/nlab/files/Riley-TinyTypes-Apr2024.pdf", :title => "pdf"}> pdf
                , video:
                = succeed "&rbrack;" do
                  %a{:href => "https://cdnapisec.kaltura.com/html5/html5lib/v2.73.2/mwEmbedFrame.php/p/1674401/uiconf_id/23435151/entry_id/1_31zdfvgi?wid=_1674401&iframeembed=true&playerId=kaltura_player&entry_id=1_31zdfvgi"} kt
