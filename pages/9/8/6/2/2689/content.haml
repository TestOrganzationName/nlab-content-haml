                    %mi Y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} Y'
              with a relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ′
                    %mo :
                    %mi B
                    %mo ′
                    %mo ↬
                    %mi Y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} M':B'\looparrowright Y'
              maintaining the truth of these statements.
            %p
              Now the induced function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi p
                      %mo ¯
                    %mo :
                    %mi B
                    %mo →
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \overline{p}:B\to im(p)
              is surjective, and since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} im(p)
              is a subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              it is
              = succeed "-small." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "-small" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi C
                    %mo ↠
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q:C\twoheadrightarrow im(p)
              and a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:C\to B
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo =
                      %mover
                        %mi p
                        %mo ¯
                      %mo ∘
                      %mi f
                    %annotation{:encoding => "application/x-tex"} q = \overline{p} \circ f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ′
                    %mo =
                    %mi C
                  %annotation{:encoding => "application/x-tex"} B'=C
              and the composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} C \to im(p)\to A
              as the function
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} p'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} M\circ f
              still satisfies (1) and (2) above. (We have not replaced
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              yet, so this is still an intermediate step.) Property (1) follows since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p'(c) = p(f(c))
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo ∘
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi c
                      %mo ≅
                      %msub
                        %mi M
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (M\circ f)_c \cong M_{f(c)}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} im(p) = im(p')
              by construction.
            %p
              Now consider a tabulation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ′
                    %mover
                      %mo ←
                      %mi r
                    %mi Z
                    %mover
                      %mo →
                      %mi s
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} B' \overset{r}{\leftarrow} Z \overset{s}{\to} Y
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ∘
                      %mi f
                    %annotation{:encoding => "application/x-tex"} M\circ f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi B
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} b\in B'
              we have
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi r
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo ∘
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi b
                    %annotation{:encoding => "application/x-tex"} r^{-1}(b) \cong (M\circ f)_b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi r
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r^{-1}(b)
              is
              = succeed "-small" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} B'
              is also
              = succeed "-small," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              is also
              = succeed "-small." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi r
                      %mi o
                    %mo :
                    %mi B
                    %mo ′
                    %mo ↬
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} r^o:B'\looparrowright Z
              is equivalent to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ∘
                      %mi f
                    %annotation{:encoding => "application/x-tex"} M\circ f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi r
                      %mi o
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi b
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ∘
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi b
                  %annotation{:encoding => "application/x-tex"} (r^o)_b \cong (M\circ f)_b
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi B
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} b\in B'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ′
                    %mo =
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Y'=Z
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ′
                      %mo =
                      %msup
                        %mi r
                        %mi o
                    %annotation{:encoding => "application/x-tex"} M'=r^o
          %p
            Note that both the “Replacement” and “Collection” properties of a universe are required to show the SEAR Collection axiom for
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %em Algebraic Set Theory
            by Joyal and Moerdijk.
          %p
            What about families and dependent products? We define a function, considered as a family of sets, to be
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              \-small
            if each of its fibers is. Note that then we can state the Replacement property as “the composite of
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "-small.\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi C
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} g:C\to B
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi B
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f:B\to A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi f
                  %mi g
                %annotation{:encoding => "application/x-tex"} \Pi_f g
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} a\in A
            is the subset of the function set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mi g
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %msup
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Big((f g)^{-1}(a)\Big)^{f^{-1}(a)}
            consisting of functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo :
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mi g
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s: f^{-1}(a) \to (f g)^{-1}(a)
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∘
                    %mi s
                    %mo =
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                  %annotation{:encoding => "application/x-tex"} g\circ s = \id
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            are
            = succeed "-small," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mi g
                %annotation{:encoding => "application/x-tex"} f g
            (by the “Replacement” property), and thus so is this fiber. Hence
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %p Also of interest is the following, which should be compared to the “descent” axiom in Joyal-Moerdijk.
          #univ-descent.num_theorem
            %h6#theorem_2 Theorem
            %p
              The following are equivalent for a function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi B
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} f:B\to A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              = succeed "-small." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi C
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p:C\to A
              and a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi C
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} g:C\to U
              and two pullback squares
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo ←
                              %mi q
                          %mtd
                            %mi P
                          %mtd
                            %mover
                              %mo →
                              %mi k
                          %mtd
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi E
                              %mo{:stretchy => "false"} |
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi j
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %munder
                              %mo ↞
                              %mi p
                          %mtd
                            %mi C
                          %mtd
                            %munder
                              %mo →
                              %mi g
                          %mtd
                            %mi U
                  %annotation{:encoding => "application/x-tex"}
                    \\array{B &amp;\overset{q}{\leftarrow} &amp; P &amp; \overset{k}{\to} &amp; {|E|}\\
                    ^f\downarrow &amp;&amp; \downarrow^j &amp;&amp; \downarrow\\
                    A &amp;\underset{p}{\twoheadleftarrow} &amp; C &amp; \underset{g}{\to} &amp; U}
            %ol
              %li
                (If the axiom of choice holds) There exists a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi A
                      %mo →
                      %mi U
                    %annotation{:encoding => "application/x-tex"} g:A\to U
                and a pullback square
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi B
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                              %mtd
                                %mrow
                                  %mo{:stretchy => "false"} |
                                  %mi E
                                  %mo{:stretchy => "false"} |
                            %mtr
                              %mtd
                                %msup
                                  %mo
                                  %mi f
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi A
                              %mtd
                                %munder
                                  %mo →
                                  %mi g
                              %mtd
                                %mi U
                      %annotation{:encoding => "application/x-tex"}
                        \\array{B &amp; \overset{}{\to} &amp; {|E|}\\
                        ^f\downarrow &amp;&amp; \downarrow\\
                        A &amp; \underset{g}{\to} &amp; U}
          .proof
            %h6#proof_2 Proof
            %p
              Clearly the third condition implies the second. The second implies the first, since pullbacks have isomorphic fibers. And in the presence of AC, the second implies the third, since the surjection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              has a section. Thus the difficulty is in showing that the first implies the second.
            %p
              Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi B
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f:B\to A
              is
              = succeed "-small." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a\in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} u\in U
              and a bijection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %msub
                        %mi E
                        %mi u
                    %annotation{:encoding => "application/x-tex"} f^{-1}(a)\cong E_u
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be the subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi U
                    %mo ×
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ×
                    %mo{:stretchy => "false"} |
                    %mi E
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A\times U\times P(B\times |E|)
              consisting of those triples
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi u
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,u,h)
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is a bijection
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mo ≅
                      %msub
                        %mi E
                        %mi u
                    %annotation{:encoding => "application/x-tex"} f^{-1}(a) \overset{\cong}{\to} E_{u}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi C
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p:C\to A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi C
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} g:C\to U
              be the projections. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              = succeed "-small," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is surjective. Define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              to be a pullback of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi P
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} q:P\to B
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo :
                      %mi P
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} j:P\to C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo :
                    %mi P
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi E
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} k:P\to {|E|}
              by (informally speaking)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} k(x) = h(q(x))
              where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi u
                      %mo ,
                      %mi h
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} j(x) = (a,u,h)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is a bijection,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              a pullback of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi E
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|E|}
