                  ,
                  = succeed "," do
                    %em Lectures in (2+1)-Dimensional Gravity
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/gr-qc/9503024"} arXiv:gr-qc/9503024
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Steven+Carlip"}> Steven Carlip
                  ,
                  = succeed "," do
                    %em Quantum Gravity in 2+1 Dimensions
                  = succeed ")" do
