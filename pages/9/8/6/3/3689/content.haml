            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
            is the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            and whose morphisms are module homomorphisms.
          %p
            Specifically if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mo ⊗
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes)
            is the category
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            of
            %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
          %p
            We write just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} Mod
            for the category whose objects are pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (R,N)
            consisting of a monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and an
            = succeed "-module," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %h2#definition_of_
            Definition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} Mod
          %p
            We assume that the ambient
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            is
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            with the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
          #ModSpelledOut.num_defn
            %h6#definition Definition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} Mod
              is a pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (R,N)
              consisting of a commutative
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              and an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ,
                    %mi κ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ′
                    %mo ,
                    %mi N
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\phi,\kappa) :  (R,N) \to (R',N')
            %p
              is a pair consisting of a ring
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi R
                    %mo →
                    %mi R
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \phi : R \to R'
              and a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo :
                    %mi N
                    %mo →
                    %msup
                      %mi ϕ
                      %mo *
                    %mi N
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \kappa : N \to \phi^* N'
              of
              = succeed "-modules," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mo *
                    %mi N
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \phi^* N'
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/restriction+of+scalars"} restriction of scalars
          %h2#properties Properties
          %h3#ModAsBifibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} Mod
            as a bifibration
          %p
            Projecting out the first items in the pairs appearing in def.
            %a.maruku-ref{:href => "#ModSpelledOut"}
            yields a canonical functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi Mod
                  %mo →
                  %mi CRing
                %annotation{:encoding => "application/x-tex"}
                  p :Mod \to CRing
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi R
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (R,N) \mapsto R
                  \\,.
          %p
            that exhibits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} Mod
            as a
            %a.existingWikiWord{:href => "/nlab/show/bifibration"} bifibration
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %p
            The fiber of this projection over a ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Mod
                      %mi R
                  %annotation{:encoding => "application/x-tex"} Mod_R
            = succeed "-modules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %p
            In particular the fiber over the initial commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} R = \mathbb{Z}
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Mod
                    %mi ℤ
                  %mo =
                  %mi Ab
                %annotation{:encoding => "application/x-tex"}
                  Mod_{\mathbb{Z}} = Ab
          %p
            the category
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            of abelian groups.
          %h3#TangentsAndDeformationTheory Tangents and deformation theory
          %p
            By an old observation of Quillen – reviewed at
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            – the bifibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                  %mo →
                  %mi CRing
                %annotation{:encoding => "application/x-tex"} Mod \to CRing
            is
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            to the category of fiberwise abelian
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi CRing
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi CRing
                  %annotation{:encoding => "application/x-tex"} [I,CRing] \to CRing
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Mod
                  %mo →
                  %mi CRing
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Ab
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi CRing
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi CRing
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (Mod \to CRing) \simeq Ab([I,CRing] \to CRing)
                  \\,.
          %p
            For a fixed ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Mod
                    %mi R
                %annotation{:encoding => "application/x-tex"} Mod_R
            of
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ab
                    %mo{:stretchy => "false"} (
                    %mi CRing
                    %mo{:stretchy => "false"} /
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ab(CRing/R)
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CRing
                    %mo{:stretchy => "false"} /
                    %mi R
                  %annotation{:encoding => "application/x-tex"} CRing/R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Mod
                    %mi R
                  %mo ≃
                  %mi Ab
                  %mo{:stretchy => "false"} (
                  %mi CRing
                  %mo{:stretchy => "false"} /
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Mod_R \simeq Ab(CRing/R)
                  \\,.
          %p
            This says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                  %mo →
                  %mi Ring
                %annotation{:encoding => "application/x-tex"} Mod \to Ring
            is the
            %a.existingWikiWord{:href => "/nlab/show/tangent+category"} tangent category
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CRing
                  %annotation{:encoding => "application/x-tex"} CRing
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            equivalently as the
            %a.existingWikiWord{:href => "/nlab/show/square-0+extension"} square-0 extension
            ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ⊕
                  %mi N
                %annotation{:encoding => "application/x-tex"} R \oplus N
            (with multiplication
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mi ⋯
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 2
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 1
                    %msub
                      %mi r
                      %mn 2
                    %mo ,
                    %msub
                      %mi r
                      %mn 1
                    %msub
                      %mi n
                      %mn 2
                    %mo +
                    %msub
                      %mi r
                      %mn 2
                    %msub
                      %mi n
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (r_1,n_1) \cdots (r_2,n_2) = (r_1 r_2, r_1 n_2 + r_2 n_1)
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            (or rather
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaf"} quasicoherent sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mi R
                %annotation{:encoding => "application/x-tex"} Spec R
            that is given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
          %p
            There is thus another natural projection from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} Mod
            to rings, namely the functor that remembers these
            %a.existingWikiWord{:href => "/nlab/show/square-0+extensions"} square-0 extensions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi Mod
                  %mo →
                  %mi CRing
                %annotation{:encoding => "application/x-tex"}
                  f : Mod \to CRing
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi R
                  %mo ⊕
                  %mi N
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (R,N) \mapsto R \oplus N
                  \\,.
          %p
            This functor has a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo :
                  %mi CRing
                  %mo →
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} \Omega : CRing \to Mod
            which is also a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/section"} section
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differential"} Kähler differential
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo ⊣
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Mod
                  %mover
                    %munder
                      %mo →
                      %mi f
                    %mover
                      %mo ←
                      %mi Ω
                  %mi CRing
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\Omega \dashv f) :  Mod \stackrel{\overset{\Omega}{\leftarrow}}{\underset{f}{\to}}
                  CRing
                  \\,.
          %h3#RModIsAbelian
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} R Mod
            is an abelian category
          %p
            Let the ambient
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            be
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            equipped with the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
          #RModIsAbelian.num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Mod
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            %p
              In fact
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Mod
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+category"} Grothendieck category
          %p We discuss now all the ingredients of this statement in detail.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mi R
                  %mi Mod
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} U : R Mod \to Set
            be the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            to the underlying sets.
          #RModHasZeroObject.num_prop
            %h6#proposition Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Mod
              has a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial group
              equipped with trivial
              = succeed "-action." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          .proof
            %h6#proof Proof
            %p
              Clearly the 0-module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} N \to 0
              has to send all elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              to the unique element of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              because a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"} 0 \to N
              always exists and is unique, as it has to send the unique element of 0, which is the neutral element, to the neutral element of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
          #RModHasKernelsAndCokernels.num_prop
            %h6#proposition_2 Proposition
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mi Mod
                      %annotation{:encoding => "application/x-tex"} R Mod
                  has all
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/kernels"} kernels
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %msub
                          %mi N
                          %mn 1
                        %mo →
                        %msub
                          %mi N
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} f : N_1 \to N_2
                  is the set-theoretic
                  %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi f
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(f)^{-1}(0)
                  equipped with the induced
                  = succeed "-module" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mi Mod
                      %annotation{:encoding => "application/x-tex"} R Mod
                  has all
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/cokernels"} cokernels
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %msub
                          %mi N
                          %mn 1
                        %mo →
                        %msub
                          %mi N
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} f : N_1 \to N_2
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
                  abelian group
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi coker
                        %mi f
                        %mo =
                        %mfrac
                          %mrow
                            %msub
                              %mi N
                              %mn 2
                          %mrow
                            %mi im
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        coker f = \frac{N_2}{im(f)}
                %p
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi N
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} N_2
                  by the
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
          .proof
            %h6#proof_2 Proof
            %p
              The defining
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of kernel and cokernels is immediately checked.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi R
                    %mi Mod
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U : R Mod \to Set
              preserves and reflects
              %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
              and
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/epimorphisms"} epimorphisms
            %p
              A homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi N
                      %mn 1
                    %mo →
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f : N_1 \to N_2
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Mod
              is a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              \/
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(f)
              is an
              %a.existingWikiWord{:href => "/nlab/show/injection"} injection
              \/
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
          .proof
            %h6#proof_3 Proof
            %p
              Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi N
                      %mn 1
                    %mo →
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f : N_1 \to N_2
              is such that for all morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo :
                    %mi K
                    %mo →
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} g_1, g_2 : K \to N_1
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %msub
                      %mi g
                      %mn 1
                    %mo =
                    %mi f
                    %mo ∘
                    %msub
                      %mi g
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \circ g_1 = f \circ g_2
              already
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 1
                      %mo =
                      %msub
                        %mi g
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} g_1 = g_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} g_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} g_2
              be the inclusion of
              %a.existingWikiWord{:href => "/nlab/show/submodules"} submodules
              generated by a single element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mn 1
                    %mo ∈
                    %mi K
                  %annotation{:encoding => "application/x-tex"} k_1 \in K
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mn 2
                      %mo ∈
                      %mi K
                    %annotation{:encoding => "application/x-tex"} k_2 \in K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi k
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi k
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(k_1) = f(k_2)
              then already
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mn 1
                    %mo =
                    %msub
                      %mi k
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} k_1 = k_2
              and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/injection"} injection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an injection then its image is a
              %a.existingWikiWord{:href => "/nlab/show/submodule"} submodule
              and it follows directly that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a monomorphism.
            %p
              Suppose now that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              and hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi N
                      %mn 1
                    %mo →
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f : N_1 \to N_2
              is such that for all morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo :
                    %msub
                      %mi N
                      %mn 2
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} g_1, g_2 : N_2 \to K
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %msub
                      %mi g
                      %mn 1
                    %mo =
                    %mi f
                    %mo ∘
                    %msub
                      %mi g
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \circ g_1 = f \circ g_2
              already
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 1
                      %mo =
                      %msub
                        %mi g
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} g_1 = g_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                    %mo :
                    %msub
                      %mi N
                      %mn 2
                    %mo →
                    %mfrac
                      %mrow
                        %msub
                          %mi N
                          %mn 2
                      %mrow
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g_1 : N_2 \to \frac{N_2}{im(f)}
              be the natural projection. and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 2
                    %mo :
                    %msub
                      %mi N
                      %mn 2
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} g_2 : N_2 \to 0
              be the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %msub
                      %mi g
                      %mn 1
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f \circ g_1 = 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %msub
                      %mi g
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f \circ g_2 = 0
              we have that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 1
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} g_1 = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi N
                      %mrow
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \frac{N}{im(f)} = 0
              and hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo =
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N = im(f)
              and so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is surjective. The other direction is evident on elements.
          #AbelianGroupStructureOnHoms.num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                    %mo ∈
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} N_1, N_2 \in R Mod
              two modules, define on the
              %a.existingWikiWord{:href => "/nlab/show/hom+set"} hom set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi R
                        %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{R Mod}(N_1,N_2)
              the structure of an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              whose addition is given by argumentwise addition in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} N_2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 1
                      %mo +
                      %msub
                        %mi f
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi n
                      %mo ↦
                      %msub
                        %mi f
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo +
                      %msub
                        %mi f
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f_1 + f_2) : n \mapsto f_1(n) + f_2(n)
          #RModIsAbEnriched.num_prop
            %h6#proposition_4 Proposition
            %p
              With def.
              %a.maruku-ref{:href => "#AbelianGroupStructureOnHoms"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Mod
              composition of morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∘
                    %mo :
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 2
                    %mo ,
                    %msub
                      %mi N
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\circ : Hom(N_1, N_2) \times Hom(N_2, N_3) \to Hom(N_1,N_3)
            %p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 2
                    %mo ,
                    %msub
                      %mi N
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(N_1, N_2) \otimes Hom(N_2,N_3) \to Hom(N_1, N_3)
            %p
              out of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
            %p
              This makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Mod
              into an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enriched category
          .proof
            %h6#proof_4 Proof
            %p Linearity of composition in the second argument is immediate from the pointwise definition of the abelian group structure on morphisms. Linearity of the composition in the first argument comes down to linearity of the second module homomorphism.
          .num_remark
            %h6#remark Remark
            %p
              In fact
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Mod
              is even a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+category"} closed category
              %a.maruku-ref{:href => "#RModIsClosedMonoidal"}
              below, but this we do not need for showing that it is abelian.
          %p
            Prop.
            %a.maruku-ref{:href => "#RModHasZeroObject"}
            and prop.
            %a.maruku-ref{:href => "#RModIsAbEnriched"}
            together say that:
          #RModIsAdditive.num_cor
            %h6#corollary Corollary
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Mod
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pre-additive+category"} pre-additive category
          #RModHasProductsAndCoproducts.num_prop
            %h6#proposition_5 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Mod
              has all
              %a.existingWikiWord{:href => "/nlab/show/products"} products
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              %a.existingWikiWord{:href => "/nlab/show/direct+products"} direct products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi N
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \prod_{i \in I} N_i
              and
              %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ⊕
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi N
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \oplus_{i \in I} N_i
            %p
              The products are given by
              %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
              of the underlying sets with componentwise addition and
              = succeed "-action." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            %p
              The direct sum is the
              %a.existingWikiWord{:href => "/nlab/show/submodule"} submodule
              of the direct product consisting of tuples of elements such that only finitely many are non-zero.
          .proof
            %h6#proof_5 Proof
            %p
              The defining
              %a.existingWikiWord{:href => "/nlab/show/universal+properties"} universal properties
              are directly checked. Notice that the direct product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi N
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \prod_{i \in I} N_i
              consists of arbitrary tuples because it needs to have a projection map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi j
                    %mo :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi N
                      %mi i
                    %mo →
                    %msub
                      %mi N
                      %mi j
                  %annotation{:encoding => "application/x-tex"}
                    p_j : \prod_{i \in I} N_i \to N_j
            %p
              to each of the modules in the product, reproducing all of a possibly infinite number of non-trivial maps
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi K
                      %mo →
                      %msub
                        %mi N
                        %mi j
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{K \to N_j\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi j
                    %mo :
                    %msub
                      %mi N
                      %mi j
                    %mo →
                    %msub
                      %mo ⊕
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi N
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_j : N_j \to \oplus_{i \in I} N_i
            %p
              and since, being a module, it needs to be closed only under addition of
              %em finitely
              many elements, so it consists only of
              %a.existingWikiWord{:href => "/nlab/show/linear+combinations"} linear combinations
              of the elements in the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mi j
                    %annotation{:encoding => "application/x-tex"} N_j
          %p
            Together cor.
            %a.maruku-ref{:href => "#RModIsAdditive"}
            and prop.
            %a.maruku-ref{:href => "#RModHasProductsAndCoproducts"}
            say that:
          #RModIsAdditive.num_cor
            %h6#corollary_2 Corollary
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Mod
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
          #InRModMonosAreKernelOfTheirCokernel.num_prop
            %h6#proposition_6 Proposition
            %p
              In
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Mod
            %ul
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  of its
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
                  of its
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
          .proof
            %h6#proof_6 Proof
            %p
              Using prop.
              %a.maruku-ref{:href => "#RModHasKernelsAndCokernels"}
              this is directly checked on the underlying sets: given a monomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo ↪
                      %mi N
                    %annotation{:encoding => "application/x-tex"} K \hookrightarrow N
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo →
                      %mfrac
                        %mi N
                        %mi K
                    %annotation{:encoding => "application/x-tex"} N \to \frac{N}{K}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo ↪
                      %mi N
                    %annotation{:encoding => "application/x-tex"} K \hookrightarrow N
          %p
            Now cor.
            %a.maruku-ref{:href => "#RModIsAdditive"}
            and prop.
            %a.maruku-ref{:href => "#InRModMonosAreKernelOfTheirCokernel"}
            imply theorem
            = succeed "," do
              %a.maruku-ref{:href => "#RModIsAbelian"}
          #FilteredColimitsInRModAreExact.num_prop
            %h6#proposition_7 Proposition
            %p
              The operation of forming
              %a.existingWikiWord{:href => "/nlab/show/filtered+colimits"} filtered colimits
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Mod
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact functor
          %p
            (e.g.
            %a{:href => "#Weibel94"} Weibel 1994, Lem. 2.6.14
            = succeed ")." do
              %a{:href => "#Kiersz"} Kiersz, prop. 4
          %h3#RModIsClosedMonoidalCategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} R Mod
            is a closed monoidal category
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
          #HomModule.num_defn
            %h6#definition_3 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mn 1
                      %mo ,
                      %msub
                        %mi N
                        %mn 2
                      %mo ∈
                      %mi R
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} N_1, N_2 \in R Mod
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi R
                        %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{R Mod}(N_1, N_2)
              with the structure of an
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo ∈
                      %msub
                        %mi Hom
                        %mrow
                          %mi R
                          %mi Mod
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi N
                        %mn 1
                      %mo ,
                      %msub
                        %mi N
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f,g \in Hom_{R Mod}(N_1, N_2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo ∈
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} n_1 \in N_1
              and all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} r \in R
              set
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo +
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi n
                          %mn 1
                        %mo ↦
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi n
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi g
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi n
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (f + g) \colon n_1 \mapsto f(n_1) + g(n_2)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi r
                        %mo ⋅
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi n
                          %mn 1
                        %mo ↦
                        %mi r
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi n
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} r \cdot f \colon n_1 \mapsto r\cdot (f(n_1))
                  \.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} [N_1,N_2] \in R Mod
              for the resulting
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          #RModIsClosedMonoidal.num_prop
            %h6#proposition_8 Proposition
            %p
              Equipped with the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} R Mod
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              (in fact a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/distributive+monoidal+category"} distributive monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              regarded canonically as an
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            %p
              This is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              is given by the hom-modules of def.
              = succeed "." do
                %a.maruku-ref{:href => "#HomModule"}
          .proof
            %h6#proof_7 Proof
            %p
              Either by definition or by a basic property of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi N
                      %mn 1
                    %msub
                      %mo ⊗
                      %mi R
                    %msub
                      %mi N
                      %mn 2
                    %mo →
                    %msub
                      %mi N
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \phi \colon N_1 \otimes_R N_2 \to N_3
              is precisely an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/bilinear+function"} bilinear function
              of the underlying sets. For fixed elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo ∈
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} n_1 \in N_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 2
                    %mo ∈
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} n_2 \in N_2
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ϕ
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi n
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi n
                      %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi N
                      %mn 2
                    %mo →
                    %msub
                      %mi N
                      %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{\phi}(n_1) \coloneqq \phi(n_1, -) \colon N_2 \to N_3
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi N
                      %mn 1
                    %mo →
                    %msub
                      %mi N
                      %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    \\phi(-,n_2) \colon N_1 \to N_3
            %p
              for the hom-
              %a.existingWikiWord{:href => "/nlab/show/adjuncts"} adjuncts
              on the underlying sets. By the bilinearity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              both of these are
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
