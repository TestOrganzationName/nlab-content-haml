                  %a{:href => "https://doi.org/10.1017/CBO9781139644136"} doi:10.1017/CBO9781139644136
                = succeed "&rbrack;" do
                  %a{:href => "https://web.math.rochester.edu/people/faculty/doug//otherpapers/weibel-hom.pdf"} pdf
            %li#Kiersz
              %p
                Andy Kiersz,
                = succeed "," do
                  %em Colimits and homological algebra
                = succeed ")" do
                  %a{:href => "http://www.math.uchicago.edu/~may/VIGRE/VIGRE2006/PAPERS/Kiersz.pdf"} pdf
          %p
            Discussion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Mod
                    %mi R
                %annotation{:encoding => "application/x-tex"} Mod_R
            in the generality of
            %a.existingWikiWord{:href => "/nlab/show/module+objects"} module objects
            over a
            %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+a+symmetric+monoidal+category"} commutative monoid object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            to a
            %a.existingWikiWord{:href => "/nlab/show/bicomplete+category"} bicomplete
            %a.existingWikiWord{:href => "/nlab/show/closed+symmetric+monoidal+category"} closed symmetric monoidal category
            and proof that it is itself
            %a.existingWikiWord{:href => "/nlab/show/bicomplete+category"} bicomplete
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/closed+symmetric+monoidal+category"} closed symmetric monoidal
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jeff+Smith"} Jeff Smith
                = succeed "," do
                  %em Symmetric spectra
                %strong 13
                (2000) 149-208 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/math/9801077"}> arXiv:math/9801077
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1090/S0894-0347-99-00320-3"} doi:10.1090/S0894-0347-99-00320-3
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Florian+Marty"}> Florian Marty
                , Prop. 1.2.14, 1.2.16, 1.2.17 in:
                = succeed "," do
                  %em Des Ouverts Zariski et des Morphismes Lisses en Géométrie Relative
                = succeed "," do
                  %a{:href => "https://www.theses.fr/2009TOU30071"} theses:2009TOU30071
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Marty-DesOuverts.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Brandenburg"}> Martin Brandenburg
                , Prop. 4.1.10:
                %em Tensor categorical foundations of algebraic geometry
                \&amp;lbrack;
                %a{:href => "http://arxiv.org/abs/1410.1716"}> arXiv:1410.1716
                \&amp;rbrack;
          %p See also:
          %ul
            %li
              %a{:href => "http://mathoverflow.net/questions/180673/category-of-modules-over-commutative-monoid-in-symmetric-monoidal-category"}> MO:180673
              \.
          %p Lecture notes:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              \:
              = succeed "," do
                %em
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#AlgebrasAndModules"} Algebras and Modules
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+Homotopy+Theory"} Introduction to Stable Homotopy Theory
              1.2:
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1-2"} Structured Spectra
          %p
