                          %mi X
                        %annotation{:encoding => "application/x-tex"} T_{hol} X
                  %a.existingWikiWord{:href => "/nlab/show/cochain+complexes"} cochain complexes
                  of
                  %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundles"} complex vector bundles
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi E
                          %mo •
                      %annotation{:encoding => "application/x-tex"} E^{\bullet}
                  over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  equipped with a
                  = succeed "-linear" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} \mathbb{C}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mo ∂
                            %mo{:stretchy => "false"} ¯
                          %mi E
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi E
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo •
                        %mo ⟶
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi E
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo •
                        %msub
                          %mo ⊗
                          %mrow
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi ℂ
                            %mo{:stretchy => "false"} )
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi T
                          %mi hol
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\bar \partial_E
                        \\;\colon\;
                        \\Gamma(E)^\bullet
                        \\longrightarrow
                        \\Gamma(E)^\bullet \otimes_{C^\infty(X,\mathbb{C})} CE(T_{hol}X)
                %p
                  that extend to a graded
                  %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi E
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo •
                          %msub
                            %mo ⊗
