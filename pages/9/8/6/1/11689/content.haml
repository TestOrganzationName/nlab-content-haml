                            %mi T
                            %mi hol
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \Gamma(E)^\bullet \otimes_{C^\infty(X,\mathbb{C})} CE(T_{hol}X)
              %li
                %p
