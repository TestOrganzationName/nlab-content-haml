                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi ℂ
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi Ω
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} (
