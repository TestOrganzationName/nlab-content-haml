                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CE(T_{hol} X) \coloneqq (\Omega^{0,\bullet}(X), \bar \partial)
            %p
              for its
              %a.existingWikiWord{:href => "/nlab/show/Dolbeault+complex"} Dolbeault complex
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/differential+graded+algebra"} differential graded algebra
              (the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              of its holomorphic
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
              %a.existingWikiWord{:href => "/nlab/show/dg-category"} dg-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mi hol
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Rep(T_{hol} X)
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are
                  %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid+representations"} ∞-Lie algebroid representations
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
