              are equivalently
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundles"} complex vector bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              which are equipped with a “holomorphically flat” connection
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∇
                    %annotation{:encoding => "application/x-tex"} \nabla
              %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mo ∂
                        %mo{:stretchy => "false"} ¯
                      %mi E
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
