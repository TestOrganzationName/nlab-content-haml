            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            with their
            %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-duality
            and
            %a.existingWikiWord{:href => "/nlab/show/U-duality"} U-duality
            symmetries (
            %a.existingWikiWord{:href => "/nlab/show/non-geometric+vacua"}> non-geometric vacua
            ).
          %ul
