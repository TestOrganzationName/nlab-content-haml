                          %annotation{:encoding => "application/x-tex"} \sigma
                %li
                  %a{:href => "#mirror_symmetry"} Mirror symmetry
                %li
                  %a{:href => "#geometry_of_supergravity"} Geometry of supergravity
          %h2#idea Idea
          %p
            %em Generalized complex geometry
            is the study of the geometry of
            %a.existingWikiWord{:href => "/nlab/show/symplectic+Lie+n-algebroid"} symplectic Lie 2-algebroid
            called
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/standard+Courant+algebroid"} standard Courant algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔠
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{c}(X)
            (over a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            This geometry of symplectic Lie 2-algebroids turns out to unify, among other things,
            %a.existingWikiWord{:href => "/nlab/show/complex+geometry"} complex geometry
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+geometry"} symplectic geometry
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-duality
          %h2#Definition Definition
          %h3#on_a_vector_space On a vector space
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a
            %a.existingWikiWord{:href => "/nlab/show/dimension"} finite dimensional
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            over the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
          %p
            Recall that a
            %em
              %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a
            %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo :
                  %mi V
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"}
                  J : V \to V
          %p
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ∘
                    %mi J
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi id
                      %mi V
                  %annotation{:encoding => "application/x-tex"} J \circ J = - id_V
            %a.existingWikiWord{:href => "/nlab/show/symplectic+structure"} symplectic structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is equivalently a linear
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo :
                  %mi V
                  %mo →
                  %msup
                    %mi V
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\omega : V \to V^*
          %p such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ω
                    %mo *
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi ω
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\omega^* = - \omega
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mo *
                %annotation{:encoding => "application/x-tex"} V^*
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual vector space
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ω
                    %mo *
                %annotation{:encoding => "application/x-tex"} \omega^*
            the dual linear map.
          %p The following definition may be thought of as combining these two concepts.
          .num_defn
            %h6#definition_2 Definition
            %p
              A
              %strong generalized complex structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is a
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒥
                    %mo :
                    %mi V
                    %mo ⊕
                    %msup
                      %mi V
                      %mo *
                    %mo →
                    %mi V
                    %mo ⊕
                    %msup
                      %mi V
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{J} : V \oplus V^* \to V \oplus V^*
            %p
              (an
              %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
              of the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              with its
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual vector space
            %p such that it is both
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex structure
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ⊕
                        %msup
                          %mi V
                          %mo *
                      %annotation{:encoding => "application/x-tex"} V \oplus V^*
                  in that
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝒥
                            %mn 2
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi id
                        %annotation{:encoding => "application/x-tex"} \mathcal{J}^2 = - id
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/symplectic+structure"} symplectic structure
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ⊕
                        %msup
                          %mi V
                          %mo *
                      %annotation{:encoding => "application/x-tex"} V \oplus V^*
                  in that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝒥
                            %mo *
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi 𝒥
                        %annotation{:encoding => "application/x-tex"} \mathcal{J}^* = - \mathcal{J}
          %p The following shows that this is indeed a joint generalization of complex and symplectic structures.
          .num_example
            %h6#examples Examples
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo :
                    %mi V
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} J : V \to V
              be an ordinary complex structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊕
                    %msup
                      %mi V
                      %mo *
                  %annotation{:encoding => "application/x-tex"} V \oplus V^*
              defined by
              %a.existingWikiWord{:href => "/nlab/show/matrix+calculus"} matrix calculus
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒥
                      %mi j
                    %mo :
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi J
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %msup
                                %mi J
                                %mo *
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{J}_j :=
                    \\left(
                    \\array{
                    \-J &amp; 0
                    \\\
                    0 &amp; J^*
                    }
                    \\right)
            %p
              is a generalized complex structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              Similarly, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo :
                    %mi V
                    %mo →
                    %msup
                      %mi V
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \omega : V \to V^*
              be an ordinary symplectic structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒥
                      %mi ω
                    %mo :
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msup
                                %mi ω
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                          %mtr
                            %mtd
                              %mi ω
                            %mtd
                              %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{J}_\omega :=
                    \\left(
                    \\array{
                    0 &amp; - \omega^{-1}
                    \\\
                    \\omega &amp; 0
                    }
                    \\right)
            %p
              is a generalized complex structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
          %h3#on_a_manifold On a manifold
          %p
            A generalized complex structure on a manifold is a generalized complex structure on the fibers of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/generalized+tangent+bundle"} generalized tangent bundle
          %p (…)
          %h3#in_terms_of_reduction_of_the_structure_group In terms of reduction of the structure group
          %p
            A generalized complex structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ⊕
                  %msup
                    %mi V
                    %mo *
                %annotation{:encoding => "application/x-tex"} V \oplus V^*
            is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/reduction+of+the+structure+group"} reduction of the structure group
            along the inclusion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo ,
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  U(n,n) \hookrightarrow O(2n,2n)
                  \\,,
          %p
            where the left hand is identified as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo ,
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ∩
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(n,n) = O(2n,2n) \cap GL(2n, \mathbb{C})
            (
            %a{:href => "#Gualtieri"}> Gualtieri, prop. 4.6
            ).
          %p
            The analog of this with the unitary group replaced by the orthogonal group yields
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/type+II+geometry"} type II geometry
          %h2#properties Properties
          %p
            One finds (as described at
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/standard+Courant+algebroid"} standard Courant algebroid
          %ul
            %li
              %p
                choices of sub-
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"}> Lie algebroid
                s of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔠
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{c}(X)
                encode (almost)
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+structure"}> Dirac structure
                  s
                and – after
                %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
                –
                = succeed ";" do
                  %strong
                    generalized
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex structure
            %li
              %p
                choices of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/section"} section
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔠
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mathfrak{c}(X) \to T X
                to the
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
                = succeed ":" do
                  %strong generalized Riemannian metrics
                = succeed "-)" do
                  %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+metric"} pseudo
                %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
                and a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/differential+form"} 2-form
              %p
                In applications in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
                %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
                and the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kalb%E2%80%93Ramond+field"} Kalb–Ramond field
                %a.existingWikiWord{:href => "/nlab/show/dilaton"} dilaton
                field appears in this context.)
          %p
            In components these are structures found on the
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                  %mo ⊕
                  %msup
                    %mi T
                    %mo *
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  T X \oplus T^* X
                  \\,,
          %p
            the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            with the cotangent bundle of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p Generalized complex geometry thus generalizes and unifies
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/complex+geometry"}> complex geometry
              ,
            %li
              %a.existingWikiWord{:href => "/nlab/show/symplectic+geometry"}> symplectic geometry
              , and
            %li
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+geometry"}> Riemannian geometry
              \.
          %p
            It was in particular motivated by the observation that this provides a natural formalism for describing
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-duality
          %h2#examples_2 Examples
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/generalized+Calabi-Yau+manifold"} generalized Calabi-Yau manifold
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/generalized+tangent+bundle"}> generalized tangent bundle
                ,
                %a.existingWikiWord{:href => "/nlab/show/generalized+vielbein"} generalized vielbein
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/type+II+geometry"} type II geometry
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/exceptional+generalized+geometry"} exceptional generalized geometry
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bn-geometry"} Bn-geometry
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/generalized+contact+geometry"} generalized contact geometry
          %h2#references References
          %h4#general General
          %p
            Generalized complex geometry was proposed by
            %a.existingWikiWord{:href => "/nlab/show/Nigel+Hitchin"} Nigel Hitchin
            as a formalism in
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            that would be suited to capture the phenomena that physicists encountered in the study of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-duality
          %p A standard reference is the PhD thesis
          %ul#Gualtieri
            %li
              %a.existingWikiWord{:href => "/nlab/show/Marco+Gualtieri"}> Marco Gualtieri
              ,
              %em Generalized complex geometry
              (
              %a{:href => "http://arxiv.org/abs/math/0401221"}> arXiv:math/0401221
              )
          %p
            A survey set of slides with an eye towards the description of the
            %a.existingWikiWord{:href => "/nlab/show/Kalb-Ramond+field"} Kalb-Ramond field
            and
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nigel+Hitchin"}> Nigel Hitchin
                ,
                %em B-Fields, gerbes and generalized geometry
                Oxford Durham Symposium 2005 (
                %a{:href => "http://www.maths.dur.ac.uk/events/Meetings/LMS/2005/GCFTST/Talks/hitchin1.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nigel+Hitchin"}> Nigel Hitchin
                ,
                %em Lectures on generalized geometry
                (
                %a{:href => "http://arxiv.org/abs/1008.0973"}> arxiv/1008.0973
                )
          %p
            With emphasis on the role of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/G-structures"} G-structures
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paul+Koerber"}> Paul Koerber
              ,
              = succeed "," do
                %em Lectures on Generalized Complex Geometry for Physicists
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1006.1536"} arXiv:1006.1536
          %p
            In relation to
            = succeed "::" do
              %a.existingWikiWord{:href => "/nlab/show/Cartan+geometry"} Cartan geometry
          %ul
            %li
              Falk Hassler, Ondrej Hulik, David Osten:
              %em Current Algebra and Generalised Cartan Geometry
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2409.00176"}> arXiv:2409.00176
              \&amp;rbrack;
          %h4#as_targets_for_models
            As targets for
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p
            Generalized complex structures may serve as
            %a.existingWikiWord{:href => "/nlab/show/target+spaces"} target spaces
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sigma-models"} sigma-models
            %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma-model"} Poisson sigma-model
            and the
            %a.existingWikiWord{:href => "/nlab/show/Courant+sigma-model"} Courant sigma-model
