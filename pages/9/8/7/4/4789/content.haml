                  \\,.
          %p
            Moreover, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo :
                  %mi 𝔤
                  %mo →
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mu : \mathfrak{g} \to b^{n-1}\mathbb{R}
            a degree-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi μ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp(\mu) : \exp(\mathfrak{g}) \to \exp(b^{n-1}\mathbb{R})
                  \\,.
          %p
            Under
            %a.existingWikiWord{:href => "/nlab/show/coskeleton"} coskeletization
            on the left this carves out the
            = succeed "s" do
