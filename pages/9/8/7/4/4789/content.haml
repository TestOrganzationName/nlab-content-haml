          %p
            which is the coefficient object for
            %em trivial
            principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-connection," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ")" do
              %a{:href => "http://nlab.mathforge.org/nlab/show/smooth+infinity-groupoid#StrucDeRham"} here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \to \mathbf{\flat}_{dR} \mathbf{B}^n U(1)
            correspond to trivial circle bundle with connection, hence to cocycles in
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi H
                              %mi dR
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mi n
                            %mo ≥
                            %mn 2
                        %mtr
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi cl
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mi n
                            %mo =
                            %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi_0 Smooth \infty Grpd(X, \mathbf{\flat}_{dR} \mathbf{B}^n U(1))
                  \=
                  \\left\{
                  \\array{
                  H_{dR}^n(X) &amp; n \geq 2
                  \\\
                  \\Omega^1_{cl}(X) &amp; n = 1
                  }
                  \\right.
                  \\,.
          %p This now allows us to construct differential refinements:
          %p
            one can show (detailed discussion is
            = succeed ")" do
              %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive%20(infinity,1)-topos#CurvatureCharacteristics"} here
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi curv
                  %mo :
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  curv : \mathbf{B}^n U(1) \to \mathbf{\flat}_{dR} \mathbf{B}^{n+1}
          %p
            in the degree
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(1)
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(1)
          %p
            Then for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi c
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{c} : \mathbf{B}G \to \mathbf{B}^n U(1)
            any smooth
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            %a.existingWikiWord{:href => "/nlab/show/differential+characteristic+class"} differential characteristic class
            is simply the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mi dR
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mover
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi curv
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{c}_{dR} : \mathbf{B}G \stackrel{\mathbf{c}}{\to}
                  \\mathbf{B}^n U(1)
                  \\stackrel{curv}{\to}
                  \\mathbf{\flat}_{dR} \mathbf{B}^{n+1} U(1)
                  \\,.
          %p
            The (unrefined)
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Weil+homomorphism"} ∞-Chern-Weil homomorphism
            is postcomposition with this morphism:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mi dR
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo :
                  %msup
                    %mi H
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi H
                    %mi dR
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\mathbf{c}_{dR})_* : H^1(X,G) \to H_{dR}^{n+1}(X)
                  \\,.
          %p This is finally where the Chern-Simons elements come in:
          .standout
            %p
              Chern-Simons elements are a means to
              %em present
              the composite morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mi dR
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}_{dR}
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctor"} ∞-anafunctor
              between smooth
              = succeed "es." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
          %p This presentation we describe in the next section.
          %p
            (In fact a bit more is true: the serve to present the refinement of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mi dR
                %annotation{:encoding => "application/x-tex"} \mathbf{c}_{dR}
            to a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}
            with values in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
          %h3#ChernSimonsForms Chern-Simons forms
          %p
            We explain now how Chern-Simons elements arise as a presentation of a
            %a.existingWikiWord{:href => "/nlab/show/differential+characteristic+class"} differential characteristic class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mi dR
                %annotation{:encoding => "application/x-tex"} \mathbf{c}_{dR}
            by a
            %a.existingWikiWord{:href => "/nlab/show/span"} span
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
          %p
            At the heart of the presentation of differenial characteristic classes by morphisms of simplicial presheaves is a differential refinement of the
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            an ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/coskeleton"} coskeleton
            of the simplicial presheaf that assigns flat
            %a.existingWikiWord{:href => "/nlab/show/vertical+differential+form"} vertical
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+1-form"} Lie algebra valued 1-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi Ω
                              %mrow
                                %mi si
                                %mo ,
                                %mi vert
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ×
                            %msup
                              %mi Δ
                              %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msub
                                  %mi A
                                  %mi vert
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\exp(\mathfrak{g}) :
                  (U,[k])
                  \\mapsto
                  \\left\{
                  \\array{
                  \\Omega^\bullet_{si, vert}(U \times \Delta^k)
                  \&amp;\stackrel{A_{vert}}{\leftarrow}&amp;
                  CE(\mathfrak{g})
                  }
                  \\right\}
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of the
            %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            integrating
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi cosk
                    %mn 3
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≃
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{cosk}_3 \exp(\mathfrak{g}) \stackrel{\simeq}{\to}
                  \\mathbf{B}G
                  \\,.
          %p
            Similarly the
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            of the
            %a.existingWikiWord{:href => "/nlab/show/line+Lie+n-algebra"} line Lie n-algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} b^{n-1}\mathbb{R}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi Ω
                              %mrow
                                %mi si
                                %mo ,
                                %mi vert
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ×
                            %msup
                              %mi Δ
                              %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ←
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\exp(b^{n-1}\mathbb{R})
                  \:
                  (U,[k])
                  \\mapsto
                  \\left\{
                  \\array{
                  \\Omega^\bullet_{si,vert}(U \times \Delta^k)
                  \&amp;\leftarrow&amp;
                  CE(b^{n-1}\mathbb{R})
                  }
                  \\right\}
          %p
            is the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≃
