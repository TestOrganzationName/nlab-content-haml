          %h3#higher_csforms_on_semisimple_lie_algebras Higher CS-forms on semisimple Lie algebras
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo ∈
                  %mi CE
