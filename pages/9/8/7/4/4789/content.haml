                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
                  as differential forms on the total space of the universal
                  = succeed "-bundles;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
                  as differential forms on the fiber
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi inv
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} inv(\mathfrak{g})
                  as differential forms on the base space
            %p
              then the abov expresses the classical notion of transgression of forms from the fiber to the base of a fibe bundle (for instance
              = succeed ")." do
                %a{:href => "#Borel"} Borel, section 9
          %h2#properties Properties
          %h3#uniqueness Uniqueness
          .num_pop
            %h6#observation_2 Observation
            %p
              For a given transgressive cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              and transgressing invariant polynomial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle - \rangle
              the set of Chern-Simons elements witnessing the
              %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
              is a
              %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
              (based over the point and) over the additive
              %a.existingWikiWord{:href => "/nlab/show/group"} group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi ω
                    %mo ∈
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi d
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mi ω
                    %mo =
                    %mn 0
                    %mo ,
                    %msup
                      %mi i
                      %mo *
                    %mi ω
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\{\omega \in W(\mathfrak{g}) | d_{W(\mathfrak{g})} \omega = 0, i^* \omega = 0\}
            %p of Chern-Simons elements for vanishing cocycle and vanishing invariant polynomial.
          %h3#CanonicalChernSimonsElement
            Canonical
            = succeed "-Chern-Simons" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Since the
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            of an
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            has trivial cohomolgy in positive degree, every
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -,\cdots, -\rangle
            has a Chern-Simons element and there is a standard formula for it.
          .num_pop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              be an
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              with
              = succeed "-ary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi k
                    %mo :
                    %msup
                      %mi 𝔤
                      %mrow
                        %mo ⊗
                        %mi k
                    %mo →
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} [-,\cdots, -]_k : \mathfrak{g}^{\otimes k} \to \mathfrak{g}
              and equipped with a quadratic
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
            %p
              A Chern-Simons element for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle-,-\rangle
              is given by the formula
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cs
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi A
                    %mo ,
                    %msub
                      %mi d
                      %mi dR
                    %mi A
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 1
                      %mn ∞
                    %mfrac
                      %mn 2
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo !
                    %mo{:stretchy => "false"} ⟨
                    %mi A
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi k
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    cs(A) =
                    \\langle A, d_{dR} A\rangle
                    +
                    \\sum_{k = 1}^\infty
                    \\frac{2}{(k+1)!}
                    \\langle A, [A,\cdots,A]_k\rangle
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo :
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A : W(\mathfrak{g}) \to \Omega^\bullet(\Sigma)
              is any
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %a.existingWikiWord{:href => "/nlab/show/infinity-Lie+algebroid-valued+differential+form"} valued form
          .proof
            %h6#proof Proof
            %p
              There is a canonical contracting
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo :
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau : W(\mathfrak{g}) \to W(\mathfrak{g})
            %p
              satisfying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi d
                      %mi W
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi Id
                  %annotation{:encoding => "application/x-tex"} [d_W, \tau] = Id
            %p and the above element is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cs
                    %mo =
                    %mi τ
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    cs = \tau \langle -,-\rangle
                    \\,.
            %p
              To see this, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi t
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t_a\}
              be a
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi t
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t^a\}
              the dual basis. Then the differential of the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              can be written
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi t
                      %mi a
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 1
                      %mn ∞
                    %mfrac
                      %mn 1
                      %mrow
                        %mi k
                        %mo !
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo ,
                    %msub
                      %mi t
                      %mrow
                        %msub
                          %mi a
                          %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi t
                      %mrow
                        %msub
                          %mi a
                          %mi k
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi t
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo ∧
                    %msup
                      %mi t
                      %mrow
                        %msub
                          %mi a
                          %mn 2
                    %mo ∧
                    %mi ⋯
                    %msup
                      %mi t
                      %mrow
                        %msub
                          %mi a
                          %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE(\mathfrak{g})} t^a
                    \=
                    \-
                    \\sum_{k = 1}^\infty
                    \\frac{1}{k!}
                    [t_{a_1}, t_{a_2}, \cdots, t_{a_k}]^a
                    \\,\,
                    t^{a_1} \wedge t^{a_2}\wedge \cdots t^{a_k}
                    \\,,
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %msup
                      %mi 𝔤
                      %mrow
                        %msub
                          %mo ⊗
                          %mi k
                    %mo →
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"}
                    [-,-, \cdots, -] : \mathfrak{g}^{\otimes_k} \to \mathfrak{g}
            %p
              is the corresponding
              = succeed "-ary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mrow
                        %mi a
                        %mi b
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi t
                      %mi a
                    %mo ,
                    %msub
                      %mi t
                      %mi b
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    P_{a b} := \langle t_a , t_b\rangle
                    \\,,
            %p
              for the components of the
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
              in this basis.
            %p Then the claim is that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cs
                    %mo =
                    %mn 2
                    %msub
                      %mi P
                      %mrow
                        %mi a
                        %mi b
                    %msup
                      %mi t
                      %mi a
                    %mo ∧
                    %msub
                      %mi d
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi t
                      %mi b
                    %mo +
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 1
                      %mn ∞
                    %msub
                      %mi C
                      %mrow
                        %mi a
                        %msub
                          %mi b
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi b
                          %mi k
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi t
                      %mi a
                    %mo ∧
                    %msup
                      %mi t
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %msup
                      %mi t
                      %mrow
                        %msub
                          %mi b
                          %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    cs
                    \=
                    2 P_{a b} t^a \wedge d_{W(\mathfrak{g})} t^b
                    +
                    \\sum_{k = 1}^\infty
                    C_{a b_1, \cdots, b_k}
                    \\,\,
                    t^a \wedge t^{b_1} \wedge \cdots \wedge t^{b_k}
                    \\,,
            %p where the coefficients are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mi a
                        %msub
                          %mi b
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi b
                          %mi k
                    %mo :
                    %mo =
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo !
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi P
                      %mrow
                        %mi a
                        %mi b
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi t
                      %mrow
                        %msub
                          %mi b
                          %mi k
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C_{a b_1, \cdots, b_k}
                    \:=
                    \\frac{1}{(k+1)!}
                    (P_{a b} [t_{b_1}, \cdots, t_{b_k}]^b)
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(\mathfrak{g})
              for the
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              on the
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi t
                        %mi a
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %msup
                        %mi t
                        %mi a
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{t^a, \mathbf{d}t^a\}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F(\mathfrak{g}) \stackrel{\simeq}{\to} W(\mathfrak{g})
            %p
              given by sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi t
                      %mi a
                    %mo ↦
                    %msup
                      %mi t
                      %mi a
                  %annotation{:encoding => "application/x-tex"} t^a \mapsto t^a
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %msup
                        %mi t
                        %mi a
                      %mo ↦
                      %msub
                        %mi d
                        %mi CE
                      %msup
                        %mi t
                        %mi a
                      %mo +
                      %msup
                        %mi r
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \mathbf{d}t^a \mapsto d_{CE} t^a + r^a
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} h : F(\mathfrak{g}) \to F(\mathfrak{g})
              be the
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              which on generators is defined by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %msup
                      %mi t
                      %mi a
                    %mo ↦
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    h : t^a \mapsto 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi t
                      %mi a
                    %mo ↦
                    %msup
                      %mi t
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    h : \mathbf{d}t^a \mapsto t^a
                    \\,.
            %p
              Notice that this is
              %em not
              the homotopy that exhibits the triviality of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Id
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi 𝔤
                            %mo *
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Id_{F(\mathfrak{g}^*)}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mn 1
                        %mi L
                      %mi h
                    %annotation{:encoding => "application/x-tex"} \frac{1}{L} h
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is the word length operator for element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(\mathfrak{g}^*)
              in terms of the generators
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi t
                        %mi a
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %msup
                        %mi t
                        %mi a
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{t^a , \mathbf{d}t^a\}
            %p
              Therefore the homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
              is the composite top morphism in the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mi τ
                          %mtd
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mfrac
                                  %mn 1
                                  %mi L
                                %mi h
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    W(\mathfrak{g}) &amp;\stackrel{\tau}{\to}&amp; W(\mathfrak{g})
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \&amp;&amp;
                    \\uparrow^{\mathrlap{\simeq}}
                    \\\
                    F(\mathfrak{g}) &amp;\stackrel{\frac{1}{L} h}{\to}&amp; F(\mathfrak{g})
                    }
                    \\,.
            %p Unwinding this, we find
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi cs
                          %mtd
                            %mo :
                            %mo =
                            %mi τ
                            %mrow
                              %mo (
                              %msub
                                %mi P
                                %mrow
                                  %mi a
                                  %mi b
                              %msup
                                %mi r
                                %mi a
                              %mo ∧
                              %msup
                                %mi r
                                %mi b
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi P
                              %mrow
                                %mi a
                                %mi b
                            %mi τ
                            %mrow
                              %mo (
                              %msub
                                %mi d
                                %mrow
                                  %mi W
                                  %mo{:stretchy => "false"} (
                                  %mi 𝔤
                                  %mo{:stretchy => "false"} )
                              %msup
                                %mi t
                                %mi a
                              %mo +
                              %munderover
