                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo ∧
                    %mi η
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S : (X, \eta) \mapsto \int_\Sigma (\eta \wedge d X + \pi(\eta \wedge \eta)
                    \\,.
          .proof
