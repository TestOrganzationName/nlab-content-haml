                                    %mn 1
                                %mi ℝ
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↑
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↑
                            %mtr
