                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is equivalently a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi W
                    %mo{:stretchy => "false"} (
                    %msup
