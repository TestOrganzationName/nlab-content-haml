                      \\Omega^\bullet_{si}(U \times \Delta^k)
                      \&amp;\stackrel{\omega}{\leftarrow}&amp;
                      W(b^{n-1} \mathbb{R})
                      }
                      \\right\}
                      \\,,
              %p
                where on the right we have the set of horizontal morphisms in
                %a.existingWikiWord{:href => "/nlab/show/dgAlg"} dgAlg
                that make a
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                with the canonical vertical morphisms as indicated.
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi n
