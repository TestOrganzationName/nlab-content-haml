                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathbf{B}^n U(1)_{diff} &amp;\to&amp; \mathbf{\flat}_{dR} \mathbf{B}^{n+1}U(1)_{sim}
                  \\\
                  \&amp;&amp; \downarrow^{\mathrlap{\simeq}}
