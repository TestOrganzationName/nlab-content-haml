                                %mi ℝ
                                %mo{:stretchy => "false"} )
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{B}^n U(1)_{diff} :
                      (U \in SmoothMfd, [k] \in \Delta)
                      \\mapsto
                      \\left\{
                      \\array{
                      \\Omega^\bullet_{si,vert}(U \times \Delta^k)
                      \&amp;\leftarrow&amp; CE(b^{n-1} \mathbb{R})
                      \\\
