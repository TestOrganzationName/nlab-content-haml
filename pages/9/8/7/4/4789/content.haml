                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi Δ
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mrow
