                    %annotation{:encoding => "application/x-tex"} curv : \mathbf{B}^n U(1) \to \mathbf{\flat}_{dR} \mathbf{B}^{n+1} U(1)
                is presented on this by the
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctor"} ∞-anafunctor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi n
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi diff
                            %mtd
                              %mo →
                            %mtd
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mo ♭
                                %mi dR
                              %msup
