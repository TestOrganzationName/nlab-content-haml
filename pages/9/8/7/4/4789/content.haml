            with the groupoid of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} with connection
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection on a bundle
            ).
          %p
            In particular if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = U(1)
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} X\to \mathbf{B}U(1)_{conn}
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle bundle with connection
          %p
            This allows already to consider a simple case of a
            %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            and its refinement to a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/differential+characteristic+class"} differential characteristic class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            be the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mn 1
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{c}_1 : \mathbf{B}U \to \mathbf{B}U(1)
            given by the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mn 1
                  %mo :
                  %mi SmoothGrpd
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi SmoothGrpd
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{c}_1 : SmoothGrpd(- ,\mathbf{B}U) \to SmoothGrpd(-, \mathbf{B} U(1))
          %p
            is a smooth representative of the
            %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            called the
            %em
              first
              %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
            \. Its differential refinement is the evident morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi U
                    %mi conn
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\hat \mathbf{c}_1 : \mathbf{B}U_{conn} \to \mathbf{B}U(1)_{conn}
          %p
            that sends a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔲
                  %annotation{:encoding => "application/x-tex"} \mathfrak{u}
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+1-form"} valued differential form
            to the
            %a.existingWikiWord{:href => "/nlab/show/trace"} trace
            of its Lie algebra value. Postcomposition with this is the refined
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi SmoothGrpd
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mover
                                  %mstyle{:mathvariant => "bold"}
                                    %mi c
                                  %mo{:stretchy => "false"} ^
                                %mn 1
                        %mtd
                          %mi SmoothGrpd
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo ≃
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo ≃
                      %mtr
                        %mtd
                          %mi U
                          %msub
                            %mi Bund
                            %mo ∇
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %msub
                            %mi Bund
                            %mo ∇
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  SmoothGrpd(X, \mathbf{B}U)_{conn}
                  \&amp;\stackrel{\hat \mathbf{c}_1}{\to}&amp;
                  SmoothGrpd(X, \mathbf{B}U(1)_{conn})
                  \\\
                  \\downarrow^{\mathrlap{\simeq}} &amp;&amp; \downarrow^{\mathrlap{\simeq}}
                  \\\
                  U Bund_\nabla(X) &amp;\to&amp; U(1) Bund_\nabla(X)
                  }
          %p
            with values in circle bundles with connection, hence in degree-2
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
          %p
            It is this kind of construction on
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo{:stretchy => "false"} ^
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}_1
          %p
            A general abstract context for
            %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
            equipped with
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            is a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %em cohesive structure
            , such as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} smooth cohesive structure
          %p
            An example for such is the
            = succeed "-analog" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/stack"} stack
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-topos"} (2,1)-topos
            over
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf+%28%E2%88%9E%2C1%29-topos"} ∞-stack (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo :
                    %mo =
                    %msub
                      %mover
                        %mi Sh
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi SmoothMfd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} := \hat Sh_{(\infty,1)}(SmoothMfd)
          %p
            In that context we have for instance all the higher
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            %a{:href => ""} circle Lie (n+1)-groups
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}^n U(1) \in Smooth\infty Grpd
                  \\,.
          %p
            This is such that the evident generalizations of the above classification statements hold: we have that morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}^n U(1)
            form an
            %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} n-groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Bund
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Smooth\infty Grpd(X, \mathbf{B}^n U(1))
                  \\simeq
                  U(1) (n-1)Bund(X)
          %p
            equivalent to that of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundles
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            If here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X = \mathbf{B}G
            is again the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}G \to \mathbf{B}^n U(1)
                  \\,.
          %p
            For instance for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi Spin
                %annotation{:encoding => "application/x-tex"} G = Spin
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
            has a smooth incarnation given by a morphism of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi p
                    %mn 1
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi Spin
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{2}\mathbf{p}_1 : \mathbf{B} Spin \to \mathbf{B}^3 U(1)
          %p
            corresponding under the above equivalence to the ordinary
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+circle+3-bundle"} Chern-Simons circle 3-bundle
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            comes canonically and essentially uniquely equipped with
            %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive%20(infinity,1)-topos#Structures"} all the intrinsic structure
            that we need for the discussion of a refinement of this to
            = succeed "es:" do
              %a.existingWikiWord{:href => "/nlab/show/differential+characteristic+class"} differential characteristic class
          %p
            There is an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} endo-(∞,1)-adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi Π
                  %mo ⊣
                  %mstyle{:mathvariant => "bold"}
                    %mo ♭
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                  %mo →
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"}
                  (\mathbf{\Pi} \dashv \mathbf{\flat}) : Smooth\infty Grpd \to
                  Smooth \infty Grpd
          %p where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}(X)
                is the
                %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive%20(infinity,1)-topos#Paths"} path ∞-groupoid
                of a
                %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{\flat}\mathbf{B}G
                is the coefficient object for
                %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive%20(infinity,1)-topos#FlatDifferentialCohomology"} flat ∞-connections
                on
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}(X) \to \mathbf{B}^n U(1)
            encodes the flat
            %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
            of a flat
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} n-groupoid
            of morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
