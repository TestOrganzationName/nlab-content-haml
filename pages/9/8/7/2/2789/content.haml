          %h2#discussion_20 Discussion 2.0
          %p
            %a.existingWikiWord{:href => "/nlab/show/Eric"}> Eric
            \: This discussion began when I asked the following questions:
          %blockquote
            %p
              %a.existingWikiWord{:href => "/nlab/show/Eric"}> Eric
              \: For some reason, I always thought a natural transformation was a more general map between functors
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo :
                      %mi F
                      %mo ⇒
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \alpha:F\Rightarrow G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                    %mspace{:width => "1em"}
                    %mtext and
                    %mspace{:width => "1em"}
                    %mi G
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                    %mo .
                  %annotation{:encoding => "application/x-tex"} F:A\to B\quad\text{and}\quad G:C\to D.
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} \alpha(F):C\to D
              is a functor and we’d probably also want
              %strong 2-component
              functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi C
                    %mo :
                    %mi A
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \alpha_C:A\to C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi D
                    %mo :
                    %mi B
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} \alpha_D:B\to D
              such that the following diagram commutes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mi F
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %msub
                                  %mi α
                                  %mi C
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mi α
                          %mo ⇓
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %msub
                                  %mi α
                                  %mi D
                      %mtr
                        %mtd
                          %mi C
                        %mtd
                          %mover
                            %mo →
                            %mi G
                        %mtd
                          %mi D
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A
                  \&amp;
                  \\stackrel{F}{\to}
                  \&amp;
                  B
                  \\\
                  \\mathllap{\scriptsize{\alpha_C}}\downarrow
                  \&amp;\mathllap{\scriptsize{\alpha}}\Downarrow &amp;
                  \\downarrow\mathrlap{\scriptsize{\alpha_D}}
                  \\\ C
                  \&amp;
                  \\stackrel{G}{\to} &amp; D
                  }
          %blockquote
            %p If this is not a natural transformation, is there another name for it?
            %p
              When
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A = C
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo =
                      %mi D
                    %annotation{:encoding => "application/x-tex"} B = D
          %p
            %a.existingWikiWord{:href => "/nlab/show/Eric"}> Eric
            \: I hope to pick up where we left off because I was making some progress understanding some of this stuff.
          %p
            I like the above concept, but I’m still trying to find the right label for it. The standard definition of
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            involves a map between functors (sharing the same domain and codomain) together with
            = succeed "." do
              %strong component morphisms
            = succeed "." do
              %strong component functors
          %p
            This seems to be a natural thing to do, especially when thinking of functors as maps between morphisms, together with component morphisms, as put forward at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functor+%28discussion%29"} functor (discussion)
          %p From there, it is a skip away from thinking of morphisms as maps between objects together with component objects. Hmmm…
          %p The whole thing just wants to bumped up incrementally in dimension.
          %h3#functor_revisited Functor Revisited
          %h4#definition_experimental Definition (Experimental)
          %p
            Given categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and inclusion maps
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi A
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                    %mo ⊔
                    %mi B
                  %annotation{:encoding => "application/x-tex"} i_A:A\to A\sqcup B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi B
                    %mo :
                    %mi B
                    %mo →
                    %mi A
                    %mo ⊔
                    %mi B
                  %annotation{:encoding => "application/x-tex"} i_B:B\to A\sqcup B
            %strong functor
            is a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} F:A\to B
            together with component morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi x
                  %mo :
                  %msub
                    %mi i
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi i
                    %mi B
                  %mo ∘
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha_x:i_A(x)\to i_B\circ F(x)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi y
                  %mo :
                  %msub
                    %mi i
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi i
                    %mi B
                  %mo ∘
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha_y:i_A(y)\to i_B\circ F(y)
            for any morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi x
                  %mo →
                  %mi y
                %annotation{:encoding => "application/x-tex"} f:x\to y
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            such that the following diagram commutes:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi i
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi i
                                %mi A
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi i
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %msub
                                  %mi α
                                  %mi x
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mi F
                          %mo ⇓
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %msub
                                  %mi α
                                  %mi y
                      %mtr
                        %mtd
                          %msub
                            %mi i
                            %mi B
                          %mo ∘
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi i
                                %mi B
                              %mo ∘
                              %mi F
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi i
                            %mi B
                          %mo ∘
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  i_A(x)
                  \&amp;
                  \\stackrel{i_A(f)}{\to}
                  \&amp;
                  i_A(y)
                  \\\
                  \\mathllap{\scriptsize{\alpha_x}}\downarrow
                  \&amp;\mathllap{F}\Downarrow &amp;
                  \\downarrow\mathrlap{\scriptsize{\alpha_y}}
                  \\\ i_B\circ F(x)
                  \&amp;
                  \\stackrel{i_B\circ F(f)}{\to} &amp; i_B\circ F(y)
                  }
          %p For a less cluttered diagram, we can omit the obvious inclusion maps and look at
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi x
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi y
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %msub
                                  %mi α
                                  %mi x
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mi F
                          %mo ⇓
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %msub
                                  %mi α
                                  %mi y
                      %mtr
                        %mtd
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi F
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  x
                  \&amp;
                  \\stackrel{f}{\to}
                  \&amp;
                  y
                  \\\
                  \\mathllap{\scriptsize{\alpha_x}}\downarrow
                  \&amp;\mathllap{F}\Downarrow &amp;
                  \\downarrow\mathrlap{\scriptsize{\alpha_y}}
                  \\\ F(x)
                  \&amp;
                  \\stackrel{F(f)}{\to} &amp; F(y)
                  }
          %p
            %img{:src => "http://ncatlab.org/nlab/files/alt_functor.jpg", :width => "250"}/
          %h2#discussion_10 Discussion 1.0
          %p
            %a.existingWikiWord{:href => "/nlab/show/Eric"}> Eric
            \: For some reason, I always thought a natural transformation was a more general map between functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %mi F
                    %mo ⇒
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \alpha:F\Rightarrow G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                  %mspace{:width => "1em"}
                  %mtext and
                  %mspace{:width => "1em"}
                  %mi G
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                  %mo .
                %annotation{:encoding => "application/x-tex"} F:A\to B\quad\text{and}\quad G:C\to D.
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} \alpha(F):C\to D
            is a functor and we’d probably also want
            %strong 2-component
            functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi C
                  %mo :
                  %mi A
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \alpha_C:A\to C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi D
                  %mo :
                  %mi B
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} \alpha_D:B\to D
            such that the following diagram commutes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mi F
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %msub
                                  %mi α
                                  %mi C
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mi α
                          %mo ⇓
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %msub
                                  %mi α
                                  %mi D
                      %mtr
                        %mtd
                          %mi C
                        %mtd
                          %mover
                            %mo →
                            %mi G
                        %mtd
                          %mi D
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A
                  \&amp;
                  \\stackrel{F}{\to}
                  \&amp;
                  B
                  \\\
                  \\mathllap{\scriptsize{\alpha_C}}\downarrow
                  \&amp;\mathllap{\scriptsize{\alpha}}\Downarrow &amp;
                  \\downarrow\mathrlap{\scriptsize{\alpha_D}}
                  \\\ C
                  \&amp;
                  \\stackrel{G}{\to} &amp; D
                  }
          %p If this is not a natural transformation, is there another name for it?
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mi C
                %annotation{:encoding => "application/x-tex"} A = C
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                    %mi D
                  %annotation{:encoding => "application/x-tex"} B = D
          %p
            %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
            \: I suppose your 2-arrow in the middle labeled
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is supposed to be a natural transformation (in the standard sense)?
          %p
            Then this is a square in the 2-category of categories. Such squares appear in turn as the
            %em components
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/lax+natural+transformation"} lax natural transformation
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
          %p
            %a.existingWikiWord{:href => "/nlab/show/Eric"}> Eric
            \: Thanks. I was hesitant to put that 2-arrow in there. I’m still learning this stuff and am on shaky ground. But no. That 2-arrow is not supposed to be a natural transformation in the traditional sense because it is not a map between functors with the same domain and codomain. It is tempting to say we might want
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi D
                  %mo ∘
                  %mi F
                  %mo ⇒
                  %msub
                    %mi α
                    %mi C
                  %mo ∘
                  %mi G
                %annotation{:encoding => "application/x-tex"} \alpha_D\circ F\Rightarrow\alpha_C\circ G
            to be a natural transformation in the traditional sense though.
          %p
            %em> Toby
            \: That arrow certainly
            %em looks
            to me like a
            = succeed "-arrow" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi D
                  %mo ∘
                  %mi F
                %annotation{:encoding => "application/x-tex"} \alpha_D\circ F
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi C
                    %mo ∘
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \alpha_C\circ G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mo ⇒
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \alpha\colon F \Rightarrow G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi D
                  %mo ∘
                  %mi F
                %annotation{:encoding => "application/x-tex"} \alpha_D\circ F
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi C
                    %mo ∘
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \alpha_C\circ G
            %strong square
            of functors. If something more interesting, see my answer at
            %a.existingWikiWord{:href => "/ericforgy/published/Natural+Transformation"} Natural Transformation
            (which I saw first).
          %p
            %em> Todd
            \: Here’s one way of considering how the standard notion of natural transformation is the “right” one. Just as in topology we would like to consider the “space of all continuous maps
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to Y
          %p
            In the end, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi C
                %annotation{:encoding => "application/x-tex"} D^C
            denotes the functor category, the universal property provides an equivalence between functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msup
                    %mi D
                    %mi C
                %annotation{:encoding => "application/x-tex"} X \to D^C
            and functors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} X \times C \to D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi C
                %annotation{:encoding => "application/x-tex"} D^C
            should look like. In an ordinary category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            corresponds to a functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{2} \to Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{2}
            is a category with two objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ,
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 0, 1
            and exactly one nonidentity arrow
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 0 \to 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi C
                %annotation{:encoding => "application/x-tex"} D^C
            should correspond to functors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mo →
                    %msup
                      %mi D
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{2} \to D^C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mo ×
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} \mathbf{2} \times C \to D
          %p This is how you know the notion of natural transformation is morally the “right” one.
          %p
            %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
            \: I added above a subsection on this characterization in terms of the cartesian closed monoidal structure on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
          %p
            %a.existingWikiWord{:href => "/nlab/show/Eric"}> Eric
            \: I think I got it.
          %p
            Given two functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} F:A\to B
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} G:C\to D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi F
                  %mo ⇒
                  %mi G
                %annotation{:encoding => "application/x-tex"} \alpha:F\Rightarrow G
            together with component functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi C
                  %mo :
                  %mi A
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \alpha_C:A\to C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi D
                  %mo :
                  %mi B
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} \alpha_D:B\to D
            be a map such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi D
                  %mo ∘
                  %mi F
                  %mo ⇒
                  %mi G
                  %mo ∘
                  %msub
                    %mi α
                    %mi C
                %annotation{:encoding => "application/x-tex"} \alpha_D\circ F\Rightarrow G\circ\alpha_C
          %p is a natural transformation (in the standard sense). Does this guy have a name?
          %p
            The reason why I bring this up is that I do not like bigons. Bigons are not a good shape for doing computational geometry, geometric realization, etc. So before I could finally grok what a
            %a.existingWikiWord{:href => "/nlab/show/cone"} cone
            was, I had to draw a bunch of diagrams. These diagrams were bigons. Yucky!
          %p
            Thanks Todd. That was a valiant effort, but didn’t manage to convince me (I have a thick skull!). I still like this more general definition. Given topological spaces
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ,
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ,
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} W,X,Y,Z
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo →
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (W\to X)\Rightarrow (Y\to Z)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo =
                  %mi Y
                %annotation{:encoding => "application/x-tex"} W=Y
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} X=Z
          %p Here is my attempt to formalize an alternative definition:
          %hr/
          %blockquote
            %h2#definition Definition
            %p
              Given categories
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              and functors
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} F:A\to B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
