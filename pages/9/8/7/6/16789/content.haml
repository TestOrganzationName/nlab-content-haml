                    %semantics
                      %mrow
                        %msubsup
                          %mi ℤ
                          %mn 2
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2^2
                %td{:style => "text-align: left;"}
