              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo =
                  %mfrac
                    %mn 1
                    %mi R
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi j
                      %mo =
                      %mn 1
                    %mn 5
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi j
                      %mo −
                      %mn 1
                  %msub
                    %mi x
                    %mi j
                  %mi d
                  %msub
                    %mi x
                    %mn 1
                  %mo ∧
                  %mi …
                  %mo ∧
                  %mover
                    %mrow
                      %mi d
                      %msub
                        %mi x
                        %mi j
                    %mo ^
                  %mo ∧
                  %mi …
                  %mo ∧
                  %mi d
                  %msub
                    %mi x
                    %mn 5
                %annotation{:encoding => "application/x-tex"}
                  \\omega = \frac{1}{R} \sum_{j=1}^{5} (-1)^{j-1} x_j d x_1 \wedge \ldots \wedge \widehat{d x_j} \wedge \ldots \wedge d x_{5}
          %p
            where the hat means omit that factor. This is equal to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mi d
                    %mi r
                  %annotation{:encoding => "application/x-tex"} \ast d r
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} \ast
            is the
            %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 5
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^5
            for the Euclidean
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} metric
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi r
                %annotation{:encoding => "application/x-tex"} d r
            is the
            %a.existingWikiWord{:href => "/nlab/show/exterior+derivative"} exterior derivative
            of the radius function.
          %p
            The volume of the manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 4
                %annotation{:encoding => "application/x-tex"} S^4
            with this volume form is then given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 8
                    %msup
                      %mi π
                      %mn 2
                    %msup
                      %mi R
                      %mn 4
                    %mo{:stretchy => "false"} /
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 8\pi^2R^4/3
          %h3#CosetSpaceStructure Coset space structure
          %p
            As any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
            %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
            has the
            %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 4
                  %mo ≃
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mn 5
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 5
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 5
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Pin
                  %mo{:stretchy => "false"} (
                  %mn 5
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi Pin
                  %mo{:stretchy => "false"} (
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  S^4 \simeq O(5)/O(4) \simeq SO(5)/SO(4) \simeq Spin(5)/Spin(4)\simeq Pin(5)/Pin(4).
          %p There is also this:
          #Sp2Sp1BySp1Sp1Sp1IsS4.num_example
            %h6#example Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
              of
              %a.existingWikiWord{:href => "/nlab/show/Sp%282%29.Sp%281%29"} Sp(2).Sp(1)
              (
              %a{:href => "SpnSp1#SpnSp1"}> this Def.
              ) by
              %a.existingWikiWord{:href => "/nlab/show/Sp%281%29Sp%281%29Sp%281%29"} Sp(1)Sp(1)Sp(1)
              (
              %a{:href => "SpnSp1#Spin4Spin3"}> this Def.
              ) is the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mi Sp
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi Sp
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi Sp
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi Sp
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi Sp
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 4
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    Sp(2)\cdot Sp(1)
                    }
                    {
                    Sp(1)Sp(1)Sp(1)
                    }
                    \\;\simeq\;
                    S^4
                    \\,.
            %p
              This follows essentially from the
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+Hopf+fibration"} quaternionic Hopf fibration
              and its
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sp
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sp(2)
              = succeed "\u2026" do
                %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariance
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#BettiolMendes15"} Bettiol-Mendes 15, (3.1), (3.2), (3.3)
          %h3#HomotopyGroups Homotopy groups
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            of the 4-sphere in low degree are:
          %table
            %thead
              %tr
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %th 0
                %th 1
                %th 2
                %th 3
                %th 4
                %th 5
                %th 6
                %th 7
                %th 8
                %th 9
                %th 10
                %th 11
                %th 12
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mi k
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 4
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_k(S^4)
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                %td{:style => "text-align: left;"} 0
                %td{:style => "text-align: left;"} 0
                %td{:style => "text-align: left;"} 0
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
