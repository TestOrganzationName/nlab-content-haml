          .num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝔤
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \hat \mathfrak{g} \to \mathfrak{g}
              be a
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+extension"} Lie algebra extension
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              of a finite dimensional Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo ⟶
                    %mi b
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \longrightarrow b \mathbb{R}
              be the corresponding
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+cohomology"} L-∞ 2-cocycle
              with coefficients in the
              %a.existingWikiWord{:href => "/nlab/show/line+Lie+n-algebra"} line Lie 2-algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} b \mathbb{R}
              = succeed ")" do
                %a.existingWikiWord{:href => "/schreiber/show/The+brane+bouquet"} FSS 13, prop. 3.5
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝔤
                      %mo{:stretchy => "false"} ^
                    %mo ⟶
                    %mi 𝔤
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi ω
                          %mn 2
                    %mi b
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\hat \mathfrak{g}
                    \\longrightarrow
                    \\mathfrak{g}
                    \\overset{\omega_2}{\longrightarrow}
                    b \mathbb{R}
            %p which is dually modeled by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi 𝔤
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ⊕
                    %mo{:stretchy => "false"} ⟨
                    %mi e
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi d
                      %mover
                        %mi 𝔤
                        %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi 𝔤
                          %mo *
                    %mo =
                    %msub
                      %mi d
                      %mi 𝔤
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi d
                      %mover
                        %mi 𝔤
                        %mo{:stretchy => "false"} ^
                    %mi e
                    %mo =
                    %msub
                      %mi ω
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CE(\hat \mathfrak{g})
                    \=
                    ( \wedge^\bullet ( \mathfrak{g}^\ast \oplus \langle e \rangle ), d_{\hat \mathfrak{g}}|_{\mathfrak{g}^\ast} = d_{\mathfrak{g}},\;  d_{\hat \mathfrak{g}} e = \omega_2)
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a space with
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
