                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 24
                        %mo ×
                        %msub
                          %mi ℤ
                          %mn 3
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_{24} \times \mathbb{Z}_3
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 15
