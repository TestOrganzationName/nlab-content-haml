              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational
              %a.existingWikiWord{:href => "/nlab/show/minimal+dg-modules"} minimal dg-modules
              for the maps (via Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CircleActionOn4Sphere"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
