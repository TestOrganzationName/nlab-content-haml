                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
