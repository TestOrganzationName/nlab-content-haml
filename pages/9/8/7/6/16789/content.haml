                      %annotation{:encoding => "application/x-tex"} \mathbb{Z} \times \mathbb{Z}_{12}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi ℤ
                          %mn 2
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2^2
