            is a
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SU(2)
            (i.e. an
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/ADE+classification"} ADE group
            %a.existingWikiWord{:href => "/nlab/show/action"} acting
            via the identification
