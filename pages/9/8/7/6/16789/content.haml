          %h4#m5brane_orbifolds M5-brane orbifolds
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetric
            %a.existingWikiWord{:href => "/nlab/show/Freund-Rubin+compactifications"} Freund-Rubin compactifications
            of
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            which are
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
            of 7-dimensional
            %a.existingWikiWord{:href => "/nlab/show/anti-de+Sitter+spacetime"} anti-de Sitter spacetime
            with a compact 4-dimensional
            %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi AdS
                    %mn 7
                  %mo ×
                  %msub
                    %mi X
                    %mn 4
                %annotation{:encoding => "application/x-tex"}
                  AdS_7 \times X_4
          %p
            (the
            %a.existingWikiWord{:href => "/nlab/show/near+horizon+geometry"} near horizon geometry
            of a
            %a.existingWikiWord{:href => "/nlab/show/black+brane"} black
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 4
                  %mo ≃
                  %msup
                    %mi S
                    %mn 4
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  X_4 \simeq S^4//G
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
