              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %strong cohesive site
            is a small
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            whose
            %a.existingWikiWord{:href => "/nlab/show/topos+of+sheaves"} topos of sheaves
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
          %h2#Definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+site"} small
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/site"} site
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              equipped with a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              %strong cohesive site
              if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  has a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              %li
                %p
                  The coverage on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  makes it a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/locally+connected+site"} locally connected site
                  %a.existingWikiWord{:href => "/nlab/show/cover"} covering
                  %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
                  on an object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} U\in C
                  is
                  %a.existingWikiWord{:href => "/nlab/show/connected+category"} connected
                  as a
                  %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                          %mo{:stretchy => "false"} /
                          %mi U
                        %annotation{:encoding => "application/x-tex"} C/U
              %li
                %p
                  Every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} U\in C
                  admits a
                  %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                          %mo →
                          %mi U
                        %annotation{:encoding => "application/x-tex"} *\to U
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/cosifted+category"} cosifted category
                %p
                  (for instance in that it has all
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
                  = succeed ")." do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/categories+with+finite+products+are+cosifted"} categories with finite products are cosifted
          %h2#properties Properties
          %h3#SheavesOnACohesiveSiteAreCohesive Sheaves on a cohesive site are cohesive
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a cohesive site, the
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(C)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
              over
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              for which
              %em
                %a.existingWikiWord{:href => "/nlab/show/pieces+have+points"} pieces have points
              \.
          .proof
            %h6#proof Proof
            %p
              Following the notation at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Disc
                    %mo ⊣
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi Const
                    %mo ⊣
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    (Disc \dashv \Gamma)
                    \\coloneqq
                    (L Const \dashv \Gamma)
                    \\;\colon\;
                    Sh(C) \to Set
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              constructs
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+object"} discrete object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Π
                      %mn 0
                    %mo ⊣
                    %mi Disc
                    %mo ⊣
                    %mi Γ
                    %mo ⊣
                    %mi CoDisc
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi_0 \dashv Disc \dashv \Gamma \dashv CoDisc)
                    \\;\colon\;
                    Sh(C) \to Set
            %p
              and show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Pi_0
              preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi X
                    %mo →
                    %msub
                      %mi Π
                      %mn 0
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Gamma X \to \Pi_0 X
              is an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Firstly, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+connected+site"} locally connected site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              has a further
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              given by taking
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi op
                    %annotation{:encoding => "application/x-tex"} C^{op}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \Pi_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(C)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+connected+topos"} locally connected topos
            %p
              Moreover, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cosifted+category"} cosifted
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Pi_0
              preserves finite products. In particular,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(C)
              is
              %a.existingWikiWord{:href => "/nlab/show/connected+topos"} connected
              and even
              = succeed "." do
                %em strongly connected
            %p
              Next, we claim that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+site"} local site
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
              is
              = succeed "," do
                %em cover-irreducible
              %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
              must contain its identity map. But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a locally connected site, every covering family is inhabited, and since every object has a global section, every covering sieve must include a global section. In the case of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} *
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a local site, and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(C)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+topos"} local topos
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Codisc
                  %annotation{:encoding => "application/x-tex"} Codisc
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is defined by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CoDisc
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi A
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo ,
                        %mi U
                        %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi A
                      %mrow
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CoDisc(A)(U) = A^{C(*,U)} = A^{\Gamma(U)}
                    \\,.
            %p
              We now claim that the transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Codisc
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(A) \to Codisc(A)
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monic"} monic
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} U\in C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Codisc
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(A)(U) \to Codisc(A)(U)
              is just the
              %a.existingWikiWord{:href => "/nlab/show/diagonal+morphism"} diagonal
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %msup
                      %mi A
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo ,
                        %mi U
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A \to A^{C(*,U)}
            %p
              which is monic since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(*,U)
              is always inhabited (by assumption on
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          %h3#aufhebung Aufhebung
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            over a cohesive site satisfies
            %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
            of the
            %a.existingWikiWord{:href => "/nlab/show/unity+of+opposites"} moments
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/becoming"} becoming
            %em
              %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
            the section
            %em
              %a{:href => "http://ncatlab.org/nlab/show/Aufhebung#ExamplesBecomingFormalization"} Aufhebung of becoming – Over cohesive sites
          %h2#examples Examples
          %h3#cohesive_presheaf_sites Cohesive presheaf sites
          %p
            Consider a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            equipped with the trivial coverage/topology. Then the
            %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the
            %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Sh(C) \simeq PSh(C)
          %p
            and trivially every constant presheaf is a sheaf. So we always have an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            of functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Π
                    %mn 0
                  %mo ⊣
                  %mi Disc
                  %mo ⊣
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Set
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (\Pi_0 \dashv Disc \dashv \Gamma) : Sh(C) \to Set
                  \\,,
          %p where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \Pi_0
                is the functor that takes
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo :
                      %msup
                        %mi C
                        %mi op
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} X : C^{op} \to Set
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 0
                      %mi X
                      %mo =
                      %mrow
                        %munder
                          %mi lim
                          %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"}
                      \\Pi_0 X = {\lim_\to} X
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
                is the functor that takes
                = succeed "s;" do
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mi X
                      %mo =
                      %mrow
                        %munder
                          %mi lim
                          %mo ←
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma X = {\lim_\leftarrow} X
                      \\,.
          %p
            The condition that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \Pi_0
            preserves finite products is precisely the condition that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cosifted+category"} cosifted category
          %p In conclusion we have
          .num_prop
            %h6#proposition_2 Proposition
            %p A small category equipped with the trivial coverage/topology is a cohesive site if
            %ul
              %li
                %p
                  it is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/cosifted+category"} cosifted
              %li
                %p
                  has a
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} *
              %li
                %p
                  every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  has a
                  %a.existingWikiWord{:href => "/nlab/show/global+element"} global element
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                          %mo →
                          %mi U
                        %annotation{:encoding => "application/x-tex"} * \to U
            %p
              The first two conditions ensure that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(C) = PSh(C)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
              %em cohesive pieces have points
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(C)
          %h3#sites_of_open_balls Sites of open balls
          %p
            Any full small subcategory of
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            on
            %a.existingWikiWord{:href => "/nlab/show/connected"} connected
            topological spaces with the canonical induced
            %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
            is a cohesive site. If a subcategory on
            %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
            spaces, then this is also an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-cohesive+site"} (∞,1)-cohesive site
          %p Specifically we have:
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The categories
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              and
              %a.existingWikiWord{:href => "/nlab/show/ThCartSp"} ThCartSp
              equipped with the standard
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              are cohesive sites.
          %p The axioms are readily checked.
          %p
            Notice that the cohesive topos over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ThCartSp
                %annotation{:encoding => "application/x-tex"} ThCartSp
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
          .num_prop
            %h6#proposition_4 Proposition
            %p
              The cohesive concrete objects of the cohesive topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(CartSp)
              are precisely the
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            for more on this.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/locally+connected+topos"} locally connected topos
                \/
                %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected (∞,1)-topos
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/connected+topos"} connected topos
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} ∞-connected (∞,1)-topos
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/strongly+connected+topos"} strongly connected topos
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/strongly+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} strongly ∞-connected (∞,1)-topos
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/totally+connected+topos"} totally connected topos
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/totally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} totally ∞-connected (∞,1)-topos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/local+topos"} local topos
                \/
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/local+%28%E2%88%9E%2C1%29-topos"} local (∞,1)-topos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
                \/
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
          %p and
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/locally+connected+site"} locally connected site
                \/
                %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+site"} locally ∞-connected site
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/connected+site"} connected site
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+site"} ∞-connected site
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/strongly+connected+site"} strongly connected site
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/strongly+%E2%88%9E-connected+site"} strongly ∞-connected site
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/totally+connected+site"} totally connected site
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/totally+%E2%88%9E-connected+site"} totally ∞-connected site
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/local+site"} local site
                \/
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-local+site"} ∞-local site
            %li
              %p
                %strong cohesive site
                \/
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive site
          %h2#references References
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              \: §3.4.2.1 in:
