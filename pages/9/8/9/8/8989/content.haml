                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
                %em
                  %a.existingWikiWord{:href => "/nlab/show/topological+interior"} topological interior
                as a co-closure operator on a power set that preserves finite meets, or dually as a closure operator on the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/opposite+poset"} opposite
                of a power set that preserves finite
                %a.existingWikiWord{:href => "/nlab/show/joins"} joins
                (given by
                %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
                of subsets).
            %li
              %p
