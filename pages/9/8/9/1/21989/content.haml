            %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            (see also
            = succeed ")" do
              %a{:href => "#Ravenel86"} Ravenel 86, Section 6.5
            %a.existingWikiWord{:href => "/nlab/show/Ravenel%27s+conjectures"} Ravenel's conjectures
            (notably the
            = succeed ");" do
              %a.existingWikiWord{:href => "/nlab/show/nilpotence+theorem"} nilpotence theorem
            = succeed "." do
