                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\underset{
                  \\underset{n}{\longrightarrow}
                  }{lim}
                  M \Omega^2 SU(n)
                  \\simeq
                  M \Omega^2 SU
                  \\simeq
                  M U
                  \\,.
          %p
            Hence the
            %a.existingWikiWord{:href => "/nlab/show/tower"} tower
            of Ravenel’s spectra interpolates between the
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            and
            %a.existingWikiWord{:href => "/nlab/show/MU"} MU
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
