            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mi i
                      %mi SU
                      %mo ≔
                      %munder
                        %mi SU
                        %munder
                          %mo ⟶
                          %mi k
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(n) \overset{i}{\longrightarrow} SU \coloneqq \underset{\underset{k}{\longrightarrow}} SU(k)
                is the
                %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
                of
                %a.existingWikiWord{:href => "/nlab/show/SU%28n%29"} SU(n)
