                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                (
                %a{:href => "#Hopkins84"}> Hopkins 84, 1.2
                ,
                = succeed ")" do
                  %a{:href => "#Ravenel86"} Ravenel 86, 6.5.2
              – or rather, for the most part, of
              %a.existingWikiWord{:href => "/nlab/show/Ravenel%27s+spectrum"} Ravenel's
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectra"} Thom spectra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X(n)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(m)
              (
