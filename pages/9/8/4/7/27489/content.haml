          %h2#definition Definition
          %p
            By the
            %em spherical braid group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Br
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Br_n(S^2)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            = succeed "," do
              %em sphere braid group
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/surface+braid+group"} surface braid group
            %a.existingWikiWord{:href => "/nlab/show/surface"} surface
            in question is the
            %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Br
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi π
                    %mn 1
                  %msub
                    %mi Conf
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Br_n(S^2)
                  \\;\simeq\;
                  \\pi_1
                  Conf_n(S^2)
                  \\,,
          .float_right_image{:style => "margin: -60px 0px 20px 25px"}
            %img{:src => "/nlab/files/BraidOn2Sphere.png", :width => "150px"}/
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(-)
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"}
                configuration space of
                = succeed "-points" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Conf
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Conf_n(-)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
          %p
            Illustrated on the right is the element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mn 2
                  %msub
                    %mi b
                    %mn 1
                  %mo ∈
                  %msub
                    %mi Br
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} b_2 b_1 \in Br_3(S^2)
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mi i
                %annotation{:encoding => "application/x-tex"} b_i
            denote the
            = succeed "," do
              %a{:href => "braid+group#ArtinPresentation"} Artin braid generators
            = succeed ".)" do
              %a.maruku-ref{:href => "#AsQuotientOfPlainBraidGroup"}
          %p
            %br/
          %p#NotAnMCG
            %strong Beware
            that the spherical
            = succeed "-braid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 3
                %annotation{:encoding => "application/x-tex"} n \geq 3
            are
            %em not
            %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
            to the
            %a.existingWikiWord{:href => "/nlab/show/mapping+class+groups"} mapping class groups
            of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/punctured"} punctured
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
            = succeed "." do
              %a{:href => "mapping+class+group#MappingClassGroupsOfNPuncturedSpheres"} there
          .float_right_image{:style => "margin: -55px 0px 20px 25px"}
            %figure{:style => "margin: 0 0 0 0"}
              %img{:src => "/nlab/files/KernelofSphericalBraidGroupToMCG.jpg", :width => "150px"}/
              %figcaption{:style => "text-align: center"}
                (
                %a{:href => "#FarbMargalit12"}> Farb-Margalit '12 Fig. 9.6
                )
          %p
            The generalized Birman sequence (
            %a{:href => "braid+group#GenBirmanSequenceForTrivialPi"}> here
            ), which would superficially imply such isomorphism, does not apply to punctured spheres, since its assumption is violated: The map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 2
                  %mo ≃
                  %msub
                    %mi π
                    %mn 1
                  %msup
                    %mi Diff
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi Br
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_2 \simeq \pi_1 Diff^{+}(S^2) \longrightarrow Br_n(S^2)
            is not trivial, whence the actual mapping class group is the
            %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
            of this
            = succeed "-inclusion" do
              %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
            = succeed ")," do
              %a{:href => "#FarbMargalit12"} Farb &amp; Margalit 2012 (9.1)
          %h2#properties Properties
          .float_right_image{:style => "margin: -30px 0px 20px 25px"}
            %figure{:style => "margin: 0 0 0 0"}
              %img{:src => "/nlab/files/RelationInSphericalBraidGroup.png", :width => "100px"}/
              %figcaption{:style => "text-align: center"}
                (from
                = succeed ")" do
                  %a{:href => "https://math.stackexchange.com/q/136821/58526"} math.SE:q/136821
          %p
          #AsQuotientOfPlainBraidGroup.num_prop
            %h6 Proposition
            %p
              The spherical braid group is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
              of the ordinary
              %a.existingWikiWord{:href => "/nlab/show/braid+group"} braid group
              by one further relation:
            #eq:ArtinPresentation.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Br
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Br
                      %mi n
                    %mo{:stretchy => "false"} /
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mn 1
                    %msub
                      %mi b
                      %mn 2
                    %mi ⋯
                    %msub
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ⋯
                    %msub
                      %mi b
                      %mn 2
                    %msub
                      %mi b
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Br_n(S^2)
                    \\;\simeq\;
                    Br_n/
                    \\big(
                    (b_1 b_2 \cdots b_{n-1})(b_{n-1} \cdots b_2 b_1)
                    \\big)
                    \\,,
            %p
              where the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mi i
                  %annotation{:encoding => "application/x-tex"} b_i
              denote the
              = succeed "." do
                %a{:href => "braid+group#ArtinPresentation"} Artin braid generators
            %p
              Moreover, the canonical map from the plain braid group to the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sym
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Sym_n
              factors through the corresponding quotient
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
            %svg{:height => "62.028pt", :version => "1.2", :viewbox => "0 0 137.571 62.028", :width => "137.571pt", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
              %defs
                %g
                  %symbol{:id => "Q_2Hg_HUJ8x3rPNi1wBibis2KxI=-glyph0-0", :overflow => "visible"}
