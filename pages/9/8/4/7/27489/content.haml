                %path{:d => "M -44.459974 10.795812 L -21.575652 -10.74354 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.984571,0,0,-0.984571,68.574802,30.535498)"}
                %path{:d => "M -2.167705 2.533192 C -1.772981 1.013994 -0.890876 0.296839 -0.00165767 0.000491294 C -0.889141 -0.295452 -1.772522 -1.012541 -2.169445 -2.535865 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.716896,0.674806,0.674806,-0.716896,45.606326,39.489752)"}
                %path{:d => "M -2.166902 2.534538 C -1.772179 1.01534 -0.887354 0.295296 -0.000855093 0.00183695 C -0.888339 -0.294106 -1.771719 -1.011195 -2.168642 -2.534519 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.716896,0.674806,0.674806,-0.716896,47.50328,41.275331)"}
                %path{:d => "M 29.525262 9.601606 L 2.463202 -10.783215 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.984571,0,0,-0.984571,68.574802,30.535498)"}
                %path{:d => "M -2.16618 2.534406 C -1.770994 1.014814 -0.887729 0.294857 -0.00199373 0.000213919 C -0.889747 -0.294715 -1.774413 -1.014176 -2.169562 -2.534508 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(-0.786417,0.592367,0.592367,0.786417,72.892837,39.727575)"}
                %path{:d => "M -2.169061 2.535252 C -1.770706 1.013273 -0.89061 0.295703 0.000681512 0.00184183 C -0.889458 -0.296256 -1.771738 -1.012548 -2.169274 -2.536049 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(-0.786417,0.592367,0.592367,0.786417,70.811945,41.295023)"}
            %p
          (
          %a{:href => "#FadellVanBuskirk61"}> Fadell &amp; Van Buskirk 1961 p 245, 255
          , cf.
          = succeed ")" do
            %a{:href => "#Tan24"} Tan 2024 §3.1
          %p
          #GroupOrder.num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi Br
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \vert Br_n(S^2) \vert
              of the spherical braid group is:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n = 2
                  (cf. Ex.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#SphericalBraidsOnTwoStrands"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 12
                      %annotation{:encoding => "application/x-tex"} 12
                  for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo =
                          %mn 3
                        %annotation{:encoding => "application/x-tex"} n =3
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ≥
                          %mn 4
                        %annotation{:encoding => "application/x-tex"} n \geq 4
            %p
          (
          %a{:href => "#FadellVanBuskirk61"}> Fadell &amp; VanBuskirk 1961 p 255
          )
          %h2#examples Examples
          %p
          #SphericalBraidsOnTwoStrands.num_remark
            %h6 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
              strands the ordinary
              %a.existingWikiWord{:href => "/nlab/show/braid+group"} braid group
              is
              %a.existingWikiWord{:href => "/nlab/show/free+group"} free
              on the single Artin generator
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} b_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Br
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi b
                      %mn 1
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Br_2 \;\simeq\; \langle b_1 \rangle \,\simeq\, \mathbb{Z}
                    \\,,
            %p
              but the spherical braid group on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
              strands is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+two"} cyclic of order 2
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:ArtinPresentation"} (1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Br
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi b
                      %mn 1
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} /
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi b
                      %mn 1
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ≕
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi C
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Br_2(S^2)
                    \\;\simeq\;
                    \\langle b_1\rangle/\big(b_1^2\big) \,\simeq\,
                    \\mathbb{Z}/2 \,\eqqcolon\, C_2
                    \\,.
            %p
              Geometrically, the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
              of the ordinary braid group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Br
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} Br_2
              is the braid on two strands which makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              %em half
              rotations in itself. But on the sphere, one full rotation (two half rotations) of one point around another may be contracted to a loop constant on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/antipode"} antipodal point
          (cf.
          %a{:href => "#FadellVanBuskirk61"} Fadell &amp; VanBuskirk 1961 p 254
          and Prop.
          = succeed ")" do
            %a.maruku-ref{:href => "#GroupOrder"}
          %h2#references References
          %ul
            %li#FadellVanBuskirk61
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Fadell"}> Edward Fadell
                , James Van Buskirk:
                = succeed "," do
                  %em
                    On the braid groups of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi E
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} E^2
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} S^2
                %strong 67
                2 (1961) 211-213 &amp;lbrack;
                %a{:href => "https://projecteuclid.org/journals/bulletin-of-the-american-mathematical-society/volume-67/issue-2/On-the-braid-groups-of-E2-and-S2/bams/1183524083.full"}> euclid:bams/1183524083
                \&amp;rbrack;
            %li#FarbMargalit12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Benson+Farb"}> Benson Farb
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dan+Margalit"} Dan Margalit
                = succeed "," do
                  %em A primer on mapping class groups
                = succeed "," do
                  %a{:href => "https://press.princeton.edu/books/hardcover/9780691147949/a-primer-on-mapping-class-groups"} ISBN:9780691147949
                = succeed "," do
                  %a{:href => "https://www.jstor.org/stable/j.ctt7rkjw"} jstor:j.ctt7rkjw
                = succeed "&rbrack;" do
                  %a{:href => "http://euclid.nmu.edu/~joshthom/Teaching/MA589/farbmarg.pdf"} pdf
            %li#Tan24
              %p
                Cindy Tan:
                = succeed "," do
                  %em Smallest nonabelian quotients of surface braid groups
                %strong 24
                (2024) 3997-4006 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2301.01872"}> arXiv:2301.01872
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.2140/agt.2024.24.3997"} doi:10.2140/agt.2024.24.3997
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/representation+theory"} representation theory
            of the spherical braid group:
          %ul
            %li
              V. G. Bardakov:
              = succeed "," do
                %em Linear Representations of the Braid Groups of Some Manifolds
              %strong 85
              (2005) 41–48 &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/s10440-004-5584-6"}> doi:10.1007/s10440-004-5584-6
              \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
            of spherical braid groups:
          %ul
            %li#GoncalvesGuaschi11
              %a.existingWikiWord{:href => "/nlab/show/Daciberg+Lima+Gon%C3%A7alves"}> Daciberg Lima Gonçalves
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/John+Guaschi"} John Guaschi
              = succeed "," do
                %em The classification of the virtually cyclic subgroups of the sphere braid groups
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1110.6628"} arXiv:1110.6628
              = succeed "," do
                %a{:href => "https://doi.org/10.1007/978-3-319-00257-6"} doi:10.1007/978-3-319-00257-6
              = succeed "&rbrack;" do
                %a{:href => "https://link.springer.com/content/pdf/bbm%3A978-3-319-00257-6%2F1.pdf"} pdf
