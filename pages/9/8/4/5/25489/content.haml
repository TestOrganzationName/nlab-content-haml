          %h2#idea Idea
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %a.existingWikiWord{:href => "/nlab/show/structures"} structures
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presenting
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
