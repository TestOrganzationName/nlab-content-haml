          %p (…)
          %h2#Properties Properties
          %p We consider some properties of model category
          #eq:ModelCategoryOfSpectraInISpaces.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi{:mathvariant => "normal"} Sp
                    %mi ℛ
                    %mi Σ
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi ModCat
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{Sp}^\Sigma_{\mathcal{R}}
                  \\;\;
                  \\in
                  \\;\;
                  ModCat
          %p
            of parameterized
            %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
            in
            %a.existingWikiWord{:href => "/nlab/show/I-space"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} \mathcal{I}
              \-spaces
            based on
            %a.existingWikiWord{:href => "/nlab/show/SimplicialSets"} SimplicialSets
            and equipped with the absolute/positive local model structures.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                  %mo ≔
                  %mi sSet
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{S} \coloneqq sSet
          %p
            as given in
            = succeed ":" do
              %a{:href => "#HebestreitSagaveSchlichtkrull20"} Hebestreit, Sagave &amp; Schlichtkrull (2020)
          %p
          .num_prop
            %h6 Proposition
            %p
              With the
              %a.existingWikiWord{:href => "/nlab/show/external+tensor+product"} external
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
              the model category
              %a.maruku-eqref{:href => "#eq:ModelCategoryOfSpectraInISpaces"} (1)
            %ol
              %li
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
                  %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              %li
                %p
                  with
                  %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
                  the
                  %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒮
                        %annotation{:encoding => "application/x-tex"} \mathcal{S}
              %li
                %p
                  which satisfies the
                  %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout-product axiom
              %li
                %p
                  and the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/unit+axiom"} unit axiom
            %p
              hence is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
          .proof
            %h6 Proof
            %p
              The first statements are made explicit in
              = succeed "." do
                %a{:href => "#HebestreitSagaveSchlichtkrull20"} HSS, Prop. 4.5 &amp; Prop. 5.11
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝕊
                      %mi t
                      %mi ℐ
                    %mo{:stretchy => "false"} [
                    %mo *
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_t^{\mathcal{I}}[\ast]
              (hidden on
              = succeed ")" do
                %a{:href => "https://arxiv.org/pdf/1904.01824.pdf#page=38"} p. 38
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝕊
                      %mi t
                      %mi ℐ
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_t^{\mathcal{I}}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
              = succeed "." do
                %a{:href => "#HebestreitSagaveSchlichtkrull20"} HSS, Lem. 5.12
          %p
          .num_prop
            %h6 Proposition
            %p
              The inclusion of
              %a.existingWikiWord{:href => "/nlab/show/I-spaces"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℐ
                    %annotation{:encoding => "application/x-tex"} \mathcal{I}
                \-spaces
              via their
              %a.existingWikiWord{:href => "/nlab/show/zero-spectrum+bundles"} zero-spectrum bundles
              is a
              %a.existingWikiWord{:href => "/nlab/show/bireflective+subcategory"} bireflective subcategory
              (according to
              = succeed ")" do
                %a{:href => "bireflective+subcategory#BireflectiveSubcategory"} this Def.
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+triple"} Quillen adjoint triple
            #eq:BireflectionOfZeroSpectrumBundles.maruku-equation
