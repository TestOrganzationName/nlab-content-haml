          .proof
            %h6 Proof
            %p
              This may be recognized from
              = succeed "." do
                %a{:href => "#HebestreitSagaveSchlichtkrull20"} HSS, Lem. 3.19 &amp; Cor. 5.13
          %p
          .num_defn
            %h6 Definition
            %p In the following we will leave the inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mover
                      %mo ↪
                      %mi const
                    %msup
                      %mi 𝒮
                      %mi ℐ
                    %mover
                      %mo ↪
                      %mn 0
                    %msubsup
                      %mi{:mathvariant => "normal"} Sp
                      %mi ℛ
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}
                    \\overset{const}{\hookrightarrow}
                    \\mathcal{S}^{\mathcal{I}}
                    \\overset{0}{\hookrightarrow}
                    \\mathrm{Sp}^\Sigma_\mathcal{R}
            %p
              notationally implicit. For example, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              we write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi{:mathvariant => "normal"} Sp
                      %mi ℛ
                      %mi Σ
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi B
                  %annotation{:encoding => "application/x-tex"} \big(\mathrm{Sp}^\Sigma_\mathcal{R}\big)_{/B}
              for the
              %a.existingWikiWord{:href => "/nlab/show/slice+model+structure"} slice model structure
              of
              %a.maruku-eqref{:href => "#eq:ModelCategoryOfSpectraInISpaces"} (1)
              over the
              %a.existingWikiWord{:href => "/nlab/show/zero-spectrum+bundle"} zero-spectrum bundle
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
          %p
            The model category
            %a.maruku-eqref{:href => "#eq:ModelCategoryOfSpectraInISpaces"} (1)
            is not quite
            %a.existingWikiWord{:href => "/nlab/show/right+proper"} right proper
            (cf.
            = succeed ")" do
              %a{:href => "https://arxiv.org/pdf/1904.01824.pdf#page=40"} pp. 40
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
          %p
          #QuillenRightBaseChange.num_prop
            %h6 Proposition
            %p
              Left
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              along
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibrations"} Kan fibrations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi B
                      %mn 1
                    %mo →
                    %msub
                      %mi B
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \,\colon\, B_1 \to B_2
              of (
              %a.existingWikiWord{:href => "/nlab/show/zero-spectrum+bundles"} zero-spectrum bundles
              %a.maruku-eqref{:href => "#eq:BireflectionOfZeroSpectrumBundles"} (2)
              over)
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              %em is
              a
              %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
              between the
              %a.existingWikiWord{:href => "/nlab/show/slice+model+structures"} slice model structures
              of the
              %em absolute
              local model structure. Since, generally,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              is also a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+triples"} Quillen adjoint triples
              of this form:
            %svg{:height => "59.125pt", :version => "1.2", :viewbox => "0 0 500.844 59.125", :width => "500.844pt", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
