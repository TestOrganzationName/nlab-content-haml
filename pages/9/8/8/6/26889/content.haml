                  %annotation{:encoding => "application/x-tex"} e = a x
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mi A
                      %mo ⊆
                      %mi a
