                %annotation{:encoding => "application/x-tex"} \iff
            9), and (1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⇔
                %annotation{:encoding => "application/x-tex"} \iff
            10) iff (1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⇔
                %annotation{:encoding => "application/x-tex"} \iff
            11).
          %p
          #McCoy.num_prop
            %h6 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is vN regular, then so is the matrix ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M_n(A)
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
          %p
          .proof
            %h6 Proof
            %p
              The following proof is adapted from Kaplansky (
              %a{:href => "#KapFaR"}> Kaplansky
              ), starting at page 110; see particularly his Theorem 24. It uses a result called McCoy’s lemma: If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi x
                    %mi a
                    %mo −
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a x a - a
              is regular, then so is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mi x
                      %mi a
                      %mo −
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mi y
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mi x
                      %mi a
                      %mo −
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi a
                    %annotation{:encoding => "application/x-tex"} (a x a - a)y(a x a - a) = a
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %mi a
                      %mi x
                      %mi a
                      %mo −
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mi x
                      %mi a
                      %mo −
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mi y
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mi x
                      %mi a
                      %mo −
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a = a x a - (a x a - a)y(a x a - a)
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo{:stretchy => "false"} [
                      %mo *
                      %mo{:stretchy => "false"} ]
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a [\ast] a
            %p
              First treat the case of a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ×
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2 \times 2
              matrix
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mi c
                          %mtd
                          %mtd
                            %mi d
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left( \begin{array}{ccc} a &amp; &amp; b\\ c &amp; &amp; d \end{array}\right)
            %p
              To prove this matrix is regular, suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mi r
                    %mi c
                    %mo =
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c r c = c
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mi c
                          %mtd
                          %mtd
                            %mi d
                      %mo )
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mi r
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mn 0
                      %mo )
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mi c
                          %mtd
                          %mtd
                            %mi d
                      %mo )
                    %mo −
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mi c
                          %mtd
                          %mtd
                            %mi d
                      %mo )
                    %mo =
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mi c
                            %mi r
                            %mi c
                            %mo −
                            %mi c
                          %mtd
                          %mtd
                            %mo *
                      %mo )
                    %mo =
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mo *
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left( \begin{array}{ccc} a &amp; &amp; b\\ c &amp; &amp; d \end{array}\right)\left( \begin{array}{ccc} 0 &amp; &amp; r\\ 0 &amp; &amp; 0 \end{array}\right)\left( \begin{array}{ccc} a &amp; &amp; b\\ c &amp; &amp; d \end{array}\right) - \left( \begin{array}{ccc} a &amp; &amp; b\\ c &amp; &amp; d \end{array}\right) = \left( \begin{array}{ccc} \ast &amp; &amp; \ast\\ c r c - c &amp; &amp; \ast \end{array}\right) = \left( \begin{array}{ccc} \ast &amp; &amp; \ast\\ 0 &amp; &amp; \ast \end{array}\right)
            %p
              so by McCoy’s lemma, we are reduced to proving that upper triangular matrices are regular. So now do the case of a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ×
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2 \times 2
              matrix
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mi d
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left( \begin{array}{ccc} a &amp; &amp; b\\ 0 &amp; &amp; d \end{array}\right)
            %p
              which we want to prove is regular. Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi x
                    %mi a
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a x a = a
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi y
                    %mi d
                    %mo =
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d y d = d
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x, y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mi d
                      %mo )
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mi y
                      %mo )
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mi d
                      %mo )
                    %mo −
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mi d
                      %mo )
                    %mo =
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi a
                            %mi x
                            %mi a
                            %mo −
                            %mi a
                          %mtd
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mi d
                            %mi y
                            %mi d
                            %mo −
                            %mi d
                      %mo )
                    %mo =
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left( \begin{array}{ccc} a &amp; &amp; b\\ 0 &amp; &amp; d \end{array}\right)\left( \begin{array}{ccc} x &amp; &amp; 0\\ 0 &amp; &amp; y \end{array}\right)\left( \begin{array}{ccc} a &amp; &amp; b\\ 0 &amp; &amp; d \end{array}\right) - \left( \begin{array}{ccc} a &amp; &amp; b\\ 0 &amp; &amp; d \end{array}\right) = \left( \begin{array}{ccc} a x a - a &amp; &amp; \ast\\ 0 &amp; &amp; d y d - d \end{array}\right) = \left( \begin{array}{ccc} 0 &amp; &amp; \ast\\ 0 &amp; &amp; 0 \end{array}\right)
            %p
              so by McCoy’s lemma, we are reduced to proving that
              %em strictly
              upper triangular matrices are regular. To show the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ×
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2 \times 2
              matrix
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left( \begin{array}{ccc} 0 &amp; &amp; b\\ 0 &amp; &amp; 0 \end{array}\right)
            %p
              is regular, write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mi z
                    %mi b
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b z b = b
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                    %annotation{:encoding => "application/x-tex"} z
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mn 0
                      %mo )
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                            %mi z
                          %mtd
                          %mtd
                            %mn 0
                      %mo )
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mn 0
                      %mo )
                    %mo =
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mi b
                            %mi z
                            %mi b
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mn 0
                      %mo )
                    %mo =
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left( \begin{array}{ccc} 0 &amp; &amp; b\\ 0 &amp; &amp; 0 \end{array}\right)\left( \begin{array}{ccc} 0 &amp; &amp; 0\\ z &amp; &amp; 0 \end{array}\right)\left( \begin{array}{ccc} 0 &amp; &amp; b\\ 0 &amp; &amp; 0 \end{array}\right) = \left( \begin{array}{ccc} 0 &amp; &amp; b z b\\ 0 &amp; &amp; 0 \end{array}\right) = \left( \begin{array}{ccc} 0 &amp; &amp; b\\ 0 &amp; &amp; 0 \end{array}\right)
            %p
              which completes the proof for the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ×
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2 \times 2
              case.
            %p
              For the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 4
                    %mo ×
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} 4 \times 4
              case, write this in block form as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi U
                          %mtd
                          %mtd
                            %mi V
                        %mtr
                          %mtd
                            %mi W
                          %mtd
                          %mtd
                            %mi X
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left( \begin{array}{ccc} U &amp; &amp; V\\ W &amp; &amp; X \end{array}\right)
            %p
              where
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ,
                      %mi V
                      %mo ,
                      %mi W
                      %mo ,
                      %mi X
                      %mo ∈
                      %msub
                        %mi M
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U, V, W, X \in M_2(A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mi M
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi M
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M_4(A) \cong M_2(M_2(A))
              is also vN regular. By induction,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M_n(A)
              is vN regular for integers
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %msup
                        %mn 2
                        %mi k
                    %annotation{:encoding => "application/x-tex"} n = 2^k
            %p
              Finally, for any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mn 2
                        %mi k
                      %mo ≥
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 2^k \geq n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ×
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n \times n
              matrices sits in the upper left corner of the ring of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 2
                      %mi k
                    %mo ×
                    %msup
                      %mn 2
                      %mi k
                  %annotation{:encoding => "application/x-tex"} 2^k \times 2^k
              matrices. Kaplansky concludes (paraphrasing), “The desired result then follows from a remark which we leave as an exercise for the reader: if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is von Neumann regular and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              is an idempotent in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mi A
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e A e
              is von Neumann regular.”
          %p
          .num_lemma
            %h6 Lemma
            %p
              (1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
              7) Every finitely generated submodule
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} A^n
              is a direct summand of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} A^n
              (hence is projective).
          %p
          .proof
            %h6 Proof
            %p
              There is a surjective module map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi k
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A^k \to B
              and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is the image of a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              defined to be a composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mrow
                        %mi n
                        %mo +
                        %mi k
                    %mo ≅
                    %msup
                      %mi A
                      %mi n
                    %mo ×
                    %msup
                      %mi A
                      %mi k
                    %mover
                      %mo →
                      %mi p
                    %msup
                      %mi A
                      %mi k
                    %mo →
                    %mi B
                    %mo ↪
                    %msup
                      %mi A
                      %mi n
                    %mover
                      %mo ↪
                      %mi i
                    %msup
                      %mi A
                      %mi n
                    %mo ×
                    %msup
                      %mi A
                      %mi k
                    %mo ≅
                    %msup
                      %mi A
                      %mrow
                        %mi n
                        %mo +
                        %mi k
                  %annotation{:encoding => "application/x-tex"} A^{n+k} \cong A^n \times A^k \overset{p}{\to} A^k \to B \hookrightarrow A^n \overset{i}{\hookrightarrow} A^n \times A^k \cong A^{n+k}
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi i
                  %annotation{:encoding => "application/x-tex"} p, i
              are obvious projection, inclusion maps. Since the previous proposition says the matrix ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo =
                    %msub
                      %mi M
                      %mrow
                        %mi n
                        %mo +
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M = M_{n+k}(A)
              is vN regular assuming
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is, we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi M
                    %mo =
                    %mi E
                    %mi M
                  %annotation{:encoding => "application/x-tex"} P M = E M
              for some idempotent
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                    %mi P
                    %mo ⋅
                    %msup
                      %mi A
                      %mrow
                        %mi n
                        %mo +
                        %mi k
                    %mo =
                    %mi P
                    %mi M
                    %mo ⋅
                    %msup
                      %mi A
                      %mrow
                        %mi n
                        %mo +
                        %mi k
                    %mo =
                    %mi E
                    %mi M
                    %mo ⋅
                    %msup
                      %mi A
                      %mrow
                        %mi n
                        %mo +
                        %mi k
                    %mo =
                    %mi E
                    %mo ⋅
                    %msup
                      %mi A
                      %mrow
                        %mi n
                        %mo +
                        %mi k
                  %annotation{:encoding => "application/x-tex"} B = P \cdot A^{n+k} = P M \cdot A^{n+k} = E M \cdot A^{n+k} = E \cdot A^{n+k}
            %p
              which makes the module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              the result of splitting the idempotent
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              acting on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mrow
                          %mi n
                          %mo +
                          %mi k
                    %annotation{:encoding => "application/x-tex"} A^{n+k}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ↪
                    %msup
                      %mi A
                      %mrow
                        %mi n
                        %mo +
                        %mi k
                  %annotation{:encoding => "application/x-tex"} B \hookrightarrow A^{n+k}
              a direct summand, say with left inverse
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo :
                      %msup
                        %mi A
                        %mrow
                          %mi n
                          %mo +
                          %mi k
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} r: A^{n+k} \to B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ↪
                    %msup
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} B \hookrightarrow A^n
              is split, with left inverse
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi n
                    %mover
                      %mo ↪
                      %mi i
                    %msup
                      %mi A
                      %mrow
                        %mi n
                        %mo +
                        %mi k
                    %mover
                      %mo →
                      %mi r
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A^n \overset{i}{\hookrightarrow} A^{n+k} \overset{r}{\to} B
            %p and this completes the proof.
          %p
          .num_lemma
            %h6 Lemma
            %p
              (7
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
              9) If any finitely generated right submodule of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} A^n
              is a direct summand, then every finitely presented right module is projective.
          %p
          .proof
            %h6 Proof
            %p
              Suppose given a finite presentation of a module
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi B
                    %mo →
                    %msup
                      %mi A
                      %mi n
                    %mo →
                    %mi N
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0 \to B \to A^n \to N \to 0
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is finitely generated. By hypothesis, the exact sequence splits, and by this splitting,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              becomes a direct summand of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mi n
                    %annotation{:encoding => "application/x-tex"} A^n
          %p
          .num_lemma
            %h6 Lemma
            %p
              (9
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
              11) If every finitely presented right
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
          .proof
            %h6 Proof
            %p
              By general considerations of locally finite presentability (see
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Gabriel-Ulmer+duality"} Gabriel-Ulmer duality
          %p
          .num_lemma
            %h6 Lemma
            %p
              (11
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
              3) If every right
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a \in A
              there is an idempotent element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mi A
                      %mo =
                      %mi e
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a A = e A
          %p
          .proof
            %h6 Proof
            %p
              As shown in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/flat+module"} flat module
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a \in A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo =
                      %mi A
                      %mo{:stretchy => "false"} /
                      %mi a
                      %mi A
                    %annotation{:encoding => "application/x-tex"} M = A/a A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ≅
                      %msub
                        %mi{:mathvariant => "normal"} colim
                        %mi i
                      %msub
                        %mi F
                        %mi i
                    %annotation{:encoding => "application/x-tex"} M \cong \mathrm{colim}_i F_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is finitely presented by a short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi a
                    %mi A
                    %mo →
                    %mi A
                    %mo →
                    %mi M
                    %mo →
                    %mn 0
                    %mo .
                  %annotation{:encoding => "application/x-tex"} 0 \to a A \to A \to M \to 0.
            %p
              By
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gabriel-Ulmer+duality"} Gabriel-Ulmer duality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(M, -)
              preserving filtered colimits. Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(M, -)
              preserves the colimit
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ≅
                      %msub
                        %mi{:mathvariant => "normal"} colim
                        %mi i
                      %msub
                        %mi F
                        %mi i
                    %annotation{:encoding => "application/x-tex"} M \cong \mathrm{colim}_i F_i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} colim
                      %mi i
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %msub
                      %mi F
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{colim}_i \hom(M, F_i) \to \hom(M, M)
            %p
              is an isomorphism. In particular, it is surjective, and therefore there is some element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo :
                    %mi M
                    %mo →
                    %msub
                      %mi F
                      %mi i
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi{:mathvariant => "normal"} colim
                      %mi i
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %msub
                      %mi F
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [f: M \to F_i] \in \mathrm{colim}_i \hom(M, F_i)
              that maps to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 1
                        %mi M
                    %annotation{:encoding => "application/x-tex"} 1_M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %msub
                      %mi F
                      %mi i
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} g: F_i \to M
              appearing in the colimit cocone such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∘
                      %mi f
                      %mo =
                      %msub
                        %mn 1
                        %mi M
                    %annotation{:encoding => "application/x-tex"} g \circ f = 1_M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is a retract of the free module
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi i
                    %annotation{:encoding => "application/x-tex"} F_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is projective. It follows that the exact sequence above used to present
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              splits. Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a A
              itself is a retract of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} e \in A
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mi A
                      %mo =
                      %mi e
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a A = e A
          %p
          %h3#section_Commutative_von_Neumann_rings Commutative von Neumann rings
          %p
            One can characterize
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative
            vN rings as certain subrings of products of fields.
          %p
            The first remark to make is that such rings
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            form a variety of algebras, in other words they are the algebras of a
            %a.existingWikiWord{:href => "/nlab/show/finitary+monad"} finitary monad
            on the category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %a.existingWikiWord{:href => "/nlab/show/models"} models
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            %em pseudo-inverse
            of an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} a \in R
            to be an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} x \in R
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi x
                  %mi a
                  %mo =
                  %mi a
                %annotation{:encoding => "application/x-tex"} a x a = a
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi a
                    %mi x
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x a x = x
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pseudogroup"} pseudogroup
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/inverse+semigroup"} inverse semigroup
          %p
          .num_lemma
            %h6 Lemma
            %p
              In a commutative vN ring, every element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              has a unique pseudo-inverse
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          %p
          .proof
            %h6 Proof
            %p
              Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mi x
                      %mi a
                      %mo =
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a x a = a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo =
                    %mi x
                    %mi a
                    %mi x
                  %annotation{:encoding => "application/x-tex"} y = x a x
              is a pseudo-inverse of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
            %p
              To prove uniquness, suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x, y
              are both pseudo-inverses of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi x
                    %mi a
                    %mo =
                    %mi a
                    %mspace{:width => "2em"}
                    %mi x
                    %mi a
                    %mi x
                    %mo =
                    %mi x
                    %mspace{:width => "2em"}
                    %mi a
                    %mi y
                    %mi a
                    %mo =
                    %mi a
                    %mspace{:width => "2em"}
                    %mi y
                    %mi a
                    %mi y
                    %mo =
                    %mi y
                    %mo .
                  %annotation{:encoding => "application/x-tex"} a x a = a \qquad x a x = x \qquad a y a = a \qquad y a y = y.
            %p
              We want to prove
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x = y
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mi x
                      %mo =
                      %mi a
                      %mi y
                    %annotation{:encoding => "application/x-tex"} a x = a y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi x
                    %mo =
                    %mi x
                    %mi a
                    %mo =
                    %mi x
                    %mi a
                    %mi y
                    %mi a
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mi a
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mi a
                    %mo =
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mi a
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi x
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mi y
                    %mo =
                    %mi a
                    %mi y
                    %mo .
                  %annotation{:encoding => "application/x-tex"} a x = x a = x a y a = (x a y)a = a(x a y) = (a x a)y = a y.
            %p
              Then prove
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x = y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi x
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                    %mo .
                  %annotation{:encoding => "application/x-tex"} x = x(a x) = x(a y) = y(a x) = y(a y) = y.
            %p This completes the proof.
          %p
            It follows immediately from this lemma that commutative vN rings are the same thing as commutative rings equipped with a pseudo-inversion operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ↦
                  %mover
                    %mi a
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} a \mapsto \overline{a}
            (moreover, pseudo-inversion is uniquely determined, as we just saw). Now we can state the characterization:
          %p
          .num_theorem
            %h6 Theorem
            %p
              Every commutative vN ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              occurs as a subring of a product of fields that is closed under pseudo-inversion.
          %p We sketch the proof as the end result after a series of lemmas.
          %p
          .num_lemma
            %h6 Lemma
            %p
              Every von Neumann regular ring is a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/reduced+ring"} reduced ring
              %a.existingWikiWord{:href => "/nlab/show/nilpotent+element"} nilpotents
              in a vN regular ring.
          %p
          .proof
            %h6 Proof
            %p
              It is enough to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a^2 = 0
              implies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} a = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi a
                    %mover
                      %mi a
                      %mo ¯
                    %mi a
                    %mo =
                    %msup
                      %mi a
                      %mn 2
                    %mover
                      %mi a
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} a = a \overline{a} a = a^2 \overline{a}
              makes this plain.
          %p
          .num_lemma
            %h6 Lemma
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/integral+domain"} integral domain
              that is vN regular must be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
          %p
          .proof
            %h6 Proof
            %p
              It is easy to see from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mi a
                    %mover
                      %mi a
                      %mo ¯
                    %mo{:stretchy => "false"} )
                    %mi a
                    %mo =
                    %mi a
                    %mo −
                    %mi a
                    %mover
                      %mi a
                      %mo ¯
                    %mi a
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} (1 - a\overline{a})a = a - a\overline{a}a = 0
              that either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a = 0
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              is invertible.
          %p
          .num_cor
            %h6 Corollary
            %p Every prime ideal in a commutative vN regular ring is maximal.
          %p
          .num_cor
            %h6 Corollary
            %p
              For a commutative vN regular ring, the
              %a.existingWikiWord{:href => "/nlab/show/nilradical"} nilradical
              equals the
              %a.existingWikiWord{:href => "/nlab/show/Jacobson+radical"} Jacobson radical
              (the intersection of all maximal ideals).
          %p
          .proof
            %h6 Proof
            %p
              This follows from a well-known consequence of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ultrafilter+principle"} ultrafilter principle
              %a.existingWikiWord{:href => "/nlab/show/nilradical"} nilradical
              for the proof. The statement then follows from the previous corollary.
          %p The lemmas and corollaries enter the proof of the Theorem:
          %p
          .proof
            %h6 Proof
            %p
              Taking
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}
              to range over maximal ideals of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} R \to R/\mathfrak{m}
              are maps to fields, and these quotient maps “tuple” together to form a map into a product of fields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi R
                    %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi 𝔪
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi 𝔪
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \phi: R \to \prod_{\mathfrak{m}} R/\mathfrak{m}.
            %p
              The image is obviously closed under pseudo-inversion. The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              isomorphically onto its image iff it has trivial kernel, but the kernel is clearly just the intersection of all maximal ideals, which is the same as the nilradical, which is the ideal consisting precisely of nilpotent elements, but the only nilpotent is the zero element. Thus the kernel is trivial, and the proof is complete.
          %p
          .num_theorem
            %h6 Theorem
            %p
              Every commutative von Neumann regular ring is a commutative
              %a.existingWikiWord{:href => "/nlab/show/reduced+ring"} reduced
              %a.existingWikiWord{:href => "/nlab/show/zero-dimensional+ring"} zero-dimensional ring
          %p
          .proof
            %h6 Proof
            %p
              See section titled
              %em Equational definition of reduced zero-dimensional rings
              on page 212 and theorem 2.3 on page 456 of
              %a{:href => "#LombardiQuitté2010"} Lombardi &amp; Quitté (2010)
              for the time being.
          %h3#nonalgebraicity_of_von_neumann_regular_rings Non-algebraicity of von Neumann regular rings
          %p
            As stated in the preceding subsection, commutative vN rings form a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/variety+of+algebras"} variety of algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ↦
                  %mover
                    %mi a
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} a \mapsto \overline{a}
            satisfying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mover
                    %mi a
                    %mo ¯
                  %mi a
                  %mo =
                  %mi a
                %annotation{:encoding => "application/x-tex"} a \overline{a} a = a
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi a
                      %mo ¯
                    %mi a
                    %mover
                      %mi a
                      %mo ¯
                    %mo =
                    %mover
                      %mi a
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{a} a \overline{a} = \overline{a}
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/finitary+functor"} finitarily
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic
          %p
            In contrast, vN rings generally do not form a variety of algebras: they are not monadic over sets. For a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} C \to Set
            to be monadic, it is necessary that it preserve and reflect
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            (see
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/monadicity+theorem"} monadicity theorem
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mi vN
                  %mspace{:width => "thickmathspace"}
                  %mi Ring
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} U: vN\; Ring \to Set
          %p
            although this
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            does preserve and reflect arbitrary small
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/products"} products
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi vN
                  %mspace{:width => "thickmathspace"}
                  %mi Ring
                  %mo ↪
                  %mi Ring
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} vN\; Ring \hookrightarrow Ring \to Set
          %p
            where the inclusion is fully faithful (hence reflects isomorphisms) and the forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ring
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Ring \to Set
            also reflects isomorphisms. So the problem is that in some cases,
            %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi vN
                  %mspace{:width => "thickmathspace"}
                  %mi Ring
                %annotation{:encoding => "application/x-tex"} vN\; Ring
            cannot be formed in the usual way, by taking equalizers at the level of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
          %p
          #nonalg.num_remark
            %h6 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %msub
                      %mi M
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R = M_2(k)
              for a field
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %a.maruku-ref{:href => "#McCoy"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} L \in R
              be the matrix
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo =
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mn 1
                      %mo )
                  %annotation{:encoding => "application/x-tex"} L = \left(\begin{array}{ccc} 1 &amp; &amp; 1\\0 &amp; &amp; 1\end{array} \right)
            %p
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mi L
                    %mo :
                    %mi R
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \Phi_L: R \to R
              be conjugation by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mi L
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi L
                      %mi X
                      %msup
                        %mi L
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \Phi_L(X) = L X L^{-1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mi L
                    %mo ,
                    %msub
                      %mn 1
                      %mi R
                  %annotation{:encoding => "application/x-tex"} \Phi_L, 1_R
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ring
                  %annotation{:encoding => "application/x-tex"} Ring
              is not vN regular. For by a routine linear algebra calculation, the equalizer, which is the subring of elements fixed under
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mi L
                    %annotation{:encoding => "application/x-tex"} \Phi_L
              %a.existingWikiWord{:href => "/nlab/show/centralizer"} centralizer
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} M_2(k)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              consisting of matrices of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                          %mtd
                            %mi b
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mi a
                      %mo )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \left(\begin{array}{ccc} a &amp; &amp; b\\0 &amp; &amp; a\end{array} \right),
            %p
              but this
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              has a nonzero nilpotent two-sided ideal consisting of such matrices where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} a = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is not von Neumann regular by the following lemma.
          %p
          .num_lemma
            %h6 Lemma
            %p In a vN regular ring, the only nilpotent two-sided ideal is the zero ideal.
          %p
          .proof
            %h6 Proof
            %p
              It suffices to show that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              any two-sided ideal,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mn 2
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} I^2 = \{0\}
              implies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} I = \{0\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} a \in I
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mi x
                      %mi a
                      %mo =
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a x a = a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} a \in I
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mi a
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} x a \in I
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %mi a
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi I
                        %mn 2
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} a = a(x a) \in I^2 = \{0\}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} a = 0
          %p
            One way of considering Example
            %a.maruku-ref{:href => "#nonalg"}
            is that although there are many pseudo-inverses
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi N
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{N}
            to choose from for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo =
                  %mrow
                    %mo (
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mn 0
                        %mtd
                        %mtd
                          %mn 1
                      %mtr
                        %mtd
                          %mn 0
                        %mtd
                        %mtd
                          %mn 0
                    %mo )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} N = \left(\begin{array}{ccc} 0 &amp; &amp; 1\\0 &amp; &amp; 0\end{array} \right),
          %p namely matrices of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi a
                        %mtd
                        %mtd
                          %mi a
                          %mi b
                      %mtr
                        %mtd
                          %mn 1
                        %mtd
                        %mtd
                          %mi b
                    %mo )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \left(\begin{array}{ccc} a &amp; &amp; a b\\1 &amp; &amp; b\end{array} \right),
          %p
            there is not a single one of these that is fixed by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \Phi_L
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %msub
                        %mi Φ
                        %mi L
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                    %mo ¯
                  %mo =
                  %mover
                    %mi N
                    %mo ¯
                  %mo ≠
                  %msub
                    %mi Φ
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi N
                    %mo ¯
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \overline{\Phi_L(N)} = \overline{N} \neq \Phi_L(\overline{N}),
          %p
            i.e., there is no hope of getting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mi L
                %annotation{:encoding => "application/x-tex"} \Phi_L
            to preserve any chosen pseudo-inversion operation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↦
                    %mover
                      %mi X
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} X \mapsto \overline{X}
          %h2#examples Examples
          %ul
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/field"} field
                or
                %a.existingWikiWord{:href => "/nlab/show/division+ring"} division ring
                is a von Neumann regular ring.
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/boolean+ring"} boolean ring
                is a von Neumann regular ring.
            %li
              %p Any product of von Neumann regular rings is von Neumann regular.
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/semisimple+ring"} semisimple ring
                is von Neumann regular.
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                a
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                over a
                %a.existingWikiWord{:href => "/nlab/show/skew-field"} skew-field
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                %a.existingWikiWord{:href => "/nlab/show/endomorphism+ring"} endomorphism ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi End
                        %mi K
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} End_K(V)
                is von Neumann regular.
            %li
              %p
                The property of being a von Neumann regular ring is
                %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
                under
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"} Morita equivalence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is vN regular, then any ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                Morita equivalent to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is also vN regular. For example, Proposition
                %a.maruku-ref{:href => "#McCoy"}
                gives the case of a
                %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix ring
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo =
                        %msub
                          %mi M
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B = M_n(A)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
          %p
          .num_remark
            %h6 Remark
            %p
              To check that a property is preserved by Morita equivalence, it suffices to check that (1) the property passes up from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              to matrix rings
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} M_n(R)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              to “corner rings”, i.e., rings of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mi R
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e R e
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              is an idempotent such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo =
                      %mi R
                      %mi e
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R= R e R
              = succeed "," do
                %a{:href => "https://link.springer.com/book/10.1007/978-1-4612-0525-8"} Lam’s Lectures on Modules and Rings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mi a
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mi x
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mi a
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mi a
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mi x
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mi a
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e a e)x(e a e) = (e a e)(e x e)(e a e)
              for idempotents
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
          %h2#references References
          %p Von Neumann regular rings were introduced in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+von+Neumann"}> John von Neumann
              \:
              = succeed "," do
                %em On Regular Rings
              %strong 22
              (1936) 707-713 &amp;lbrack;
              %a{:href => "https://doi.org/10.1073/pnas.22.12.707"}> doi:10.1073/pnas.22.12.707
              \&amp;rbrack;
          %p Reference book:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ken+Goodearl"}> Ken Goodearl
              \:
              = succeed "," do
                %em Von Neumann Regular Rings
              %strong 4
              (1979)
          %p Also see:
          %ul
            %li#KapFaR
              %p
                %a.existingWikiWord{:href => "/nlab/show/Irving+Kaplansky"}> Irving Kaplansky
                \:
                = succeed "," do
                  %em Fields and Rings
            %li{:id => "LombardiQuitté2010"}
              %p
                %a.existingWikiWord{:href => "/nlab/show/Henri+Lombardi"}> Henri Lombardi
                ,
                %a.existingWikiWord{:href => "/nlab/show/Claude+Quitt%C3%A9"} Claude Quitté
                (2010):
                %em Commutative algebra: Constructive methods (Finite projective modules)
                Translated by Tania K. Roblo, Springer (2015) &amp;lbrack;
                %a{:href => "https://link.springer.com/book/10.1007/978-94-017-9944-7"}> doi:10.1007/978-94-017-9944-7
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://hlombardi.free.fr/CACM.pdf"} pdf
          %p See also:
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Von_Neumann_regular_ring"} Von Neumann regular ring
          %p This discussion post from the Category Theory Zulip, titled “Semisimple commutative rings”, is mostly about von Neumann regular rings; many of the results above were extracted from that discussion:
          %ul
            %li
              %em> Semisimple commutative rings
              , Category Theory Zulip (
              %a{:href => "https://categorytheory.zulipchat.com/#narrow/channel/229199-learning.3A-questions/topic/Semisimple.20commutative.20rings"}> web
              )
