          %h3#partially_quenched_chiral_perturbation_theory Partially Quenched Chiral Perturbation Theory
          %p
            In
            = succeed "," do
              %span.newWikiWord
                Lattice QCD
                %a{:href => "/nlab/new/Lattice+QCD"} ?
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/light+quarks"} light quarks
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "." do
