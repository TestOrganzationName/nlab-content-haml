            %p
              See at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/SL%282%2CH%29"} SL(2,H)
              %em
                %a{:href => "SL2H#UnitarySubgroup"} Unitary subgroup
              and
              = succeed "." do
                %em
                  %a{:href => "SL2H#RelationToSpin51"} Relation to Spin(1,5)
          %h3#action_on_quaternionic_hopf_fibration Action on quaternionic Hopf fibration
          #Spin5EquivarianceOfQuaternionicHopfFibration.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Spin%285%29"}> Spin(5)
                \-
                %a.existingWikiWord{:href => "/nlab/show/action"} equivariance
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/quaternionic+Hopf+fibration"} quaternionic Hopf fibration
            %p Consider
            %ol
              %li
                %p
                  the
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/Spin%285%29"} Spin(5)
                  %a.existingWikiWord{:href => "/nlab/show/action"} action
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 4
                      %annotation{:encoding => "application/x-tex"} S^4
                  which is induced by the defining action on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mn 5
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^5
                  under the identification
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 4
                          %mo ≃
                          %mi S
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mn 5
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} S^4 \simeq S(\mathbb{R}^5)
              %li
                %p
                  the
                  = succeed "-action" do
                    %a.existingWikiWord{:href => "/nlab/show/Spin%285%29"} Spin(5)
                  %a.existingWikiWord{:href => "/nlab/show/7-sphere"} 7-sphere
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 7
                      %annotation{:encoding => "application/x-tex"} S^7
                  which is induced under the exceptional isomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 5
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi Sp
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mi ℍ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(5) \simeq Sp(2) = U(2,\mathbb{H})
                  (from Prop.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ExceptionalIsoToSp2"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mi ℍ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(2,\mathbb{H})
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℍ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{H}^2
                  via
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 7
                          %mo ≃
                          %mi S
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℍ
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} S^7 \simeq S(\mathbb{H}^2)
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+Hopf+fibration"} quaternionic Hopf fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 7
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi h
                          %mi ℍ
                    %msup
                      %mi S
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} S^7 \overset{h_{\mathbb{H}}}{\longrightarrow} S^4
              is
              %a.existingWikiWord{:href => "/nlab/show/equivariant"} equivariant
              with respect to these
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/actions"} actions
          %p
            This is almost explicit in
            %a{:href => "#Porteous95"} Porteous 95, p. 263
          %div{:style => "text-align: center"}
            %img{:src => "/nlab/files/Spin5OnHopfH.jpg", :width => "280px"}/
          %h3#cohomology Cohomology
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              of the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 5
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B Spin(5)
              is spanned by two generators
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/first+fractional+Pontryagin+class"} first fractional Pontryagin class
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msub
                          %mi p
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \tfrac{1}{2}p_1
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/linear+combination"} linear combination
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msub
                          %mi p
                          %mn 2
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %mo{:stretchy => "false"} (
                        %msub
