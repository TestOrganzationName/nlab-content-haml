              = succeed "," do
                %em Kan extensions for program optimisation - Or: Art and Dan explain an old trick
              = succeed "," do
                %em 11th International Conference on Mathematics of Program Construction (MPC ‘12)
              %strong 7342
              Springer (2012) 324–362. (
              %a{:href => "http://dx.doi.org/10.1007/978-3-642-31113-0_16"}> doi: 10.1007/978-3-642-31113-0_16
              ,
              = succeed ")" do
