                  %annotation{:encoding => "application/x-tex"} M_k
              consists of all morphisms (equivalently,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi k
                  %annotation{:encoding => "application/x-tex"} E_k
              consists of only isomorphisms/equivalences).
          %p
            Given a
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/coimage"} co
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mi i
                  %mo ,
                  %msub
                    %mi M
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E_i,M_i)
            is the
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              \-(co)image
            of the entire
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            Note that every (higher) category has a unique
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            (or
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"} groupoid
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mn 0
                  %mo =
                  %msub
                    %mi M
                    %mi k
                %annotation{:encoding => "application/x-tex"} M_0 = M_k
            (and
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 0
                    %mo =
                    %msub
                      %mi E
                      %mi k
                  %annotation{:encoding => "application/x-tex"} E_0 = E_k
            %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete category
            has a (necessarily unique)
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-1)
          %p
            A
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              \-step factorisation system
            or a
            = succeed "." do
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k+1)
                \-stage factorisation system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} k - 1
            overlapping factorisation systems produce from a morphism.
          %h2#infinitary_factorisation_systems Infinitary factorisation systems
          %p Here is an incomplete attempt at a general definition:
          %p
            Fix any
            %a.existingWikiWord{:href => "/nlab/show/ordinal+number"} ordinal number
            (or
            %a.existingWikiWord{:href => "/nlab/show/opposite+poset"} opposite
            thereof, or any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              \-stage factorisation system
            (in an ambient
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mi i
                  %mo ,
                  %msub
                    %mi M
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E_i, M_i)
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            such that:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi i
                    %mo ⊆
                    %msub
                      %mi M
                      %mi j
                  %annotation{:encoding => "application/x-tex"} M_i \subseteq M_j
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≤
                    %mi j
                  %annotation{:encoding => "application/x-tex"} i \leq j
              (equivalently,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi i
                    %mo ⊇
                    %msub
                      %mi E
                      %mi j
                  %annotation{:encoding => "application/x-tex"} E_i \supseteq E_j
              whenever
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ≤
                      %mi j
                    %annotation{:encoding => "application/x-tex"} i \leq j
            %li
              each morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\colon X \to Y
              is both the
              %a.existingWikiWord{:href => "/nlab/show/inverse+limit"} inverse limit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mrow
                        %mi i
                        %mo →
                        %mn ∞
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                      %mi i
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \underset{i \to \infty}\lim \im_i f
              in the
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} C/Y
              and the
              %a.existingWikiWord{:href => "/nlab/show/direct+limit"} direct limit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} colim
                      %mrow
                        %mi i
                        %mo →
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn ∞
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} coim
                      %mi i
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \underset{i \to -\infty}\colim \coim_i f
              in the
              %a.existingWikiWord{:href => "/nlab/show/coslice+category"} coslice category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi C
                    %annotation{:encoding => "application/x-tex"} X/C
            %li
              for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f\colon X \to Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \id_Y
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} colim
                      %mrow
                        %mi i
                        %mo →
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn ∞
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                      %mi i
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \underset{i \to -\infty}\colim \im_i f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \id_X
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mi lim
                        %mrow
                          %mi i
                          %mo →
                          %mn ∞
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} coim
                        %mi i
                      %mi f
                    %annotation{:encoding => "application/x-tex"} \underset{i \to \infty}\lim \coim_i f
          %p
            This seems to be correct whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            really is either an ordinal or the opposite thereof, as well as some other posets such as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ω
                    %mi op
                  %mo +
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega^op + \omega
            (which is the poset of
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo +
                    %msup
                      %mi ω
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \omega + \omega^op
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is
            %em both
            an ordinal and the opposite thereof, we recover the above definition of an
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi alpha
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (alpha-1)
          %h2#examples Examples
          %ul
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} k = 3
                one speaks of a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/ternary+factorization+system"} ternary factorization system
            %li
              %p
                In an
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
                the
                %a.existingWikiWord{:href => "/nlab/show/%28epi%2C+mono%29+factorization+system"} (epi, mono) factorization system
                in a
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
                splits up to an
                = succeed "-ary" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                %a.existingWikiWord{:href => "/nlab/show/%28n-epi%2C+n-mono%29+factorization+systems"} (n-epi, n-mono) factorization systems
                (the
                = succeed "-factorization)" do
                  %a.existingWikiWord{:href => "/nlab/show/n-image"} n-image
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Postnikov+system"} Postnikov system
          %h2#references References
          %ul
            %li
              %p
                %a{:href => "http://golem.ph.utexas.edu/category/2010/07/ternary_factorization_systems.html"} Cafe discussion
                mainly on the ternary version
            %li
              %p
                %a{:href => "https://nforum.ncatlab.org/discussion/1629"} Forum discussion
                including the k-ary case, even when k is infinite
