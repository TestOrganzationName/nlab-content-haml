                            %mi β
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ]
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi{:mathvariant => "normal"} d
                            %mi A
                          %msub
                            %mi α
                            %mi i
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                          %msup
                            %mi t
                            %mi i
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi β
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} [
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi{:mathvariant => "normal"} d
                            %mi A
                          %mi α
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi β
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} ]
                          %mspace{:width => "thinmathspace"}
                          %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    \\Big\{
                    \\textstyle{\int}
                    \\big(\mathrm{d}_A \alpha_i\big)
                    E^i
                    ,\,
                    \\mathrm{d}_A \beta
                    \\Big\}
                    \\\
                    \\;\equiv\;
                    \\Big\{
                    \\textstyle{\int}
                    \\big(\mathrm{d}_A \alpha_i\big)
                    E^i
                    ,\,
                    \\mathrm{d}\beta
                    + [A, \beta]
                    \\Big\}
                    \\\
                    \\;=\;
                    \\textstyle{\int}
                    \\big(\mathrm{d}_A \alpha_i\big)
                    \\Big[
                    \\big\{
                    E^i
                    ,\,
                    A
                    \\big\}
                    ,\,
                    \\beta
                    \\Big]
                    \\\
                    \\;=\;
                    \\big(\mathrm{d}_A \alpha_i\big)
                    \\big[
                    t^i
                    ,\,
                    \\beta
                    \\big]
                    \\\
                    \\;=\;
                    \\Big[
                    \\big(\mathrm{d}_A \alpha\big)
                    ,\,
                    \\beta
                    \\Big]
                    \\,.
                    \\end{array}
            %p
          This is the relation needed for the computation of the bracket among electric fluxes in Prop.
          %a.maruku-ref{:href => "#PoissonBracketBetweenElectricFluxes"}
          below.
          %p
          #BracketOfElectricFluxWithMagneticFluxDensity.num_remark
            %h6 Example
            %p
              The Poisson bracket of an electric flux observable with a magnetic flux density results in the
              %em covariant derivative
              of the electric smearing function:
            #eq:TheBracketOfElectricFluxWithMagneticFluxDensity.maruku-equation
              %span.maruku-eq-number (25)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                          %mstyle{:displaystyle => "false"}
                            %mo ∫
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi{:mathvariant => "normal"} d
                              %mi A
                            %msub
                              %mi α
                              %mi i
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo ∧
                            %msup
                              %mi E
                              %mi i
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi F
                              %mi A
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi d
                              %mi A
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi{:mathvariant => "normal"} d
                              %mi A
                            %mi α
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ′
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    \\Big\{
                    \\textstyle{\int}
                    \\big(\mathrm{d}_A \alpha_i\big) \wedge E^i
                    ,\,
                    F_A(x')
                    \\Big\}
                    \\;=\;
                    d_A \big(\mathrm{d}_A \alpha\big)(x')
                    \\end{array}
            %p
          This is the main relation needed in the computation of the bracket between electric and magnetic fluxes, in Prop.
          %a.maruku-ref{:href => "#PoissonBracketBetweenElectricAndMagneticFluxes"}
          below.
          .proof
            %h6 Proof
            %p
              For the first summand in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ≡
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi A
                    %mo +
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F_A \,\equiv\, \mathrm{d}A + \tfrac{1}{2}[A, A]
              we have simply:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                          %mstyle{:displaystyle => "false"}
                            %mo ∫
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi{:mathvariant => "normal"} d
                              %mi A
                            %msub
                              %mi α
                              %mi i
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo ∧
                            %msup
                              %mi E
                              %mi i
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi{:mathvariant => "normal"} d
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} d
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                          %mstyle{:displaystyle => "false"}
                            %mo ∫
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi{:mathvariant => "normal"} d
                              %mi A
                            %msub
                              %mi α
                              %mi i
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo ∧
                            %msup
                              %mi E
                              %mi i
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
