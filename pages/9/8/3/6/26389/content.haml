                    %mrow
                      %mi j
                      %mi k
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi A
                    %mi j
                  %mo ∧
                  %msup
                    %mi A
                    %mi k
                  %mo ⊗
                  %msub
                    %mi t
                    %mi i
