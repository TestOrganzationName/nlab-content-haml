            %p
          %p
            %br/
          %h3#ThePoissonBracketOfIntegratedFluxes The sub-phase space of integrated fluxes
          %p
          #ReducedPhaseSpaceOfIntegratedFluxes.num_theorem
            %h6 Theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/reduced+phase+space"} reduced
              sub-
              %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
              of integral fluxes through a given surface
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \hookrightarrow X
              %a.maruku-eqref{:href => "#eq:TheEmbeddedSurfaces"} (21)
              in
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+manifold"} Fréchet
              %a.existingWikiWord{:href => "/nlab/show/Lie-Poisson+manifold"} Lie-Poisson manifold
            #eq:SemidirectProductLieAlgebraOfMaps.maruku-equation
              %span.maruku-eq-number (26)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
