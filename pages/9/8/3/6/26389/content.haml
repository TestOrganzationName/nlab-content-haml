          .proof
            %h6 Proof
            %p
              That the
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+manifold"} Fréchet manifold
              is as claimed is just a restatement of the form of the linear flux observables in Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#TheProperFluxObservables"}
              %a.maruku-eqref{:href => "#eq:ThePoissonBracketOnCanonicalCoordinates"} (19)
              of these linear observables is equivalently the Lie bracket of their smearing functions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mi el
                    %annotation{:encoding => "application/x-tex"} \alpha_{el}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mi mag
                    %annotation{:encoding => "application/x-tex"} \alpha_{mag}
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:SemidirectProductLieAlgebraOfMaps"} (26)
              %a.maruku-ref{:href => "#PoissonBracketBetweenElectricFluxes"}
              and Prop.
              %a.maruku-ref{:href => "#PoissonBracketBetweenElectricAndMagneticFluxes"}
              below.
          %p
          #PoissonBracketBetweenElectricFluxes.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a{:href => "#CattaneoPerez17"}> CP17 (7)
                )
              %br/
              The Poisson bracket
              %a.maruku-eqref{:href => "#eq:ThePoissonBracketOnCanonicalCoordinates"} (19)
              of electric flux observables
              %a.maruku-eqref{:href => "#eq:TheFluxObservables"} (23)
              among each other is the Lie bracket on their smearing functions:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                    %msubsup
                      %mi Φ
                      %mi E
                      %mi α
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi Φ
                      %mi E
                      %mi β
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Φ
                      %mi E
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi α
                        %mo ,
                        %mi β
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Big\{
                    \\Phi_E^{\alpha}
                    ,\,
                    \\Phi_E^{\beta}
                    \\Big\}
                    \\;=\;
                    \\Phi_E^{ [\alpha,\beta] }
                    \\,.
            %p
          .proof
