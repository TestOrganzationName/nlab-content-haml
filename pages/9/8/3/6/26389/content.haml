                    \\textstyle{\int}
                    \\big\langle
                    \\mathrm{d}_A [\alpha, \beta]
                    ,\,
                    F_A
                    \\big\rangle
                    \\,.
                    \\end{array}
            %p Here we used, in order of appearance:
            %ol
              %li
                %p
                  %a.maruku-eqref{:href => "#eq:PoissonBracketBetweenElectricFieldAndSmearingFunction"} (24)
                  and
                  = succeed ";" do
                    %a.maruku-eqref{:href => "#eq:TheBracketOfElectricFluxWithMagneticFluxDensity"} (25)
              %li
                %p
                  %a.maruku-eqref{:href => "#eq:CyclicInvarianceOfTrilinearPairing"} (18)
                  and
                  %a.maruku-eqref{:href => "#eq:CurvatureFromCovariantDerivativeSquared"} (11)
              %li
                %p
                  %a.maruku-eqref{:href => "#eq:CyclicInvarianceOfTrilinearPairing"} (18)
              %li
                %p
                  %a.maruku-eqref{:href => "#eq:CovariantDerivativeIsDerivationOfLieBracket"}> (10)
                  \.
            %p
          %h3#AlgebraOfQuantumObservablesOnFluxes The algebra of quantum observables on fluxes
          %p
            By Thm.
            = succeed "," do
              %a.maruku-ref{:href => "#ReducedPhaseSpaceOfIntegratedFluxes"}
            %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} quantum observables
            on fluxes in Yang-Mills theory should constitute a
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of the
            %a.existingWikiWord{:href => "/nlab/show/Lie-Poisson+structure"} Lie-Poisson
            %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:SemidirectProductLieAlgebraOfMaps"} (26)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/strict+deformation+quantization"} strict
            (
            %a.existingWikiWord{:href => "/nlab/show/non-perturbative+field+theory"}> non-perturbative
            )
            %a.existingWikiWord{:href => "/nlab/show/deformation+quantization"} deformation
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of
            %a.existingWikiWord{:href => "/nlab/show/phase+spaces"} phase spaces
            which are
            %a.existingWikiWord{:href => "/nlab/show/Lie-Poisson+manifolds"} Lie-Poisson manifolds
            of a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            is well-known &amp;lbrack;
            %a{:href => "C-star+algebraic+deformation+quantization#Rieffel90"}> Rieffel 1990
            ;
            = succeed ";" do
              %a{:href => "C-star+algebraic+deformation+quantization#Landsman99"} Landsman 1999, Ex. 2
            %a{:href => "C-star+algebraic+deformation+quantization#LandsmanRamazan01"} Landsman &amp; Ramazan 2001, Ex. 11.1
            \&amp;rbrack;: The
            %a.existingWikiWord{:href => "/nlab/show/C-star+algebra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
              \-algebra
            of
            %a.existingWikiWord{:href => "/nlab/show/algebra+of+quantum+observables"} quantum observables
            is a
            %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
            of a corresponding
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            (i.e. with the
            %a.existingWikiWord{:href => "/nlab/show/convolution"} convolution
            product), with due care about
            %a.existingWikiWord{:href => "/nlab/show/analysis"} analytic
            issue.
          %p
            Hence consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            (not necessarily
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi 𝔤
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} \big(\mathfrak{g}, [-,-]\big)
            which serves as the actual
            %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            of our
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            which on the
            %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mi{:mathvariant => "normal"} e
                  %mo ⊂
                  %mi G
                %annotation{:encoding => "application/x-tex"} G_{\mathrm{e}} \subset G
            of the
            %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
            restricts to the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
            and which preserves a
            %a.existingWikiWord{:href => "/nlab/show/lattice+%28discrete+subgroup%29"} lattice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                  %mo ⊂
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \Lambda \subset \mathfrak{g}
            (possibly empty, generally not maximal-dimensional), we may take the
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            of the
            %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
            %a.existingWikiWord{:href => "/nlab/show/abelian+Lie+algebra"} abelian Lie algebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            to be the
            %a.existingWikiWord{:href => "/nlab/show/torus"} torus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mo{:stretchy => "false"} /
                  %mi Λ
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}/\Lambda
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/group+action"} group action
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            With these choices, the
            %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mo ⋉
                    %mi ad
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} /
                  %mi Λ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  G \,\ltimes_{ad}\, (\mathfrak{g}/\Lambda)
          %p
            exists and has as
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            the
            %a.existingWikiWord{:href => "/nlab/show/semidirect+product+Lie+algebra"} semidirect product Lie algebra
            defining the
            %a.existingWikiWord{:href => "/nlab/show/Lie-Poisson+structure"} Lie-Poisson structure
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:SemidirectProductLieAlgebraOfMaps"} (26)
          %p
            Therefore a
            %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturvative
            %a.existingWikiWord{:href => "/nlab/show/algebra+of+quantum+observables"} algebra of quantum observables
            is given by the
            %a.existingWikiWord{:href => "/nlab/show/C-star+algebra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
              \-
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi S
                    %mo ,
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mo ⋉
                      %mi ad
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} /
                    %mi Λ
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty\big(S, G \,\ltimes_{ad}\, (\mathfrak{g}/\Lambda)\big)
          %p
            To isolate the topological sector of fluxes, consider the
            %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
            of this group given by the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi S
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mo ⋉
                    %mi ad
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} /
                  %mi Λ
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi π
                    %mn 0
                  %mo{:maxsize => "2.4em", :minsize => "2.4em"} (
                  %mi Map
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                  %mi S
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mo ⋉
                    %mi ad
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} /
                  %mi Λ
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mo{:maxsize => "2.4em", :minsize => "2.4em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\pi_0
                  \\Big(
                  C^\infty\big(
                  S
                  ,\,
                  G \,\ltimes_{ad}\, (\mathfrak{g}/\Lambda)
                  \\big)
                  \\Big)
                  \\;\simeq\;
                  \\pi_0
                  \\bigg(
                  Map\Big(
                  \\esh S
                  ,\,
                  \\esh
                  \\big(
                  G \,\ltimes_{ad}\, (\mathfrak{g}/\Lambda)
                  \\big)
                  \\Big)
                  \\bigg)
          %p
            This is now a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
            serves as an algebra of observables on the topological sectors of fluxes.
          %p (…)
          %p
            %br/
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/flux"} flux
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/flux+tube"} flux tube
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/flux+quantization"} flux quantization
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/flux+compactification"} flux compactification
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cosmic+topology"} cosmic topology
          %h2#references References
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
          %ul
            %li#FreedMooreSegal07a
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Greg+Moore"} Greg Moore
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"} Graeme Segal
                = succeed "," do
                  %em The Uncertainty of Fluxes
                %strong 271
                (2007) 247-274 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/hep-th/0605198"}> arXiv:hep-th/0605198
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/s00220-006-0181-3"} doi:10.1007/s00220-006-0181-3
            %li#FreedMooreSegal07b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Greg+Moore"} Greg Moore
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"} Graeme Segal
                = succeed "," do
                  %em Heisenberg Groups and Noncommutative Fluxes
                %strong 322
                (2007) 236-285 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/hep-th/0605200"}> arXiv:hep-th/0605200
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.aop.2006.07.014"} doi:10.1016/j.aop.2006.07.014
          %p
            In
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            (highlighted for the case of the
            %a.existingWikiWord{:href => "/nlab/show/first-order+formulation+of+gravity"} first-order formulation of gravity
            but applying verbatim also to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            = succeed "):" do
              %a{:href => "Yang-Mills+theory#ReferencesPhaseSpaceAndCanonicalQuantization"} there
          %ul
            %li#CattaneoPerez17
              %a.existingWikiWord{:href => "/nlab/show/Alberto+S.+Cattaneo"}> Alberto S. Cattaneo
              , Alejandro Perez,
              = succeed "," do
                %em A note on the Poisson bracket of 2d smeared fluxes
              %strong 34
              (2017) 107001 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1611.08394"}> arXiv:1611.08394
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1088/1361-6382/aa69b4"} doi:10.1088/1361-6382/aa69b4
          %p
            Proposal of
            %a.existingWikiWord{:href => "/nlab/show/experiments"} experiments
            potentially measuring
            %a.existingWikiWord{:href => "/nlab/show/Heisenberg+uncertainty+relations"} Heisenberg uncertainty relations
            of fluxes:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexei+Kitaev"}> Alexei Kitaev
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gregory+W.+Moore"} Gregory W. Moore
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kevin+Walker"} Kevin Walker
              %em Noncommuting Flux Sectors in a Tabletop Experiment
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/0706.3410"}> arXiv:0706.3410
              \&amp;rbrack;
          %p See also:
          %ul
