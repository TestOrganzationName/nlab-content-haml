            this means for instance, with
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:BracketOfGaugePotentialWithItself"} (6)
          #eq:AAX.maruku-equation
            %span.maruku-eq-number (8)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mi A
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mo −
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mi A
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mtext and hence
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mi A
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\big[A, [A, X]\big]
                  \\;=\;
                  \\big[ [A,A], X \big]
                  \-
                  \\big[A, [A, X]\big]
                  \\;\;\;\;
                  \\text{and hence}
                  \\;\;\;\;
                  \\big[A, [A, X]\big]
                  \\;=\;
                  \\tfrac{1}{2}
                  \\big[ [A,A], X \big]
                  \\,.
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/gauge+potential"} gauge potential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as above
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:GaugePotential"} (3)
            %em
              %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
            is the sum of the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
            with the operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [A,-]
            = succeed ":" do
              %a.maruku-eqref{:href => "#eq:LieBracketOnLieAlgebraValuedDifferentialForms"} (4)
          #eq:CovariantDerivative.maruku-equation
            %span.maruku-eq-number (9)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mi A
                  %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo ≡
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi X
                  %mo +
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %msup
                    %mi X
                    %mo •
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %msup
                    %mi f
                    %mo •
                  %msub
                    %mrow
                    %mrow
                      %mi j
                      %mi k
                  %msup
                    %mi A
                    %mi j
                  %mo ∧
                  %msup
                    %mi X
                    %mi k
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{d}_{A} X
                  \\;\equiv\;
                  \\mathrm{d} X + [A, X]
                  \\;=\;
                  \\mathrm{d} X^\bullet + f^\bullet{}_{j k} A^j \wedge X^k
                  \\,.
          %p
            Since the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                %annotation{:encoding => "application/x-tex"} \mathrm{d}
            is a degree=1
            %a.existingWikiWord{:href => "/nlab/show/graded+derivation"} graded derivation
            on the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+algebra"} de Rham algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi dR
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{dR}
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
            %a.maruku-eqref{:href => "#eq:JacobiIdentity"} (7)
            implies that the
            %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
            %a.maruku-eqref{:href => "#eq:CovariantDerivative"} (9)
            is a degree=1
            %a.existingWikiWord{:href => "/nlab/show/graded+derivation"} graded derivation
            on the
            %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            %a.maruku-eqref{:href => "#eq:LieBracketOnLieAlgebraValuedDifferentialForms"} (4)
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra-valued+differential+forms"} Lie algebra-valued differential forms
          #eq:CovariantDerivativeIsDerivationOfLieBracket.maruku-equation
            %span.maruku-eq-number (10)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mi ω
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %msubsup
                          %mi Ω
                          %mi dR
                          %mi p
                        %mo ⊗
                        %mi 𝔤
                    %mtr
                      %mtd
                        %mi γ
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %msubsup
                          %mi Ω
                          %mi dR
                          %mo •
                        %mo ⊗
                        %mi 𝔤
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mi A
                  %mo{:stretchy => "false"} [
                  %mi ω
                  %mo ,
                  %mi γ
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mi A
                  %mi ω
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi γ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi p
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mi ω
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mi A
                  %mi γ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{l}
                  \\omega \,\in\, \Omega^p_{dR} \otimes \mathfrak{g}
                  \\\
                  \\gamma \,\in\, \Omega^\bullet_{dR} \otimes \mathfrak{g}
                  \\end{array}
                  \\;\;\;\;\;\;\;
                  \\vdash
                  \\;\;\;\;\;\;\;
                  \\mathrm{d}_A [ \omega, \gamma ]
                  \\;=\;
                  \\big[
                  \\mathrm{d}_A \omega
                  ,\,
                  \\gamma
                  \\big]
                  +
                  (-1)^{p}
                  \\big[
                  \\omega
                  ,\,
                  \\mathrm{d}_A \gamma
                  \\big]
                  \\,.
          %p
            Another key point is that applying the
            %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
            %a.maruku-eqref{:href => "#eq:CovariantDerivative"} (9)
            twice is equal to applying the Lie bracket
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi F
                    %mi A
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [F_A, -]
            with the
            %a.existingWikiWord{:href => "/nlab/show/curvature+2-form"} curvature 2-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo ≡
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi A
                  %mo +
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  F_A
                  \\;\equiv\;
                  \\mathrm{d}A + \tfrac{1}{2}[A, A]
                  \\,,
          %p
            representing the
            %a.existingWikiWord{:href => "/nlab/show/magnetic+charge"} magnetic
            %a.existingWikiWord{:href => "/nlab/show/flux+density"} flux density
            carried by the
            %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          #eq:CurvatureFromCovariantDerivativeSquared.maruku-equation
            %span.maruku-eq-number (11)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
