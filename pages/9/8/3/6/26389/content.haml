                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{c}
                  \\Phi_E^\alpha
                  \\;\overset{?}{\equiv}\;
                  \\int_S \langle \alpha,  E \rangle
                  \\,,
                  \\\
                  \\Phi_B^\beta
                  \\;\overset{?}{\equiv}\;
                  \\int_S \langle \alpha, F_A \rangle
                  \\,,
                  \\end{array}
                  \\;\;\;\;\;\;\;\;
                  \\text{for}
                  \\;\;
                  \\alpha, \beta
                  \\;\in\;
                  \\Omega^0(S) \otimes \mathfrak{g}
          %p
            and more general flux observables ought to be taken to be the
            %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
            in these linear observables.
          %p
            However, these expressions
            %a.maruku-eqref{:href => "#eq:NaiveFluxObservables"} (22)
            need to be corrected (“regularized”) in order to become actual observables, since as given they do not have associated smooth
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
            = succeed ":" do
              %a{:href => "#CattaneoPerez17"} Cattaneo &amp; Perez 2017
            %a.maruku-ref{:href => "#TheProperFluxObservables"}
            below.
          %p
            Using the orientation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            we consider any one-sided
            %a.existingWikiWord{:href => "/nlab/show/tubular+neighbourhood"} tubular neighbourhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi S
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat S
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            inside
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            (a non-compact
            %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
            %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} with boundary
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %blockquote
            %p
              (
              %a{:href => "#CattaneoPerez17"} CP17
              speak of extending to the “interior” and seem to imagine that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is actually the boundary of a compact sub-manifold – which however is generally not what one wants to assume in discussion of fluxes: Typical choices of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              coincide with actual (
              %a.existingWikiWord{:href => "/nlab/show/asymptotic+boundary"}> asymptotic
              ) boundaries of the ambient spacetime, such as around the singular locus of a
              %a.existingWikiWord{:href => "/nlab/show/magnetic+monopole"} magnetic monopole
              that has been removed from spacetime. Our choice of extending to a neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              towards the exterior, instead of the interior, works just as well and allows
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              to actually sit on a boundary of spacetime.)
          %p
            and extending the coefficient functions to this neighbourhood with
            %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
            (i.e. such that they vanish some finite distance from
            = succeed "):" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
          #TheProperFluxObservables.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a{:href => "#CattaneoPerez17"}> CP17 (6)
                )
              Well-defined linear flux-observables equivalent to the naïve observables
              %a.maruku-eqref{:href => "#eq:NaiveFluxObservables"} (22)
              are of this form:
            #eq:TheFluxObservables.maruku-equation
              %span.maruku-eq-number (23)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msubsup
                            %mi Φ
                            %mi E
                            %mi α
                          %mspace{:width => "thickmathspace"}
                          %mo ≡
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mo ∫
                            %mover
                              %mi S
                              %mo ^
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                          %msub
                            %mi{:mathvariant => "normal"} d
                            %mi A
                          %mi α
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi E
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                      %mtr
                        %mtd
                          %msubsup
                            %mi Φ
                            %mi B
                            %mi β
                          %mspace{:width => "thickmathspace"}
                          %mo ≡
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mo ∫
                            %mover
                              %mi S
                              %mo ^
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                          %msub
                            %mi{:mathvariant => "normal"} d
                            %mi A
                          %mi α
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi F
                            %mi A
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext for
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi α
                    %mo ,
                    %mi β
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mn 0
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mover
                      %mi S
                      %mo ^
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi cpt
                    %mo ⊗
                    %mi 𝔤
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    \\Phi_E^\alpha
                    \\;\equiv\;
                    \\int_{\widehat S}
                    \\big\langle
                    \\mathrm{d}_A \alpha
                    ,\,
                    E
                    \\big\rangle
                    \\,,
                    \\\
                    \\Phi_B^\beta
                    \\;\equiv\;
                    \\int_{\widehat S}
                    \\big\langle
                    \\mathrm{d}_A \alpha
                    ,\,
                    F_A
                    \\big\rangle
                    \\,,
                    \\end{array}
                    \\;\;\;\;
                    \\text{for}
                    \\;\;
                    \\alpha, \beta
                    \\;\in\;
                    \\Omega^0\big(\widehat S \big)_{cpt}
                    \\otimes \mathfrak{g}
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              To check that these are indeed equivalent to the naïve observables, in that the difference is proportional to the left hand side of the
              %a.existingWikiWord{:href => "/nlab/show/Gauss+law"} Gauss law
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:GaussLawConstraint"} (20)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mo ∫
                            %mover
                              %mi S
                              %mo ^
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                          %msub
                            %mi{:mathvariant => "normal"} d
                            %mi A
                          %mi α
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi E
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≈
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mo ∫
                            %mover
                              %mi S
                              %mo ^
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                          %msub
                            %mi{:mathvariant => "normal"} d
                            %mi A
                          %mi α
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi E
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                          %mo +
                          %munder
                            %munder
                              %mrow
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                                %mi α
                                %mo ,
                                %mspace{:width => "thinmathspace"}
                                %msub
                                  %mi{:mathvariant => "normal"} d
                                  %mi A
                                %mi E
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                              %mo ⏟
                            %mrow
                              %mo ≈
                              %mn 0
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mo ∫
                            %mover
                              %mi S
                              %mo ^
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                          %mi{:mathvariant => "normal"} d
                          %mi α
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi E
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                          %mspace{:width => "thinmathspace"}
                          %mo +
                          %mspace{:width => "thinmathspace"}
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                          %mi α
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi{:mathvariant => "normal"} d
                          %mi E
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mo ∫
                            %mover
                              %mi S
                              %mo ^
                          %mi{:mathvariant => "normal"} d
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                          %mi α
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi E
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mo ∫
                            %mi S
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                          %mi α
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi E
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    \\int_{\widehat{S}}
                    \\big\langle
                    \\mathrm{d}_A \alpha
                    ,\,
                    E
                    \\big\rangle
                    \\\
                    \\;\approx\;
                    \\int_{\widehat{S}}
                    \\Big(
                    \\big\langle
                    \\mathrm{d}_A \alpha
                    ,\,
                    E
                    \\big\rangle
                    +
                    \\underset{
                    \\approx 0
                    }{
                    \\underbrace{
                    \\big\langle
                    \\alpha
                    ,\,
                    \\mathrm{d}_A E
                    \\big\rangle
                    }
                    }
                    \\Big)
                    \\\
                    \\;=\;
                    \\int_{\widehat{S}}
                    \\Big(
                    \\big\langle
                    \\mathrm{d} \alpha
                    ,\,
                    E
                    \\big\rangle
                    \\,+\,
                    \\big\langle
                    \\alpha
                    ,\,
                    \\mathrm{d} E
                    \\big\rangle
                    \\Big)
                    \\\
                    \\;=\;
                    \\int_{\widehat{S}}
                    \\mathrm{d}
                    \\big\langle
                    \\alpha
                    ,\,
                    E
                    \\big\rangle
                    \\\
                    \\;=\;
                    \\int_{S}
                    \\big\langle
                    \\alpha
                    ,\,
                    E
                    \\big\rangle
                    \\mathrlap{\,,}
                    \\end{array}
            %p where we used:
            %ol
              %li
                %p the Gauss law
              %li
                %p
                  %a.maruku-eqref{:href => "#eq:AdInvarianceOfPairingOnLieAlgValuedForms"} (15)
              %li
                %p
                  derivation property of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} d
                      %annotation{:encoding => "application/x-tex"} \mathrm{d}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Stokes+theorem"} Stokes
            %p
          %p
            %br/
          %p
            In the computation
            = succeed "," do
              %a{:href => "#ThePoissonBracketOfIntegratedFluxes"} below
            = succeed ":" do
              %a.maruku-eqref{:href => "#eq:ThePoissonBracketOnCanonicalCoordinates"} (19)
          %p
          .num_remark
            %h6 Example
            %p
              A key consequence of the corrected flux observables
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:TheFluxObservables"} (23)
            #eq:PoissonBracketBetweenElectricFieldAndSmearingFunction.maruku-equation
              %span.maruku-eq-number (24)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
