                    %mi t
                    %mi i
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi t
                    %mi j
                  %mo ,
                  %msub
                    %mi t
                    %mi k
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi t
                    %mi i
                  %mo ,
                  %msub
                    %mi t
                    %mi j
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %msub
                    %mi t
                    %mi k
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo +
                  %mspace{:width => "thinmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %msub
                    %mi t
                    %mi j
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi t
                    %mi i
                  %mo ,
                  %msub
                    %mi t
                    %mi k
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi f
                    %mo •
                  %msub
                    %mrow
                    %mrow
                      %mi i
                      %mi l
                  %msup
                    %mi f
                    %mi l
                  %msub
                    %mrow
                    %mrow
                      %mi j
                      %mi k
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi f
                    %mo •
                  %msub
                    %mrow
                    %mrow
                      %mi l
                      %mi k
                  %msup
                    %mi f
                    %mi l
                  %msub
                    %mrow
                    %mrow
                      %mi i
                      %mi j
                  %mspace{:width => "thinmathspace"}
                  %mo +
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi f
                    %mo •
                  %msub
                    %mrow
                    %mrow
                      %mi j
                      %mi l
                  %msup
                    %mi f
                    %mi l
                  %msub
                    %mrow
                    %mrow
                      %mi i
                      %mi k
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\big[t_i, [t_j, t_k] \big]
                  \\;=\;
                  \\big[ [t_i, t_j], t_k] \big]
                  \\,+\,
                  \\big[ t_j, [t_i, t_k] \big]
                  \\;\;\;\;\;
                  \\Leftrightarrow
                  \\;\;\;\;\;
                  f^\bullet{}_{i l} f^{l}{}_{j k}
                  \\;=\;
