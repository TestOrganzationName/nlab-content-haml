                            %mo ∫
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi{:mathvariant => "normal"} d
                              %mi A
                            %msub
                              %mi α
                              %mi i
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %msup
                              %mi E
                              %mi i
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi{:mathvariant => "normal"} d
