          %p
            For example, the Lie bracket of the
            %a.existingWikiWord{:href => "/nlab/show/gauge+potential"} gauge potential
            1-form
            %a.maruku-eqref{:href => "#eq:GaugePotential"} (3)
            with itself is:
          #eq:BracketOfGaugePotentialWithItself.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo ≡
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi A
                    %mi j
                  %mo ∧
                  %msup
                    %mi A
                    %mi k
                  %mo ⊗
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi t
                    %mi i
                  %mo ,
                  %msub
                    %mi t
                    %mi j
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi f
                    %mi i
