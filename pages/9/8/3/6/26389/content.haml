                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [ A , A ]
                  \\;\equiv\;
                  A^j \wedge A^k \otimes [t_i, t_j]
                  \\;=\;
                  f^i{}_{j k}
                  \\,
                  A^j \wedge A^k \otimes t_i
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi t
                    %mi i
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [t_i,-]
