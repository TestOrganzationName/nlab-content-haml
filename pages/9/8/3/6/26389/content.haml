                  \\mathrm{d}_A \big(
                  \\mathrm{d}X + [A,X]
                  \\big)
                  \\\
                  \\;=\;
                  [A, \mathrm{d}X]
                  +
                  \\mathrm{d}[A,X]
                  +
                  \\big[ A, [A, X] \big]
                  \\\
                  \\;=\;
                  [A, \mathrm{d}X]
                  +
                  [\mathrm{d} A,X]
                  \-
                  [A, \mathrm{d} X]
                  +
                  \\tfrac{1}{2}\big[ [A, A],  X \big]
