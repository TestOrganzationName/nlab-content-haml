                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                          %mspace{:width => "thinmathspace"}
                          %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    \\Big\{
                    \\textstyle{\int}
                    \\omega_i E^i
                    ,\,
                    \\tfrac{1}{2} [A, A]
                    \\Big\}
                    \\\
                    \\;=\;
                    \\tfrac{1}{2}
                    \\Big[
                    \\big\{
                    \\textstyle{\int}
                    \\omega_i E^i
                    ,\,
                    A
                    \\big\}
                    ,\,
                    A
                    \\Big]
                    +
                    \\tfrac{1}{2}
                    \\Big[
                    A
                    ,\,
                    \\big\{
                    \\textstyle{\int}
                    \\omega_i E^i
                    ,\,
                    A
                    \\big\}
                    \\Big]
                    \\\
                    \\;=\;
                    \\big[
                    A
                    ,\,
                    \\omega
                    \\big]
