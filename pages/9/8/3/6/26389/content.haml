                    \\;=\;
                    \\mathrm{d}
                    \\Big\{
                    \\textstyle{\int}
                    \\big(\mathrm{d}_A \alpha_i \big) \wedge E^i
                    ,\,
                    A(x')
                    \\Big\}
                    \\\
                    \\;=\;
                    \\mathrm{d}
                    \\big(\mathrm{d}_A \alpha(x') \big)
                    \\,.
                    \\end{array}
            %p
              For the second summand, considering any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
