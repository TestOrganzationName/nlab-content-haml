                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                          %mstyle{:displaystyle => "false"}
                            %mo ∫
                            %msub
                              %mi ω
                              %mi i
                            %msup
                              %mi E
                              %mi i
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mo{:stretchy => "false"} [
                            %mi A
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} [
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
