              is the
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+%E2%88%9E-bundle"} universal principal ∞-bundle
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              in the canonical
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model
              for the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/SynthDiff%E2%88%9EGrpd"} SynthDiff∞Grpd
              = succeed "." do
