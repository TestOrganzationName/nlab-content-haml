                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo ∨
                                %mspace{:width => "negativethinmathspace"}
                                %mspace{:width => "negativethinmathspace"}
                                %mspace{:width => "negativethinmathspace"}
                                %mo ∧
                              %mi supp
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi A
                                %mn 2
                              %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T(A_1 A_2)
                    \\;=\;
                    \\left\{
                    \\array{
                    A_1 \star_H A_2 &amp;\vert&amp; supp(A_1) {\vee\!\!\!\wedge} supp(A_2)
                    \\\
                    A_2 \star_H A_1 &amp;\vert&amp; supp(A_2) {\vee\!\!\!\wedge} supp(A_2)
                    }
                    \\right.
                    \\,.
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                    %mrow
                      %mo ∨
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo ∧
                    %msub
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S_1 {\vee\!\!\!\wedge} S_2
              is the
              %a.existingWikiWord{:href => "/nlab/show/causal+order"} causal order
              relation (“
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S_1
              does not intersect the
              %a.existingWikiWord{:href => "/nlab/show/past+cone"} past cone
