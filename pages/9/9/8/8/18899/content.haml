                    %msup
                      %mi y
                      %mn 0
                    %mo −
                    %mi ϵ
                    %mo ,
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi ϕ
