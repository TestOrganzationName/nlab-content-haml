                    \\Big\rangle
                    \\;=\;
                    \-\mathrm{i}\hbar f(\vec y)
                    \\mathrlap{\,.}
            %p
              But since this holds for all smearing functions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distributional
              equation
            #eq:UnIntegratedSchwingerDysonForComputingCCRsViaMomenta.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %munder
                        %mo ⟶
                        %mrow
                          %mi ϵ
                          %mo →
