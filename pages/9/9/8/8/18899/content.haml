          .proof
            %h6#proof Proof
            %p Recall the following facts:
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/advanced+and+retarded+propagators"} advanced and retarded propagators
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mo ±
                      %annotation{:encoding => "application/x-tex"} \Delta_{\pm}
                  by definition are
                  %a.existingWikiWord{:href => "/nlab/show/support"} supported
                  in the
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/future+cone"} future cone
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/past+cone"} past cone
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi supp
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Δ
                          %mo ±
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msup
                          %mover
                            %mi V
                            %mo ¯
                          %mo ±
                      %annotation{:encoding => "application/x-tex"}
                        supp(\Delta_{\pm}) \subset \overline{V}^{\pm}
              %li
                %p
                  they turn into each other under exchange of their arguments (
                  %a{:href => "causal+propagator#CausalPropagatorIsSkewSymmetric"}> this cor.
                  ):
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
