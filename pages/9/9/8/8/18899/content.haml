                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi dvol
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi dvol
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    A_1 \star_F A_2
                    \\;
                    \\coloneqq
                    \\;
                    ((-)\cdot(-))
                    \\circ
                    \\exp\left(
                    \\underset{\Sigma \times \Sigma}{\int}
                    \\Delta_F^{a b}(x,y)
                    \\frac{\delta}{\delta \mathbf{\Phi}^a(x)}
                    \\otimes
                    \\frac{\delta}{\delta \mathbf{\Phi}^b(y)}
                    \\,
                    dvol_\Sigma(x)
                    \\,
                    dvol_\Sigma(y)
                    \\right)
            %p
              (Notice that this does not descend to the
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              observables, since the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              is not a solution to the
              %em homogeneous
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
          #CausalOrderingTimeOrderedProductOnRegular.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
                is indeed causally ordered
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
                product)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              over a
              %a.existingWikiWord{:href => "/nlab/show/Lorentzian+manifold"} Lorentzian
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              and with
              %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"} Green-hyperbolic
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/differential+equations"} differential equations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi S
                    %mo =
                    %msub
                      %mi Δ
                      %mo +
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi Δ
                      %mo −
                  %annotation{:encoding => "application/x-tex"} \Delta_S = \Delta_+ - \Delta_-
              for the induced
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                    %mo =
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %msub
                      %mi Δ
                      %mi S
                    %mo +
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H = \tfrac{i}{2}\Delta_S + H
              be a compatible
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi F
                    %mo =
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mo +
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msub
                      %mi Δ
                      %mo −
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_F = \tfrac{i}{2}(\Delta_+ + \Delta_-) + H
              for the induced
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
              on
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OnRegularPolynomialObservablesTimeOrderedProduct"}
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋆
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \star_H
              in that for all
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              of
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %mo ∈
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
