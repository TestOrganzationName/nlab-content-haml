                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
                  %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
                  is symmetric (by definition or else by
                  = succeed "):" do
                    %a{:href => "Hadamard+distribution#SkewSymmetricPartOfHadmrdPropagatorIsCausalPropagatorForKleinGordonEquationOnMinkowskiSpacetime"} this prop.
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        H(x,y) = H(y,x)
            %p Using this we compute as follows:
