                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    A_1, A_2 \in PolyObs(E)_{reg}[ [\hbar] ]
            %p
              with
              %a.existingWikiWord{:href => "/nlab/show/disjoint+subset"} disjoint
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a.existingWikiWord{:href => "/nlab/show/support"} support
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
