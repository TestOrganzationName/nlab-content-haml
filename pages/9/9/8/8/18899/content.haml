                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mi{:mathvariant => "normal"} i
                    %mi ℏ
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\underset{\epsilon\to 0}{\longrightarrow}}{\lim}
                    \\int_{\mathbb{R}^{d}/\mathbb{Z}^{d}}
                    \\mathrm{d}^d x
                    \\,
                    \\int \mathrm{d}^d \vec x
                    f(\vec x)
                    \\Big\langle
                    \\pi(y^0 + \epsilon, \vec x)
                    \\,
                    \\phi(y^0, \vec y)
                    \\;-\;
                    \\pi(y^0 - \epsilon, \vec x)
                    \\,
