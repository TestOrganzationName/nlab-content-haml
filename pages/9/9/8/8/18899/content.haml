                      %mspace{:width => "thickmathspace"}
                      %mo −
                      %mspace{:width => "thickmathspace"}
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi L
                        %mrow
                          %mo ∂
                          %mo{:stretchy => "false"} (
                          %msub
                            %mo ∂
                            %mn 0
                          %mi ϕ
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi y
                        %mn 0
                      %mo −
                      %mi ϵ
                      %mo ,
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi y
                        %mn 0
                      %mo ,
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %mo ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mi{:mathvariant => "normal"} i
                    %mi ℏ
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\underset{\epsilon\to 0}{\longrightarrow}}{\lim}
                    \\int_{\mathbb{R}^{d}/\mathbb{Z}^{d}}
                    \\mathrm{d}^d \vec x
                    \\,
                    \\left\langle
                    \\frac{ \partial L }{ \partial (\partial_0 \phi) }
                    (y^0 + \epsilon, \vec x)
                    \\,
                    \\phi(y^0, \vec y)
                    \\;-\;
                    \\frac{ \partial L }{ \partial (\partial_0 \phi) }
                    (y^0 - \epsilon, \vec x)
                    \\,
                    \\phi(y^0, \vec y)
                    \\right\rangle
                    \\;=\;
                    \-\mathrm{i}\hbar
                    \\mathrlap{\,.}
            %p
              Here we recognize the
              %a.existingWikiWord{:href => "/nlab/show/canonical+momentum"} canonical momentum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              to the field
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi L
                      %mrow
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∂
                          %mn 0
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\pi(x)
                    \\;\coloneqq\;
                    \\frac{ \partial L }{ \partial (\partial_0 \phi) }(x)
                    \\mathrlap{\,,}
            %p so that
            #eq:IntegratedSchwingerDysonForComputingCCRsViaMomenta.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %munder
                        %mo ⟶
                        %mrow
                          %mi ϵ
                          %mo →
                          %mn 0
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi ℝ
                          %mi d
                        %mo{:stretchy => "false"} /
                        %msup
                          %mi ℤ
                          %mi d
                    %msup
                      %mi{:mathvariant => "normal"} d
                      %mi d
                    %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟨
                    %mi π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo +
                    %mi ϵ
                    %mo ,
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo ,
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mspace{:width => "thickmathspace"}
                    %mi π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo −
                    %mi ϵ
                    %mo ,
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo ,
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mi{:mathvariant => "normal"} i
                    %mi ℏ
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\underset{\epsilon\to 0}{\longrightarrow}}{\lim}
                    \\int_{\mathbb{R}^{d}/\mathbb{Z}^{d}}
                    \\mathrm{d}^d x
                    \\,
                    \\Big\langle
                    \\pi(y^0 + \epsilon, \vec x)
                    \\,
                    \\phi(y^0, \vec y)
                    \\;-\;
                    \\pi(y^0 - \epsilon, \vec x)
                    \\,
                    \\phi(y^0, \vec y)
                    \\Big\rangle
                    \\;=\;
                    \-\mathrm{i}\hbar
                    \\mathrlap{\,.}
            %blockquote
              %p
                This is the field-theoretic version of Feynman’s
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:FeynmanCCRViaTimeShiftedProduct"} (3)
            %p
              We may redo this derivation after multiplication of the original Schwinger-Dyson equation
              %a.maruku-eqref{:href => "#eq:SchwingerDysonForComputingCCRs"} (4)
              with any “smearing function”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(\vec x)
              (a spatial
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              %a.existingWikiWord{:href => "/nlab/show/Stokes%27+theorem"} Stokes' theorem
              above we are now faced with an
              %a.existingWikiWord{:href => "/nlab/show/integration+by+parts"} integration by parts
              that picks up terms proportional to the
              %a.existingWikiWord{:href => "/nlab/show/gradient"} gradient
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              — but if the dependence of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              on spatial derivatives of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              does not have unusual singularities (i.e. if the
              %a.existingWikiWord{:href => "/nlab/show/kinetic+energy"} kinetic energy
              term in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is a standard one) then these terms vanish with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              just as the
              %a.existingWikiWord{:href => "/nlab/show/potential+energy"} potential energy
              term does, and hence we end up with
            #eq:IntegratedSchwingerDysonForComputingCCRsViaMomenta.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %munder
                        %mo ⟶
                        %mrow
                          %mi ϵ
                          %mo →
                          %mn 0
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi ℝ
                          %mi d
                        %mo{:stretchy => "false"} /
                        %msup
                          %mi ℤ
                          %mi d
                    %msup
                      %mi{:mathvariant => "normal"} d
                      %mi d
                    %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo ∫
                    %msup
                      %mi{:mathvariant => "normal"} d
                      %mi d
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟨
                    %mi π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo +
                    %mi ϵ
                    %mo ,
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
