                      %mfrac
                        %mi i
                        %mn 2
                    %msub
                      %mi Δ
                      %mi S
                    %mo +
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H = \tfrac{i}{2}\Delta_S + H
              be a compatible
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi F
                    %mo =
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mo +
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msub
                      %mi Δ
                      %mo −
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_F = \tfrac{i}{2}(\Delta_+ + \Delta_-) + H
              for the induced
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
            %p
              Then the
              %em
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
              on the space of
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observable"} regular polynomial observable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
