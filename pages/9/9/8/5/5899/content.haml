            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi μ
                  %mo ,
                  %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (T,\mu,\eta)
            is left (resp. right)
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint
            to a
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi δ
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (G,\delta,\epsilon)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is
            %em
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            (resp.
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %a.existingWikiWord{:href => "/nlab/show/1-morphism"} 1-morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            of the comonad, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                %annotation{:encoding => "application/x-tex"} \delta
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} \epsilon
            are conjugate/adjoint/
            %a.existingWikiWord{:href => "/nlab/show/mate"} mate
            2-cells to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            in the sense explained below.
          %h2#construction Construction
          %p
            In fact given a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi T
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %msup
                    %mi μ
                    %mi T
                  %mo ,
                  %msup
                    %mi η
                    %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{T} = (T,\mu^T,\eta^T)
            which has a
            %em
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a part of a comonad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %msup
                    %mi δ
                    %mi G
                  %mo ,
                  %msup
                    %mi ϵ
                    %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{G} = (G,\delta^G,\epsilon^G)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi δ
                    %mi G
                %annotation{:encoding => "application/x-tex"} \delta^G
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ϵ
                    %mi G
                %annotation{:encoding => "application/x-tex"} \epsilon^G
            are in some sense dual to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi μ
                    %mi T
                %annotation{:encoding => "application/x-tex"} \mu^T
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi η
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \eta^T
          %p Thus there is a bijective correspondence between monads having a right adjoint and comonads having a left adjoint (and “2-dually” between comonads having a right adjoint and monads having a left adjoint, as explained below). This is little more than a consequence of two general facts:
          %ol
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ⊣
                      %mi G
                    %annotation{:encoding => "application/x-tex"} T\dashv G
                then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi T
                        %mi k
                      %mo ⊣
                      %msup
                        %mi G
                        %mi k
                    %annotation{:encoding => "application/x-tex"} T^k \dashv G^k
                for every
                %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
            %li
              %p
                Given two
                %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊣
                      %mi T
                    %annotation{:encoding => "application/x-tex"} S\dashv T
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ′
                      %mo ⊣
                      %mi T
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} S'\dashv T'
                where
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo ,
                        %mi S
                        %mo ′
                        %mo :
                        %mi B
                        %mo →
                        %mi A
                      %annotation{:encoding => "application/x-tex"} S,S': B\to A
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                between the
                %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi S
                      %mo ′
                      %mo ⇒
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \phi:S'\Rightarrow S
                and natural transformations
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo :
                      %mi T
                      %mo ⇒
                      %mi T
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \psi:T\Rightarrow T'
                such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mi T
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi A
                                %mo{:stretchy => "false"} (
                                %mi ϕ
                                %mo ,
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %msup
                            %mrow
                            %mpadded{:width => "0"}
                              %mrow
                                %mi B
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo ,
                                %mi ψ
                                %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi A
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo ′
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mi T
                          %mo ′
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A (S,-) &amp;\to&amp; B(-,T)
                  \\\
                  {}^{\mathllap{A(\phi,-)}}\downarrow &amp;&amp;\downarrow {}^{\mathrlap{B(-,\psi)}}
                  \\\
                  A(S',-)&amp;\to &amp; B(-,T')
                  }
          %p
            where the horizontal arrows are the natural bijections given by the adjunctions.
            %a{:href => "#EilenbergMoore65"} Eilenberg &amp; Moore 1965
            would write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo ⊣
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \phi\dashv\psi
            and talk about “adjointness for morphisms” (of functors), which is of course relative to the given adjunctions among functors. MacLane calls the correspondence
            %em conjugation
            (p 99-102 in
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Categories+for+Working+Mathematician"} Categories for Working Mathematician
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/mates"} mates
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo ,
                  %mi η
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \eta,\eta'
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo ,
                  %mi ϵ
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \epsilon,\epsilon'
            are their
            %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
            and counit of course the upper arrow is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mi M
                  %mover
                    %mo →
                    %mi f
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi T
                  %mi f
                  %mo ∘
                  %msub
                    %mi η
                    %mi M
                %annotation{:encoding => "application/x-tex"} (S M\stackrel{f}\to N)\mapsto T f\circ \eta_M
            and the lower arrow
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ′
                    %mi M
                    %mover
                      %mo →
                      %mi g
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi T
                    %mo ′
                    %mi g
                    %mo ∘
                    %mi η
                    %msub
                      %mo ′
                      %mi M
                  %annotation{:encoding => "application/x-tex"} (S'M\stackrel{g}\to N)\mapsto T'g\circ\eta'_M
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ∘
                  %msub
                    %mi ϕ
                    %mi M
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi η
                  %msub
                    %mo ′
                    %mi M
                  %mo =
                  %msub
                    %mi ψ
                    %mi N
                  %mo ∘
                  %mi T
                  %mi f
                  %mo ∘
                  %msub
                    %mi η
                    %mi M
                %annotation{:encoding => "application/x-tex"} T'(f\circ\phi_M)\circ\eta'_M = \psi_N\circ T f\circ\eta_M
          %p
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ′
                    %mi f
                    %mo ∘
                    %mi T
                    %mo ′
                    %msub
                      %mi ϕ
                      %mi M
                    %mo ∘
                    %mi η
                    %msub
                      %mo ′
                      %mi M
                    %mo =
                    %mi T
                    %mo ′
                    %mi f
                    %mo ∘
                    %msub
                      %mi ψ
                      %mi SM
                    %mo ∘
                    %msub
                      %mi η
                      %mi M
                  %annotation{:encoding => "application/x-tex"} T'f\circ T'\phi_M\circ\eta'_M = T'f\circ \psi_{SM}\circ\eta_M
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi ψ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(-,\psi)
            is clear from the above
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} invertible
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi ψ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(-,\psi)
            determines
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mi N
                    %mo =
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \psi_N = B(-,\psi)(id_N)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \psi
            (given
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \psi
            is the composition
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo =
                    %mi T
                    %mo ′
                    %mi ϵ
                    %mo ∘
                    %mi T
                    %mo ′
                    %mi ϕ
                    %mi T
                    %mo ∘
                    %mi η
                    %mo ′
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \psi  = T'\epsilon \circ T'\phi T \circ \eta'T
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mover
                    %mo ⟶
                    %mrow
                      %mi η
                      %mo ′
                      %mi T
                  %mi T
                  %mo ′
                  %mi S
                  %mo ′
                  %mi T
                  %mover
                    %mo ⟶
                    %mrow
                      %mi T
                      %mo ′
                      %mi ϕ
                      %mi T
                  %mi T
                  %mo ′
                  %mi S
                  %mi T
                  %mover
                    %mo ⟶
                    %mrow
                      %mi T
                      %mo ′
                      %mi ϵ
                  %mi T
                  %mo ′
                %annotation{:encoding => "application/x-tex"}
                  T\stackrel{\eta' T}\longrightarrow T'S' T\stackrel{T'\phi T}\longrightarrow T' S T \stackrel{T'\epsilon}\longrightarrow T'
          %p and checks that it works. The inverse is similarly given by the composition
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ′
                  %mover
                    %mo ⟶
                    %mrow
                      %mi S
                      %mo ′
                      %mi η
                  %mi S
                  %mo ′
                  %mi T
                  %mi S
                  %mover
                    %mo ⟶
                    %mrow
                      %mi S
                      %mo ′
                      %mi ψ
                      %mi S
                  %mi S
                  %mo ′
                  %mi T
                  %mo ′
                  %mi S
                  %mover
                    %mo ⟶
                    %mrow
                      %mi ϵ
                      %mo ′
                      %mi S
                  %mi S
                %annotation{:encoding => "application/x-tex"}
                  S'\stackrel{S'\eta}\longrightarrow S' T S\stackrel{S'\psi S}\longrightarrow S'T'S\stackrel{\epsilon' S}\longrightarrow S
          %p
            This correspondence now enables in our special case to dualize
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi μ
                    %mi T
                %annotation{:encoding => "application/x-tex"} \mu^T
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi δ
                      %mi G
                  %annotation{:encoding => "application/x-tex"} \delta^G
          %h2#duality Duality
          %p
            The construction above easily dualises to a bijection between
            %em comonads
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            having a
            %em right
            adjoint and
            %em monads
            having a
            %em left
            adjoint. However, 1-categorical duality is not enough to analyse this: in the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
            = succeed ");" do
              %a.existingWikiWord{:href => "/nlab/show/opposite+adjunction"} opposite adjunction
          %p
            Instead, as explained in
            = succeed "," do
              %a{:href => "https://math.stackexchange.com/a/3564754"} math.SE:a/3564754
            %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            and
            %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
            in any
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
