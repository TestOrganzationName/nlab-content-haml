          %p
          #AdjointMonadsInducedFromAdjointTriples.num_remark
            %h6 Example
            %p
              %strong (adjoint monads induced from adjoint triples of adjoint functors)
              %br/
              Every
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              (of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mo ⊣
                    %msub
                      %mi F
                      %mo *
                    %mo ⊣
                    %msup
                      %mi F
                      %mo !
                  %annotation{:encoding => "application/x-tex"} F^*\dashv F_* \dashv F^!
              %a{:href => "monad#RelationBetweenAdjunctionsAndMonads"} induces
              an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo *
                      %msup
                        %mi F
                        %mo *
                      %mo ⊣
                      %msub
                        %mi F
                        %mo *
                      %msup
                        %mi F
                        %mo !
                    %annotation{:encoding => "application/x-tex"} F_* F^*\dashv F_* F^!
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo *
                    %msup
                      %mi F
                      %mo *
                  %annotation{:encoding => "application/x-tex"} F_* F^*
              is underlying a monad induced by the adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mo ⊣
                    %msub
                      %mi F
                      %mo *
                  %annotation{:encoding => "application/x-tex"} F^*\dashv F_*
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo *
                    %msup
                      %mi F
                      %mo !
                  %annotation{:encoding => "application/x-tex"} F_* F^!
              is underlying a comonad induced by the adjuntion
