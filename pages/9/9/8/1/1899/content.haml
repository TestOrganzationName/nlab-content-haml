              %p
                A
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                = succeed "-coalgebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
            %li
              %p
                A
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                for which
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hom(R, -)
                is provided with a left
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
            %li
              %p
                A
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                for which
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ⋅
                      %mi R
                    %annotation{:encoding => "application/x-tex"} -\cdot R
                is provided with a right
                = succeed "-algebra/module" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
          %p The following proposition gives two more useful descriptions:
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ladj
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Set
                      %mi T
                    %mo ,
                    %msup
                      %mi Set
                      %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ladj(Set^T, Set^T)
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi Radj
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Set
                      %mi T
                    %mo ,
                    %msup
                      %mi Set
                      %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Radj(Set^T, Set^T)
              ) be the category of left (right) adjoint functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ψ
                      %mo :
                      %msup
                        %mi Set
                        %mi T
                      %mo →
                      %msup
                        %mi Set
                        %mi T
                    %annotation{:encoding => "application/x-tex"} \Psi: Set^T \to Set^T
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi BiAlg
                    %mo →
                    %mi Ladj
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Set
                      %mi T
                    %mo ,
                    %msup
                      %mi Set
                      %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} BiAlg \to Ladj(Set^T, Set^T)
              that takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (R, \phi)
              to the right
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi R
                    %mo ,
                    %mi β
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (W_R, \beta)
              is an equivalence. Or, what is the same, the functor
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi BiAlg
                      %mo →
                      %mi Radj
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Set
                        %mi T
                      %mo ,
                      %msup
                        %mi Set
                        %mi T
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                    %annotation{:encoding => "application/x-tex"} BiAlg \to Radj(Set^T, Set^T)^{op}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (R, \phi)
              to the left
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi α
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hom(R, -), \alpha)
          .proof
            %h6#sketch_of_proof Sketch of proof
            %p
              The main thing to check is that the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ↦
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R \mapsto \hom(R, -)
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Radj
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Set
                      %mi T
                    %mo ,
                    %msup
                      %mi Set
                      %mi T
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Radj(Set^T, Set^T)^{op}
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              has a left adjoint iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} U \Phi
              has a left adjoint iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi Φ
                    %mo :
                    %msup
                      %mi Set
                      %mi T
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U \Phi: Set^T \to Set
              is
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi Φ
                    %mo ≅
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U \Phi \cong \hom(R, -)
              for some
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              (in which case the lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(R, -)
              through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is tantamount to a
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hom(R, -)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              has a left adjoint if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} U\Phi
              has a left adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo =
                      %msub
                        %mi W
                        %mi R
                    %annotation{:encoding => "application/x-tex"} W = W_R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                  %annotation{:encoding => "application/x-tex"} \Psi
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              objectwise, we take any
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              with its canonical presentation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi U
                    %mi F
                    %mi U
                    %mi S
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %mi F
                          %mi U
                          %mi ϵ
                      %mover
                        %mo →
                        %mrow
                          %mi ϵ
                          %mi F
                          %mi U
                          %mi S
                    %mi F
                    %mi U
                    %mi S
                    %mover
                      %mo →
                      %mi ϵ
                    %mi S
                  %annotation{:encoding => "application/x-tex"} F U F U S \stackrel{\overset{\epsilon F U S}{\to}}{\underset{F U \epsilon}{\to}} F U S \stackrel{\epsilon}{\to} S
            %p
              which is a
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              diagram. A left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                  %annotation{:encoding => "application/x-tex"} \Psi
              must preserve this coequalizer, and we must have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mi F
                    %mo ≅
                    %mi W
                  %annotation{:encoding => "application/x-tex"} \Psi F \cong W
              since both sides are left adjoint to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mi Φ
                    %annotation{:encoding => "application/x-tex"} U \Phi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Psi (S)
              to be a coequalizer
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi U
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %mi W
                          %mi U
                          %mi ϵ
                          %mi S
                      %mover
                        %mo →
                        %mrow
                          %mi β
                          %mi U
                          %mi S
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Ψ
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(T U S) \stackrel{\overset{\beta U S}{\to}}{\underset{W U\epsilon S}{\to}} W(U S) \to \Psi(S)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo :
                    %mi W
                    %mi T
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \beta: W T \to T
              is the
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi T
                      %mo →
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ⋅
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi: T \to \hom(R, -\cdot R)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                  %annotation{:encoding => "application/x-tex"} \Psi
              easily extends to morphisms by
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universality
              and provides a left adjoint to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                    %annotation{:encoding => "application/x-tex"} \Phi
          %p
            One import of this proposition is that left adjoint endofunctors on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mi T
                %annotation{:encoding => "application/x-tex"} Set^T
            compose, i.e., endofunctor composition gives a monoidal structure on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ladj
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Set
                      %mi T
                    %mo ,
                    %msup
                      %mi Set
                      %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ladj(Set^T, Set^T)
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi BiAlg
                  %annotation{:encoding => "application/x-tex"} BiAlg
            = succeed "-bialgebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊙
                  %annotation{:encoding => "application/x-tex"} \odot
          %p
            A second import of this proposition is that the canonical functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mtext -
                  %mi Bialg
                  %mo →
                  %mi Ladj
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Set
                    %mi T
                  %mo ,
                  %msup
                    %mi Set
                    %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T\text{-}Bialg \to Ladj(Set^T, Set^T)
            induces a functor which is reasonably denoted
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊙
                  %mo :
                  %mi T
                  %mtext -
                  %mi Bialg
                  %mo ×
                  %msup
                    %mi Set
                    %mi T
                  %mo →
                  %msup
                    %mi Set
                    %mi T
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \odot: T\text{-}Bialg \times Set^T \to Set^T,
          %p
            realizing an
            %a.existingWikiWord{:href => "/nlab/show/actegory"} actegory
            structure over the monoidal category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mtext -
                    %mi Bialg
                  %annotation{:encoding => "application/x-tex"} T\text{-}Bialg
          %p
            A direct construction of the monoidal product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊙
                %annotation{:encoding => "application/x-tex"} \odot
            can be extracted by following the proof of the proposition. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ,
                  %mi S
                %annotation{:encoding => "application/x-tex"} R, S
            are
            = succeed "-bialgebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⊙
                  %mi R
                %annotation{:encoding => "application/x-tex"} S \odot R
            (corresponding to composition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hom(S, -) \circ \hom(R, -)
            of right adjoints
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mi T
                    %mo →
                    %msup
                      %mi Set
                      %mi T
                  %annotation{:encoding => "application/x-tex"} Set^T \to Set^T
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mi T
                  %annotation{:encoding => "application/x-tex"} Set^T
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi U
                  %mi S
                  %mo ⋅
                  %mi R
                  %mover
                    %munder
                      %mo →
                      %mrow
                        %mi β
                        %mi U
                        %mi S
                    %mover
                      %mo →
                      %mrow
                        %mi ϵ
                        %mi U
                        %mi S
                        %mo ⋅
                        %mi R
                  %mi U
                  %mi S
                  %mo ⋅
                  %mi R
                  %mo →
                  %mi S
                  %mo ⊙
                  %mi R
                  %mo .
                %annotation{:encoding => "application/x-tex"} T U S \cdot R \stackrel{\overset{\epsilon U S \cdot R}{\to}}{\underset{\beta U S}{\to}} U S \cdot R \to S \odot R.
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mi U
                  %mi S
                %annotation{:encoding => "application/x-tex"} \epsilon U S
            is the same as the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi U
                  %mi S
                  %mo →
                  %mi U
                  %mi S
                %annotation{:encoding => "application/x-tex"} T U S \to U S
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mi X
                  %mo :
                  %mi T
                  %mi X
                  %mo ⋅
                  %mi R
                  %mo →
                  %mi X
                  %mo ⋅
                  %mi R
                %annotation{:encoding => "application/x-tex"} \beta X: T X \cdot R \to X \cdot R
            is a component of the
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi R
                    %mi T
                    %mo →
                    %msub
                      %mi W
                      %mi R
                  %annotation{:encoding => "application/x-tex"} W_R T \to W_R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ⋅
                  %mi R
                  %mo ⊣
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} - \cdot R \dashv \hom(R, -)
            adjunction to the component of the coalgebra structure
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mi X
                    %mo :
                    %mi T
                    %mi X
                    %mo →
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi X
                    %mo ⋅
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi X: T X \to \hom(R, X \cdot R)
          %p
            To extract the
            = succeed "-coalgebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊙
                    %mi R
                  %annotation{:encoding => "application/x-tex"} S \odot R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F: C \to D
            is a left adjoint, then for any category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            there is an induced left adjoint
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mn 1
                      %mi E
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi E
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi E
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [1_E, F]: [E, C] \to [E, D]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ladj
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Ladj
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ladj(E, C) \to Ladj(E, D)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mi D
                  %mo =
                  %mi E
                  %mo =
                  %msup
                    %mi Set
                    %mi T
                %annotation{:encoding => "application/x-tex"} C = D = E = Set^T
            and where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is the left adjoint to the lift
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi Set
                      %mi T
                    %mo →
                    %msup
                      %mi Set
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \hom(R, -): Set^T \to Set^T
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ⊙
                  %mi R
                  %mo :
                  %mi Ladj
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Set
                    %mi T
                  %mo ,
                  %msup
                    %mi Set
                    %mi T
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Ladj
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Set
                    %mi T
                  %mo ,
                  %msup
                    %mi Set
                    %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} - \odot R: Ladj(Set^T, Set^T) \to Ladj(Set^T, Set^T)
          %p
            is a left adjoint, and in particular preserves
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ⋅
                    %mi S
                  %annotation{:encoding => "application/x-tex"} Y \cdot S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            we have canonical isomorphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ⊙
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ⋅
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo ⊙
                  %mi R
                  %mo ,
                  %mspace{:width => "2em"}
                  %mi T
                  %mi X
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ⊙
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo ⋅
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo ⊙
                  %mi R
                %annotation{:encoding => "application/x-tex"} X \cdot (S \odot R) \cong (X \cdot S) \odot R, \qquad T X \cdot (S \odot R) \cong (T X \cdot S) \odot R
          %p
            so that the desired right
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ⊙
                  %mi R
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi X
                  %mo ≔
                  %mrow
                    %mo (
                    %mi T
                    %mi X
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ⊙
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo ⋅
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⊙
                    %mi R
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi β
                        %mi S
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi X
                        %mo ⊙
                        %mi R
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⋅
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⊙
                    %mi R
                    %mo ≅
                    %mi X
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ⊙
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \beta (S \odot R)_X \coloneqq \left(T X \cdot (S \odot R) \cong (T X \cdot S) \odot R \stackrel{(\beta S)_X \odot R}{\to} (X \cdot S) \odot R \cong X \cdot (S \odot R)\right).
          %h3#tallwraith_monoids_relative_to_a_monad Tall-Wraith monoids relative to a monad
          %p
            A
            %em Tall-Wraith monoid
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is of course a monoid in the monoidal category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mtext -
                    %mi BiAlg
                    %mo ,
                    %mo ⊙
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (T\text{-}BiAlg, \odot)
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mo :
                    %msup
                      %mi Set
                      %mi T
                    %mo →
                    %msup
                      %mi Set
                      %mi T
                  %annotation{:encoding => "application/x-tex"} id: Set^T \to Set^T
            = succeed "-coalgebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(1)
            is given tautologously by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi U
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mi Set
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mi Set
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi X
                  %mo ⋅
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} T(X) \cong U F(X) \cong Set^T(F(1), F(X)) \cong Set^T(F(1), X \cdot F(1)).
          %p
            So, multiplication on a Tall-Wraith monoid is a bialgebra map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo :
                  %mi R
                  %mo ⊙
                  %mi R
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"} m: R \odot R \to R
            and the unit is a bialgebra map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} u: F(1) \to R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ladj
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Set
                      %mi T
                    %mo ,
                    %msup
                      %mi Set
                      %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ladj(Set^T, Set^T)
            %em left adjoint monad
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mi T
                  %annotation{:encoding => "application/x-tex"} Set^T
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} R Alg
            of algebras over that monad, giving a monadic functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mi R
                    %mo →
                    %msup
                      %mi Set
                      %mi T
                  %annotation{:encoding => "application/x-tex"} Alg_R \to Set^T
          %p
            Now, recall that left adjoint monads are canonically
            %a.existingWikiWord{:href => "/nlab/show/mate"} mated
            to right adjoint comonads
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            are essentially the same thing as functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo :
                  %mi C
                  %mo →
                  %msup
                    %mi Set
                    %mi T
                %annotation{:encoding => "application/x-tex"} G: C \to Set^T
          %p
            which are simultaneously
            = succeed ":" do
              %em monadic and comonadic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a left adjoint and has a left adjoint
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi F
                  %mo :
                  %msup
                    %mi Set
                    %mi T
                  %mo →
                  %msup
                    %mi Set
                    %mi T
                %annotation{:encoding => "application/x-tex"} G F: Set^T \to Set^T
            resides in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ladj
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Set
                      %mi T
                    %mo ,
                    %msup
                      %mi Set
                      %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ladj(Set^T, Set^T)
          .num_example
            %h6#example_2 Example
            %p
              In the important example where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is the theory of commutative rings and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
              is the bialgebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %msub
                        %mi x
                        %mn 2
                      %mo ,
                      %mi …
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[x_1, x_2, \ldots]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo ⊙
                    %mi Λ
                    %mo →
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda \odot \Lambda \to \Lambda
              given by
              %a.existingWikiWord{:href => "/nlab/show/plethysm"} plethysm
              (a decategorified product that arises by viewing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
              as the Grothendieck ring of the category of
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ab
                    %annotation{:encoding => "application/x-tex"} Ab
              %a.existingWikiWord{:href => "/nlab/show/species"} species
              together with its substitution or plethystic product), the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} Alg_\Lambda
              may be identified with the category of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/lambda-rings"} lambda-rings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo ⊙
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} \Lambda \odot -
              has right adjoint given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi Λ
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hom(\Lambda, -)
              %em right
              adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CRing
                    %mo →
                    %mi Λ
                    %mi Ring
                  %annotation{:encoding => "application/x-tex"} CRing \to \Lambda Ring
              to the forgetful functor is the big Witt functor, often denoted
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
