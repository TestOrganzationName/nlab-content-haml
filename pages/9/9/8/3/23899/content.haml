            always
            %a.existingWikiWord{:href => "/nlab/show/implication"} implies
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
