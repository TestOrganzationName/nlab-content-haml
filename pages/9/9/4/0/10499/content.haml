            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+%28%E2%88%9E%2C1%29-subcategories"} full (∞,1)-subcategories
              of objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              for which,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
