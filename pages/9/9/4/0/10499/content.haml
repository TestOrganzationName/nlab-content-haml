                          %mi 𝔞
                      %annotation{:encoding => "application/x-tex"} \eta_{\mathfrak{a}}\colon id \longrightarrow \Pi_{\mathfrak{a}}
            %p Finally write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
