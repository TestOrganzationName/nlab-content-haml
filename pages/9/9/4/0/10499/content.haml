                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X_{\mathbb{Q}} &amp;&amp; \longleftarrow &amp;&amp; G_{S (\mathbb{Q}/\mathbb{Z})}(X)
                    \\\
                    \&amp; \swarrow &amp;&amp; \nwarrow &amp;&amp; \swarrow
