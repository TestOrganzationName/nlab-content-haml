          .num_remark
            %h6#remark_4 Remark
            %p
              The special case of prop.
              %a.maruku-ref{:href => "#CompletionTorsionAdjointModalityForModuleSpectra"}
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
              of a plain
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %a.existingWikiWord{:href => "/nlab/show/stable+Dold-Kan+correspondence"} stable Dold-Kan correspondence
              – the case where
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-modules"} ∞-modules
              are equivalently
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              = succeed "." do
                %a{:href => "#CompletionAndTorsionOnDerivedCategories"} below
          #FracturingOnEInfinityAlgebras.num_remark
            %h6#remark_5 Remark
            %p
              By the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/completion+of+modules"} completion of modules
              in the section
              = succeed "," do
                %em
                  %a{:href => "completion+of+a+module#Monoidalness"} Monoidalness
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
              of prop.
              %a.maruku-ref{:href => "#CompletionTorsionAdjointModalityForModuleSpectra"}
              is a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2C1%29-functor"} monoidal (∞,1)-functor
              without, possibly, respect the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} A Mod
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Π
                      %mi 𝔞
                    %mo ⊣
                    %msub
                      %mo ♭
                      %mi 𝔞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Pi_{\mathfrak{a}}\dashv \flat_{\mathfrak{a}})
              passes to “
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+a+symmetric+monoidal+%28%E2%88%9E%2C1%29-category"}> commutative ∞-monoids
              \-without unit” in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} A Mod
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Isbell+duality"} formal duals of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/nonunital+E-%E2%88%9E+algebras"} nonunital E-∞ algebras
              %a{:href => "nonunital+Ek-algebra#RelationToAugmentedEkAlgebras"} this proposition
              (
              %a{:href => "#LurieAlgebra"}> Lurie “Algebra”, prop. 5.2.3.15
              )
              %a.existingWikiWord{:href => "/nlab/show/nonunital+E-%E2%88%9E+rings"} nonunital E-∞ rings
              are
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalent
              to
              %a.existingWikiWord{:href => "/nlab/show/augmented+E-%E2%88%9E+rings"} augmented E-∞ rings
              over the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+arithmetic+geometry"} E-∞ arithmetic geometry
              under
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi 𝕊
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spec(\mathbb{S})
            %p
              Notice that in addition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \Pi_{\mathfrak{a}}
              here should preserve
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              (because by the discussion at
              %a{:href => "completion%20of%20a%20module#Monoidalness"} completion of a module – monoidalness
              the underlying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi 𝔞
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mi Mod
                    %mo →
                    %mi A
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \Pi_{\mathfrak{a}} \colon A Mod \to A Mod
              preserves all small
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
              and because by
              %a{:href => "commutative+monoid+in+a+symmetric+monoidal+%28infinity%2C1%29-category#LimitsInCRing"} this proposition
              finite coproducts in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CRng
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mi Mod
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CRng(A Mod)
              are computed in the underlying
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} A Mod
            %p
              Therefore we may think of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \Pi_{\mathfrak{a}}
              as a
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
              and of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ♭
                      %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \flat_{\mathfrak{a}}
              as a
              %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
              on affine
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+geometry"} E-∞
              %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(\mathbb{S})
              – namely on
              %a.existingWikiWord{:href => "/nlab/show/Isbell+duality"} formal duals
              of
              %a.existingWikiWord{:href => "/nlab/show/nonunital+E-%E2%88%9E+rings"} nonunital E-∞ rings
              \.
            %p
              (It may be entertaining to note that on the level of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups+of+units"} ∞-groups of units
              then
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+arithmetic+geometry"} E-∞ arithmetic geometry
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(\mathbb{S})
              translates to
              %a.existingWikiWord{:href => "/nlab/show/abelian+%E2%88%9E-groups"} abelian ∞-groups
              of
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twists
              over the
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              – which has been argued to be the homotopy-theoretic incarnation of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/superalgebra"} superalgebra
              %em
                %a{:href => "super+algebra#AbstractIdea"} superalgebra – abstract idea
              for more on this.)
          %p
            For more discussion of this see also
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+cohesion+and+idelic+structure"} differential cohesion and idelic structure
          %h4#CompletionAndTorsionOnDerivedCategories The arithmetic fracture square for chain complexes
          %p
            We discuss here arithmetic fracturing on
            %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            of modules. Under the
            %a.existingWikiWord{:href => "/nlab/show/stable+Dold-Kan+correspondence"} stable Dold-Kan correspondence
            this is a special case of prop.
            = succeed "," do
              %a.maruku-ref{:href => "#CompletionTorsionAdjointModalityForModuleSpectra"}
            %em Grothendieck local duality
            and sometimes called
            %em Greenlees-May duality
            due to (
            %a{:href => "#GreenlessMay92"}> Greenlees-May 92
            ) – and we point to these original proofs.
          .num_defn
            %h6#definition Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                    %mo ⊂
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a} \subset A
              be be an ideal generated by a single regular element (i.e. not a zero divisor). Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msubsup
                      %mi Mod
                      %mn ∞
                      %mi op
                  %annotation{:encoding => "application/x-tex"} A Mod_{\infty}^{op}
              for the
              %a.existingWikiWord{:href => "/nlab/show/opposite+%28%E2%88%9E%2C1%29-category"} opposite (∞,1)-category
              of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+modules"} (∞,1)-category of modules
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %p Write
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ♭
                          %mi 𝔞
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %msubsup
                          %mi Mod
                          %mn ∞
                          %mi op
                        %mo →
                        %mi A
                        %msubsup
                          %mi Mod
                          %mn ∞
                          %mi op
                      %annotation{:encoding => "application/x-tex"} \flat_{\mathfrak{a}}\colon A Mod_\infty^{op} \to A Mod_{\infty}^{op}
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
                  of
                  %a.existingWikiWord{:href => "/nlab/show/formal+completion"} formal completion
                  (adic completion) of modules at
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔞
                        %annotation{:encoding => "application/x-tex"} \mathfrak{a}
                %p with canonical natural transformation
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ϵ
                          %mi 𝔞
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mo ♭
                          %mi 𝔞
                        %mo ⟶
                        %mi id
                      %annotation{:encoding => "application/x-tex"} \epsilon_{\mathfrak{a}} \colon \flat_{\mathfrak{a}} \longrightarrow id
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mi 𝔞
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %msubsup
                          %mi Mod
                          %mn ∞
                          %mi op
                        %mo →
                        %mi A
                        %msubsup
                          %mi Mod
                          %mn ∞
                          %mi op
                      %annotation{:encoding => "application/x-tex"} \Pi_{\mathfrak{a}} \colon A Mod_\infty^{op} \to A Mod_\infty^{op}
                  for the total
                  %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
                  of the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
