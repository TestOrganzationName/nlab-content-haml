              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence in an (∞,1)-category
          .num_prop
            %h6#proposition_6 Proposition
            %ol
              %li
                %p
                  The transformation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ϵ
                          %mi 𝔞
                      %annotation{:encoding => "application/x-tex"} \epsilon_{\mathfrak{a}}
                  exhibits
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi A
                        %msubsup
                          %mi Mod
                          %mn ∞
                          %mi op
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi 𝔞
                            %mi com
                        %mo ↪
                        %mi A
                        %msub
                          %mi Mod
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} (A Mod_\infty^{op})^{\mathfrak{a}com}\hookrightarrow A Mod_\infty
                  as a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/reflective+%28%E2%88%9E%2C1%29-subcategory"} reflective (∞,1)-subcategory
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ♭
                          %mi 𝔞
                      %annotation{:encoding => "application/x-tex"} \flat_{\mathfrak{a}}
                  as an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/idempotent+%28%E2%88%9E%2C1%29-monad"} idempotent (∞,1)-monad
              %li
                %p
                  The transformation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi 𝔞
                      %annotation{:encoding => "application/x-tex"} \eta_{\mathfrak{a}}
                  exhibits
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi A
                        %msubsup
                          %mi Mod
                          %mn ∞
                          %mi op
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi 𝔞
                            %mi tor
                        %mo ↪
                        %mi A
                        %msub
                          %mi Mod
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} (A Mod_\infty^{op})^{\mathfrak{a}tor}\hookrightarrow A Mod_\infty
                  as a co-reflective
                  = succeed "-category," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mi 𝔞
                      %annotation{:encoding => "application/x-tex"} \Pi_{\mathfrak{a}}
                  as an idempotent
                  = succeed "-comonad." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
              %li
                %p
                  Restricted to these sub-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
                  \-categories both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ♭
                          %mi 𝔞
                      %annotation{:encoding => "application/x-tex"} \flat_{\mathfrak{a}}
                  as well as
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mi 𝔞
                      %annotation{:encoding => "application/x-tex"} \Pi_{\mathfrak{a}}
                  become
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/equivalences+of+%28%E2%88%9E%2C1%29-categories"} equivalences of (∞,1)-categories
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Π
                          %mi 𝔞
                        %mo ⊣
                        %msub
                          %mo ♭
                          %mi 𝔞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\Pi_{\mathfrak{a}} \dashv \flat_{\mathfrak{a}})
                  as a higher
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
          .proof
            %h6#proof_2 Proof
            %p
              This is a paraphrase of the results in (
              %a{:href => "#DwyerGreenlees99"}> Dwyer-Greenlees 99
              ) and (
              %a{:href => "#PortaShaulYekutieli10"}> Porta-Shaul-Yekutieli 10
              ) from the language of
              %a.existingWikiWord{:href => "/nlab/show/derived+categories"} derived categories
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+theory"} (∞,1)-category theory
            %p
              First of all, by our simplifying assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              is generated by a single regular element, the running assumption of “weak proregularity” in (
              %a{:href => "#PortaShaulYekutieli10"}> Porta-Shaul-Yekutieli 10, def.3.21
              ) is satisfied.
            %p
              Then in view of (
              %a{:href => "#PortaShaulYekutieli10"}> Porta-Shaul-Yekutieli 10, corollary 3.31
              ) the statement of (
              %a{:href => "#PortaShaulYekutieli10"}> Porta-Shaul-Yekutieli 10, theorem 6.12
              ) is the
              = succeed "-category#CharacterizationOfReflectors)" do
                %a{:href => "reflective+sub-(infinity,1"} characterization of reflectors
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective sub-(∞,1)-category
              %a.existingWikiWord{:href => "/nlab/show/homotopy+categories"} homotopy categories
              given by (
              %a{:href => "#HoveyPalieriStrickland97"}> Hovey-PalieriS-trickland 97, 3.3.5
              ,
              %a{:href => "#DwyerGreenlees99"} Dwyer-Greenlees 99, theorem 2.1
              = succeed ")" do
                %a{:href => "#PortaShaulYekutieli10"} Porta-Shaul-Yekutieli 10, theorem 6.11
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-categories"} sub-(∞,1)-categories
              and this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \Pi_{\mathfrak{a}}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ♭
                      %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \flat_{\mathfrak{a}}
              are the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
              induced from the reflection/coreflection
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            %p
              This adjoint triple is stated more explicitly in (
              %a{:href => "#DwyerGreenlees99"}> Dwyer-Greenlees 99, section 4
              ), see also (
              %a{:href => "#PortaShaulYekutieli10"}> Porta-Shaul-Yekutieli 10, end of remark 6.14
              ).
          %p
            Therefore arithmetic fracture squares in the homotopy theory of chain complexes are induced by this as in corollary
            %a.maruku-ref{:href => "#FractureFromCohesion"}
            above.
          %h4#GeneralFractureSquares General fracture squares of spectra
          %p
            By prop.
            %a.maruku-ref{:href => "#ReformulationOfProdOverPComletionByLocalizationAtCoproduct"}
            the arithmetic fracture square of prop.
            %a.maruku-ref{:href => "#SullivanArithmeticFracture"}
            is equivalently of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi L
                            %mrow
                              %mi H
                              %mi ℚ
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↖
                      %mtr
                        %mtd
                          %msub
                            %mi L
                            %mrow
                              %mi H
                              %mi ℚ
                          %msub
                            %mi L
                            %mrow
                              %mi S
                              %mi ℚ
                              %mo{:stretchy => "false"} /
                              %mi ℤ
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %mo ↖
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi L
                            %mrow
                              %mi S
                              %mi ℚ
                              %mo{:stretchy => "false"} /
                              %mi ℤ
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; L_{H\mathbb{Q}}X
                  \\\
                  \&amp; \swarrow &amp;&amp; \nwarrow
                  \\\
                  L_{H\mathbb{Q}}
                  L_{S \mathbb{Q}/\mathbb{Z}} X
                  \&amp;&amp;  &amp;&amp;
                  X
                  \\\
                  \&amp; \nwarrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp; L_{S \mathbb{Q}/\mathbb{Z}} X
                  }
                  \\,.
          %p In this form the statement holds much more generally:
          #GeneralFractureSquare.num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ,
                    %mi F
                    %mo ,
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E, F, X
              be
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              such that the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+spectra"} localization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "-acyclic," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi L
                        %mi F
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} E_\bullet(L_F X) \simeq 0
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi L
                              %mi F
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↖
                        %mtr
                          %mtd
                            %msub
                              %mi L
                              %mi F
                            %msub
                              %mi L
                              %mi E
                            %mi X
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi L
                              %mrow
                                %mi E
                                %mo ∨
                                %mi F
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ↖
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi L
                              %mi E
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; L_F X
                    \\\
                    \&amp; \swarrow &amp;&amp; \nwarrow
                    \\\
                    L_F
                    L_E X
                    \&amp;&amp;  &amp;&amp;
                    L_{E\vee F} X
                    \\\
                    \&amp; \nwarrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; L_E X
                    }
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              (and hence by stability also a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
          %p
            e.g. (
            %a{:href => "#Bauer11"}> Bauer 11, prop. 2.2
            )
          #ExampleOfChromaticFracturing.num_remark
            %h6#remark_6 Remark
            %p
              The general version of the fracture statement in prop.
              %a.maruku-ref{:href => "#GeneralFractureSquare"}
              is used frequently in
              %a.existingWikiWord{:href => "/nlab/show/chromatic+homotopy+theory"} chromatic homotopy theory
              for decomposition in
              %a.existingWikiWord{:href => "/nlab/show/Morava+K-theory"} Morava K-theory
              and
              = succeed "-localizations." do
                %a.existingWikiWord{:href => "/nlab/show/Morava+E-theory"} Morava E-theory
              %strong chromatic
              fracture square:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi L
                              %mrow
                                %mi E
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo −
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↖
                        %mtr
                          %mtd
                            %msub
                              %mi L
                              %mrow
                                %mi E
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo −
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %msub
                              %mi L
                              %mrow
                                %mi K
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %mi X
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi L
                              %mrow
                                %mi E
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ↖
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi L
                              %mrow
                                %mi K
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; L_{E(n-1)} X
                    \\\
                    \&amp; \swarrow &amp;&amp; \nwarrow
                    \\\
                    L_{E(n-1)}
                    L_{K(n)} X
                    \&amp;&amp;  &amp;&amp;
                    L_{E(n)} X
                    \\\
                    \&amp; \nwarrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; L_{K(n)} X
                    }
            %p
              In particular it is used for instance in the construction of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
              %a.maruku-ref{:href => "#ConstructionOfTmf"}
              below.
          %p From another perspective:
          .num_prop
            %h6#claim Claim
            %p
              Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Spectra
                    %mo →
                    %mi Spectra
                  %annotation{:encoding => "application/x-tex"} L \colon Spectra \to Spectra
              is a
              %a.existingWikiWord{:href => "/nlab/show/smashing+localization"} smashing localization
              given by
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              with some
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              for the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⟶
                    %mi 𝕊
                    %mo ⟶
                    %mi T
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F \longrightarrow \mathbb{S} \longrightarrow T
                    \\,.
            %p
              Then there is a
              %a.existingWikiWord{:href => "/nlab/show/fracture+diagram"} fracture diagram
              of operations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi T
                            %mo ∧
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mo ⟵
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi T
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo ↖
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi 𝕊
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↖
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi F
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ]
                          %mtd
                          %mtd
                            %mo ⟵
                          %mtd
                          %mtd
                            %mi F
                            %mo ∧
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T \wedge (-) &amp;&amp; \longleftarrow  &amp;&amp;  [T,-]
                    \\\
                    \&amp; \nwarrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; \mathbb{S}
                    \\\
                    \&amp; \swarrow &amp; &amp; \nwarrow
                    \\\
                    [F,-] &amp;&amp; \longleftarrow &amp;&amp; F \wedge (-)
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi F
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [F,-]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Spectra
                    %mo →
                    %mi Spectra
                  %annotation{:encoding => "application/x-tex"} T \wedge (-) \colon Spectra \to Spectra
              are
              %a.existingWikiWord{:href => "/nlab/show/idempotent+%28%E2%88%9E%2C1%29-monads"} idempotent (∞,1)-monads
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi T
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [T,-]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \wedge (-)
              are idempotent
              = succeed "-comonads," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
