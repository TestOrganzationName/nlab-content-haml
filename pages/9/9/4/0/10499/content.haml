                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} X \to \flat_{dR} \hat E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %msub
                    %mo ♭
                    %mi dR
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat E \to \flat_{dR} \hat E
            is a generalized form of rationalization in the sense discussed at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+cohomology+hexagon"} differential cohomology hexagon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat E
            is a
            %a{:href => "differential%20cohomology%20diagram#HopkinsSingerCoefficients"} Hopkins-Singer-type
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            refinement of a plain
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %msub
                    %mo ♭
                    %mi dR
                  %mi E
                %annotation{:encoding => "application/x-tex"} E\to \flat_{dR} E
            is its ordinary
            %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
            given by the
            %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %msub
                    %mo ♭
                    %mi dR
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat E \to \flat_{dR} \hat E
            is the corresponding map on Chern
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/curvature+forms"} curvature forms
          %p
            Moreover, if the ambient
            %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
            is
            %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
            over a base of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+cohesion"} infinitesimal cohesion
            %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♭
                %annotation{:encoding => "application/x-tex"} \flat
            takes any space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the union of all its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/formal+disks"} formal disks
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+cohesion+and+idelic+structure"} differential cohesion and idelic structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♭
                  %mi X
                  %mo →
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \flat X \to \hat E
            in this case behave like the product of all
            %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
            of
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat E
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %a.maruku-ref{:href => "#GeometricMeaning"}
          %p
            An example of this are
            %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+%E2%88%9E-groupoids"} synthetic differential ∞-groupoids
            regarded as cohesive over their
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/formal+moduli+problems"} formal moduli problems
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+analytic+%E2%88%9E-groupoids"} complex analytic ∞-groupoids
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} X = \Sigma
            is a
            %a.existingWikiWord{:href => "/nlab/show/complex+curve"} complex curve
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♭
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \flat \Sigma
            is precisely the analog of the
            %a.existingWikiWord{:href => "/nlab/show/integral+adeles"} integral adeles
            as it is predicted by the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/function+field+analogy"} function field analogy
          %h2#Examples Examples
          #ConstructionOfTmf.num_example
            %h6#example_2 Example
            %p
              The construction of the
              = succeed "-spectrum" do
                %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
              %a.existingWikiWord{:href => "/nlab/show/global+sections"} global sections
              of the
              %a.existingWikiWord{:href => "/nlab/show/derived+Deligne-Mumford+stack"} derived Deligne-Mumford stack
              of
              %a.existingWikiWord{:href => "/nlab/show/derived+elliptic+curves"} derived elliptic curves
              – as described in (
              %a{:href => "tmf#Behrens13"}> Behrens 13
              ) proceeds by first applying the arithmetic fracture square of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ArithmeticFractureSquare"}
              %a.maruku-ref{:href => "#SullivanArithmeticFracture"}
              to decompose the
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+elliptic+curves"} moduli stack of elliptic curves
              into rational and
              = succeed "-adic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.maruku-ref{:href => "#GeneralFractureSquare"}
              for
              %a.existingWikiWord{:href => "/nlab/show/Morava+K-theory"} Morava K-theory
              to the remaining
              = succeed "-adic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            %p
              See at
              %em
                %a{:href => "tmf#DecomopositionViaArithmeticSquares"} tmf – Decomposition via arithmetic fracture squares
              for more on this.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/p-adic+homotopy+theory"}> p-adic homotopy theory
                ,
                %a.existingWikiWord{:href => "/nlab/show/p-completion"} p-completion
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"}> rational homotopy theory
                ,
                %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
          %h2#references References
          %ul
            %li#BousfieldKan72
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aldridge+Bousfield"}> Aldridge Bousfield
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Homotopy+limits%2C+completions+and+localizations"} Homotopy limits, completions and localizations
            %li#Bousfield79
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aldridge+Bousfield"}> Aldridge Bousfield
                ,
                %em The localization of spectra with respect to homology
                , Topology vol 18 (1979) (
                %a{:href => "http://www.uio.no/studier/emner/matnat/math/MAT9580/v12/undervisningsmateriale/bousfield-topology-1979.pdf"}> pdf
                )
            %li#Sullivan05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dennis+Sullivan"}> Dennis Sullivan
                ,
                = succeed "," do
                  %em Geometric topology: localization, periodicity and Galois symmetry
              %p
                by
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Ranicki"} Andrew Ranicki
                (
                %a{:href => "http://www.maths.ed.ac.uk/~aar/books/gtop.pdf"}> pdf
                )
            %li#Bauer11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tilman+Bauer"}> Tilman Bauer
                ,
                %em Bousfield localization and the Hasse square
                (2011) (
                %a{:href => "https://math.mit.edu/events/talbot/2007/tmfproc/Chapter09/Bousfield.pdf"}> pdf
                ,
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/files/Bauer_BousfieldLocalization.pdf", :title => "pdf"} pdf
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christopher+Douglas"} Christopher Douglas
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Francis"} John Francis
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Henriques"} André Henriques
                %a.existingWikiWord{:href => "/nlab/show/Michael+Hill"} Michael Hill
                (eds.),
                = succeed "," do
                  %em Topological Modular Forms
                = succeed ")" do
                  %a{:href => "https://bookstore.ams.org/surv-201"} ISBN:978-1-4704-1884-7
            %li#VanKoughnett13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+VanKoughnett"}> Paul VanKoughnett
                ,
                = succeed "," do
                  %em Spectra and localization
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/VanKoughnettLocalization.pdf", :title => "pdf"} pdf
            %li#Riehl14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"}> Emily Riehl
                ,
                = succeed "," do
                  %em Categorical homotopy theory
            %li#MayPonto
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kate+Ponto"} Kate Ponto
                %em More concise algebraic topology: Localization, completion, and model categories
                (
                %a{:href => "http://www.maths.ed.ac.uk/~aar/papers/mayponto.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Shulman"}> Michael Shulman
                ,
                = succeed "," do
                  %em The Propositional Fracture Theorem
                = succeed ")" do
                  %a{:href => "http://golem.ph.utexas.edu/category/2013/05/the_propositional_fracture_the.html"} blog post
          %p Related MO-discussion:
          %ul
            %li
              %em
                %a{:href => "http://mathoverflow.net/a/91057/381"} Fracture squares of Bousfield Localizations of Spectra
          %p
            Discussion of rational functions as functions on the
            %a.existingWikiWord{:href => "/nlab/show/Ran+space"} Ran space
            is in
          %ul
            %li#Gaitsgory11
              %a.existingWikiWord{:href => "/nlab/show/Dennis+Gaitsgory"}> Dennis Gaitsgory
              ,
              %em Contractibility of the space of rational maps
              (
              %a{:href => "http://arxiv.org/abs/1108.1741"}> arXiv:1108.1741
              )
          %p
            Discussion of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            %a.existingWikiWord{:href => "/nlab/show/adic+completion"} adic completion
            and
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            %a.existingWikiWord{:href => "/nlab/show/torsion+approximation"} torsion approximation
            as derived idempotent (co-)monads on a
            %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
            of chain complexes of modules –
            %em Greenlees-May duality
            – is in
          %ul
            %li#PortaShaulYekutieli10
              Marco Porta,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Liran+Shaul"} Liran Shaul
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Amnon+Yekutieli"} Amnon Yekutieli
              %em On the Homology of Completion and Torsion
              (
              %a{:href => "http://arxiv.org/abs/1010.4386"}> arXiv:1010.4386
              )
          %p building on
          %ul
            %li#GreenlessMay92
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Greenlees"}> John Greenlees
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                = succeed "," do
                  %em Derived functors of I-adic completion and local homology
                = succeed ")" do
                  %a{:href => "http://math.uchicago.edu/~may/PAPERS/73.pdf"} pdf
            %li
              %p
                Leovigildo Alonso, Ana Jeremías,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Joseph+Lipman"} Joseph Lipman
                %em Local Homology and Cohomology on Schemes
                (
                %a{:href => "http://arxiv.org/abs/alg-geom/9503025"}> arXiv:alg-geom/9503025
                )
            %li#HoveyPalieriStrickland97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Palmieri"} John Palmieri
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Neil+Strickland"} Neil Strickland
                = succeed "," do
                  %em Axiomatic stable homotopy theory
            %li#DwyerGreenlees99
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"}> William Dwyer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Greenlees"} John Greenlees
                = succeed "," do
                  %em Complete modules and torsion modules
                = succeed ")" do
                  %a{:href => "https://www3.nd.edu/~wgd/Dvi/Complete.And.Torsion.pdf"} pdf
          %p
            Discussion of this in
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            and the full generality of
            %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
            is in
          %ul
            %li#LurieProper
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              , section 4 of
              %em
                %a.existingWikiWord{:href => "/nlab/show/Proper+Morphisms%2C+Completions%2C+and+the+Grothendieck+Existence+Theorem"} Proper Morphisms, Completions, and the Grothendieck Existence Theorem
          %p And in the context of commutative DG-rings in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Liran+Shaul"}> Liran Shaul
              ,
              = succeed "," do
                %em Completion and torsion over commutative DG rings
              %a{:href => "http://arxiv.org/abs/1605.07447"} arXiv:1605.07447
          %p This and further generalization is in
          %ul
            %li#BarthelHeard15
              %a.existingWikiWord{:href => "/nlab/show/Tobias+Barthel"}> Tobias Barthel
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Drew+Heard"} Drew Heard
              %em Local duality in algebra and topology
              (
              %a{:href => "http://arxiv.org/abs/1511.03526"}> arXiv:1511.03526
              )
          %p
            Discussion in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ul
            %li#Scoccola19
              Luis Scoccola,
              %em Nilpotent Types and Fracture Squares in Homotopy Type Theory
              (
              %a{:href => "https://arxiv.org/abs/1903.03245"}> arXiv:1903.03245
              )
          %p
            Exposition from the point of view of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/modal+homotopy+type+theory"} modal homotopy theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/differential+cohesion+and+idelic+structure"} Fractures, Ideles and the Differential Hexagon
                = succeed "," do
                  %em
                    %a{:href => "http://qcpages.qc.cuny.edu/~swilson/cunyworkshop14.html"} Workshop on differential cohomologies
                = succeed ")" do
                  %a{:href => "http://videostreaming.gc.cuny.edu/videos/video/1806/in/channel/55/"} video recording
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/schreiber/show/Differential+cohesion+and+Arithmetic+geometry"} Differential cohesion and Arithmetic geometry
                %a{:href => "http://www.math.kit.edu/iag3/~herrlich/seite/weihnachts-workshops"} Karslruher Weihnachts-Workshop 2015
          %p
            Formalization in
            %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type+theory"} cohesive
            %a.existingWikiWord{:href => "/nlab/show/modal+homotopy+type+theory"} modal homotopy type theory
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Jaz+Myers"}> David Jaz Myers
              ,
              = succeed "," do
                %em Modal Fracture of Higher Groups
              %em
                %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/index.html"}> CMU-HoTT Seminar
                , 2021 (
                %a{:href => "http://davidjaz.com/Talks/CMU_March_2021.pdf"}> pdf
                ,
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/MyersModalFracture2021.pdf", :title => "pdf"} pdf
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Greenlees"}> John Greenlees
              ,
              %em Tate cohomology in axiomatic stable homotopy theory
              (
              %a{:href => "http://citeseerx.ist.psu.edu/viewdoc/download?doi=10.1.1.490.322&rep=rep1&type=pdf"}> pdf
              )
