              be an
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                    %mo ⊂
                    %msub
                      %mi π
                      %mn 0
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a} \subset \pi_0 A
              be a
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} finitely generated
              ideal in its underlying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %p
              Then there is an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functors"} adjoint (∞,1)-functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
