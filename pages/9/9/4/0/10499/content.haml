                    }
            %p is homotopy exact, in that
            %ol
              %li
                %p
                  the square is a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
                  and hence also a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
                  (this is prop.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#ReformulationOfProdOverPComletionByLocalizationAtCoproduct"}
              %li
                %p
                  the diagonals are
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequences"} homotopy cofiber sequences
                  and hence also
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequences"} homotopy fiber sequences
                  (by
                  %a{:href => "Bousfield+localization+of+spectra#LocalizationCofiber"} this proposition
                  at
                  = succeed ");" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+spectra"} Bousfield localization of spectra
              %li
                %p
                  the top and bottom outer composite sequences are
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequences"} homotopy fiber sequences
                  (and hence
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequences"} homotopy cofiber sequences
                  %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
                  to the previous two items).
            %p
              Together this is like two-thirds of a
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology+hexagon"} differential cohomology hexagon
              – to the extent that
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/adic+completion"} adic completion
              is adjoint to
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/torsion+approximation"} torsion approximation
            %p
              Notice that in view of remark
              %a.maruku-ref{:href => "#GeometricMeaning"}
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi X
                      %mi p
                      %mo ∧
                  %annotation{:encoding => "application/x-tex"} X_p^\wedge
              is like the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              from
              %a.existingWikiWord{:href => "/nlab/show/Spec%28Z%29"} Spec(Z)
              to all
              %a.existingWikiWord{:href => "/nlab/show/formal+disks"} formal disks
              around the points
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mrow
                        %mi S
                        %msub
