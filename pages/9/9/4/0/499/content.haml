            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi X
                %annotation{:encoding => "application/x-tex"} h_X
            represented by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} C \to [C^{op}, Set]
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            implies that this functor is
            %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful
            and hence realizes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            as a
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            inside its category of presheaves.
          %p
            Recall from the discussion at
            %a.existingWikiWord{:href => "/nlab/show/representable+presheaf"} representable presheaf
            that the presheaf represented by an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi X
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} h_X :C^{op} \to Set
            whose assignment is illustrated by
          %p
            %img{:src => "http://ncatlab.org/ericforgy/files/hxalpha3.jpg", :width => "400"}/
          %p
            which sends each object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom_C(U,X)
            and each morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi U
                  %mo ′
                  %mo →
                  %mi U
                %annotation{:encoding => "application/x-tex"} \alpha:U'\to U
            to the function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi X
                  %mi α
                  %mo :
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ′
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} h_X\alpha: Hom_C(U,X)\to Hom_C(U',X).
          %p
            Moreover, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f : X \to Y
            a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi f
                    %mo :
                    %msub
                      %mi h
                      %mi X
                    %mo →
                    %msub
                      %mi h
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} h_f : h_X \to h_Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is illustrated by
          %p
            %img{:src => "http://ncatlab.org/ericforgy/files/hf.jpg", :width => "400"}/
          %p For this to be a natural transformation, we need to have the commuting diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi h
                            %mi X
                          %mi U
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi h
                                %mi f
                              %mi U
                        %mtd
                          %msub
                            %mi h
                            %mi Y
                          %mi U
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mrow
                              %msub
                                %mi h
                                %mi X
                              %mi α
                              %mspace{:width => "1em"}
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mrow
                        %mtd
                          %mpadded{:width => "0"}
                            %mo{:stretchy => "false"} ↓
                          %mrow
                            %mspace{:width => "1em"}
                            %msub
                              %mi h
                              %mi Y
                            %mi α
                      %mtr
                        %mtd
                          %msub
                            %mi h
                            %mi X
                          %mi U
                          %mo ′
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi h
                                %mi f
                              %mi U
                              %mo ′
                        %mtd
                          %msub
                            %mi h
                            %mi Y
                          %mi U
                          %mo ′
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  h_X U &amp; \stackrel{h_f U}{\rightarrow} &amp; h_Y U \\
                  \\mathllap{h_X\alpha\quad}{\downarrow} &amp; {} &amp; \mathrlap{\downarrow}{\quad h_Y\alpha} \\
                  h_X U' &amp; \stackrel{h_f U'}{\rightarrow} &amp; h_Y U'
                  }
          %p
            but this simply means that it doesn’t matter if we first “comb” the strands back to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ′
                %annotation{:encoding => "application/x-tex"} U'
            and then comb the strands forward to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            first and then comb the strands back to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ′
                %annotation{:encoding => "application/x-tex"} U'
          %p
            %img{:src => "http://ncatlab.org/ericforgy/files/nattrans.jpg", :width => "600"}/
          %p
            which follows from associativity of composition of morphisms in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h2#definition Definition
          %p
            The
            %strong Yoneda embedding
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            a
            %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small category
            is the
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo :
                  %mi C
                  %mo →
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  Y : C \to [C^{op}, Set]
          %p
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to the
            %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            which is the image of the
            %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo ×
                  %mi C
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"}
                  Hom : C^{op} \times C \to Set
          %p
            under the Hom
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %mo ×
                  %mi C
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Hom(C^{op} \times C , Set) \simeq
                  Hom(C, [C^{op}, Set])
          %p
            in the
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} symmetric monoidal category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
          %p
            Hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            sends any
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \in C
            to the
            %a.existingWikiWord{:href => "/nlab/show/representable+presheaf"} representable presheaf
            which assigns to any other object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            the
            %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            into
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi C
                    %mi op
                  %mover
                    %mo →
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                  %mi Set
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Y(c)
                  \\;\colon\;
                  C^{op} \stackrel{C(-,c)}{\to} Set
                  \\,.
          %p
            The Yoneda embedding is sometimes denoted by よ, the
            %a{:href => "https://en.wikipedia.org/wiki/Yo_(kana%29"} hiragana
            for “Yo”; see the references
            = succeed "." do
              %a{:href => "#ReferencesNotation"} below
          %h2#remarks Remarks
          %p We can also curry the Hom functor in the other variable, thus obtaining a contravariant functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  C^{op} \to [C, Set]
          %p
            which is explicitly given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ↦
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \mapsto C(c,-)
            = succeed "." do
              %strong contravariant Yoneda embedding
          %p
            However, since
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^{op}(-,c)=C(c,-)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo :
                  %msup
                    %mi C
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Y: C^{\op} \to [(C^{op})^{op}, Set]=[C, Set]
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
          %h2#properties Properties
          #YonedaEmbeddingIsFullyFaithful.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (Yoneda embedding is a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                          %mtd
                            %mover
                              %mo ↪
                              %mi Y
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi 𝒞
                              %mi op
                            %mo ,
                            %mi Set
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mi c
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C}
                    \&amp;\overset{Y}{\hookrightarrow}&amp;
                    [\mathcal{C}^{op}, Set]
                    \\\
                    c &amp;\mapsto&amp; Hom_{\mathcal{C}}(-,c)
                    }
            %p
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
          .proof
            %h6#proof Proof
            %p
              We need to show that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c_1, c_2 \in \mathcal{C}
              any two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              of
              %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
              between their
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represented presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi ϕ
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}(-,c_1)
                    \\overset{\phi}{\longrightarrow}
                    Hom_{\mathcal{C}}(-,c_2)
            %p is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \;=\; Hom_{\mathcal{C}}(-,f)
            %p for a unique morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi c
                      %mn 1
                    %mo →
                    %msub
                      %mi c
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; c_1 \to c_2
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              as above are identified with the elements in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}(-,c_2)(c_1)
                    \\;=\;
                    Hom_{\mathcal{C}}(c_1,c_2)
                    \\,.
          %p
          #PreservesLimits.num_prop
            %h6 Proposition
            %p
              The Yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo ⟶
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y \colon \mathcal{C} \longrightarrow Func(\mathcal{C}^{op}, Set)
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+functor"} continuous functor
          .proof
            %h6 Proof
            %p
              This follows because (1.)
              %a.existingWikiWord{:href => "/nlab/show/hom-functors+preserve+limits"} hom-functors preserve limits
              and (2.)
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/limits+of+presheaves+are+computed+objectwise"} limits of presheaves are computed objectwise
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi y
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %munder
                            %mi lim
                            %munder
                              %mo ⟵
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi c
                            %mi i
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≡
                          %mspace{:width => "thickmathspace"}
                          %mi Hom
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %munder
                            %mi lim
                            %munder
                              %mo ⟵
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi c
                            %mi i
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %munder
                            %mi lim
                            %munder
                              %mo ⟵
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                          %mspace{:width => "thinmathspace"}
                          %mi Hom
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi c
                            %mi i
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %munder
                            %mi lim
                            %munder
                              %mo ⟵
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                          %mspace{:width => "thinmathspace"}
                          %mi y
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi c
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    y\big(
                    \\underset{
                    \\underset
                    {i \in I}
                    {\longleftarrow}
                    }{\lim}
                    \\,
                    c_i
                    \\big)
                    \\\
                    \\;\equiv\;
                    Hom\big(
                    \-
                    ,\,
                    \\underset{
                    \\underset
                    {i \in I}
                    {\longleftarrow}
                    }{\lim}
                    \\,
                    c_i
                    \\big)
                    \\\
                    \\;\simeq\;
                    \\underset{
                    \\underset
                    {i \in I}
                    {\longleftarrow}
                    }{\lim}
                    \\,
                    Hom\big(
                    \-
                    ,\,
                    c_i
                    \\big)
                    \\\
                    \\;\simeq\;
                    \\underset{
                    \\underset
                    {i \in I}
                    {\longleftarrow}
                    }{\lim}
                    \\,
                    y(c_i)
                    \\,.
                    \\end{array}
            %p
          %p
          .num_remark
            %h6 Remark
            %p
              In contrast, the Yoneda embedding does not in general preserve
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            %p
              Instead, the Yoneda embedding of a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is its
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/free+cocompletion"} free cocompletion
          %p
          .num_remark
            %h6 Remark
            %p
              If the Yoneda embedding of a category has a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %em
                %a.existingWikiWord{:href => "/nlab/show/total+category"} total category
              \.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                is a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/total+category"} total category
                if its Yoneda embedding has a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/restricted+Yoneda+embedding"} restricted Yoneda embedding
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-Yoneda+embedding"} (infinity,1)-Yoneda embedding
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                injection, the Yoneda embedding for 0-category theory.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma+for+bicategories"} Yoneda lemma for bicategories
          %h2#references References
          %h3#general General
          %p
            Named after
            %a.existingWikiWord{:href => "/nlab/show/Nobuo+Yoneda"} Nobuo Yoneda
            (see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            and the list of references given
            = succeed ")." do
              %a{:href => "Yoneda+lemma#References"} there
          %p Early accounts:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"}> Alexander Grothendieck
              , Section A.1 of:
              = succeed "," do
                %em Technique de descente et théorèmes d’existence en géométrie algébriques. II. Le théorème d’existence en théorie formelle des modules
              = succeed ")" do
                %a{:href => "http://www.numdam.org/item/?id=SB_1958-1960__5__369_0"} numdam:SB_1958-1960__5__369_0
          %h3#ReferencesNotation Notation
          %p
            It seems that the notation “よ” for the Yoneda embedding (the
            %a{:href => "https://en.wikipedia.org/wiki/Yo_(kana%29"} hiragana
            for “Yo”) was first used in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Theo+Johnson-Freyd"}> Theo Johnson-Freyd
              , Claudia Scheimbauer, p. 33 of
              = succeed "," do
                %em (Op)lax natural transformations, twisted quantum field theories, and “even higher” Morita categories
              = succeed ")" do
                %a{:href => "https://arxiv.org/pdf/1502.06526v1"} arxiv:1502.06526
          %p Their Latex code for the command reads as follows:
          %p
            %code \usepackage[utf8]{inputenc}
          %p
            %code \DeclareFontFamily{U}{min}{}
          %p
            %code \DeclareFontShape{U}{min}{m}{n}{&lt;-&gt; udmj30}{}
          %p
            %code \newcommand\yo{\!\text{\usefont{U}{min}{m}{n}\symbol{'207}}\!}
          %p Subsequent references that use this notation include:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"}> Emily Riehl
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dominic+Verity"} Dominic Verity
                %em
                  Elements of
                  = succeed "-category" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                (
                %a{:href => "http://www.math.jhu.edu/~eriehl/elements.pdf#page=10"}> web
                )
            %li#Li-Bland15
              %p
                David Li-Bland, p. 5 of
                %em The stack of higher internal categories and stacks of iterated spans
                (
                %a{:href => "https://arxiv.org/pdf/1506.08870.pdf#page=5"}> arXiv:1506.08870
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fosco+Loregian"}> Fosco Loregian
                , p. 4 of
                %em This is the (co)end, my only (co)friend
                (
                %a{:href => "https://arxiv.org/pdf/1501.02503.pdf#page=4"}> arXiv:1501.02503
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Hill"}> Michael Hill
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"} Michael Hopkins
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Douglas+Ravenel"} Douglas Ravenel
                = succeed "," do
                  %em Equivariant stable homotopy theory and the Kervaire invariant problem
                = succeed ")" do
                  %a{:href => "https://web.math.rochester.edu/people/faculty/doug/mybooks/esht.pdf#page=53"} web
