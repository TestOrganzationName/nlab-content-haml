                              %msup
                                %mo
                                %mi DF
                        %annotation{:encoding => "application/x-tex"} \;\;\;\psi \;=\; \sqrt{2}\psi^{^{DF}}
                %li
                  %p
                    our 4-flux density absorbs a combinatorial factor of
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 1
                            %mo{:stretchy => "false"} /
                            %mn 2
                          %annotation{:encoding => "application/x-tex"} 1/2
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thickmathspace"}
