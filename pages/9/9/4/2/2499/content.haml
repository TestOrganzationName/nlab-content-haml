                        %annotation{:encoding => "application/x-tex"} \;\;\;\Gamma_a \;=\; \mathrm{i}\, \Gamma_a^{^{DF}}
                %li
                  %p
                    our gravitinos absorb a factor of
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msqrt
                              %mn 2
                          %annotation{:encoding => "application/x-tex"} \sqrt{2}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thickmathspace"}
