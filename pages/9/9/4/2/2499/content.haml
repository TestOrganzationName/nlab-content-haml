            %p
            #11dSuGraEOMFromSuperFluxIdentity.num_theorem
              %h6 Theorem
              %p
                %strong (11d SuGra EoM from super-flux Bianchi identity)
                Given
              %ol
                %li
                  %p
                    (
                    %a.existingWikiWord{:href => "/nlab/show/supergravity"} super-gravity
                    = succeed ":)" do
                      %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
                    = succeed "-dimensional" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 11
                            %mo{:stretchy => "false"} |
                            %mstyle{:mathvariant => "bold"}
                              %mn 32
                          %annotation{:encoding => "application/x-tex"} 11\vert\mathbf{32}
                    %a.existingWikiWord{:href => "/nlab/show/super-spacetime"} super-spacetime
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                    (Def.
                    = succeed ")," do
                      %a.maruku-ref{:href => "#SuperSpacetime"}
                %li
                  %p
                    (
                    %a.existingWikiWord{:href => "/nlab/show/differential+form+on+a+supermanifold"} super-
                    %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} C-field
                    = succeed ":)" do
                      %a.existingWikiWord{:href => "/nlab/show/flux+densities"} flux densities
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msubsup
                            %mi G
                            %mn 4
                            %mi s
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %msubsup
                            %mi G
                            %mn 7
                            %mi s
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (G^s_4,\, G^s_7)
                    as in
                    %a.maruku-eqref{:href => "#eq:LocalFormOfSuperFluxDensities"} (9)
              %p
                then the super-flux
                %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
                %a.maruku-eqref{:href => "#eq:SuperFluxBianchiIdentity"} (8)
                (the super-
                %a{:href => "higher+gauge+field#HigherGaugeTheoryOfMaxwellType"} higher Maxwell equation
                for the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} C-field
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi{:mathvariant => "normal"} d
                            %mspace{:width => "thinmathspace"}
                            %msubsup
                              %mi G
                              %mn 4
                              %mi s
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mn 0
                        %mtr
                          %mtd
                            %mi{:mathvariant => "normal"} d
                            %mspace{:width => "thinmathspace"}
                            %msubsup
                              %mi G
                              %mn 7
                              %mi s
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %msubsup
                              %mi G
                              %mn 4
                              %mi s
                            %mspace{:width => "thinmathspace"}
                            %msubsup
                              %mi G
                              %mn 4
                              %mi s
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{array}{l}
                      \\mathrm{d} \, G_4^s \;=\; 0
                      \\\
                      \\mathrm{d} \, G_7^s \;=\; \tfrac{1}{2} G_4^s \, G_4^s
                      \\end{array}
              %p
                is equivalent to the joint solution by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi e
                      %mo ,
                      %mi ψ
                      %mo ,
                      %mi ω
                      %mo ,
                      %msubsup
                        %mi G
                        %mn 4
                        %mi s
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %msubsup
                        %mi G
                        %mn 7
                        %mi s
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} \big(e, \psi, \omega, G_4^s,\, G_7^s\big)
                of the
                %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
            This is, in some paraphrase, the result of
            = succeed "," do
              %a{:href => "D'Auria-Fre+formulation+of+supergravity#CastellaniDAuriaFre"} CDF91, §III.8.5
            %strong proof
            broken up in the following Lemmas
            = succeed "," do
              %a.maruku-ref{:href => "#SuperBianchiIdentityOnG4InComponents"}
            = succeed "," do
              %a.maruku-ref{:href => "#SuperBianchiIdentityOnG7InComponents"}
            = succeed "." do
              %a.maruku-ref{:href => "#SuperCFieldBianchiImpliesSuGraEoM"}
            %p In all of the following lemmas one expands the Bianchi identoties in their super-vielbein form components.
            %p
            .num_remark
              %h6 Remark
              %p
                %strong (Normalization conventions)
                %br/
                Our choice of prefactors and normalization follows
                %a{:href => "D'Auria-Fre+formulation+of+supergravity#CastellaniDAuriaFre"} CDF91
                except for the following changes:
              %ul
                %li
                  %p
                    our Clifford generators absorb a factor of
                    = succeed ":" do
                      %a.existingWikiWord{:href => "/nlab/show/imaginary+unit"}
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
