                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo ,
                              %mi D
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} Spin(1,D)
                    %a.existingWikiWord{:href => "/nlab/show/equivariant+map"} equivariant
                    %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear
                    pairing we denote
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
