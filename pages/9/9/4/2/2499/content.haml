            %a{:href => "#CastellaniDAuriaFre"}> Castellani, D’Auria &amp;Fré 1991, vol 2, (III.3.30)
            )
          .proof
            %h6#proof Proof
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
