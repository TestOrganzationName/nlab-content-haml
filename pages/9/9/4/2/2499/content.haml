                          %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          \\overline{(\text{-})}(\text{-})
                          \\;\colon\;
                          \\mathbf{N} \otimes \mathbf{N}
                          \\longrightarrow
                          \\mathbb{R}^{1,D-1}
                          \\,,
              %p
                by a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/super-spacetime"} super-spacetime
                of super-dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
