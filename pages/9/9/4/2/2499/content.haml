                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
            %strong cosmo-cocycle condition
            in (
            %a{:href => "#DAuriaFre"}> DAuriaFre
            ).
          %p
            To do so, we work in a basis
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi t
                    %mi a
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{t^a\}
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi r
                    %mi a
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{r^a\}
            be the corresponding shifted basis of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*[1]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mfrac
                    %mn 1
                    %mi n
                  %msup
                    %mi C
                    %mi a
                  %msub
                    %mrow
                    %mrow
                      %msub
                        %mi b
                        %mn 0
                      %mi ⋯
                      %msub
                        %mi b
                        %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\frac{1}{n}C^a{}_{b_0 \cdots b_n}\}
            for the structure constants in this basis, so that the differential in the
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            acts as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi W
                  %mo :
                  %msup
                    %mi t
                    %mi a
                  %mo ↦
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                  %mfrac
                    %mn 1
                    %mi n
                  %msup
                    %mi C
                    %mi a
                  %msub
                    %mrow
                    %mrow
                      %msub
                        %mi b
                        %mn 0
                      %mi ⋯
                      %msub
                        %mi b
                        %mi n
                  %msup
                    %mi t
                    %mrow
                      %msub
                        %mi b
                        %mn 0
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %msup
                    %mi t
                    %mrow
                      %msub
                        %mi b
                        %mi n
                  %mo +
                  %msup
                    %mi r
                    %mi a
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_W : t^a \mapsto \sum_{n \in \mathbb{N}} \frac{1}{n} C^a{}_{b_0 \cdots b_n} t^{b_0} \wedge \cdots \wedge t^{b_n} + r^a
                  \\,.
          %p
            Write a general element in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cs
                  %mo ≔
                  %mi λ
                  %mo +
                  %msup
                    %mi r
                    %mi a
                  %mo ∧
                  %msub
                    %mi ν
                    %mi a
                  %mo +
                  %msup
                    %mi r
                    %mi a
                  %mo ∧
                  %msup
                    %mi r
                    %mi b
                  %mo ∧
                  %msub
                    %mi ν
                    %mrow
                      %mi a
                      %mi b
                  %mo +
                  %mi ⋯
                  %mo +
                  %msup
                    %mi r
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %msup
                    %mi r
                    %mrow
                      %msub
                        %mi a
                        %mi d
                  %msub
                    %mi ν
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi a
                        %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  cs
                  \\coloneqq
                  \\lambda + r^a \wedge \nu_a + r^a \wedge r^b \wedge \nu_{a b} + \cdots
                  + r^{a_1} \wedge \cdots \wedge r^{a_d} \nu_{a_1 \cdots a_2}
                  \\,,
          %p
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ,
                    %msub
                      %mi ν
                      %mi a
                    %mo ,
                    %msub
                      %mi ν
                      %mrow
                        %mi a
                        %mi b
                    %mo ,
                    %mi ⋯
                    %mo ∈
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda, \nu_a, \nu_{a b}, \cdots \in CE(\mathfrak{g})
          .num_prop
            %h6#proposition_4 Proposition
            %p
              The condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi cs
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d_{W(\mathfrak{g})} (cs)
              has no terms
              %em linear
              in the curvatures
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi r
                      %mi a
                  %annotation{:encoding => "application/x-tex"} r^a
              is equivalent to the system of equations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi t
                                  %mi a
                            %mi λ
                            %mo +
                            %mo ∇
                            %msub
                              %mi ν
                              %mi a
                          %mtd
                            %mo ≔
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi t
                                  %mi a
                            %mi λ
                            %mo +
                            %msub
                              %mi d
                              %mi W
                            %msub
                              %mi ν
                              %mi a
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:stretchy => "false"} |
                                %msub
                                  %mi t
                                  %mi a
                                %mo{:stretchy => "false"} |
                            %msup
                              %mi C
                              %mi c
                            %msub
                              %mrow
                              %mrow
                                %mi a
                                %msub
                                  %mi b
                                  %mn 1
                                %mi ⋯
                                %msub
                                  %mi b
                                  %mi n
                            %msup
                              %mi t
                              %mrow
                                %msup
                                  %mi b
                                  %mn 1
                            %mo ∧
                            %mi ⋯
                            %msup
                              %mi t
                              %mrow
                                %msup
                                  %mi b
                                  %mi n
                            %mo ∧
                            %msub
                              %mi ν
                              %mi c
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\iota_{t_a} \lambda + \nabla \nu_a
                    \&amp; \coloneqq
                    \\iota_{t_a} \lambda
                    +
                    d_W \nu_a +
                    (-1)^{|t_a|}
                    C^c{}_{a b_1 \cdots b_n} t^{b^1} \wedge \cdots t^{b^n} \wedge \nu_c
                    \\\
                    \&amp; = 0
                    \\end{aligned}
                    \\,,
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi t
                        %mi a
                      %mo ∈
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} t_a \in \mathfrak{g}
          %p
            In
            %a{:href => "#DAuriaFre"} DAuriaFre p. 9
            this system of equations is called the
            %strong cosmo-cocycle condition
            \.
          .proof
            %h6#proof_2 Proof
            %p
              This follows straightforwardly from the definition of the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi W
                          %mo{:stretchy => "false"} (
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_{W(\mathfrak{g})}
            %p
              We have
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi W
                          %mo{:stretchy => "false"} (
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                      %mo +
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                    %annotation{:encoding => "application/x-tex"} d_{W(\mathfrak{g})} = d_{CE(\mathfrak{g})} + \mathbf{d}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mo :
                      %msup
                        %mi t
                        %mi a
                      %mo ↦
                      %msup
                        %mi r
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \mathbf{d} : t^a \mapsto r^a
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mi λ
                    %mo =
                    %msub
                      %mi d
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mi λ
                    %mo +
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi λ
                    %mo =
                    %msub
                      %mi d
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mi λ
                    %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi a
                    %msup
                      %mi r
                      %mi a
                    %mo ∧
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi t
                          %mi a
                    %mi λ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_{W(\mathfrak{g})} \lambda
                    \=
                    d_{CE(\mathfrak{g})} \lambda
                    +
                    \\mathbf{d} \lambda
                    \=
                    d_{CE(\mathfrak{g})} \lambda
                    +
                    \\sum_a r^a \wedge \iota_{t_a} \lambda
                    \\,.
            %p Here the first term contains no curvatures, while the second is precisely linear in the curvatures.
            %p
              Moreover, by the
              %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi r
                      %mi a
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi n
                    %msup
                      %mi C
                      %mi a
                    %msub
                      %mrow
                      %mrow
                        %msub
                          %mi b
                          %mn 0
                        %mi ⋯
                        %msub
                          %mi b
                          %mi n
                    %msup
                      %mi r
                      %mrow
                        %msub
                          %mi b
                          %mn 0
                    %mo ∧
                    %msup
                      %mi t
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %msup
                      %mi t
                      %mrow
                        %msub
                          %mi b
                          %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_{W(\mathfrak{g})} r^a
                    \=
                    \\sum_n C^a{}_{b_0 \cdots b_n} r^{b_0} \wedge t^{b_1} \wedge \cdots \wedge t^{b_n}
                    \\,.
            %p
              Therefore the condition that all terms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi W
                    %mi cs
                  %annotation{:encoding => "application/x-tex"} d_{W} cs
              that are linear in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi r
                      %mi a
                  %annotation{:encoding => "application/x-tex"} r^a
              in vanish is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mi r
                              %mi a
                            %mo ∧
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi t
                                  %mi a
                            %mi λ
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:stretchy => "false"} |
                                %msub
                                  %mi t
                                  %mi a
                                %mo{:stretchy => "false"} |
                            %msup
                              %mi r
                              %mi a
                            %msub
                              %mi d
                              %mrow
                                %mi CE
                                %mo{:stretchy => "false"} (
                                %mi 𝔤
                                %mo{:stretchy => "false"} )
                            %msub
                              %mi ν
                              %mi a
                            %mo +
                            %msup
                              %mi r
                              %mi a
                            %mo ∧
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi n
                            %msup
                              %mi C
                              %mi c
                            %msub
                              %mrow
                              %mrow
                                %mi a
                                %msub
                                  %mi b
                                  %mn 1
                                %mi ⋯
                                %msub
                                  %mi b
                                  %mi n
                            %msup
                              %mi t
                              %mrow
                                %msub
                                  %mi b
                                  %mn 1
                            %mo ∧
                            %msup
                              %mi t
                              %mrow
                                %msub
                                  %mi b
                                  %mi n
                            %mo ∧
                            %msub
                              %mi ν
                              %mi c
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mi r
                              %mi a
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi t
                                  %mi a
                            %mi λ
                            %mo +
                            %msub
                              %mi d
                              %mrow
                                %mi CE
                                %mo{:stretchy => "false"} (
                                %mi 𝔤
                                %mo{:stretchy => "false"} )
                            %msub
                              %mi ν
                              %mi a
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:stretchy => "false"} |
                                %msub
                                  %mi t
                                  %mi a
                                %mo{:stretchy => "false"} |
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi n
                            %msup
                              %mi C
                              %mi c
                            %msub
                              %mrow
                              %mrow
                                %mi a
                                %msub
                                  %mi b
                                  %mn 1
                                %mi ⋯
                                %msub
                                  %mi b
                                  %mi n
                            %msup
                              %mi t
                              %mrow
                                %msub
                                  %mi b
                                  %mn 1
                            %mo ∧
                            %mi ⋯
                            %mo ∧
                            %msup
                              %mi t
                              %mrow
                                %msub
                                  %mi b
                                  %mi n
                            %mo ∧
                            %msub
                              %mi ν
                              %mi c
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \&amp; r^a \wedge \iota_{t_a} \lambda
                    +
                    (-1)^{|t_a|}
                    r^a d_{CE(\mathfrak{g})}\nu_a
                    +
                    r^a \wedge \sum_n C^c{}_{a b_1 \cdots b_n} t^{b_1} \wedge t^{b_n} \wedge \nu_c
                    \\\
                    \&amp; =
                    r^a(
                    \\iota_{t_a} \lambda +
                    d_{CE(\mathfrak{g})}\nu_a
                    +
                    (-1)^{|t_a|}
                    \\sum_n C^c{}_{a b_1 \cdots b_n} t^{b_1}\wedge \cdots  \wedge t^{b_n} \wedge \nu_c
                    )
                    \\\
                    \&amp;
                    \= 0
                    \\end{aligned}
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              For comparison with
              %a{:href => "#DauriaFre"} DAuriaFre
              notice the following:
            %ul
              %li
                %p
                  there all elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi t
                          %mi a
                      %annotation{:encoding => "application/x-tex"} t_a
                  happen to be in even degree. Therefore the extra sign
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi t
                              %mi a
                            %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} (-1)^{|t_a|}
                  that we display does not appear.
              %li
                %p
                  the term that we write
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mrow
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi ν
                          %mi a
                      %annotation{:encoding => "application/x-tex"} d_{CE(\mathfrak{g})} \nu_a
                  is there equivalently expressed as
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mrow
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi ν
                          %mi a
                        %mspace{:width => "thickmathspace"}
                        %mo ,
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi at
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi r
                          %mi a
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        d_{W(\mathfrak{g})} \nu_a \;,\;\;\; at\; r^a = 0
                %p
                  (
                  %a{:href => "http://ncatlab.org/nlab/files/GeometricSupergravity.pdf#page=9"}> equation (2.21)
                  ).
          %h3#Examples Examples
          %h4#minimal_4dimensional__supergravity
            Minimal 4-dimensional
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} N=2
