                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} \mu_a\big( (x^a), (\theta^\alpha = 0)  \big)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi a
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi θ
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mu_a\big( (x^a), (\theta^\alpha)  \big)
            %p and
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi α
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi θ
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mu_\alpha\big( (x^a), (\theta^\alpha)  \big)
            %p
              may be expressed as functions of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mi a
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi θ
                        %mi α
                      %mo =
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} \mu_a\big( (x^a), (\theta^\alpha = 0) \big)
            %p
              We now first prove something weaker, namely that these functions are uniquely determined once we know not just
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi a
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi θ
                      %mi α
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mu_a\big( (x^a), (\theta^\alpha = 0) \big)
              but also
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mi α
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi θ
                        %mi α
                      %mo =
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} \mu_\alpha\big( (x^a), (\theta^\alpha = 0) \big)
            %blockquote
              %p
                It seems to me that this weaker statement is all that
                %a{:href => "#CastellaniDAuriaFre"} Castellani-D’Auria-Fré 91, vol 2, III.3.3
                really provide, for notice that the last line of their (III.3.29) still depends on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi μ
                          %mi α
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi x
                          %mi a
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi θ
                          %mi α
                        %mo =
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} \mu_\alpha\big( (x^a), (\theta^\alpha = 0) \big)
            %p
              By the nilpotency of the odd-graded coordinates
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi θ
                        %mi α
                    %annotation{:encoding => "application/x-tex"} \theta^\alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is a
              %a.existingWikiWord{:href => "/nlab/show/multilinear+map"} multilinear map
              in the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi θ
                        %mi α
                    %annotation{:encoding => "application/x-tex"} \theta^\alpha
            %p
              Hence, by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi θ
                      %mi α
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi k
                        %mi lin
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mu\big( (x^a), (\theta^\alpha)_{k lin}  \big)
              in the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi θ
                      %mi α
                  %annotation{:encoding => "application/x-tex"} \theta^\alpha
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi θ
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mu\big( (x^a), (\theta^\alpha)  \big)
              is fixed by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi θ
                        %mi α
                      %mo =
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} \mu\big( (x^a), (\theta^\alpha = 0)  \big)
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k+1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi a
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi θ
                      %mi α
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi lin
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mu_a\big( (x^a), (\theta^\alpha)_{(k+1) lin}  \big)
              is fixed.
            %p
              This is evidently equivalent to the statement that all the
              %a.existingWikiWord{:href => "/nlab/show/derivatives"} derivatives
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi θ
                      %mi α
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi lin
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mu\big( (x^a), (\theta^\alpha)_{(k+1) lin}  \big)
              by any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                  %annotation{:encoding => "application/x-tex"} \theta^{\alpha_{k+1}}
              evaluated at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \theta^{\alpha_{k+1}} = 0
              are fixed.
            %p
              The key point is that by the assumption that we have a Cartan connection, these derivatives are proportional to a sum of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi F
                      %mi ω
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %msub
                          %mi α
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                        %mi a
                  %annotation{:encoding => "application/x-tex"} \big( F_\omega\big)_{\alpha_{k+1} a}
              with a linear combination of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi F
                      %mi ω
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %msub
                          %mi α
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                        %mi a
                  %annotation{:encoding => "application/x-tex"} \big( F_\omega\big)_{\alpha_{k+1} a}
              (which a priori depends on data at
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %msup
                        %mi θ
                        %mi α
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathbf{d}\theta^\alpha \neq 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %msup
                        %mi θ
                        %mi α
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d \theta^\alpha = 0
            %blockquote
              %p
                This is essentially the argument in
                = succeed "," do
                  %a{:href => "#CastellaniDAuriaFre"} Castellani-D’Auria-Fré 91, vol 2, (III.3.29)-(III.3.31)
            %p
              This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi θ
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mu\big( (x^a), (\theta^\alpha)  \big)
              satisfies well-formed differential equations in the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi θ
                        %mi α
                    %annotation{:encoding => "application/x-tex"} \theta^\alpha
            %p
              To conclude, we hence need to see that we have sufficient boundary data on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi θ
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mu\big( (x^a), (\theta^\alpha)  \big)
              fixed to have the solution to this differential equation be unique.
            %p
              Now the boundary data for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi a
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi θ
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mu_a\big( (x^a), (\theta^\alpha)  \big)
              is clearly
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mi a
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi θ
                        %mi α
                      %mo =
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} \mu_a\big( (x^a), (\theta^\alpha = 0)  \big)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi α
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi θ
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mu_\alpha\big( (x^a), (\theta^\alpha)  \big)
              this would be the end of the story.
            %p
              We do
              %em not
              know the analogous boundary data
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mi α
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi θ
                        %mi α
                      %mo =
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} \mu_\alpha\big( (x^a), (\theta^\alpha = 0)  \big)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi α
                  %annotation{:encoding => "application/x-tex"} \mu_\alpha
              is forgotten when restricting to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %msup
                        %mi θ
                        %mi α
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathbf{d}\theta^\alpha = 0
            %blockquote
              %p I think this is a real gap in the general argument for rheonomy. It is not a real problem in special situations, though…
          %p (…)
          %div
            %h2#11DSugraFromSuperCFieldFluxQuantization 11d-SuGra from Super C-Field Flux Quantization
            %p
              We discuss (Thm.
              %a.maruku-ref{:href => "#11dSuGraEOMFromSuperFluxIdentity"}
              below, following
              = succeed ")" do
                %a{:href => "D=11+supergravity#GiotopoulosSatiSchreiber24"} GSS24, §3
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              of
              %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
              — on an
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 11
                      %mo{:stretchy => "false"} |
                      %mstyle{:mathvariant => "bold"}
                        %mn 32
                    %annotation{:encoding => "application/x-tex"} 11\vert\mathbf{32}
              = succeed "-free" do
                %a.existingWikiWord{:href => "/nlab/show/super-torsion"} super-torsion
              %a.existingWikiWord{:href => "/nlab/show/super+spacetime"} super spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %a.existingWikiWord{:href => "/nlab/show/super+vielbein"} super vielbein
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e,\psi)
              (the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/graviton"} graviton
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/gravitino"} gravitino
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
              %a.existingWikiWord{:href => "/nlab/show/duality-symmetric+higher+gauge+theory"} duality-symmetric
              %a.existingWikiWord{:href => "/nlab/show/differential+form+on+a+supermanifold"} super-
