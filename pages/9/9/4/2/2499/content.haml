                            %mo ⊗
                        %annotation{:encoding => "application/x-tex"} \;\;\;G_7 = \tfrac{1}{5!} R^{\otimes}
              %p Here:
              %ul
                %li
                  %p
                    The first rescaling reflects that
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
