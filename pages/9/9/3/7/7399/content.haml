          %title Childrens drawings (Dessins denfants)
          %h1#childrens_drawings_dessins_denfants Children’s drawings (Dessins d’enfants)
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea_and_prehistory"} Idea and prehistory
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#remark"} Remark
              %li
