                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %mi y
                    %msub
                      %mo +
                      %mn 0.5
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mi x
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %mi y
                    %msub
                      %mo +
                      %mn 0.5
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x +_0.5 z) \oplus (y+_0.5 z) \oplus x \oplus (y+_0.5 x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mn 0.5
                  %mo ,
                  %mn 0
                  %mo ,
                  %mn 0.5
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
