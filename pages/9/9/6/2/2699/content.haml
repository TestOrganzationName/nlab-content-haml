              %li
                %a{:href => "#the_nonabelian_lie_group_case"} The Non-Abelian Lie Group Case
          %h1#derived_elliptic_curves Derived Elliptic Curves
          %p
            %strong Definition
            A
            %a.existingWikiWord{:href => "/nlab/show/derived+elliptic+curve"} derived elliptic curve
            over an (affine)
            %a.existingWikiWord{:href => "/nlab/show/derived+scheme"} derived scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Spec
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mathrm{Spec} A
            is a commutative
            %a.existingWikiWord{:href => "/nlab/show/derived+group+scheme"} derived group scheme
            (CDGS)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} /
                  %mi A
                %annotation{:encoding => "application/x-tex"} E /A
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi E
                    %mo ¯
                  %mo →
                  %mi{:mathvariant => "normal"} Spec
                  %msub
                    %mi π
                    %mn 0
                  %mi A
                %annotation{:encoding => "application/x-tex"} \overline{E} \to \mathrm{Spec} \pi_0 A
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be an
            = succeed "-ring." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(A)
            denote the
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Spec
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{Spec} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(A)
            is in particular a space (we will return to this point later).
          %p The point is to prove the following due to Lurie.
          %p
            %strong Theorem
            The functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ↦
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \mapsto E(A)
            is representable by a derived Deligne-Mumford stack
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℳ
                      %mi Der
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi ℳ
                    %mo ,
                    %msub
                      %mi O
                      %mi ℳ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}^{Der} = (\mathcal{M} , O_\mathcal{M} )
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℳ
                %annotation{:encoding => "application/x-tex"} \mathcal{M}
            is equivalent to the topos underlying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℳ
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathcal{M}_{1,1}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msub
                      %mi O
                      %mi ℳ
                    %mo =
                    %msub
                      %mi O
                      %mrow
                        %msub
                          %mi ℳ
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_0 O_\mathcal{M} = O_{\mathcal{M}_{1,1}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi ℳ
                %annotation{:encoding => "application/x-tex"} O_\mathcal{M}
            provides a lift in sense of Hopkins and Miller.
          %h1#equivariant
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{G}
            \-Equivariant
            = succeed "-cohomology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h2#the_strategy The Strategy
          %ol
            %li
              %p
                Define
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A_{S^1 } (*)
            %li
              %p
                Extend to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_{S^1} (X)
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a trivial
                = succeed "-space;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S^1
            %li
              %p
                Define
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_T (X)
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                is a compact abelian Lie group where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is again a trivial
                = succeed "-space;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
            %li
              %p
                Extend to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_T (X)
                for any (finite enough)
                = succeed "-space;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
            %li
              %p
                Define
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_G (X)
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                any compact Lie group.
          %h2#equivariance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
            \-equivariance
          %p To accomplish (1) we need a map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo :
                  %mi{:mathvariant => "normal"} Spf
                  %msup
                    %mi A
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn ∞
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                %annotation{:encoding => "application/x-tex"} \sigma : \mathrm{Spf} A^{\mathbb{C} P^\infty} \to \mathbf{G}
          %p
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Spec
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{Spec} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_{S^1} (*) = O (\mathbf{G})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo →
                  %msup
                    %mi A
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn ∞
                %annotation{:encoding => "application/x-tex"} A_{S^1} \to A^{\mathbb{C}P^\infty}
          %p
            which we may interpret as a preorientation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi{:mathvariant => "normal"} Map
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi BS
                      %mn 1
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma \in \mathrm{Map} (BS^1 , \mathbf{G} (A))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            is an orientation if the induced map to the formal completion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{G}
            is an isomorphism.
          %p Recall two facts:
          %ol
            %li
              %p
                There is a bijection
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msup
                          %mi BS
                          %mn 1
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi G
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} }
                        %mo ↔
                        %mo{:stretchy => "false"} {
                        %mi{:mathvariant => "normal"} Spf
                        %msup
                          %mi A
                          %mrow
                            %msup
                              %mi BS
                              %mn 1
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi G
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{ BS^1 \to \mathbf{G} (A) \} \leftrightarrow \{ \mathrm{Spf} A^{BS^1} \to \mathbf{G} \}
            %li
              %p
                Orientations of the multiplicative group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi G
                        %mi m
                    %annotation{:encoding => "application/x-tex"} \mathbf{G}_m
                associated to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                are in bijection with maps of
                = succeed "-rings" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} E_\infty
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi K
                        %mo →
                        %mi A
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{ K \to A\}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                is the K-theory spectrum.
          %p
            %strong Theorem
            We can define equivariant
            = succeed "-cohomology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi G
                    %mi m
                %annotation{:encoding => "application/x-tex"} \mathbf{G}_m
            if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %h2#the_abelian_lie_group_case_for_a_point The Abelian Lie Group Case for a Point
          %p
            Fix
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                  %mo{:stretchy => "false"} /
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mathbf{G}/A
            oriented. Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            be a compact abelian Lie group. We construct a commutative
            %a.existingWikiWord{:href => "/nlab/show/derived+group+scheme"} derived group scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mi T
                %annotation{:encoding => "application/x-tex"} M_T
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            whose global sections give
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi T
                %annotation{:encoding => "application/x-tex"} A_T
            which is equipped with an appropriate completion map.
          %p
            %strong Definition
            Define the Pontryagin dual,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi T
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat T
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi T
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %mo =
                    %msub
                      %mi{:mathvariant => "normal"} Hom
                      %mi{:mathvariant => "normal"} Lie
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ,
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat T := \mathrm{Hom}_\mathrm{Lie} (T, S^1)
          %p
            %strong Examples
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi T
                      %mo =
                      %msup
                        %mi T
                        %mi n
                    %annotation{:encoding => "application/x-tex"} T=T^n
                , the
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi T
                        %mo{:stretchy => "false"} ^
                      %mo =
                      %msup
                        %mi ℤ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \hat T = \mathbb{Z}^n
                as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi T
                        %mo{:stretchy => "false"} ^
                      %mo ∋
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi θ
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi θ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi k
                        %mn 1
                      %msub
                        %mi θ
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi k
                        %mi n
                      %msub
                        %mi θ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \hat T \ni ( \theta_1 , \dots , \theta_n ) \mapsto (k_1 \theta_1 , \dots , k_n \theta_n ).
            %li
              %p
                If
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mi e
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} T = \{ e \}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi T
                          %mo{:stretchy => "false"} ^
                        %mo =
                        %mi T
                      %annotation{:encoding => "application/x-tex"} \hat T = T
          %p
            %strong Pontryagin Duality
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is an abelian, locally compact topological group then
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mover
                        %mi T
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} ^
                    %mo ≃
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \hat \hat T \simeq T
          %p
            %strong Definition
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            be an
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mi T
                %annotation{:encoding => "application/x-tex"} M_T
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi{:mathvariant => "normal"} Hom
                    %mi{:mathvariant => "normal"} AbTop
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi T
                    %mo{:stretchy => "false"} ^
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} M_T (B) := \mathrm{Hom}_\mathrm{AbTop} (\hat T , \mathbf{G} (B)).
          %p
            Further,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mi T
                %annotation{:encoding => "application/x-tex"} M_T
            is representable.
          %p
            %strong Examples
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi{:mathvariant => "normal"} Hom
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mstyle{:mathvariant => "bold"}
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} M_{S^1} (B) = \mathrm{Hom} ( \mathbb{Z} , \mathbf{G} (B)) = \mathbf{G} (B).
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mrow
                          %msup
                            %mi T
                            %mi n
                      %mo =
                      %mstyle{:mathvariant => "bold"}
                        %mi G
                      %msub
                        %mo ×
                        %mrow
                          %mi{:mathvariant => "normal"} Spec
                          %mi A
                      %mi …
                      %msub
                        %mo ×
                        %mrow
                          %mi{:mathvariant => "normal"} Spec
                          %mi A
                      %mstyle{:mathvariant => "bold"}
                        %mi G
                      %mo .
                    %annotation{:encoding => "application/x-tex"} M_{T^n} = \mathbf{G} \times_{\mathrm{Spec} A} \dots \times_{\mathrm{Spec} A} \mathbf{G}.
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mi n
                      %mo =
                      %mi{:mathvariant => "normal"} hker
                      %mo{:stretchy => "false"} (
                      %mo ×
                      %mi n
                      %mo :
                      %mstyle{:mathvariant => "bold"}
                        %mi G
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi G
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} M_{\mathbb{Z}/n} = \mathrm{hker} (\times n: \mathbf{G}\to \mathbf{G}).
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mrow
                          %mo{:stretchy => "false"} {
                          %mi e
                          %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi{:mathvariant => "normal"} Hom
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mi e
                      %mo{:stretchy => "false"} }
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi e
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} M_{\{e\}} (B) = \mathrm{Hom} ( \{e \} , \mathbf{G} (B) = \{e\}
                , so
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mrow
                          %mo{:stretchy => "false"} {
                          %mi e
                          %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} M_{\{e\}}
                is final over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} Spec
                        %mi A
                      %annotation{:encoding => "application/x-tex"} \mathrm{Spec} A
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} Spec
                        %mi A
                      %annotation{:encoding => "application/x-tex"} \mathrm{Spec} A
          %p
            How do we get a completion map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mi T
                  %mo :
                  %mi BT
                  %mo →
                  %msub
                    %mi M
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sigma_T : BT \to M_T (A)
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            given an orientation
            = succeed "?" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo :
                    %msup
                      %mi BS
                      %mn 1
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma_{S^1} : BS^1 \to \mathbf{G} (A)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Bev
                  %mo :
                  %mi BT
                  %mo →
                  %mi{:mathvariant => "normal"} Hom
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi T
                    %mo{:stretchy => "false"} ^
                  %mo ,
                  %msup
                    %mi BS
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mi p
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ↦
                  %mi Bf
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Bev: BT \to \mathrm{Hom}(\hat T , BS^1), \; p \mapsto (f \mapsto Bf(p))
          %p then define
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mi T
                  %mo :
                  %mo =
                  %msub
                    %mi σ
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo ∘
                  %mi Bev
                  %mo .
                %annotation{:encoding => "application/x-tex"} \sigma_T := \sigma_{S^1} \circ Bev.
          %p
            %strong Proposition
            There exists a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi M
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat M
            such that the assignment
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ↦
                  %msub
                    %mi M
                    %mi T
                %annotation{:encoding => "application/x-tex"} T \mapsto M_T
            factors as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ↦
                    %mover
                      %mi M
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi BT
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T \mapsto \hat M (BT)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            factors through the category of classifying spaces of compact Abelian Lie groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi CALG
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(CALG)
            (considered as orbifolds). Further, such factorizations are in bijection with the preorientations of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{G}
          %p
            %em Proof.
            That such a factorization exists defines
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi M
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat M
            on objects. Now by choosing a base point in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi BT
                  %mo ′
                %annotation{:encoding => "application/x-tex"} BT'
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Hom
                  %mo{:stretchy => "false"} (
                  %mi BT
                  %mo ,
                  %mi BT
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi BT
                  %mo ′
                  %mo ×
                  %mi{:mathvariant => "normal"} Hom
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi T
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Hom} (BT , BT' ) \simeq BT' \times \mathrm{Hom} (T, T')
          %p as spaces. Now we need a map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi BT
                  %mo ′
                  %mo →
                  %mi{:mathvariant => "normal"} Hom
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi M
                    %mi T
                  %mo ,
                  %msub
                    %mi M
                    %mrow
                      %mi T
                      %mo ′
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} BT' \to \mathrm{Hom} (M_T , M_{T'}) .
          %p
            Because this map must be functorial in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ′
                %annotation{:encoding => "application/x-tex"} T'
            we can restrict to the universal case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is trivial and then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi BT
                  %mo ′
                  %mo →
                  %mi{:mathvariant => "normal"} Hom
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi M
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi e
                      %mo{:stretchy => "false"} }
                  %mo ,
                  %msub
                    %mi M
                    %mrow
                      %mi T
                      %mo ′
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi M
                    %mrow
                      %mi T
                      %mo ′
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} BT' \to \mathrm{Hom} ( M_{\{e\}} , M_{T'} ) = M_{T'} (A)
          %p
            is just a preorientation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mrow
                        %mi T
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} \sigma_{T'}
          %h2#the_abelian_case_for_general_spaces The Abelian Case for General Spaces
          %p
            We will see that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A_T (X)
            is the global sections of a quasi-coherent sheaf on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi T
                  %annotation{:encoding => "application/x-tex"} M_T
          %p
            %strong Theorem
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{G}
            be preoriented and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a finite
            = succeed "-CW" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi F
                    %mi T
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{ F_T \}
            from finite
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mi T
                %annotation{:encoding => "application/x-tex"} M_T
            such that
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi T
                    %annotation{:encoding => "application/x-tex"} F_T
                maps
                = succeed "-equivariant" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi T
                    %annotation{:encoding => "application/x-tex"} F_T
                maps finite homotopy colimits to finite homotopy limits of quasi-coherent sheaves;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi O
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi M
                        %mstyle{:mathvariant => "bold"}
                          %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_T (*) = O (M_\mathbf{G})
                ;
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ⊂
                      %mi T
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} T \subset T'
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ′
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi T
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi T
                    %annotation{:encoding => "application/x-tex"} X' = (X \times T' )/T
                then
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mi T
                            %mo ′
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi f
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mi T
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F_{T'} (X') \simeq f_* (F_T (X))
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %msub
                        %mi M
                        %mi T
                      %mo →
                      %msub
                        %mi M
                        %mrow
                          %mi T
                          %mo ′
                    %annotation{:encoding => "application/x-tex"} f: M_T \to M_{T'}
                is the induced map;
            %li
              %p
                The
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi T
                    %annotation{:encoding => "application/x-tex"} F_T
                are compatible under finite chains of inclusions of subgroups
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo ⊂
                        %mi T
                        %mo ′
                        %mo ⊂
                        %mi T
                        %mo ″
                        %mi …
                      %annotation{:encoding => "application/x-tex"} T \subset T' \subset T'' \dots
          %p
            %em Proof.
            Use (2) to reduce to the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi T
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi T
                    %mn 0
                  %mo ×
                  %msup
                    %mi D
                    %mi k
                %annotation{:encoding => "application/x-tex"} X = T/ T_0 \times D^k
            for some subgroup
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 0
                    %mo ⊂
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T_0 \subset T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi T
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi T
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X = T/T_0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi T
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi f
                      %mo *
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi T
                          %mn 0
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_T (T/T_0) = f_* F_{T_0} (*)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi T
                          %mn 0
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mover
                      %mi M
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi T
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_{T_0} (*) = \hat M (*/T_0 )
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi M
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat M
            is specified by the preorientation.
          %blockquote
            %p For trivial actions there is no dependence on the preorientation.
          %p
            %strong Remark
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_T (X)
                is actually a sheaf of algebras.
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X,Y
                are
                = succeed "-spaces" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo ←
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_T (X) \to F_T (X \times Y) \leftarrow F_T (Y)
              %p and
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} F_T (X) \otimes F_T (Y) \to F_T (X \times Y).
            %li
              %p
                Define relative version for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 0
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X_0 \subset X
                by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mi X
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi hker
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_T (X, X_0 ) = hker (F_T (X) \to F_T (X_0 ))
              %p
                and for all
                = succeed "-spaces" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                we have a map
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mi X
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⊗
                        %mi A
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %mo ,
                      %msub
                        %mi X
                        %mn 0
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} F_T (X, X_0 ) \otimes_{A} F_T (Y) \to F_T (X \times Y , X_0 \times Y).
          %p
            %strong Definition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A_T (X) = \Gamma (F_T (X))
            as an
            = succeed "-ring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          %p
            We now verify loop maps on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi T
                  %annotation{:encoding => "application/x-tex"} A_T
          %p
            Recall that in the classical setting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A^n (X)
            is represented by a space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mi n
                %annotation{:encoding => "application/x-tex"} Z_n
            and we have suspension maps
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mn 0
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %msub
                      %mi Z
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z_0 \to (S^n \to Z_n)
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "-maps" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %msub
                      %mi Z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n \to Z_n
          %p
            %strong Theorem
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{G}
            be oriented,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            a finite dimensional unitary representation of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SV
                  %mo ⊂
                  %mi BV
                %annotation{:encoding => "application/x-tex"} SV \subset BV
            the unit sphere inside of the unit ball. Define
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi V
                    %mo =
                    %msub
                      %mi F
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi BV
                    %mo ,
                    %mi SV
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L_V = F_T (BV, SV)
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mi V
                    %annotation{:encoding => "application/x-tex"} L_V
                is a line bundle on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi M
                          %mi T
                      %annotation{:encoding => "application/x-tex"} M_T
            %li
              %p
                For all (finite)
                = succeed "-spaces" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                the map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi V
                  %mo ⊗
                  %msub
                    %mi F
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi F
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi BV
                  %mo ,
                  %mi X
                  %mo ×
                  %mi SV
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L_V \otimes F_T (X) \to F_T (X \times BV, X \times SV)
          %p is an isomorphism.
          %p
            %em
              Proof for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo =
                    %msup
                      %mi S
                      %mn 1
                    %mo =
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T = S^1 = U(1)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} V = \mathbb{C}
            Then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi V
                  %mo =
                  %mi hker
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi BV
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi F
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi SV
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} L_V = hker ( F_T (BV) \to F_T (SV)) .
          %p
            As
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi BV
                %annotation{:encoding => "application/x-tex"} BV
            is contractible
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi BV
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_T (BV) = O (\mathbf{G})
            and by property (3) above
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi SV
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} Spec
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_T (SV) = f_* (O (\mathrm{Spec} A))
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi{:mathvariant => "normal"} Spec
                  %mi A
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                %annotation{:encoding => "application/x-tex"} f: \mathrm{Spec} A \to \mathbf{G}
            is the identity section. As
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{G}
            is oriented,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi π
                    %mn 0
                  %mi{:mathvariant => "normal"} Spec
                  %mi A
                %annotation{:encoding => "application/x-tex"} \pi_0 \mathbf{G} / \pi_0 \mathrm{Spec} A
            is smooth of relative dimension 1, so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi V
                %annotation{:encoding => "application/x-tex"} L_V
            can be though of as the invertible sheaf of ideals defining the identity section of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{G}
          %p
            Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ′
                %annotation{:encoding => "application/x-tex"} V'
            are representations of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi V
                  %mo ⊗
                  %msub
                    %mi L
                    %mrow
                      %mi V
                      %mo ′
                  %mo →
                  %msub
                    %mi L
                    %mrow
                      %mi V
                      %mo ⊕
                      %mi V
                      %mo ′
                %annotation{:encoding => "application/x-tex"} L_V \otimes L_{V'} \to L_{V \oplus V'}
            is an equivalence. So if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            is a virtual representation (i.e.
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo =
                    %mi U
                    %mo −
                    %mi U
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} W = U - U'
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi W
                  %mo =
                  %msub
                    %mi L
                    %mi U
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi L
                    %mrow
                      %mi U
                      %mo ′
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo .
                %annotation{:encoding => "application/x-tex"} L_W = L_U \otimes (L_{U'} )^{-1} .
          %p
            %strong Definition
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a virtual representation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            and define
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi A
                    %mi T
                    %mi V
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msubsup
                    %mi L
                    %mi V
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} A_T^V (X) = \pi_0 \Gamma (F_T (X) \otimes L_V^{-1}) .
          %blockquote
            %p
              The point is that in order to define equivariant cohomology requires functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi A
                      %mi G
                      %mi W
                  %annotation{:encoding => "application/x-tex"} A_G^W
              for all representations of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{G}
          %h2#the_nonabelian_lie_group_case The Non-Abelian Lie Group Case
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be an
            = succeed "-ring," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{G}
            an orientated commutative
            %a.existingWikiWord{:href => "/nlab/show/derived+group+scheme"} derived group scheme
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Spec
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{Spec} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            a (not necessarily Abelian) compact Lie group.
          %p
            %strong Theorem
            There exists a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi T
                %annotation{:encoding => "application/x-tex"} A_T
            from (finite?)
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi T
                    %annotation{:encoding => "application/x-tex"} A_T
                preserves equivalence;
            %li
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mn 0
                        %mo ⊂
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T_0 \subset T
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mrow
                            %msub
                              %mi T
                              %mn 0
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi A
                          %mi T
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ×
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi T
                          %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A_{T_0} (X) = A_T ((X \times G) / T_0 )
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi T
                    %annotation{:encoding => "application/x-tex"} A_T
                maps homotopy colimits to homotopy limits;
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                is Abelian, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi T
                    %annotation{:encoding => "application/x-tex"} A_T
                is defined as above;
            %li
              %p
                For all spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                the map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi A
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %msup
                    %mi E
                    %mi ab
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A_T (X) \to A_T (X \times E^{ab} T)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mi ab
                  %mi T
                %annotation{:encoding => "application/x-tex"} E^{ab} T
            is a
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 0
                    %mo ⊂
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T_0 \subset T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi E
                    %mi ab
                  %mi T
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                %annotation{:encoding => "application/x-tex"} (E^{ab} T )^{T_0}
            is contractible and empty for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} T_0
            not Abelian. Further, for Borel equivariant cohomology we require
          %ol
            %li
              %p
                If
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mi e
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} T = \{e \}
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mi T
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi A
                          %mi X
                      %annotation{:encoding => "application/x-tex"} A_T(X) = A(X) = A^X
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi A
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi ET
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_T (X) \to A_T (X \times ET)
                is an isomorphism.
          %p
            %em Proof.
            In the case of ordinary equivariant cohomology we can use property (5) to reduce to the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            has only Abelian stabilizer groups. Then via (3) we reduce to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            being a colimit of
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi k
                  %mo ×
                  %mi T
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} D^k \times T/T_0
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} T_0
            Abelian. Via homotopy equivalence (1) we reduce to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi T
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi T
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X = T / T_0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi A
                      %mrow
                        %msub
                          %mi T
                          %mn 0
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_T (X) = A_{T_0} (*)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mover
                    %mi M
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi T
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A_{T_0} (*) = \hat M (*/T_0 )
