                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} U_f = \{x_f\} \times \prod_{g: g \neq f} \{0, 1\}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
