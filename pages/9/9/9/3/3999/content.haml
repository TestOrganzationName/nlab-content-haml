                    %mi f
                    %mo :
                    %mi ℕ
                    %mo →
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} f: \mathbb{N} \to 2
              that is not eventually constant on the subsequence
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mi k
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi k
                          %mo :
                          %mi ℕ
                    %annotation{:encoding => "application/x-tex"} (n_k)_{k: \mathbb{N}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℕ
                    %mo →
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} f: \mathbb{N} \to 2
              by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi k
                      %mspace{:width => "thickmathspace"}
                      %mi mod
                      %mspace{:width => "thickmathspace"}
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} f(n_k) = k\; mod\; 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f(n) = 0
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              does not appear in the subsequence. Consider the open set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
