                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ⊣
                      %mi coDisc
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Gamma \dashv coDisc)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
