              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is both a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              as well as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %a.existingWikiWord{:href => "/nlab/show/epimorphisms"} epimorphisms
              as well as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              factorizations. This implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %msubsup
                      %mi η
                      %mi X
                      %mi conc
                  %annotation{:encoding => "application/x-tex"} \Gamma \eta^{conc}_X
              is the epimorphism onto the image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi η
                        %mi X
                        %mo ♯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma( \eta^\sharp_X )
              %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotency
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♯
                    %annotation{:encoding => "application/x-tex"} \sharp
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p
              Therefore the equality in
              %a.maruku-eqref{:href => "#eq:ConcNatur"} (2)
              says that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi η
                              %mi X
                              %mo ♯
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mi iso
                              %mo ∘
                              %msubsup
                                %mi η
                                %mrow
                                  %mi im
                                  %mo{:stretchy => "false"} (
                                  %msubsup
                                    %mi η
                                    %mi X
                                    %mo ♯
                                  %mo{:stretchy => "false"} )
                                %mo ♯
                              %mo )
                            %mo ∘
                            %msubsup
                              %mi η
                              %mi X
                              %mi conc
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi mono
                            %mo ∘
                            %msubsup
                              %mi η
                              %mi X
                              %mi conc
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\eta^\sharp_{ X }
                    \&amp; =
                    \\left(
                    iso \circ \eta^{\sharp}_{ im(\eta^\sharp_X)}
                    \\right)
                    \\circ
                    \\eta^{conc}_X
                    \\\
                    \&amp; =
                    mono \circ \eta^{conc}_X
                    \\,,
                    \\end{aligned}
            %p
              where in the second line we remembered that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi η
                      %mi X
                      %mi conc
                  %annotation{:encoding => "application/x-tex"} \eta^{conc}_X
              is, by definition, the epimorphism in the epi/mono-factorization of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi η
                        %mi X
                        %mo ♯
                    %annotation{:encoding => "application/x-tex"} \eta^\sharp_X
            %p Now the defining property of epimorphisms allows to cancel this commmon factor on both sides, which yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi η
                      %mrow
                        %mi im
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi η
                          %mi X
                          %mo ♯
                        %mo{:stretchy => "false"} )
                      %mo ♯
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi iso
                    %mo ∘
                    %mi mono
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi mono
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta^{\sharp}_{ im(\eta^\sharp_X) }
                    \\;=\;
                    iso \circ mono
                    \\;=\;
                    mono.
            %p
              This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi conc
                    %mi X
                    %mo ≔
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi η
                      %mi X
                      %mo ♯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} conc X \coloneqq im(\eta^\sharp_X)
              is indeed concrete.
            %p
              It remains to show that this construction is
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to the inclusion. We claim that the
              %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi conc
                    %mo ⊣
                    %msub
                      %mi ι
                      %mi conc
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (conc \dashv \iota_{conc})
              is provided by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi η
                      %mi conc
                  %annotation{:encoding => "application/x-tex"} \eta^{conc}
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:ConcretificationUnitFromEpiMonoFactorization"} (1)
            %p
              To see this, first notice that, since the
              %a.existingWikiWord{:href => "/nlab/show/%28epi%2C+mono%29+factorization+system"} epi/mono-factorization
              is
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system"} orthogonal
              and hence
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/functorial+factorization"} functorial
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagrams"} commuting diagrams
              of the form
            #eq:NaturalitySquareForConcretificationUnit.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %munderover
                              %mo ⟶
                              %mi epi
                              %mrow
                                %msubsup
                                  %mi η
                                  %mrow
                                    %msub
                                      %mi X
                                      %mn 1
                                  %mi conc
                          %mtd
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi η
                              %mrow
                                %msub
                                  %mi X
                                  %mn 1
                              %mo ♯
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mi mono
                          %mtd
                            %mo ♯
                            %msub
                              %mi X
                              %mn 1
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                          %mtd
                            %munderover
                              %mo ⟶
                              %mi epi
                              %mrow
                                %msubsup
                                  %mi η
                                  %mrow
                                    %msub
                                      %mi X
                                      %mn 2
                                  %mi conc
                          %mtd
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi η
                              %mrow
                                %msub
                                  %mi X
                                  %mn 2
                              %mo ♯
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mi mono
                          %mtd
                            %mo ♯
                            %msub
                              %mi X
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_1
                    \&amp;\underoverset{epi}{\eta^{conc}_{X_1}}{\longrightarrow}&amp;
                    im(\eta^\sharp_{X_1})
                    \&amp;\underset{mono}{\longrightarrow}&amp;
                    \\sharp X_1
                    \\\
                    \\big\downarrow &amp;&amp; \big\downarrow &amp;&amp; \big\downarrow
                    \\\
                    X_2
                    \&amp;\underoverset{epi}{\eta^{conc}_{X_2}}{\longrightarrow}&amp;
                    im(\eta^\sharp_{X_2})
                    \&amp;\underset{mono}{\longrightarrow}&amp;
                    \\sharp X_2
                    }
            %p
              Now to demonstrate the adjunction, it is sufficient, to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi η
                      %mi conc
                  %annotation{:encoding => "application/x-tex"} \eta^{conc}
              is a
              %a.existingWikiWord{:href => "/nlab/show/universal+morphism"} universal morphism
              in the sense discussed at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
                      %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X_1 \to X_2
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 2
                      %mo ∈
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi conc
                      %mo ↪
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} X_2 \in \mathbf{H}_{conc} \hookrightarrow \mathbf{H}
              %em top left triangle
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AA
                                %mi f
                                %mphantom
                                  %mi AA
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi epi
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi η
                                    %mrow
                                      %msub
                                        %mi X
                                        %mn 1
                                    %mi conc
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∃
                                  %mo !
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mi mono
                        %mtr
                          %mtd
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi η
                              %mrow
                                %msub
                                  %mi X
                                  %mn 1
                              %mo ♯
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                          %mtd
                            %mo ♯
                            %msub
                              %mi X
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_1
                    \&amp;\overset{\phantom{AA} f \phantom{AA}}{\longrightarrow}&amp;
                    X_2
                    \\\
                    {}^{\mathllap{epi}}\big\downarrow^{\mathrlap{\eta^{conc}_{X_1}}}
                    \&amp;{}^{\mathllap{\exists !}}\nearrow&amp;
                    \\big\downarrow^{\mathrlap{mono}}
                    \\\
                    im(\eta^\sharp_{X_1})
                    \&amp;\underset{}{\longrightarrow}&amp;
                    \\sharp X_2
                    }
            %p
              Now, from
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:NaturalitySquareForConcretificationUnit"} (3)
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              as shown. Here the left morphism is an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              by construction, while the right morphism is a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              by assumption on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} X_2
              %a.existingWikiWord{:href => "/nlab/show/%28epi%2C+mono%29+factorization+system"} epi/mono-factorization
              says that there is a diagonal
              %a.existingWikiWord{:href => "/nlab/show/lift"} lift
              which makes
              %em both
              triangles
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commute
            %p
              It remains to see that the lift is unique with just the property of making the top left triangle commute. But this is equivalently the statement that the left morphism is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
          %h3#FurtherProperties Further properties
          %p
          #CohesiveMapsToConcreteObjectsGlue.num_prop
            %h6 Proposition
            %p
              %strong (cohesive maps to concrete objects glue)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"}
                  cohesive
                  = succeed "-topos" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %msub
                          %mo ♯
                          %mn 1
                    %mover
                      %mo ↪
                      %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} Y \,\in\, \mathbf{H}_{\sharp_1} \xhookrightarrow{\;} \mathbf{H}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/concrete+object"} concrete object
              %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
              %a.existingWikiWord{:href => "/nlab/show/unit+of+a+monad"} unit
              is
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+of+an+%28infinity%2C1%29-category"} (-1)-truncated
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism+in+an+%28infinity%2C1%29-category"} monomorphic
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mover
                        %mo ↪
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %msubsup
                            %mi η
                            %mi Y
                            %mo ♯
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                      %mo ♯
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y \xhookrightarrow{ \;\;\eta^\sharp_Y\;\; } \sharp Y
              %em
                cohesive maps to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                glue
              (satisfy the respective sheaf property):
            %p
              For any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} Y \,\in\, \mathbf{H}
              and any open cover, namely any
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/n-connected+object+of+an+%28infinity%2C1%29-topos"} (-1)-connected
              %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28infinity%2C1%29-category"} effective epi-morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ↠
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U \twoheadrightarrow X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \xrightarrow{\;} X
              whose maps of
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              = succeed "-groupoids" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              as cohesive maps, in an essentially unique way, in that all solid
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              %a.existingWikiWord{:href => "/nlab/show/commutative+square"} commutative square
              as follows have essentially unique dashed lifts:
            %svg{:height => "82.731", :viewbox => "0 0 92.857 82.731", :width => "92.857", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
              %defs
                %g
