                        %mi X
                        %mi β
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S \subseteq i_\beta(X_\beta)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is closed, because closure of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊆
                    %msub
                      %mi i
                      %mi β
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi β
                    %mo{:stretchy => "false"} )
