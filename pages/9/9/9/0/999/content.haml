                    %mrow
                      %msub
                        %mi α
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \alpha_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              be the set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi x
                        %mi n
                      %mo :
                      %mi n
                      %mo ∈
                      %mi ℕ
                      %mo{:stretchy => "false"} }
