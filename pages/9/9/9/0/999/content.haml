              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mn 1
                    %mo &lt;
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \alpha_1 \lt \kappa
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 0
                      %mo ∈
                      %msub
                        %mi i
                        %mrow
                          %msub
                            %mi α
                            %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mrow
                          %msub
                            %mi α
                            %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x_0 \in i_{\alpha_1}(X_{\alpha_1})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi n
                    %mo ∈
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x_n \in f(Y)
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi n
                      %mo ∉
                      %msub
                        %mi i
                        %mrow
                          %msub
                            %mi α
                            %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mrow
                          %msub
                            %mi α
                            %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x_n \notin i_{\alpha_n}(X_{\alpha_n})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \alpha_{n+1}
              be the minimal ordinal such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi n
                      %mo ∈
                      %msub
                        %mi i
                        %mrow
                          %msub
                            %mi α
                            %mrow
