                  %annotation{:encoding => "application/x-tex"} Y \in Top
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} hom(Y,-)
              preserves colimits of functors mapping out of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/limit+ordinals"} limit ordinals
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi α
                    %mo →
                    %msub
                      %mi X
                      %mi β
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    X_\alpha \rightarrow X_\beta,
            %p
              are
              %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed
              inclusions of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/separation+axiom"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} T_1
                  \-spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi β
                  %annotation{:encoding => "application/x-tex"} X_\beta
              is the colimit of earlier
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi α
                  %annotation{:encoding => "application/x-tex"} X_\alpha
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              is itself a limit ordinal.
          %p
            This applies for example to the sequence of inclusions of
            = succeed "-skeleta" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo =
                  %msup
                    %mi S
                    %mi k
                %annotation{:encoding => "application/x-tex"} Y=S^k
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %msup
                      %mi S
                      %mi k
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} Y = S^k \times I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi k
                %annotation{:encoding => "application/x-tex"} \pi_k
            also preserves colimits of such sequences. Applications also occur in the theory of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi EO
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} EO(n)
            of the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n)
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
            can be constructed as the colimit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi colim
                    %mrow
                      %mi k
                      %mo →
                      %mn ∞
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi V
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi n
                      %mo +
                      %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \underset{k \to \infty}{colim} \; V_n(\mathbb{R}^{n+k})
            of
            %a.existingWikiWord{:href => "/nlab/show/Stiefel+manifolds"} Stiefel manifolds
            of orthonormal
            = succeed "-frames" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+k}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi EO
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} EO(n)
            is weakly contractible, it suffices, by this result, to show that for each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi j
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msup
