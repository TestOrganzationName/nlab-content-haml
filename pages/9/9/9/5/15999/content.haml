          %p
            The abstract picture behind this cohomological
            %a.existingWikiWord{:href => "/nlab/show/motivic+quantization"} motivic quantization
            is discussed at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/dependent+linear+type+theory"} dependent linear type theory
            = succeed "-quantization." do
              %a.existingWikiWord{:href => "/nlab/show/KU"} KU
          %h2#kutheory KU-theory
          %h3#twisted_kucohomology_of_manifolds Twisted KU-cohomology of manifolds
          %p
            (
            %a{:href => "twisted+K-theory#Rosenberg89"}> Rosenberg 04
            ,
            = succeed ")," do
              %a{:href => "twisted+K-theory#AtiyahSegal04"} Atiyah-Segal 04
            = succeed ")" do
              %a{:href => "#Nuiten"} Nuiten section 3.2.1
          %h3#twisted_kucohomology_of_smooth_local_quotient_stacks Twisted KU-cohomology of smooth local quotient stacks
          %p
            (
            %a{:href => "#FHT"}> FHT I
            ), reviewed in (
            %a{:href => "#Nuiten"}> Nuiten section 3.3.2
            )
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 0
                %annotation{:encoding => "application/x-tex"} H_0
            for the
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2\mathbb{Z}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/separable+Hilbert+space"} separable Hilbert space
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              with
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+bundle"} Hilbert bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ≔
                    %mi X
                    %mo ×
                    %msub
                      %mi H
                      %mn 0
                    %mo ⊗
                    %msup
                      %mi L
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    E \coloneqq X \times H_0 \otimes L^2(G) \to X
            %p
              equipped with the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L^2(G)
              by pullback along the right
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi K
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mi Fred
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    K^\bullet(X//G)
                    \\simeq
                    \\Gamma(X, Fred^\bullet(E))
                    \\,.
          %h3#twisted_integration_with_kucoefficients Twisted integration with KU-coefficients
          %p
