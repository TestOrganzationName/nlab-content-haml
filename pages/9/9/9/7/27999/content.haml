            of the
            %a.existingWikiWord{:href => "/nlab/show/crystal"} crystalline
            material, acting on
            %a.existingWikiWord{:href => "/nlab/show/crystal+momenta"} crystal momenta
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
