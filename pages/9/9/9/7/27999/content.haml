              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            %a.existingWikiWord{:href => "/nlab/show/valence+bands"} valence bands
            are filled and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            %a.existingWikiWord{:href => "/nlab/show/conduction+bands"} conduction bands
            are accessible are given by the
            %a.existingWikiWord{:href => "/nlab/show/equivariant+map"} equivariant
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of maps from the
            %a.existingWikiWord{:href => "/nlab/show/Brillouin+torus"} Brillouin torus
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Proj
                      %mi v
                      %mrow
                        %mi c
                        %mo +
                        %mi v
                    %mo =
                    %msubsup
                      %mi Gr
                      %mi v
                      %mrow
                        %mi c
                        %mo +
                        %mi v
                  %annotation{:encoding => "application/x-tex"} Proj_{v}^{c+v} = Gr_{v}^{c+v}
            %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
            of the
            %a.existingWikiWord{:href => "/nlab/show/Brillouin+torus"} Brillouin torus
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
