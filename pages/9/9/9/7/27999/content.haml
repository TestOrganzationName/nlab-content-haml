          %p
            such that the
            %a.existingWikiWord{:href => "/nlab/show/Bloch+Hamiltonian"} Bloch Hamiltonian
            satisfies
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mrow
