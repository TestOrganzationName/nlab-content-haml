          %h2#idea Idea
          %p
            A (binary)
            %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            on a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is called
            %em well-founded
            if it is valid to do
            %a.existingWikiWord{:href => "/nlab/show/induction"} induction
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %h2#defn Definitions
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            be a
            %a.existingWikiWord{:href => "/nlab/show/binary+relation"} binary relation
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ≺
                  %annotation{:encoding => "application/x-tex"} \prec
              \-inductive
            if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mo ∀
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:lspace => "verythinmathspace"} :
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mi t
                  %mo ≺
                  %mi x
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %mi t
                  %mo ∈
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %mi x
                  %mo ∈
                  %mi A
                  %mo .
                %annotation{:encoding => "application/x-tex"} \forall (x\colon S),\; (\forall (t\colon S),\; t \prec x \;\Rightarrow\; t \in A) \;\Rightarrow\; x \in A.
          %p
            The relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            is
            %strong well-founded
            if the only
            = succeed "-inductive" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≺
                  %annotation{:encoding => "application/x-tex"} \prec
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            itself.
          %p
            Note that this is precisely what is necessary to validate induction over
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≺
                  %annotation{:encoding => "application/x-tex"} \prec
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            whenever it is true of everything that precedes (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            )
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            it is equivalent to other commonly stated definitions; see
            %em Formulations in classical logic
            below.
          %h3#formulations_in_classical_logic Formulations in classical logic
          %p
            While the definition above follows how a well-founded relation is generally
            %em used
            (namely, to prove properties of elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            by induction), it is complicated. Two alternative formulations are given by the following:
          %ol
            %li
              %p
                The relation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≺
                    %annotation{:encoding => "application/x-tex"} \prec
                has
                %strong no infinite descent
                (usually attributed to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Pierre+de+Fermat"} Pierre de Fermat
                %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ⋯
                      %mo ≺
                      %msub
                        %mi x
                        %mn 2
                      %mo ≺
                      %msub
                        %mi x
                        %mn 1
                      %mo ≺
                      %msub
                        %mi x
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \cdots \prec x_2 \prec x_1 \prec x_0
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                = succeed ".)" do
                  %em infinite descending sequence
            %li
              %p
                The relation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≺
                    %annotation{:encoding => "application/x-tex"} \prec
                is
                %strong classically well-founded
                if every
                %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
                subset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                has a member
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x \in A
                such that no
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} t \in A
                satisfies
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ≺
                        %mi x
                      %annotation{:encoding => "application/x-tex"} t \prec x
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                is called a
                %em minimal
                element of
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            = succeed ")," do
              %a.maruku-ref{:href => "#empty"}
            = succeed ")," do
              %a.maruku-ref{:href => "#classical"}
          %p The classical notion of well-foundedness enforces classical logic onto us, in the following sense.
          #LEM.num_prop
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ≺
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \prec)
              is an
              %a.existingWikiWord{:href => "/nlab/show/inhabited+subset"} inhabited
              well-founded relation in a classical sense, then the unrestricted
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} law of excluded middle
              holds.
          %p
            For a
            = succeed "-theoretic" do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "." do
              %a{:href => "http://ncatlab.org/toddtrimble/published/classical+well-foundedness"} here
          .proof
            %h6#proof Proof
            %p
              Suppose there are
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ≺
                      %mi x
                    %annotation{:encoding => "application/x-tex"} y\prec x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              be an arbitrary proposition. Consider then a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \subset X
              defined as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi a
                      %mo ≺
                      %mi x
                      %mspace{:width => "thickmathspace"}
                      %mo ∧
                      %mspace{:width => "thickmathspace"}
                      %mi Q
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} P = \{ x \} \cup \{ a \mid a \prec x \;\wedge\; Q\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is inhabited, thus by classical well-foundedness it has a minimal element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} x_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x_0
              is in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{ x \}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 0
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x_0 = x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 0
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi a
                      %mo ≺
                      %mi x
                      %mspace{:width => "thickmathspace"}
                      %mo ∧
                      %mspace{:width => "thickmathspace"}
                      %mi Q
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} x_0 \in \{ a \mid a \prec x \;\wedge\; Q\}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 0
                      %mo ≺
                      %mi x
                      %mspace{:width => "thickmathspace"}
                      %mo ∧
                      %mspace{:width => "thickmathspace"}
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} x_0 \prec x \;\wedge\; Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              holds. So, suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x_0 = x
              is the minimal element of
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} \neg Q
              holds. For suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              holds; then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi P
                  %annotation{:encoding => "application/x-tex"} y \in P
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ≺
                      %mi x
                      %mo =
                      %msub
                        %mi x
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} y \prec x = x_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x_0
              is a minimal element of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              was an arbitrary proposition, we can deduce
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∀
                      %mi Q
                      %mo .
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo ∨
                      %mo ¬
                      %mi Q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \forall Q. (Q \vee \neg Q)
          #LEM_rem.num_remark
            %h6#remark Remark
            %p
              We note that classical well-foundedness is really too strong for constructive (i.e., intuitionistic) mathematics, due to Proposition
              = succeed "." do
                %a.maruku-ref{:href => "#LEM"}
          %p
            Note however that in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} predicative mathematics
          %p
            Even in constructive predicative mathematics, (1) is strong enough to establish the
            %a.existingWikiWord{:href => "/nlab/show/Burali-Forti+paradox"} Burali-Forti paradox
            (when applied to
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/linear+orders"} linear orders
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+foundation"} axiom of foundation
          %p To round out the discussion we prove the following two results, both valid in intuitionistic mathematics:
          #empty.num_prop
            %h6#proposition_2 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ≺
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \prec)
              is a well-founded relation and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \subseteq X
              has no minimal element, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is empty.
          %p This result makes it trivial to infer (under classical logic) that classical well-foundedness is a consequence of well-foundedness. It also shows that well-foundedness rules out infinite descent (intuitionistically), since an infinite descent sequence has no minimal element.
          .proof
            %h6#proof_2 Proof
            %p
              Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi u
                      %mo ∈
                      %mi X
                      %mo :
                      %mi u
                      %mo ∉
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mo ∧
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mo ∀
                      %mi x
                      %mo :
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi x
                      %mo ≺
                      %mi u
                      %mo ⇒
                      %mi x
                      %mo ∉
                      %mi A
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} U = \{u \in X: u \notin A\; \wedge \; (\forall x: X),\; x \prec u \Rightarrow x \notin A\}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∩
                      %mi A
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} U \cap A = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is inductive, so that under well-foundedness
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U = X
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %mi X
                      %mo ∩
                      %mi A
                      %mo =
                      %mi U
                      %mo ∩
                      %mi A
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} A = X \cap A = U \cap A = \emptyset
            %p
              So, suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              is an element such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} y \in U
              whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ≺
                      %mi z
                    %annotation{:encoding => "application/x-tex"} y \prec z
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} z \in U
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ∉
                      %mi A
                    %annotation{:encoding => "application/x-tex"} z \notin A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} z \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              would be a minimal element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              (as
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ≺
                      %mi z
                      %mo ⇒
                      %mi y
                      %mo ∈
                      %mi U
                      %mo ⇒
                      %mi y
                      %mo ∉
                      %mi A
                    %annotation{:encoding => "application/x-tex"} y \prec z \Rightarrow y \in U \Rightarrow y \notin A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              has no minimal element.
            %p
              Thus
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ∉
                      %mi A
                    %annotation{:encoding => "application/x-tex"} z \notin A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ≺
                      %mi z
                      %mo ⇒
                      %mi y
                      %mo ∈
                      %mi U
                      %mo ⇒
                      %mi y
                      %mo ∉
                      %mi A
                    %annotation{:encoding => "application/x-tex"} y \prec z \Rightarrow y \in U \Rightarrow y \notin A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} z \in U
          #classical.num_prop
            %h6#proposition_3 Proposition
            %p In intuitionistic set theory, classical well-foundedness implies (inductive) well-foundedness.
          .proof
            %h6#proof_3 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≺
                  %annotation{:encoding => "application/x-tex"} \prec
              be a classically well-founded relation on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              be an inductive subset. We must show that every element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              belongs to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is inductive, it suffices to show that every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ≺
                    %mi x
                  %annotation{:encoding => "application/x-tex"} u \prec x
              belongs to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ≺
                    %mi x
                  %annotation{:encoding => "application/x-tex"} u\prec x
              and show
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} u\in U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≺
                  %annotation{:encoding => "application/x-tex"} \prec
              is inhabited, so according to Remark
              = succeed "," do
                %a.maruku-ref{:href => "#LEM"}
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
              follows and we might as well then argue classically. The argument is well-known but we include it for completeness: under classical well-foundedness, if an inductive subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is not the entirety of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \neg U
              has a minimal element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ≺
                    %mi y
                  %annotation{:encoding => "application/x-tex"} v \prec y
              implies
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ∈
                      %mo ¬
                      %mo ¬
                      %mi U
                      %mo =
                      %mi U
                    %annotation{:encoding => "application/x-tex"} v \in \neg\neg U = U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} y \in U
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is inductive, contradiction. Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U = X
              and in particular
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} u \in U
          %p
            To bring us full circle: in classical set theory we may prove that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo ≺
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \prec)
            has no infinite descent, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            is classically well-founded. For suppose an inhabited subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ⊆
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \subseteq X
            (say with an element
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi P
                  %annotation{:encoding => "application/x-tex"} x \in P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi n
                  %mo ∈
                  %mi P
                %annotation{:encoding => "application/x-tex"} x_n \in P
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x_0 = x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo ∈
                  %mi P
                %annotation{:encoding => "application/x-tex"} x_{n+1} \in P
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ≺
                    %msub
                      %mi x
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x_{n+1} \prec x_n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+choice"} dependent choice
          %h3#coalgebraic_formulation Coalgebraic formulation
          %p
            Many inductive or recursive notions may also be packaged in
            %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebraic
            terms. For the concept of well-founded relation, first observe that a binary relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            on a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the same as a coalgebra structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \theta\colon X \to P(X)
            for the covariant
            %a.existingWikiWord{:href => "/nlab/show/power-set"} power-set
            endofunctor on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ≺
                  %mi x
                %annotation{:encoding => "application/x-tex"} y \prec x
            if and only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y \in \theta(x)
          %p
            In this language, a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mi U
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} i\colon U \hookrightarrow X
            is
            = succeed "-inductive," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≺
                  %annotation{:encoding => "application/x-tex"} \prec
            = succeed "-inductive," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi H
                        %mtd
                          %mover
                            %mo →
                            %mi j
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi θ
                      %mtr
                        %mtd
                          %mi P
                          %mi U
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %mi P
                              %mi i
                        %mtd
                          %mi P
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  H &amp; \stackrel{j}{\to} &amp; X \\
                  \\downarrow &amp; &amp; \downarrow^\mathrlap{\theta} \\
                  P U &amp; \underset{P i}{\to} &amp; P X
                  }
          %p
            the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            factors through
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            is necessarily
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            preserves monos.) Unpacking this a bit: for any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi V
                %annotation{:encoding => "application/x-tex"} \theta(x) = V
            belongs to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi U
                  %annotation{:encoding => "application/x-tex"} P U
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \theta(x) \subseteq U
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} x \in U
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∀
                      %mrow
                        %mi x
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∀
                      %mrow
                        %mi y
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                    %mi y
                    %mo ≺
                    %mi x
                    %mo ⇒
                    %mi y
                    %mo ∈
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mi x
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \forall_{x\colon X} (\forall_{y\colon X} y \prec x \Rightarrow y \in U) \Rightarrow x \in U
          %p
            Then, as usual, the
            = succeed "-coalgebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi θ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \theta)
            is well-founded if every
            = succeed "-inductive" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \hookrightarrow X
            is all of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Other relevant notions may also be packaged; for example, the
            = succeed "-coalgebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %a.existingWikiWord{:href => "/nlab/show/extensional+relation"} extensional
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi P
                  %mi X
                %annotation{:encoding => "application/x-tex"} \theta\colon X \to P X
            is monic. See also
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/well-founded+coalgebra"} well-founded coalgebra
          %h3#simulations Simulations
          %p
            Given two sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≺
                  %annotation{:encoding => "application/x-tex"} \prec
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi S
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} f\colon S \to T
            is a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/simulation"} simulation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            if
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≺
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(x) \prec f(y)
                whenever
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≺
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \prec y
                and
            %li
              %p
                given
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ≺
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} t \prec f(x)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ≺
                      %mi x
                    %annotation{:encoding => "application/x-tex"} y \prec x
                with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo =
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} t = f(y)
          %p
            Then sets so equipped form a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with simulations as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            %a.existingWikiWord{:href => "/nlab/show/extensional+relation"} extensional relation
            for more uses of simulations.
          %p
            For example, a simulation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \to Y
            between two
            %a.existingWikiWord{:href => "/nlab/show/well-ordered+sets"} well-ordered sets
            is an isomorphism of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            onto an
            %a.existingWikiWord{:href => "/nlab/show/lower+set"} initial segment
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          %p
            In coalgebraic language, a simulation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} S \to T
            is simply a
            = succeed "-coalgebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} f\colon S \to T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is merely
            = succeed "-preserving," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≺
                  %annotation{:encoding => "application/x-tex"} \prec
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a
            %a.existingWikiWord{:href => "/nlab/show/colax+morphism"} colax morphism
            of coalgebras, in the sense that there is an inclusion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi θ
                                %mi X
                        %mtd
                          %mi P
                          %mi X
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi f
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi P
                                %mi f
                      %mtr
                        %mtd
                          %mi Y
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %msub
                                %mi θ
                                %mi Y
                        %mtd
                          %mi P
                          %mi Y
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp; \stackrel{\theta_X}{\to} &amp; P X \\
                  ^\mathllap{f} \downarrow &amp; \swArrow &amp; \downarrow^\mathrlap{P f} \\
                  Y &amp; \underset{\theta_Y}{\to} &amp; P Y.
                  }
          .num_prop
            %h6#proposition_4 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ≺
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \prec)
              is well-founded and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mo ≺
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y, \prec)
              is (weakly) extensional, then there is at most one simulation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f: X \to Y
          .proof
            %h6#proof_4 Proof
            %p
              It is enough to show that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f, g: X \to Y
              are
              = succeed "-coalgebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi u
                    %mo ∈
                    %mi X
                    %mo :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U = \{u \in X: f(u) = g(u)\}
              is an inductive subset. Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} y \in X
              is an element such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(u) = g(u)
              whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ≺
                      %mi y
                    %annotation{:encoding => "application/x-tex"} u \prec y
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mi u
                      %mo :
                      %mi u
                      %mo ≺
                      %mi y
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mi u
                      %mo :
                      %mi u
                      %mo ≺
                      %mi y
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(\{u: u \prec y\}) = g(\{u: u \prec y\})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f, g
              are
              = succeed "-coalgebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo :
                      %mi x
                      %mo ≺
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo :
                      %mi x
                      %mo ≺
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{x: x \prec f(y)\} = \{x: x \prec g(y)\}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(y) = g(y)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} y \in U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is inductive.
          %h2#properties Properties
          %p
            Every well-founded relation is
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/irreflexive+relation"} irreflexive
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊀
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x \nprec x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⪯
                %annotation{:encoding => "application/x-tex"} \preceq
            of a well-founded relation; let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⪯
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \preceq y
            if and only
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≺
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \prec y
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x = y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            be a minimal element of a subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            states that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ⪯
                  %mi x
                %annotation{:encoding => "application/x-tex"} t \preceq x
            only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} t = x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            rather than
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⪯
                  %annotation{:encoding => "application/x-tex"} \preceq
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/well-order"} well order
            may be defined as a well-founded
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/linear+order"} linear order
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} transitive
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/extensional+relation"} extensional
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/well-quasi-order"} well-quasi-order
            is a well-founded
            %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
            (referring to the reflexive version of well-foundedness above) that in addition has no infinite
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/antichain"} antichains
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+foundation"} axiom of foundation
            in material
            %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            states precisely that the membership relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} \in
            on the proper class of all
            %a.existingWikiWord{:href => "/nlab/show/pure+sets"} pure sets
            is well-founded. In structural set theory, accordingly, one uses well-founded relations in building structural models of well-founded pure sets.
          %h2#examples Examples
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            whose
            %a.existingWikiWord{:href => "/nlab/show/transitive+closure"} transitive closure
            is irreflexive is well-founded.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be the set of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≺
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \prec y
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            is the
            %a.existingWikiWord{:href => "/nlab/show/successor"} successor
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo =
                    %mi x
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} y = x + 1
            = succeed "." do
              %em mathematical induction
          %p
            Again let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be the set of natural numbers, but now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≺
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \prec y
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo &lt;
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \lt y
            in the usual order. That this relation is well-founded is the principle of
            = succeed "." do
              %em strong induction
          %p
            More generally, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be a set of
            %a.existingWikiWord{:href => "/nlab/show/ordinal+numbers"} ordinal numbers
            (or even the proper class of all ordinal numbers), and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≺
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \prec y
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo &lt;
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \lt y
            in the usual order. That this relation is well-founded is the principle of
            = succeed "." do
              %em transfinite induction
          %p
            Similarly, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be a set of
            %a.existingWikiWord{:href => "/nlab/show/pure+sets"} pure sets
            (or even the proper class of all pure sets), and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≺
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \prec y
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \in y
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+foundation"} axiom of foundation
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be the set of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≺
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \prec y
            mean that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            properly divides
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo{:stretchy => "false"} /
                  %mi x
                %annotation{:encoding => "application/x-tex"} y/x
            is an integer other than
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ±
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \pm{1}
