          %h2#references References
          %p Survey:
          %ul
            %li
              Mohamed Elhamdadi, Mustafa Hajij, Kyle Istvan:
              = succeed "," do
                %em Framed Knots
              %strong 42
              (2020) 7–22 &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/s00283-020-09990-0"}> doi:10.1007/s00283-020-09990-0
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/1910.10257"} arXiv:1910.10257
          %p Textbooks:
          %ul
            %li#Ohtsuki01
              %a.existingWikiWord{:href => "/nlab/show/Tomotada+Ohtsuki"}> Tomotada Ohtsuki
              , pp. 15 in:
              = succeed "," do
                %em Quantum Invariants – A Study of Knots, 3-Manifolds, and Their Sets
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1142/4746"} doi:10.1142/4746
          %p Lecture notes:
          %ul
