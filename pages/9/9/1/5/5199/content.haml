                = succeed "&rbrack;" do
                  %a{:href => "https://archive.bridgesmathart.org/2022/bridges2022-245.pdf"} pdf
          %p
            Discussion of framed links in the context of regularizing
            %a.existingWikiWord{:href => "/nlab/show/Wilson+loop"} Wilson loop
