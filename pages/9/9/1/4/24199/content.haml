                  %annotation{:encoding => "application/x-tex"} d^3 : H_{n,s}(\pi_\ast(X_\ast)) \to H_{n-1,s+2}(\pi_\ast(X_\ast))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mrow
                      %mi n
                      %mo ,
                      %mi s
                  %mo{:stretchy => "false"} (
