                        %mi n
                        %mo ,
                        %mi s
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
