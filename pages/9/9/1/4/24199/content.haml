                    %msup
                      %mi d
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} d^2
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi d
                      %mn 3
                    %mo :
                    %msub
                      %mi H
