            %em chain complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi d
                        %mn 2
                  %msub
                    %mi π
                    %mi n
