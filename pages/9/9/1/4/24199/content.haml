                  %mi X
                  %mo ;
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo ≡
                  %mo{:stretchy => "false"} ‖
                  %mi X
                  %mo →
                  %msup
                    %mi Ω
                    %mrow
                      %mi k
                      %mo −
                      %mi n
