                  %annotation{:encoding => "application/x-tex"} r \ge max(T-s+4,s-R+1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %msubsup
                    %mi E
                    %mrow
                      %mi n
                      %mo −
                      %mi s
                      %mo ,
                      %mi s
                    %mn ∞
                  %mo →
                  %msub
                    %mi B
                    %mrow
                      %mi n
                      %mo ,
                      %mi s
                  %mo →
                  %msub
                    %mi B
                    %mrow
                      %mi n
                      %mo ,
                      %mi s
                      %mo −
                      %mn 1
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0 \to E^\infty_{n-s,s} \to B_{n,s} \to B_{n,s-1} \to 0
          %p
            which is the extension that we wanted.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo □
                %annotation{:encoding => "application/x-tex"} \Box
          %p
            This is all very abstract, so let’s look at a couple of degenerate cases. First, in the case of a finite iterated fibration sequence with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} T=1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mn 1
                          %mo →
                          %mi Y
                          %mo →
                          %msub
                            %mi X
                            %mn 0
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mn 0
                          %mo →
                          %msub
                            %mi X
                            %mn 0
                          %mo →
                          %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X_1 \to Y \to X_0\\
                  X_0 \to X_0 \to \ast
                  }
          %p
            hence essentially just a single fibration sequence. The spectral sequence is confined to the strip
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} q\in \{0,1\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E^2
            page looking like:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %msub
                            %mi π
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi π
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi π
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mi ⋯
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %mn 0
                        %mtd
                          %msub
                            %mi π
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi π
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\cdots &amp; \pi_0(X_1) &amp; \pi_1(X_1) &amp; \pi_2(X_1) &amp; \pi_3(X_1) &amp; \cdots \\
                  \\cdots &amp; 0 &amp; \pi_0(X_0) &amp; \pi_1(X_0) &amp; \pi_2(X_0) &amp; \cdots
                  }
          %p
            The differentials on this page go, as always, left two and up one, hence from
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(X_0) \to \pi_{n-1}(X_1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \delta_n
            in the ordinary LES of the fibration. Since the differentials entering
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_n(X_0)
            come from zero, and those leaving
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_n(X_1)
            go to zero, on passage to homology we get the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mn 3
                %annotation{:encoding => "application/x-tex"} E^3
            page
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %mi im
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi δ
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mi im
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi δ
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mi im
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi δ
                            %mn 3
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mi im
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi δ
                            %mn 4
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mi ⋯
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %mn 0
                        %mtd
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi δ
                            %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi δ
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi δ
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\cdots &amp; im(\delta_1) &amp; im(\delta_2) &amp; im(\delta_3) &amp; im(\delta_4) &amp; \cdots \\
                  \\cdots &amp; 0 &amp; ker(\delta_0) &amp; ker(\delta_1) &amp; ker(\delta_2) &amp; \cdots
                  }
          %p
            We have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mn 3
                  %mo =
                  %msup
                    %mi E
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} E^3 = E^\infty
            since all the remaining differentials hit zero on one side or the other, so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mo ,
                      %mn 0
                    %mn ∞
                  %mo =
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi δ
                    %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E^\infty_{p,0} = ker(\delta_p)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                      %mn ∞
                    %mo =
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi δ
                      %mrow
                        %mi p
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^\infty_{p,1} = im(\delta_{p+2})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi im
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi δ
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} )
                          %mo →
                          %msub
                            %mi π
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi δ
                            %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi δ
                            %mi n
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi δ
                            %mi n
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  im(\delta_{n+1}) \to \pi_n(Y) \to ker(\delta_n)\\
                  ker(\delta_n) \to ker(\delta_n) \to 0
                  }
          %p which is just the ordinary extension we observed above as coming from an LES.
          %p
            Another degenerate case is when the iterated fibration sequence is the
            %em Postnikov tower
            of a space (or spectrum)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is an
            = succeed "-type," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \pi_n(Y)=0
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mi m
                  %annotation{:encoding => "application/x-tex"} n\gt m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≤
                  %mi m
                %annotation{:encoding => "application/x-tex"} n\le m
            we have an
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi Y
                        %mo{:stretchy => "false"} ‖
                      %mi n
                  %annotation{:encoding => "application/x-tex"} {\Vert Y\Vert}_n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi n
                  %mo →
                  %msub
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi Y
                      %mo{:stretchy => "false"} ‖
                    %mi n
                  %mo →
                  %msub
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi Y
                      %mo{:stretchy => "false"} ‖
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} X_n \to {\Vert Y\Vert}_n \to {\Vert Y\Vert}_{n-1}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi n
                  %mo =
                  %mi K
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X_n = K(\pi_n(Y),n)
            is an Eilenberg-Mac Lane space, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_n(X_n) = \pi_n(Y)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \pi_i(X_n) = 0
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≠
                    %mi n
                  %annotation{:encoding => "application/x-tex"} i\neq n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is an
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is an
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi n
                %annotation{:encoding => "application/x-tex"} X_n
            is an Eilenberg-Mac Lane space of dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E^2
            page of the spectral sequence is concentrated on the line
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p=0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ⋮
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi ⋮
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\vdots \\
                  \\pi_2(Y)\\
                  \\pi_1(Y) \\
                  \\pi_0(Y)\\
                  \\vdots
                  }
          %p
            There is no room for any nontrivial differentials,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mn 2
                    %mo =
                    %msup
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E^2=E^\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            we obtain the trivial iterated extension
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mn 0
                          %mo →
                          %msub
                            %mi π
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo →
                          %msub
                            %mi π
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi ⋮
                      %mtr
                        %mtd
                          %mn 0
                          %mo →
                          %msub
                            %mi π
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo →
                          %msub
                            %mi π
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mi n
