                    %mi q
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %msub
                    %mi π
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E^2_{p,q} = \pi_{p+q}(X_q) \Rightarrow \pi_{p+q}(Y)
          %p The only homotopical input required was the long exact sequences of homotopy groups associated to the iterated fibration sequence, which as we’ve seen applies just as well to spectra as to types. After that, it was only homological algebra of abelian groups, which was fully constructive, and hence formalizable using sets in homotopy type theory, with higher inductive types for quotients and images.
          %p
            Part one was kind of light on examples, though. I mentioned the obvious example of an iterated fibration sequence, namely the Postnikov tower of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi K
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi π
                            %mi s
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi s
                          %mo{:stretchy => "false"} )
                          %mo →
                          %msub
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi Y
                              %mo{:stretchy => "false"} ‖
                            %mi s
                          %mo →
                          %msub
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi Y
                              %mo{:stretchy => "false"} ‖
                            %mrow
                              %mi s
                              %mo −
                              %mn 1
                      %mtr
                        %mtd
                          %mi K
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi π
                            %mrow
                              %mi s
                              %mo −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi s
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo →
                          %msub
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi Y
                              %mo{:stretchy => "false"} ‖
                            %mrow
                              %mi s
                              %mo −
                              %mn 1
                          %mo →
                          %msub
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi Y
                              %mo{:stretchy => "false"} ‖
                            %mrow
                              %mi s
                              %mo −
                              %mn 2
                      %mtr
                        %mtd
                          %mi ⋮
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  K(\pi_s(Y),s) \to {\Vert Y\Vert}_s \to {\Vert Y\Vert}_{s-1}\\
                  K(\pi_{s-1}(Y),s-1) \to {\Vert Y\Vert}_{s-1} \to {\Vert Y\Vert}_{s-2}\\
                  \\vdots
                  }
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is an
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo &lt;
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} m\lt \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} ‖
                  %mi Y
                  %msub
                    %mo{:stretchy => "false"} ‖
                    %mi s
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                %annotation{:encoding => "application/x-tex"} (\Vert Y \Vert_s)_n
            defined to be
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %msub
                      %mi Y
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %mi n
                        %mo +
                        %mi s
                  %annotation{:encoding => "application/x-tex"} \Vert Y_n\Vert_{n+s}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} s \in \mathbb{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ‖
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} ‖
                    %mi m
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \Vert X\Vert_{m} = \mathbf{1}
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo &lt;
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} m \lt  -1
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              \-type spectrum
            to be one for which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mi n
                %annotation{:encoding => "application/x-tex"} Y_n
            is an ordinary
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+m)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi m
                    %mo −
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \ge -m-2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            also satisfies our simple hypotheses for convergence despite potentially being infinite downwards (an
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                %annotation{:encoding => "application/x-tex"} \pi_n
            for all
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn ∞
                    %mo &lt;
                    %mi n
                    %mo ≤
                    %mi m
                  %annotation{:encoding => "application/x-tex"} -\infty \lt  n \le m
          %p
            The Postnikov tower of a space or spectrum doesn’t give rise to an interesting or useful spectral sequence. However, mapping out of a type preserves fibration sequences, so for any type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            we have an induced iterated fibration sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi SpMap
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi K
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi π
                            %mi s
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi s
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi SpMap
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msub
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi Y
                              %mo{:stretchy => "false"} ‖
                            %mi s
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi SpMap
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msub
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi Y
                              %mo{:stretchy => "false"} ‖
                            %mrow
                              %mi s
                              %mo −
                              %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi SpMap
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi K
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi π
                            %mrow
                              %mi s
                              %mo −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi s
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi SpMap
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msub
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi Y
                              %mo{:stretchy => "false"} ‖
                            %mrow
                              %mi s
                              %mo −
                              %mn 1
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi SpMap
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msub
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi Y
                              %mo{:stretchy => "false"} ‖
                            %mrow
                              %mi s
                              %mo −
                              %mn 2
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi ⋮
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathsf{SpMap}(X,K(\pi_s(Y),s)) \to \mathsf{SpMap}(X,{\Vert Y\Vert}_s) \to \mathsf{SpMap}(X,{\Vert Y\Vert}_{s-1}) \\
                  \\mathsf{SpMap}(X,K(\pi_{s-1}(Y),s-1)) \to \mathsf{SpMap}(X,{\Vert Y\Vert}_{s-1}) \to \mathsf{SpMap}(X,{\Vert Y\Vert}_{s-2}) \\
                  \\vdots
                  }
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(A,s)
            denotes the spectrum whose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi n
                    %mi{:mathvariant => "normal"} th
                %annotation{:encoding => "application/x-tex"} n^{\mathrm{th}}
            space is the usual Eilenberg-Mac Lane space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi s
                  %mo +
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(A,s+n)
            if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo +
                    %mi n
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} s+n\ge 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(A,0)
            is the Eilenberg-Mac Lane spectrum that we denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mi A
                %annotation{:encoding => "application/x-tex"} H A
            last time.
          %p Hence, we have a spectral sequence with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mi p
                              %mi q
                            %mn 2
                        %mtd
                          %mo =
                          %msub
                            %mi π
                            %mrow
                              %mi p
                              %mo +
                              %mi q
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi SpMap
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi K
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi π
                            %mi q
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msub
                            %mi π
                            %mi p
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi SpMap
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi H
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi π
                            %mi q
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msup
                            %mi H
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi p
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ;
                          %msub
                            %mi π
                            %mi q
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  E^2_{p q} &amp;= \pi_{p+q}(\mathsf{SpMap}(X,K(\pi_q(Y),q)))\\
                  \&amp;= \pi_p(\mathsf{SpMap}(X,H(\pi_q(y)))\\
                  \&amp;= H^{-p}(X;\pi_q(Y))
                  \\end{aligned}
          %p
            the “ordinary”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi p
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi{:mathvariant => "normal"} th
                %annotation{:encoding => "application/x-tex"} (-p)^{\mathrm{th}}
            cohomology of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coefficients in the abelian group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_q(Y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is an
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi SpMap
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n( \mathsf{SpMap}(X,Y))
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ;
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{-n}(X;Y)
          %p
            This is called the
            = succeed "." do
              %em Atiyah-Hirzebruch spectral sequence
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            (what algebraic topologists call “generalized cohomology”) can be put together out of the “ordinary” cohomology of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coefficients in the homotopy groups of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            in “cohomological” spectral sequences of this sort, simultaneously switching the subscripts and superscripts; thus we write instead
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mn 2
                    %mrow
                      %mi p
                      %mi q
                  %mo =
                  %msup
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %msub
                    %mi π
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %msup
                    %mi H
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E_2^{p q} = H^p(X;\pi_{-q}(Y)) \Rightarrow H^{p+q}(X;Y)
          %p
            Graphically, this corresponds to rotating all the “pages” of the spectral sequence by 180 degrees about the origin. This causes the differentials to go down and right rather than left and up. (Note also that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi H
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                  %mo ;
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_{-q}(Y) = H^q(\mathbf{1};Y)
            is also the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi q
                    %mi{:mathvariant => "normal"} th
                %annotation{:encoding => "application/x-tex"} q^{\mathrm{th}}
            cohomology of a point with coefficients in
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          %p
            Of course, this may not seem very interesting unless you have some spectra up your sleeve other than
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mi A
                %annotation{:encoding => "application/x-tex"} H A
            whose cohomology you care about. However, we can also use it to construct the Serre spectral sequence, which is interesting even as a statement only about ordinary cohomology.
          %p
            First we have to generalize our notion of cohomology a bit. In the language of classical algebraic topology, we’re going to define
            %em parametrized
            cohomology theories, including as a special case
            = succeed "." do
              %em cohomology with local coefficients
            %em dependent
            function types.
          %p
            Thus, suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a type and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Spectrum
                %annotation{:encoding => "application/x-tex"} Y : X \to \mathsf{Spectrum}
            is an
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            to be
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo ≡
                  %msub
                    %mi π
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi n
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi SpSect
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^n(X;Y) :\equiv \pi_{-n} (\mathsf{SpSect}(X,Y))
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi SpSect
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathsf{SpSect}(X,Y)
            is the “spectrum of sections of
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi SpSect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo :
                    %mo ≡
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo :
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathsf{SpSect}(X,Y)_n :\equiv \prod_{(x:X)} Y(x)_n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is a constant family this reduces to the previously defined notion of cohomology.
          %p
            Where do families of spectra come from? One place they come from is families of abelian groups. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi AbGp
                %annotation{:encoding => "application/x-tex"} A : X \to \mathsf{AbGp}
            is such, then composing it with the “Eilenberg-Mac Lane spectrum” function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo :
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi ApGp
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Spectrum
                %annotation{:encoding => "application/x-tex"} H : \mathsf{ApGp}\to \mathsf{Spectrum}
            we obtain an
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mi A
                  %annotation{:encoding => "application/x-tex"} H A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi AbGp
                %annotation{:encoding => "application/x-tex"} \mathsf{AbGp}
            is a 1-type, and hence any such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            factors through
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ‖
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Vert X \Vert_1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em local system
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is pointed and connected, then
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ‖
                      %mn 1
                    %mo =
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Vert X \Vert_1 = K(\pi_1(X),1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mi A
                %annotation{:encoding => "application/x-tex"} H A
            is called
            = succeed "." do
              %em cohomology with local coefficients
          %p
            Where do local systems come from? One place they come from is homotopy groups of families of types (or spectra). We can compose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mo :
                  %msub
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Type
                    %mo *
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi AbGp
                %annotation{:encoding => "application/x-tex"} \pi_n : \mathsf{Type}_\ast \to \mathsf{AbGp}
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mo :
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Spectrum
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi AbGp
                %annotation{:encoding => "application/x-tex"} \pi_n : \mathsf{Spectrum} \to \mathsf{AbGp}
            with any family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo :
                  %mi X
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Type
                    %mo *
                %annotation{:encoding => "application/x-tex"} Y : X \to \mathsf{Type}_\ast
            of pointed types or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Spectrum
                %annotation{:encoding => "application/x-tex"} Y : X \to \mathsf{Spectrum}
            of spectra to obtain a local system. I think the ease with which we can pass back and forth between local systems and families of spectra is a good example of the value of the type-theoretic framework.
          %p
            In the same way, we can construct the “fiberwise” Postnikov tower of a family of spectra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Spectrum
                  %annotation{:encoding => "application/x-tex"} Y : X \to \mathsf{Spectrum}
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi AbGp
                  %annotation{:encoding => "application/x-tex"} \pi_q(Y) : X \to \mathsf{AbGp}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi SpSect
                  %annotation{:encoding => "application/x-tex"} \mathsf{SpSect}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi SpMap
                  %annotation{:encoding => "application/x-tex"} \mathsf{SpMap}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mn 2
                    %mrow
                      %mi p
                      %mi q
                  %mo =
                  %msup
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %msub
                    %mi π
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E^{p q}_2 = H^{p}(X;\pi_{-q}(Y))
            (meaning the cohomology with local coefficients in the local system
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_{-q}(Y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^{p+q}(X;Y)
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is a family of
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
          %p
            Now we’re ready to deduce the Serre spectral sequence. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            be an ordinary spectrum, such as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mi A
                  %annotation{:encoding => "application/x-tex"} H A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Type
                %annotation{:encoding => "application/x-tex"} F : X \to \mathsf{Type}
            be a type family. Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi SpMap
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi x
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x\mapsto \mathsf{SpMap}(F_x,Y)
            is an
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is. Thus, we have the above “parametrized” Atiyah-Hirzebruch spectral sequence:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %mi λ
                  %mi x
                  %mo .
                  %msub
                    %mi π
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi SpMap
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi x
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %msup
                    %mi H
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %mi λ
                  %mi x
                  %mo .
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi SpMap
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi x
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} H^p(X;\lambda x.\pi_{-q}(\mathsf{SpMap}(F_x,Y))) \Rightarrow H^{p+q}(X;\lambda x.\mathsf{SpMap}(F_x,Y)).
          %p
            On the left, we have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi SpMap
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi x
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi H
                    %mi q
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi x
                  %mo ;
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_{-q}(\mathsf{SpMap}(F_x,Y)) = H^q(F_x;Y)
            by definition. And as for the right side, we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msup
                            %mi H
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ;
                          %mi λ
                          %mi x
                          %mo .
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi SpMap
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi F
                            %mi x
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %msub
                            %mi π
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi n
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi SpSect
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi λ
                          %mi x
                          %mo .
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi SpMap
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi F
                            %mi x
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msub
                            %mi π
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi n
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi SpMap
                          %mo{:stretchy => "false"} (
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo :
                              %mi X
                              %mo{:stretchy => "false"} )
                          %msub
                            %mi F
                            %mi x
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msup
                            %mi H
                            %mi n
                          %mo{:stretchy => "false"} (
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo :
                              %mi X
                              %mo{:stretchy => "false"} )
                          %msub
                            %mi F
                            %mi x
                          %mo ;
                          %mi F
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  H^n(X;\lambda x.\mathsf{SpMap}(F_x,Y)) &amp;= \pi_{-n}(\mathsf{SpSect}(X,\lambda x.\mathsf{SpMap}(F_x,Y)))\\
                  \&amp;= \pi_{-n}(\mathsf{SpMap}(\sum_{(x:X)} F_x, Y))\\
                  \&amp;= H^n(\sum_{(x:X)}F_x;F)
                  \\end{aligned}
          %p
            the cohomology of the total space of the fibration
            %em F
            with coefficients in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "-types," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ;
                        %mi X
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi F
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo :
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi x
                    %mo →
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((\sum_{(x;X)} F_x) \to Z) = \prod_{(x:X)} (F_x \to Z)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %mi λ
                  %mi x
                  %mo .
                  %msup
                    %mi H
                    %mi q
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi x
                  %mo ;
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %msup
                    %mi H
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} (
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo :
                      %mi X
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi F
                    %mi x
                  %mo ;
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^p(X;\lambda x. H^q(F_x;Y)) \Rightarrow H^{p+q}(\sum_{(x:X)} F_x;Y)
          %p
            which is the usual cohomological Serre spectral sequence, relating the cohomology of the base, with local coefficients in the cohomology of the fiber, to the cohomology of the total space. Note that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is pointed and simply connected, so that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ‖
                      %mn 1
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Vert X \Vert_1 = \mathbf{1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is constant, and so the cohomology with local coefficients in the domain reduces simply to the ordinary cohomology of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coefficients in the cohomology of the fiber over the basepoint.
          %p
            After all of this theory, I ought to give you at least one application to justify it all. Here’s a fairly easy one. Suppose we have a fibration of spheres, i.e. a fiber sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi a
                  %mo →
                  %msup
                    %mi S
                    %mi b
                  %mo →
                  %msup
                    %mi S
                    %mi c
                %annotation{:encoding => "application/x-tex"} S^a \to S^b \to S^c
            in which all three types are spheres of some dimension, and suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo &gt;
                  %mn 1
                %annotation{:encoding => "application/x-tex"} c\gt1
            so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi c
                %annotation{:encoding => "application/x-tex"} S^c
            is simply connected and that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} a\gt0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} b\gt0
            for nontriviality. Then we have a Serre spectral sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi c
                  %mo ;
                  %msup
                    %mi H
                    %mi q
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi a
                  %mo ;
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %msup
                    %mi H
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi b
                  %mo ;
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} H^p(S^c; H^q(S^a;\mathbb{Z})) \Rightarrow H^{p+q}(S^b;\mathbb{Z}).
          %p
            The Eilenberg-Steenrod axioms for ordinary cohomology (i.e. with coefficients in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} H \mathbb{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi m
                  %mo ;
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^n(S^m;\mathbb{Z})
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n=0
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mi m
                  %annotation{:encoding => "application/x-tex"} n=m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E_2
            page of this spectral sequence is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            at
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,0), (c,0), (0,a), (c,a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mn 0
                      %mo ,
                      %mi a
                    %mi r
                %annotation{:encoding => "application/x-tex"} E^r_{0,a}
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi c
                        %mo ,
                        %mn 0
                      %mi r
                  %annotation{:encoding => "application/x-tex"} E^r_{c,0}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %mi a
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} c = a+1
            %em no
            such differential, then
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                    %mo =
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_\infty = E_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi b
                  %mo ;
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^n(S^b;\mathbb{Z})
            will be built out of nontrivial groups for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                    %mo ,
                    %mi a
                    %mo ,
                    %mi c
                    %mo ,
                    %mi a
                    %mo +
                    %mi c
                  %annotation{:encoding => "application/x-tex"} n = 0,a,c,a+c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi b
                  %mo ;
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^n(S^b;\mathbb{Z})
            is zero unless
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                    %mo ,
                    %mi b
                  %annotation{:encoding => "application/x-tex"} n = 0,b
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %mi a
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} c = a+1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mn 0
                      %mo ,
                      %mi a
                    %mi r
                  %mo →
                  %msubsup
                    %mi E
                    %mrow
                      %mi c
                      %mo ,
                      %mn 0
                    %mi r
                %annotation{:encoding => "application/x-tex"} E^r_{0,a} \to E^r_{c,0}
            is an isomorphism and “kills” both of these groups, and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo =
                    %mi a
                    %mo +
                    %mi c
                    %mo =
                    %mn 2
                    %mi a
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} b = a+c = 2a+1
          %p
            In conclusion,
            %em the only possible fibrations of spheres are of the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi a
                    %mo →
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi a
                        %mo +
                        %mn 1
                    %mo →
                    %msup
                      %mi S
                      %mrow
                        %mi a
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^a \to S^{2a+1}\to S^{a+1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} a=1
            we do have such a fibration, namely the Hopf fibration. (Classically, there are also such fibrations for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo =
                  %mn 3
                  %mo ,
                  %mn 7
                %annotation{:encoding => "application/x-tex"} a=3,7
            and no other positive values of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            — the latter is a famous theorem called the “Hopf invariant one problem”.)
          %p There are lots of other applications of spectral sequences; it’ll be fun to see how many of them we can reproduce. Many of them require homology in addition to cohomology, though, which would be a whole other post.
          %p
            One last comment deserves to be made. I claimed that this “is” the Serre spectral sequence, but actually I haven’t proven that. It has the same groups in its
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E_2
            page, and converges to the same thing, but that doesn’t imply that the whole spectral sequence is the same (although it strongly suggests it). And I haven’t seen this construction of the Serre SS anywhere in the classical algebraic topology literature (although I’d be surprised if it were new) — most constructions use instead a CW decomposition of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em
              (Edit: See
              = succeed "!)" do
                %a{:href => "#Maunder"} below
          %h2#on_indexing_choices On indexing choices
          %p
            The “natural” indexing of the spectral sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_n(X_s)
            constructed above is by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-1,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mi p
                  %mo +
                  %mi q
                %annotation{:encoding => "application/x-tex"} n = p+q
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo =
                    %mi q
                  %annotation{:encoding => "application/x-tex"} s=q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (p,q)
            degree
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-2,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E_2
            page of some known spectral sequences (such as the Serre and Atiyah-Hirzebruch SS).
          %p
            However, there are other ways to do the reindexing. For instance, if we instead set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mi t
                    %mo −
                    %mi s
                  %annotation{:encoding => "application/x-tex"} n = t-s
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (s,t)
            degree
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,0)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 1
                %annotation{:encoding => "application/x-tex"} E_1
            page of a spectral sequence. For instance, the Adams spectral sequence can be obtained in this way from a suitably chosen tower of fibrations (although usually in that case one talk about cofibers rather than fibers, which in the world of spectra are the same up to a furtherh degree shift). Thanks to
            %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
            for pointing this out.
          %h2#notes Notes
          %p Some notes not in the original blog posts:
          %ul
            %li
              %p
                In the section on Spectral Sequences on HoTT it is ambiguous whether
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi SpMap
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathsf{SpMap}(X,Y)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi SpSect
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathsf{SpSect}(X,Y)
                consists of pointed or unpointed maps. Most steps taken are true both when they are interpreted as pointed or as unpointed maps. If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi SpMap
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathsf{SpMap}(X,Y)
                is unpointed then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is unpointed and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi n
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi SpMap
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_{-n} (\mathsf{SpMap}(X,Y))
                is the unreduced cohomology of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                (with coefficients in
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi SpMap
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathsf{SpMap}(X,Y)
                is pointed then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is interpreted as a pointed type and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi n
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi SpMap
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_{-n} (\mathsf{SpMap}(X,Y))
                is the reduced cohomology. Everything in the proof of the Atiyah-Hirzebruch spectral sequence holds for both cases, so the Atiyah-Hirzebruch spectral sequence exists for both reduced and unreduced cohomology. However, the Serre Spectral sequence is only valid for unreduced cohomology, since the equivalence
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi SpSect
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi λ
                      %mi x
                      %mo .
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi SpMap
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi F
                        %mi x
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi SpMap
                      %mo{:stretchy => "false"} (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo :
                          %mi X
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi F
                        %mi x
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathsf{SpSect}(X,\lambda x.\mathsf{SpMap}(F_x,Y)) = \mathsf{SpMap}(\sum_{(x:X)} F_x, Y)
              %p used in the proof is only true for unpointed maps.
            %li#Maunder
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                has
                %a{:href => "https://homotopytypetheory.org/2013/08/08/spectral-sequences/#comment-100544"} pointed out
                that this construction of the AHSS appears in
                = succeed "," do
                  %a{:href => "Atiyah–Hirzebruch+spectral+sequence#Maunder63"} C. R. F. Maunder (1963)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/exact+couples"} exact couples
