                  %msub
                    %mi X
                    %mi s
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi d
                        %mn 2
                  %msub
                    %mi π
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mrow
                      %mi s
