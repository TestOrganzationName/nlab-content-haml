                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo :
                      %mi ℕ
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi Y
                    %mi n
                  %mo →
                  %msub
                    %mi Z
                    %mi n
                %annotation{:encoding => "application/x-tex"} f : \prod_{(n:\mathbb{N})} Y_n \to Z_n
            such that the evident squares commute relating it to the equivalences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mi n
                  %mo =
                  %mi Ω
                  %msub
                    %mi Y
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} Y_n = \Omega Y_{n+1}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi n
                    %mo =
                    %mi Ω
                    %msub
                      %mi Z
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
