                            %mi π
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi π
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi π
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mi ⋯
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %mn 0
                        %mtd
                          %msub
                            %mi π
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi π
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mi ⋯
                      %mtr
