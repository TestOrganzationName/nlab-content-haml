                          %mn 0
                          %mo →
                          %mn 0
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  0 \to \pi_n(Y) \to \pi_n(Y) \\
                  \\vdots\\
                  0 \to \pi_n(Y) \to \pi_n(Y) \\
                  \\pi_n(Y) \to \pi_n(Y) \to 0 \\
