          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo →
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mrow
                      %mi s
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
