            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x\in \pi_n(X_s)
            automatically gives us an element of
