            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mrow
                        %mi s
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_{n+1}(Y_{s-1})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo →
                  %msub
                    %mi π
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Y
                    %mrow
                      %mi s
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi s
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Y
                    %mi s
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Y
                    %mrow
                      %mi s
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"} \cdots \to \pi_{n+1}(Y_{s-1}) \to \pi_n(X_{s}) \to \pi_n(Y_{s}) \to \pi_n(Y_{s-1}) \to \cdots
          %p
            is exact, any such element must map to zero in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mi s
                    %mo{:stretchy => "false"} )
