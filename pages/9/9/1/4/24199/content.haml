                        %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; \vdots &amp; \vdots &amp; \vdots &amp; \vdots &amp; \\
                  \\cdots &amp; \pi_1(X_2) &amp; \pi_2(X_2) &amp; \pi_3(X_2) &amp; \pi_4(X_2) &amp; \cdots\\
                  \\cdots &amp; \pi_0(X_1) &amp; \pi_1(X_1) &amp; \pi_2(X_1) &amp; \pi_3(X_1) &amp; \cdots\\
                  \\cdots &amp; 0 &amp; \pi_0(X_0) &amp; \pi_1(X_0) &amp; \pi_2(X_0) &amp; \cdots\\
                  \\cdots &amp; 0 &amp; 0 &amp; 0 &amp; 0 &amp; \cdots\\
                  \&amp; \vdots &amp; \vdots &amp; \vdots &amp; \vdots &amp;
                  }
          %p
            With spectra, the zero groups above would be replaced by negative homotopy groups such as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_{-1}(X_0)
          %p
            We then obtain the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mn 3
                %annotation{:encoding => "application/x-tex"} E^3
            page by replacing each entry
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mi q
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E^2_{p q}
            of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E^2
            page by the homology of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi d
                    %mn 2
                %annotation{:encoding => "application/x-tex"} d^2
            at that spot, i.e. the kernel of the outgoing differential modulo the image of the incoming one. The
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mn 3
                %annotation{:encoding => "application/x-tex"} E^3
            page then has its own differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi d
                    %mn 3
                %annotation{:encoding => "application/x-tex"} d^3
            which goes
            %em three
            steps left and
            %em two
            steps up, and we repeat. We then “take the limit” of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mi r
                %annotation{:encoding => "application/x-tex"} E^r
            as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo →
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} r\to\infty
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E^\infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(Y)
          %p
            First of all, we have to address the question of what it means to “take the limit”, since in general
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mrow
                      %mi r
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} E^{r+1}
            is neither a subobject nor a quotient object of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mi r
                  %annotation{:encoding => "application/x-tex"} E^r
            %em subquotient
            (a quotient of a subobject, or equivalently a subobject of a quotient). One can make sense of this in general, but in many (perhaps most) applications of spectral sequences, there’s a much simpler answer. Namely, it often happens that for each grading
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,q)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mi q
                    %mi r
                %annotation{:encoding => "application/x-tex"} E^r_{p q}
            eventually stabilize as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo →
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} r\to\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mi q
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} E^\infty_{p q}
            to be their eventual value. (The
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            at which this happens generally depends on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,q)
            %em somewhere
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mi r
                %annotation{:encoding => "application/x-tex"} E^r
            for arbitrarily large values of
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
          %p
            Of course, having
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mi q
                    %mrow
                      %mi r
                      %mo +
                      %mn 1
                  %mo =
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mi q
                    %mi r
                %annotation{:encoding => "application/x-tex"} E^{r+1}_{p q} = E^r_{p q}
            means that the differentials coming into and out of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mi q
                    %mi r
                %annotation{:encoding => "application/x-tex"} E^r_{p q}
            are zero, and a good reason for this is if their domain and codomain are respectively the zero group. Note that when the differentials have the usual degrees, they always move from one diagonal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo +
                  %mi q
                  %mo =
                  %mi n
                %annotation{:encoding => "application/x-tex"} p+q=n
            to the next lower one
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mi q
                    %mo =
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p+q=n-1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E^2
            page (hence also in every other page) contains only finitely many nonzero groups, then the groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mi q
                    %mi r
                %annotation{:encoding => "application/x-tex"} E^r_{p q}
            will eventually stabilize for each
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,q)
          %p
            In particular, this is the case in the example arising from a
            %em finite
            iterated fibration sequence, where the nonzero part of the spectral sequence lives entirely in a finite strip
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi q
                    %mo ≤
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} 0\le q\le Q
            %em above
            fibration sequence (which stabilizes above some point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo =
                  %mi T
                %annotation{:encoding => "application/x-tex"} s=T
            but extends infinitely downwards) as long as for every
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi s
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mi s
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi_n(X_s) = \pi_n(Y_s)=0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mi s
                %annotation{:encoding => "application/x-tex"} Y_s
            decreases, or their connectedness increases, as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo →
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} s\to-\infty
          %p
            %strong Convergence Theorem:
            Suppose given a bounded-above iterated fibration sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mi T
                          %mo →
                          %msub
                            %mi Y
                            %mi T
                          %mo →
                          %msub
                            %mi Y
                            %mrow
                              %mi T
                              %mo −
                              %mn 1
                      %mtr
                        %mtd
                          %mi ⋮
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mi s
                          %mo →
                          %msub
                            %mi Y
                            %mi s
                          %mo →
                          %msub
                            %mi Y
                            %mrow
                              %mi s
                              %mo −
                              %mn 1
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mrow
                              %mi s
                              %mo −
                              %mn 1
                          %mo →
                          %msub
                            %mi Y
                            %mrow
                              %mi s
                              %mo −
                              %mn 1
                          %mo →
                          %msub
                            %mi Y
                            %mrow
                              %mi s
                              %mo −
                              %mn 2
                      %mtr
                        %mtd
                          %mi ⋮
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X_{T} \to Y_{T} \to Y_{T-1}\\
                  \\vdots \\
                  X_s \to Y_s \to Y_{s-1}\\
                  X_{s-1} \to Y_{s-1} \to Y_{s-2}\\
                  \\vdots
                  }
          %p
            such that for every
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi s
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Y
                    %mi s
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \pi_n(X_s) =\pi_n(Y_s)=0
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ≤
                    %mi R
                  %annotation{:encoding => "application/x-tex"} s\le R
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %msub
                      %mi lim
                      %mi s
                    %msub
                      %mi Y
                      %mi s
                    %mo =
                    %msub
                      %mi Y
                      %mi T
                  %annotation{:encoding => "application/x-tex"} Y = \lim_s Y_s = Y_T
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mi n
                              %mo −
                              %mi T
                              %mo ,
