                              %mn 1
                              %mo ,
                              %mi s
                              %mo −
                              %mn 1
                            %mn ∞
                          %mo →
                          %msub
                            %mi B
                            %mrow
                              %mi n
                              %mo ,
                              %mi s
                              %mo −
                              %mn 1
                          %mo →
                          %msub
                            %mi B
                            %mrow
                              %mi n
                              %mo ,
