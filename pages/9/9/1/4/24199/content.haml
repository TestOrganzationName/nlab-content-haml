            is precisely the “obstruction” to lifting that to an element of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mrow
                        %mi s
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
