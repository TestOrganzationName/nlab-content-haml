            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            into
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(Y_s)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mi s
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
