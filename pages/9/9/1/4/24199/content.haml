                    %mi D
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} D'
              (which obviously lands inside
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} D'
            %li
              Define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ′
                    %mo :
                    %mi D
                    %mo ′
                    %mo →
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} j':D'\to E'
              as follows. Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi D
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} x\in D'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x = i(y)
              for some
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi D
                    %annotation{:encoding => "application/x-tex"} y\in D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j'(x)
              be the homology class determined by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j(y)
              (which is a cycle since
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mi j
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k j = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x = i(y')
              as well, then
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo −
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} i(y-y') = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo −
                    %mi y
                    %mo ′
                    %mo =
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y-y' = k(z)
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ∈
                      %mi E
                    %annotation{:encoding => "application/x-tex"} z\in E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j(y) - j(y') = d(z)
              is a boundary.
            %li
              Define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ′
                    %mo :
                    %mi E
                    %mo ′
                    %mo →
                    %mi D
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} k':E'\to D'
              by restricting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(d)
              (which lands inside
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} D'
              since if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi j
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d(x) = j(k(x)) = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} k(x)
              lies in the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              by exactness) and then passing to the quotient (which is well-defined since
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mi j
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k j = 0
            %li
              I’ll leave it as an exercise to check the exactness of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} i'
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} j'
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} k'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} deg(i') = deg(i)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} deg(k')=deg(k)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} deg(j')=deg(j) - deg(i)
          %p
            We can thus iterate this process. We write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi D
                    %mi r
                  %mo ,
                  %msup
                    %mi E
                    %mi r
                  %mo ,
                  %msup
                    %mi i
                    %mi r
                  %mo ,
                  %msup
                    %mi j
                    %mi r
                  %mo ,
                  %msup
                    %mi k
                    %mi r
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (D^r,E^r,i^r,j^r,k^r)
            for the exact couple obtained by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo −
                  %mn 2
                %annotation{:encoding => "application/x-tex"} r-2
            iterations. In particular, we have graded abelian groups
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mi r
                  %annotation{:encoding => "application/x-tex"} E^r
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi d
                    %mi r
                  %mo :
                  %msup
                    %mi E
                    %mi r
                  %mo →
                  %msup
                    %mi E
                    %mi r
                %annotation{:encoding => "application/x-tex"} d^r : E^r \to E^r
            of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi deg
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi deg
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo −
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi deg
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} deg(j) + deg(k) - (r-2)\cdot deg(i)
            satisfying
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∘
                    %mi d
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d\circ d = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mrow
                      %mi r
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} E^{r+1}
            is the homology of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mi r
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E^r,d)
            = succeed "." do
              %em spectral sequence
          %p
            Note that I’ve chosen the indexing so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E^2
            is the graded group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            we started with. Like the change from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (n,s)
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,q)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mn 1
                %annotation{:encoding => "application/x-tex"} E^1
            whose homology is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E^2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} E^0
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} E^0
          %p
            When the groups in a spectral sequence are
            = succeed "-graded," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ×
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{Z}\times\mathbb{Z})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            the horizontal coordinate and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            the vertical one. For instance,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E^2
            can be drawn like this:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                          %mi ⋮
                        %mtd
                          %mi ⋮
                        %mtd
                          %mi ⋮
                        %mtd
                          %mi ⋮
                        %mtd
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %mo ,
                              %mn 2
                            %mn 2
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mn 0
                              %mo ,
                              %mn 2
                            %mn 2
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mn 1
                              %mo ,
                              %mn 2
                            %mn 2
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mn 2
                              %mo ,
                              %mn 2
                            %mn 2
                        %mtd
                          %mi ⋯
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %mo ,
                              %mn 1
                            %mn 2
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mn 0
                              %mo ,
                              %mn 1
                            %mn 2
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mn 1
                              %mo ,
                              %mn 1
                            %mn 2
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mn 2
                              %mo ,
                              %mn 1
                            %mn 2
                        %mtd
                          %mi ⋯
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %mo ,
                              %mn 0
                            %mn 2
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mn 0
                              %mo ,
                              %mn 0
                            %mn 2
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mn 1
                              %mo ,
                              %mn 0
                            %mn 2
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mn 2
                              %mo ,
                              %mn 0
                            %mn 2
                        %mtd
                          %mi ⋯
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                            %mn 2
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mn 0
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                            %mn 2
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mn 1
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                            %mn 2
                        %mtd
                          %msubsup
                            %mi E
                            %mrow
                              %mn 2
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                            %mn 2
                        %mtd
                          %mi ⋯
                      %mtr
                        %mtd
                        %mtd
                          %mi ⋮
                        %mtd
                          %mi ⋮
                        %mtd
                          %mi ⋮
                        %mtd
                          %mi ⋮
                        %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; \vdots &amp; \vdots &amp; \vdots &amp; \vdots &amp; \\
                  \\cdots &amp; E_{-1,2}^2 &amp; E_{0,2}^2 &amp; E_{1,2}^2 &amp; E_{2,2}^2 &amp; \cdots\\
                  \\cdots &amp; E_{-1,1}^2 &amp; E_{0,1}^2 &amp; E_{1,1}^2 &amp; E_{2,1}^2 &amp; \cdots\\
                  \\cdots &amp; E_{-1,0}^2 &amp; E_{0,0}^2 &amp; E_{1,0}^2 &amp; E_{2,0}^2 &amp; \cdots\\
                  \\cdots &amp; E_{-1,-1}^2 &amp; E_{0,-1}^2 &amp; E_{1,-1}^2 &amp; E_{2,-1}^2 &amp; \cdots\\
                  \&amp; \vdots &amp; \vdots &amp; \vdots &amp; \vdots &amp;
                  }
          %p
            We call this the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E^2
            %em page
            of the spectral sequence. When the degrees of the differentials are as they are in our example (which is, again, the most common situation), we can draw the differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi d
                    %mn 2
                %annotation{:encoding => "application/x-tex"} d^2
            on this lattice as moving two steps left and one step up. The best picture I’ve been able to find of this online is
            = succeed "," do
              %a{:href => "http://mathworld.wolfram.com/SpectralSequence.html"} here
          %p
            Just to keep ourselves a bit more grounded, here’s what the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E^2
            page looks like in the case of an iterated fibration sequence of spaces:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                          %mi ⋮
                        %mtd
                          %mi ⋮
                        %mtd
                          %mi ⋮
                        %mtd
                          %mi ⋮
                        %mtd
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %msub
                            %mi π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi π
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi π
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mn 2
                          %mo{:stretchy => "false"} )
