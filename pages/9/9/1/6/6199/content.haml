            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/arithmetic+topology"} arithmetic topology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cohomology+of+dynamical+systems"} cohomology of dynamical systems
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/chaos"} chaos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Furstenberg-Zimmer+structure+theorem"} Furstenberg-Zimmer structure theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/shifts"} shifts
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/control+theory"} control theory
          %h2#references References
          %h3#general General
          %ul
            %li
              Boris Hasselblatt, Anatole Katok,
              = succeed "," do
                %em Handbook of dynamical systems
              %a{:href => "http://www.math.psu.edu/katok_a/handbook.html"} contents
          %p See also
          %ul
            %li
              Wikipedia
              = succeed "," do
                %a{:href => "http://en.wikipedia.org/wiki/Dynamical_system"} dynamical system
              %a{:href => "http://en.wikipedia.org/wiki/Autonomous_system_%28mathematics%29"} autonomous system
          %h3#categorytheoretic_formulations Category-theoretic formulations
          %p
            Discussion of dynamical systems in terms of
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            (see also at
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/categorical+systems+theory"} categorical systems theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"}> William Lawvere
                ,
                = succeed "," do
                  %a{:href => "http://www.ima.umn.edu/preprints/Functional-Remarks-General-Concept-Chaos"}
                    %em Functorial Remarks on the General Concept of Chaos
                = succeed ")" do
                  %a{:href => "http://www.ima.umn.edu/sites/default/files/87s.pdf"} pdf
            %li
              %p
                George Dimitrov, Fabian Haiden,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ludmil+Katzarkov"} Ludmil Katzarkov
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"} Maxim Kontsevich
                = succeed "," do
                  %em Dynamical systems and categories
                = succeed "&rbrack;" do
                  %a{:href => "http://arxiv.org/abs/1307.8418"} arxiv/1307.8418
            %li
              %p
                Mike Behrisch, Sebastian Kerkhoff, Reinhard Pöschel, Friedrich Martin Schneider, Stefan Siegmund,
                = succeed "." do
                  %em Dynamical systems in categories
                = succeed ")" do
                  %a{:href => "https://tud.qucosa.de/api/qucosa%3A27340/attachment/ATT-0/"} link
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Kennison"} John Kennison
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Robert+Raphael"} Robert Raphael
                = succeed "," do
                  %em Flows: cocyclic and almost cocyclic
                %strong 25
                18 (2010) 490–507 &amp;lbrack;
                %a{:href => "http://www.tac.mta.ca/tac/volumes/25/18/25-18abs.html"}> tac:25-18
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Patrick+Schultz"}> Patrick Schultz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/David+I.+Spivak"} David I. Spivak
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christina+Vasilakopoulou"} Christina Vasilakopoulou
                = succeed "," do
                  %em Dynamical Systems and Sheaves
                %strong 28
                (2020) 1–57 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1609.08086"}> arXiv:1609.08086
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/s10485-019-09565-x"} doi:10.1007/s10485-019-09565-x
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Jaz+Myers"}> David Jaz Myers
                ,
                = succeed "," do
                  %em Double Categories of Open Dynamical Systems
                %strong 333
                (2021) 154-167 &amp;lbrack;
