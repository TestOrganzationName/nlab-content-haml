          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/solid+state+physics"} solid state physics
            %em topological crystalline insulator
            is a
            %a.existingWikiWord{:href => "/nlab/show/crystal"} crystalline
            %a.existingWikiWord{:href => "/nlab/show/quantum+material"} quantum material
            in a
            %a.existingWikiWord{:href => "/nlab/show/topological+phase+of+matter"} topological phase of matter
            like a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+insulator"} topological insulator
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/symmetry+protected+topological+phase"} protected
            %a.existingWikiWord{:href => "/nlab/show/time-reversal+symmetry"} time-reversal symmetry
            and) a
            = succeed "-symmetry" do
              %a.existingWikiWord{:href => "/nlab/show/crystallographic+group"} crystallographic point group
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/crystal"} crystal
          %p
            This means that a topological crystalline insulator phase observed in the
            %a.existingWikiWord{:href => "/nlab/show/bulk"} bulk
            of some
            %a.existingWikiWord{:href => "/nlab/show/crystal"} crystal
            whose
            %a.existingWikiWord{:href => "/nlab/show/dynamics"} dynamics
            (or rather that of its
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/electrons"} electrons
            %a.existingWikiWord{:href => "/nlab/show/crystallographic+group"} point group
            may disappear for instance at
            %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            regions where the dynamics
            %a.existingWikiWord{:href => "/nlab/show/symmetry+breaking"} breaks
