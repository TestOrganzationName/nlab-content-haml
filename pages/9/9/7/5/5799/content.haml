                  %div
                    %p
                      %a{:href => "/nlab/edit/topos+theory+-+contents"} Edit this sidebar
          %blockquote
            %p under construction
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %li
                %a{:href => "#logical_characterization"} Logical characterization
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi et
                %annotation{:encoding => "application/x-tex"} C_{et}
            be the
            %a.existingWikiWord{:href => "/nlab/show/etale+site"} etale site
            of complex
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            %strong infinitesimal site
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cris
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cris(X)
            is the
            %a.existingWikiWord{:href => "/nlab/show/big+site"} big site
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi et
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi X
                    %mi dR
                %annotation{:encoding => "application/x-tex"} C_{et}/X_{dR}
            of the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+space"} de Rham space
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi dR
                    %mo :
                    %msub
                      %mi C
                      %mi et
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} X_{dR} : C_{et} \to Set
          %p
            the site whose objects are pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mi A
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi red
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Spec A, (Spec A)_{red} \to X)
            of an affine
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mi A
                %annotation{:encoding => "application/x-tex"} Spec A
            and a morphism from its reduced part (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi red
                  %mo =
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} /
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Spec A)_{red} = Spec (A/I)
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            the
            %a.existingWikiWord{:href => "/nlab/show/nilradical"} nilradical
            of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            More generally, for positive
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
          %h2#properties Properties
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cris
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cris(X)
            is the
            %a.existingWikiWord{:href => "/nlab/show/crystalline+cohomology"} crystalline cohomology
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h2#logical_characterization Logical characterization
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a ring. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"} k \to R
            be a finitely presented
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-scheme" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(k)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spec(R)
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifies
            the theory of commutative squares of ring homomorphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mo →
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↑
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %mi k
                        %mtd
                          %mo →
                        %mtd
                          %mi R
                %annotation{:encoding => "application/x-tex"}
                  \\array{A &amp; \rightarrow &amp; B \\
                  \\uparrow &amp;&amp;\uparrow \\
                  k &amp; \rightarrow&amp; R
                  }
          %p
            where the rings
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            are local, the top arrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \to B
            is surjective and has nilpotent kernel (i.e. every element of the kernel is nilpotent) This result is due to (
            %a{:href => "#Hutzler18"}> Hutzler 2018
            ). By the conditions on the top morphism, it is enough to require that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is local.
          %p
            Routine arguments, to be made explicit in a further revision of this entry, allow to generalize this description to the non-affine case. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} f \colon X \to S
            be a scheme over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is locally of finite presentation over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "-scheme" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            classifies, as a
            = succeed "-topos," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(X)
            = succeed "-theory" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mo →
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↑
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %msup
                            %mi f
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %msub
                            %mi 𝒪
                            %mi S
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi 𝒪
                            %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{A &amp; \rightarrow &amp; B \\
                  \\uparrow &amp;&amp;\uparrow \\
                  f^{-1}\mathcal{O}_S &amp; \rightarrow&amp; \mathcal{O}_X
                  }
          %p
            where the rings
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            are local, the top arrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \to B
            is surjective and has nilpotent kernel (i.e. every element of the kernel is nilpotent), and both vertical arrows are local (i.e. reflect invertibility).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/crystalline+cohomology"} crystalline cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/crystalline+differential+operator"} crystalline differential operator
          %h2#references References
          %p
            An original account of the definition of the crystalline topos is
            %a{:href => "http://www.math.jussieu.fr/~leila/grothendieckcircle/DixExp.pdf#page=299"} section 7, page 299
            of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"}> Alexander Grothendieck
              ,
              %em Crystals and de Rham cohomology of schemes
              , chapter IX in
              %em Dix Exposes sur la cohomologie des schema
              (
              %a{:href => "http://www.math.jussieu.fr/~leila/grothendieckcircle/DixExp.pdf"}> pdf
              )
          %p A review of some aspects:
          %ul
            %li#LurieCrystal
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                Notes on crystals and algebraic
                = succeed "-modules" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} \mathcal{D}
              (2010) &amp;lbrack;
              %a.existingWikiWord{:href => "/nlab/files/Lurie-NotesOnCrystals.pdf", :title => "pdf"}> pdf
              \&amp;rbrack;
          %p and on page 7 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Carlos+Simpson"}> Carlos Simpson
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Constantin+Teleman"} Constantin Teleman
              %em
                deRham theorem for
                = succeed "-stacks" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              (
              %a{:href => "http://math.berkeley.edu/~teleman/math/simpson.pdf"}> pdf
              )
          %p In the article
          %ul
            %li
              Arthur Ogus,
              %em Cohomology of the infinitesimal site
              Annales scientifiques de l’École Normale Supérieure, Sér. 4, 8 no. 3 (1975), p. 295-318 (
              %a{:href => "http://www.numdam.org/item?id=ASENS_1975_4_8_3_295_0"}> numdam
              )
          %p
            it is shown that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is proper over an algebraically closed field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            of
            %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            coincides with
            %a.existingWikiWord{:href => "/nlab/show/etale+cohomology"} etale cohomology
            with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            (or more generally
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W_n(k)
            if we work with the infinitesimal site of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            over
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W_n(k)
          %p The result about the geometric theory classified by the big infinitesimal topos appears in
          %ul
            %li#Hutzler18
              %p
                %span.newWikiWord>
                  Matthias Hutzler
                  %a{:href => "/nlab/new/Matthias+Hutzler"} ?
                ,
                %em Internal language and classified theories of
              %p
                toposes in algebraic geometry_, Master’s thesis at the University of Augsburg, 2018,
                = succeed "," do
                  %a{:href => "https://gitlab.com/MatthiasHu/master-thesis/blob/master/thesis.pdf"} GitLab
                %a{:href => "https://gitlab.com/MatthiasHu/master-thesis/raw/master/thesis.pdf?inline=false"} pdf download
            %li
              %p
                %span.newWikiWord>
                  Matthias Hutzler
                  %a{:href => "/nlab/new/Matthias+Hutzler"} ?
                ,
                = succeed "," do
                  %em Syntactic presentations for glued toposes and for crystalline toposes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/2206.11244"} arXiv:2206.11244
