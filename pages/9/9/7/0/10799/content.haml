                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔸
                    %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_1(\mathbb{A}_F)
            is the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/group+of+ideles"} group of ideles
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+bundles"} moduli stack of bundles
            on algebraic curves, see at
            = succeed "." do
              %em
                %a{:href => "moduli+space+of+bundles#OverCurvesAndTheLanglandsCorrespondence"} Moduli space of bundles and the Langlands correspondence
          %div
