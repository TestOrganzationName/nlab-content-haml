                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_{dR}(X,\mathbf{B}^{n+1}U(1)) \to \mathbf{H}_{dR}(X,\mathbf{B}^{n+1}U(1))
              by definition picks one representative in each connected component. Using the
              %a{:href => "#OrdinaryDeRham"} above model
              of the intrinsic de Rham cohomology in terms of globally defined differential froms, we could easily get rid of this restriction by considering instead of the above
              = succeed "-pullback" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
