                  \&amp; \searrow &amp; \downarrow &amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; \mathbf{\flat}_{dR}\mathbf{B}^{n+1}U(1)_{simp}
                  \&amp;\stackrel{\int_{\Delta^\bullet}}{\to^\simeq}&amp;
                  \\mathbf{\flat}_{dR}\mathbf{B}^{n+1}U(1)_{chn}
                  \&amp;&amp;&amp;
                  curvature
                  }
                  \\,.
          %p
            In summary this gives us the following alternative perspective on connections on
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
