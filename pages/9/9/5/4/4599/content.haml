                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C^\infty(-,U(1))
                  \\oplus
                  \\Omega^1(-)
                  \&amp;\stackrel{d_{dR} + Id}{\to}&amp;
                  \\Omega^1(-)
                  \\\
                  \\downarrow^{\mathrlap{p_2}} &amp;&amp; \downarrow^{\mathrlap{d_{dR}}}
                  \\\
                  \\Omega^1(-) &amp;\stackrel{d_{dR}}{\to}&amp;
                  \\Omega^2_{cl}(-)
                  }
                  \\,.
          %p
            By the
            %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+lemma"} Poincaré lemma
            applied to each
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
          %p
            In the
            %a{:href => "#AbGerbesConnection"} next section
            we give the proof of this (simple) claim. Here in the warmup phase we instead want to discuss the geometric interpretation of this resolution, along the lines of the section
            %a{:href => "http://ncatlab.org/schreiber/show/differential+cohomology+in+an+(%E2%88%9E%2C1)-topos+--+survey#CurvatureCharacteristicsI"} curvature characteristics of 1-bundles
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+an+%28%E2%88%9E%2C1%29-topos+--+survey"} survey-part
          .num_prop
            %h6#proposition_3 Proposition
            %p We have the following geometric interpretation of the above models:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi U
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi U
                            %mtd
                              %mo →
                            %mtd
                              %mo *
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi Π
                                %mn 2
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %msup
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mn 2
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                      %mo }
                    %mo =
                    %mrow
                      %mo {
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Π
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mn 2
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\flat}_{dR} \mathbf{B}^2 U(1)
                    \:
                    U \mapsto
                    \\left\{
                    \\array{
                    U &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{\Pi}_2(U) &amp;\to&amp; \mathbf{B}^2 U(1)
                    }
                    \\right\}
                    \=
                    \\left\{
                    \\mathbf{\Pi}_2(U) \to \mathbf{B}^2 U(1)
                    \\right\}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                    %mo :
                    %mi U
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi U
                            %mtd
                              %mo →
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi Π
                                %mn 2
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi INN
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}U(1)_{diff}
                    \:
                    U \mapsto
                    \\left\{
                    \\array{
                    U &amp;\to&amp; \mathbf{B}U(1)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{\Pi}_2(U) &amp;\to&amp; \mathbf{B}INN(U(1))
                    }
                    \\right\}
                    \\,.
            %p
              And in this presentation the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi curv
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi diff
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} curv : \mathbf{B}_{diff}U(1) \to \mathbf{B}^2 U(1)
              is given over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} U \in CartSp
              by forming the pasting composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                          %mtd
                            %mi underlying
                            %mspace{:width => "thickmathspace"}
                            %mi cocycle
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi INN
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                          %mtd
                            %mi connection
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                          %mtd
                            %mi curvature
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U &amp;\to&amp; \mathbf{B}U(1) &amp;&amp;&amp; underlying\;cocycle
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{\Pi}_2(U) &amp;\to&amp; \mathbf{B}INN(U(1)) &amp;&amp;&amp; connection
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{\Pi}_2(U) &amp;\to&amp; \mathbf{B}^2 U(1) &amp;&amp;&amp; curvature
                    }
            %p and picking the lowest horizontal morphism.
          %p Here the terms mean the following:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi INN
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} INN(U(1))
                is the
                %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ξ
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Xi(U(1) \to U(1))
                %a.existingWikiWord{:href => "/nlab/show/groupal+model+for+universal+principal+%E2%88%9E-bundles"} groupal model for the universal principal U(1)-bundle
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi E
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{E}U(1)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Π
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_2(U)
                is the
                %a.existingWikiWord{:href => "/nlab/show/path+2-groupoid"} path 2-groupoid
                with homotopy class of 2-dimensional paths as 2-morphisms
            %li
              %p
                the groupoids of diagrams in braces have as objects commuting diagrams in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]
                as indicated, and horizontal 2-morphisms fitting into such diagrams as morphisms.
          %p
            Using the discussion at
            %a.existingWikiWord{:href => "/nlab/show/2-groupoid+of+Lie+2-algebra+valued+forms"} 2-groupoid of Lie 2-algebra valued forms
            (
            %a{:href => "http://arxiv.org/abs/0802.0663"}> SchrWalII
            ) we have the following:
          %ol
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mn 2
                      %mi Grpd
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, 2Grpd]
                of the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi tra
                        %mi A
                      %mo :
                      %msub
                        %mi Π
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} tra_A : \Pi_2(X) \to \mathbf{E}\mathbf{B}U(1)
                are in bijection with smooth 1-forms
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A \in \Omega^1(X)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to the the
                %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                along that path, and sends a surface in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to the exponentiated integral of the curvature 2-form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi A
                      %mo =
                      %mi d
                      %mi A
                    %annotation{:encoding => "application/x-tex"} F_A = d A
                over that surface. The
                %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %msub
                        %mi F
                        %mi A
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d F_A = 0
                says precisely that this assignment indeed descends to homotopy classes of surfaces, which are the 2-morphisms in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Pi_2(X)
            %li
              %p
                Moreover
                %a.existingWikiWord{:href => "/nlab/show/k-morphism"} 2-morphisms
                of the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo ,
                      %mi α
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi tra
                        %mi A
                      %mo →
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} tra
                        %mrow
                          %mi A
                          %mo ′
                    %annotation{:encoding => "application/x-tex"} (\lambda,\alpha) : tra_A \to \tra_{A'}
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mn 2
                      %mi Grpd
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, 2Grpd]
                are in bijection with pairs consisting of a
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \lambda \in C^\infty(X,U(1))
                and a 1-form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ∈
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha \in \Omega^1(X)
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ′
                        %mo =
                        %mi A
                        %mo +
                        %msub
                          %mi d
                          %mi dR
                        %mi λ
                        %mo −
                        %mi α
                      %annotation{:encoding => "application/x-tex"} A' = A + d_{dR} \lambda - \alpha
            %li
              %p
                And finally
                %a.existingWikiWord{:href => "/nlab/show/k-morphism"} 3-morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo ,
                      %mi α
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo ′
                      %mo ,
                      %mi α
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} h : (\lambda, \alpha) \to (\lambda', \alpha')
                are in bijection with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} h \in C^\infty(X,U(1))
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo ′
                      %mo =
                      %mi λ
                      %mo ⋅
                      %mi h
                    %annotation{:encoding => "application/x-tex"} \lambda' = \lambda \cdot h
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                        %mo ′
                        %mo =
                        %mi α
                        %mo +
                        %msub
                          %mi d
                          %mi dR
                        %mi h
                      %annotation{:encoding => "application/x-tex"} \alpha' = \alpha + d_{dR} h
          %p
            By the same reasoning we find that the coefficient object for flat
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^2 U(1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mo ♭
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mi Ξ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi d
                        %mi dR
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi d
                        %mi dR
                  %msubsup
                    %mi Ω
                    %mi cl
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{\flat}\mathbf{B}^2 U(1)
                  \=
                  [\Pi_2(-), \mathbf{B}^2U(1)]
                  \=
                  \\Xi(
                  C^\infty(-,U(1))
                  \\stackrel{d_{dR}}{\to}
                  \\Omega^1(-) \stackrel{d_{dR}}{\to} \Omega^2_{cl}(-)
                  )
                  \\,.
          %p
            So by the above definition of differential cohomology in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            we find that
            = succeed "-differential" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            %a.existingWikiWord{:href => "/nlab/show/paracompact+space"} paracompact
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is given by choosing any
            %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(\{U_i\})
            to be the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi CartSp
                    %mi op
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi proj
                      %mo ,
                      %mi cov
                %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj,cov}
            and forming the ordinary pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi diff
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msubsup
                            %mi H
                            %mi dR
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi CartSp
                            %mi op
                          %mo ,
                          %mi sSet
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi diff
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi curv
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi CartSp
                            %mi op
                          %mo ,
                          %mi sSet
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %msub
                            %mo ♭
                            %mi dR
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{H}_{diff}(X,\mathbf{B}U(1)) &amp;\to&amp; H^2_{dR}(X)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  [CartSp^{op},sSet](C(\{U_i\}), \mathbf{B}_{diff}U(1))
                  \&amp;\stackrel{curv}{\to}&amp;
                  [CartSp^{op},sSet](C(\{U_i\}), \flat_{dR}\mathbf{B}^2 U(1))
                  }
          %p
            (because the bottom vertical morphism is a fibration, by the fact that our model for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi diff
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}_{diff} U(1) \to \flat_{dR}\mathbf{B}^2 U(1)
            is a fibration, that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(\{U_i\})
            is cofibrant and using the axioms of the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj}
          .num_prop
            %h6#observations Observations
            %p
              A cocycle in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi diff
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op},sSet](C(\{U_i\}), \mathbf{B}_{diff}U(1))
              is
            %ol
              %li
                %p a collection of functions
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mo ∈
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mo ,
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (g_{i j } \in C^\infty(U_i \cap U_j, U(1)))
                %p
                  satsifying
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %msub
                          %mi g
                          %mrow
                            %mi j
                            %mi k
                        %mo =
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi k
                      %annotation{:encoding => "application/x-tex"} g_{i j} g_{j k} = g_{i k}
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi i
                          %mo ∩
                          %msub
                            %mi U
                            %mi j
                          %mo ∩
                          %msub
                            %mi U
                            %mi k
                        %annotation{:encoding => "application/x-tex"} U_i \cap U_j \cap U_k
              %li
                %p a collection of 1-forms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mi i
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (A_i \in \Omega^1(U_i))
              %li
                %p a collection of 1-forms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mrow
                            %mi i
                            %mi j
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (a_{i j} \in \Omega^1(U_i \cap U_j))
                %p such that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mi j
                        %mo =
                        %msub
                          %mi A
                          %mi i
                        %mo +
                        %msub
                          %mi d
                          %mi dR
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mo +
                        %msub
                          %mi a
                          %mrow
                            %mi i
                            %mi j
                      %annotation{:encoding => "application/x-tex"}
                        A_j = A_i + d_{dR} g_{i j} + a_{i j}
                %p
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                      %annotation{:encoding => "application/x-tex"} U_i \cap U_j
                  and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi a
                          %mrow
                            %mi i
                            %mi j
                        %mo +
                        %msub
                          %mi a
                          %mrow
                            %mi j
                            %mi k
                        %mo =
                        %msub
                          %mi a
                          %mrow
                            %mi i
                            %mi k
                      %annotation{:encoding => "application/x-tex"}
                        a_{i j} + a_{j k} = a_{i k}
                %p
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi i
                          %mo ∩
                          %msub
                            %mi U
                            %mi j
                          %mo ∩
                          %msub
                            %mi U
                            %mi k
                        %annotation{:encoding => "application/x-tex"} U_i \cap U_j \cap U_k
            %p The curvature-morphism takes such a cocycle to the cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msub
                      %mi A
                      %mi i
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mi j
                    %mo ,
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (d A_i, a_{i j}, )
            %p
              in the
              %a{:href => "#OrdinaryDeRham"} above model
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op},sSet](C(\{U_i\}), \mathbf{\flat}_{dR}\mathbf{B}^2 U(1))
              for intrinsic de Rham cohomology.
            %p
              Every cocycle with nonvanishing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a_{i j})
              is in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi diff
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [C(\{U_i\}), \mathbf{B}_{diff}U(1)]
              coboundant to one with vanishing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a_{i j})
          .proof
            %h6#proof_3 Proof
            %p
              The first statements are effectively the definition and the construction of the above models. The last statement is as in the
              %a{:href => "#OrdinaryDeRham"} above discussion
              of our model for ordinary de Rham cohomology: given a cocycle with non-vanishing closed
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mrow
                          %mi i
                          %mi j
                    %annotation{:encoding => "application/x-tex"} a_{i j}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ρ
                      %mi i
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\rho_i \in C^\infty(X))
              subordinate to the chosen cover and the coboundary given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                      %msub
                        %mi ρ
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                      %msub
                        %mi a
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                          %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\sum_{i_0} \rho_{i_0} a_{i_0 i})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi i
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mi j
                    %mo ,
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A_i,a_{i j}, g_{i j})
              with the cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo ′
                      %mi i
                    %mo ,
                    %mi a
                    %msub
                      %mo ′
                      %mrow
                        %mi i
                        %mi j
                    %mo ,
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A'_i, a'_{i j}, g_{i j})
              where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ′
                      %mi i
                    %mo =
                    %msub
                      %mi A
                      %mi i
                    %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                    %msub
                      %mi ρ
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                    %msub
                      %mi a
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mi i
                  %annotation{:encoding => "application/x-tex"}
                    A'_i = A_i + \sum_{i_0} \rho_{i_0} a_{i_0 i}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi a
                            %msub
                              %mo ′
                              %mrow
                                %mi i
                                %mi j
                          %mtd
                            %mo =
                            %mi A
                            %msub
                              %mo ′
                              %mi j
                            %mo −
                            %mi A
                            %msub
                              %mo ′
                              %mi i
                            %mo −
                            %mi d
                            %msub
                              %mi g
                              %mrow
                                %mi i
                                %mi j
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi a
                              %mrow
                                %mi i
                                %mi j
                            %mo +
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi a
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                                %mi i
                            %mo −
                            %msub
                              %mi a
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                                %mi j
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    a'_{i j}
                    \&amp; = A'_j - A'_i - d g_{i j}
                    \\\
                    \&amp; = a_{i j} +
                    \- \sum_{i_0}( a_{i_0 i} - a_{i_0 j} )
                    \\\
                    \&amp; = 0
                    \\end{aligned}
                    \\,.
          %p So in total we have found the following story:
          %ol
            %li
              %p
                In order to compute the curvature characteristic form of a
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
                cocycle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g : C(\{U_i\}) \to \mathbf{B}U(1)
                of a principal U(1)-bundle, we first lift it
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi diff
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi g
                                    %mo ,
                                    %mo ∇
                                    %mo{:stretchy => "false"} )
                              %mo ↗
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi C
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} {
                              %msub
                                %mi U
                                %mi i
                              %mo{:stretchy => "false"} }
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mi g
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; \mathbf{B}_{diff}U(1)
                      \\\
                      \&amp; {}^{\mathllap{(g,\nabla)}}\nearrow &amp; \downarrow
                      \\\
                      C(\{U_i\}) &amp;\stackrel{g}{\to}&amp; \mathbf{B}U(1)
                      }
              %p
                to an equivalent
                = succeed "-cocycle," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi diff
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}_{diff}U(1)
                %em pseudo-connection
                on the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
            %li
              %p From that lift the desired curvature characteristic is simply projected out
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi diff
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mi curv
                            %mtd
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mo ♭
                                %mi dR
                              %msup
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mn 2
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi g
                                    %mo ,
                                    %mo ∇
                                    %mo{:stretchy => "false"} )
                              %mo ↗
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi C
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} {
                              %msub
                                %mi U
                                %mi i
                              %mo{:stretchy => "false"} }
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mi g
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; \mathbf{B}_{diff}U(1) &amp;\stackrel{curv}{\to}&amp; \mathbf{\flat}_{dR}\mathbf{B}^2 U(1)
                      \\\
                      \&amp; {}^{\mathllap{(g,\nabla)}}\nearrow &amp; \downarrow
                      \\\
                      C(\{U_i\}) &amp;\stackrel{g}{\to}&amp; \mathbf{B}U(1)
                      }
                      \\,,
              %p
                and we find that it lives in the sheaf
                %a.existingWikiWord{:href => "/nlab/show/hypercohomology"} hypercohomology
                that models ordinary de Rham cohomology.
            %li
              %p
                Therefore we find that in each
                %em cohomology class
                of curvatures, there is at least one representative which is an ordinary globally defined 2-form. Moreover, the pseudo-connections that map to such a representative are precisely the
                %em genuine
                connections, those for which the
                = succeed "-part" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mrow
                            %mi i
                            %mi j
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (a_{i j})
          %p So we see that ordinary connections on ordinary circle bundles are a means to model the homotopy pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi diff
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msubsup
                            %mi H
                            %mi dR
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi dR
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{H}_{diff}(X,\mathbf{B}U(1)) &amp;\to&amp; H_{dR}^2(X)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\mathbf{H}(X,\mathbf{B}U(1)) &amp;\to&amp; \mathbf{H}_{dR}(X,\mathbf{B}U(1))
                  }
          %p
            in a 2-step process: first the choice of a pseudo-connection realizes the bottom horizontal morphism as an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/anafunctor"} anafunctor
          %p
            The general version of this story is discussed in detail at
            %a{:href => "#Connections"} differential cohomology in an (∞,1)-topos – Local (pseudo-)connections.
          %h3#CircleBunlePseudoConnection Circle bundles with pseudo-connection
          %p
            In the above discussion of extracting ordinary connections on ordinary
            %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundles"} principal U(1)-bundles
            from the abstract topos-theoretic definition of differential cohomology, we argued that a certain homotopy pullback may be computed by choosing in the Cech-hypercohomology of the complex of sheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi d
                        %mi dR
                  %msubsup
                    %mi Ω
                    %mi cl
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Omega^1(-) \stackrel{d_{dR}}{\to} \Omega^2_{cl}(-))
            over a manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            those cohomology representatives that happen to be represented by globally defined 2-forms on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em pseudo-connections
            over these 2-forms happened to have connected components indexed by
            %em genuine
            connections.
          %p But by the general abstract theory, up to isomorphism the differential cohomology computed this way is guaranteed to be independent of all such choices, which only help us to compute things.
          %p To get a feeling for what is going on, it may therefore be useful to re-tell the analgous story with pseudo-connections that are not genuine connections.
          %p
            By the very fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ←
                    %mo ≃
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi diff
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1) \stackrel{\simeq}{\leftarrow} \mathbf{B}_{diff}U(1)
            is a weak equivalence, it follows that every pseudo-connection is equivalent to an ordinary connection as cocycles in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi diff
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet](C(\{U_i\}), \mathbf{B}_{diff}(G))
          %p
            If we choose a
            %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ρ
                    %mi i
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\rho_i \in C^\infty(X,\mathbb{R}))
            subordinate to the cover
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
          %p
            let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mi i
                  %msub
                    %mi g
                    %mi ij
                  %mo ,
                  %msub
                    %mi a
                    %mrow
                      %mi i
                      %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A_i g_{ij}, a_{i j})
            be an arbitrary pseudo-connection cocycle. Consider the Cech-hypercohomology coboundary given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                    %msub
                      %mi ρ
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                    %msub
                      %mi a
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mi i
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\sum_{i_0} \rho_{i_0} a_{i_0 i}, 0)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msub
                    %mo ′
                    %mi i
                  %mo ≔
                  %msub
                    %mi A
                    %mi i
                  %mo +
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %msub
                        %mi i
                        %mn 0
                  %msub
                    %mi ρ
                    %mrow
                      %msub
                        %mi i
                        %mn 0
                  %msub
                    %mi a
                    %mrow
                      %msub
                        %mi i
                        %mn 0
                      %mi i
                  %mo ,
                  %msub
                    %mi g
                    %mrow
                      %mi i
                      %mi j
                  %mo ,
                  %mi a
                  %msub
                    %mo ′
                    %mrow
                      %mi i
                      %mi j
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (A'_i \coloneqq A_i + \sum_{i_0} \rho_{i_0} a_{i_0 i}, g_{i j}, a'_{i j})
                  \\,,
          %p
            and we can find the new pseudo-components
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %msub
                    %mo ′
                    %mrow
                      %mi i
                      %mi j
                %annotation{:encoding => "application/x-tex"} a'_{i j}
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %msub
                    %mo ′
                    %mrow
                      %mi i
                      %mi j
                  %mo =
                  %mi A
                  %msub
                    %mo ′
                    %mi j
                  %mo −
                  %mi A
                  %msub
                    %mo ′
                    %mi i
                  %mo −
                  %msub
                    %mi d
                    %mi dR
                  %msub
                    %mi g
                    %mrow
                      %mi i
                      %mi j
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  a'_{i j} = A'_j - A'_i - d_{dR} g_{i j}
                  \\,.
          %p Using the computation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %msub
                                %mi i
                                %mn 0
                          %msub
                            %mi ρ
                            %mrow
                              %msub
                                %mi i
                                %mn 0
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi a
                            %mrow
                              %msub
                                %mi i
                                %mn 0
                              %mi i
                          %mo −
                          %msub
                            %mi a
                            %mrow
                              %msub
                                %mi i
                                %mn 0
                              %mi j
                        %mtd
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %msub
                                %mi i
                                %mn 0
                          %msub
                            %mi ρ
                            %mrow
                              %msub
                                %mi i
                                %mn 0
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi a
                            %mrow
                              %mi i
                              %msub
                                %mi i
                                %mn 0
                          %mo +
                          %msub
                            %mi a
                            %mrow
                              %msub
                                %mi i
                                %mn 0
                              %mi j
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %msub
                                %mi i
                                %mn 0
                          %msub
                            %mi ρ
                            %mrow
                              %msub
                                %mi i
                                %mn 0
                          %msub
                            %mi a
                            %mrow
                              %mi i
                              %mi j
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msub
                            %mi a
                            %mrow
                              %mi i
                              %mi j
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\sum_{i_0} \rho_{i_0} (a_{i_0 i} - a_{i_0 j}
                  \&amp;=
                  \- \sum_{i_0} \rho_{i_0} (a_{i i_0} + a_{i_0 j}
                  \\\
                  \&amp; = \sum_{i_0} \rho_{i_0} a_{i j}
                  \\\
                  \&amp; = a_{i j}
                  \\end{aligned}
          %p we find that these indeed vanish.
          %p
            The most drastic example for this is a lift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            of a cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mrow
                      %mi i
                      %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g = (g_{i j})
            in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi diff
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mo ∇
                          %mo ↗
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi g
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathbf{B}_{diff} U(1)
                  \\\
                  \&amp; {}^{\mathllap{\nabla}}\nearrow &amp; \downarrow
                  \\\
                  C(\{U_i\}) &amp;\stackrel{g}{\to}&amp; \mathbf{B}U(1)
                  }
          %p is one which takes all the ordinary curvature forms to vanish identically
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mi i
                  %mo ≔
                  %mn 0
                  %mo ,
                  %msub
                    %mi g
                    %mrow
                      %mi i
                      %mi j
                  %mo ,
                  %msub
                    %mi a
                    %mrow
                      %mi i
                      %mi j
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\nabla = (A_i \coloneqq 0, g_{i j}, a_{i j})
                  \\,.
          %p
            This fixes the pseudo-components to be
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mi j
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi d
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} a_{i j} = - d g_{i j}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi i
                    %mo ≔
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                    %msub
                      %mi ρ
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                    %mi d
                    %msub
                      %mi g
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A_i \coloneqq \sum_{i_0} \rho_{i_0} d g_{i_0 i})
            %a{:href => "http://ncatlab.org/nlab/show/connection+on+a+bundle#Properties"} standard formula
            for equipping
            %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundles"} principal U(1)-bundles
            with Cech cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mrow
                      %mi i
                      %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (g_{i j})
            with a connection.
          %h3#U1GroupoidBundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 0
                %annotation{:encoding => "application/x-tex"} U(1)_0
            \-groupoid bundles
          %p
            We saw above that the intrinsic coefficient object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{\flat}_{dR} \mathbf{B}^n U(1)
            yields ordinary de Rham cohomology in degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \gt 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n = 1
            we
            %a{:href => "#FlatCircleCohomology"} have
            that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{\flat}_{dR} \mathbf{B}U(1)
            is given simply by the 0-
            %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
            sheaf of 1-forms,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi CartSp
                      %mi op
                    %mo →
                    %mi Set
                    %mo ↪
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} \Omega^1(-) : CartSp^{op} \to Set \hookrightarrow sSet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a paracompact smooth manifold
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msubsup
                    %mi Ω
                    %mi cl
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}(X, \mathbf{\flat}_{dR}\mathbf{B}U(1)) =
                  \\Omega^1_{cl}(X)
          %p
            instead of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi dR
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^1_{dR}(X)
          %p
            There is a good reason for this discrepancy: for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n \geq 1
            the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{\flat}_{dR} \mathbf{B}^n U(1)
            is the recipient of the intrinsic curvature characteristic morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi curv
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
