                            %mi Ω
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
