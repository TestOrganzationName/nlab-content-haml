                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi diff
                      %mo ,
                      %mi chn
                %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1) \stackrel{\simeq}{\leftarrow} \mathbf{B} U(1)_{diff,chn}
            given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi diff
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi Ξ
                  %mo{:stretchy => "false"} (
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi C
