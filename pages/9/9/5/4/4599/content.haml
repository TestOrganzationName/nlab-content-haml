                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} curv : \mathbf{B}_{diff}U(1) \to \mathbf{\flat}_{dR}\mathbf{B}^2 U(1)
            given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo ⊕
                          %msup
                            %mi Ω
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
