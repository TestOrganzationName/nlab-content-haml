          %h2#DifferentialCohomology Differential cohomology
          %p
            The intrinsic
            %a{:href => "http://ncatlab.org/schreiber/show/differential+cohomology+in+an+(%E2%88%9E%2C1)-topos#DiffCohWithGroupalCoeffs"} definition of the ∞-groupoid of cocycles for the intrinsic differential cohomology
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \mathbf{H} = Smooth\infty Grpd
            with coefficients
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
