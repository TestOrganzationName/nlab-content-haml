                              %mi n
                              %mo −
                              %mn 1
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                        %mtd
                          %mi underlying
                          %mspace{:width => "thickmathspace"}
                          %mi cocycle
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↑
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %msup
                            %mi Ω
                            %mo •
                          %mo{:stretchy => "false"} (
