                            %mi Ω
                            %mo •
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mi k
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ←
                        %mtd
                          %mi CE
