                              %mrow
                                %msub
                                  %mi d
                                  %mi dR
                      %mtr
                        %mtd
                          %msup
                            %mi Ω
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
