                    %mo {
                    %mi P
                    %mo :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mo ∃
                    %mi F
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo .
                    %mi curv
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo =
