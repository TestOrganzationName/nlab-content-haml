                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Ξ
                  %mo{:stretchy => "false"} (
                  %mspace{:width => "thickmathspace"}
                  %mi const
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 0
                  %mo →
                  %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{\flat} \mathbf{B}^2 U(1)
                  \=
                  \\Xi(
                  \\;
                  const U(1) \to 0 \to 0
                  \\;
                  )
                  \\,.
          %p Above we already found the model
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
