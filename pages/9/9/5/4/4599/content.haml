                  %annotation{:encoding => "application/x-tex"} n
            %a{:href => "#DifferentialCohomology"} above
            is expressed in
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo ≃
