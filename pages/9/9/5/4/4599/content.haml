                    X,\,
                    \\mathbf{\flat}_{dR} \mathbf{B}^n U(1)
                    \\big)
                    \\;\simeq\;
                    H_{dR}^n(X)
                    \\,,
            %p
              where on the left we have the
              = succeed "," do
                %a{:href => "cohesive%20%28infinity,1%29-topos#deRhamCohomology"} intrinsic (∞,1)-topos theoretic notion of de Rham cohomology
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
              of a smooth manifold.
          .proof
            %h6#proof_2 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
