                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Xi[C^\infty(-,U(1)) \stackrel{d_{dR}}{\to} \Omega^1(-) \stackrel{d_{dR}}{\to} \cdots \stackrel{d_{dR}}{\to} \Omega^n_{cl}(-)]
              by the
              %a.existingWikiWord{:href => "/nlab/show/Poincare+lemma"} Poincare lemma
              applied to each
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              (using the same standard logic that proves the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+theorem"} de Rham theorem
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
