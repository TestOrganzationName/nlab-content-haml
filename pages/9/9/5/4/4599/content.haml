          .proof
            %h6#proof Proof
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              amounts to evaluation on the point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^0
              and since constant simplicial presheaves on
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              satisfy
              %a.existingWikiWord{:href => "/nlab/show/descent"} descent
              (on objects in
              = succeed "!)," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CartSp
                    %annotation{:encoding => "application/x-tex"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{\flat} \mathbf{B}^n U(1)
              is represented by the complex of sheaves
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
