                  %semantics
                    %mrow
                      %msubsup
                        %mi Ω
                        %mi cl
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Omega^n_{cl}
                of
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/substitution"} substitution
                by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi curv
                    %annotation{:encoding => "application/x-tex"} curv
                of
            %li
              %p
