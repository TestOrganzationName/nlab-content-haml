            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
          %p
            Above in
            %em
              %a{:href => "#FlatCircleCohomology"} Flat U(1)-valued differential cohomology
            we found a fibrant representative of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
