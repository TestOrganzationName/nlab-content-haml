          %h3#InvariantMetric Invariant metric
          %p
          #CompactLieGroupsAdmitBiinvariantMetrics.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/compact+Lie+groups"} compact Lie groups
                admit
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/bi-invariant+Riemannian+metrics"} bi-invariant Riemannian metrics
              %br/
              Every compact Lie group admits a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bi-invariant+Riemannian+metric"} bi-invariant Riemannian metric
          %p
            (
            %a{:href => "invariant+metric#Milnor76"}> Milnor 76, Cor. 1.4
            )
          %h3#smooth_actions Smooth actions
          #SmoothActionOfCompactLieGroupOnSmoothManifoldIsProper.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
