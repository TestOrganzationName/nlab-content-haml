          %h3#EquivariantTriangulationTheorem Equivariant triangulation theorem
          %p
            The
            %em
              %a.existingWikiWord{:href => "/nlab/show/equivariant+triangulation+theorem"} equivariant triangulation theorem
            (
            %a{:href => "equivariant+triangulation+theorem#Illman78"}> Illman 78
            ,
            = succeed ")" do
              %a{:href => "equivariant+triangulation+theorem#Illman83"} Illman 83
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a compact Lie group and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/action"} action
            = succeed "-" do
