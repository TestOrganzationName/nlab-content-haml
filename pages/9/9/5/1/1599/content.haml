                %a.existingWikiWord{:href => "/nlab/show/continuous+homomorphisms+of+Lie+groups+are+smooth"} continuous homomorphisms of Lie groups are smooth
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
