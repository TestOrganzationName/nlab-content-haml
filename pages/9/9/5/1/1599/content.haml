            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/p-compact+group"} p-compact group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/twisted+ad-equivariant+K-theory"} twisted ad-equivariant K-theory
          %h2#references References
          %p Textbook accounts:
          %ul
            %li#Bredon72
              %p
                %a.existingWikiWord{:href => "/nlab/show/Glen+Bredon"}> Glen Bredon
                , Section 0.6 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Introduction+to+compact+transformation+groups"} Introduction to compact transformation groups
                = succeed "," do
                  %a{:href => "https://www.elsevier.com/books/introduction-to-compact-transformation-groups/bredon/978-0-12-128850-1"} ISBN 9780080873596
                = succeed ")" do
                  %a{:href => "http://www.indiana.edu/~jfdavis/seminar/Bredon,Introduction_to_Compact_Transformation_Groups.pdf"} pdf
            %li#Adams82
              %p
                %a.existingWikiWord{:href => "/nlab/show/Frank+Adams"}> Frank Adams
                ,
                = succeed "," do
                  %em Lectures on Lie groups
                = succeed "," do
                  %a{:href => "https://press.uchicago.edu/ucp/books/book/chicago/L/bo3614673.html"} ISBN:9780226005300
                = succeed ")" do
                  %a{:href => "https://www.google.com/books/edition/Lectures_on_Lie_Groups/TC7d3ZcqjfsC?hl=en"} gbooks
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hans+Duistermaat"}> Hans Duistermaat
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Johan+A.+C.+Kolk"} Johan A. C. Kolk
                = succeed "," do
                  %em Lie groups
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-642-56936-4"} doi:10.1007/978-3-642-56936-4
          %p
            In the broader context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
          %ul
            %li#Lee12
              %a.existingWikiWord{:href => "/nlab/show/John+Lee"}> John Lee
              ,
              = succeed "," do
                %em Introduction to Smooth Manifolds
              = succeed "," do
                %a{:href => "https://doi.org/10.1007/978-1-4419-9982-5"} doi:10.1007/978-1-4419-9982-5
              = succeed ")" do
                %a{:href => "https://lost-contact.mit.edu/afs/adrake.org/usr/rkh/Books/books/Introduction%20to%20Smooth%20Manifolds%20-%20J.%20Lee.pdf"} Draft pdf of the 1st edition
          %p Dedicated lecture notes:
          %ul
            %li#Salamon21
              %a.existingWikiWord{:href => "/nlab/show/Dietmar+Salamon"}> Dietmar Salamon
              ,
              = succeed "," do
                %em Notes on compact Lie groups
              = succeed "," do
                %a{:href => "https://people.math.ethz.ch/~salamon/PREPRINTS/liegroup.pdf"} pdf
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/Salamon_CompactLieGroups.pdf", :title => "pdf"} pdf
          %p
            Discussion in the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/representation+theory"} representation theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
              ,
