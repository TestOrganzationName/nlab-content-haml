              %a.existingWikiWord{:href => "/nlab/show/restriction"} restricts
              to the
              %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
