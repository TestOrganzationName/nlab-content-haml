          .num_defn
            %h6#definition_2 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (B,f)
              = succeed "," do
                %a.maruku-ref{:href => "#BfStructure"}
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (B,f)
                \-structure on the manifold
              is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
              of the following structure:
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mi X
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo ↪
                        %msup
                          %mi ℝ
                          %mi k
                      %annotation{:encoding => "application/x-tex"} i_X \; \colon \; X \hookrightarrow \mathbb{R}^k
                  for some
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+class"} homotopy class
                  of a
                  %a.existingWikiWord{:href => "/nlab/show/lift"} lift
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi g
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat g
                  of the classifying map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %msub
                                  %mi B
                                  %mi n
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mover
                                      %mi g
                                      %mo{:stretchy => "false"} ^
                                %mo ↗
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %msub
                                        %mi f
                                        %mi n
                            %mtr
                              %mtd
                                %mi X
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mi g
                              %mtd
                                %mi B
                                %mi O
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; B_{n}
                        \\\
                        \&amp;{}^{\mathllap{\hat g}}\nearrow&amp; \downarrow^{\mathrlap{f_n}}
                        \\\
                        X &amp;\overset{g}{\longrightarrow}&amp; B O(n)
                        }
                        \\,.
            %p
              The equivalence relation on such structures is to be that generated by the relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∼
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo ,
                    %msub
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((i_{X})_1, \hat g_1) \sim ((i_{X})_,\hat g_2)
              if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi k
                          %mn 2
                        %mo ≥
                        %msub
                          %mi k
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} k_2 \geq k_1
              %li
                %p the second inclusion factors through the first as
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mn 2
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mover
                          %mo ↪
                          %mrow
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi i
                              %mi X
                            %msub
                              %mo{:stretchy => "false"} )
                              %mn 1
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi k
                              %mn 1
                        %mo ↪
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi k
                              %mn 2
                      %annotation{:encoding => "application/x-tex"}
                        (i_X)_2
                        \\;\colon\;
                        X
                        \\overset{(i_X)_1}{\hookrightarrow}
                        \\mathbb{R}^{k_1}
                        \\hookrightarrow
                        \\mathbb{R}^{k_2}
              %li
                %p the lift of the classifying map factors accordingly (as homotopy classes)
