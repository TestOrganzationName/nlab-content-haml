                    %mi 𝒰
                  %annotation{:encoding => "application/x-tex"} \mathcal{U}
          %p
            Let the
            %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ≡
                    %mrow
                      %mi I
                      %mo ,
                      %mi J
                %annotation{:encoding => "application/x-tex"} \equiv_{I, J}
            in the Cartesian product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo ,
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(I, \mathbb{Q}) \times C(J, \mathbb{Q})
            for directed sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            be defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %msub
                    %mo ≡
                    %mrow
                      %mi I
                      %mo ,
                      %mi J
                  %mi b
                  %mo ≔
                  %mo ∀
                  %mi ϵ
                  %mo ∈
                  %msub
