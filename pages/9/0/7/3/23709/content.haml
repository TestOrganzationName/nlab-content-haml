                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo ,
                  %mo ∃
                  %mi M
                  %mo ∈
                  %mi I
                  %mo .
                  %mo ∀
                  %mi i
                  %mo ∈
                  %mi I
                  %mo .
                  %mo ∃
                  %mi N
                  %mo ∈
                  %mi J
                  %mo .
                  %mo ∀
                  %mi j
                  %mo ∈
                  %mi J
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ≥
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo ≥
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi a
                    %mi i
                  %mo −
                  %msub
                    %mi b
                    %mi j
                  %mo{:stretchy => "false"} |
                  %mo &lt;
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a \equiv_{I, J} b \coloneqq \forall \epsilon \in \mathbb{Q}_{+}, \exists M \in I. \forall i \in I. \exists N \in J. \forall j \in J. (i \geq M) \wedge (j \geq N) \wedge (\vert a_i - b_j \vert \lt \epsilon)
          %p
            Let a
            %em generalized Cauchy algebra
            be defined as a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mo ∈
                  %msup
                    %mi A
                    %mrow
                      %mi CauchyNetsIn
                      %mo{:stretchy => "false"} (
                      %mi ℚ
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \iota \in {A}^{CauchyNetsIn(\mathbb{Q})}
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi I
                  %mo ∈
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi DirectedSet
                    %mi 𝒰
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mo ∀
                  %mi J
                  %mo ∈
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi DirectedSet
                    %mi 𝒰
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mo ∀
                  %mi a
                  %mo ∈
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mo ∀
                  %mi b
                  %mo ∈
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo ,
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi a
                  %msub
                    %mo ≡
                    %mrow
                      %mi I
                      %mo ,
                      %mi J
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⇒
