          %h3#using_nets Using nets
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            be the
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            and let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℚ
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo ∈
                  %mi ℚ
                  %mo{:stretchy => "false"} |
                  %mn 0
                  %mo &lt;
                  %mi x
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}_{+} \coloneqq \{x \in \mathbb{Q} \vert 0 \lt x\}
          %p
            be the set of positive rational numbers. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
