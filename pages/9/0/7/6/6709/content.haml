          %h2#idea Idea
          %p
            A family of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spin%5Ec+structure"} spin^c structure
            %a.existingWikiWord{:href => "/nlab/show/w4-orientation+of+EO%282%29-theory"} orientation of EO(2)-theory
            etc.
          %p
            Stiefel-Whitney classes have coefficients in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
            %a.existingWikiWord{:href => "/nlab/show/Bockstein+homomorphism"} Bockstein homomorphism
            they are lifted to
            = succeed "es." do
              %a.existingWikiWord{:href => "/nlab/show/integral+Stiefel-Whitney+class"} integral Stiefel-Whitney class
          %h2#Definition Definition
          #AxiomaticDefinition.num_defn
            %h6#definition_2 Definition
            %p
              %strong (axiomatic definition)
            %p
              The
              %em Stiefel-Whitney classes
              are
              %a.existingWikiWord{:href => "/nlab/show/characteristic+classes"} characteristic classes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi w
                      %mi i
                    %mo ∈
                    %msup
                      %mi H
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} w_i \in H^{i}(B O(n), \mathbb{Z}_2)
              on the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              of the
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
              in
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi w
                          %mn 0
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} w_0 = 1
                  and if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo &gt;
                        %mi n
                      %annotation{:encoding => "application/x-tex"} i \gt n
                  then
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi w
                            %mi i
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} w_i = 0
              %li
                %p
                  for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo =
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n = 1
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi w
                            %mn 1
                          %mo ≠
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} w_1 \neq 0
              %li
                %p
                  for the inclusion
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ι
                        %mo :
                        %mi B
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mi B
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \iota : B O(n) \hookrightarrow B O(n+1)
                  we have
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ι
                            %mo *
                          %msubsup
                            %mi w
                            %mi i
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mo =
                          %msubsup
                            %mi w
                            %mi i
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \iota^* w_i^{(n+1)} = w_i^{(n)}
              %li
                %p
                  %strong> sum rule
                  \: for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo ,
                        %mi l
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} k,l \in \mathbb{N}
                  with the canonical inclusion
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ι
                        %mo :
                        %mi B
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi B
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi l
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi B
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo +
                        %mi l
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\iota : B O(k) \times B O(l) \to B O(k+l)
                %p
                  we have for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} i \in \mathbb{N}
                  that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ι
                          %mo *
                        %msub
                          %mi w
                          %mi i
                        %mo =
                        %munderover
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi j
                            %mo =
                            %mn 0
                          %mi i
                        %msub
                          %mi w
                          %mi j
                        %mo ∪
                        %msub
                          %mi w
                          %mrow
                            %mi i
                            %mo −
                            %mi j
                      %annotation{:encoding => "application/x-tex"}
                        \\iota^* w_i = \sum_{j = 0}^i w_j \cup w_{i-j}
                %p
                  (on the right the
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
          #TotalSWClass.num_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \to X
              a real
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              %strong total universal Stiefel-Whitney class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} w(E)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi w
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    w(E) \coloneqq \sum_i w_i(E) \in H^\bullet(X, \mathbb{Z}_2)
            %p
              as an element in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
          .num_remark
            %h6#remark Remark
            %p
              For the total SW class of def.
              = succeed "," do
                %a.maruku-ref{:href => "#TotalSWClass"}
              %a.maruku-ref{:href => "#AxiomaticDefinition"}
              says equivalently that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mo ,
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_1, E_2
              two real
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum of vector bundles
              is the
              %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
              of the separate classes:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi E
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi w
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mi w
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    w(E_1 \oplus E_2) = w(E_1) \cup w(E_2)
                    \\,.
          %h2#constructions Constructions
          %p (…)
          %h2#properties Properties
          %h3#spanning_the_cohomology_ring_of_
            Spanning the cohomology ring of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi SO
                %annotation{:encoding => "application/x-tex"} B SO
          .num_prop
            %h6#proposition Proposition
            %p
              Every class in the
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^\bullet(B O(n), \mathbb{Z}_2)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi S
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^\bullet(B S O(n), \mathbb{Z}_2)
              of the
              %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
              of the (
              %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"}> special
              )
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              is uniquely a
              %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
              in the Stiefel-Whitney classes. In fact the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+rings"} cohomology rings
              are
              %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
              algebras over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              in the SW classes:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi w
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi w
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(B O(n), \mathbb{Z}_2)
                    \\simeq
                    \\mathbb{Z}_2[w_1, \cdots, w_n]
                    \\,,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi S
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi w
                      %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi w
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(B S O(n), \mathbb{Z}_2)
                    \\simeq
                    \\mathbb{Z}_2[w_2, \cdots, w_n]
                    \\,.
          %p
            (
            %a{:href => "#MilnorStasheff74"}> Milnor &amp; Stasheff 74, Theorem 7.1. &amp; Theorem 12.4.
            )
          %h3#whitney_duality_formula Whitney duality formula
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↪
                  %msup
                    %mi ℝ
                    %mi q
                %annotation{:encoding => "application/x-tex"} X \hookrightarrow \mathbb{R}^q
            an
            %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
            of a compact manifold, write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo :
                  %mo =
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} \tau := T X
            for the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                %annotation{:encoding => "application/x-tex"} \nu
            for the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/normal+bundle"} normal bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo ⊕
                  %mi ν
                  %mo ≃
                  %mi T
                  %msup
                    %mi ℝ
                    %mi q
                %annotation{:encoding => "application/x-tex"}
                  \\tau \oplus \nu \simeq T \mathbb{R}^q
          %p
            and the class of the vector bundle on the right is trivial, the sum rule for the SW classes says gives the
            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            duality
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mo{:stretchy => "false"} (
                  %mi τ
                  %mo{:stretchy => "false"} )
                  %mo ∪
                  %mi w
                  %mo{:stretchy => "false"} (
                  %mi ν
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  w(\tau) \cup w(\nu) = 1
                  \\,.
          %h3#RelationToChernClasses Relation to Chern-classes
          .num_prop
            %h6#proposition_2 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi ℂ
                  %annotation{:encoding => "application/x-tex"} E_{\mathbb{C}}
              is a complex
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(n)
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi ℝ
                  %annotation{:encoding => "application/x-tex"} E_{\mathbb{R}}
              is the underlying real vector bundle /
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(2n)
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              then the second Stiefel-Whitney class is given by the
              %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
              mod 2:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi w
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mi mod
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    w_2(E_{\mathbb{R}}) = c_1(E_{\mathbb{C}}) \; mod 2
                    \\,.
          .num_cor
            %h6#corollary Corollary
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/almost+complex+structure"} almost complex structure
              on the
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of a
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              induces a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spin%5Ec+structure"} spin^c structure
          %p
            This is discussed at
            = succeed "." do
              %em
                %a{:href => "spin^c+structure#FromAlmostComplexStructures"} Spin^c-structure – From almost complex structures
          .num_remark
            %h6#remark_2 Remark
            %p
              More generally, the SW classes are then given by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
              = succeed "." do
                %a{:href => "#MilnorStasheff"} Milnor-Stasheff, p. 171
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+number"} Stiefel-Whitney number
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/orientation"}> orientation
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Spin+structure"} Spin structure
                %a.existingWikiWord{:href => "/nlab/show/w4-structure"} w4-structure
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"}> Pontryagin class
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Wu+class"} Wu class
                %a.existingWikiWord{:href => "/nlab/show/one-loop+anomaly+polynomial+I8"} one-loop anomaly polynomial I8
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+calculus"} orthogonal calculus
          %h2#references References
          %p
            Named after
            %a.existingWikiWord{:href => "/nlab/show/Eduard+Stiefel"} Eduard Stiefel
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hassler+Whitney"} Hassler Whitney
          %p Textbook accounts include
          %ul
            %li#MilnorStasheff
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Milnor"}> John Milnor
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} James D. Stasheff
                = succeed "," do
                  %em Characteristic Classes
            %li#Kochmann96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochmann"}> Stanley Kochmann
                , section 2.3 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                , chapter 23, section 3 of
                %em A concise course in algebraic topology
                (
                %a{:href => "http://www.math.uchicago.edu/~may/CONCISE/ConciseRevised.pdf"}> pdf
                )
          %p
            Discussion with an eye towards
            %a.existingWikiWord{:href => "/nlab/show/mathematical+physics"} mathematical physics
          %ul
            %li#RudolhSchmidt
              Gerd Rudolph, Matthias Schmidt,
              = succeed "," do
                %em Differential Geometry and Mathematical Physics: Part II. Fibre Bundles, Topology and Gauge Fields
              = succeed ")" do
                %a{:href => "https://link.springer.com/book/10.1007/978-94-024-0959-8"} doi:10.1007/978-94-024-0959-8
          %p
            Stiefel-Whitney classes generating the
            %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi BO
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} BO(n)
          %ul
            %li#MilnorStasheff74
              %a.existingWikiWord{:href => "/nlab/show/John+Milnor"}> John Milnor
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
              = succeed "," do
                %em Characteristic classes
              = succeed "," do
                %a{:href => "https://press.princeton.edu/books/paperback/9780691081229/characteristic-classes-am-76-volume-76"} ISBN:9780691081229
              = succeed "," do
                %a{:href => "https://doi.org/10.1515/9781400881826"} doi:10.1515/9781400881826
              = succeed ")" do
                %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/milnstas.pdf"} pdf
          %p See also
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "http://en.wikipedia.org/wiki/Stiefel%E2%80%93Whitney_class"} Stiefel-Whitney class
