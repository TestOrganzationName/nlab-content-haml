                          %mi S
                          %mo{:stretchy => "false"} (
                          %mi 𝒱
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} T_{S(p)} S(\mathcal{V})
              %li
                %p
                  hence the homotopy-commutativity of the diagram says that the once-
                  %a.existingWikiWord{:href => "/nlab/show/stable+tangent+bundle"} stabilized
                  vertical tangent bundle is the
                  %a.existingWikiWord{:href => "/nlab/show/pullback+bundle"} pullback
                  of the original bundle on the base:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
