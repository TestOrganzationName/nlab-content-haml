                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi ℝ
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mo ≃
                          %mrow
                            %msub
                              %mrow
                              %mi X
                        %mspace{:width => "thickmathspace"}
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi p
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
