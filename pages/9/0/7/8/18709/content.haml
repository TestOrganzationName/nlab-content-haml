              Then:
            %ol
              %li
                %p
                  the top map shown classifies the
                  %a.existingWikiWord{:href => "/nlab/show/vertical+tangent+bundle"} vertical tangent bundle
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi T
