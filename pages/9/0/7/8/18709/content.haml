                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        T_{S(p)}
                        S(\mathcal{V})
                        \\times \mathbb{R}
                        \\;\simeq_{{}_{X}}\;
                        S(p)^\ast
                        \\big(
                        \\mathcal{V}
                        \\big)
                        \\,.
            %p
          %h3#tangent_bundles_of_sphere_bundles Tangent bundles of sphere bundles
          %p
            The following generalizes Cor.
            %a.maruku-ref{:href => "#OnceStabilizedVerticalTangentBundlesOfSphereBundlesArePulledBackFromBase"}
            to the full
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            of sphere-fiber bundles, now assuming that the base is a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            and giving a more traditional
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential-geometric
            %a.existingWikiWord{:href => "/nlab/show/proof"} proof
            (the following statement appears, without proof, as
            = succeed "," do
              %a{:href => "#CrowleyEscher03"} Crowley-Escher 03, Fact. 3.1
            = succeed "):" do
              %a{:href => "#Milnor1956"} Milnor 56, p. 403
          %p
          #StableTangentBundleOfUnitSphereBundle.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/stable+tangent+bundle"} stable tangent bundle
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/unit+sphere+bundle"} unit sphere bundle
              %br/
              The once-
              %a.existingWikiWord{:href => "/nlab/show/stable+tangent+bundle"} stabilized
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of a
              %a.existingWikiWord{:href => "/nlab/show/unit+sphere+bundle"} unit sphere bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(\mathcal{V})
              in a
              %a.existingWikiWord{:href => "/nlab/show/real+vector+bundle"} real vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                    %mover
                      %mo ⟶
                      %mi p
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \mathcal{V} \overset{p}{\longrightarrow} M
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#UnitSphereBundles"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/pullback+bundle"} pullback
              of the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum
              of the
              %a.existingWikiWord{:href => "/nlab/show/stable+tangent+bundle"} stable tangent bundle
              of the base manifold with that vector bundle:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi ℝ
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi T
                    %mi M
                    %msub
                      %mo ⊕
                      %mi M
                    %mi 𝒱
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T S(\mathcal{V}) \times \mathbb{R}
                    \\;
                    \\simeq
                    \\;
                    S(p)^\ast
                    \\big(
                    T M
                    \\oplus_M
                    \\mathcal{V}
                    \\big)
                    \\,.
            %p
          %p
          #ProofOfStableTangentBundleOfUnitSphereBundle.proof
            %h6 Proof
            %p
              Consider first the actual
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              but to the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/disk"} disk
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(\mathcal{V})
              that fills the given sphere-fiber bundle: By the standard splitting (
              %a{:href => "vertical+vector+field#SplittingOfTotalSpaceTangentBundle"}> this Prop.
              ) this is the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi T
                    %mi M
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %msub
                      %mo ⊕
                      %mi M
                    %msub
                      %mi T
                      %mi p
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    T
                    \\big(
                    D(\mathcal{V})
                    \\big)
                    \\;\simeq\;
                    \\big(
                    D(p)^\ast T M
                    \\big)
                    \\oplus_M
                    T_p D(\mathcal{V})
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi p
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T_p D(\mathcal{V})
              is the
              %a.existingWikiWord{:href => "/nlab/show/vertical+tangent+bundle"} vertical tangent bundle
              of the disk bundle. But, by definition of disk bundles, this is the restriction of the vertical tangent bundle of the vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
              itself, and that is just the pullback of that vector bundle along itself (by
              = succeed "):" do
                %a{:href => "vertical+vector+field#SplittingOfTotalSpaceTangentBundle"} this Example
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi p
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mi T
                            %mi M
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %msub
                              %mo ⊕
                              %mi M
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi p
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mi 𝒱
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi p
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi T
                            %mi M
                            %msub
                              %mo ⊕
                              %mi M
                            %mi 𝒱
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\cdots
                    \&amp;
                    \\simeq\;
                    \\big(
                    D(p)^\ast T M
                    \\big)
                    \\oplus_M
                    \\big(
                    D(p)^\ast \mathcal{V}
                    \\big)
                    \\\
                    \&amp; \simeq\;
                    D(p)^\ast
                    \\big(
                    T M \oplus_M \mathcal{V}
                    \\big)
                    \\,.
                    \\end{aligned}
            %p
              To conclude, it just remains to observe that the
              %a.existingWikiWord{:href => "/nlab/show/normal+bundle"} normal bundle
              of the
              = succeed "-boundary" do
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              = succeed "-ball" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"} trivial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(\mathcal{V})
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(\mathcal{V})
              is the
              %a.existingWikiWord{:href => "/nlab/show/stable+tangent+bundle"} stable tangent bundle
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi 𝒱
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S(\mathcal{V})
          %p
          .num_remark
            %h6 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#StableTangentBundleOfUnitSphereBundle"}
              implies that every
              %em stable
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
              of the
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of an orthogonal
              %a.existingWikiWord{:href => "/nlab/show/sphere-fiber+bundle"} sphere-fiber bundle
              – i.e all
              %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
              in its
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin+classes"} Pontryagin classes
              – are
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/basic+differential+form"} basic
              %a.existingWikiWord{:href => "/nlab/show/pullback+in+cohomology"} pulled back
              from the base space.
          %h2#examples Examples
          %h3#unit_sphere_bundles Unit sphere bundles
          %p
          #UnitSphereBundles.num_remark
            %h6 Example
            %p
              A key example of sphere fiber bundles are the
              %em unit sphere bundles
              inside of
              %a.existingWikiWord{:href => "/nlab/show/real+vector+bundles"} real vector bundles
              that are equipped with
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+structure"} orthogonal structure
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              are the
              %a.existingWikiWord{:href => "/nlab/show/unit+spheres"} unit spheres
              in the corresponding fiber of the given
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/real+vector+bundle"} real vector bundle
          %p
            These appear in the discussion of
            %a.existingWikiWord{:href => "/nlab/show/Thom+spaces"} Thom spaces
            and hence of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectra"} Thom spectra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/wave+front+sets"} wave front sets
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+a+spherical+fibration"} Sullivan model of a spherical fibration
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/twisted+Cohomotopy"} twisted Cohomotopy
          %h2#references References
          %p
            Early discussion of sphere bundles (and introducing the general notion of
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundles"} fiber bundles
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hassler+Whitney"}> Hassler Whitney
              ,
              = succeed "," do
                %em On the theory of sphere-bundles
              %strong 26
              2 (1940) 148-153 &amp;lbrack;
              %a{:href => "https://doi.org/10.1073/pnas.26.2.148"}> doi:10.1073/pnas.26.2.148
              \&amp;rbrack;
          %p
            With focus on
            = succeed "-fiber" do
              %a.existingWikiWord{:href => "/nlab/show/3-sphere"} 3-sphere
            %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
            and the construction of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/exotic+7-spheres"} exotic 7-spheres
          %ul
            %li#Milnor1956
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Milnor"}> John Milnor
                ,
                = succeed "," do
                  %em On manifolds homeomorphic to the 7-sphere
                = succeed "," do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/exotic.pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1142/9789812836878_0001"} doi:10.1142/9789812836878_0001
            %li#CrowleyEscher03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Diarmuid+Crowley"}> Diarmuid Crowley
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christine+Escher"} Christine Escher
                = succeed "," do
                  %em
                    A classification of
                    = succeed "-bundles" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi S
                              %mn 3
                          %annotation{:encoding => "application/x-tex"} S^3
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 4
                        %annotation{:encoding => "application/x-tex"} S^4
                = succeed "))" do
                  %a{:href => "https://doi.org/10.1016/S0926-2245(03)00012-3"} doi:10.1016/S0926-2245(03)00012-3
          %p
            On sphere fiber bundles as
            %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+compactifications"} Kaluza-Klein compactifications
            in
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Federico+Bonetti"}> Federico Bonetti
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ruben+Minasian"} Ruben Minasian
              %em Consistent truncations from the geometry of sphere bundles
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2212.08068"}> arXiv:2212.08068
              \&amp;rbrack;
          %p
            On sphere bundles with
            %a.existingWikiWord{:href => "/nlab/show/formal+dg-algebra"} formal
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+models"} Sullivan models
          %ul
            %li
              Jiawei Zhou,
              %em Formality of Sphere Bundles
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2304.09594"}> arXiv:2304.09594
              \&amp;rbrack;
