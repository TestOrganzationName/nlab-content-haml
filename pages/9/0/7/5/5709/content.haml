                        %annotation{:encoding => "application/x-tex"} [0,\infty)
                  %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinition"} interaction vertex redefinition
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi 𝒵
                          %mi Λ
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi Λ
                            %mo ∈
                            %msub
                              %mi ℝ
                              %mrow
                                %mo ≥
