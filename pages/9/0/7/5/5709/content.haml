                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi T
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\Lambda \to \infty}{\lim}
                    \\left(
                    T_\Lambda \circ \mathcal{Z}_{\leq n, \Lambda}
                    \\right)_n
                    \\;=\;
                    T_n
                    \\,.
            %p
              We proceed by
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %p
              Since by definition
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                      %mo =
                      %msub
                        %mi const
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} T_0 = const_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"} T_1 = id
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Z
                        %mn 0
                      %mo =
                      %msub
                        %mi const
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} Z_0 = const_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mn 1
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"} Z_1 = id
              the statement is trivially true for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n = 1
            %p
              So assume now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi Z
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ≤
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \{Z_{k}\}_{k \leq n}
              has been found such that
              %a.maruku-eqref{:href => "#eq:CountertermsInductionAssumption"} (2)
              holds.
            %p
              Observe that with the chosen renormalizing projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                  %annotation{:encoding => "application/x-tex"} p_{\rho_{n+1}}
              the time-ordered product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} T_{n+1}
              may be expressed as follows:
            #eq:RenormalizedSMatrixAsLimitOfEffectiveSMatricesEvaluatedOnProjection.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
