                  %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda'}
              (
              %a{:href => "star+product#PropagatorStarProduct"}> this def.
              ).
          %p
            This goes back to (
            %a{:href => "#Polchinski84"}> Polchinski 84, (27)
            ). The rigorous formulation and proof is due to (
            %a{:href => "#BrunettiDuetschFredenhagen09"}> Brunetti-Dütsch-Fredenhagen 09, prop. 5.2
            ,
            = succeed ")." do
              %a{:href => "#Duetsch10"} Dütsch 10, theorem 2
          .proof
