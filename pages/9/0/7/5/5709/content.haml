            = succeed ")" do
              %a{:href => "#Duetsch18"} Dütsch 18, example 3.126
          #SMatrixEffective.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix+scheme"}> effective S-matrix scheme
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (according to
              = succeed ")" do
                %a{:href => "S-matrix#VacuumFree"} this def.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi Δ
                          %mrow
                            %mi F
                            %mo ,
                            %mi Λ
                        %mo }
                      %mrow
                        %mi Λ
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \left\{ \Delta_{F,\Lambda}\right\}_{\Lambda \in [0,\infty)}
              be a choice of
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoffs"} UV cutoffs
              for
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              around this vacuum (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
            %p
              We say that the
              %em
                %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix+scheme"} effective S-matrix scheme
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\Lambda
              at cutoff scale
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Lambda \in [0,\infty)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi PolyObs
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi mc
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} [
                            %mi ℏ
                            %mo ,
                            %mi g
                            %mo ,
                            %mi j
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi 𝒮
                                  %mi Λ
                          %mtd
                            %mi PolyObs
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi mc
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} [
                            %mi ℏ
                            %mo ,
                            %mi g
                            %mo ,
                            %mi j
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mi O
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi 𝒮
                              %mi Λ
                            %mo{:stretchy => "false"} (
                            %mi O
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar, g, j] ]
                    \&amp;\overset{\mathcal{S}_{\Lambda}}{\longrightarrow}&amp;
                    PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar, g, j] ]
                    \\\
                    O &amp;\mapsto&amp; \mathcal{S}_\Lambda(O)
                    }
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/exponential+series"} exponential series
            #eq:EffectiveSMatrixScheme.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒮
                              %mi Λ
                            %mo{:stretchy => "false"} (
                            %mi O
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %msub
                              %mi exp
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %mrow
                              %mo (
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi i
                                  %mi ℏ
                              %mi O
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 1
                            %mo +
                            %mfrac
                              %mn 1
                              %mrow
                                %mi i
                                %mi ℏ
                            %mi O
                            %mo +
                            %mfrac
                              %mn 1
                              %mn 2
                            %mfrac
                              %mn 1
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mi ℏ
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 2
                            %mi O
                            %msub
                              %mo ⋆
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %mi O
                            %mo +
                            %mfrac
                              %mn 1
                              %mrow
                                %mn 3
                                %mo !
                            %mfrac
                              %mn 1
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mi ℏ
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 3
                            %mi O
                            %msub
                              %mo ⋆
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %mi O
                            %msub
                              %mo ⋆
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %mn 0
                            %mo +
                            %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathcal{S}_\Lambda(O)
                    \&amp; \coloneqq
                    \\exp_{F,\Lambda}\left( \frac{1}{i \hbar} O \right)
                    \\\
                    \&amp; =
                    1
                    +
                    \\frac{1}{i \hbar} O
                    +
                    \\frac{1}{2} \frac{1}{(i \hbar)^2} O \star_{F,\Lambda} O
                    +
                    \\frac{1}{3!} \frac{1}{(i \hbar)^3} O \star_{F,\Lambda} O \star_{F,\Lambda} 0
                    +
                    \\cdots
                    \\end{aligned}
                    \\,.
            %p
              with respect to the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋆
                      %mrow
                        %mi F
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} \star_{F,\Lambda}
              induced by the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
              (
              %a{:href => "star+product#PropagatorStarProduct"}> this def.
              ).
            %p
              This is evidently defined on all
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              as shown, and restricts to an endomorphism on
              %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
              as shown, since the contraction coefficients
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
          %p
            (
            %a{:href => "#Duetsch10"}> Dütsch 10, (4.2)
            )
          #UVRegularization.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
