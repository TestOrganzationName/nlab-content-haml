              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BrST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    g S_{int} + j A
                    \\;\in\;
                    LocObs(E_{\text{BV-BrST}})[ [ \hbar, g, j] ]\langle g, j\rangle
            %p
              regarded as an
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %p
              Then def.
              %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
              and def.
              %a.maruku-ref{:href => "#EffectiveActionRelative"}
              say that for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Lambda \in (0,\infty)
              the
              %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix"} effective S-matrix
              %a.maruku-eqref{:href => "#eq:EffectiveSMatrixScheme"} (1)
              of the
              %a.existingWikiWord{:href => "/nlab/show/relative+effective+action"} relative effective action
              %a.maruku-eqref{:href => "#eq:RelativeEffectiveActionComposite"} (10)
              equals the genuine
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\infty
              of the genuine
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                    %annotation{:encoding => "application/x-tex"} g S_{int} + j A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mi Λ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mrow
                        %mi eff
                        %mo ,
                        %mi Λ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝒮
                      %mn ∞
                    %mrow
                      %mo (
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}_\Lambda( S_{eff,\Lambda} )
                    \\;=\;
                    \\mathcal{S}_\infty\left( g S_{int} + j A  \right)
                    \\,.
            %p
              In other words the
              %a.existingWikiWord{:href => "/nlab/show/relative+effective+action"} relative effective action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi eff
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} S_{eff,\Lambda}
              encodes what the actual
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              defined by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mn ∞
                    %mrow
                      %mo (
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\infty\left( g S_{int} + j A  \right)
              %em effectively
              looks like at
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                    %annotation{:encoding => "application/x-tex"} \Lambda
            %p
              Therefore one says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi eff
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} S_{eff,\Lambda}
              defines
              %em
                %a.existingWikiWord{:href => "/nlab/show/effective+quantum+field+theory"} effective quantum field theory
              at
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                    %annotation{:encoding => "application/x-tex"} \Lambda
            %p
              Notice that in general
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi eff
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} S_{eff,\Lambda}
              is
              %em
                not a
                %a.existingWikiWord{:href => "/nlab/show/local+observable"} local
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              anymore: By prop.
              %a.maruku-ref{:href => "#EffectiveSmatrixSchemeInvertible"}
              the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of the
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒮
                      %mi Λ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}^{-1}_\Lambda
              of the
              %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix"} effective S-matrix
              is
              %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo +
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} 1 + PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar, g, j] ]\langle g,j\rangle
              and there is no guarantee that this lands in the subspace of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            %p
              Therefore
              %a.existingWikiWord{:href => "/nlab/show/effective+quantum+field+theories"} effective quantum field theories
              at finite
              = succeed "-scale" do
                %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Lambda \in [0,\infty)
              are in general
              %em not
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+field+theories"} local field theories
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo →
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \Lambda \to \infty
              is, via prop.
              = succeed "." do
                %a.maruku-ref{:href => "#UVRegularization"}
          #EffectiveActionAsRelativeEffectiveAction.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/effective+action"} effective action
                is
                %a.existingWikiWord{:href => "/nlab/show/relative+effective+action"} relative effective action
                at
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Λ
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \Lambda = 0
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (according to
              = succeed ")" do
                %a{:href => "S-matrix#VacuumFree"} this def.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi Δ
                          %mrow
                            %mi F
                            %mo ,
                            %mi Λ
                        %mo }
                      %mrow
                        %mi Λ
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \left\{ \Delta_{F,\Lambda}\right\}_{\Lambda \in [0,\infty)}
              be a choice of
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoffs"} UV cutoffs
              for
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              around this vacuum (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/relative+effective+action"} relative effective action
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EffectiveActionRelative"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Lambda = 0
              is the actual
              %a.existingWikiWord{:href => "/nlab/show/effective+action"} effective action
              (
              %a{:href => "S-matrix#InPerturbationTheoryActionEffective"}> this def.
              ) being
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} i \hbar
              times the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"} Feynman perturbation series
              of
              %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(g S_{int} + j A)
              for
              %a.existingWikiWord{:href => "/nlab/show/connected+graph"} connected
              %a.existingWikiWord{:href => "/nlab/show/Feynman+diagrams"} Feynman diagrams
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi S
                              %mrow
                                %mi eff
                                %mo ,
                                %mn 0
                          %mtd
                            %mo ≔
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi S
                              %mrow
                                %mi eff
                                %mo ,
                                %mn 0
                                %mo ,
                                %mn ∞
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi S
                              %mi eff
                            %mspace{:width => "thickmathspace"}
                            %mo ≔
                            %mspace{:width => "thickmathspace"}
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi Γ
                                %mo ∈
                                %msub
                                  %mi Γ
                                  %mi conn
                            %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi g
                            %msub
                              %mi S
                              %mi int
                            %mo +
                            %mi j
                            %mi A
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    S_{eff,0}
                    \&amp; \coloneqq\;
                    S_{eff,0,\infty}
                    \\\
                    \&amp; = S_{eff} \;\coloneqq\;
                    \\underset{\Gamma \in \Gamma_{conn}}{\sum}
                    \\Gamma(g S_{int} + j A)
                    \\end{aligned}
                    \\,.
          %p
            (
            %a{:href => "#Duetsch18"}> Dütsch 18, (3.473)
            )
          .proof
            %h6#proof_3 Proof
            %p
              Observe that the
              %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix+scheme"} effective S-matrix scheme
              at scale
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Lambda = 0
              %a.maruku-eqref{:href => "#eq:EffectiveSMatrixScheme"} (1)
              is the
              %a.existingWikiWord{:href => "/nlab/show/exponential+series"} exponential series
              with respect to the pointwise product (
              %a{:href => "A+first+idea+of+quantum+field+theory#Observable"}> this def.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi exp
                      %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}_0(O) = \exp_\cdot( O )
                    \\,.
            %p
              Therefore the statement to be proven says equivalently that the
              %a.existingWikiWord{:href => "/nlab/show/exponential+series"} exponential series
              of the
              %a.existingWikiWord{:href => "/nlab/show/effective+action"} effective action
              with respect to the pointwise product is the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi exp
                      %mo ⋅
                    %mrow
                      %mo (
                      %mfrac
                        %mn 1
                        %mrow
                          %mi i
                          %mi ℏ
                      %msub
                        %mi S
                        %mi eff
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝒮
                      %mn ∞
                    %mrow
                      %mo (
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\exp_\cdot\left( \frac{1}{i \hbar} S_{eff} \right)
                    \\;=\;
                    \\mathcal{S}_\infty\left( g S_{int} + j A \right)
                    \\,.
            %p
              That this is the case is the statement of
              = succeed "." do
                %a{:href => "S-matrix#LogarithmEffectiveAction"} this prop.
          %h4#renormalization_via_wilsonian_rg_flow (“Re”-)Normalization via Wilsonian RG flow
          %p
            The definition of the
            %a.existingWikiWord{:href => "/nlab/show/relative+effective+action"} relative effective action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒮
                    %mrow
                      %mi eff
                      %mo ,
                      %mi Λ
                  %mo ≔
                  %msub
                    %mi 𝒮
                    %mrow
                      %mi eff
                      %mo ,
                      %mi Λ
                      %mo ,
                      %mn ∞
                %annotation{:encoding => "application/x-tex"} \mathcal{S}_{eff,\Lambda} \coloneqq \mathcal{S}_{eff,\Lambda, \infty}
            in def.
            %a.maruku-ref{:href => "#EffectiveActionRelative"}
            invokes a choice of
            %a.existingWikiWord{:href => "/nlab/show/UV+regularization"} UV regularization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒮
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \mathcal{S}_\infty
            (prop.
            = succeed ")." do
              %a.maruku-ref{:href => "#UVRegularization"}
            %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
            this is guaranteed to exist, in practice one is after methods for constructing this without specifying it a priori.
          %p
            But the collection
            %a.existingWikiWord{:href => "/nlab/show/relative+effective+actions"} relative effective actions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒮
                    %mrow
                      %mi eff
                      %mo ,
                      %mi Λ
                      %mo ,
                      %msub
                        %mi Λ
                        %mn 0
                %annotation{:encoding => "application/x-tex"} \mathcal{S}_{eff,\Lambda, \Lambda_0}
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Λ
                    %mn 0
                  %mo &lt;
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \Lambda_0 \lt \infty
            “flows” with the cutoff-parameters
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                %annotation{:encoding => "application/x-tex"} \Lambda
            and in particular also with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Λ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \Lambda_0
            (remark
            %a.maruku-ref{:href => "#GroupoidOfEFTs"}
            below) which suggests that examination of this flow yields information about full theory at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\infty
          %p
            This is made precise by
            %em
              %a.existingWikiWord{:href => "/nlab/show/Polchinski%27s+flow+equation"} Polchinski's flow equation
            (prop.
            %a.maruku-ref{:href => "#FlowEquationPolchinski"}
            below), which is the
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal"} infinitesimal
            version of the “
            %a.existingWikiWord{:href => "/nlab/show/Wilsonian+RG+flow"}> Wilsonian RG flow
            ” (remark
            = succeed ")." do
              %a.maruku-ref{:href => "#GroupoidOfEFTs"}
            %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
            it is
            %em independent
            of the choice of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒮
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \mathcal{S}_{\infty}
            and hence may be used to solve for the
            %a.existingWikiWord{:href => "/nlab/show/Wilsonian+RG+flow"} Wilsonian RG flow
            without knowing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒮
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \mathcal{S}_\infty
            in advance.
          %p
            The freedom in choosing the initial values of this differential equation corresponds to the
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization freedom
            in choosing the
            %a.existingWikiWord{:href => "/nlab/show/UV+regularization"} UV regularization
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\infty
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/Wilsonian+RG+flow"} Wilsonian RG flow
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
            of
            %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
            (
            %a{:href => "S-matrix#ExtensionOfTimeOrderedProoductsRenormalization"}> this def.
            ).
          #GroupoidOfEFTs.num_remark
            %h6#remark_3 Remark
            %p
              %strong
                (Wilsonian
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/effective+quantum+field+theories"} effective quantum field theories
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (according to
              = succeed ")" do
                %a{:href => "S-matrix#VacuumFree"} this def.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi Δ
                          %mrow
                            %mi F
                            %mo ,
                            %mi Λ
                        %mo }
                      %mrow
                        %mi Λ
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \left\{ \Delta_{F,\Lambda}\right\}_{\Lambda \in [0,\infty)}
              be a choice of
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoffs"} UV cutoffs
              for
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              around this vacuum (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/relative+effective+actions"} relative effective actions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mrow
                        %mi eff
                        %mo ,
                        %mi Λ
                        %mo ,
                        %msub
                          %mi Λ
                          %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_{eff,\Lambda, \Lambda_0}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EffectiveActionRelative"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi eff
                        %mo ,
                        %mi Λ
                        %mo ′
                        %mo ,
                        %msub
                          %mi Λ
                          %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msubsup
                        %mi 𝒮
                        %mrow
                          %mi Λ
                          %mo ′
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ∘
                      %msub
                        %mi 𝒮
                        %mi Λ
                      %mo )
                    %mrow
                      %mo (
                      %msub
                        %mi S
                        %mrow
                          %mi eff
                          %mo ,
                          %mi Λ
                          %mo ,
                          %msub
                            %mi Λ
                            %mn 0
                      %mo )
                    %mphantom
                      %mi AAA
                    %mtext for
                    %mspace{:width => "thinmathspace"}
                    %mi Λ
                    %mo ,
                    %mi Λ
                    %mo ′
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Λ
                      %mn 0
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ⊔
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S_{eff, \Lambda', \Lambda_0}
                    \\;=\;
                    \\left(
                    \\mathcal{S}_{\Lambda'}^{-1}
                    \\circ
                    \\mathcal{S}_\Lambda
                    \\right)
                    \\left(
                    S_{eff, \Lambda, \Lambda_0}
                    \\right)
                    \\phantom{AAA}
                    \\text{for}
                    \\,
                    \\Lambda,\Lambda' \in [0,\infty)
                    \\,,\,
                    \\Lambda_0 \in [0,\infty) \sqcup \{\infty\}
                    \\,.
            %p
              This is similar to a
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              of UV-cutoff scale-transformations. But since the
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              operations are only sensible when the UV-cutoff labels match, as shown, it is really a
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoid+action"} action
            %p
              This is often called the
              = succeed "," do
                %em Wilsonian RG
              = succeed ")." do
                %a{:href => "#Wilson71"} Wilson 71
          %p
            We now consider the
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal"} infinitesimal
            version of this “flow”:
          #FlowEquationPolchinski.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Polchinski%27s+flow+equation"}> Polchinski's flow equation
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (according to
              = succeed ")," do
                %a{:href => "S-matrix#VacuumFree"} this def.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi Δ
                          %mrow
                            %mi F
                            %mo ,
                            %mi Λ
                        %mo }
                      %mrow
                        %mi Λ
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \left\{ \Delta_{F,\Lambda}\right\}_{\Lambda \in [0,\infty)}
              be a choice of
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoffs"} UV cutoffs
              for
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              around this vacuum (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo ↦
                    %msub
                      %mi Λ
                      %mrow
                        %mi F
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda \mapsto \Lambda_{F,\Lambda}
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable
            %p
              Then for
              %em every
              choice of
              %a.existingWikiWord{:href => "/nlab/show/UV+regularization"} UV regularization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\infty
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#UVRegularization"}
              %a.existingWikiWord{:href => "/nlab/show/relative+effective+actions"} relative effective actions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi eff
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} S_{eff,\Lambda}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EffectiveActionRelative"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi Λ
                    %msub
                      %mi S
                      %mrow
                        %mi eff
                        %mo ,
                        %mi Λ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mfrac
                      %mn 1
                      %mn 2
                    %mfrac
                      %mn 1
