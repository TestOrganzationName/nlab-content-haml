            %p Then
            %ol
              %li
                %p
                  there exists a
                  = succeed "-parameterized" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
