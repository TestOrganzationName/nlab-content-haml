                            %mo ⊠
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi Λ
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (0, \infty)
                    \&amp;\overset{}{\longrightarrow}&amp;
                    \\Gamma_{\Sigma \times \Sigma,cp}(E_{\text{BV-BRST}} \boxtimes E_{\text{BV-BRST}})
                    \\\
                    \\Lambda &amp;\mapsto&amp; \Delta_{F,\Lambda}
                    }
            %p such that:
            %ol
              %li
                %p
                  each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mrow
                            %mi F
                            %mo ,
                            %mi Λ
                      %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
                  satisfies the following basic properties
                %ol
                  %li
                    %p (translation invariance)
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo =
                            %msub
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo −
                            %mi y
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"}
                            \\Delta_{F,\Lambda}(x,y) = \Delta_{F,\Lambda}(x-y)
                  %li
                    %p (symmetry)
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msubsup
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                              %mrow
                                %mi b
                                %mi a
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msubsup
                              %mi Δ
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                              %mrow
                                %mi a
                                %mi b
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"}
