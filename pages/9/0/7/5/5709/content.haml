              we have
            #eq:CountertermsInductionAssumption.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mrow
                        %mi Λ
                        %mo →
                        %mn ∞
                    %msub
                      %mrow
                        %mo (
                        %msub
                          %mi T
                          %mi Λ
                        %mo ∘
                        %msub
