                            %mrow
                              %mo (
                              %mfrac
                                %mi d
                                %mrow
                                  %mi d
                                  %mi Λ
                              %msub
                                %mi 𝒮
                                %mi Λ
                              %mo )
                            %mrow
                              %mo (
                              %msub
                                %mi S
