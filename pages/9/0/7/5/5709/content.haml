                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
              is symmetric (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
              %a.existingWikiWord{:href => "/nlab/show/star+products"} star products
              (
              %a{:href => "star+product#SymmetricContribution"}> this prop.
              ) just as for the genuine
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
              on
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              (
              %a{:href => "Wick+algebra#IsomorphismOnRegularPolynomialObservablesTimeOrderedandPointwise"}> this prop.
              ) that eeach the “effective time-ordered product”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋆
                      %mrow
                        %mi F
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} \star_{F,\Lambda}
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the pointwise product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-)\cdot (-)
              (
              %a{:href => "A+first+idea+of+quantum+field+theory#Observable"}> this def.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
