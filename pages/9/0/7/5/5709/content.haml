                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \{\Delta_{F,\Lambda}\}_{\Lambda \in [0,\infty)}
              be a
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
              (def.
              = succeed ");" do
                %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\Lambda
              the induced
              %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix+schemes"} effective S-matrix schemes
              = succeed "." do
