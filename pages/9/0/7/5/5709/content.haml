                              %mo ⋆
                              %mrow
                                %mi F
                                %mo ,
                                %mi Λ
                            %msub
                              %mi 𝒮
                              %mi Λ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi S
                              %mrow
                                %mi eff
                                %mo ,
                                %mi Λ
                            %mo{:stretchy => "false"} )
