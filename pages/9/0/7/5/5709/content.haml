                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mi Λ
                    %mo ∘
                    %msub
                      %mi 𝒵
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\Lambda \circ \mathcal{Z}_\Lambda
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/UV+regularization"} UV regularization
              of the
              %a.existingWikiWord{:href => "/nlab/show/effective+S-matrices"} effective S-matrices
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒮
                        %mi Λ
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}_\Lambda
            %p
              Hence
              %a.existingWikiWord{:href => "/nlab/show/UV-regularization"} UV-regularization
              via
              %a.existingWikiWord{:href => "/nlab/show/counterterms"} counterterms
              is a method of
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
              of
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              (
              %a{:href => "S-matrix#ExtensionOfTimeOrderedProoductsRenormalization"}> this def.
              ).
          %p
            This was claimed in (
            %a{:href => "#BrunettiDuetschFredenhagen09"}> Brunetti-Dütsch-Fredenhagen 09, (75)
            ), a proof was indicated in (
            %a{:href => "#DuetschFredenhagenKellerRejzner14"}> Dütsch-Fredenhagen-Keller-Rejzner 14, theorem A.1
            ).
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi p
                      %mrow
                        %msub
                          %mi ρ
                          %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \{p_{\rho_{k}}\}_{k \in \mathbb{N}}
              be a sequence of projection maps as in
              %a.maruku-eqref{:href => "#eq:ForExtensionOfDistributionsProjectionMaps"} (?)
              defining an
              %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser ("re"-)normalization
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#RenormalizationIsInductivelyExtensionToDiagonal"}
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi T
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \{T_k\}_{k \in \mathbb{N}}
              as
              %a.existingWikiWord{:href => "/nlab/show/extensions+of+distributions"} extensions of distributions
              of the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi k
                    %annotation{:encoding => "application/x-tex"} T_k
              = succeed "," do
                %a.maruku-ref{:href => "#TimeOrderedProductOfFixedInteraction"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi q
                      %mi k
                      %mi α
                    %mo =
                    %mn 0
