                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{d}{d \Lambda}
                    S_{eff,\Lambda}
                    \\;=\;
                    \-
                    \\frac{1}{2} \frac{1}{i \hbar}
