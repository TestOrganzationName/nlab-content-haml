                      %annotation{:encoding => "application/x-tex"} \{\mathcal{Z}_\Lambda\}_{\Lambda \in \mathbb{R}_{\geq 0}}
                  (
                  %a{:href => "Stückelberg-Petermann+renormalization+group#InteractionVertexRedefinition"}> this def.
