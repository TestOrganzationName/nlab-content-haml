                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ⊙
                  %mi J
                  %mo ⊙
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J(g,f) \cong C(1,f) \odot J \odot D(g,1)
          %p
            which was what we took as the the definition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J(g,f)
            with the original definition of proarrow equipment. Thus, the companions and conjoints determine the rest of the cartesian squares. Note that this is an equipment-version of
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/Yoneda+reduction"} Yoneda reduction
          %p In conclusion, we have three definitions of proarrow equipment:
          %ul
            %li A 2-functor which is bijective on objects, locally fully faithful, and maps every 1-morphism to one having a right adjoint.
            %li A double category in which every vertical arrow has a companion and a conjoint.
            %li A double category in which every niche has a cartesian filler.
          %p While the first definition is perhaps simpler, for some purposes the second and third definitions are preferable. For instance, the definition of the 3-category of “2-categories equipped with proarrows” is much more naturally defined by viewing them as double categories. (See Dominic Verity’s thesis and Mike Shulman’s paper on framed bicategories.) It also generalizes better to situations in which not all proarrows have composites; see “virtual equipments,” below.
          %h3#as_a_category_internal_to_
            As a category internal to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
          %p
            We discuss how a 2-category with proarrow equipment is an
            %a.existingWikiWord{:href => "/nlab/show/internal+category"} internal category
            in the
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            in the sense of the theory of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/internal+%28%E2%88%9E%2C1%29-categories"} internal (∞,1)-categories
          %p (…)
          %p
            For the moment see at
            = succeed "." do
              %em
                %a{:href => "http://ncatlab.org/nlab/show/Segal%20space#ExamplesInIGrpd"} Segal space - Examples - In 1Grpd
          %h3#related_notions Related notions
          %p There are a number of variations on the notion.
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/virtual+proarrow+equipment"} virtual proarrow equipment
            %li
              %a.existingWikiWord{:href => "/nlab/show/1-category+proarrow+equipment"} 1-category proarrow equipment
            %li
              %a.existingWikiWord{:href => "/nlab/show/%281%2C2%29-category+proarrow+equipment"} (1,2)-category proarrow equipment
          %p Some related concepts include:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/cartesian+bicategory"} cartesian bicategory
            %li
              %a.existingWikiWord{:href => "/nlab/show/bicategory+of+relations"} bicategory of relations
            %li
              %a.existingWikiWord{:href => "/nlab/show/allegory"} allegory
          %p
            See also at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Segal+space"} Segal space
            = succeed "." do
              %em
                %a{:href => "Segal+space#ExamplesInIGrpd"} Examples – In 1Grpd
          %h2#category_theory_in_a_proarrow_equipment Category theory in a proarrow equipment
          %p We now give a few examples of how to do category theory internal to a proarrow equipment.
          %h3#HomsetAdjn Homset definition of adjunctions
          %p
            We start with this: two (vertical) arrows
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f\colon A\to B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} g\colon B\to A
            are adjoint (in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                    %mo{:stretchy => "false"} (
                    %munder
                      %mi X
                      %mo ̲
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}(\underline{X})
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(f,1)\cong A(1,g)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ⊣
                  %mi g
                %annotation{:encoding => "application/x-tex"} f\dashv g
            comes with a unit and a counit, which (expressed in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi X
                      %mo ̲
                  %annotation{:encoding => "application/x-tex"} \underline{X}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi U
                                %mi A
                        %mtd
                          %mi A
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mi f
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %mover
                            %mo ⇐
                            %mi η
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi id
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mi g
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %msub
                                %mi U
                                %mi A
                        %mtd
                          %mi A
                  %mspace{:width => "2em"}
                  %mtext and
                  %mspace{:width => "2em"}
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi U
                                %mi B
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi g
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mi id
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mover
                            %mo ⇐
                            %mi ε
                        %mtd
                          %mi A
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi f
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %msub
                                %mi U
                                %mi B
                        %mtd
                          %mi B
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{A &amp; \overset{U_A}{\to} &amp; A\\
                  ^f\downarrow &amp;&amp; \downarrow\\
                  B &amp; \overset{\eta}{\Leftarrow} &amp; \downarrow^{id} \\
                  ^g\downarrow &amp;&amp; \downarrow\\
                  A&amp; \underset{U_A}{\to} &amp; A} \qquad\text{and}\qquad
                  \\array{B &amp; \overset{U_B}{\to} &amp; B\\
                  \\downarrow &amp;&amp; \downarrow^g\\
                  ^{id}\downarrow &amp; \overset{\varepsilon}{\Leftarrow} &amp; A \\
                  \\downarrow &amp;&amp; \downarrow^f\\
                  B&amp; \underset{U_B}{\to} &amp; B.}
          %p
            Applying the bijection of the Central Lemma, we see that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            corresponds to a map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(f,1) \to A(1,g)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                %annotation{:encoding => "application/x-tex"} \varepsilon
            corresponds to a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(1,g)\to B(f,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                %annotation{:encoding => "application/x-tex"} \varepsilon
            are then equivalent to saying that these two maps are inverse isomorphisms. So we’ve recovered the classical equivalence between the “diagrammatic” and isomorphism-of-hom-sets definitions of an adjunction, in a purely formal way.
          %h3#fully_faithful_arrows Fully faithful arrows
          %p
            An arrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f:A\to B
            in a 2-category equipped with proarrows is said to be
            %strong fully faithful
            if the canonical morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi A
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U_A\to B(f,f)
            is an isomorphism of proarrows
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A\to A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} V Cat
            this recaptures the correct notion of
            = succeed "-fully-faithful" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "-functor." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            It is not hard to see, using the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} K\to M
            is locally fully faithful, that any fully-faithful arrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f\colon A\to B
            is, in fact, internally fully-faithful in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            in the sense that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(X,A)\to K(X,B)
            is fully faithful for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi K
                  %annotation{:encoding => "application/x-tex"} X\in K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f\colon A\to B
            has a left or right adjoint, using the above characterization of adjunctions.
          %h3#limits Limits
          %p
            The notion of limit we end up in a 2-category equipped with proarrows with is actually more general than what you’re probably used to, but this extra generality turns out to be useful. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} d\colon D\to C
            be an arrow and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo ↛
                  %mi A
                %annotation{:encoding => "application/x-tex"} J\colon D\nrightarrow A
            be a proarrow; we’re going to define what it means for an arrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \ell\colon A\to C
            to be the
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              \-weighted limit
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} V Cat
            of
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the
            %a{:href => "http://ncatlab.org/nlab/show/unit+enriched+category"} unit
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/weighted+limit"} weighted limit
          %p
            To make things easier, let’s assume that our proarrow equipment is
            = succeed "," do
              %em closed
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℋ
                  %mo{:stretchy => "false"} (
                  %munder
                    %mi X
                    %mo ̲
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo ⊙
                  %mi K
                  %mo ,
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi ℋ
                  %mo{:stretchy => "false"} (
                  %munder
                    %mi X
                    %mo ̲
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo ,
                  %mi K
                  %mo ⊳
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi ℋ
                  %mo{:stretchy => "false"} (
                  %munder
                    %mi X
                    %mo ̲
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo ,
                  %mi L
                  %mo ⊲
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mathcal{H}(\underline{X})(H\odot K,L) \cong \mathcal{H}(\underline{X})(H,K\rhd L) \cong \mathcal{H}(\underline{X})(K,L\lhd H).
          %p
            The Central Lemma implies that analogously to
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:coyon"} (1)
          #eq:yon.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ⊳
                  %mi K
                  %mo ⊲
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} K(g,f) \cong D(1,g)\rhd K \lhd C(f,1).
          %p
            In
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mtext -
                    %mi Prof
                  %annotation{:encoding => "application/x-tex"} V\text{-}Prof
            %a{:href => "http://ncatlab.org/nlab/show/end"} ends
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo ⊳
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                  %mo{:stretchy => "false"} [
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} (K\rhd L)(b,a) = \int_{c\in C} [K(c,b), L(c,a)]
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ⊲
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                  %mo{:stretchy => "false"} [
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo .
                %annotation{:encoding => "application/x-tex"} (L \lhd H)(c,b) = \int_{a\in A} [H(b,a), L(c,a)].
          %p
            Therefore,
            %a.maruku-eqref{:href => "#eq:yon"} (2)
            is an abstract form of the Yoneda lemma, just as
            %a.maruku-eqref{:href => "#eq:coyon"} (1)
            is an abstract form of Yoneda reduction.
          %p
            Now recall that for
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} \ell\in C
            is a
            = succeed "-weighted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} d\colon D\to C
            if we have a natural isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo ,
                          %mi ℓ
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≅
                          %mo{:stretchy => "false"} [
                          %mi D
                          %mo ,
                          %mi V
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} (
                          %mi J
                          %mo ,
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msub
                            %mo ∫
                            %mrow
                              %mi x
                              %mo ∈
                              %mi D
                          %mo{:stretchy => "false"} [
                          %mi J
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ]
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  C(c,\ell) &amp;\cong [D,V](J, C(c,d(-)))\\
                  \&amp;= \int_{x\in D} [J(x), C(c,d(x))].
                  \\end{aligned}
          %p
            Thus it makes sense to define, in a closed proarrow equipment, an arrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \ell\colon A\to C
            to be the
            = succeed "-weighted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            if we have an isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ⊲
                  %mi J
                  %mo .
                %annotation{:encoding => "application/x-tex"} C(1,\ell) \cong C(1,d) \lhd J.
          %p
            (If our proarrow equipment is not closed, we simply assert that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(1,\ell)
            has the universal property that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ⊲
                  %mi J
                %annotation{:encoding => "application/x-tex"} C(1,d) \lhd J
            would have if it existed. In other terminology, we assert that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(1,\ell)
            is a
            %em right lifting
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(1,d)
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            in the 2-category of proarrows.) In particular, when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the unit
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} V Cat
            there are interesting examples for other values of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo =
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J = D(j,1)
            for some functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} j\colon A\to D
            %a.maruku-eqref{:href => "#eq:coyon"} (1)
            and
            %a.maruku-eqref{:href => "#eq:yon"} (2)
            imply that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} )
                          %mo ⊲
                          %mi J
                        %mtd
                          %mo =
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} )
                          %mo ⊲
                          %mi D
                          %mo{:stretchy => "false"} (
                          %mi j
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                          %msup
                            %mi j
                            %mo *
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                          %mi D
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} )
                          %mo ⊙
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi d
                          %mi j
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  C(1,d) \lhd J &amp;= C(1,d) \lhd D(j,1)\\
                  \&amp; \cong j^* C(1,d)\\
                  \&amp; \cong D(1,j) \odot C(1,d)\\
                  \&amp; \cong C(1,d j)
                  \\end{aligned}
          %p
            so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                  %mo =
                  %mi d
                  %mi j
                %annotation{:encoding => "application/x-tex"} \ell = d j
            is the
            = succeed "-weighted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            = succeed "-weighted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(j,1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
          %p
            More interestingly, one can show that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo =
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J = D(1,k)
            for some
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} k\colon D\to A
            = succeed "-weighted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            %em pointwise
            right Kan extensions along
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %em define
            a “pointwise right Kan extension” along an arrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} k\colon D\to A
            to be a
            = succeed "-weighted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(1,k)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} V Cat
          %h3#right_adjoints_preserve_limits Right adjoints preserve limits
          %p
            Suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \ell\colon A\to C
            is a
            = succeed "-weighted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} d\colon D\to C
            in the above sense, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} g\colon C\to B
            be an arrow with a left adjoint
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f\colon B\to C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mi ℓ
                %annotation{:encoding => "application/x-tex"} g\ell
            is a
            = succeed "-weighted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mi d
                  %annotation{:encoding => "application/x-tex"} g d
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi g
                          %mi ℓ
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≅
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi ℓ
                          %mo{:stretchy => "false"} )
                          %mo ⊙
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi g
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} )
                          %mo ⊲
                          %mi J
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ⊙
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo ⊳
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} )
                          %mo ⊲
                          %mi J
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo ⊳
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ⊲
                          %mi J
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} )
                          %mo ⊙
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ⊲
                          %mi J
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} )
                          %mo ⊙
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ⊲
                          %mi J
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi g
                          %mi d
                          %mo{:stretchy => "false"} )
                          %mo ⊲
                          %mi J
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  B(1,g\ell) &amp;\cong C(1,\ell) \odot B(1,g)\\
                  \&amp;\cong \big(C(1,d) \lhd J\big) \odot C(f,1)\\
                  \&amp;\cong C(1,f) \rhd \big(C(1,d) \lhd J\big)\\
                  \&amp;\cong \big(C(1,f) \rhd C(1,d)\big) \lhd J\\
                  \&amp;\cong \big(C(1,d) \odot C(f,1)\big) \lhd J\\
                  \&amp;\cong \big(C(1,d) \odot B(1,g)\big) \lhd J\\
                  \&amp;\cong B(1,g d) \lhd J.
                  \\end{aligned}
          %p which is what we want.
          %h2#graphs_and_cographs Graphs and cographs
          %p
            As noted above, in the case of ordinary categories, the profunctors can in fact be recovered from the 2-category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\to B
            can be identified with two-sided discrete fibrations from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (that is, spans
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ←
                  %mi C
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} B \leftarrow C \to A
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} C \to B
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} (Grothendieck) fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} C\to A
            is an opfibration, the two structures are compatible, and each fiber of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %mi B
                  %mo ×
                  %mi A
                %annotation{:encoding => "application/x-tex"} C\to B\times A
            is discrete). The two-sided fibration corresponding to a profunctor is also called its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/graph+of+a+profunctor"} graph
          %p
            However the
            = succeed "-profunctors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\to B
            %em can
            be recovered from the 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} V Cat
            in a different, and in fact dual, way: they are the two-sided
            %a.existingWikiWord{:href => "/nlab/show/codiscrete+cofibrations"} codiscrete cofibrations
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mi Cat
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} (V Cat)^{op}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cograph+of+a+profunctor"} cograph
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/collage"} collage
          %h2#virtual_equipments Virtual equipments
          %p
            One can formulate a generalized notion of equipment which includes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} V Cat
            for
            %em any
            monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            (and in fact, any
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/multicategory"} multicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cat(S)
            for any category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            with pullbacks. The precise definition is complicated, but the basic idea is not: we start from the double-category definition, and instead of composites of the horizontal (pro)arrows, we allow the squares to have domains that are arbitrary composable strings, like so:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                          %mo →
                          %mo →
                          %mi …
                          %mo →
                        %mtd
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇓
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                          %munder
                            %mo →
                            %mrow
                        %mtd
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{ &amp; \to \to \dots \to &amp;\\
                  \\downarrow &amp; \Downarrow &amp; \downarrow\\
                  \&amp; \underset{}{\to}&amp; .}
          %p
            So far this is analogous to the generalization from monoidal categories to multicategories, and gives the notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/virtual+double+category"} virtual double category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/virtual+equipment"} virtual equipment
          %h2#CategoriesEnrichedInAnEquipment Categories enriched in an equipment
          %p
            For any equipment
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            one can define a notion of
            = succeed "." do
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                \-enriched category
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/category+enriched+in+a+bicategory"} category enriched in a bicategory
          %ul
            %li
              a collection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ob
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ob(C)
              of objects,
            %li
              for each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              an
              %em extent
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e(x)
              which is an object of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
            %li
              for each pair of objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x,y
              a proarrow
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi hom
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi e
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi e
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} hom_C(x,y):e(x)\to e(y)
            %li composition and identity-assigning 2-cells obeying associativity and unit axioms.
          %p
            So far we have not used the ordinary arrows, so many authors have studied only the notion of “category enriched in a bicategory.” (Note that any 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            can be regarded as the proarrow 2-category of an equipment in which the only ordinary arrows are identites.) However, we need the extra structure when we define a
            %em functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} f:C\to D
            between
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
          %ul
            %li
              a function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi ob
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi ob
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f:ob(C)\to ob(D)
            %li
              for each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              an arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi x
                    %mo :
                    %mi e
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi e
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_x:e(x)\to e(f(x))
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
            %li
              for each pair of objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi e
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi hom
                                    %mi C
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo ,
                                  %mi y
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi e
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mo
                                %mrow
                                  %msub
                                    %mi f
                                    %mi y
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo ⇓
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mrow
                                  %msub
                                    %mi f
                                    %mi x
                          %mtr
                            %mtd
                              %mi e
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                            %mtd
                              %munder
                                %mo →
                                %mrow
                                  %msub
                                    %mi hom
                                    %mi D
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo{:stretchy => "false"} )
                                  %mo ,
                                  %mi f
                                  %mo{:stretchy => "false"} (
                                  %mi y
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi e
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{e(y) &amp; \overset{hom_C(x,y)}{\to} &amp; e(x)\\
                      ^{f_y}\downarrow &amp; \Downarrow &amp; \downarrow^{f_x}\\
                      e(f(y))&amp; \underset{hom_D(f(x),f(y))}{\to} &amp; e(f(x))}
            %li satisfying functoriality axioms.
          %p
            Finally, we define a
            %em natural transformation
            between such functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} f,g:C\to D
            to consist of
          %ul
            %li
              squares
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi e
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi U
                                    %mrow
                                      %mi e
                                      %mo{:stretchy => "false"} (
                                      %mi x
                                      %mo{:stretchy => "false"} )
                            %mtd
                              %mi e
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mo
                                %mrow
                                  %msub
                                    %mi g
                                    %mi x
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo ⇓
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mrow
                                  %msub
                                    %mi f
                                    %mi x
                          %mtr
                            %mtd
                              %mi e
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                            %mtd
                              %munder
                                %mo →
                                %mrow
                                  %msub
                                    %mi hom
                                    %mi D
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo{:stretchy => "false"} )
                                  %mo ,
                                  %mi f
                                  %mo{:stretchy => "false"} (
                                  %mi y
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi e
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{e(x) &amp; \overset{U_{e(x)}}{\to} &amp; e(x)\\
                      ^{g_x}\downarrow &amp; \Downarrow &amp; \downarrow^{f_x}\\
                      e(g(x))&amp; \underset{hom_D(f(x),f(y))}{\to} &amp; e(f(x))}
            %li satisfying a naturality axiom.
          %p
            By choosing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            appropriately, categories enriched in an equipment include most types of generalized category:
          %ul
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                is a monoidal category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                are the proarrows of
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
                = succeed "-enriched" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
                = succeed "-enriched" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                has pullbacks, there is an equipment
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Span
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Span(S)
                whose objects and arrows are those of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                and whose proarrows are spans. A category enriched in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Span
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Span(S)
                which has one object is the same as an internal category in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
            %li
              %p
                Arbitrary
                = succeed "-enriched" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Span
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Span(S)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
          %p
            Other choices of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            give “categories which are both enriched and internal,” for example:
          %ul
            %li
              For a suitably nice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              (such as a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ab
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ab(S)
              whose objects and arrows are those of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A\to B
              are internal abelian group objects in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ×
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S/(B\times A)
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ab
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ab(S)
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enriched category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          %h2#references References
          %ul
            %li#Wood82
