          %h2#idea Idea
          %p
            A
            %em trigonometric function
            is one derived from the basic
            %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/trigonometry"} trigonometry
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cos
                  %annotation{:encoding => "application/x-tex"} \cos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sin
                %annotation{:encoding => "application/x-tex"} \sin
            (
            %a.existingWikiWord{:href => "/nlab/show/cosine"} cosine
            and
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/sine"} sine
            %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
            (equivalently:
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} product projections
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi pr
                      %mi i
                  %annotation{:encoding => "application/x-tex"} pr_i
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
            %a.existingWikiWord{:href => "/nlab/show/restriction"} restricted
            to the unit
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi ℝ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi cos
                          %mo ↗
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↑
                          %msup
                            %mrow
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi pr
                                  %mn 1
                      %mtr
                        %mtd
                          %mi ℝ
                          %mover
                            %mo ⟶
                            %mi exp
                        %mtd
                          %msup
                            %mi S
                            %mn 1
                        %mtd
                          %mo ↪
                        %mtd
                          %msup
                            %mi ℝ
                            %mn 2
                        %mtd
                          %mo ≃
                        %mtd
                          %mi ℝ
                          %mo ×
                          %mi ℝ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi sin
                          %mo ↘
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %msup
                            %mrow
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi pr
                                  %mn 2
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;
                  \&amp;&amp; \mathbb{R}
                  \\\
                  \&amp;
                  \&amp;
                  {}^{\mathllap{cos}}\nearrow
                  \&amp; \big\uparrow{}^{ \mathrlap{pr_1} }
                  \\\
                  \\mathbb{R}
                  \\overset{exp}{\longrightarrow}
                  \&amp;
                  S^1
                  \&amp;\hookrightarrow&amp;
                  \\mathbb{R}^2
                  \&amp;\simeq&amp;
                  \\mathbb{R} \times \mathbb{R}
                  \\\
                  \&amp;
                  \&amp; {}_{\mathllap{sin}}\searrow &amp; \big\downarrow{}^{ \mathrlap{pr_2} }
                  \\\
                  \&amp;
                  \&amp;&amp; \mathbb{R}
                  }
                  \\,,
          %p
            or rather the result of
            %a.existingWikiWord{:href => "/nlab/show/composition"} composing
            these restrictions with an
            %a.existingWikiWord{:href => "/nlab/show/arc+length"} arc length
            parametrization
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mover
                      %mo →
                      %mi exp
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R} \overset{\exp}{\to} S^1
            = succeed "." do
              %em circular functions
          %p
            In elementary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/mathematics"} mathematics
          %ol
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/sine"} sine
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mspace{:width => "thickmathspace"}
                    %annotation{:encoding => "application/x-tex"} \;
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sin
                    %annotation{:encoding => "application/x-tex"} sin
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cosine"} cosine
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mspace{:width => "thickmathspace"}
                    %annotation{:encoding => "application/x-tex"} \;
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cos
                    %annotation{:encoding => "application/x-tex"} cos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tan"} tangent
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mspace{:width => "thickmathspace"}
                    %annotation{:encoding => "application/x-tex"} \;
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi tan
                        %mo =
                        %mfrac
                          %mi sin
                          %mi cos
                      %annotation{:encoding => "application/x-tex"} \tan = \frac{\sin}{\cos}
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cotan"} cotangent
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mspace{:width => "thickmathspace"}
                    %annotation{:encoding => "application/x-tex"} \;
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi cot
                        %mo =
                        %mfrac
                          %mi cos
                          %mi sin
                      %annotation{:encoding => "application/x-tex"} \cot = \frac{\cos}{\sin}
            %li
              %p
                %span.newWikiWord
                  secant
                  %a{:href => "/nlab/new/secant"} ?
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mspace{:width => "thickmathspace"}
                    %annotation{:encoding => "application/x-tex"} \;
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi sec
                        %mo =
                        %mfrac
                          %mn 1
                          %mi cos
                      %annotation{:encoding => "application/x-tex"} \sec = \frac1{\cos}
            %li
              %p
                %span.newWikiWord
                  cosecant
                  %a{:href => "/nlab/new/cosecant"} ?
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mspace{:width => "thickmathspace"}
                    %annotation{:encoding => "application/x-tex"} \;
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi csc
                        %mo =
                        %mfrac
                          %mn 1
                          %mi sin
                      %annotation{:encoding => "application/x-tex"} \csc = \frac1{\sin}
          %p
            The early view was that these functions measured the six possible
            %a.existingWikiWord{:href => "/nlab/show/ratios"} ratios
            of side
            %a.existingWikiWord{:href => "/nlab/show/lengths"} lengths
            of right
            %a.existingWikiWord{:href => "/nlab/show/triangles"} triangles
            (as a basic case in terms of which other triangles can be analyzed; “trigonometry” = “triangle measure”).
          %p
            These six functions figure prominently in
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+geometry"} Euclidean geometry
            where the angles of a triangle sum to
            %a.existingWikiWord{:href => "/nlab/show/arc+length"} arc length
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
          %p
            There are more elaborate offshoots such as
            %span.newWikiWord
              spherical trigonometry
              %a{:href => "/nlab/new/spherical+trigonometry"} ?
            (see
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/elliptic+geometry"} elliptic geometry
            %a.existingWikiWord{:href => "/nlab/show/hyperbolic+functions"} hyperbolic functions
            (see
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/hyperbolic+geometry"} hyperbolic geometry
            %a.existingWikiWord{:href => "/nlab/show/conic+section"} conic section
            (from a circle to a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/hyperbola"} hyperbola
          %h2#definition Definition
          %p
            The most useful modern approach to
            %a.existingWikiWord{:href => "/nlab/show/cos"} cos
            and
            %a.existingWikiWord{:href => "/nlab/show/sin"} sin
            comes from taking
            %a.existingWikiWord{:href => "/nlab/show/Euler%27s+formula"} Euler's formula
            as a working definition:
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi ℂ
                  %mo ⟶
                  %msup
                    %mi ℂ
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\exp
                  \\;\colon\;
                  \\mathbb{C}
                  \\longrightarrow
                  \\mathbb{C}^\ast
          %p
            be the
            %a.existingWikiWord{:href => "/nlab/show/complex+number"} complex
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/exponential+function"} exponential function
            %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
            %a.existingWikiWord{:href => "/nlab/show/power+series"} power series
            formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 0
                  %mfrac
                    %mrow
                      %msup
                        %mi z
                        %mi n
                    %mrow
                      %mi n
                      %mo !
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp(z)
                  \\;\coloneqq\;
                  \\sum_{n \geq 0} \frac{z^n}{n!}
                  \\,.
          %p These satisfy the following fundamental exponential identities:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo +
                      %mi w
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi w
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exp(z+w) = \exp(z) \cdot \exp(w)
                (
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                from an additive
                %a.existingWikiWord{:href => "/nlab/show/group"} group
                to a multiplicative group),
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi z
                          %mo{:stretchy => "false"} )
                        %mo ¯
                      %mo =
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi z
                        %mo ¯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \widebar{\exp(z)} = \exp(\widebar{z})
                (because
                %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \widebar{(-)}
                is a
                %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous
                %a.existingWikiWord{:href => "/nlab/show/field"} field
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
          %p
            As a result, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo +
                  %mover
                    %mi z
                    %mo ¯
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} z + \widebar{z} = 0
            (i.e., if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            is
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/imaginary+number"} purely imaginary
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo =
                  %mi i
                  %mi t
                %annotation{:encoding => "application/x-tex"} z = i t
            for some
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} t \in \mathbb{R}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mover
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                    %mo ¯
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \exp(z) \cdot \widebar{\exp(z)} = 1
          %p
            so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mo =
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} w = \exp(z)
            lies on the unit circle defined by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mover
                      %mi w
                      %mo ¯
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} w\widebar{w} = 1
          .num_defn
            %h6#definition_2 Definition
            %p
              The
              %em cosine function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cos
                    %mo :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \cos: \mathbb{R} \to \mathbb{R}
              is defined by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cos
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \cos(t) = Re(\exp(i t))
              (
              %a.existingWikiWord{:href => "/nlab/show/real+part"}> real part
              ); the
              %em sine function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sin
                    %mo :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \sin: \mathbb{R} \to \mathbb{R}
              is defined by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sin
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sin(t) = Im(\exp(i t))
              (
              %a.existingWikiWord{:href => "/nlab/show/imaginary+part"}> imaginary part
              ). In other words:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi cos
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi i
                    %mi sin
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(i t) = \cos(t) + i\sin(t)
              (Euler).
          %p
            This implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cos
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi i
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \cos(t) = \frac1{2}(\exp(i t) + \exp(-i t))
            and
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sin
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 2
                        %mi i
                    %mo{:stretchy => "false"} (
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi i
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sin(t) = \frac1{2 i}(\exp(i t) - \exp(-i t))
            %a.existingWikiWord{:href => "/nlab/show/analytic+continuation"} analytic continuation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cos
                %annotation{:encoding => "application/x-tex"} \cos
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sin
                %annotation{:encoding => "application/x-tex"} \sin
            to functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mo →
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C} \to \mathbb{C}
            on the entire complex plane.
          %h2#properties Properties
          %p More or less immediate consequences of the definition include
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi cos
                      %mi t
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mi sin
                      %mi t
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} (\cos t)^2 + (\sin t)^2 = 1
                (“
                %a.existingWikiWord{:href => "/nlab/show/Pythagorean+theorem"}> Pythagorean theorem
                ”), since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mi t
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exp(i t)
                lies on the unit circle. This is traditionally written as
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi cos
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo +
                        %msup
                          %mi sin
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \cos^2(t) + \sin^2(t) = 1
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cos
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi cos
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mi cos
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi sin
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mi sin
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \cos(x + y) = \cos(x)\cos(y) - \sin(x)\sin(y)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sin
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi sin
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mi cos
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi cos
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mi sin
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \sin(x + y) = \sin(x)\cos(y) + \cos(x)\sin(y)
                (“addition formulas”), by taking real and imaginary parts of the identity that says
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                    %annotation{:encoding => "application/x-tex"} \exp
                is a homomorphism;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi sin
                      %mo{:stretchy => "false"} )
                      %mo ′
                      %mo =
                      %mi cos
                    %annotation{:encoding => "application/x-tex"} (\sin)' = \cos
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi cos
                      %mo{:stretchy => "false"} )
                      %mo ′
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi sin
                    %annotation{:encoding => "application/x-tex"} (\cos)' = -\sin
                (by
                %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiating
                = succeed ");" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mi t
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \exp(i t)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} p'(t) = (\exp(i t))'
                is a velocity vector
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mi t
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i\exp(i t)
                of unit length;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cos
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mn 2
                      %mi π
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi cos
                      %mo{:stretchy => "false"} (
                      %mi x
