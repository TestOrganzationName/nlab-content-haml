          %title Homotopy factorization systems
          %h1#homotopy_factorization_systems Homotopy factorization systems
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#the_enriched_case"} The enriched case
              %ul
                %li
                  %a{:href => "#definition"} Definition
                %li
                  %a{:href => "#remarks"} Remarks
              %li
                %a{:href => "#the_unenriched_case"} The unenriched case
              %ul
                %li
                  %a{:href => "#definition_2"} Definition
              %li
                %a{:href => "#relation_between_definitions"} Relation between definitions
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %strong homotopy factorization system
            in a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            is a presentation of an
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system+in+an+%28%E2%88%9E%2C1%29-category"} orthogonal factorization system
            in its
            %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} underlying
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
          %h2#the_enriched_case The enriched case
          %h3#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
            (with cofibrant unit object) and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                %annotation{:encoding => "application/x-tex"} V =
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
            = succeed "." do
              %a{:href => "#Bousfield"} Bousfield, section 6
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %strong homotopy factorization system
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is a pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
              of classes of maps such that:
            %ol
              %li
                Every map in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                is a cofibration, and every map in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                is a fibration.
              %li
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} i:A\to B
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} p:X\to Y
                is in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                %a.existingWikiWord{:href => "/nlab/show/pullback+power"} pullback power
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi i
                        %mo ,
                        %mi p
                        %mo{:stretchy => "false"} ]
                        %mo :
                        %mo{:stretchy => "false"} [
                        %mi B
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} ]
                        %msub
                          %mo ×
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi A
                            %mo ,
                            %mi Y
                            %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} [
                        %mi B
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [i,p] : [B,X] \to [A,X] \times_{[A,Y]} [B,Y]
                %p
                  is an acyclic fibration in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
              %li
                Every morphism in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                factors as a map in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                followed by a map in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                are closed under
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
            %p
          %h3#remarks Remarks
          %p
            It follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (L,R)
            is in fact a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi V
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} V(I,-) : V\to Set
            takes acyclic fibrations to surjections since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is cofibrant; thus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (L,R)
            have the lifting property. And on the other hand, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            has the left lifting property against
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
