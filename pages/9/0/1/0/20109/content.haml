            (hence also
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            are fibrant or all objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            are cofibrant.
          %h2#the_unenriched_case The unenriched case
          %h3#definition_2 Definition
          %p
            A hierarchy of notions of “homotopy factorization system” for unenriched model categories can be found in
            = succeed "." do
              %a{:href => "#Joyal"} Joyal, Appendix F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be a model category and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (L,R)
            a pair of classes of maps. Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            for the class of cofibrations,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            for the class of fibrations,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mi c
                %annotation{:encoding => "application/x-tex"} M_{c}
            for the subcategory of cofibrant objects,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mi f
                %annotation{:encoding => "application/x-tex"} M_f
            for the subcategory of fibrant objects,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mrow
                      %mi c
                      %mi f
                %annotation{:encoding => "application/x-tex"} M_{c f}
            for the subcategory of fibrant and cofibrant objects,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mi c
                      %mi f
                %annotation{:encoding => "application/x-tex"} C_{c f}
            for the class of cofibrations between fibrant and cofibrant objects, etc.
          %p
          .num_defn
            %h6 Definition
            %p
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L,R)
                is a
                %strong weak homotopy factorization system
                if
                %ol
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                        %annotation{:encoding => "application/x-tex"} L
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                    are closed under weak equivalence in the
                    %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi M
                              %mo →
                          %annotation{:encoding => "application/x-tex"} M^\to
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi L
                          %mo ∩
                          %msub
                            %mi C
                            %mrow
                              %mi c
                              %mi f
                          %mo ,
                          %mi R
                          %mo ∩
                          %msub
                            %mi F
                            %mrow
                              %mi c
                              %mi f
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (L\cap C_{c f}, R\cap F_{c f})
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
                    in
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi M
                              %mrow
                                %mi c
                                %mi f
                          %annotation{:encoding => "application/x-tex"} M_{c f}
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L,R)
                is a
                %strong homotopy factorization system
                if it is a weak homotopy factorization system and in addition
                %ol
                  %li
                    If
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo ∈
                          %mi L
                        %annotation{:encoding => "application/x-tex"} f\in L
                    and
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi g
                            %mi f
                            %mo ∈
                            %mi L
                          %annotation{:encoding => "application/x-tex"} g f\in L
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi g
                            %mo ∈
                            %mi L
                          %annotation{:encoding => "application/x-tex"} g\in L
                  %li
                    If
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                          %mo ∈
                          %mi R
                        %annotation{:encoding => "application/x-tex"} g\in R
                    and
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi g
                            %mi f
                            %mo ∈
                            %mi R
                          %annotation{:encoding => "application/x-tex"} g f\in R
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi f
                            %mo ∈
                            %mi R
                          %annotation{:encoding => "application/x-tex"} f\in R
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L,R)
                is a
                %strong strong homotopy factorization system
                if it is a homotopy factorization system and in addition
                %ol
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi L
                          %mo ∩
                          %mi C
                          %mo ,
                          %mi R
                          %mo ∩
                          %mi F
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (L\cap C, R\cap F)
                    is a weak factorization system in
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi M
                          %annotation{:encoding => "application/x-tex"} M
            %p
          %h2#relation_between_definitions Relation between definitions
          %p The relation between the enriched and unenriched notions is unclear to the author of this page, but here are some things that can be said.
          %p
          .num_prop
            %h6 Proposition
            %p
              Suppose either every object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is fibrant and cofibrant, or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is right proper and either every object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is fibrant or every object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is cofibrant. Then given an enriched hfs, by closing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              under weak equivalence in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi M
                      %mo →
                  %annotation{:encoding => "application/x-tex"} M^\to
              we obtain an unenriched weak hfs
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ′
                      %mo ,
                      %mi R
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L',R')
          .proof
            %h6 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
              is a wfs, to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ′
                    %mo ,
                    %mi R
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L',R')
              is an unenriched weak hfs, it suffices to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ′
                    %mo ∩
                    %msub
                      %mi C
                      %mrow
                        %mi c
                        %mi f
                    %mo =
                    %mi L
                    %mo ∩
                    %msub
                      %mi C
                      %mrow
                        %mi c
                        %mi f
                  %annotation{:encoding => "application/x-tex"} L'\cap C_{c f} = L \cap C_{c f}
              and dually. Note that any morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mi c
                        %mi f
                  %annotation{:encoding => "application/x-tex"} C_{c f}
              is both cofibrant and fibrant in the Reedy model structure on
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi M
                        %mo →
                    %annotation{:encoding => "application/x-tex"} M^\to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi M
                        %mo →
                    %annotation{:encoding => "application/x-tex"} M^\to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is dual (using the other Reedy model structure).
          %p It is unclear whether or under what conditions this weak hfs is a hfs or a strong hfs.
          %p
            In the converse direction, the following are proven by
            = succeed ":" do
              %a{:href => "#Joyal"} Joyal
          %ul
            %li
              An unenriched weak hfs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
              is determined by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ∩
                    %msub
                      %mi C
                      %mrow
                        %mi c
                        %mi f
                    %mo ,
                    %mi R
                    %mo ∩
                    %msub
                      %mi F
                      %mrow
                        %mi c
                        %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L\cap C_{c f}, R\cap F_{c f})
              (called its
              = succeed ")." do
                %strong center
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
              is an unenriched weak hfs, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ∩
                    %msub
                      %mi C
                      %mi C
                  %annotation{:encoding => "application/x-tex"} L\cap C_C
              has the left lifting property against
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo ∩
                      %msub
                        %mi F
                        %mi f
                    %annotation{:encoding => "application/x-tex"} R\cap F_f
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
              is an unenriched weak hfs, then every morphism from a cofibrant object to a fibrant one factors as a map in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ∩
                    %msub
                      %mi C
                      %mi c
                  %annotation{:encoding => "application/x-tex"} L\cap C_c
              followed by one in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo ∩
                      %msub
                        %mi F
                        %mi f
                    %annotation{:encoding => "application/x-tex"} R\cap F_f
          %p
          .num_prop
            %h6 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R))
              is an unenriched weak hfs, the following are equivalent:
            %ol
              %li
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi L
                    %annotation{:encoding => "application/x-tex"} f\in L
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mi f
                        %mo ∈
                        %mi L
                      %annotation{:encoding => "application/x-tex"} g f\in L
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∈
                        %mi L
                      %annotation{:encoding => "application/x-tex"} g\in L
              %li
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} g\in R
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mi f
                        %mo ∈
                        %mi R
                      %annotation{:encoding => "application/x-tex"} g f\in R
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∈
                        %mi R
                      %annotation{:encoding => "application/x-tex"} f\in R
              %li
                The codiagonal of any map in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ∩
                      %msub
                        %mi C
                        %mi c
                    %annotation{:encoding => "application/x-tex"} L\cap C_c
                belongs to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
              %li
                The diagonal of any map in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo ∩
                      %msub
                        %mi F
                        %mi f
                    %annotation{:encoding => "application/x-tex"} R\cap F_f
                belongs to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
              %li
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi L
                      %mo ∩
                      %msub
                        %mi C
                        %mrow
                          %mi c
                          %mi f
                    %annotation{:encoding => "application/x-tex"} f\in L\cap C_{c f}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mi f
                      %mo ∈
                      %mi L
                      %mo ∩
                      %msub
                        %mi C
                        %mrow
                          %mi c
                          %mi f
                    %annotation{:encoding => "application/x-tex"} g f \in L\cap C_{c f}
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} g\in C
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∈
                        %mi L
                      %annotation{:encoding => "application/x-tex"} g\in L
              %li
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi R
                      %mo ∩
                      %msub
                        %mi F
                        %mrow
                          %mi c
                          %mi f
                    %annotation{:encoding => "application/x-tex"} g\in R\cap F_{c f}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mi f
                      %mo ∈
                      %mi R
                      %mo ∩
                      %msub
                        %mi F
                        %mrow
                          %mi c
                          %mi f
                    %annotation{:encoding => "application/x-tex"} g f \in R\cap F_{c f}
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
