                  %mover
                    %mo →
                    %mi f
                  %mi b
                %annotation{:encoding => "application/x-tex"} a\stackrel{f}{\to}b
          %p
            that there is the identity
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
