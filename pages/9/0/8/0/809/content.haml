                    %mi f
                  %mi b
                %annotation{:encoding => "application/x-tex"} a\stackrel{f}{\to}b
            also
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
