                  %annotation{:encoding => "application/x-tex"}
                    \\big[
                    \\Omega^\infty \Sigma^n E
                    \\overset{
                    (-)^{2_\cup}
                    }{\longrightarrow}
                    \\Omega^\infty \Sigma^{2 n} E
                    \\big]
                    \\;\;\in\;\;
                    \\widetilde E^{ 2 n }
                    \\big(
                    \\Omega^{\infty - n} E
                    \\big)
            %p
              defined – via the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              on the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              of the
              %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
              of
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              – by acting over any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Ho
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi PointedTopologicalSpaces
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} X \,\in\, Ho\big(PointedTopologicalSpaces\big)
              as the
              %a{:href => "cup+product#CupProductInWhiteheadGeneralizedCohomologyTheory"} cup square on E-cohomology
              on cohomology in degree
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            #eq:CupSquareInMultiplicativeCohomologyNaturalTransformation.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
