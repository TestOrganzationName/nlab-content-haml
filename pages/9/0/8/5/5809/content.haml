            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo •
                %annotation{:encoding => "application/x-tex"} F_\bullet
            are the component spaces of
            %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            and if such cohomology operations are compatible with the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/suspension+isomorphism"} suspension isomorphism
            = succeed "." do
              %em stable cohomology operation
