                    %mi X
                    %mo ,
                    %msup
                      %mi Ω
                      %mn ∞
                    %msup
                      %mi Σ
                      %mi n
                    %mi E
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mi E
                      %mo ˜
                    %msup
                      %mrow
                      %mi n
                    %mo{:stretchy => "false"} (
