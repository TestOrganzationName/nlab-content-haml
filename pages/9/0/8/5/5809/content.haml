                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mo ≃
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mi k
                  %mo ,
                  %msub
                    %mi F
                    %mi l
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\{
                  H^k(-, E)
                  \\to
                  H^l(-, F)
                  \\}
                  \\simeq
                  Ho(E_k, F_l)
                  \\,.
          %p
            (This statement is made fully explicit for instance below def. 12.3.22 in (
            %a{:href => "#AguilarGitlerPrieto"}> Aguilar-Gitler-Prieto
            ).
          %p
            If here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mo •
