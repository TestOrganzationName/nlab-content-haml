                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ho
                    \\big(
                    PointedTopologicalSpaces
                    \\big)
                    \\;\overset{ \;\; A \mapsto [-,A]\;\; }{\hookrightarrow}\;
