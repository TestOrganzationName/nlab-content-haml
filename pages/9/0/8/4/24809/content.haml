          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+information+theory"} quantum information theory
            %em controlled
            %a.existingWikiWord{:href => "/nlab/show/quantum+gate"} quantum gate
            is a quantum gate whose operation on a given
            %a.existingWikiWord{:href => "/nlab/show/space+of+states"} space of states
            is conditioned on the data in another space of “control states”.
          %h3#the_conceptual_problem The conceptual problem
          %p
            The analogous situation for classical
            %a.existingWikiWord{:href => "/nlab/show/logic+gates"} logic gates
            is without subtlety: Here the parameterization of a
            %a.existingWikiWord{:href => "/nlab/show/logic"} logic
            gate on
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi n
                      %mi in
                    %mo ,
                    %msub
                      %mi n
                      %mi out
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n_{in}, n_{out})
            %a.existingWikiWord{:href => "/nlab/show/bits"} bits
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi n
                    %mi ctrl
                %annotation{:encoding => "application/x-tex"} n_{ctrl}
            control bits is a choice of function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Bool
                    %mrow
                      %msub
                        %mi n
                        %mi ctrl
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi F
                        %mo •
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %mi Map
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Bool
                    %mrow
                      %msub
                        %mi n
                        %mi in
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi Bool
                    %mrow
                      %msub
                        %mi n
                        %mi out
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  Bool^{n_{ctrl}}
                  \\xrightarrow{\;\;\; F_{\bullet} \;\;\;}
                  Map
                  \\big(
                  Bool^{n_{in}}
                  ,\,
                  Bool^{n_{out}}
                  \\big)
          %p
            from the intended set of controls to the
            %a.existingWikiWord{:href => "/nlab/show/set+of+functions"} set of functions
            between the intended input/output; and by the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction
            in the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
            of
            %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
            this is in
            %a{:href => "adjoint+functor#InTermsOfHomIsomorphism"} bijective correspondence
            with a single function out of the
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            set of the control bits with the input bits:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi Bool
                            %mrow
                              %msub
                                %mi n
                                %mi ctrl
                              %mo +
                              %msub
                                %mi n
                                %mi in
                        %mtd
                          %mo ≃
                        %mtd
                          %msup
                            %mi Bool
                            %mrow
                              %msub
                                %mi n
                                %mi ctrl
                          %mo ×
                          %msup
                            %mi Bool
                            %mrow
                              %msub
                                %mi n
                                %mi in
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                        %mtd
                          %msup
                            %mi Bool
                            %mrow
                              %msub
                                %mi n
                                %mi out
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi b
                            %mi ctrl
                          %mo ,
                          %msub
                            %mi b
                            %mi in
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ↦
                        %mtd
                          %msub
                            %mi F
                            %mrow
                              %msub
                                %mi b
                                %mi ctrl
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi b
                            %mi in
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Bool^{ n_{ctrl} + n_{in} }
                  \&amp;\simeq&amp;
                  Bool^{ n_{ctrl} }
                  \\times
                  Bool^{ n_{in} }
                  \&amp;\xrightarrow{\;\;\;}&amp;
                  Bool^{ n_{out} }
                  \\\
                  \&amp;&amp;
                  ( b_{ctrl}, b_in )
                  \&amp;\mapsto&amp;
                  F_{b_{ctrl}}\big( b_{in} \big)
                  }
                  \\,.
          %p This function would/could be called the “controlled logic gate”. Notice that the control bits in the above function are “discarded after use”, in that they cannot in general be recovered from the output of the above function.
          %p
            The subtleties with generalizing this situation to
            %a.existingWikiWord{:href => "/nlab/show/quantum+logic+gates"} quantum logic gates
            are:
          %ol
            %li
              %p The control of quantum gates may be either by quantum data or by classical data, which is not quite the same.
              %p
                %br/
              %p
                (In a
                %em quantum-controlled
                quantum logic gate, the control itself may be in a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+superposition"} quantum superposition
                %em classically-controlled
                quantum gate is effectively an
                %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed set
                of quantum gates, indexed by classical data.)
            %li
              %p
                A quantum-controlled quantum gate should, like any pure
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+logic+gate"} quantum logic gate
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/unitary"} unitary
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/invertible"} invertible
              %p
                %br/
              %p
                This
                %em rules out
                the otherwise evident non-cartesian analog of the above classical situation (with the product operation replaced by the non-cartesian
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                of
                %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite-dimensional
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hilbert+spaces"} Hilbert spaces
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                now being the corresponding linear space of linear maps)):
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %msup
                            %mi QBit
                            %mrow
                              %msub
                                %mi n
                                %mi ctrl
                          %mover
                            %mo →
                            %mrow
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %msub
                                %mi F
                                %mo •
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                          %mi Map
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msup
                            %mi QBit
                            %mi n
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi QBit
                            %mi n
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mrow
                          %msup
                            %mi QBit
                            %mrow
                              %msub
                                %mi n
                                %mi ctrl
                          %mo ⊗
                          %msup
                            %mi QBit
                            %mi n
                          %mover
                            %mo →
                            %mphantom
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo −
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo −
                          %msup
                            %mi QBit
                            %mi n
                    %annotation{:encoding => "application/x-tex"}
                      \\frac{
                      QBit^{n_{ctrl}}
                      \\xrightarrow{\;\;\; F_\bullet \;\;\;}
                      Map
                      \\big(
                      QBit^{ n }
                      ,\,
                      QBit^{ n }
                      \\big)
                      }{
