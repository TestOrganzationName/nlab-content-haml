                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} w_0(V(x))=0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FV
                  %mo =
                  %mi p
                %annotation{:encoding => "application/x-tex"} FV=p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi VF
                  %mo{:stretchy => "false"} (
                  %mi xy
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi xV
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} VF(xy)=xV(y)
          .num_defn
            %h6#definition_2 Definition
            %p
              A
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 3
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 3n
                \-display over R
              is defined to be a quadruple
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi Q
                    %mo ,
                    %mi F
                    %mo ,
                    %msup
                      %mi V
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (P, Q, F, V^{-1})
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is a finitely generated projective
              = succeed "-module," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(R)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo ⊂
                    %mi P
                  %annotation{:encoding => "application/x-tex"} Q \subset P
              is a submodule and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} V^{-1}
              are
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi P
                      %mo →
                      %mi P
                    %annotation{:encoding => "application/x-tex"} F : P \to P
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi V
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo :
                      %mi Q
                      %mo →
                      %mi P
                    %annotation{:encoding => "application/x-tex"} V^{-1}: Q \to P
            %p The following properties are satisfied:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi w
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mi P
                        %mo ⊂
                        %mi Q
                        %mo ⊂
                        %mi P
                      %annotation{:encoding => "application/x-tex"} ker(w_0)P \subset  Q \subset P
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo{:stretchy => "false"} /
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} P /Q
                  is a direct summand of the
                  = succeed "\u2212module" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                          %mo{:stretchy => "false"} (
                          %mi R
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} W (R)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                          %mo{:stretchy => "false"} /
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi w
                            %mn 0
                          %mo{:stretchy => "false"} )
                          %mi P
                        %annotation{:encoding => "application/x-tex"} P /ker(w_0)P
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi V
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo :
                        %mi Q
                        %mo →
                        %mi P
                      %annotation{:encoding => "application/x-tex"} V^{-1} : Q \to P
                  is a
                  = succeed "-linear" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi P
                      %annotation{:encoding => "application/x-tex"} x \in P
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi w
                          %mo ∈
                          %mi W
                          %mo{:stretchy => "false"} (
                          %mi R
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} w \in W (R)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi V
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mi wx
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi wF
                          %mi x
                        %annotation{:encoding => "application/x-tex"} V^{-1} ( V wx) = wF x
          .num_defn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mi ij
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\alpha_{ij})
              be a invertible matrix satisfying
            %p
              a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %msub
                      %mi e
                      %mi j
                    %mo =
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi h
                    %msub
                      %mi α
                      %mi ij
                    %msub
                      %mi e
                      %mi i
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi j
                    %mo =
                    %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mi d
                  %annotation{:encoding => "application/x-tex"} F e_j=\sum_{i=1}^h\alpha_{ij} e_i, \; j=1,\dots ,d
            %p
              b)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msub
                      %mi e
                      %mi j
                    %mo =
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi h
                    %msub
                      %mi α
                      %mi ij
                    %msub
                      %mi e
                      %mi i
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi j
                    %mo =
                    %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mi h
                  %annotation{:encoding => "application/x-tex"} V^{-1} e_j=\sum_{i=1}^h\alpha_{ij} e_i, \; j=1,\dots ,h
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi β
                      %mi kl
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\beta_{kl})
              denote the inverse matrix of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi α
                        %mi ij
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\alpha_{ij})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi w
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi β
                      %mi kl
                    %mo{:stretchy => "false"} )
                    %mi modulo
                    %mspace{:width => "thickmathspace"}
                    %mi p
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi k
                        %mo ,
                        %mi l
                        %mo =
                        %mi d
                        %mo +
                        %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %mi k
                  %annotation{:encoding => "application/x-tex"} B:=(w_0(\beta_{kl})modulo\; p)_{k,l=d+1,\dots,k}
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B^{(p)}
              deonte the matrix obtained by raising all entries to the
              = succeed "-th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mi ij
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\alpha_{ij})
              is said to satisfy
              %em
                the
                = succeed "-nilpotence" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
              if there is a natural number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} N\in \mathbb{N}
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mrow
                          %msup
                            %mi p
                            %mrow
                              %mi N
                              %mo −
                              %mn 1
                      %mo ⋅
                      %mi …
                      %mo ⋅
                      %msup
                        %mi B
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi B
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} B^{p^{N-1}}\cdot\dots\cdot B^{(p)}\cdot B=0
            %p
              Then a
              = succeed "-display" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 3
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 3n
              = succeed "-nilpotence" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mi R
                  %annotation{:encoding => "application/x-tex"} Spec R
              is called a
              = succeed "." do
                %em display
          %h2#properties Properties
          %p
            The following theorem compares the Dieudonné theory in terms of displays and the
            %span.newWikiWord
              crystalline Dieudonné theory
              %a{:href => "/nlab/new/crystalline+Dieudonn%C3%A9+theory"} ?
            of Grothendieck and Messing
            = succeed "." do
              %a{:href => "#Messing"} Messing
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi Q
                    %mo ,
                    %mi F
                    %mo ,
                    %msup
                      %mi V
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}:=(P,Q,F,V^{-1})
              be a display over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/crystal"} crystals
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi 𝒫
                    %mover
                      %mo →
                      %mo ∼
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi D
                      %mrow
                        %mi B
                        %msub
                          %mi T
                          %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D_\mathcal{P}\stackrel{\sim}{\to}\mathbf{D}_{B T_\mathcal{P}}(S)
            %p
              where on the right side is the crystal defined in
              = succeed "." do
                %a{:href => "#Messing"} Messing
          %h2#examples Examples
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lawrence+Breen"}> Lawrence Breen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pierre+Berthelot"} Pierre Berthelot
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/William+Messing"} William Messing
            %li
              %p
                T. Zink, the display of a formal p-divisible group, to appear in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ast%C3%A9risque"} Astérisque
                %a{:href => "http://www.math.uni-bielefeld.de/~zink/display.pdf"} pdf
            %li
              %p
                T. Zink, Windows for displays of p-divisible groups. in:Moduli of Abelian Varieties, Progress in Mathematics 195, Birkhäuser 2001,
                %a{:href => "http://www.math.uni-bielefeld.de/~zink/Texel.pdf"} pdf
