                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mi R
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 0
                            %mo ,
                            %mi …
                            %mo ,
                            %msub
                              %mi x
                              %mi i
                            %mo ,
                            %mi …
                            %mo{:stretchy => "false"} )
