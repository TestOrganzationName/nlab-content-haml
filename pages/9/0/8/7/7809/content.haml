                  w_n:\begin{cases}
                  W(R)\to R
                  \\\
                  (x_0,\dots,x_i,\dots)\mapsto x_0^{p^n}+p x_1^{p^{n-1}}+ \dots + p^n x_n
                  \\end{cases}
          %p
            denote the morphism of rings assigning to Witt vector its correspnding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Witt+polynomial"} Witt polynomial
