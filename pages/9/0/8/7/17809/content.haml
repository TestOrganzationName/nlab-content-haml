                    %annotation{:encoding => "application/x-tex"} \mathfrak{sp}(2) = C_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(m,2)
              and of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(m,2)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 5
                      %mo −
                      %mn 2
                      %mo =
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} 5-2 = 3
            %p The other exceptional isomorphism of relevance is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %mn 6
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi 𝔰𝔲
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi A
                      %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{so}(6)\simeq \mathfrak{su}(4) = A_3
            %p
              with the spinor representation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %mn 6
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{so}(6)
              being the vector representation of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔰𝔲
                      %mo{:stretchy => "false"} (
                      %mn 4
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi A
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \mathfrak{su}(4) = A_3
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A(3,k)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 6
                      %mo −
                      %mn 2
                      %mo =
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} 6-2 = 4
            %p
              Finally by
              %a.existingWikiWord{:href => "/nlab/show/triality"} triality
              the vector representation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %mn 8
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi D
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \mathfrak{so}(8) = D_4
              is isomorphic to its spinor representation. By the above tables this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(4,k)
              is a superconformal algebra in dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 8
                      %mo −
                      %mn 2
                      %mo =
                      %mn 6
                    %annotation{:encoding => "application/x-tex"} 8-2 = 6
              = succeed ")" do
                %a{:href => "#Shnider88"} Shnider 88, last paragraphs
          .num_remark
            %h6#remark_19 Remark
            %p
              Further constraints follow from requiring
              %a.existingWikiWord{:href => "/nlab/show/super-unitary+representations"} super-unitary representations
              (
              %a{:href => "#Minwalla98"}> Minwalla 98, section 4.3
              ). This restricts for instance the 6d superconformal algebra to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi 𝔬𝔰𝔭
                    %mo{:stretchy => "false"} (
                    %mn 8
                    %mo{:stretchy => "false"} |
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(4,1) = \mathfrak{osp}(8|2)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mn 4
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi 𝔬𝔰𝔭
                      %mo{:stretchy => "false"} (
                      %mn 8
                      %mo ,
                      %mn 4
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(4,1) = \mathfrak{osp}(8,4)
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔰𝔬
                      %mo{:stretchy => "false"} (
                      %msup
                        %mn 8
                        %mo *
                      %mo{:stretchy => "false"} |
                      %mn 4
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi 𝔬𝔰𝔭
                      %mo{:stretchy => "false"} (
                      %mn 6
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} |
                      %mn 4
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{so}(8^\ast|4) = \mathfrak{osp}(6,2|4)
              %a.existingWikiWord{:href => "/nlab/show/6d+%282%2C0%29-superconformal+QFT"} 6d (2,0)-superconformal QFT
              on the
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
          %h2#SupersymmetryFromTheSuperpoint Supersymmetry from the superpoint
          %p
            Above we have discussed the definition and classification of
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            in the strict sense of “spacetime supersymmetry” and specifically in the strict sense of super-extensions (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#SuperExtensions"}
            %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebra"} Poincaré Lie algebra
            by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+spin+representations"} real spin representations
            %a.maruku-ref{:href => "#AnExotiSuperExtensionOfThePoincareLieAlgebra"}
            showed that there are other exotic super-extensions of the
            %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebra"} Poincaré Lie algebra
            which are not of this form.
          %p
            While there are further conditions, motivated from
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            = succeed ")" do
              %a.maruku-ref{:href => "#FurtherConditionsToSingleOutOrdinarySupersymmetry"}
          %p
            Here we discuss one such principle. Supersymmetry and spin representations emerge from forming consecutive maximal invariant central extensions starting from the
            %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
            (
            %a{:href => "#MTheoryFromTheSuperpoint"}> Huerta-Schreiber 17
            ).
          %p Before giving the general definition and discussion, we consider the simplest case right away:
          #3dSuperMinkowskiFromExtensionOfTheSuperpoint.num_prop
            %h6#proposition_40 Proposition
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{0\vert 1}
            %p
              regarded as an abelian
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              = succeed "." do
                %a.maruku-ref{:href => "#SuperVectorSpaceAsAbelianSuperLieAlgebra"}
            %p
              Its maximal
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
              is the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} N = 1
              super-
              %a.existingWikiWord{:href => "/nlab/show/worldline"} worldline
              of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/superparticle"} superparticle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 0
                                %mo ,
                                %mn 1
                                %mo{:stretchy => "false"} |
                                %mstyle{:mathvariant => "bold"}
                                  %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 0
                                %mo{:stretchy => "false"} |
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^{0,1\vert \mathbf{1}}
                    \\\
                    \\downarrow
                    \\\
                    \\mathbb{R}^{0\vert 1}
                    }
                    \\,.
            %ul
              %li
                %p
                  whose even part is spanned by one generator
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
              %li
                %p
                  whose odd part is spanned by one generator
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} Q
              %li
                %p the only non-trivial bracket is
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi Q
                        %mo ,
                        %mi Q
                        %mo{:stretchy => "false"} }
                        %mo =
                        %mi H
                      %annotation{:encoding => "application/x-tex"}
                        \\{Q, Q\} = H
            %p
              Then consider the
              %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{0\vert 2}
                    \\,.
            %p
              Its maximal
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
              is
            %p
              the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo =
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} d = 3
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} N = 1
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 2
                                %mo ,
                                %mn 1
                                %mo{:stretchy => "false"} |
                                %mstyle{:mathvariant => "bold"}
                                  %mn 2
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 0
                                %mo{:stretchy => "false"} |
                                %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^{2,1\vert \mathbf{2}}
                    \\\
                    \\downarrow
                    \\\
                    \\mathbb{R}^{0\vert 2}
                    }
                    \\,.
            %ul
              %li
                %p
                  whose even part is
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^3
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi P
                          %mn 0
                        %mo ,
                        %msub
                          %mi P
                          %mn 1
                        %mo ,
                        %msub
                          %mi P
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} P_0, P_1, P_2
              %li
                %p
                  whose odd part is
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
                  representation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbf{2}
                %p
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi SL
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mi ℝ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(2,1) \simeq SL(2,\mathbb{R})
              %li
                %p the only non-trivial bracket is the spinor bilinear pairing
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi Q
                          %mi α
                        %mo ,
                        %mi Q
                        %msub
                          %mo ′
                          %mi β
                        %mo{:stretchy => "false"} }
                        %mo =
                        %msub
                          %mi C
                          %mrow
                            %mi α
                            %mi α
                            %mo ′
                        %msub
                          %mi Γ
                          %mi a
                        %msup
                          %mrow
                          %mrow
                            %mi α
                            %mo ′
                        %msub
                          %mrow
                          %mi β
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi P
                          %mi a
                      %annotation{:encoding => "application/x-tex"}
                        \\{Q_\alpha, Q'_\beta\}
                        \=
                        C_{\alpha \alpha'} \Gamma_a{}^{\alpha'}{}_\beta
                        \\,P^a
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mi α
                        %mi β
                  %annotation{:encoding => "application/x-tex"} C_{\alpha \beta}
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/charge+conjugation+matrix"} charge conjugation matrix
          #FromSuperpointTo3dProof.proof
            %h6#proof_25 Proof
            %p
              Recall that
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              %a.existingWikiWord{:href => "/nlab/show/central+extensions"} central extensions
              of
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              are classified by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} 2-cocycles
              %a.existingWikiWord{:href => "/nlab/show/bilinear+maps"} bilinear maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔤
                    %mo ∧
                    %mi 𝔤
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mi d
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_2
                    \\;\colon\;
                    \\mathfrak{g} \wedge\mathfrak{g}
                    \\longrightarrow
                    \\mathbb{R}^d
            %p
              satisfying a cocycle condition. The extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝔤
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{\mathfrak{g}}
              that this classifies has underlying
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝔤
                      %mo ^
                    %mo ≔
                    %mi 𝔤
                    %mo ⊕
                    %msup
                      %mi ℝ
                      %mi d
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{\mathfrak{g}} \coloneqq \mathfrak{g} \oplus \mathbb{R}^d
            %p
              an the new super Lie bracket is given on pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi 𝔤
                    %mo ⊕
                    %msup
                      %mi ℝ
                      %mi d
                  %annotation{:encoding => "application/x-tex"} (x,c) \in \mathfrak{g} \oplus \mathbb{R}^d
            %p by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %msub
                          %mi μ
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi μ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\; (x_1,c_1), (x_2,c_2)\;]_{\mu_2}
                    \\;=\;
                    (\, [x_1,x_2]\,,\, \mu_2(c_1,c_2) \,)
                    \\,.
            %p
              The condition that the new bracket
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %msub
                          %mi μ
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} [-,-]_{\mu_2}
              satisfies the super
              %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
              is equivalent to the cocycle condition on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mu_2
            %p
              Now in the case that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                      %mo =
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 0
                          %mo{:stretchy => "false"} |
                          %mi q
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g} = \mathbb{R}^{0\vert q}
              %em symmetric
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
              on the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              fermionic dimensions.
            %p
              So in the case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo =
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} = \mathbb{R}^{0\vert 1}
              there is a unique such, up to scale, namely
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi Q
                    %mo ,
                    %mi b
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi a
                    %mi b
                    %mi P
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_2(a Q,b Q) = a b P
                    \\,.
            %p
              But in the case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo =
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} = \mathbb{R}^{0\vert 2}
              there is a 3-dimensional space of 2-cocycles, namely
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 2
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi Q
                                  %mn 1
                            %mtr
                              %mtd
                                %msub
                                  %mi Q
                                  %mn 2
                        %mo )
                      %mo ,
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi Q
                                %msub
                                  %mo ′
                                  %mn 1
                            %mtr
                              %mtd
                                %mi Q
                                %msub
                                  %mo ′
                                  %mn 2
                        %mo )
                      %mo )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi Q
                                %mn 1
                              %mi Q
                              %msub
                                %mo ′
                                %mn 1
                              %mo ,
                            %mtd
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mn 2
                              %mrow
                                %mo (
                                %msub
                                  %mi Q
                                  %mn 1
                                %mi Q
                                %msub
                                  %mo ′
                                  %mn 2
                                %mo +
                                %msub
                                  %mi Q
                                  %mn 2
                                %mi Q
                                %msub
                                  %mo ′
                                  %mn 1
                                %mo )
                              %mo ,
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mi Q
                                %mn 2
                              %mi Q
                              %msub
                                %mo ′
                                %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_2
                    \\left(
                    \\left(
                    \\array{
                    Q_1
                    \\\
                    Q_2
                    }\right),
                    \\left(
                    \\array{
                    Q'_1
                    \\\
                    Q'_2
                    }
                    \\right)
                    \\right)
                    \=
                    \\left\{
                    \\array{
                    Q_1 Q'_1,
                    \&amp;
                    \\tfrac{1}{2}\left(
                    Q_1 Q'_2 + Q_2 Q'_1
                    \\right),
                    \\\
                    \&amp; Q_2 Q'_2
                    }
                    \\right.
            %p
              If this is identified with the three coordinates of 3d
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mo ,
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi t
                              %mo +
                              %mi x
                            %mtd
                              %mi y
                          %mtr
                            %mtd
                            %mtd
                              %mi t
                              %mo −
                              %mi x
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{2,1}
                    \\;\simeq\;
                    \\left(
                    \\array{
                    t + x &amp; y
                    \\\
                    \&amp; t - x
                    }
                    \\right)
            %p
              then the pairing is the claimed one (see at
              = succeed ")." do
                %em
                  %a{:href => "https://ncatlab.org/nlab/show/geometry+of+physics+--+supersymmetry#InTermsOfNormedDivisionAlgebraInDimension3To10"} supersymmetry – in dimensions 3, 4, 6, 10
          %p
            On the face of it prop.
            %a.maruku-ref{:href => "#3dSuperMinkowskiFromExtensionOfTheSuperpoint"}
            only produces the super-translation super Lie algebra in 3d, without identifying the fact that its odd components transform as
            %a.existingWikiWord{:href => "/nlab/show/spinors"} spinors
            under the
            %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#SpinGroup"}
            %a.existingWikiWord{:href => "/nlab/show/double+cover"} double cover
            (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#SpinDoubleCover"}
            %a.existingWikiWord{:href => "/nlab/show/proper+orthochronous+Lorentz+group"} proper orthochronous Lorentz group
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#LorentzGroup"}
          #internalsymm.num_defn
            %h6#definition_33 Definition
            %p
              %strong (external and internal symmetries)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              be a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#SuperLieAlgebraAsLieAlgebraInternalToSuperVectorSpaces"}
              = succeed ")." do
                %a.maruku-ref{:href => "#SuperLieAlgebraTraditional"}
              %em infinitesimal internal symmetries
              is the
              %a.existingWikiWord{:href => "/nlab/show/stabilizer"} stabilizer
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔤
                      %mi{:mathvariant => "normal"} even
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}_{\mathrm{even}}
              inside the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+Lie+algebra"} automorphism Lie algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔦𝔫𝔱
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi{:mathvariant => "normal"} Stab
                      %mrow
                        %mi 𝔞𝔲𝔱
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi{:mathvariant => "normal"} even
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔤
                      %mi{:mathvariant => "normal"} even
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{int}(\mathfrak{g}) \coloneqq \mathrm{Stab}_{\mathfrak{aut}(\mathfrak{g})_{\mathrm{even}}}(\mathfrak{g}_{\mathrm{even}})
                    \\,,
            %p
              hence is the sub-Lie algebra of derivations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              on those which vanish on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔤
                        %mi{:mathvariant => "normal"} even
                      %mo ↪
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}_{\mathrm{even}} \hookrightarrow \mathfrak{g}
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔢𝔵𝔱
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi{:mathvariant => "normal"} aut
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} even
                    %mo{:stretchy => "false"} /
                    %mi 𝔦𝔫𝔱
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{ext}(\mathfrak{g}) \coloneqq \mathrm{aut}(\mathfrak{g})_{\mathrm{even}}/\mathfrak{int}(\mathfrak{g})
            %p
              of all automorphisms by internal ones is again a Lie algebra, the Lie algebra of
              %em external symmetries
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi 𝔦𝔫𝔱
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi 𝔞𝔲𝔱
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} even
                    %mo →
                    %mi 𝔢𝔵𝔱
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to
                    \\mathfrak{int}(\mathfrak{g}) \hookrightarrow \mathfrak{aut}(\mathfrak{g})_{\mathrm{even}}
                    \\to
                    \\mathfrak{ext}(\mathfrak{g})
                    \\to 0
                    \\,.
            %p
              Finally, the Lie algebra of
              %em simple external automorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔢𝔵𝔱
                      %mi{:mathvariant => "normal"} simp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi 𝔢𝔵𝔱
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi 𝔞𝔲𝔱
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{ext}_{\mathrm{simp}}(\mathfrak{g})
                    \\hookrightarrow
                    \\mathfrak{ext}(\mathfrak{g})
                    \\hookrightarrow
                    \\mathfrak{aut}(\mathfrak{g})
            %p
              is the maximal
              %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semi-simple
              sub-Lie algebra of the external automorphism Lie algebra.
          #symmetryR.num_example
            %h6#example_8 Example
            %p
              %strong (R-symmetry)
            %p
              The internal automorphisms according to def.
              = succeed ")" do
                %a.maruku-ref{:href => "#internalsymm"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1\vert N}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperMinkowskiSpacetime"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/R-symmetries"} R-symmetries
              in the physics literature (e.g.
              = succeed ")." do
                %a{:href => "#Freed99"} Freed 99, p. 56
          #MaximalInvariantCentralExtension.num_defn
            %h6#definition_34 Definition
            %p
              %strong (maximal invariant central extensions)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              be a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#SuperLieAlgebraAsLieAlgebraInternalToSuperVectorSpaces"}
              = succeed ")." do
                %a.maruku-ref{:href => "#SuperLieAlgebraTraditional"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔥
                    %mo ↪
                    %mi 𝔞𝔲𝔱
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} even
                  %annotation{:encoding => "application/x-tex"} \mathfrak{h} \hookrightarrow \mathfrak{aut}(\mathfrak{g})_{\mathrm{even}}
              be a sub-Lie algebra of its
              %a.existingWikiWord{:href => "/nlab/show/automorphism+Lie+algebra"} automorphism Lie algebra
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi V
                          %mtd
                            %mo ⟶
                          %mtd
                            %mover
                              %mi 𝔤
                              %mo ^
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi 𝔤
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    V &amp;\longrightarrow&amp; \widehat{\mathfrak{g}}
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; \mathfrak{g}
                    }
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              by a vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              in even degree. Then we say that:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝔤
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{\mathfrak{g}}
              is
            %ol
              %li
                %p
                  an
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi 𝔥
                        %annotation{:encoding => "application/x-tex"} \mathfrak{h}
                    \-invariant central extension
                  if the 2-cocycles that classify the extension are
                  = succeed "-invariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔥
                        %annotation{:encoding => "application/x-tex"} \mathfrak{h}
              %li
                %p
                  an
                  %em invariant central extension
                  if it is
                  = succeed "-invariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔥
                        %annotation{:encoding => "application/x-tex"} \mathfrak{h}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔥
                        %mo =
                        %msub
                          %mi 𝔢𝔵𝔱
                          %mi{:mathvariant => "normal"} simp
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{h} = \mathfrak{ext}_{\mathrm{simp}}(\mathfrak{g})
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple
                  part of its external automorphism Lie algebra (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#internalsymm"}
            %p
              1.a
              %em
                maximal
                = succeed "-invariant" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔥
                      %annotation{:encoding => "application/x-tex"} \mathfrak{h}
              if it is an
              = succeed "-invariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔥
                    %annotation{:encoding => "application/x-tex"} \mathfrak{h}
              = succeed "-tuple" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-invariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔥
                    %annotation{:encoding => "application/x-tex"} \mathfrak{h}
              = succeed "-invariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔥
                    %annotation{:encoding => "application/x-tex"} \mathfrak{h}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo ,
                    %mi ℝ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi 𝔥
                  %annotation{:encoding => "application/x-tex"} H^2(\mathfrak{g},\mathbb{R})^{ \mathfrak{h} }
          #SuperpointMaximalInvariantCentralExtensions.num_theorem
            %h6#theorem Theorem
            %p
              %strong
                (
                %a{:href => "#MTheoryFromTheSuperpoint"}> Huerta-Schreiber 17
                )
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
              shown on the right
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/schreiber/files/TheSpacetimeExtensions.png", :width => "250"}/
            %p
              is obtained by consecutively forming maximal invariant central extensions according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#MaximalInvariantCentralExtension"}
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1\vert \mathbf{N}}
              is the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbf{N}
              super-translation
              %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
              algebra from def.
              = succeed "." do
                %a.maruku-ref{:href => "#SuperMinkowskiSpacetime"}
            %p
              Moreover, in each case the semisimple part of the external automorphism is the Lie algebra of the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
          .num_remark
            %h6#remark_20 Remark
            %p
              That every
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
              is
              %em some
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
              of some
              %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
              is elementary. This was highlighted in (
              %a{:href => "https://ncatlab.org/nlab/show/Green-Schwarz+action+functional#CAIB99"}> Chryssomalakos-Azcárraga-Izquierdo-Bueno 99, 2.1
              ). But most central extensions of superpoints are nothing like super-Minkowksi spacetimes. The point of the above proposition is to restrict attention to
              %em iterated invariant
              central extensions and to find that these single out the super-Minkowski spacetimes.
          %p
            %strong Conclusion.
          %p
            Hence just from studying iterated invariant
            %a.existingWikiWord{:href => "/nlab/show/central+extensions"} central extensions
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
          %ol
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+geometry"}> Lorentzian geometry
                ,
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/spin+geometry"}> spin geometry
                \.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/super+spacetimes"}> super spacetimes
                \.
          %p
            In the next chapter
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+fundamental+super+p-branes"} geometry of physics – fundamental super p-branes
            we discuss that this process continues through
            %em higher
            central extensions to yield not only
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super-spacetime"} super-spacetime
            %a.existingWikiWord{:href => "/nlab/show/super+p-branes"} super p-branes
            propagating on it.
          %blockquote
            %p
              Perhaps we need to understand the nature of time itself better.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo .
                    %mo .
                    %mo .
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [...]
              One natural way to approach that question would be to understand in what sense time itself is an emergent concept, and one natural way to make sense of such a notion is to understand how pseudo-Riemannian geometry can emerge from more fundamental and abstract notions such as categories of branes. (
              %a.existingWikiWord{:href => "/nlab/show/Greg+Moore"}> G. Moore
              , p.41 of “
              %a.existingWikiWord{:href => "/nlab/show/Physical+Mathematics+and+the+Future"}> Physical Mathematics and the Future
              ”, talk at
              = succeed ")" do
                %a{:href => "http://physics.princeton.edu/strings2014/"} Strings 2014
          %h2#references References
          %p
            Mathematical discussion of
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            includes
          %ul
            %li#Freed99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
                ,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Five+lectures+on+supersymmetry"} Five lectures on supersymmetry
                1999
            %li#Varadarajan04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Veeravalli+Varadarajan"}> Veeravalli Varadarajan
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Supersymmetry+for+mathematicians"}> Supersymmetry for mathematicians
                    \: An introduction
          %p Discussion in the style standard in physics includes
          %ul
            %li#VanProeyen99
              %a.existingWikiWord{:href => "/nlab/show/Antoine+Van+Proeyen"}> Antoine Van Proeyen
              , section 3 of
              %em Tools for supersymmetry
              (
              %a{:href => "http://arxiv.org/abs/hep-th/9910030"}> arXiv:hep-th/9910030
              )
          %p
            Discussion specifically of (real,
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Majorana+representation"} Majorana
            %a.existingWikiWord{:href => "/nlab/show/spin+representations"} spin representations
            includes
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/H.+Blaine+Lawson"}> H. Blaine Lawson
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Marie-Louise+Michelsohn"} Marie-Louise Michelsohn
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Spin+geometry"} Spin geometry
            %li#CastellaniDAuriaFre
              %p
                %a.existingWikiWord{:href => "/nlab/show/Leonardo+Castellani"}> Leonardo Castellani
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Riccardo+D%27Auria"} Riccardo D'Auria
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"} Pietro Fré
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Supergravity+and+Superstrings+-+A+Geometric+Perspective"} Supergravity and Superstrings - A Geometric Perspective
            %li#FigueroaOFarrill
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+Figueroa-O%27Farrill"}> José Figueroa-O'Farrill
                ,
                %em Majorana spinors
                (
                %a{:href => "http://www.maths.ed.ac.uk/~jmf/Teaching/Lectures/Majorana.pdf"}> pdf
                )
          %p
            The relation between
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry+and+division+algebras"} supersymmetry and division algebras
            was gradually established by a variety of authors, including
          %ul
            %li#KugoTownsend82
              %p
                %a.existingWikiWord{:href => "/nlab/show/Taichiro+Kugo"}> Taichiro Kugo
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
                = succeed "," do
                  %em Supersymmetry and the division algebras
                = succeed "," do
                  %a{:href => "http://inspirehep.net/record/181889"} spires
                = succeed ")" do
                  %a{:href => "http://cds.cern.ch/record/140183/files/198301032.pdf"} pdf
            %li#Sudbery84
              %p
                A. Sudbery,
                = succeed "," do
                  %em Division algebras, (pseudo)orthogonal groups and spinors
            %li#Evans88
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Evans"}> Jonathan Evans
                , Supersymmetric Yang–Mills theories and division algebras, Nucl. Phys. B298
              %p (1988), 92–108. Also available as hhttp://www-lib.kek.jp/cgi-bin/img index?198801412i
            %li#ChungSudbery87
              %p
                K.-W. Chung, A. Sudbery,
                = succeed "," do
                  %em Octonions and the Lorentz and conformal groups of ten-dimensional space-time
            %li#ManogueSudbery89
              %p
                %a.existingWikiWord{:href => "/nlab/show/Corinne+Manogue"}> Corinne Manogue
                , A. Sudbery,
                = succeed "," do
                  %em General solutions of covariant superstring equations of motion
            %li#Schray96
              %p
                Jörg Schray,
                = succeed "," do
                  %em The general classical solution of the superparticle
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9407045"} arXiv:hep-th/9407045
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tevian+Dray"}> Tevian Dray
                , J. Janesky,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Corinne+Manogue"} Corinne Manogue
              %p
                Adv. Appl. Clifford Algebras 10 (2000), 193–216 (
                %a{:href => "https://arxiv.org/abs/math/0006069"}> arXiv:math/0006069
                )
          %p
            Streamlined proof and exposition regarding
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry+and+division+algebras"} supersymmetry and division algebras
            is in
          %ul
            %li#BaezHuerta09
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Huerta"} John Huerta
                = succeed "," do
                  %em Division algebras and supersymmetry I
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rosenberg"} Jonathan Rosenberg
                (eds.),
                = succeed "," do
                  %em
                    Superstrings, Geometry, Topology, and
                    = succeed "-algebras" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi C
                            %mo *
                          %annotation{:encoding => "application/x-tex"} C*
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0909.0551"} arXiv:0909.0551
            %li#BaezHuerta10
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Huerta"} John Huerta
                = succeed "," do
                  %em Division algebras and supersymmetry II
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1003.3436"} arXiv:1003.34360
          %p
            A neat collection of background on the real
            %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
            themselves is in
          %ul
            %li#Baez02
              %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
              ,
              = succeed "," do
                %em The Octonions
              = succeed ")" do
                %a{:href => "http://math.ucr.edu/home/baez/octonions/octonions.html"} web
          %p
            The derivation of the process of higher invariant extensions that leads from the
            %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
            to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
          %ul
            %li#MTheoryFromTheSuperpoint
              %a.existingWikiWord{:href => "/nlab/show/John+Huerta"}> John Huerta
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/M-Theory+from+the+Superpoint"} M-Theory from the Superpoint
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1702.01774"} arXiv:1702.01774
        .revisedby
