          .num_prop
            %h6#proposition_35 Proposition
            %p
              Under the identification of prop.
              %a.maruku-ref{:href => "#SpinorRepsByNormedDivisionAlgebraOneDimHigher"}
              of the bilinear pairings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mo ⊗
                    %mi S
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}(-) \;\colon\; S \otimes S \longrightarrow \mathbb{R}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mo ⊗
                    %mi S
                    %mo ⟶
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}\Gamma (-) \;\colon\; S  \otimes S \longrightarrow V
            %p
              of remark
              = succeed "," do
                %a.maruku-ref{:href => "#BilinearPairingForRealRepresentations"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi ϕ
                    %mo ≔
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ψ
                      %mo †
                    %msup
                      %mi Γ
                      %mn 0
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\psi,\phi)
                    \\mapsto
                    \\overline\psi\phi
                    \\coloneqq
                    Re(\psi^\dagger \Gamma^0 \phi)
            %p and the second is characterized by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi η
                            %mrow
                              %mo (
                              %mover
                                %mi ψ
                                %mo ¯
                              %mi Γ
                              %mi ϕ
                              %mo ,
                              %mi A
                              %mo )
                          %mtd
                            %mo =
                            %mover
                              %mi ψ
                              %mo ¯
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mi ϕ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ψ
                              %mo †
                            %msup
                              %mi Γ
                              %mn 0
                            %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mi ϕ
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\eta
                    \\left(
                    \\overline{\psi}\Gamma\phi, A
                    \\right)
                    \&amp;=
                    \\overline{\psi}(\Gamma(A)\phi)
                    \\\
                    \&amp; = Re( \psi^\dagger \Gamma^0 \Gamma(A)\phi)
                    \\end{aligned}
                    \\,.
          %p
            (
            %a{:href => "#BaezHuerta10"}> Baez-Huerta 10, prop. 10, prop. 11
            ).
          %h3#real_pinor_representations_including_spacetime_reflection Real pinor representations (including spacetime reflection)
          %p
            We discuss
            = succeed "-representations" do
              %a.existingWikiWord{:href => "/nlab/show/Pin+group"} Pin(10,1)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Supergravity+and+Superstrings+-+A+Geometric+Perspective"} CDF, II.7.1
            %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            above.
          %p
            The statement is Prop.
            %a.maruku-ref{:href => "#PinGroupRepresentationOnMajoranaSpinors"}
            below. We need the following facts from the above discussion:
          %p
            %strong Dirac representation.
            From
            %a{:href => "#CliffordAlgebraRepresentation"} Prop. 2.18
            we have
          #eq:GammaHermiticity.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Γ
                    %mn 0
                    %mo †
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %msub
                    %mi Γ
                    %mn 0
                  %mphantom
                    %mi AAAA
                  %msubsup
                    %mi Γ
                    %mi a
                    %mo †
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mi Γ
                    %mi a
                  %mphantom
                    %mi AAA
                  %mtext for
                  %mspace{:width => "thickmathspace"}
                  %mi a
                  %mspace{:width => "thickmathspace"}
                  %mtext spatial
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma_0^\dagger = + \Gamma_0
                  \\phantom{AAAA}
                  \\Gamma_{a}^\dagger = - \Gamma_{a}
                  \\phantom{AAA}
                  \\text{for} \; a \; \text{spatial}
          %p
            %strong Charge conjugation matrix.
            From
            %a{:href => "#ChargeConjugationMatrices"} Prop. 2.22
            and
            %a{:href => "#TransposeChargeConjugation"} Remark 2.23
            we get for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo =
                  %mn 11
                %annotation{:encoding => "application/x-tex"} d = 11
            (see the table there) that the charge conjugation matrix satisfies
          #eq:ChargeConjugation.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Γ
                    %mi a
                    %mi T
                  %mi C
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi C
                  %msub
                    %mi Γ
                    %mi a
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma_a^T C = - C \Gamma_a
          %p
            %strong Majorana condition.
            From
            %a{:href => "#TheMajoranaConditionInComponents"} Prop. 2.29
            we have that the Majorana condition on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \psi
            is equivalent to
          #eq:MajoranaCondition.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ψ
                    %mo †
                  %msub
                    %mi Γ
                    %mn 0
                  %mo =
                  %msup
                    %mi ψ
                    %mi t
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\psi^\dagger \Gamma_0 = \psi^t C
          #PinGroupRepresentationOnMajoranaSpinors.num_prop
            %h6#proposition_36 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Pin+group"}> Pin group
                \-
                %a.existingWikiWord{:href => "/nlab/show/representation"} representation
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Majorana+spinors"} Majorana spinors
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 1
                    %mo =
                    %mn 10
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p+1 = 10+1
              and with choice of
              %a.existingWikiWord{:href => "/nlab/show/Dirac+representation"} Dirac representation
              from Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Gamma_{a}
              does not preserves the
              %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
              condition
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:MajoranaCondition"} (3)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ±
                    %mi i
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \pm i \Gamma_{a}
              does.
            %p
              Hence to get on
              %a.existingWikiWord{:href => "/nlab/show/Majorana+spinors"} Majorana spinors
              not just a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Spin+group"} Spin group
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/representation"} representation
              = succeed "-representation" do
                %a.existingWikiWord{:href => "/nlab/show/Pin+group"} Pin group
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a.existingWikiWord{:href => "/nlab/show/reflections"} reflections
              on top of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/rotations"} rotations
              = succeed "," do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi i
                    %msub
                      %mi Γ
                      %mi a
                    %msubsup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi a
                        %mo −
                        %mn 0
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \{i \Gamma_a\}_{a - 0}^p
          .proof
            %h6#proof_23 Proof
            %p
              First assume that the index is spatial. Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              is Majorana, then we compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Γ
                              %mi a
                            %mi ψ
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi T
                            %mi C
                          %mtd
                            %mo =
                            %msup
                              %mi ψ
                              %mi T
                            %msubsup
                              %mi Γ
                              %mi a
                              %mi T
                            %mi C
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mi ψ
                              %mi T
                            %mi C
                            %msub
                              %mi Γ
                              %mi a
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mi ψ
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi Γ
                              %mi a
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %msup
                              %mi ψ
                              %mo †
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi Γ
                              %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mi ψ
                              %mo †
                            %msubsup
                              %mi Γ
                              %mi a
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Γ
                              %mi a
                            %mi ψ
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (\Gamma_a \psi)^T C
                    \&amp; =
                    \\psi^T \Gamma_a^T C
                    \\\
                    \&amp; =
                    \- \psi^T C \Gamma_a
                    \\\
                    \&amp; =
                    \-  \psi^\dagger \Gamma_0 \Gamma_a
                    \\\
                    \&amp; =
                    +  \psi^\dagger \Gamma_a \Gamma_0
                    \\\
                    \&amp; =
                    \-  \psi^\dagger \Gamma_a^\dagger \Gamma_0
                    \\\
                    \&amp; =
                    \- (\Gamma_a \psi)^\dagger \Gamma_0
                    \\end{aligned}
            %p Here
            %ul
              %li
                %p the first equality is that transposition is an algbra anti-homomorphism,
              %li
                %p
                  the second equality is the charge conjugation relation
                  = succeed "," do
                    %a.maruku-eqref{:href => "#eq:ChargeConjugation"} (2)
              %li
                %p
                  the third equality is the Majorana condition
                  %a.maruku-eqref{:href => "#eq:MajoranaCondition"} (3)
                  on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ψ
                        %annotation{:encoding => "application/x-tex"} \psi
              %li
                %p
                  the fourth equality is the Clifford relation
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi Γ
                            %mn 0
                          %mo ,
                          %msub
                            %mi Γ
                            %mi a
                          %mo{:stretchy => "false"} }
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \{\Gamma_0,\Gamma_{a}\} = 0
              %li
                %p
                  the fifth equality is the anti-hermiticity
                  = succeed "," do
                    %a.maruku-eqref{:href => "#eq:GammaHermiticity"} (1)
              %li
                %p
                  the sixth equality is that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo †
                      %annotation{:encoding => "application/x-tex"} \dagger
                  is algebra anti-homomorphism.
            %p
              In conclusion, the overall minus sign between the first and the last term means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi a
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \Gamma_{a} \psi
              fails the Majorana condition
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:MajoranaCondition"} (3)
            %p
              But with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} i \Gamma_{a}
              instead of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \Gamma_{a}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
              is applied, from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo †
                      %mo =
                      %msup
                        %mi i
                        %mo *
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i^\dagger = i^\ast = -i
            %p
              Finally, in the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a = 0
              the same computation goes through once more, except for
              %em two
              extra signs: One from the difference of sign under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
              from
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:GammaHermiticity"} (1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \Gamma_0
          %h2#Supersymmetry Spacetime supersymmetry
          %p
            We have seen in example
            %a.maruku-ref{:href => "#SuperExtensionOfPoincare"}
            that super-extensions of the symmetries of
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            are given by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/real+spin+representations"} real spin representations
            = succeed ")." do
              %a{:href => "#RealSpinRepresentations"} above
          %p
            Hence every
            %a.existingWikiWord{:href => "/nlab/show/real+spin+representation"} real spin representation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo −
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
            induces a
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+extension"} extension
            of the
            %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebra"} Poincaré Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℑ𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{Iso}(\mathbb{R}^{d-1,1})
            in that dimension, i.e. of the Lie algebra of the
            %a.existingWikiWord{:href => "/nlab/show/isometry+group"} isometry group
            of the
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#MinkowskiSpacetime"}
            %em
              %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
              algebras
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
          %p
            Since we may recover a
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            from its
            %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebra"} Poincaré Lie algebra
            as the (vector space underlying the)
            %a.existingWikiWord{:href => "/nlab/show/coset"} coset
            of the
            %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebra"} Poincaré Lie algebra
            by the Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo −
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{so}(d-1,1)
            of the
            %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            (the
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+Lie+algebra"} orthogonal Lie algebra
            in Lorentzian signature)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                  %mo ≃
                  %mi ℑ𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi 𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo −
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{R}^{d-1,1}
                  \\simeq
                  \\mathfrak{Iso}(\mathbb{R}^{d-1,1})/\mathfrak{so}(d-1,1)
          %p
            (namely as the Lie algebra of translations along itself), every
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/extension+of+Lie+algebras"} extension
            of the
            %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebra"} Poincaré Lie algebra
            defines a
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/extension+of+Lie+algebras"} extension
            of Minkowski spacetime. These extensions are the
            %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetimes"} super Minkowski spacetimes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1\vert N}
            which in the
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            literature are often just called “
            %a.existingWikiWord{:href => "/nlab/show/superspace"}> superspace
            ”.
          %p To set the scene, we recall some basics of ordinary spacetime symmetry in
          %ul
            %li
              %em
                %a{:href => "#SpacetimeSymmetry"} Spacetime symmetry
          %p Then in
          %ul
            %li
              %em
                %a{:href => "#SuperPoincareAndSuperMinkowsSymmetry"} Super Poincaré and super Minkowski symmetry
          %p
            we specialize to the particular such extensions commonly known as
            = succeed "." do
              %em supersymmetries
          %p Finally we discuss the question of how god-given this common choice is, in
          %ul
            %li
              %em
                %a{:href => "#SupersymmetryFromTheSuperpoint"} Supersymmetry from the superpoint
          %h3#SpacetimeSymmetry Spacetime symmetry
          #PoincareLieAlgebra.num_defn
            %h6#definition_28 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1}
              for
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/inner+product+space"} inner product space
              whose underlying
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^d
              and equipped with the
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
              given in the canonical
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^d
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo ≔
                    %mi diag
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \coloneqq diag(-1,+1,+1, \cdots, +1)
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+group"} Poincaré group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Iso
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Iso(\mathbb{R}^{d-1,1})
              is the
              %a.existingWikiWord{:href => "/nlab/show/isometry+group"} isometry group
              of this inner product space. The
              %em Poincaré Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{iso}(\mathbb{R}^{d-1,1})
              is the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              of this
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              (its
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Lie+differentiation"} Lie differentiation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Lie
                    %mo{:stretchy => "false"} (
                    %mi Iso
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{iso}(\mathbb{R}^{d-1,1})
                    \\coloneqq
                    Lie(Iso(\mathbb{R}^{d-1,1}))
                    \\,.
          .num_remark
            %h6#remark_15 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+group"} Poincaré group
              is the
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Iso
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo ⋊
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Iso(\mathbb{R}^{d-1,1})
                    \\simeq
                    \\mathbb{R}^{d-1,1} \rtimes O(d-1,1)
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"} Lorentz group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(d-1,1)
              (the group of
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
              %a.existingWikiWord{:href => "/nlab/show/isometries"} isometries
              of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^d
              regarded as the
              %a.existingWikiWord{:href => "/nlab/show/translation+group"} translation group
              along itself, via the defining
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/action"} action
            %p
              Accordingly, the Poincaré Lie algebra is the
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+Lie+algebra"} semidirect product Lie algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo ⋊
                    %msup
                      %mi 𝔰𝔬
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{iso}(\mathbb{R}^{d-1,1})
                    \\simeq
                    \\mathbb{R}^{d-1,1}
                    \\rtimes
                    \\mathfrak{so}^+(d-1,1)
            %p
              of the abelian Lie algebra on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^d
              with the (orthochronous)
              %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+Lie+algebra"} special orthogonal Lie algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔰𝔬
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{so}(d-1,1)
          .num_prop
            %h6#proposition_37 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi P
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{P_a\}
              the canonical
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi d
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^d
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi L
                      %mrow
                        %mi a
                        %mi b
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi L
                      %mrow
                        %mi b
                        %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{L_{a b} = - L_{b a}\}
              the corresponding canonical basis of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔰𝔬
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{so}(d-1,1)
              %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{iso}(\mathbb{R}^{d-1,1})
              is given as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi P
                              %mi a
                            %mo ,
                            %msub
                              %mi P
                              %mi b
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi L
                              %mrow
                                %mi a
                                %mi b
                            %mo ,
                            %msub
                              %mi L
                              %mrow
                                %mi c
                                %mi d
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo =
                            %msub
                              %mi η
                              %mrow
                                %mi d
                                %mi a
                            %msub
                              %mi L
                              %mrow
                                %mi b
                                %mi c
                            %mo −
                            %msub
                              %mi η
                              %mrow
                                %mi b
                                %mi c
                            %msub
                              %mi L
                              %mrow
                                %mi a
                                %mi d
                            %mo +
                            %msub
                              %mi η
                              %mrow
                                %mi a
                                %mi c
                            %msub
                              %mi L
                              %mrow
                                %mi b
                                %mi d
                            %mo −
                            %msub
                              %mi η
                              %mrow
                                %mi d
                                %mi b
                            %msub
                              %mi L
                              %mrow
                                %mi a
                                %mi c
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi L
                              %mrow
                                %mi a
                                %mi b
                            %mo ,
                            %msub
                              %mi P
                              %mi c
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo =
                            %msub
                              %mi η
                              %mrow
                                %mi a
                                %mi c
                            %msub
                              %mi P
                              %mi b
                            %mo −
                            %msub
                              %mi η
                              %mi bc
                            %msub
                              %mi P
                              %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    [P_a, P_b] &amp; = 0
                    \\\
                    [L_{a b}, L_{c d}]
                    \&amp; =
                    \\eta_{d a} L_{b c}
                    \-\eta_{b c} L_{a d}
                    +\eta_{a c} L_{b d}
                    \-\eta_{d b} L_{a c}
                    \\\
                    [L_{a b}, P_c] &amp; = \eta_{a c} P_b -\eta_{bc} P_a
                    \\end{aligned}
          .proof
            %h6#proof_24 Proof
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/Lie+differentiation"} Lie differentiation
              sees only the
              %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
              of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/covering+spaces"} covering spaces
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi SO
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1) \to SO^+(d-1,1)
              (the double cover of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/proper+orthochronous+Lorentz+group"} proper orthochronous Lorentz group
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1}
            %p
              By the discussion at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              is the Lie algebra spanned by the
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              %a.existingWikiWord{:href => "/nlab/show/bivectors"} bivectors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mrow
                        %mi a
                        %mi b
                    %mo ↔
                    %msub
                      %mi Γ
                      %mi a
                    %msub
                      %mi Γ
                      %mi b
                  %annotation{:encoding => "application/x-tex"}
                    L_{a b} \leftrightarrow \Gamma_a \Gamma_b
            %p
              and its
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              on itself as well as on the vectors, identified with single Clifford generators
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi a
                    %mo ↔
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"}
                    P_a \leftrightarrow \Gamma_a
            %p
              is given by forming
              %a.existingWikiWord{:href => "/nlab/show/commutators"} commutators
              in the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi L
                      %mrow
                        %mi a
                        %mi b
                    %mo ,
                    %msub
                      %mi P
                      %mi c
                    %mo{:stretchy => "false"} ]
                    %mo ↔
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                    %mo ,
                    %msub
                      %mi Γ
                      %mi c
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [L_{a b}, P_c]
                    \\leftrightarrow
                    \\tfrac{1}{2}[\Gamma_{a b}, \Gamma_c  ]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi L
                      %mrow
                        %mi a
                        %mi b
                    %mo ,
                    %msub
                      %mi L
                      %mrow
                        %mi c
                        %mi d
                    %mo{:stretchy => "false"} ]
                    %mo ↔
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                    %mo ,
                    %msub
                      %mi Γ
                      %mrow
                        %mi c
                        %mi d
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [L_{a b}, L_{c d}]
                    \\leftrightarrow
                    \\tfrac{1}{2}[\Gamma_{a b}, \Gamma_{c d}  ]
                    \\,.
            %p Via the Clifford relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi a
                    %msub
                      %mi Γ
                      %mi b
                    %mo +
                    %msub
                      %mi Γ
                      %mi b
                    %msub
                      %mi Γ
                      %mi a
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 2
                    %msub
                      %mi η
                      %mrow
                        %mi a
                        %mi b
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_a \Gamma_b + \Gamma_b \Gamma_a = -2 \eta_{a b}
            %p this yields the claim.
          .num_remark
            %h6#remark_16 Remark
            %p
              Dually, the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{iso}(\mathbb{R}^{d-1})
              is generated from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d,1}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∧
                        %mn 2
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \wedge^2 \mathbb{R}^{d,1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi t
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t_a\}
              the standard basis of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1}
              we write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi ω
                      %mrow
                        %mi a
                        %mi b
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\omega^{a b}\}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi e
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{e^a\}
              for these generators. With
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi η
                      %mrow
                        %mi a
                        %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\eta_{a b})
              the components of the
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+metric"} Minkowski metric
              we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ω
                      %mi a
                    %msub
                      %mrow
                      %mi b
                    %mo ≔
                    %msup
                      %mi ω
                      %mrow
                        %mi a
                        %mi c
                    %msub
                      %mi η
                      %mrow
                        %mi c
                        %mi b
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\omega^{a}{}_b \coloneqq \omega^{a c}\eta_{c b}
                    \\,.
            %p In terms of this the CE-differential that defines the Lie algebra structure is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ω
                      %mrow
                        %mi a
                        %mi b
                    %mo =
                    %msup
                      %mi ω
                      %mi a
                    %msub
                      %mrow
                      %mi c
                    %mo ∧
                    %msup
                      %mi ω
                      %mrow
                        %mi c
                        %mi b
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE} \colon \omega^{a b} = \omega^a{}_c \wedge \omega^{c b}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi e
                      %mi a
                    %mo ↦
                    %msup
                      %mi ω
                      %mi a
                    %msub
                      %mrow
                      %mi b
                    %mo ∧
                    %msup
                      %mi t
                      %mi b
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE} \colon e^a \mapsto \omega^{a}{}_b  \wedge t^b
          %h3#SuperPoincareAndSuperMinkowsSymmetry Super Poincaré and super Minkowski symmetry
          %p
            We may now finally make explicit the super-extension of spacetime symmetry according to example
            = succeed ":" do
              %a.maruku-ref{:href => "#SuperExtensionOfPoincare"}
          %p
            In all of the following it is most convenient to regard
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
            dually via their
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebras"} Chevalley-Eilenberg algebras
          #CEAlgebraofSuperLieAlgebra.num_defn
            %h6#definition_29 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              of
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %em
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
              is the super-
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
              on the
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual
              super vector space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge^\bullet  \mathfrak{g}^\ast
            %p
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} d_{\mathfrak{g}}
              that on generators is the linear dual of the super Lie bracket
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi 𝔤
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo →
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ∧
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    d_{\mathfrak{g}} \;\coloneqq\; [-,-]^\ast \;\colon\; \mathfrak{g}^\ast \to \mathfrak{g}^\ast \wedge \mathfrak{g}^\ast
            %p
              and which is extended to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \wedge^\bullet \mathfrak{g}^\ast
              by the graded Leibniz rule (i.e. as a graded
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              Here all elements are
              = succeed "-bigraded," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo ×
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{Z} \times \mathbb{Z}/2)
              %em cohomological grading
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∧
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} n
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \wedge^\n \mathfrak{g}^\ast
              %em super-grading
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              (even/odd).
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi i
                    %mo ∈
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha_i \in CE(\mathfrak{g})
              two elements of homogeneous bi-degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mi i
                      %mo ,
                      %msub
                        %mi σ
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n_i, \sigma_i)
              %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} sign rule
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mn 1
                    %mo ∧
                    %msub
                      %mi α
                      %mn 2
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi σ
                          %mn 1
                        %msub
                          %mi σ
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi α
                      %mn 2
                    %mo ∧
                    %msub
                      %mi α
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha_1 \wedge \alpha_2 = (-1)^{n_1 n_2} (-1)^{\sigma_1 \sigma_2}\; \alpha_2 \wedge \alpha_1
                    \\,.
            %p
              (See at
              %em
                %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} signs in supergeometry
              for discussion of this sign rule and of an alternative sign rule that is also in use. )
          %p
            We may think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
            equivalently as the
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            of
            %a.existingWikiWord{:href => "/nlab/show/invariant+differential+form"} left-invariant
            %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
            on the
            %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} corresponding
            simply connected
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+group"} super Lie group
            \.
          %p
            The concept of
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebras"} Chevalley-Eilenberg algebras
            is traditionally introduced as a means to define
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
          #SuperLieAlgebraCohomology.num_defn
            %h6#definition_30 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %ol
              %li
                %p
                  an
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                    \-cocycle
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  (with
                  %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                  in
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi even
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n,even)
                  in its
                  %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CEAlgebraofSuperLieAlgebra"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi 𝕘
                      %annotation{:encoding => "application/x-tex"} d_{\mathbb{g}}
                  closed.
              %li
                %p
                  the cocycle is non-trivial if it is not
                  = succeed "-exact" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi d
                            %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} d_{\mathfrak{g}}
              %li
                %p
                  hene the
                  %em
                    super-
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  (with
                  %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                  in
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
                  of its
                  %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo ,
                        %mi ℝ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        H^\bullet(\mathfrak{g}, \mathbb{R}) = H^\bullet(CE(\mathfrak{g}))
                        \\,.
          %p
            The following says that the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            is an equivalent incarnation of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
          .num_prop
            %h6#proposition_38 Proposition
            %p The functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi sLieAlg
                      %mi fin
                    %mo ↪
                    %msup
                      %mi dgAlg
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    CE \;\colon\; sLieAlg^{fin}  \hookrightarrow dgAlg^{op}
            %p
              that sends a finite dimensional
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              to its
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CEAlgebraofSuperLieAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              which hence exibits
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
              as a
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differential-graded+algebras"} differential-graded algebras
          #SuperMinkowskiSpacetime.num_defn
            %h6#definition_31 Definition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    d \in \mathbb{N}
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %msub
                      %mi Rep
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    N \in Rep_{\mathbb{R}}(Spin(d-1,1))
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/real+spin+representation"} real spin representation
              of the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              of the
              %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"} Lorentz group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(d-1,1)
              in this dimension. Then the
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                \-dimensional
                = succeed "-supersymmetric" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                %a.existingWikiWord{:href => "/nlab/show/super-Minkowski+spacetime"} super-Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1|N}
              is the
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              that is characterized by the fact that its
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathbb{R}^{d-1,1})
              is as follows:
            %p
              The algebra has generators (as an
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              over
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi e
                            %mi a
                        %mo ⏟
                      %mrow
                        %mi deg
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi even
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi ψ
                            %mi α
                        %mo ⏟
                      %mrow
                        %mi deg
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi odd
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{deg = (1,even)}{\underbrace{e^a}}
                    \\;\;\;\;
                    \\text{and}
                    \\;\;\;\;
                    \\underset{deg = (1,odd)}{\underbrace{\psi^\alpha}}
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mn 9
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} a \in \{0,1,2, \cdots, 9\}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mi ⋯
                    %msub
                      %mi dim
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \alpha \in \{1, 2, \cdots dim_{\mathbb{R}}(N)\}
              subjects to the
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} relations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi e
                              %mi a
                            %mo ∧
                            %msup
                              %mi e
                              %mi b
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mi e
                              %mi b
                            %mo ∧
                            %msup
                              %mi e
                              %mi a
                        %mtr
                          %mtd
                            %msup
                              %mi ψ
                              %mi α
                            %mo ∧
                            %msup
                              %mi ψ
                              %mi β
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %msup
                              %mi ψ
                              %mi β
                            %mo ∧
                            %msup
                              %mi ψ
                              %mi α
                        %mtr
                          %mtd
                            %msup
                              %mi e
                              %mi a
                            %mo ∧
                            %msup
                              %mi ψ
                              %mi α
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mi ψ
                              %mi α
                            %mo ∧
                            %msup
                              %mi e
                              %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    e^a \wedge e^b = - e^b \wedge e^a
                    \\\
                    \\psi^\alpha \wedge \psi^\beta = + \psi^\beta \wedge \psi^\alpha
                    \\\
                    e^a \wedge \psi^\alpha = - \psi^\alpha \wedge e^a
                    \\end{aligned}
            %p
              (see at
              = succeed ")," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} signs in supergeometry
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                  %annotation{:encoding => "application/x-tex"} d_{CE}
              acts on the generators as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %mi d
                                    %mo −
                                    %mn 1
                                    %mo ,
                                    %mn 1
                                    %mo{:stretchy => "false"} |
                                    %mi N
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi ψ
                              %mi α
                          %mtd
                            %mo ≔
                            %mn 0
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %mi d
                                    %mo −
                                    %mn 1
                                    %mo ,
                                    %mn 1
                                    %mo{:stretchy => "false"} |
                                    %mi N
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi e
                              %mi a
                          %mtd
                            %mo ≔
                            %mover
                              %mi ψ
                              %mo ¯
                            %mo ∧
                            %msup
                              %mi Γ
                              %mi a
                            %mi ψ
                        %mtr
                          %mtd
                          %mtd
                            %mo ≔
                            %mrow
                              %mo (
                              %msub
                                %mi C
                                %mrow
                                  %mi α
                                  %mi α
                                  %mo ′
                              %msup
                                %mrow
                                  %msup
                                    %mi Γ
                                    %mi a
                                %mrow
                                  %mi α
                                  %mo ′
                              %msub
                                %mrow
                                %mi β
                              %mo )
                            %msup
                              %mi ψ
                              %mi α
                            %mo ∧
                            %msup
                              %mi ψ
                              %mi β
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d_{\mathbb{R}^{d-1,1\vert N}} \; \psi^\alpha &amp;
                    \\coloneqq
                    0
                    \\\
                    d_{\mathbb{R}^{d-1,1\vert N}} \; e^a
                    \&amp; \coloneqq \overline{\psi} \wedge \Gamma^a \psi
                    \\\
                    \&amp; \coloneqq   \left(C_{\alpha \alpha'} {\Gamma^a}^{\alpha'}{}_\beta\right)  \psi^\alpha \wedge \psi^\beta
                    \\end{aligned}
                    \\,,
            %p where
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi ψ
                          %mo ¯
                        %mo ∧
                        %msup
                          %mi Γ
                          %mi a
                        %mi ψ
                      %annotation{:encoding => "application/x-tex"} \overline{\psi} \wedge \Gamma^a \psi
                  denotes the
                  = succeed "-component" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                        %annotation{:encoding => "application/x-tex"} a
                  = succeed "-invariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} otime
                        %mi N
                        %mo →
                        %msup
                          %mi ℝ
                          %mi d
                      %annotation{:encoding => "application/x-tex"} N \otime N \to \mathbb{R}^d
                  that comes with every
                  %a.existingWikiWord{:href => "/nlab/show/real+spin+representation"} real spin representation
                  applied to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ψ
                        %mo ∧
                        %mi ψ
                      %annotation{:encoding => "application/x-tex"} \psi \wedge \psi
                  regarded as an
                  = succeed "-valued" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo ⊗
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N \otimes N
              %li
                %p
                  hence in components (if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
                  representation, by prop.
                  = succeed ":" do
                    %a.maruku-ref{:href => "#SpinorToVectorBilinearPairing"}
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi C
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mrow
                                %mi α
                                %mi α
                                %mo ′
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} C = (C_{\alpha \alpha'})
                      is the
                      %a.existingWikiWord{:href => "/nlab/show/charge+conjugation+matrix"} charge conjugation matrix
                      (as discussed at
                      = succeed ");" do
                        %em
                          %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi Γ
                              %mi a
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi Γ
                              %mi a
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi α
                            %msub
                              %mrow
                              %mi β
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \Gamma^a = ((\Gamma^a)^{\alpha}{}_\beta)
                      are the
                      %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
                      representing the
                      %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
                      action on
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi N
                          %annotation{:encoding => "application/x-tex"} N
                      in the
                      %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} {
                            %msup
                              %mi ψ
                              %mi α
                            %msubsup
                              %mo{:stretchy => "false"} }
                              %mrow
                                %mi α
                                %mo =
                                %mn 1
                              %mrow
                                %msub
                                  %mi dim
                                  %mi ℝ
                                %mo{:stretchy => "false"} (
                                %mi N
                                %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \{\psi^\alpha\}_{\alpha = 1}^{dim_{\mathbb{R}}(N)}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} summation over paired indices
                  is understood.
            %p
              That this indeed yields a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              follows by the symmetry and equivariance of the bilinear spinor pairing (via prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SpinorToVectorPairing"}
            %p
              There is a canonical
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
              of the
              %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+Lie+algebra"} special orthogonal Lie algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Lie
                    %mo{:stretchy => "false"} (
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
