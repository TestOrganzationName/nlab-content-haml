                          %mi σ
                          %mi z
                        %mo ∈
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \sigma_x,\sigma_y,\sigma_z\in \mathbb{Z}_2
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi σ
                              %mi x
                            %mo ⋅
                            %msub
                              %mi σ
                              %mi y
                        %mo{:stretchy => "false"} [
                        %mi y
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        [x, [y, z]] = [[x,y],z] + (-1)^{\sigma_x \cdot \sigma_y} [y, [x,z]]
                        \\,.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of super Lie algebras is a homomorphisms of the underlying
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              which preserves the Lie bracket. We write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sLieAlg
                  %annotation{:encoding => "application/x-tex"}
                    sLieAlg
            %p
              for the resulting
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of super Lie algebras.
          %p Some obvious but important classes of examples are the following:
          #SuperVectorSpaceAsAbelianSuperLieAlgebra.num_example
            %h6#example Example
            %p
              Every
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#SuperLieAlgebraAsLieAlgebraInternalToSuperVectorSpaces"}
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperLieAlgebraTraditional"}
              %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [-,-] = 0
                    \\,.
            %p These may be called the “abelian” super Lie algebras.
          #OrdinaryLieAlgebraAsSuperLieAlgebra.num_example
            %h6#example_2 Example
            %p
              Every ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#SuperLieAlgebraAsLieAlgebraInternalToSuperVectorSpaces"}
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperLieAlgebraTraditional"}
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LieAlg
                    %mo ↪
                    %mi sLieAlg
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    LieAlg \hookrightarrow sLieAlg
                    \\,.
            %p
              which is a
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
              inclusion in that it has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LieAlg
                    %munderover
                      %mrow
                        %mphantom
                          %mi AA
                        %mo ⊥
                        %mphantom
                          %mi AA
                      %munder
                        %mo ⟵
                        %mover
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %mo ⇝
                      %mo ↪
                    %mi sLieAlg
                  %annotation{:encoding => "application/x-tex"}
                    LieAlg
                    \\underoverset
                    {\underset{ \overset{ \rightsquigarrow}{(-)} }{\longleftarrow}}
                    {\hookrightarrow}
                    {\phantom{AA}\bot\phantom{AA}}
                    sLieAlg
            %p given on the underlying super vector spaces by restriction to the even graded part
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝔰
                      %mo ⇝
                    %mo =
                    %msub
                      %mi 𝔰
                      %mi even
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overset{\rightsquigarrow}{\mathfrak{s}} = \mathfrak{s}_{even}
                    \\,.
          %p Using this we may finally say what a super-extension is supposed to be:
          #SuperExtensions.num_defn
            %h6#definition_2 Definition
            %p
              Given an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %em super-extension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰
                  %annotation{:encoding => "application/x-tex"} \mathfrak{s}
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#SuperLieAlgebraAsLieAlgebraInternalToSuperVectorSpaces"}
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperLieAlgebraTraditional"}
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔤
                    %mo ↪
                    %mi 𝔰
                  %annotation{:encoding => "application/x-tex"}
                    i \;\colon\; \mathfrak{g} \hookrightarrow  \mathfrak{s}
            %p
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is regarded as a super Lie algebra according to example
              = succeed ")" do
                %a.maruku-ref{:href => "#OrdinaryLieAlgebraAsSuperLieAlgebra"}
            %p
              such that this is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              on the even part (example
              = succeed ")" do
                %a.maruku-ref{:href => "#OrdinaryLieAlgebraAsSuperLieAlgebra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi i
                      %mo ⇝
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔤
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi 𝔰
                      %mi even
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overset{\rightsquigarrow}{i}
                    \\;\colon\;
                    \\mathfrak{g} \overset{\simeq}{\longrightarrow} \mathfrak{s}_{even}
                    \\,.
          %p We now make explicit structure involved in super-extensions of Lie algebras:
          #DataInSuperExtension.num_prop
            %h6#proposition_2 Proposition
            %p
              Given an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo ↪
                    %mi 𝔰
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \hookrightarrow \mathfrak{s}
              according to def.
              %a.maruku-ref{:href => "#SuperExtensions"}
              is equivalently the following data:
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
              %li
                %p
                  a Lie action of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                  %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mo :
                        %mi 𝔤
                        %mo ⟶
                        %mi 𝔤𝔩
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{(-)} : \mathfrak{g} \longrightarrow \mathfrak{gl}(S)
                %p
                  from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/endomorphism+Lie+algebra"} endomorphism Lie algebra
                  of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
              %li
                %p
                  a symmetric
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi S
                        %msub
                          %mo ⊗
                          %mi k
                        %mi S
                        %mo ⟶
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"}
                        (-,-) \;\colon\; S \otimes_k S \longrightarrow \mathfrak{g}
            %p such that
            %ol
              %li
                %p
                  the pairing is
                  = succeed "-equivariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ∈
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} t \in \mathfrak{g}
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mi t
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ρ
                          %mi t
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %msub
                          %mi ρ
                          %mi t
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{t}(-,-) = (\rho_t(-),(-)) + (-,\rho_t(-))
              %li
                %p the pairing satisfies
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi ϕ
                            %mo ,
                            %mi ϕ
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{(\phi,\phi)}(\phi) = 0
                %p
                  for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mo ∈
                          %mi S
                        %annotation{:encoding => "application/x-tex"} \phi \in S
          .proof
            %h6#proof Proof
            %p
              By definition of super-extension, the underlying super vector space of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰
                  %annotation{:encoding => "application/x-tex"} \mathfrak{s}
              is necessarily of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔰
                      %mi even
                    %mo =
                    %munder
                      %munder
                        %mi 𝔤
                        %mo ⏟
                      %mrow
                        %msub
                          %mi 𝔰
                          %mi even
                    %mo ⊕
                    %munder
                      %munder
                        %mi S
                        %mo ⏟
                      %mrow
                        %msub
                          %mi 𝔰
                          %mi odd
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{s}_{even} = \underset{\mathfrak{s}_{even}}{\underbrace{\mathfrak{g}}} \oplus \underset{\mathfrak{s}_{odd}}{\underbrace{S}}
            %p
              for some vector space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            %p
              Moreover the super Lie bracket on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰
                  %annotation{:encoding => "application/x-tex"} \mathfrak{s}
              restricts to that of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              when restricted to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %msub
                      %mo ⊗
                      %mi k
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \otimes_{k}\mathfrak{g}
              and otherwise constitutes
            %ol
              %li
                %p a bilinear map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi 𝔰
                              %mi even
                            %mo ⊕
                            %msub
                              %mi 𝔰
                              %mi odd
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi 𝔤
                        %msub
                          %mo ⊗
                          %mi k
                        %mi S
                        %mo ⟶
                        %mi S
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{(-)}(-) \coloneqq [-,-]\vert_{\mathfrak{s}_{even}\oplus \mathfrak{s}_{odd}} \;\colon\; \mathfrak{g} \otimes_k S \longrightarrow S
              %li
                %p a symmetric bilinear map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi 𝔰
                              %mi odd
                            %mo ⊕
                            %msub
                              %mi 𝔰
                              %mi odd
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi S
                        %msub
                          %mo ⊗
                          %mi k
                        %mi S
                        %mo ⟶
                        %mi 𝔤
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (-,-) \coloneqq [-,-]\vert_{\mathfrak{s}_{odd} \oplus \mathfrak{s}_{odd}} \;\colon\; S \otimes_k S \longrightarrow \mathfrak{g}
                        \\,.
            %p
              This yields the claimed
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} structure
              %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} properties
              of these linear maps are now just a restatement of the super-Jacobi identity in terms of this data:
            %ol
              %li
                %p
                  The restriction of the super Jacobi identity of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔰
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔰
                          %mi even
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi even
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi even
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}_{even} \otimes_k \mathfrak{s}_{even} \otimes_k \mathfrak{s}_{even}
                  is equivalently the Jacobi identity on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  and hence is no new constraint.
              %li
                %p
                  The restriction of the super Jacobi identity of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔰
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔰
                          %mi even
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi even
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi odd
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}_{even} \otimes_k \mathfrak{s}_{even} \otimes_k \mathfrak{s}_{odd}
                  says that for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi t
                          %mn 1
                        %mo ,
                        %msub
                          %mi t
                          %mn 2
                        %mo ∈
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} t_1,t_2 \in \mathfrak{g}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} \phi \in S
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 2
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi ρ
                          %mrow
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi t
                              %mn 1
                            %mo ,
                            %msub
                              %mi t
                              %mn 2
                            %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                        %mo +
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 2
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{t_1}( \rho_{t_2}(\phi) ) = \rho_{[t_1,t_2]}(\phi) + \rho_{t_1}( \rho_{t_2}(\phi) )
                        \\,.
                %p This is equivalent to
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 1
                        %mo ∘
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 2
                        %mo −
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 2
                        %mo ∘
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 1
                        %mo =
                        %msub
                          %mi ρ
                          %mrow
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi t
                              %mn 1
                            %mo ,
                            %msub
                              %mi t
                              %mn 2
                            %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{t_1} \circ \rho_{t_2} - \rho_{t_2} \circ \rho_{t_1} = \rho_{[t_1,t_2]}
                %p
                  which means equivalently that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \rho_{(-)}
                  is a Lie algebra homomorphism from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/endomorphism+Lie+algebra"} endomorphism Lie algebra
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie algebra representation
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
              %li
                %p
                  The restriction of the super Jacobi identity of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔰
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔰
                          %mi even
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi odd
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi odd
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}_{even} \otimes_k \mathfrak{s}_{odd}  \otimes_k \mathfrak{s}_{odd}
                  says that for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ∈
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} t \in \mathfrak{g}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo ,
                        %mi ψ
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} \phi,\psi \in S
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mi t
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ρ
                          %mi t
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo ,
                        %msub
                          %mi ρ
                          %mi t
                        %mo{:stretchy => "false"} (
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{t}(\phi,\psi) = (\rho_t(\phi), \psi) + (\phi, \rho_t(\psi))
                        \\,.
                %p
                  This is exactly the claimed
                  = succeed "-equivariance" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %li
                %p
                  The restriction of the super Jacobi identity of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔰
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔰
                          %mi odd
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi odd
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi odd
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}_{odd} \otimes_k \mathfrak{s}_{odd}  \otimes_k \mathfrak{s}_{odd}
                  implies that for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ψ
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} \psi \in S
                  that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi ψ
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi ψ
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} (
                        %mi ψ
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} ]
                        %mo −
                        %mo{:stretchy => "false"} [
                        %mi ψ
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi ψ
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        [\psi,(\psi,\psi)] = [ (\psi,\psi), \psi  ] - [\psi, (\psi, \psi)]
                %p and hence in particular that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} (
                        %mi ψ
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %msub
                          %mi ρ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi ψ
                            %mo ,
                            %mi ψ
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        [(\psi,\psi),\psi] =  \rho_{(\psi,\psi)}(\psi) = 0
                        \\,.
                %p
                  Therefore it only remains to show that this special case is in fact equivalent to the full odd-odd-odd super Jacobi identity. This follows by polarization: First insert
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ψ
                        %mo =
                        %msub
                          %mi ϕ
                          %mn 1
                        %mo +
                        %msub
                          %mi ϕ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \psi = \phi_1 + \phi_2
                  into the above cubic condition to obtain a quadratic condition, then polarize once more in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ϕ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \phi_2
          #TrivialSuperExtension.num_example
            %h6#example_3 Example
            %p
              %strong (trivial super extension)
            %p
              Given an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              there is the
              %em trivial
              super extension (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperExtensions"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰
                    %mo ≔
                    %mi 𝔤
                    %mo ⊕
                    %mi S
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{s} \coloneqq \mathfrak{g} \oplus S
            %p
              and with both the action and the pairing (via prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#DataInSuperExtension"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\rho = 0
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (-,-) = 0
                    \\,.
          %p The key example of interest now is going to be this:
          #SuperExtensionOfPoincare.num_example
            %h6#example_4 Example
            %p
              %strong (super Poincaré super Lie algebra)
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperExtensions"}
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebra"} Poincaré Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{iso}(\mathbb{R}^{d-1,1})
              (recalled as def.
              %a.maruku-ref{:href => "#PoincareLieAlgebra"}
              below) which is non-trivial (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialSuperExtension"}
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie algebra representation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                      %annotation{:encoding => "application/x-tex"} \rho
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔰𝔬
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{so}(d-1,1)
                  on some
                  %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
              %li
                %p
                  an
                  = succeed "-equivariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔰𝔬
                        %annotation{:encoding => "application/x-tex"} \mathfrak{so}
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear pairiing
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %mi S
                        %msub
                          %mo ⊗
                          %mi k
                        %mi S
                        %mo →
                        %msup
                          %mi ℝ
                          %mrow
                            %mi d
                            %mo −
                            %mn 1
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} (-,-) \colon S \otimes_k S \to \mathbb{R}^{d-1,1}
            %p
              It turns out that data as in example
              %a.maruku-ref{:href => "#SuperExtensionOfPoincare"}
              is given for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              the Lie algebra version of a
              %a.existingWikiWord{:href => "/nlab/show/real+spin+representation"} real spin representation
              of the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              (this is prop.
              %a.maruku-ref{:href => "#SpinorToVectorPairing"}
              below). These we introduce and discuss now in
              = succeed "." do
                %em
                  %a{:href => "#RealSpinRepresentations"} Real spin representations
            %p
              The super-extensions of the
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebra"} Poincaré Lie algebra
              induced by
              %a.existingWikiWord{:href => "/nlab/show/real+spin+representations"} real spin representations
              are called
              %em
                %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebras"} super Poincaré Lie algebras
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperMinkowskiSpacetime"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
                algebras
              in the physics literature.
          %p
            But beware that there are more (“exotic”) super-extensions of the Poincaré Lie algebra than the “standard supersymmetry”
            %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebra"} super Poincaré Lie algebra
            from example
            = succeed ":" do
              %a.maruku-ref{:href => "#SuperExtensionOfPoincare"}
          #AnExotiSuperExtensionOfThePoincareLieAlgebra.num_example
            %h6#example_5 Example
            %p
              %strong (an exotic super-extension of the Poincaré Lie algebra)
            %p
              Let
