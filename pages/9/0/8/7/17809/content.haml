                        %annotation{:encoding => "application/x-tex"} S_-
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕂
                        %mo =
                        %mi 𝕆
                      %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{O}
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Majorana-Weyl+representation"} Majorana-Weyl representation
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 9
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(9,1)
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mo +
                      %annotation{:encoding => "application/x-tex"} S_+
                  and on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi S
                            %mo −
                        %annotation{:encoding => "application/x-tex"} S_-
          #RealSpinorPairingsViaDivisionAlg.num_prop
            %h6#proposition_33 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
                %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear
                pairings)
            %p
              Under the identification of prop.
              %a.maruku-ref{:href => "#SpinorRepsByNormedDivisionAlgebra"}
              the
              %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear
              pairings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi S
                      %mo +
                    %mo ⊗
                    %msub
                      %mi S
                      %mo −
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}(-) \;\colon\; S_+ \otimes S_-\longrightarrow \mathbb{R}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi S
                      %mo ±
                    %mo ⊗
                    %msub
                      %mi S
                      %mo ±
                    %mo ⟶
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}\Gamma (-) \;\colon\; S_\pm \otimes S_{\pm}\longrightarrow V
            %p
              from
              %a{:href => "#TheSpinorPairingToVectors"} above
              are given, respectively, by forming the real part of the canonical
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi S
                      %mo +
                    %mo ⊗
                    %msub
                      %mi S
                      %mo −
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}(-) \colon S_+\otimes S_- \longrightarrow \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi ϕ
                    %mo ≔
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ψ
                      %mo †
                    %mo ⋅
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\psi,\phi)\mapsto \overline{\psi} \phi \coloneqq Re(\psi^\dagger \cdot \phi)
            %p
              and by forming the product of a column vector with a row vector to produce a matrix, possibly up to trace reversal (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#TraceReversal"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo +
                    %mo ⊗
                    %msub
                      %mi S
                      %mo +
                    %mo ⟶
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    S_+ \otimes S_+ \longrightarrow V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi Γ
                    %mi ϕ
                    %mo ≔
                    %mover
                      %mrow
                        %mi ψ
                        %msup
                          %mi ϕ
                          %mo †
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi ϕ
                        %msup
                          %mi ψ
                          %mo †
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"}
                    (\psi , \phi) \mapsto \overline{\psi}\Gamma \phi \coloneqq
                    \\widetilde{\psi \phi^\dagger + \phi \psi^\dagger}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo −
                    %mo ⊗
                    %msub
                      %mi S
                      %mo −
                    %mo ⟶
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    S_- \otimes S_- \longrightarrow V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mrow
                      %mi ψ
                      %msup
                        %mi ϕ
                        %mo †
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi ϕ
                      %msup
                        %mi ψ
                        %mo †
                  %annotation{:encoding => "application/x-tex"}
                    (\psi , \phi) \mapsto {\psi \phi^\dagger + \phi \psi^\dagger}
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} A \in V
              the
              = succeed "-component" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi Γ
                    %mi ϕ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ψ
                      %mo †
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta(\overline{\psi}\Gamma \phi, A)
                    \=
                    Re (\psi^\dagger (A\phi))
                    \\,.
          %p
            (
            %a{:href => "#BaezHuerta09"}> Baez-Huerta 09, prop. 8, prop. 9
            ).
          #RealSpinorRepsIn3d.num_example
            %h6#example_7 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/real+spin+representation"} real spin representation
                in
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo =
                        %mn 2
                        %mo +
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} d = 2+1
            %p
              Consider the case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                    %mo =
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{R}
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %p
              Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msubsup
                      %mi Mat
                      %mrow
                        %mn 2
                        %mo ×
                        %mn 2
                      %mi symm
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V= Mat^{symm}_{2\times 2}(\mathbb{R})
              is the space of symmetric 2x2-matrices with real numbers.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mrow
                          %mo (
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi t
                                  %mo +
                                  %mi x
                                %mtd
                                  %mi y
                              %mtr
                                %mtd
                                  %mi y
                                %mtd
                                  %mi t
                                  %mo −
                                  %mi x
                          %mo )
                        %mo |
                      %mi t
                      %mo ,
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi ℝ
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    V =
                    \\left\{
                    \\left.
                    \\left(
                    \\array{
                    t + x &amp; y
                    \\\
                    y &amp; t - x
                    }
                    \\right)
                    \\right\vert
                    t,x,y\in \mathbb{R}
                    \\right\}
            %p
              The “light-cone”-
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              for this space would be
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msup
                        %mi v
                        %mo +
                      %mo ≔
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mn 1
                              %mtd
                                %mn 0
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 0
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi v
                        %mo −
                      %mo ≔
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 0
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 1
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi v
                        %mi y
                      %mo ≔
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 1
                            %mtr
                              %mtd
                                %mn 1
                              %mtd
                                %mn 0
                        %mo )
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    v^+
                    \\coloneqq
                    \\left(
                    \\array{
                    1 &amp; 0
                    \\\
                    0 &amp; 0
                    }
                    \\right)
                    \\,,
                    \\;
                    v^-
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; 0
                    \\\
                    0 &amp; 1
                    }
                    \\right)
                    \\,,
                    \\;
                    v^y
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; 1
                    \\\
                    1 &amp; 0
                    }
                    \\right)
                    \\right\}
            %p
              Its trace reversal (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TraceReversal"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msup
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ˜
                        %mo +
                      %mo ≔
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 0
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ˜
                        %mo −
                      %mo ≔
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                              %mtd
                                %mn 0
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 0
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ˜
                        %mi y
                      %mo ≔
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 1
                            %mtr
                              %mtd
                                %mn 1
                              %mtd
                                %mn 0
                        %mo )
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\tilde{v}^+
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; 0
                    \\\
                    0 &amp; -1
                    }
                    \\right)
                    \\,,
                    \\;
                    \\tilde v^-
                    \\coloneqq
                    \\left(
                    \\array{
                    \-1 &amp; 0
                    \\\
                    0 &amp; 0
                    }
                    \\right)
                    \\,,
                    \\;
                    \\tilde v^y
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; 1
                    \\\
                    1 &amp; 0
                    }
                    \\right)
                    \\right\}
            %p
              Hence the Minkowski metric of prop.
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              in this basis has the components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                            %mtd
                              %mn 0
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 0
                            %mtd
                              %mn 2
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta
                    \=
                    \\left(
                    \\array{
                    0 &amp; -1 &amp; 0
                    \\\
                    \-1 &amp; 0 &amp; 0
                    \\\
                    0 &amp; 0 &amp; 2
                    }
                    \\right)
                    \\,.
            %p
              As vector spaces
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mo ±
                      %mo =
                      %msup
                        %mi ℝ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S_{\pm} = \mathbb{R}^2
            %p
              The bilinear spinor pairing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi S
                      %mo +
                    %mo ⊗
                    %msub
                      %mi S
                      %mo −
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \overline{(-)}(-) \colon S_+ \otimes S_- \to \mathbb{R}
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mover
                              %mi ψ
                              %mo ¯
                            %mi ϕ
                          %mtd
                            %mo =
                            %msup
                              %mi ψ
                              %mi t
                            %mo ⋅
                            %mi ϕ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ψ
                              %mn 1
                            %msub
                              %mi ϕ
                              %mn 1
                            %mo +
                            %msub
                              %mi ψ
                              %mn 2
                            %msub
                              %mi ϕ
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\overline{\psi}\phi
                    \&amp;= \psi^t \cdot \phi
                    \\\
                    \&amp; = \psi_1  \phi_1 + \psi_2 \phi_2
                    \\end{aligned}
                    \\,.
            %p
              The spinor pairing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo +
                    %mo ⊗
                    %msub
                      %mi S
                      %mo +
                    %mo ⊗
                    %msup
                      %mi V
                      %mo *
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} S_+ \otimes S_+ \otimes V^\ast \to \mathbb{R}
              from prop.
              %a.maruku-ref{:href => "#RealSpinorPairingsViaDivisionAlg"}
              is given on an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msub
                      %mi A
                      %mo +
                    %msup
                      %mi v
                      %mo +
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msub
                      %mi A
                      %mo −
                    %msup
                      %mi v
                      %mo −
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msub
                      %mi A
                      %mi y
                    %msup
                      %mi v
                      %mi y
                  %annotation{:encoding => "application/x-tex"} A = A_+ v^+ + A_- v^- + A_y v^y
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo +
                    %mo ,
                    %msub
                      %mi A
                      %mo −
                    %mo ,
                    %msub
                      %mi A
                      %mi y
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} A_+, A_-, A_y \in \mathbb{R}
