              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CliffordAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/unitary+operator"} unitary
              with respect to the conjugation operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{(-)}
              from def.
              = succeed ":" do
                %a.maruku-ref{:href => "#CliffordAlgebra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mi A
                      %mo ∈
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi even
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mover
                        %mi A
                        %mo ¯
                      %mi A
                      %mo =
                      %mn 1
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Spin(d-1,1)
                    \\;\coloneqq\;
                    \\left\{
                    A \in Cl(\mathbb{R}^{d-1,1})_{even}
                    \\;\vert\;
                    \\overline{A} A = 1
                    \\right\}
                    \\,.
          #SpinDoubleCover.num_prop
            %h6#proposition_5 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
