                              %mi ψ
                              %mn 2
                            %mo{:stretchy => "false"} ⟩
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} ⟨
                            %mi C
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mi T
                            %msubsup
                              %mi ψ
                              %mn 1
                              %mo *
                            %mo ,
                            %msub
                              %mi ψ
                              %mn 2
                            %mo{:stretchy => "false"} ⟩
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi C
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mi T
                            %msubsup
                              %mi ψ
                              %mn 1
                              %mo *
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi ψ
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi ψ
                              %mn 1
                              %mi T
                            %msup
                              %mi C
                              %mo †
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mo *
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi ψ
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi ψ
                              %mn 1
                              %mi T
                            %mi C
                            %msub
                              %mi ψ
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\langle J(\psi_1),\psi_2 \rangle
                    \&amp;=
                    \\langle C \Gamma_0^T\psi_1^\ast, \psi_2\rangle
                    \\\
                    \&amp; =
                    (C \Gamma_0^T \psi_1^\ast)^\dagger \Gamma_0 \psi_2
                    \\\
                    \&amp; = \psi_1^T C^\dagger \Gamma_0^\ast \Gamma_0 \psi_2
                    \\\
                    \&amp; = \psi_1^T C \psi_2
                    \\end{aligned}
                    \\,.
          #MajoranaConjugation.num_defn
            %h6#definition_14 Definition
            %p
              For a Clifford algebra representation on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mi ν
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^\nu
              as in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi T
                    %mi C
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Mat
                      %mrow
                        %msup
                          %mn 2
                          %mi ν
                        %mo ×
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Mat
                      %mrow
                        %mn 1
                        %mo ×
                        %msup
                          %mn 2
                          %mi ν
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (-)^T C
                    \\;\colon\;
                    Mat_{2^\nu \times 1}(\mathbb{C})
                    \\longrightarrow
                    Mat_{1 \times 2^\nu}(\mathbb{C})
            %p
              (from complex column vectors to complex row vectors) which is given by transposition followed by
              %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
              from the right by the
              %a.existingWikiWord{:href => "/nlab/show/charge+conjugation+matrix"} charge conjugation matrix
              according to prop.
              %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
              is called the
              = succeed "." do
                %strong Majorana conjugation
          #TheMajoranaConditionInComponents.num_prop
            %h6#proposition_13 Proposition
            %p
              In dimensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 4
                    %mo ,
                    %mn 8
                    %mo ,
                    %mn 9
                    %mo ,
                    %mn 10
                    %mo ,
                    %mn 11
                  %annotation{:encoding => "application/x-tex"} d = 4, 8, 9, 10, 11
              a spinor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo ∈
                    %msup
                      %mi ℂ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mn 2
                          %mi ν
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \psi \in \mathbb{C}^{(2^\nu)}
              is a real spinor according to def.
              %a.maruku-ref{:href => "#MajoranaSpinorGeneral"}
              with respect to the
              %a.existingWikiWord{:href => "/nlab/show/real+structure"} real structure
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo =
                    %mi C
                    %msubsup
                      %mi Γ
                      %mn 0
                      %mi T
                    %msup
                      %mi ψ
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\psi = C \Gamma_0^T \psi^\ast
            %p
              (as e.g. in
              = succeed ")," do
                %a{:href => "#CastellaniDAuriaFre"} Castellani-D’Auria-Fré, (II.7.22)
            %p
              This is equivalent to the condition that the Majorana conjugate (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MajoranaConjugation"}
              = succeed ")" do
                %a.maruku-ref{:href => "#DiracConjugate"}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ψ
                      %mi T
                    %mi C
                    %mo =
                    %msup
                      %mi ψ
                      %mo †
                    %msub
                      %mi Γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\psi^T C = \psi^\dagger \Gamma_0
            %p
              and such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              are called
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/Majorana+spinors"} Majorana spinors
            %p This condition is also equivalent to the condition that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi ψ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (\psi,-)
                    \=
                    \\langle \psi,-\rangle
                    \\,,
            %p
              where on the left we have the complex bilinear form of prop.
              %a.maruku-ref{:href => "#ComplexBilinearFormInducedFromMajoranaStructure"}
              and on the right the
              %a.existingWikiWord{:href => "/nlab/show/hermitian+form"} hermitian form
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
          .proof
            %h6#proof_9 Proof
            %p
              The first statement is immediate. The second follows by applying the transpose to the first equation, and using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^{-1} = C^T
              (from prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#ChargeConjugationMatrices"}
              = succeed "." do
                %a.maruku-ref{:href => "#ComplexBilinearFormInducedFromMajoranaStructure"}
          %p Of course we may combine the condition Majorana and Weyl conditions on spinors:
          #WeylMajorana.num_defn
            %h6#definition_15 Definition
            %p
              In the even dimensions among those dimensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              for which the Majorana projection operator (real structure)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              exists (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \Gamma_{d}
              exists (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#WeylRepresentation"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              is both Majorana,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo{:stretchy => "false"} (
                      %mi ψ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} J(\psi) = \psi
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi d
                      %mi ψ
                      %mo =
                      %mo ±
                      %mi i
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \Gamma_d \psi = \pm i \psi
              = succeed "," do
                %strong Majorana-Weyl spinor
              %a.existingWikiWord{:href => "/nlab/show/sub-representation"} sub-representation
              these form is a called a
              = succeed "." do
                %em Majorana-Weyl representation
          #WeylMajoranaInLorentzian10d.num_prop
            %h6#proposition_14 Proposition
            %p
              In Lorentzian signature for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 4
                      %mo ≤
                      %mi d
                      %mo ≤
                      %mn 11
                    %annotation{:encoding => "application/x-tex"} 4 \leq d \leq 11
              = succeed ")" do
                %a.maruku-ref{:href => "#WeylMajorana"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo =
                      %mn 10
                    %annotation{:encoding => "application/x-tex"} d = 10
          .proof
            %h6#proof_10 Proof
            %p
              According to prop.
              %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
              Majorana spinors in the given range exist for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 4
                      %mo ,
                      %mn 8
                      %mo ,
                      %mn 9
                      %mo ,
                      %mn 10
                      %mo ,
                      %mn 11
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} d \in \{4,8,9,10,11\}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 4
                      %mo ,
                      %mn 8
                      %mo ,
                      %mn 10
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} d \in \{4,8,10\}
            %p Majorana-Weyl spinors clearly exist precisely if the two relevant projection operators in these dimensions commute with each other, i.e. if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi J
                    %mo ,
                    %mi ϵ
                    %msub
                      %mi Γ
                      %mn 0
                    %mi ⋯
                    %msub
                      %mi Γ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    [J, \epsilon \Gamma_0 \cdots \Gamma_{d-1}] = 0
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thickmathspace"}
                              %mi ν
                              %mspace{:width => "thinmathspace"}
                              %mtext odd
                          %mtr
                            %mtd
                              %mi i
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thickmathspace"}
                              %mi ν
                              %mspace{:width => "thinmathspace"}
                              %mtext even
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon
                    \=
                    \\left\{
                    \\array{
                    1 &amp; \vert \; \nu \, \text{odd}
                    \\\
                    i &amp; \vert \; \nu \, \text{even}
                    }
                    \\right.
                    \\,.
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 2
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} d = 2\nu
              (from the proof of prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            %p
              By prop.
              %a.maruku-ref{:href => "#RealStructureAntiCommutesWithSingleCliffordGenerator"}
              all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Gamma_a
              commute or all anti-commute with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mn 0
                    %mi ⋯
                    %msub
                      %mi Γ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Gamma_0 \cdots \Gamma_{d-1}
              contains an even number of these, it commutes with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              commutes with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \Gamma_d
              precisely if it commutes with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              is conjugate-linear, this is the case precisely if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \epsilon = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 2
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} d = 2\nu
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
              odd.
            %p
              This is the case for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo =
                      %mn 10
                      %mo =
                      %mn 2
                      %mo ⋅
                      %mn 5
                    %annotation{:encoding => "application/x-tex"} d = 10 = 2 \cdot 5
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 8
                    %mo =
                    %mn 2
                    %mo ⋅
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} d = 8 = 2 \cdot 4
              neither for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo =
                      %mn 4
                      %mo =
                      %mn 2
                      %mo ⋅
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} d = 4 = 2 \cdot 2
          %h4#pseudomajorana_spinors_and_symplectic_structure Pseudo-Majorana spinors and Symplectic structure
          %p
            In
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 5
                  %annotation{:encoding => "application/x-tex"} d = 5
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo =
                  %mi C
                  %msubsup
                    %mi Γ
                    %mn 0
                    %mi T
                  %msup
                    %mi ψ
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\psi = C \Gamma_0^T \psi^\ast
          %p
            from prop.
            %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
            has no solution. But if we consider the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            of two copies of the complex spinor representation space, with elements denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ψ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \psi_1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \psi_2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %msubsup
                    %mi Γ
                    %mn 0
                    %mi T
                  %msubsup
                    %mi ψ
                    %mn 1
                    %mo *
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mi ψ
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi C
                  %msubsup
                    %mi Γ
                    %mn 0
                    %mi T
                  %msubsup
                    %mi ψ
                    %mn 2
                    %mo *
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %msub
                    %mi ψ
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  C \Gamma_0^T \psi_1^\ast = -\psi_2
                  \\;\;\;\;
                  C \Gamma_0^T \psi_2^\ast = +\psi_1
          %p
            (e.g
            = succeed ")." do
              %a{:href => "#CastellaniDAuriaFre"} Castellani-D’Auria-Fré, II.8.41
            %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
            and def.
            %a.maruku-ref{:href => "#MajoranaSpinorGeneral"}
            shows that this exhibits a quaternionic structure on the original complex spinor space, and hence a real structure on its direct sum double.
          %h4#TheSpinorPairingToVectors
            The spinor bilinear pairing to antisymmetric
            = succeed "-tensors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %p
            We now discuss, in the component expressions established
            = succeed "," do
              %a{:href => "#InComponents"} above
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vector"} vector
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tensor"} tensor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo ↦
                  %mi ϵ
                  %mrow
                    %mo (
                    %mover
                      %mi ψ
                      %mo ¯
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mi p
                    %mi ψ
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\psi
                  \\mapsto
                  \\epsilon \left( \overline{\psi} \Gamma^{a_1 \cdots a_p} \psi \right)
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo ∈
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{C}
            is some prefactor, constrained such as to make the whole expression be real, hence such as to make this the components of an element in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
