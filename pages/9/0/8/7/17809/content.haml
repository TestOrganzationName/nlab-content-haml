                                      %mo +
                                      %msub
                                        %mi x
                                        %mn 1
                                    %mtd
                                      %mi y
                                  %mtr
                                    %mtd
                                      %msup
                                        %mi y
                                        %mo *
                                    %mtd
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo −
                                      %msub
                                        %mi x
                                        %mn 1
