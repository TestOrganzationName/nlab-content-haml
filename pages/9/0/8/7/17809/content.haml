                    \\;=\;
                    \\left(
                    \\array{
                    \\tilde A(A \phi)
                    \\\
                    A(\tilde A \psi)
                    }
                    \\right)
                    \\,,
            %p where on the right we have in each component ordinary matrix product expressions.
            %p Now observe that both expressions on the right are sums of triple products that involve either one real factor or two factors that are conjugate to each other:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
