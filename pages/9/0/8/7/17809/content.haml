            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ϕ
                          %mtr
                            %mtd
                              %mi ψ
                      %mo )
