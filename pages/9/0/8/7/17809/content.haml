                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} |
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1\vert 1}
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                \-supersymmetric
                %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebra"} super Poincaré Lie algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔦𝔰𝔬
