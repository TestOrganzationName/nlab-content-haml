                              %mo (
                              %msub
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                                %mn 1
                              %msub
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                                %mn 2
                              %mo +
                              %msub
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                                %mn 2
                              %msub
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                                %mn 1
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi η
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi v
                              %mn 1
                            %mo ,
                            %msub
                              %mi v
                              %mn 2
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\eta(\overline{A}v_1A , \overline{A} v_2 A)
                    \&amp;=
                    \\tfrac{1}{2}
                    \\left(
                    \\left(\overline{A} \hat v_1 A\right) \left(\overline{A}\hat v_2 A\right)
                    +
                    \\left(\overline{A} \hat v_2 A\right) \left(\overline{A} \hat v_1 A\right)
                    \\right)
                    \\\
                    \&amp; =
                    \\tfrac{1}{2}
                    \\left(
                    \\overline{A}(\hat v_1 \hat v_2 + \hat v_2 \hat v_1) A
                    \\right)
                    \\\
                    \&amp; =
                    \\overline{A} A \tfrac{1}{2}\left( \hat v_1 \hat v_2 + \hat v_2 \hat v_1\right)
                    \\\
                    \&amp; =
                    \\eta(v_1, v_2)
                    \\end{aligned}
                    \\,.
            %p
              That it moreover lands in the
              %a.existingWikiWord{:href => "/nlab/show/proper+Lorentz+group"} proper Lorentz group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(d-1,1)
              follows from observing (example
              = succeed ")" do
                %a.maruku-ref{:href => "#CliffordConjugtionReflectionAndRotation"}
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
              by a linear combination of generators, which are excluded from the group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              (as that is defined to be in the even subalgebra).
            %p
              To see that the homomorphism is surjective, use that all elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(d-1,1)
              are products of
              %a.existingWikiWord{:href => "/nlab/show/rotations"} rotations
              in hyperplanes. If a hyperplane is spanned by the
              %a.existingWikiWord{:href => "/nlab/show/bivector"} bivector
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ω
                        %mrow
                          %mi a
                          %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\omega^{a b})
              %a.maruku-ref{:href => "#CliffordConjugtionReflectionAndRotation"}
              by the conjugation action by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi α
                        %mn 2
                    %msup
                      %mi ω
                      %mrow
                        %mi a
                        %mi b
                    %msub
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\tfrac{\alpha}{2} \omega^{a b}\Gamma_{a b})
            %p
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
            %p
              That the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              is clear from the fact that the only even Clifford elements which commute with all vectors are the multiples
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi ℝ
                    %mo ↪
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a \in \mathbb{R} \hookrightarrow Cl(\mathbb{R}^{d-1,1})
              of the identity. For these
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi a
                      %mo ¯
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \overline{a} = a
              and hence the condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi a
                      %mo ¯
                    %mi a
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \overline{a} a = 1
              is equivalent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi a
                        %mn 2
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} a^2 = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{+1,-1\}
              are in the
              %a.existingWikiWord{:href => "/nlab/show/center"} center
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              = succeed "." do
                %a.maruku-ref{:href => "#AmbiguityInCliffordConjugation"}
          %h4#real_structure_on_unitary_representations Real structure on Unitary representations
          %p
            We are interested in
            %a.existingWikiWord{:href => "/nlab/show/spin+representations"} spin representations
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+vector+spaces"} real vector spaces
            %a.existingWikiWord{:href => "/nlab/show/unitary+representations"} unitary representations
            on
            %a.existingWikiWord{:href => "/nlab/show/complex+vector+spaces"} complex vector spaces
            by equipping these with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+structure"} real structure
            %a.existingWikiWord{:href => "/nlab/show/real+structure"} real structure
            usually not made explicit, but phrased in terms of (symplectic)
            %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana
            conditions).
          %p
            Hence for reference, we here recollect the basics of the concept of
            %a.existingWikiWord{:href => "/nlab/show/unitary+representations"} unitary representations
            equipped with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+structure"} real structure
          %p
            All
            %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            in the following are taken to be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+spaces"} finite dimensional vector spaces
          #RealStructure.num_defn
            %h6#definition_8 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
              %em
                %a.existingWikiWord{:href => "/nlab/show/real+structure"} real structure
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/quaternionic+structure"} quaternionic structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is a real-
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi V
                    %mo ⟶
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \;\colon\; V \longrightarrow V
            %p such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                      %annotation{:encoding => "application/x-tex"} \phi
                  is conjugate linear, in that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mover
                          %mi λ
                          %mo ¯
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \phi(\lambda v) = \overline{\lambda} \phi(v)
                  for all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi λ
                          %mo ∈
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} \lambda \in \mathbb{C}
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi v
                          %mo ∈
                          %mi V
                        %annotation{:encoding => "application/x-tex"} v \in V
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ϕ
                          %mn 2
                        %mo =
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                  %mi id
                                %mtd
                                  %mtext for real structure
                              %mtr
                                %mtd
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi id
                                %mtd
                                  %mtext for quaternionic structure
                      %annotation{:encoding => "application/x-tex"} \phi^2 = \left\{ \array{ +id &amp; \text{for real structure} \\ -id &amp; \text{for quaternionic structure} }  \right.
          .num_remark
            %h6#remark_4 Remark
            %p
              A real structure
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
              = succeed "," do
                %a.maruku-ref{:href => "#RealStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              corresponds to a choice of complex linear isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ≃
                    %mi ℂ
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %msub
                      %mi V
                      %mo +
                  %annotation{:encoding => "application/x-tex"}
                    V \simeq \mathbb{C} \otimes_{\mathbb{R}} V_+
            %p
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              with the
              %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
              of a
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mo +
                    %annotation{:encoding => "application/x-tex"} V_+
              %a.existingWikiWord{:href => "/nlab/show/eigenspace"} eigenspace
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              for
              %a.existingWikiWord{:href => "/nlab/show/eigenvalue"} eigenvalue
              +1, while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mo −
                    %mo ≔
                    %mi i
                    %msub
                      %mi V
                      %mo +
                  %annotation{:encoding => "application/x-tex"} V_- \coloneqq i V_+
              is the eigenspace of eigenvalue -1.
            %p
              A quaternionic structure, def.
              = succeed "," do
                %a.maruku-ref{:href => "#RealStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              gives it the structure of a left
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              over the
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TheQuaternions"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                        %mo ≔
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %mi V
                        %mo →
                        %mi V
                      %annotation{:encoding => "application/x-tex"} I \coloneqq i(-) \colon V \to V
                  be the operation of multiplying with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ∈
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} i \in \mathbb{C}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                        %mo ≔
                        %mi ϕ
                        %mo{:lspace => "verythinmathspace"} :
                        %mi V
                        %mo →
                        %mi V
                      %annotation{:encoding => "application/x-tex"} J \coloneqq \phi \colon V \to V
                  be the given endomorphisms,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo ≔
                        %mi I
                        %mo ∘
                        %mi J
                      %annotation{:encoding => "application/x-tex"} K \coloneqq I \circ J
                  their composite,
            %p
              then the conjugate complex linearity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ∘
                    %mi I
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi I
                    %mo ∘
                    %mi J
                  %annotation{:encoding => "application/x-tex"}
                    J \circ I = - I \circ J
            %p
              and hence with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mn 2
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} J^2 = -1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mn 2
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} I^2 = -1
              this means that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              act like the imaginary
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
          #RealStructureOnLinearRepresentation.num_defn
            %h6#definition_9 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo ⟶
                    %msub
                      %mi GL
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\rho \;\colon\; G \longrightarrow GL_{\mathbb{C}}(V)
            %p
              be a complex
              %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
              form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              to the
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %p
              Then a
              %em real structure
              or
              %em quaternionic structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi ρ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V,\rho)
              is a real or complex structure, respectively,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#RealStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is
              = succeed "-invariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ∘
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi ϕ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \circ \rho(g) = \rho(g) \circ \phi
                    \\,.
          %p
            We will be interested in complex
            %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+spaces"} finite dimensional vector spaces
            equipped with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/hermitian+forms"} hermitian forms
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+spaces"} Hilbert spaces
          #HermitianForms.num_defn
            %h6#definition_10 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/hermitian+form"} hermitian form
              (or symmetric complex
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/sesquilinear+form"} sesquilinear form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
              on a
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is a real
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi V
                    %mo ×
                    %mi V
                    %mo ⟶
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    \\langle
                    \-,-
                    \\rangle
                    \\;\colon\;
                    V \times V
                    \\longrightarrow
                    \\mathbb{C}
            %p
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v_1, v_2 \in V
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \lambda \in \mathbb{C}
              then
            %ol
              %li
                %p
                  (sesquilinearity)
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi v
                            %mn 1
                          %mo ,
                          %mi λ
                          %msub
                            %mi v
                            %mn 2
                          %mo{:stretchy => "false"} ⟩
                          %mo =
                          %mi λ
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi v
                            %mn 1
                          %mo ,
                          %msub
                            %mi v
                            %mn 2
                          %mo{:stretchy => "false"} ⟩
                        %annotation{:encoding => "application/x-tex"} \langle v_1, \lambda v_2 \rangle = \lambda \langle v_1, v_2 \rangle
              %li
                %p
                  (conjugate symmetry)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi v
                            %mn 1
                          %mo ,
                          %msub
                            %mi v
                            %mn 2
                          %msup
                            %mo{:stretchy => "false"} ⟩
                            %mo *
                          %mo =
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi v
                            %mn 2
                          %mo ,
                          %msub
                            %mi v
                            %mn 1
                          %mo{:stretchy => "false"} ⟩
                        %annotation{:encoding => "application/x-tex"} \langle v_1, v_2\rangle^\ast = \langle v_2, v_1\rangle
              %li
                %p
                  (non-degeneracy) if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \langle v_1,-\rangle = 0
                  then
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi v
                            %mn 1
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} v_1 = 0
            %p
              A complex
              %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi V
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} f \colon V \to V
              is
              %em
                %a.existingWikiWord{:href => "/nlab/show/unitary+operator"} unitary
              with respect to this hermitian form if it preserves it, in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle f(-), f(-)\rangle
                    \=
                    \\langle -,-\rangle
                    \\,.
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi GL
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    U(V) \hookrightarrow GL_{\mathbb{C}}(V)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of
              %a.existingWikiWord{:href => "/nlab/show/unitary+operators"} unitary operators
              inside the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            %p
              A complex
              %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo ⟶
                    %msub
                      %mi GL
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho \colon G \longrightarrow GL_{\mathbb{C}}(V)
              of a
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/unitary+representation"} unitary representation
              if it factors through this subgroup
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo ⟶
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi GL
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\rho \;\colon\;  G \longrightarrow U(V) \hookrightarrow GL_{\mathbb{C}}(V)
                    \\,.
          %p The following proposition uses assumptions stronger than what we have in the application to Majorana spinors (compact Lie group, positive definite hermitian form) but it nevertheless helps to see the pattern.
          #Prop.num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
              some
              %a.existingWikiWord{:href => "/nlab/show/positive+definite+bilinear+form"} positive definite
              %a.existingWikiWord{:href => "/nlab/show/hermitian+form"} hermitian form
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %a.maruku-ref{:href => "#HermitianForms"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho \colon G \to U(V)
              a
              %a.existingWikiWord{:href => "/nlab/show/unitary+representation"} unitary representation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              carries a real structure or quaternionc structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#RealStructureOnLinearRepresentation"}
              %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi V
                    %msub
                      %mo ⊗
                      %mi ℂ
                    %mi V
                    %mo ⟶
                    %mi ℂ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (-,-) \;\colon\; V \otimes_{\mathbb{C}} V \longrightarrow \mathbb{C}
                    \\,.
            %p Explicitly:
            %p
              Given a real/quaternionic structure
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} ⟨
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (-,-) \coloneqq \langle \phi(-), -\rangle
                    \\,.
            %p
              Conversely, given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-,-)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ϕ
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde \phi
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mi ϕ
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (-,-) = \langle \tilde\phi(-),-\rangle
                    \\,,
            %p
              and then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ≔
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi ϕ
                        %mo{:stretchy => "false"} |
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi \coloneqq \frac{1}{\vert \phi\vert} \phi
              is the corresponding real/quaternionic structure.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ϕ
                      %mo{:stretchy => "false"} ˜
                    %mo =
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \tilde\phi = \phi
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-,-)
              is called
              %em compatible
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle-,- \rangle
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "Majorana+spinor#Meinrenken13"} Meinrenken 13, p. 81
          %h4#DiracAndWeylRepresentations Dirac and Weyl representations
          %p
            Hence the task is now first to understand representations of the
            %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            on
            %a.existingWikiWord{:href => "/nlab/show/complex+vector+spaces"} complex vector spaces
            (such as to then equip these with
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/real+structure"} real structure
            %em Dirac representations.
          %p One advantage of this approach of constructing real representations inside complex representations is the following:
          .num_remark
            %h6#remark_5 Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mn 2
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} d \in 2\mathbb{N}
              an even
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{d-1,1}) \otimes_{\mathbb{R}} \mathbb{C}
              of the
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{d-1,1})
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CliffordAlgebra"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/central+simple+algebra"} central simple algebra
              %a.existingWikiWord{:href => "/nlab/show/Artin-Wedderburn+theorem"} Artin-Wedderburn theorem
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              simply to a
              %a.existingWikiWord{:href => "/nlab/show/matrix+algebra"} matrix algebra
              over the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            %p
              Clearly, this drastically simplifies certain considerations about Clifford algebra, for instance it helps with analyzing
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Fierz+identities"} Fierz identities
            %p This abstract isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi ν
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %mi ℂ
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Mat
                      %mrow
                        %msup
                          %mn 2
                          %mi ν
                        %mo ×
                        %msup
                          %mn 2
                          %mi ν
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cl(\mathbb{R}^{2\nu-1,1}) \otimes_{\mathbb{R}} \mathbb{C}
                    \\;\simeq\;
                    Mat_{2^\nu \times 2^\nu}(\mathbb{C})
            %p
              is realized by the construction of the Dirac representation, below in prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
          %p
            In the following we use standard notation for operations on
            %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
            with entries in the
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            (and of course these matrices may in particular be complex row/column vectors, which may in particular be single complex numbers):
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} (-)^\ast
                – componentwise
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi T
                    %annotation{:encoding => "application/x-tex"} (-)^T
                –
                %a.existingWikiWord{:href => "/nlab/show/transpose+matrix"} transpose matrix
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo †
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi T
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi T
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} (-)^\dagger \coloneqq ((-)^\ast)^T = ((-)^T)^\ast
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A B
                for the
                %a.existingWikiWord{:href => "/nlab/show/matrix+product"} matrix product
                of two matrices
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
          %p
            We will be discussing three different pairing operations on complex column vectors
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mn 1
                    %mo ,
                    %msub
                      %mi ψ
                      %mn 2
                    %mo ∈
                    %msup
                      %mi ℂ
                      %mi ν
                  %annotation{:encoding => "application/x-tex"} \psi_1, \psi_2 \in \mathbb{C}^\nu
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi ψ
                        %mn 1
                        %mo †
                      %msub
                        %mi ψ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \psi_1^\dagger \psi_2
                – the standard
                %a.existingWikiWord{:href => "/nlab/show/hermitian+form"} hermitian form
                on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℂ
                          %mi ν
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}^\nu
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %msub
                        %mi ψ
                        %mn 1
                      %mo ,
                      %msub
                        %mi ψ
                        %mn 2
                      %mo{:stretchy => "false"} ⟩
                      %mo ≔
                      %msub
                        %mover
                          %mi ψ
                          %mo ¯
                        %mn 1
                      %msub
                        %mi ψ
                        %mn 2
                      %mo ≔
                      %msubsup
                        %mi ψ
                        %mn 1
                        %mo †
                      %msub
                        %mi Γ
                        %mn 0
                      %msub
                        %mi ψ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \langle \psi_1,\psi_2\rangle \coloneqq \overline{\psi}_1 \psi_2 \coloneqq \psi_1^\dagger \Gamma_0 \psi_2
                – the
                = succeed "," do
                  %em Dirac pairing
                %a.existingWikiWord{:href => "/nlab/show/hermitian+form"} hermitian form
                with respect to which the
                %a.existingWikiWord{:href => "/nlab/show/spin+representation"} spin representation
                below is a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/unitary+representation"} unitary representation
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ψ
                        %mn 1
                      %mo ,
                      %msub
                        %mi ψ
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %msubsup
                        %mi ψ
                        %mn 1
                        %mi T
                      %mi C
                      %msub
                        %mi ψ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} (\psi_1,\psi_2) \coloneqq \psi_1^T C \psi_2
                – the
                %em Majorana pairing
                (for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/charge+conjugation+matrix"} charge conjugation matrix
                %a.maruku-ref{:href => "#ChargeConjugationMatrices"}
                below), this turns out to coincide with the Dirac pairing above
                %em if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ψ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \psi_1
                is a Majorana spinor.
          %p
            The following is a standard convention for the complex representation of the Clifford algebra for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1}
            (
            %a{:href => "#CastellaniDAuriaFre"}> Castellani-D’Auria-Fré, (II.7.1)
            ):
          #CliffordAlgebraRepresentation.num_prop
            %h6#proposition_7 Proposition
            %p
              (
              %strong> Dirac representation
              )
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 2
                    %mi ν
                    %mo ,
                    %mn 2
                    %mi ν
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext for
                    %mspace{:width => "thinmathspace"}
                    %mi ν
                    %mo ∈
                    %mi ℕ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mo ≥
                    %mn 4
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d
                    \\in \{ 2\nu, 2 \nu + 1 \}
                    \\;\;\;\;
                    \\text{for}\, \nu \in \mathbb{N}\,,\; d\geq 4
                    \\,.
            %p
              Then there is a choice of complex linear representation of the
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{d-1,1})
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CliffordAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ≔
                    %msup
                      %mi ℂ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mn 2
                          %mi ν
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    V \coloneqq \mathbb{C}^{(2^{\nu})}
            %p such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Γ
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \Gamma_{0}
                  is
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/hermitian"} hermitian
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi Γ
                            %mn 0
                            %mo †
                          %mo =
                          %msub
                            %mi Γ
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} \Gamma_0^\dagger = \Gamma_0
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Γ
                          %mi spatial
                      %annotation{:encoding => "application/x-tex"} \Gamma_{spatial}
                  is
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/anti-hermitian"} anti-hermitian
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi Γ
                            %mi spatial
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo †
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mi Γ
                            %mi spatial
                        %annotation{:encoding => "application/x-tex"} (\Gamma_{spatial})^\dagger = - \Gamma_{spatial}
            %p Moreover, the pairing
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %msub
                      %mi Γ
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi V
                    %mo ×
                    %mi V
                    %mo ⟶
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    \\langle -,-\rangle \coloneqq (-)^\dagger \Gamma_0 (-)
                    \\;\colon\;
                    V \times V
                    \\longrightarrow
                    \\mathbb{C}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/hermitian+form"} hermitian form
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HermitianForms"}
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SpinGroup"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/unitary+representation"} unitary
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ω
                              %mrow
                                %mi a
                                %mi b
                            %msub
                              %mi Γ
                              %mrow
                                %mi a
                                %mi b
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                          %mtd
                            %mo =
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mi ω
                              %mrow
                                %mi a
                                %mi b
                            %msub
                              %mi Γ
                              %mrow
                                %mi a
                                %mi b
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ω
                              %mrow
                                %mi a
                                %mi b
                            %msub
                              %mi Γ
                              %mrow
                                %mi a
                                %mi b
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Gamma_0^{-1} \exp(\omega^{a b} \Gamma_{a b})^{\dagger} \Gamma_0
                    \&amp; =
                    \\exp(-\omega^{a b} \Gamma_{a b })
                    \\\
                    \&amp; =
                    \\exp(\omega^{a b} \Gamma_{a b})^{-1}
                    \\end{aligned}
                    \\,.
            %p
              These representations are called the
              = succeed "," do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+representations"} Dirac representations
              = succeed "." do
                %strong Dirac spinors
          .proof
            %h6#proof_4 Proof
            %p
              In the case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} d = 4
              consider the
              %a.existingWikiWord{:href => "/nlab/show/Pauli+matrices"} Pauli matrices
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi σ
                        %mi a
                      %msubsup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi a
                          %mo =
                          %mn 0
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \{\sigma_{a}\}_{a = 0}^3
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi a
                    %msup
                      %mi x
                      %mi a
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi x
                                %mn 0
                              %mo +
                              %msup
                                %mi x
                                %mn 1
                            %mtd
                              %msup
                                %mi x
                                %mn 2
                              %mo +
                              %mi i
                              %msup
                                %mi x
                                %mn 3
                          %mtr
                            %mtd
                              %msup
                                %mi x
                                %mn 2
                              %mo −
                              %mi i
                              %msup
                                %mi x
                                %mn 3
                            %mtd
                              %msup
                                %mi x
                                %mn 0
                              %mo −
                              %msup
                                %mi x
                                %mn 1
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_a x^a
                    \\coloneqq
                    \\left(
                    \\array{
                    x^0 + x^1 &amp; x^2 + i x^3
                    \\\
                    x^2 - i x^3 &amp; x^0 - x^1
                    }
                    \\right)
                    \\,.
            %p Then a Clifford representation as claimed is given by setting
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mn 0
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi id
                          %mtr
                            %mtd
                              %mi id
                            %mtd
                              %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_0
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; id
                    \\\
                    id &amp; 0
                    }
                    \\right)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi a
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %msub
                                %mi σ
                                %mi a
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mi σ
                                %mi a
                            %mtd
                              %mn 0
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_a
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; \sigma_a
                    \\\
                    \-\sigma_a &amp; 0
                    }
                    \\right)
                    \\,.
            %p
              From
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} d = 4
              we proceed to higher dimension by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
            %p
              %strong odd dimensions
            %p
              Suppose a Clifford representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi γ
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\gamma_a\}
              as claimed has been constructed in even dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo =
                      %mn 2
                      %mi ν
                    %annotation{:encoding => "application/x-tex"} d = 2 \nu
            %p
              Then a Clifford representation in dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 2
                    %mi ν
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} d = 2 \nu + 1
              is given by taking
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi a
                    %mo ≔
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi γ
                                %mi a
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thickmathspace"}
                              %mi a
                              %mo ≤
                              %mi d
                              %mo −
                              %mn 2
                          %mtr
                            %mtd
                              %mi ϵ
                              %msub
                                %mi γ
                                %mn 0
                              %msub
                                %mi γ
                                %mn 1
                              %mi ⋯
                              %msub
                                %mi γ
                                %mrow
                                  %mi d
                                  %mo −
                                  %mn 2
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thickmathspace"}
                              %mi a
                              %mo =
                              %mi d
                              %mo −
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_a
                    \\coloneqq
                    \\left\{
                    \\array{
                    \\gamma_a &amp; \vert \; a \leq d - 2
                    \\\
                    \\epsilon \gamma_0 \gamma_1 \cdots \gamma_{d-2}
                    \&amp; \vert\; a = d-1
                    }
                    \\right.
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thickmathspace"}
                              %mi ν
                              %mspace{:width => "thinmathspace"}
                              %mtext odd
                          %mtr
                            %mtd
                              %mi i
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thickmathspace"}
                              %mi ν
                              %mspace{:width => "thinmathspace"}
                              %mtext even
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon
                    \=
                    \\left\{
                    \\array{
                    1 &amp; \vert \; \nu \, \text{odd}
                    \\\
                    i &amp; \vert \; \nu \, \text{even}
                    }
                    \\right.
                    \\,.
            %p
              %strong even dimensions
            %p
              Suppose a Clifford representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi γ
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\gamma_a\}
              as claimed has been constructed in even dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo =
                      %mn 2
                      %mi ν
                    %annotation{:encoding => "application/x-tex"} d = 2 \nu
            %p
              Then a corresponding representation in dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo +
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} d+2
              is given by setting
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mrow
                        %mi a
                        %mo &lt;
                        %mi d
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %msub
                                %mi γ
                                %mi a
                          %mtr
                            %mtd
                              %msub
                                %mi γ
                                %mi a
                            %mtd
                              %mn 0
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi d
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi id
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi id
                            %mtd
                              %mn 0
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mrow
                        %mi d
                        %mo +
                        %mn 1
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi i
                              %mi{:mathvariant => "normal"} id
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi i
                              %mi{:mathvariant => "normal"} id
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{a \lt d}
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; \gamma_a
                    \\\
                    \\gamma_a &amp; 0
                    }
                    \\right)
                    \\;\;\,,
                    \\;\;\;
                    \\Gamma_{d}
                    \=
                    \\left(
                    \\array{
                    0 &amp; id
                    \\\
                    \-id &amp; 0
                    }
                    \\right)
                    \\;\;\,,
                    \\;\;\;
                    \\Gamma_{d+1}
                    \=
                    \\left(
                    \\array{
                    i \mathrm{id} &amp; 0
                    \\\
                    0 &amp; -i \mathrm{id}
                    }
                    \\right)
                    \\,.
            %p
              Finally regarding the statement that this gives a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/unitary+representation"} unitary representation
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %msub
                      %mi Γ
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \langle -,-\rangle \coloneqq (-)^\dagger \Gamma_0 (-)
              is a
              %a.existingWikiWord{:href => "/nlab/show/hermitian+form"} hermitian form
              follows since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Gamma_0
              obtained by the above construction is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hermitian+matrix"} hermitian matrix
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi d
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} a,b \in \{1, \cdots, d-1\}
              be spacelike and distinct indices. Then by the above we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi Γ
                              %mi b
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                          %mtd
                            %mo =
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msub
                              %mi Γ
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Γ
                              %mi b
                              %mo †
                            %msubsup
                              %mi Γ
                              %mi a
                              %mo †
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi Γ
                              %mi b
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi Γ
                              %mi a
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Γ
                              %mi b
                            %msub
                              %mi Γ
                              %mi a
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi Γ
                              %mi b
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Gamma_0^{-1} (\Gamma_a \Gamma_b)^\dagger \Gamma_0
                    \&amp; =
                    \\Gamma_0^{-1} \Gamma_0 (\Gamma_b^\dagger \Gamma_a^\dagger)
                    \\\
                    \&amp; = (-\Gamma_b) (-\Gamma_a)
                    \\\
                    \&amp; = \Gamma_b \Gamma_a
                    \\\
                    \&amp; = - \Gamma_a \Gamma_b
                    \\end{aligned}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi Γ
                              %mi a
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo †
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msub
                              %mi Γ
                              %mn 0
                            %msubsup
                              %mi Γ
                              %mi a
                              %mo †
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mo †
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi Γ
                              %mi a
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Γ
                              %mn 0
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi Γ
                              %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi Γ
                              %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Gamma_0^{-1} (\Gamma_0 \Gamma_a)^\dagger
                    \&amp; =
                    \- \Gamma_0^{-1} \Gamma_0 \Gamma_a^\dagger \Gamma_0^\dagger
                    \\\
                    \&amp; =
                    \- (- \Gamma_a) (\Gamma_0)
                    \\\
                    \&amp; = \Gamma_a \Gamma_0
                    \\\
                    \&amp; = - \Gamma_0 \Gamma_a
                    \\end{aligned}
                    \\,.
            %p
              This means that the exponent of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ω
                      %mrow
                        %mi a
                        %mi b
                    %msub
                      %mi Γ
                      %mi a
                    %msub
                      %mi Γ
                      %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(\omega^{a b} \Gamma_a \Gamma_b)
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/anti-hermitian+matrix"} anti-hermitian matrix
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unitary+operator"} unitary operator
          #WeylRepresentation.num_defn
            %h6#definition_11 Definition
            %p
              (
              %strong> Weyl representation
              )
            %p
              Since by prop.
              %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
              the Dirac representations in dimensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 2
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} d = 2\nu
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo +
                    %mn 1
                    %mo =
                    %mn 2
                    %mi ν
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} d+1 = 2\nu+1
              have the same underlying complex vector space, the element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi d
                    %mo ∝
                    %msub
                      %mi Γ
                      %mn 0
                    %msub
                      %mi Γ
                      %mn 1
                    %mi ⋯
                    %msub
                      %mi Γ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{d}
                    \\propto
                    \\Gamma_0 \Gamma_1 \cdots \Gamma_{d-1}
            %p
              acts
              = succeed "-invariantly" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              = succeed "-representation" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
            %p
              Moreover, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mn 0
                    %msub
                      %mi Γ
                      %mn 1
                    %mi ⋯
                    %msub
                      %mi Γ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Gamma_0 \Gamma_1 \cdots \Gamma_{d-1}
              squares to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ±
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \pm 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mrow
                        %mi d
                        %mo +
                        %mn 1
                    %mo ≔
                    %mi c
                    %msub
                      %mi Γ
                      %mn 0
                    %msub
                      %mi Γ
                      %mn 1
                    %mi ⋯
                    %msub
                      %mi Γ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{d+1} \coloneqq c \Gamma_0 \Gamma_1 \cdots \Gamma_{d-1}
            %p
              squares to +1. This is called the
              = succeed "." do
                %strong chirality operator
            %p
              (The notation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mrow
                        %mi d
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Gamma_{d+1}
              for this operator originates from times when only
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} d = 4
              was considered. Clearly this notation has its pitfalls when various
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              are considered, but nevertheless it is still commonly used this way, see e.g.
              = succeed ")." do
                %a{:href => "#CastellaniDAuriaFre"} Castellani-D’Auria-Fré, section (II.7.11) and top of p. 523
            %p
              Therefore this representation decomposes as a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msub
                      %mi V
                      %mo +
                    %mo ⊕
                    %msub
                      %mi V
                      %mo −
                  %annotation{:encoding => "application/x-tex"}
                    V = V_+ \oplus V_-
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/eigenspaces"} eigenspaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mo ±
                  %annotation{:encoding => "application/x-tex"} V_{\pm}
              of the chirality operator, respectively. These
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mo ±
                  %annotation{:encoding => "application/x-tex"} V_{\pm}
              are called the two
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Weyl+representations"} Weyl representations
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              %strong chiral spinor
              (“left handed”, “right handed”, respectively).
          #DiracConjugate.num_defn
            %h6#definition_12 Definition
            %p
              For a Clifford algebra representation on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mn 2
                          %mi ν
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^{(2^\nu)}
              as in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %msub
                      %mi Γ
                      %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Mat
                      %mrow
                        %mi ν
                        %mo ×
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Mat
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ×
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}
                    \\coloneqq
                    (-)^\dagger \Gamma_0
                    \\;\colon\;
                    Mat_{\nu \times 1}(\mathbb{C})
                    \\longrightarrow
                    Mat(1 \times \nu)(\mathbb{C})
            %p
              for the map from complex column vectors to complex row vectors which is hermitian congugation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi T
                  %annotation{:encoding => "application/x-tex"} (-)^\dagger = ((-)^\ast)^T
              followed by matrix multiplication with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Gamma_0
              from the right.
            %p
              This operation is called
              = succeed "." do
                %strong Dirac conjugation
            %p
              In terms of this the
              %a.existingWikiWord{:href => "/nlab/show/hermitian+form"} hermitian form
              from prop.
              %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
              (Dirac pairing) reads
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle -,-\rangle = \overline{(-)}(-)
                    \\,.
          #CliffordRepresentationIsDiracSelfConjugate.num_prop
            %h6#proposition_8 Proposition
            %p
              The operator adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{A}
              of a
              = succeed "-matrix" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mn 2
                        %mi ν
                      %mo ×
                      %msup
                        %mn 2
                        %mi ν
                    %annotation{:encoding => "application/x-tex"} 2^\nu \times 2^\nu
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              with respect to the Dirac pairing of def.
              = succeed "," do
                %a.maruku-ref{:href => "#DiracConjugate"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mover
                      %mi A
                      %mo ¯
                    %mo −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi A
                    %mo −
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mi A
                      %mo ¯
                    %mo −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\langle A (-), (-)\rangle
                    \=
                    \\langle   - , \overline{A} -\rangle
                    \\;\;\;\text{and} \;\;\;
                    \\langle  -, A -\rangle
                    \=
                    \\langle \overline{A} - ,  -\rangle
            %p is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo ¯
                    %mo =
                    %msubsup
                      %mi Γ
                      %mn 0
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mi A
                      %mo †
                    %msub
                      %mi Γ
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{A} = \Gamma_0^{-1} A^\dagger \Gamma_0
                    \\,.
            %p
              All the representations of the Clifford generators from prop.
              %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
              are Dirac self-conjugate in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi Γ
                        %mo ¯
                      %mi a
                    %mo =
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{\Gamma}_a = \Gamma_a
            %p
              saying that this
              %a.existingWikiWord{:href => "/nlab/show/Dirac+representation"} Dirac representation
              respects the canonical
              %a.existingWikiWord{:href => "/nlab/show/antihomomorphism"} antihomomorphism
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#CliffordAlgebra"}
          .proof
            %h6#proof_5 Proof
            %p For the first claim consider
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ⟨
                            %mi A
                            %msub
                              %mi ψ
                              %mn 1
                            %mo ,
                            %msub
                              %mi ψ
                              %mn 2
                            %mo{:stretchy => "false"} ⟩
                          %mtd
                            %mo =
                            %msubsup
                              %mi ψ
                              %mn 1
                              %mo †
                            %msup
                              %mi A
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi ψ
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi ψ
                              %mn 1
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msup
                              %mi A
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi ψ
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} ⟨
                            %msub
                              %mi ψ
                              %mn 1
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi A
                            %msub
                              %mi Γ
                              %mn 0
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi ψ
                              %mn 2
                            %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\langle A \psi_1,  \psi_2\rangle
                    \&amp; =
                    \\psi_1^\dagger A^\dagger \Gamma_0  \psi_2
                    \\\
                    \&amp; =
                    \\psi_1^\dagger \Gamma_0 (\Gamma_0^{-1} A^\dagger \Gamma_0) \psi_2
                    \\\
                    \&amp; =
                    \\langle \psi_1, (\Gamma_0^{-1} A \Gamma_0)\psi_2\rangle
                    \\end{aligned}
                    \\,.
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ⟨
                            %msub
                              %mi ψ
                              %mn 1
                            %mo ,
                            %mi A
                            %msub
                              %mi ψ
                              %mn 2
                            %mo{:stretchy => "false"} ⟩
                          %mtd
                            %mo =
                            %msubsup
                              %mi ψ
                              %mn 1
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %mi A
                            %msub
                              %mi ψ
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi ψ
                              %mn 1
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %mi A
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi ψ
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo †
                            %msup
                              %mi A
                              %mo †
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Γ
                              %mn 0
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo †
                            %msub
                              %mi ψ
                              %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi ψ
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msup
                              %mi A
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi ψ
                              %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi ψ
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} ⟨
                            %mover
                              %mi A
                              %mo ¯
                            %msub
                              %mi ψ
                              %mn 1
                            %mo ,
                            %msub
                              %mi ψ
                              %mn 2
                            %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\langle \psi_1, A \psi_2\rangle
                    \&amp; =
                    \\psi_1^\dagger \Gamma_0 A \psi_2
                    \\\
                    \&amp; =
                    \\psi_1^\dagger \Gamma_0 A \Gamma_0^{-1} \Gamma_0 \psi_2
                    \\\
                    \&amp; =
                    ( (\Gamma_0^{-1})^\dagger A^\dagger (\Gamma_0)^\dagger \psi_1 )^\dagger \Gamma_0 \psi_2
                    \\\
                    \&amp; =
                    ( \Gamma_0^{-1} A^\dagger \Gamma_0 \psi_1 )^\dagger \Gamma_0 \psi_2
                    \\\
                    \&amp;=
                    \\langle \overline{A} \psi_1, \psi_2\rangle
                    \\end{aligned}
                    \\,,
            %p
              where we used that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mn 0
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %msub
                      %mi Γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Gamma_0^{-1} = \Gamma_0
              (by def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mn 0
                      %mo †
                    %mo =
                    %msub
                      %mi Γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Gamma_0^\dagger = \Gamma_0
              (by prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            %p
              Now for the second claim, use def.
              %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              and prop.
              %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
              to find
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi Γ
                                %mo ¯
                              %mn 0
                          %mtd
                            %mo =
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi Γ
                              %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Γ
                              %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\overline{\Gamma}_0
                    \&amp; =
                    \\Gamma_0^{-1}\Gamma_0^\dagger \Gamma_0
                    \\\
                    \&amp; = \Gamma_0^{-1} \Gamma_0 \Gamma_0
                    \\\
                    \&amp; =
                    \\Gamma_0
                    \\end{aligned}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi Γ
                                %mo ¯
                              %mi spatial
                          %mtd
                            %mo =
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msubsup
                              %mi Γ
                              %mi spatial
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msub
                              %mi Γ
                              %mi spatial
                            %msub
                              %mi Γ
                              %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi Γ
                              %mi spatial
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Γ
                              %mi spatial
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\overline{\Gamma}_{spatial}
                    \&amp; =
                    \\Gamma_0^{-1} \Gamma_{spatial}^\dagger\Gamma_0
                    \\\
                    \&amp;=
                    \- \Gamma_0^{-1} \Gamma_{spatial} \Gamma_0
                    \\\
                    \&amp; = + \Gamma_0^{-1} \Gamma_0 \Gamma_{spatial}
                    \\\
                    \&amp;= \Gamma_{spatial}
                    \\end{aligned}
                    \\,.
          %h4#MajoranaSpinorsAndRealStructure Majorana spinors and Real structure
          %p
            We now define
            %a.existingWikiWord{:href => "/nlab/show/Majorana+spinors"} Majorana spinors
            in the traditional way, and then demonstrate that these are
            %a.existingWikiWord{:href => "/nlab/show/real+spin+representations"} real spin representations
            in the sense of def.
            = succeed "." do
              %a.maruku-ref{:href => "#MajoranaSpinorGeneral"}
          %p
            The key technical ingredient for the definition is the following
            %a.existingWikiWord{:href => "/nlab/show/similarity+transformations"} similarity transformations
            relating the Dirac Clifford representation to its transpose:
          #ChargeConjugationMatrices.num_prop
            %h6#proposition_9 Proposition
            %p
              Given the Clifford algebra representation of the form of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ±
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Γ
                      %mi a
                    %mo =
                    %mo ±
                    %msubsup
                      %mi Γ
                      %mi a
                      %mi T
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ±
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C_{(\pm)} \Gamma_a  = \pm \Gamma_a^T C_{(\pm)}
            %p
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo ±
                          %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi Mat
                        %mrow
                          %mi ν
                          %mo ×
                          %mi n
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C_{(\pm)} \in Mat_{\nu \times n}(\mathbb{C})
            %p
              In even dimensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 2
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} d = 2 \nu
              then both these equations have a solution, wheras in odd dimensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 2
                    %mi ν
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} d = 2 \nu + 1
              only one of them does (alternatingly, starting with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_{(+)}
              in dimension 5). Either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ±
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_{(\pm)}
              is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/charge+conjugation+matrix"} charge conjugation matrix
            %p
              Moreover, all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
