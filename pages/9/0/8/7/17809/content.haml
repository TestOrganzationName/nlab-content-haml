                      %mo{:stretchy => "false"} {
                      %mi ℝ
                      %mo ,
                      %mi ℂ
                      %mo ,
                      %mi ℍ
                      %mo ,
                      %mi 𝕆
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{K} \in \{\mathbb{R}, \mathbb{C}, \mathbb{H}, \mathbb{O}\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝕂
                    %mo ⟶
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"}
                    (-)^\ast
                    \\;\colon\;
                    \\mathbb{K}
                    \\longrightarrow
                    \\mathbb{K}
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/antihomomorphism"} antihomomorphism
              of real algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi r
                            %mi a
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo =
                            %mi r
                            %msup
                              %mi a
                              %mo *
                          %mtd
                            %mo ,
                            %mtext for
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi r
                            %mo ∈
                            %mi ℝ
                            %mo ,
                            %mi a
                            %mo ∈
                            %mi 𝕂
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mi b
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo =
                            %msup
                              %mi b
                              %mo *
                            %msup
                              %mi a
                              %mo *
                          %mtd
                            %mo ,
                            %mtext for
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi a
                            %mo ,
                            %mi b
                            %mo ∈
                            %mi 𝕂
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (r a)^\ast  = r a^\ast &amp;, \text{for}\;\; r \in \mathbb{R}, a \in \mathbb{K}
                    \\\
                    (a b)^\ast = b^\ast a^\ast &amp;,\text{for}\;\; a,b \in \mathbb{K}
                    \\end{aligned}
            %p
              given on the generators of def.
              = succeed "," do
                %a.maruku-ref{:href => "#TheComplexNumbers"}
              %a.maruku-ref{:href => "#TheQuaternions"}
              and def.
              %a.maruku-ref{:href => "#TheOctonions"}
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi i
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi e
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (e_i)^\ast = - e_i
                    \\,.
            %p
              This operation makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
