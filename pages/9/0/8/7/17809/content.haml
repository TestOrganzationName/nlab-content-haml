                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    (\Gamma(A))^2 = -\eta(A,A)1
            %p
              is satisfied. Now by definition, for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi 𝕂
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} (\phi,\psi) \in \mathbb{K}^4
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ϕ
                          %mtr
                            %mtd
                              %mi ψ
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mi ϕ
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi A
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                              %mi ψ
                              %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
