                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %msubsup
                                        %mi x
                                        %mn 0
                                        %mn 2
                                      %mo +
                                      %msubsup
                                        %mi x
                                        %mn 1
                                        %mn 2
                                      %mo{:stretchy => "false"} )
                                      %msub
                                        %mi ϕ
                                        %mn 1
                                      %mo +
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo +
                                      %msub
                                        %mi x
                                        %mn 1
                                      %mo{:stretchy => "false"} )
                                      %mo{:stretchy => "false"} (
                                      %mi y
                                      %msub
                                        %mi ϕ
                                        %mn 2
                                      %mo{:stretchy => "false"} )
                                      %mo +
                                      %mi y
                                      %mo{:stretchy => "false"} (
                                      %msup
                                        %mi y
                                        %mo *
                                      %msub
                                        %mi ϕ
                                        %mn 1
                                      %mo{:stretchy => "false"} )
                                      %mo −
                                      %mi y
                                      %mo{:stretchy => "false"} (
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo +
                                      %msub
                                        %mi x
                                        %mn 1
                                      %mo{:stretchy => "false"} )
                                      %msub
