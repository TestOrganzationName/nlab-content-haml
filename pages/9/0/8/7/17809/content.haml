            representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            as in prop.
            = succeed "," do
              %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            = succeed "," do
              %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ↪
                  %mi V
                %annotation{:encoding => "application/x-tex"}
                  S \hookrightarrow V
          %p
            for the subspace of Majorana spinors, regarded as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
          %p
            Recall, by prop.
            = succeed "," do
              %a.maruku-ref{:href => "#TheMajoranaConditionInComponents"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi T
                  %mi C
                %annotation{:encoding => "application/x-tex"} (-)^T C
            coincides with the Dirac conjugate
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
