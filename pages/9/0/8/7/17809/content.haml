                            %mo ⋅
                            %mrow
                              %mo (
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo +
                                      %msub
                                        %mi x
                                        %mn 1
                                      %mo{:stretchy => "false"} )
                                      %msub
                                        %mi ϕ
                                        %mn 1
                                      %mo +
                                      %mi y
                                      %msub
                                        %mi ϕ
                                        %mn 2
                                  %mtr
                                    %mtd
                                      %msup
                                        %mi y
                                        %mo *
                                      %msub
                                        %mi ϕ
                                        %mn 1
                                      %mo −
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo +
                                      %msub
                                        %mi x
                                        %mn 1
                                      %mo{:stretchy => "false"} )
