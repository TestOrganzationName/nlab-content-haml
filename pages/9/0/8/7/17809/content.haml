            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mo ×
                    %mi S
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}\Gamma (-)
                    \\;\colon\;
                    S \times S
                    \\longrightarrow
                    \\mathbb{R}^{d-1,1}
            %p
              be the function that takes Majorana spinors
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ψ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \psi_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \psi_2
              to the vector with components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi ψ
                        %mo ¯
                      %mn 1
                    %msup
                      %mi Γ
                      %mi a
                    %msub
                      %mi ψ
                      %mn 2
                    %mo ≔
                    %msubsup
                      %mi ψ
                      %mn 1
                      %mi T
                    %mi C
                    %msup
                      %mi Γ
                      %mi a
                    %msub
                      %mi ψ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{\psi}_1\Gamma^a \psi_2
                    \\coloneqq
                    \\psi_1^T C \Gamma^a \psi_2
                    \\,.
          %p
            Now the crucial property for the construction of spacetime
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            super Lie algebras
            %a{:href => "#Supersymmetry"} below
            is the following
          #SpinorToVectorPairing.num_prop
            %h6#proposition_15 Proposition
            %p
              For a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              as in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
              = succeed "," do
                %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
              %a.maruku-ref{:href => "#SpinorToVectorBilinearPairing"}
              satisfies the following properties: it is
            %ol
              %li
                %p symmetric:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi ψ
                            %mo ¯
                          %mn 1
                        %mi Γ
                        %msub
                          %mi ψ
                          %mn 2
                        %mo =
                        %msub
                          %mover
                            %mi ψ
                            %mo ¯
                          %mn 2
                        %mi Γ
                        %msub
                          %mi ψ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        \\overline{\psi}_1 \Gamma \psi_2
                        \=
                        \\overline{\psi}_2 \Gamma \psi_1
              %li
                %p
                  component-wise real-valued (i.e. it indeed takes values in
                  = succeed ");" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mi d
                          %mo ⊂
                          %msup
                            %mi ℂ
                            %mi d
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^d \subset \mathbb{C}^d
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
                  \-equivariant: for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∈
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} g \in Spin(d-1,1)
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mrow
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %mo ¯
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mover
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %mo ¯
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\overline{g(-)}\Gamma(g(-))
                        \=
                        g(\overline{(-)}\Gamma(-))
                        \\,.
          .proof
            %h6#proof_11 Proof
            %p
              Regarding the first point, we need to show that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} C \Gamma_a
              is a symmetric matrix. Indeed:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi C
                            %msub
                              %mi Γ
                              %mi a
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi T
                          %mtd
                            %mo =
                            %msubsup
                              %mi Γ
                              %mi a
                              %mi T
                            %msup
                              %mi C
                              %mi T
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo ±
                            %msubsup
                              %mi Γ
                              %mi a
                              %mi T
                            %mi C
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo ±
                            %mo ±
                            %mi C
                            %msub
                              %mi Γ
                              %mi a
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi C
                            %msub
                              %mi Γ
                              %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (C \Gamma_a)^T
                    \&amp; =
                    \\Gamma_a^T C^T
                    \\\
                    \&amp; = \pm \Gamma_a^T C
                    \\\
                    \&amp; = \pm \pm C \Gamma_a
                    \\\
                    \&amp; = C \Gamma_a
                    \\end{aligned}
                    \\,,
            %p
              where the first sign picked up is from
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi T
                      %mo =
                      %mo ±
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C^T = \pm C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mi a
                      %mi T
                    %mi C
                    %mo =
                    %mo ±
                    %mi C
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Gamma_a^T C = \pm C \Gamma_a
              (according to prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#ChargeConjugationMatrices"}
              %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
              one finds that these signs agree, and hence cancel out.
            %p
              (In
              %a{:href => "#VanProeyen99"} van Proeyen99
              this is part of table 1, in (
              %a{:href => "#CastellaniDAuriaFre"}> Castellani-D’Auria-Fré
              ) this is implicit in equation (II.2.32a).)
            %p
              With this the second point follows together with the relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ψ
                      %mi T
                    %mi C
                    %mo =
                    %msup
                      %mi ψ
                      %mo †
                    %msub
                      %mi Γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \psi^T C = \psi^\dagger \Gamma_0
              for Majorana spinors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#TheMajoranaConditionInComponents"}
              %a.existingWikiWord{:href => "/nlab/show/hermitian+form"} hermitian form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %msub
                      %mi Γ
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \langle -,-\rangle = (-)^\dagger \Gamma_0 (-)
              as well as the hermiticity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mn 0
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Gamma_0 \Gamma_a
              (both from prop.
              = succeed "):" do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mover
                                %mi ψ
                                %mo ¯
                              %mn 1
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi ψ
                              %mn 2
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi ψ
                              %mn 1
                              %mi T
                            %mi C
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi ψ
                              %mn 2
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi ψ
                              %mn 1
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %msup
                              %mi Γ
                              %mi a
                            %msub
                              %mi ψ
                              %mn 2
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi ψ
                              %mn 2
                              %mo †
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Γ
                              %mn 0
                            %msup
                              %mi Γ
                              %mi a
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo †
                            %msub
                              %mi ψ
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi ψ
                              %mn 2
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %msup
                              %mi Γ
                              %mi a
                            %msub
                              %mi ψ
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mover
                                %mi ψ
                                %mo ¯
                              %mn 2
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi ψ
                              %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (\overline{\psi}_1 \Gamma_a \psi_2)^\ast
                    \&amp;=
                    (\psi_1^T C \Gamma_a \psi_2)^\ast
                    \\\
                    \&amp; =
                    (\psi_1^\dagger \Gamma_0 \Gamma^a \psi_2)^\ast
                    \\\
                    \&amp; =
                    \\psi_2^\dagger (\Gamma_0 \Gamma^a)^\dagger \psi_1
                    \\\
                    \&amp; =
                    \\psi_2^\dagger \Gamma_0 \Gamma^a \psi_1
                    \\\
                    \&amp; =
                    \\overline{\psi}_2 \Gamma_a \psi_1
