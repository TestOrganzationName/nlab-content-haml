                      of the
                      %a.existingWikiWord{:href => "/nlab/show/gravitino"} gravitino
          #CEAlgebraOfSuperPoincare.num_defn
            %h6#definition_32 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{iso}(\mathbb{R}^{d-1,1|N}))
              is generated by
            %ul
              %li
                %p
                  elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msup
                          %mi e
                          %mi a
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{e^a\}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msup
                          %mi ω
                          %mrow
                            %mi a
                            %mi b
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{\omega^{ a b}\}
                  of degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi even
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (1,even)
              %li
                %p
                  and elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msup
                          %mi ψ
                          %mi α
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{\psi^\alpha\}
                  of degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi odd
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (1,odd)
            %p with the differential defined by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi ω
                      %mrow
                        %mi a
                        %mi b
                    %mo =
                    %msup
                      %mi ω
                      %mi a
                    %msub
                      %mrow
                      %mi b
                    %mo ∧
                    %msup
                      %mi ω
                      %mrow
                        %mi b
                        %mi c
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE} \, \omega^{a b} = \omega^a{}_b \wedge \omega^{b c}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi e
                      %mi a
                    %mo =
                    %msup
                      %mi ω
                      %mi a
                    %msub
                      %mrow
                      %mi b
                    %mo ∧
                    %msup
                      %mi e
                      %mi b
                    %mo +
                    %mover
                      %mi ψ
                      %mo ¯
                    %msup
                      %mi Γ
                      %mi a
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE} \, e^{a } = \omega^a{}_b \wedge e^b + \overline{\psi} \Gamma^a \psi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                    %mspace{:width => "thinmathspace"}
                    %mi ψ
                    %mo =
                    %mfrac
                      %mn 1
                      %mn 4
                    %msup
                      %mi ω
                      %mrow
                        %mi a
                        %mi b
                    %msub
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                    %mi ψ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE} \, \psi = \frac{1}{4} \omega^{ a b} \Gamma_{a b} \psi
                    \\,.
            %p
              Discarding the terms involving
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              here this is the CE algebra of the
              %a.existingWikiWord{:href => "/nlab/show/super+translation+algebra"} super translation algebra
              underlying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
          %p
            In this way the super-Poincaré Lie algebra and its extensions is usefully discussed for instance in (
            %a{:href => "#DAuriaFre82"}> D’Auria-Fré 82
            ) and in (
            %a{:href => "super+Minkowski+spacetime#AzcarragaTownsend89"}> Azcárraga-Townsend 89
            ,
            = succeed ")." do
              %a{:href => "super+Minkowski+spacetime##CAIB99"} CAIB 99
            %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+space"} super Minkowski space
          .num_remark
            %h6#remark_17 Remark
            %p
              The abstract generators in def.
              %a.maruku-ref{:href => "#CEAlgebraOfSuperPoincare"}
              are identified with
              %a.existingWikiWord{:href => "/nlab/show/left+invariant+1-forms"} left invariant 1-forms
              on the
              %a.existingWikiWord{:href => "/nlab/show/super-translation+group"} super-translation group
              (=
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+space"} super Minkowski space
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi a
                    %mo ,
                    %msup
                      %mi θ
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x^a, \theta^\alpha)
              be the canonical
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
              on the
              %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} |
                        %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d|N}
              underlying the super translation group. Then the identification is
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi ψ
                          %mi α
                        %mo =
                        %mi d
                        %msup
                          %mi θ
                          %mi α
                      %annotation{:encoding => "application/x-tex"} \psi^\alpha = d \theta^\alpha
                  \.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi e
                          %mi a
                        %mo =
                        %mi d
                        %msup
                          %mi x
                          %mi a
                        %mo +
                        %mover
                          %mi θ
                          %mo ¯
                        %msup
                          %mi Γ
                          %mi a
                        %mi d
                        %mi θ
                      %annotation{:encoding => "application/x-tex"} e^a = d x^a +  \overline{\theta} \Gamma^a d \theta
                  \.
            %p
              Notice that this then gives the above formula for the differential of the
              %a.existingWikiWord{:href => "/nlab/show/super-vielbein"} super-vielbein
              in def.
              %a.maruku-ref{:href => "#CEAlgebraOfSuperPoincare"}
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi d
                            %msup
                              %mi e
                              %mi a
                          %mtd
                            %mo =
                            %mi d
                            %mo{:stretchy => "false"} (
                            %mi d
                            %msup
                              %mi x
                              %mi a
                            %mo +
                            %mover
                              %mi θ
                              %mo ¯
                            %msup
                              %mi Γ
                              %mi a
                            %mi d
                            %mi θ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi d
                            %mover
                              %mi θ
                              %mo ¯
                            %msup
                              %mi Γ
                              %mi a
                            %mi d
                            %mi θ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mover
                              %mi ψ
                              %mo ¯
                            %msup
                              %mi Γ
                              %mi a
                            %mi ψ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d e^a &amp; = d (d x^a +  \overline{\theta} \Gamma^a d \theta)
                    \\\
                    \&amp; =  d \overline{\theta}\Gamma^a d \theta
                    \\\
                    \&amp; =  \overline{\psi}\Gamma^a \psi
                    \\end{aligned}
                    \\,.
          #Supertorsion.num_remark
            %h6#remark_18 Remark
            %p
              The term
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ψ
                      %mo ¯
                    %msup
                      %mi Γ
                      %mi a
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \overline{\psi} \Gamma^a \psi
              is sometimes called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/supertorsion"} supertorsion
              of the
              %a.existingWikiWord{:href => "/nlab/show/super-vielbein"} super-vielbein
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                    %msup
                      %mi e
                      %mi a
                    %mo −
                    %msup
                      %mi ω
                      %mi a
                    %msub
                      %mrow
                      %mi b
                    %mo ∧
                    %msup
                      %mi e
                      %mi b
                    %mo =
                    %mover
                      %mi ψ
                      %mo ¯
                    %msup
                      %mi Γ
                      %mi a
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE} e^{a } -\omega^a{}_b \wedge e^b = \overline{\psi} \Gamma^a \psi
            %p
              may be read as saying that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              is
              = succeed "-free" do
                %a.existingWikiWord{:href => "/nlab/show/torsion"} torsion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{iso}(\mathbb{R}^{d-1,1\vert N}))
              which have “all indices contracted”. See also at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/torsion+constraints+in+supergravity"} torsion constraints in supergravity
            %p Notably we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mrow
                      %mo (
                      %mover
                        %mi ψ
                        %mo ¯
                      %mo ∧
                      %msup
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi a
                            %mi p
                      %mi ψ
                      %mo ∧
                      %msub
                        %mi e
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                      %mo ∧
                      %mi ⋯
                      %mo ∧
                      %msub
                        %mi e
                        %mrow
                          %msub
                            %mi a
                            %mi p
                      %mo )
                    %mo ∝
                    %mrow
                      %mo (
                      %mover
                        %mi ψ
                        %mo ¯
                      %mo ∧
                      %msup
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi a
                            %mi p
                      %mi ψ
                      %mo ∧
                      %msub
                        %mi e
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                      %mo ∧
                      %mi ⋯
                      %mo ∧
                      %msub
                        %mi e
                        %mrow
                          %msub
                            %mi a
                            %mrow
                              %mi p
                              %mo −
                              %mn 1
                      %mo )
                    %mo ∧
                    %mrow
                      %mo (
                      %mover
                        %mi Ψ
                        %mo ¯
                      %mo ∧
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mi p
                      %mi Ψ
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d \left(
                    \\overline{\psi} \wedge \Gamma^{a_1 \cdots a_p} \psi
                    \\wedge e_{a_1} \wedge \cdots \wedge e_{a_p}
                    \\right)
                    \\propto
                    \\left(
                    \\overline{\psi} \wedge \Gamma^{a_1 \cdots a_p} \psi
                    \\wedge e_{a_1} \wedge \cdots \wedge e_{a_{p-1}}
                    \\right)
                    \\wedge
                    \\left(
                    \\overline{\Psi} \wedge \Gamma_{a_p} \Psi
                    \\right)
                    \\,.
            %p
              This remaining operation “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi e
                    %mo ↦
                    %msup
                      %mi Ψ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} e \mapsto \Psi^2
              ” of the differential acting on Lorentz scalars is sometimes denoted “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} t_0
              ”, e.g. in (
              %a{:href => "super+Minkowski+spacetime#BossardHoweStelle09"}> Bossard-Howe-Stelle 09, equation (8)
              ).
            %p
              This relation is what governs all of the exceptional super Lie algebra cocycles that appear
              = succeed ":" do
                %a{:href => "#TheOldBraneScan"} below
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi p
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d,p,N)
              a
              %a.existingWikiWord{:href => "/nlab/show/Fierz+identity"} Fierz identity
              implies that the term
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mover
                        %mi ψ
                        %mo ¯
                      %mo ∧
                      %msup
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi a
                            %mi p
                      %mi ψ
                      %mo ∧
                      %msub
                        %mi e
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                      %mo ∧
                      %mi ⋯
                      %mo ∧
                      %msub
                        %mi e
                        %mrow
                          %msub
                            %mi a
                            %mrow
                              %mi p
                              %mo −
                              %mn 1
                      %mo )
                    %mo ∧
                    %mrow
                      %mo (
                      %mover
                        %mi Ψ
                        %mo ¯
                      %mo ∧
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mi p
                      %mi Ψ
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\overline{\psi} \wedge \Gamma^{a_1 \cdots a_p} \psi
                    \\wedge e_{a_1} \wedge \cdots \wedge e_{a_{p-1}}
                    \\right)
                    \\wedge
                    \\left(
                    \\overline{\Psi} \wedge \Gamma_{a_p} \Psi
                    \\right)
            %p vanishes identically, and hence in these dimensions the term
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo ∧
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mi p
                    %mi ψ
                    %mo ∧
                    %msub
                      %mi e
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %msub
                      %mi e
                      %mrow
                        %msub
                          %mi a
                          %mi p
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{\psi} \wedge \Gamma^{a_1 \cdots a_p} \psi
                    \\wedge e_{a_1} \wedge \cdots \wedge e_{a_p}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              in super
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
          %h3#superconformal_symmetry Superconformal symmetry
          %p
            We discuss
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+extension"} extensions
            of the
            %a.existingWikiWord{:href => "/nlab/show/conformal+group"} conformal Lie algebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1}
            (equivalently the
            %a.existingWikiWord{:href => "/nlab/show/isometry"} isometry
            Lie algebra of
            %a.existingWikiWord{:href => "/nlab/show/anti+de+Sitter+space"} anti de Sitter space
            of dimension
