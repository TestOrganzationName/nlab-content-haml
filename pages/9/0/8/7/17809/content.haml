                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \overline{(-)} \coloneqq (-)^\dagger \Gamma_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
