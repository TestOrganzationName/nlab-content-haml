          .num_remark
            %h6#remark_11 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              immediately implies that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mi ℝ
                    %mo ,
                    %mi ℂ
                    %mo ,
                    %mi ℍ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{K} \in \{\mathbb{R}, \mathbb{C}, \mathbb{H}\}
              then there is a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              from the
              %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{K})
              (see at
              %em
                %a.existingWikiWord{:href => "/nlab/show/SL%282%2CH%29"} SL(2,H)
              for the definition in the quaternionic case) to the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              in the given dimension:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dim
                      %mrow
                        %mi ℝ
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                    %mo +
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    SL(2,\mathbb{K})
                    \\hookrightarrow
                    Spin(dim_{\mathbb{R}(\mathbb{K} )} +1 ,1)
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi A
                      %mo †
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A \mapsto A(-)A^\dagger
                    \\,.
            %p
              This preserves the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi A
                      %mo †
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %munder
                        %mrow
                          %mi det
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mo =
                        %mn 1
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msup
                      %munder
                        %munder
                          %mrow
                            %mi det
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mo ⏟
                        %mrow
                          %mo =
                          %mn 1
                      %mo *
                    %mo =
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    det(A(-)A^\dagger) = \underset{=1}{\underbrace{det(A)}} det(-) \underset{= 1}{\underbrace{det(A)}}^\ast = det(-)
                    \\,.
          %p
            Hence it remains to show that this is surjective, and to define this action also for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕂
                %annotation{:encoding => "application/x-tex"} \mathbb{K}
            being the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
            %a.existingWikiWord{:href => "/nlab/show/matrix+calculus"} matrix calculus
            does not apply, due to non-associativity.
          #CliffordAlgebraInTermsOfNormedDivisionAlgebra.num_defn
            %h6#definition_26 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
                via
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/normed+division+algebra"} normed division algebra
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              be one of the four real
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#HurwitzTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
              %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ZornTheorem"}
            %p
              Define a
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi dim
                          %mi ℝ
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo ≃
                    %msub
                      %mi End
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝕂
                      %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma \;\colon\; \mathbb{R}^{dim_{\mathbb{R}}(\mathbb{K})+1,1} \simeq End_{\mathbb{R}}(\mathbb{K}^4)
            %p
              from (the real vector space underlying)
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              to real
              %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝕂
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}^4
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ψ
                          %mtr
                            %mtd
                              %mi ϕ
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                              %mi ϕ
                          %mtr
                            %mtd
                              %mi A
                              %mi ψ
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma(A)
                    \\left(
                    \\array{
                    \\psi
                    \\\
                    \\phi
                    }
                    \\right)
                    \\;\coloneqq\;
                    \\left(
                    \\array{
                    \\tilde A \phi
                    \\\
                    A \psi
                    }
                    \\right)
                    \\,.
            %p
              Here on the right we are using the isomorphism from prop.
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              for identifying a spacetime vector with a
              = succeed "-matrix," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mo ×
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2 \times 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo{:stretchy => "false"} (
                      %mo ˜
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widetilde(-)
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#TraceReversal"}
          .num_remark
            %h6#remark_12 Remark
            %p
              Each operation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(A)
              in def.
              %a.maruku-ref{:href => "#CliffordAlgebraInTermsOfNormedDivisionAlgebra"}
              is clearly a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              being the non-associative
              = succeed "." do
