                                %mi A
                                %mo )
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mrow
                              %mo (
                              %mover
                                %mi A
                                %mo ¯
                              %mo{:stretchy => "false"} (
