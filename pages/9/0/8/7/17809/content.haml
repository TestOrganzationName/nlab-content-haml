              %a.existingWikiWord{:href => "/nlab/show/real+part"}> real part
              ”) and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Im
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝕂
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    Im \;\colon\; \mathbb{K} \longrightarrow \mathbb{R}
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo −
                    %msup
                      %mi a
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Im(a) \;\coloneqq \; \tfrac{1}{2}(a - a^\ast)
            %p
              (“
              %a.existingWikiWord{:href => "/nlab/show/imaginary+part"}> imaginary part
              ”).
            %p
              It follows that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} a \in \mathbb{K}
              then the product of a with its conjugate is in the real
              %a.existingWikiWord{:href => "/nlab/show/center"} center
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %msup
                      %mi a
                      %mo *
                    %mo =
                    %msup
                      %mi a
                      %mo *
                    %mi a
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi ℝ
                    %mo ↪
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"}
                    a a^\ast = a^\ast a \;\in \mathbb{R} \hookrightarrow \mathbb{K}
            %p
              and we write the
              %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
              of this expression as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi a
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msqrt
                      %mrow
                        %mi a
                        %msup
                          %mi a
                          %mo *
                  %annotation{:encoding => "application/x-tex"}
                    {\vert a\vert}
                    \\;\coloneqq\;
                    \\sqrt{a a^\ast}
            %p
              called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝕂
                    %mo ⟶
                    %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\vert -\vert}
                    \\;\colon\;
                    \\mathbb{K}
                    \\longrightarrow
                    \\mathbb{R}
                    \\,.
            %p
              This norm operation clearly satisfies the following properties (for all
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ∈
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} a,b \in \mathbb{K}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi a
                        %mo{:stretchy => "false"} |
                        %mo ≥
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \vert a \vert \geq 0
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi a
                          %mo{:stretchy => "false"} |
                        %mo =
                        %mn 0
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⇔
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi a
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} {\vert a \vert } = 0 \;\;\;\;\; \Leftrightarrow\;\;\;\;\;\; a = 0
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi a
                          %mi b
                          %mo{:stretchy => "false"} |
                        %mo =
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi a
                          %mo{:stretchy => "false"} |
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi b
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} {\vert a b \vert } = {\vert a \vert} {\vert b \vert}
            %p
              and hence makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/normed+algebra"} normed algebra
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/division+algebra"} division algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/division+algebra"} division algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi b
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi a
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext or
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi b
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    a b = 0 \;\;\;\;\;\; \Rightarrow \;\;\;\;\;\; a = 0 \;\; \text{or} \;\; b = 0
                    \\,.
            %p
              Hence the conjugation operation makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              a
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/normed+division+algebra"} normed division algebra
          #SequenceOfInclusionsOfRealNormedDivisionAlgebras.num_remark
            %h6#remark_9 Remark
            %p
              Sending each generator in def.
              = succeed "," do
                %a.maruku-ref{:href => "#TheComplexNumbers"}
              %a.maruku-ref{:href => "#TheQuaternions"}
              and def.
              %a.maruku-ref{:href => "#TheOctonions"}
              to the generator of the same name in the next larger algebra constitutes a sequence of real
              %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ↪
                    %mi ℂ
                    %mo ↪
                    %mi ℍ
                    %mo ↪
                    %mi 𝕆
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}
                    \\hookrightarrow
                    \\mathbb{C}
                    \\hookrightarrow
                    \\mathbb{H}
                    \\hookrightarrow
                    \\mathbb{O}
                    \\,.
          #HurwitzTheorem.num_prop
            %h6#proposition_24 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Hurwitz+theorem"}> Hurwitz theorem
                \:
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℍ
                    %annotation{:encoding => "application/x-tex"} \mathbb{H}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕆
                    %annotation{:encoding => "application/x-tex"} \mathbb{O}
                are the normed real division algebras)
            %p
              The four algebras of
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℍ
                  %annotation{:encoding => "application/x-tex"} \mathbb{H}
              and
              %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕆
                  %annotation{:encoding => "application/x-tex"} \mathbb{O}
              from def.
              = succeed "," do
                %a.maruku-ref{:href => "#TheComplexNumbers"}
              %a.maruku-ref{:href => "#TheQuaternions"}
              and def.
              %a.maruku-ref{:href => "#TheOctonions"}
              respectively, which are real
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              via def.
              = succeed "," do
                %a.maruku-ref{:href => "#Conjugation"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %em only
              real normed division algebras that exist.
          .num_remark
            %h6#remark_10 Remark
            %p
              While hence the sequence from remark
              %a.maruku-ref{:href => "#SequenceOfInclusionsOfRealNormedDivisionAlgebras"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ↪
                    %mi ℂ
                    %mo ↪
                    %mi ℍ
                    %mo ↪
                    %mi 𝕆
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}
                    \\hookrightarrow
                    \\mathbb{C}
                    \\hookrightarrow
                    \\mathbb{H}
                    \\hookrightarrow
                    \\mathbb{O}
            %p
              is maximal in the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of real normed non-associative
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              = succeed "." do
                %em
                  forming the
                  %a.existingWikiWord{:href => "/nlab/show/Cayley-Dickson+double+algebra"} Cayley-Dickson double algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ↪
                    %mi ℂ
                    %mo ↪
                    %mi ℍ
                    %mo ↪
                    %mi 𝕆
                    %mo ↪
                    %mi 𝕊
                    %mo ↪
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}
                    \\hookrightarrow
                    \\mathbb{C}
                    \\hookrightarrow
                    \\mathbb{H}
                    \\hookrightarrow
                    \\mathbb{O}
                    \\hookrightarrow
                    \\mathbb{S}
                    \\hookrightarrow
                    \\cdots
            %p
              where the next algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}
              is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/sedenions"} sedenions
          %p
            What actually matters for the following relation of the real normed division algebras to
            %a.existingWikiWord{:href => "/nlab/show/real+spin+representations"} real spin representations
            is that they are also
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative algebras
          #AlternativeAlgebra.num_defn
            %h6#definition_23 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"}> alternative algebra
                )
            %p
              Given any
              %a.existingWikiWord{:href => "/nlab/show/non-associative+algebra"} non-associative algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo ⟶
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    [-,-,-] \;-\; A \otimes A \otimes A \longrightarrow A
            %p
              given on any elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a,b,c \in A
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mi c
                    %mo −
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [a,b,c] \coloneqq (a b) c - a (b c)
            %p
              is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
              (in analogy with the
              %em
                %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo ≔
                    %mi a
                    %mi b
                    %mo −
                    %mi b
                    %mi a
                  %annotation{:encoding => "application/x-tex"} [a,b] \coloneqq a b - b a
              ).
            %p
              If the associator is completely antisymmetric (in that for any
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              of three elements then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi a
                      %mrow
                        %msub
                          %mi σ
                          %mn 1
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %msub
                          %mi σ
                          %mn 2
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %msub
                          %mi σ
                          %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi σ
                        %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %msub
                      %mi a
                      %mn 2
                    %mo ,
                    %msub
                      %mi a
                      %mn 3
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [a_{\sigma_1}, a_{\sigma_2}, a_{\sigma_3}] = (-1)^{\vert \sigma\vert} [a_1, a_2, a_3]
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi σ
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \vert \sigma \vert
              the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/signature+of+a+permutation"} signature of the permutation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is called an
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative algebra
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
              of the
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              is different from 2, then alternativity is readily seen to be equivalent to the conditions that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a,b \in A
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mi b
                    %mo =
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mi b
                    %mo =
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (a a)b = a (a b)
                    \\;\;\;\;\;
                    \\text{and}
                    \\;\;\;\;\;
                    (a b) b = a (b b)
                    \\,.
          %p We record some basic properties of associators in alternative star-algebras that we need below:
          #PropertiesOfAssociatorInAlternativeAlgebra.num_prop
            %h6#proposition_25 Proposition
            %p
              %strong
                (properties of
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/star+algebras"} star algebras
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be an
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative algebra
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AlternativeAlgebra"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                  vanishes when at least one argument is real
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi Re
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        [Re(a),b,c]
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                  changes sign when one of its arguments is conjugated
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi a
                          %mo *
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        [a,b,c] = -[a^\ast,b,c]
                        \\,;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                  vanishes when one of its arguments is the conjugate of another:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo ,
                        %msup
                          %mi a
                          %mo *
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        [a,a^\ast, b] = 0
                        \\,;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                  is purely imaginary
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Re
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Re([a,b,c]) = 0
                        \\,.
          .proof
            %h6#proof_19 Proof
            %p That the associator vanishes as soon as one argument is real is just the linearity of an algebra product over the ground ring.
            %p Hence in fact
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [a,b,c] = [Im(a), Im(b), Im(c)]
                    \\,.
            %p This implies the second statement by linearity. And so follows the third statement by skew-symmetry:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %msup
                      %mi a
                      %mo *
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [a,a^\ast,b] = -[a,a,b] = 0
                    \\,.
            %p The fourth statement finally follows by this computation:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi a
                            %mo ,
                            %mi b
                            %mo ,
                            %mi c
                            %msup
                              %mo{:stretchy => "false"} ]
                              %mo *
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi c
                              %mo *
                            %mo ,
                            %msup
                              %mi b
                              %mo *
                            %mo ,
                            %msup
                              %mi a
                              %mo *
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} [
                            %mi c
                            %mo ,
                            %mi b
                            %mo ,
                            %mi a
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} [
                            %mi a
                            %mo ,
                            %mi b
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    [a,b,c]^\ast
                    \&amp; =
                    \-[c^\ast, b^\ast, a^\ast]
                    \\\
                    \&amp; =
                    \-[c,b,a]
                    \\\
                    \&amp; =
                    \-[a,b,c]
                    \\end{aligned}
                    \\,.
            %p
              Here the first equation follows by inspection and using that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mi b
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo =
                      %msup
                        %mi b
                        %mo *
                      %msup
                        %mi a
                        %mo *
                    %annotation{:encoding => "application/x-tex"} (a b)^\ast = b^\ast a^\ast
          %p It is immediate to check that:
          #RCHOAreAlternative.num_prop
            %h6#proposition_26 Proposition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                ,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℍ
                    %annotation{:encoding => "application/x-tex"} \mathbb{H}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕆
                    %annotation{:encoding => "application/x-tex"} \mathbb{O}
                are real
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative algebras
            %p
              The real algebras of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              = succeed "," do
                %a.maruku-ref{:href => "#TheComplexNumbers"}
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              def.
              %a.maruku-ref{:href => "#TheQuaternions"}
              and
              %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
              def.
              %a.maruku-ref{:href => "#TheOctonions"}
              are
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative algebras
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#AlternativeAlgebra"}
          .proof
            %h6#proof_20 Proof
            %p
              Since the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              and
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
              %a.existingWikiWord{:href => "/nlab/show/associator"} associator
              vanishes identically. It only remains to see that the associator of the
              %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
              is skew-symmetric. By linearity it is sufficient to check this on generators. So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi i
                    %mo →
                    %msub
                      %mi e
                      %mi j
                    %mo →
                    %msub
                      %mi e
                      %mi k
                  %annotation{:encoding => "application/x-tex"} e_i \to e_j \to e_k
              be a circle or a cyclic permutation of an edge in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Fano+plane"} Fano plane
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi e
                              %mi i
                            %msub
                              %mi e
                              %mi j
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi e
                              %mi j
                          %mtd
                            %mo =
                            %msub
                              %mi e
                              %mi k
                            %msub
                              %mi e
                              %mi j
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi e
                              %mi j
                            %msub
                              %mi e
                              %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi e
                              %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi e
                              %mi i
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi e
                              %mi j
                            %msub
                              %mi e
                              %mi j
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (e_i e_j) e_j
                    \&amp;=
                    e_k e_j
                    \\\
                    \&amp;=
                    \- e_j e_k
                    \\\
                    \&amp; =
                    \-e_i
                    \\\
                    \&amp; =
                    e_i (e_j e_j)
                    \\end{aligned}
            %p and similarly
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi e
                              %mi i
                            %msub
                              %mi e
                              %mi i
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi e
                              %mi j
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi e
                              %mi j
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi e
                              %mi k
                            %msub
                              %mi e
                              %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi e
                              %mi i
                            %msub
                              %mi e
                              %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi e
                              %mi i
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi e
                              %mi i
                            %msub
                              %mi e
                              %mi j
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (e_i e_i ) e_j
                    \&amp;=
                    \- e_j
                    \\\
                    \&amp;=
                    \- e_k e_i
                    \\\
                    \&amp;=
                    e_i e_k
                    \\\
                    \&amp;=
                    e_i (e_i e_j)
                    \\end{aligned}
                    \\,.
          %p
            The analog of the
            %a.existingWikiWord{:href => "/nlab/show/Hurwitz+theorem"} Hurwitz theorem
            (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#HurwitzTheorem"}
          #ZornTheorem.num_prop
            %h6#proposition_27 Proposition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                ,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℍ
                    %annotation{:encoding => "application/x-tex"} \mathbb{H}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕆
                    %annotation{:encoding => "application/x-tex"} \mathbb{O}
                are precisely the
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
                %a.existingWikiWord{:href => "/nlab/show/real+number"} real
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
            %p
              The only
              %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              over the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              which are also
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative algebras
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AlternativeAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              themselves, the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              and the
              %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#RCHOAreAlternative"}
          %p
            This is due to (
            %a{:href => "#Zorn30"}> Zorn 30
            ).
          %p For the following, the key point of alternative algebras is this equivalent characterization:
          #ArtinTheorem.num_prop
            %h6#proposition_28 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative algebra
                detected on subalgebras spanned by any two elements)
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/nonassociative+algebra"} nonassociative algebra
              is alternative, def.
              = succeed "," do
                %a.maruku-ref{:href => "#AlternativeAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/subalgebra"} subalgebra
              generated by any two elements is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
          %p
            This is due to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Emil+Artin"} Emil Artin
            = succeed ")." do
              %a{:href => "alternative+algebra#Schafer95"} Schafer 95, p. 18
          %p
            Proposition
            %a.maruku-ref{:href => "#ArtinTheorem"}
            is what allows to carry over a minimum of
            %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
            also to the
            %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
            such as to yield a representation of the
            %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 9
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{9,1}
            %a.maruku-ref{:href => "#SpinorRepsByNormedDivisionAlgebra"}
            below.
          %p
            So we will be looking at a fragment of
            %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
            over these four
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
          #MatrixNotation.num_defn
            %h6#definition_24 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/hermitian+matrices"} hermitian matrices
                with vaues in real
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              be one of the four real
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#HurwitzTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
              %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ZornTheorem"}
            %p
              Say that an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ×
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n \times n
              %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi Mat
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A\in Mat_{n\times n}(\mathbb{K})
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/hermitian+matrix"} hermitian matrix
              if the
              %a.existingWikiWord{:href => "/nlab/show/transpose+matrix"} transpose matrix
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mi t
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mi j
                    %mo ≔
                    %msub
                      %mi A
                      %mrow
                        %mi j
                        %mi i
                  %annotation{:encoding => "application/x-tex"} (A^t)_{i j} \coloneqq A_{j i}
              equals the componentwise
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} conjugated
              matrix (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#Conjugation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi t
                    %mo =
                    %msup
                      %mi A
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A^t = A^\ast
                    \\,.
            %p Hence with the notation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi t
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    (-)^\dagger \coloneqq ((-)^t)^\ast
            %p
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %a.existingWikiWord{:href => "/nlab/show/hermitian+matrix"} hermitian matrix
              precisely if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msup
                      %mi A
                      %mo †
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A = A^\dagger
                    \\,.
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Mat
                      %mrow
                        %mn 2
                        %mo ×
                        %mn 2
                      %mi her
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mat_{2 \times 2}^{her}(\mathbb{K})
              for the
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              of hermitian matrices.
          #TraceReversal.num_defn
            %h6#definition_25 Definition
            %p
              %strong (trace reversal)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msubsup
                      %mi Mat
                      %mrow
                        %mn 2
                        %mo ×
                        %mn 2
                      %mi her
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Mat_{2 \times 2}^{her}(\mathbb{K})
              be a hermitian
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ×
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2 \times 2
              matrix as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#MatrixNotation"}
              %em trace reversal
              is the result of subtracting its
              %a.existingWikiWord{:href => "/nlab/show/trace"} trace
              times the identity matrix:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mi tr
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msub
                      %mn 1
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde A \;\coloneqq\; A - (tr A) 1_{n\times n}
                    \\,.
          %h4#SpacetimeInDim3And4And6And10 Spacetime in dimensions 3, 4, 6 and 10
          %p
            We discuss how
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            of dimension 3,4,6 and 10 is naturally expressed in terms of the real
            %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕂
                %annotation{:encoding => "application/x-tex"} \mathbb{K}
            from prop.
            = succeed "," do
              %a.maruku-ref{:href => "#HurwitzTheorem"}
            %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
            %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
            from prop.
            = succeed "." do
              %a.maruku-ref{:href => "#ZornTheorem"}
          #SpacetimeAsMatrices.num_prop
            %h6#proposition_29 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                via
                %a.existingWikiWord{:href => "/nlab/show/hermitian+matrices"} hermitian matrices
                in real
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              be one of the four real
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#HurwitzTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
              %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ZornTheorem"}
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              (of
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/inner+product+spaces"} inner product spaces
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 2
                    %mo +
                    %msub
                      %mi dim
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    d = 2 + dim_{\mathbb{R}}(\mathbb{K})
            %p hence
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 2
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2,1}
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{R}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 3
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{3,1}
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{C}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 5
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{5,1}
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℍ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{H}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 9
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{9,1}
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi 𝕆
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{O}
            %p
              and the
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ×
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2 \times 2
              %a.existingWikiWord{:href => "/nlab/show/hermitian+matrices"} hermitian matrices
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MatrixNotation"}
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
              whose
              = succeed "-square" do
                %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
              operation on matrices:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi dim
                          %mi ℝ
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msubsup
                        %mi Mat
                        %mrow
                          %mn 2
                          %mo ×
                          %mn 2
                        %mi her
                      %mo{:stretchy => "false"} (
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi det
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{dim_{\mathbb{R}}(\mathbb{K})+1,1}
                    \\;\simeq\;
                    \\left(Mat_{2 \times 2}^{her}(\mathbb{K}), -det \right)
                    \\,.
            %p
              As a
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              this is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi x
                                %mn 0
                              %mo +
                              %msub
                                %mi x
                                %mn 1
                            %mtd
                              %mi y
                          %mtr
                            %mtd
                              %msup
                                %mi y
                                %mo *
                            %mtd
                              %msub
                                %mi x
                                %mn 0
                              %mo −
                              %msub
                                %mi x
                                %mn 1
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext with
                    %mspace{:width => "thickmathspace"}
                    %mi y
                    %mo ≔
                    %msub
                      %mi x
                      %mn 2
                    %mn 1
                    %mo +
                    %msub
                      %mi x
                      %mn 3
                    %msub
                      %mi e
                      %mn 1
                    %mo +
                    %msub
                      %mi x
                      %mn 4
                    %msub
                      %mi e
                      %mn 2
                    %mo +
                    %mi ⋯
                    %mo +
                    %msub
                      %mi x
                      %mrow
                        %mn 2
                        %mo +
                        %msub
                          %mi dim
                          %mrow
                            %mi ℝ
                            %mo{:stretchy => "false"} (
                            %mi 𝕂
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi e
                      %mrow
                        %msub
                          %mi dim
                          %mi ℝ
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (x_0, x_1, \cdots, x_{d-1})
                    \\;\mapsto\;
                    \\left(
                    \\array{
                    x_0 + x_1 &amp; y
                    \\\
                    y^\ast &amp; x_0 - x_1
                    }
                    \\right)
                    \\;\;\;
                    \\text{with}\;
                    y \coloneqq x_2 1 + x_3 e_1 + x_4 e_2 +   \cdots + x_{2 + dim_{\mathbb{R}(\mathbb{K})}} \,e_{dim_{\mathbb{R}}(\mathbb{K})-1}
                    \\,.
            %p
              Under this identification the operation of trace reversal from def.
              %a.maruku-ref{:href => "#TraceReversal"}
              corresponds to
              %em time reversal
              in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi x
                                  %mn 0
                                %mo +
                                %msub
                                  %mi x
                                  %mn 1
                              %mtd
                                %mi y
                            %mtr
                              %mtd
                                %msup
                                  %mi y
                                  %mo *
                              %mtd
                                %msub
                                  %mi x
                                  %mn 0
                                %mo −
                                %msub
                                  %mi x
                                  %mn 1
                        %mo )
                      %mo ˜
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mi x
                                %mn 0
                              %mo +
                              %msub
                                %mi x
                                %mn 1
                            %mtd
                              %mi y
                          %mtr
                            %mtd
                              %msup
                                %mi y
                                %mo *
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mi x
                                %mn 0
                              %mo −
                              %msub
                                %mi x
                                %mn 1
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widetilde{
                    \\left(
                    \\array{
                    x_0 + x_1 &amp; y
                    \\\
                    y^\ast &amp; x_0 - x_1
                    }
                    \\right)
                    }
                    \\;=\;
                    \\left(
                    \\array{
                    \-x_0 + x_1 &amp; y
                    \\\
                    y^\ast &amp; -x_0 - x_1
                    }
                    \\right)
                    \\,.
          .proof
            %h6#proof_21 Proof
            %p
              This is immediate from the nature of the conjugation operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (-)^\ast
              from def.
              = succeed ":" do
                %a.maruku-ref{:href => "#Conjugation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo −
                            %mi det
                            %mrow
                              %mo (
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo +
                                      %msub
                                        %mi x
                                        %mn 1
                                    %mtd
                                      %mi y
                                  %mtr
                                    %mtd
                                      %msup
                                        %mi y
                                        %mo *
                                    %mtd
                                      %msub
                                        %mi x
                                        %mn 0
                                      %mo −
                                      %msub
                                        %mi x
                                        %mn 1
                              %mo )
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 0
                            %mo +
                            %msub
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 0
                            %mo −
                            %msub
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi y
                            %msup
                              %mi y
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 0
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                            %mo +
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi a
                                %mo =
                                %mn 1
                              %mrow
                                %mi d
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mi a
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \-
                    det
                    \\left(
                    \\array{
                    x_0 + x_1 &amp; y
                    \\\
                    y^\ast &amp; x_0 - x_1
                    }
                    \\right)
                    \&amp; =
                    \-(x_0 + x_1)(x_0 - x_1)
                    +
                    y y^\ast
                    \\\
                    \&amp; =
                    \-(x_0)^2 + \underoverset{a = 1}{d-1}{\sum} (x_a)^2
                    \\end{aligned}
                    \\,.
          %p By direct computation one finds:
          #DeterminantViaProductWithTraceReversal.num_prop
            %h6#proposition_30 Proposition
            %p
              In terms of the trace reversal operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
