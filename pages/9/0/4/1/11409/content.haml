                %a.existingWikiWord{:href => "/nlab/show/Lindstr%C3%B6m%27s+theorem"} Lindström's theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Deligne+completeness+theorem"} Deligne completeness theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stone+duality"} Stone duality
