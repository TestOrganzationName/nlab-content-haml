                    \\,.
            %p
              By the judgmental
              %a.existingWikiWord{:href => "/nlab/show/computation+rule"} computation rule
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/function+types"} function types
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi λ
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo .
