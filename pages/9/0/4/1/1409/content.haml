            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/center+of+contraction"} center of contraction
                  is given by the
                  %a.existingWikiWord{:href => "/nlab/show/dependent+pair"} dependent pair
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %msub
                            %mi{:mathvariant => "normal"} refl
                            %mi T
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (x, \mathrm{refl}_T(x))
              %li
                %p
                  for any
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi z
