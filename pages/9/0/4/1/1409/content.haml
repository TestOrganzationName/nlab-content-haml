                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi A
                      %mi x
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left(\sum_{j:A \to A} \prod_{x:A} i(j(x)) =_A x\right) \times \left(\sum_{k:A \to A} \prod_{x:A} k(i(x)) =_A x\right)
            %p
              indicating that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} i:A \to A
