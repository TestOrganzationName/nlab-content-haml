            = succeed "." do
              %strong identity equivalence
          %p There are other ways to prove that the identity function is an equivalence of types. One of them is given below:
          %p
          .num_theorem
            %h6 Theorem
            %p
              Suppose that
              %a.existingWikiWord{:href => "/nlab/show/function+types"} function types
              are defined using judgmental
              = succeed "." do
