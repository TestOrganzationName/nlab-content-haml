          .num_cor
            %h6 Corollary
            %p
              Any
              %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
              on a type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
          %p
            Hence, in
            = succeed "," do
