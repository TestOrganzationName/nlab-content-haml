                        %annotation{:encoding => "application/x-tex"} z \colon \sum_{y \colon T} y \,=_T\, x
                  %a.existingWikiWord{:href => "/nlab/show/identification"} identification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo =
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
