              %a.existingWikiWord{:href => "/nlab/show/terms"} terms
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mi T
                    %annotation{:encoding => "application/x-tex"} x \colon T
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              of the identity function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
