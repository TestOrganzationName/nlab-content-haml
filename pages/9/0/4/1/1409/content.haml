          %p
          .num_cor
            %h6 Corollary
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/inverse+function"} inverse function
              of the identity function is the identity function itself.
          %p
          .num_theorem
            %h6 Theorem
            %p Any identity function is bi-invertible.
          %p
          .proof
            %h6 Proof
            %p
              Given a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} i:A \to A
              and a dependent function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo :
                      %msub
