              %a.existingWikiWord{:href => "/nlab/show/fiber+type"} fiber type
              in question is the
              %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi y
                        %mo{:lspace => "verythinmathspace"} :
                        %mi T
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi λ
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo .
                    %mi t
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %msub
