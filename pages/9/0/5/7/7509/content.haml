            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/telescope+type"} telescope type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/product+type"} product type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dependent+product+type"} dependent product type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dependent+pushout+type"} dependent pushout type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/record+type"} record type
          %h2#references References
          %p A textbook account could be found in section 4.6 of:
          %ul
            %li#Rijke22
              %a.existingWikiWord{:href => "/nlab/show/Egbert+Rijke"}> Egbert Rijke
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Homotopy+Type+Theory"} Introduction to Homotopy Type Theory
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/2212.11082"} arXiv:2212.11082
          %p
            Discussion in a context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ul
            %li#UFP13
              %a.existingWikiWord{:href => "/nlab/show/Univalent+Foundations+Project"}> Univalent Foundations Project
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Homotopy+Type+Theory+--+Univalent+Foundations+of+Mathematics"} Homotopy Type Theory – Univalent Foundations of Mathematics
              (2013) &amp;lbrack;
              %a{:href => "http://homotopytypetheory.org/book/"}> web
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://hottheory.files.wordpress.com/2013/03/hott-online-323-g28e4374.pdf"} pdf
          %p For the definition of dependent sum types in terms of universes, dependent product types, and function types, see:
          %ul
            %li#ML71
              %a.existingWikiWord{:href => "/nlab/show/Per+Martin-L%C3%B6f"}> Per Martin-Löf
              ,
              = succeed "," do
                %em A Theory of Types
              = succeed "," do
                %a{:href => "https://raw.githubusercontent.com/michaelt/martin-lof/master/pdfs/martin-loef1971%20-%20A%20Theory%20of%20Types.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/MartinLoef1971-ATheoryOfTypes.pdf", :title => "pdf"} pdf
          %p
            See also most references at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
