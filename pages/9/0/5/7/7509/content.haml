                      %mo{:lspace => "verythinmathspace"} :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi x
                          %mo{:lspace => "verythinmathspace"} :
                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                  %mspace{:width => "2em"}
