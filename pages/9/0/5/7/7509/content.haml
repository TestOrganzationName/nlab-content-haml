                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{x\colon A} B(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a\colon A
            (to be the value of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \pi_1 p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} b\colon B(a)
            (to be the value of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 2
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \pi_2 p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi a
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mspace{:width => "2em"}
                      %mi b
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi x
                          %mo{:lspace => "verythinmathspace"} :
                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{a\colon A \qquad b\colon B(a)}{(a,b)\colon \sum_{x\colon A} B(x)}
          %p
            Finally, we have computation rules which say that the relationship between the constructors and the eliminators is as we hoped. We always have
            %a.existingWikiWord{:href => "/nlab/show/beta+reduction"} beta reduction
            rules
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo →
                    %mi β
                  %mi a
                  %mspace{:width => "2em"}
                  %msub
                    %mi π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo →
                    %mi β
                  %mi b
                %annotation{:encoding => "application/x-tex"} \pi_1(a,b) \to_\beta a \qquad \pi_2(a,b) \to_\beta b
          %p
            and we may or may not choose to have an
            %a.existingWikiWord{:href => "/nlab/show/eta+reduction"} eta reduction
            rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mn 1
                  %mi p
                  %mo ,
                  %msub
                    %mi π
                    %mn 2
                  %mi p
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo →
                    %mi η
                  %mi p
                %annotation{:encoding => "application/x-tex"} (\pi_1 p, \pi_2 p) \to_\eta p
          %h4#as_a_positive_type_2 As a positive type
          %p
            When presented positively, primacy is given to the constructors. We specify that the way to construct something of type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{x\colon A} B(x)
            is to give a term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a\colon A
            and a term
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b\colon B(a)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi a
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mspace{:width => "2em"}
                      %mi b
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi x
                          %mo{:lspace => "verythinmathspace"} :
                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{a\colon A \qquad b\colon B(a)}{(a,b)\colon \sum_{x\colon A} B(x)}
          %p
            Of course, this is the same as the constructor obtained from the negative presentation. However, the eliminator is different. Now, in order to say how to
            %em use
            something of type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{x\colon A} B(x)
            %em assuming
            that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            were of the form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi z
                      %mo{:lspace => "verythinmathspace"} :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi x
                          %mo{:lspace => "verythinmathspace"} :
                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Type
                      %mspace{:width => "2em"}
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi x
                          %mo{:lspace => "verythinmathspace"} :
                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "2em"}
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ,
                      %mi y
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi c
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi let
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi p
                      %mi in
                      %mi c
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{z\colon \sum_{x\colon A} B(x) \vdash C(z)\colon Type\qquad
                  p\colon \sum_{x\colon A} B(x) \qquad x\colon A, y\colon B(x) \vdash c\colon C((x,y))}{let (x,y) = p in c \;\colon C(p)}
          %p
            We need a term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            in the context of two variables of types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x,y)
            in the destructor is just a part of the syntax; it is not an instance of the
            %em constructor
            ordered pair.
          %p
            Now we have the
            %a.existingWikiWord{:href => "/nlab/show/beta+reduction"} beta reduction
            rule:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi let
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi in
                  %mi c
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo →
                    %mi β
                  %mspace{:width => "thickmathspace"}
                  %mi c
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo{:stretchy => "false"} /
                  %mi x
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} /
                  %mi y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} let (x,y) = (a,b) \,in c \;\to_\beta\; c[a/x, b/y]
          %p
            In other words, if we build an ordered pair and then break it apart, what we get is just the things we put into it. (The notation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo{:stretchy => "false"} /
                  %mi x
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} /
                  %mi y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} c[a/x, b/y]
            means to substitute
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            in the term
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
          %p
            And (if we wish) the
            %a.existingWikiWord{:href => "/nlab/show/eta+reduction"} eta reduction
            rule, which is a little more subtle:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi let
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi p
                  %mi in
                  %mi c
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi z
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo →
                    %mi η
                  %mspace{:width => "thickmathspace"}
                  %mi c
                  %mo{:stretchy => "false"} [
                  %mi p
                  %mo{:stretchy => "false"} /
                  %mi z
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} let (x,y) = p in c[(x,y)/z] \;\to_\eta\; c[p/z]
          %p
            This says that if we break something of type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{x\colon A} B(x)
            into its components, but then we only use those two components by way of putting them back together into an ordered pair, then we might as well just not have broken it down in the first place.
          %p
            Positively defined dependent sum types are naturally expressed as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inductive+types"} inductive types
            %a.existingWikiWord{:href => "/nlab/show/Coq"} Coq
            syntax we have
          %pre
            %code
              :preserve
                Inductive sig (A:Type) (B:A->Type) : Type :=
                | exist : forall (x:A), B x -> sig A B.          %p
            (Coq then implements beta-reduction, but not eta-reduction. However, eta-equivalence is provable with the internally defined
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
          %p
            Arguably, negatively defined products should be naturally expressed as
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/coinductive+type"} coinductive type
          %h4#positive_versus_negative Positive versus negative
          %p
            In ordinary “nonlinear”
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/product+types"} product types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 1
                          %mi p
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mi let
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi p
                          %mspace{:width => "thinmathspace"}
                          %mi in
                          %mspace{:width => "thinmathspace"}
                          %mi x
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 2
                          %mi p
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mi let
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi p
                          %mspace{:width => "thinmathspace"}
                          %mi in
                          %mspace{:width => "thinmathspace"}
                          %mi y
                      %mtr
                        %mtd
                          %mi let
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi p
                          %mi in
                          %mi c
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mi c
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi π
                            %mn 1
                          %mi p
                          %mo{:stretchy => "false"} /
                          %mi x
                          %mo ,
                          %msub
                            %mi π
                            %mn 2
                          %mi p
                          %mo{:stretchy => "false"} /
                          %mi y
                          %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\pi_1 p &amp;\;\coloneqq\; let (x,y) = p \,in\, x\\
                  \\pi_2 p &amp;\;\coloneqq\; let (x,y) = p \,in\, y\\
                  let (x,y) = p in c &amp;\;\coloneqq\; c[\pi_1 p / x, \pi_2 p / y]
                  \\end{aligned}
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/computation+rules"} computation rules
            then also correspond, just as for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/product+types"} product types
          %p
            Also just as for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/product+types"} product types
            %em dependent
            eliminator for the positive product type from the eliminators for the negative product type, we need the latter to satisfy the
            = succeed "-conversion" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            %a{:href => "/nlab/show/eta-conversion#Propositional"} propositional
            = succeed "-conversion," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
          %p
            One might expect that in “
            %a.existingWikiWord{:href => "/nlab/show/dependent+linear+type+theory"}> dependent linear type theory
            ” the positive and negative dependent sums would become different. However, the meaning of the quoted phrase is unclear.
          %h3#using_universes_and_dependent_product_types Using universes and dependent product types
          %p
            Dependent sum types could be defined directly from universes, dependent product types, and function types - the last of which are definable from dependent product types. Given a
            %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
            is defined as the dependent product type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi P
                      %mo :
                      %mi U
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} \sum_{x:A} B(x) \coloneqq \prod_{P:U} \prod_{x:A} (B(x) \to P) \to P
          %p
            This was the first definition of dependent sum types in dependent type theory, appearing in
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Per+Martin-L%C3%B6f"} Per Martin-Löf
            %a{:href => "#ML71"} original 1971 paper
            on dependent type theory.
          %h2#properties Properties
          %h3#descent_and_large_elimination Descent and large elimination
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            for the positive dependent sum type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Sigma x:A.B(x)
            states that given any type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ,
                  %mi y
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:A, y:B(x) \vdash C(x, y)
            one can construct a type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo :
                  %mi Σ
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %msubsup
                    %mi{:mathvariant => "normal"} descFam
                    %mrow
                      %mi Σ
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} z:\Sigma x:A.B(x) \vdash \mathrm{descFam}_{\Sigma x:A.B(x)}^{C}(z)
            with families of
            %a.existingWikiWord{:href => "/nlab/show/equivalences+of+types"} equivalences of types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ,
                  %mi y
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %msubsup
                    %mi{:mathvariant => "normal"} descEquiv
                    %mrow
                      %mi Σ
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mi C
                  %mo :
                  %msubsup
                    %mi{:mathvariant => "normal"} descFam
                    %mrow
                      %mi Σ
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} in
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:A, y:B(x) \vdash \mathrm{descEquiv}_{\Sigma x:A.B(x)}^C:\mathrm{descFam}_{\Sigma x:A.B(x)}^{C}(\mathrm{in}(x, y)) \simeq C(x, y)
          %p
            Large elimination for positive dependent sum types strengthens the equivalences of types in descent to
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equality+of+types"} judgmental equality of types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ,
                  %mi y
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %msubsup
                    %mi{:mathvariant => "normal"} descFam
                    %mrow
                      %mi Σ
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} in
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} x:A, y:B(x) \vdash \mathrm{descFam}_{\Sigma x:A.B(x)}^{C}(\mathrm{in}(x, y)) \equiv C(x, y) \; \mathrm{type}
          %h3#typal_congruence_rules Typal congruence rules
          %p
            These are called
            %em typal congruence rules
            because they are the analogue of the judgmental
            %a.existingWikiWord{:href => "/nlab/show/congruence+rules"} congruence rules
            which use
            %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            and
            %a.existingWikiWord{:href => "/nlab/show/equivalence+types"} equivalence types
            instead of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given types
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} A'
              and type families
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A \vdash B'(x)
              and equivalences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi A
                    %mo :
                    %mi A
                    %mo ≃
                    %mi A
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} e_A:A \simeq A'
              and dependent function of equivalences
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi B
                      %mo :
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi B
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi e
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} e_B:\prod_{x:A} B(x) \simeq B'(e_A(x))
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} congform
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi A
                    %mo ,
                    %msub
                      %mi e
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo ≃
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \mathrm{congform}_\Sigma(e_A, e_B):\left(\prod_{x:A} B(x)\right) \simeq \left(\prod_{x:A} B(x)\right)
            %p
          %p
          .proof
            %h6 Proof
            %p
              This is theorem 11.1.6 of
              = succeed "," do
                %a{:href => "#Rijke22"} Rijke 2022
          %p The typal congruence rules for dependent sum types are very important for proving various other theorems in dependent type theory. For example,
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/univalent"} univalent
              %a.existingWikiWord{:href => "/nlab/show/Tarski+universe"} Tarski universe
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U, T)
              and a
              = succeed "-small" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                    %annotation{:encoding => "application/x-tex"} A:U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi B
                        %mo :
                        %mi U
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{B:U} T(B) \simeq T(A)
              is contractible.
          %p
          .proof
            %h6 Proof
            %p
              By univalence, for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo :
                    %mi U
                  %annotation{:encoding => "application/x-tex"} A:U
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo :
                      %mi U
                    %annotation{:encoding => "application/x-tex"} B:U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is an equivalence of types
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} ua
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi{:mathvariant => "normal"} isEquiv
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} transport
                      %mrow
                        %mi x
                        %mo :
                        %mi U
                        %mo .
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ua}(A, B):\mathrm{isEquiv}(\mathrm{transport}_{x:U.T(x)}(A, B))
            %p and thus we have the equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} pair
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} transport
                      %mrow
                        %mi x
                        %mo :
                        %mi U
                        %mo .
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi{:mathvariant => "normal"} ua
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo =
                      %mi U
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{pair}(\mathrm{transport}_{x:U.T(x)}(A, B), \mathrm{ua}(A, B)):(A =_U B) \simeq (T(B) \simeq T(A))
            %p and thus by the typal congruence rule of dependent sum types, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} congform
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi U
                    %mo ,
                    %mi λ
                    %mi B
                    %mo :
                    %mi U
                    %mo .
                    %mi{:mathvariant => "normal"} pair
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} transport
                      %mrow
                        %mi x
                        %mo :
                        %mi U
                        %mo .
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi{:mathvariant => "normal"} ua
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi B
                          %mo :
                          %mi U
                      %mo{:stretchy => "false"} (
                      %mi A
                      %msub
                        %mo =
                        %mi U
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo ≃
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi B
                          %mo :
                          %mi U
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \mathrm{congform}_\Sigma(\mathrm{id}_U, \lambda B:U.\mathrm{pair}(\mathrm{transport}_{x:U.T(x)}(A, B), \mathrm{ua}(A, B))):\left(\sum_{B:U} (A =_U B)\right) \simeq \left(\sum_{B:U} (T(B) \simeq T(A))\right)
            %p
              Since the type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi B
                        %mo :
                        %mi U
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo =
                      %mi U
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{B:U} (A =_U B)
              is contractible for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                    %annotation{:encoding => "application/x-tex"} A:U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi B
                        %mo :
                        %mi U
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{B:U} (T(B) \simeq T(A))
              is also contractible.
          %h3#quantification_in_dependent_type_theory Quantification in dependent type theory
          %p
            Given a family of types
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
            %a.existingWikiWord{:href => "/nlab/show/existential+quantifier"} existential quantifier
            is defined as the
            %a.existingWikiWord{:href => "/nlab/show/bracket+type"} bracket type
            of the dependent sum type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mrow
                    %mo [
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ]
                %annotation{:encoding => "application/x-tex"} \exists x:A.B(x) \coloneqq \left[\sum_{x:A} B(x)\right]
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+quantifier"} uniqueness quantifier
            is defined as the
            %a.existingWikiWord{:href => "/nlab/show/isContr"} isContr
            %a.existingWikiWord{:href => "/nlab/show/modality"} modality
            of the dependent sum type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mo !
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi{:mathvariant => "normal"} isContr
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} \exists! x:A.B(x) \coloneqq \mathrm{isContr}\left(\sum_{x:A} B(x)\right)
          %p
            There is also a quantifier which states that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            holds for at most one element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
            %a.existingWikiWord{:href => "/nlab/show/isProp"} isProp
            %a.existingWikiWord{:href => "/nlab/show/modality"} modality
            of the dependent sum type:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isProp
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathrm{isProp}\left(\sum_{x:A} B(x)\right)
          %p
            In each of the last two cases, one could prove that each dependent type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(x)
            has to be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/mere+proposition"} mere proposition
          %p
            Given a natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo :
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n:\mathbb{N}
            and given a family of types
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
            %a.existingWikiWord{:href => "/nlab/show/quantifiers"} quantifiers
            to say that
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              holds for exactly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              elements:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo [
                        %mrow
                          %mo (
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi x
                              %mo :
                              %mi A
                          %mrow
                            %mo [
                            %mi B
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ]
                          %mo )
                        %mo ≃
                        %mi{:mathvariant => "normal"} Fin
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ]
                    %annotation{:encoding => "application/x-tex"} \left[\left(\sum_{x:A} \left[B(x)\right]\right) \simeq \mathrm{Fin}(n)\right]
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              holds for at most
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              elements:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo [
                        %mrow
                          %mo (
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi x
                              %mo :
                              %mi A
                          %mrow
                            %mo [
                            %mi B
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ]
                          %mo )
                        %mo ↪
                        %mi{:mathvariant => "normal"} Fin
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ]
                    %annotation{:encoding => "application/x-tex"} \left[\left(\sum_{x:A} \left[B(x)\right]\right) \hookrightarrow \mathrm{Fin}(n)\right]
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              holds for at least
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              elements:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo [
                        %mi{:mathvariant => "normal"} Fin
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mrow
                          %mo (
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi x
                              %mo :
                              %mi A
                          %mrow
                            %mo [
                            %mi B
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ]
                          %mo )
                        %mo ]
                    %annotation{:encoding => "application/x-tex"} \left[\mathrm{Fin}(n) \hookrightarrow \left(\sum_{x:A} \left[B(x)\right]\right)\right]
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ≃
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \simeq B
                is the
                %a.existingWikiWord{:href => "/nlab/show/equivalence+type"} equivalence type
                between
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ↪
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \hookrightarrow B
                is the type of
                %a.existingWikiWord{:href => "/nlab/show/embeddings"} embeddings
                between
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} Fin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Fin}(n)
                is the
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                elements.
          %h2#categorical_interpretation Categorical interpretation
          %p
            Under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo ⊢
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Type
                %annotation{:encoding => "application/x-tex"} x\colon A \vdash B(x)\colon Type
            corresponds to a
            %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
            or
            %a.existingWikiWord{:href => "/nlab/show/display+map"} display map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} B\to A
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
            = succeed "-conversion." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
          %p
            There is also another interpretation in category theory of the dependent sum type over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} x:A \vdash B(x) \; \mathrm{type}
            as the
            %a.existingWikiWord{:href => "/nlab/show/initial"} initial
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/wide+cospan"} wide cospan
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{x:A} B(x)
            with a family of morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} in
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{in}_A(x):B(x) \to \sum_{x:A} B(x)
          %p
            such that for any other object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with a family of morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f(x):B(x) \to C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mi C
                  %mo :
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} u_C:\sum_{x:A} B(x) \to C
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mi C
                  %mo ∘
                  %msub
                    %mi{:mathvariant => "normal"} in
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} u_C \circ \mathrm{in}_A(x) = f(x)
          %p This corresponds to the positive dependent sum types.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dependent+sum"}> dependent sum
                ,
