                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi π
                        %mn 2
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mn 1
                      %mi p
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{p \colon \sum_{x\colon A} B(x)}{\pi_1 p\colon A} \qquad \frac{p\colon \sum_{x\colon A} B(x)}{\pi_2 p\colon B(\pi_1 p)}
          %p
