              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mo *
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \ast\to [\ast,Y]
              is the
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
