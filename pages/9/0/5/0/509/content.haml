                    \\,.
          %h3#fibers_and_cofibers__kernels_and_cokernels Fibers and cofibers – kernels and cokernels
          #FiberAndCofiberInPointedObjects.num_defn
            %h6#definition_6 Definition
            %p
              Given a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              in a
              %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
              = succeed "," do
                %a.maruku-ref{:href => "#CategoryOfPointedObjects"}
            %ol
              %li
                %p
                  its
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                  or
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                  of the point inclusion
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
