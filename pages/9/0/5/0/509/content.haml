                      %mo →
                      %mo *
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \ast \otimes \ast \to \ast \to Y
            %p
              Regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                  %annotation{:encoding => "application/x-tex"} [X,Y]_*
              as a pointed object with basepoint induced by the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
