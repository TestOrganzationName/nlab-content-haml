                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X,Y]\to [1,Y]
              is induced from the point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo →
                      %mi X
