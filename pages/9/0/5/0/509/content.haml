            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %msup
                      %mi 𝒞
                      %mo *
                  %annotation{:encoding => "application/x-tex"} X, Y \in \mathcal{C}^{\ast}
              two pointed objects in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/pointed+mapping+space"} pointed mapping space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo ∈
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    [X,Y]_*
                    \\in
                    \\mathcal{C}^{\ast/}
            %p
              (the “object of basepoint-preserving maps”), is the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi Y
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi Y
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo ,
                            %mi Y
                            %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [X,Y]_* &amp; \overset{}{\longrightarrow} &amp; \ast
                    \\\
                    \\downarrow &amp;(pb)&amp; \downarrow
                    \\\
                    [X,Y] &amp; \underset{}{\longrightarrow} &amp; [1,Y]
                    }
            %p
              where the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 1
