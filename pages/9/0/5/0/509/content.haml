                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \ast \otimes X \to \ast \to Y
          #SmashProductLeftAdjointToPointedMappingSpace.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              with
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              and with
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+colimits"} finite colimits
            %p
              For every pointed object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msup
                      %mi 𝒞
                      %mo *
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}^{\ast}
              the operation of forming the pointed
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              out of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.maruku-ref{:href => "#PointedMappingSpace"}
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.maruku-ref{:href => "#SmashProductOfPointedObjects"}
              form a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊣
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ↔
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (
                    X \wedge (-)
                    \\;\dashv\;
                    [X,-]_\ast
                    )
                    \\;\colon\;
                    \\mathcal{C}^{\ast/}
                    \\leftrightarrow
                    \\mathcal{C}^{\ast/}
                    \\,.
            %p
              This makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
              itself a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is. The
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mo +
                  %annotation{:encoding => "application/x-tex"} I_+
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BasePointAdjoined"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              the unit for the monoidal structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            (
            %a{:href => "#ElmendorfMandell07"}> Elmendorf-Mandell 07, lemma 4.20
            )
          .num_remark
            %h6#remark_3 Remark
            %p
              The case when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/semicartesian+monoidal+category"} semicartesian
          .num_remark
            %h6#remark_4 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal
              but not
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              %a.maruku-ref{:href => "#SmashProductOfPointedObjects"}
              of the
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal
              as long as the tensor product of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              preserves finite colimits in each variable separately.
            %p
              If not, the smash product can fail to be associative. For instance, the smash product on the ordinary category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              (without any
              %a.existingWikiWord{:href => "/nlab/show/nice+category+of+spaces"} niceness conditions
              imposed) is not associative.
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            functoriality of these structures see at
            = succeed "." do
              %em
                %a{:href => "Wirthm&#252;ller+context#PointedObjects"} Wirthmüller context – Examples – On pointed objects
          %h3#Monadicity Monadicity
          %p
            Pointed objects are the
            %a.existingWikiWord{:href => "/nlab/show/algebras+over+a+monad"} algebras over a monad
            of the
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↦
                  %mi X
                  %mo ⊔
                  %mo *
                %annotation{:encoding => "application/x-tex"} X \mapsto X \sqcup \ast
            (the “
            %a.existingWikiWord{:href => "/nlab/show/maybe+monad"}> maybe monad
            ”). (Already the unit axiom of the monad makes its algebras be pointed objects, the action axiom does not add any further condition in this case.)
          %p
            Notice that if sufficient
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            exist in the first place, then this functor is trivially an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/accessible+functor"} accessible functor
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/accessible+monad"} accessible monad
            = succeed "." do
              %em
                %a{:href => "accessible+monad#CategoryOfAlgebras"} accessible monad – Categories of algebras
          %h3#classifying_topos Classifying topos
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            for pointed object is the
            %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi FinSet
                    %mo *
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSh((FinSet_\ast)^{op})
            on the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of pointed
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
            %em
              %a.existingWikiWord{:href => "/nlab/show/classifying+topos+for+the+theory+of+objects"} classifying topos for the theory of objects
            for more on this.
          %h3#ModelCategoryStructure Model category structure
          #ModelStructureOnSliceCategory.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+pointed+objects"}> model structure on pointed objects
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/X}
              as well as the
              %a.existingWikiWord{:href => "/nlab/show/coslice+category"} coslice category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mi X
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{X/}
              = succeed "," do
                %a.maruku-ref{:href => "#SliceCategory"}
              = succeed "," do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+a+slice+category"} model structure on a (co-)slice category
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is so in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              In particular the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
              = succeed "," do
                %a.maruku-ref{:href => "#CategoryOfPointedObjects"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              becomes itself a model category this way.
          .proof
            %h6#proof_3 Proof
            %p The model structure as claimed is immediate by inspection.
          #ClassicalPointedHomotopyCategory.num_example
            %h6#example_5 Example
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo =
                      %msub
                        %mi Top
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} \mathcal{C} = Top_{Quillen}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              induced via prop.
              %a.maruku-ref{:href => "#ModelStructureOnSliceCategory"}
              we call the
              %em
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed topological spaces
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Top
                        %mi Quillen
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} Top_{Quillen}^{\ast/}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category of a model category
              is the
              %em classical pointed homotopy theory
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(Top^{\ast/})
          #NonDegenerateBasepointAsCofibrantObjects.num_example
            %h6#example_6 Example
            %p
              The fibrant objects in the pointed model structure
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
