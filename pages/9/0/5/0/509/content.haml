              whose
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
