                  %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
                  constitute a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/skew-symmetric+matrix"} skew-symmetric matrix
                  = succeed "." do
