                                  %mn 1
                                  %mrow
                                    %msup
                                      %mi T
                                      %mn 2
                              %msup
                                %mi B
                                %mn 2
                            %mrow
                              %mn 1
                              %mo +
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mrow
                                    %msup
                                      %mi T
                                      %mn 2
                              %msubsup
                                %mi B
                                %mo ∥
                                %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mo ⇔
                          %mspace{:width => "thickmathspace"}
                          %mi E
                          %mspace{:width => "thickmathspace"}
                          %mo ≤
                          %mspace{:width => "thickmathspace"}
                          %mi T
                          %msqrt
                            %mfrac
                              %mrow
                                %msup
                                  %mi T
                                  %mn 2
                                %mo +
                                %msup
                                  %mi B
                                  %mn 2
                              %mrow
                                %msup
                                  %mi T
                                  %mn 2
                                %mo +
                                %msubsup
                                  %mi B
                                  %mo ∥
                                  %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \&amp;
                  \-
                  \\mathrm{det}
                  \\big(
                  (\eta_{\mu \nu})
                  +
                  \\tfrac{1}{T}
                  (F_{\mu \nu})
                  \\big)
                  \\geq  0
                  \\\
                  \&amp; \Leftrightarrow
                  \\;
                  1
                  \\;-\;
                  \\tfrac{1}{T^2}
                  (E \cdot E - B \cdot B)
                  \\;-\;
                  \\tfrac{1}{T^4}
                  (B \cdot E)^2
                  \\;\geq\;
                  0
                  \\\
                  \&amp; \Leftrightarrow
                  \\;
                  \\tfrac{1}{T^2}
                  E^2
                  \-
                  \\tfrac{1}{T^2}
                  B^2
                  +
                  \\tfrac{1}{T^4}
                  E^2 B_{\parallel}^2
                  \\;\leq 1\;
                  \\\
                  \&amp; \Leftrightarrow
                  \\;
                  \\tfrac{1}{T^2}
                  E^2
                  \\;\leq\;
                  \\frac{
                  1 + \tfrac{1}{T^2} B^2
                  }{
                  1 + \tfrac{1}{T^2} B_{\parallel}^2
                  }
                  \\\
                  \&amp; \Leftrightarrow
                  \\;
                  E
                  \\;\leq\;
                  T
                  \\sqrt{
                  \\frac{
                  T^2 + B^2
                  }{
                  T^2 + B_{\parallel}^2
                  }
                  }
                  \\end{aligned}
          %p where
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mo ∥
                  %mo ≔
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %msqrt
                        %mrow
                          %mi E
                          %mo ⋅
                          %mi E
                  %mi B
                  %mo ⋅
                  %mi E
                %annotation{:encoding => "application/x-tex"}
                  B_{\parallel} \coloneqq  \tfrac{1}{\sqrt{E\cdot E}} B \cdot E
          %p
            is the component of the
            %a.existingWikiWord{:href => "/nlab/show/magnetic+field"} magnetic field
            which is parallel to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/electric+field"} electric field
          %p The resulting maximal electric field strength
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi crit
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi T
                  %msqrt
                    %mfrac
                      %mrow
                        %msup
                          %mi T
                          %mn 2
                        %mo +
                        %msup
                          %mi B
                          %mn 2
                      %mrow
                        %msup
                          %mi T
                          %mn 2
                        %mo +
                        %msubsup
                          %mi B
                          %mo ∥
                          %mn 2
                %annotation{:encoding => "application/x-tex"}
                  E_{crit}
                  \\;\coloneqq\;
                  T
                  \\sqrt{
                  \\frac{
                  T^2 + B^2
                  }{
                  T^2 + B_{\parallel}^2
                  }
                  }
          %p
            turns out to be the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Schwinger+limit"} Schwinger limit
            (see
            = succeed ")" do
              %a{:href => "Schwinger+effect#CriticalFieldStrength"} there
            %a.existingWikiWord{:href => "/nlab/show/deconfinement"} deconfining
            = succeed "-pair" do
              %a.existingWikiWord{:href => "/nlab/show/quark"} quark
            = succeed ")." do
              %a{:href => "#HashimotoOkaSonoda14b"} Hashimoto, Oka &amp; Sonoda 2014b, (2.17)
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Myers+effect"} Myers effect
          %h2#references References
          %h3#general General
          %p
            As a proposal for a modification of
            %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
          %ul
            %li#BornInfeld34
              %a.existingWikiWord{:href => "/nlab/show/Max+Born"}> Max Born
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Leopold+Infeld"} Leopold Infeld
              = succeed "," do
                %em Foundations of the New Field Theory
              = succeed ")" do
                %a{:href => "https://www.jstor.org/stable/2935568"} jstor:2935568
          %p The article by Dirac which came to be commonly cited in this context is
          %ul
            %li#Dirac62
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Dirac"}> Paul Dirac
                ,
                = succeed "," do
                  %em An Extensible Model of the Electron
                = succeed ")" do
                  %a{:href => "https://www.jstor.org/stable/2414316"} jstor:2414316
              %p
                (which proposes a
                = succeed "-model" do
                  %a.existingWikiWord{:href => "/nlab/show/membrane"} membrane
                %a.existingWikiWord{:href => "/nlab/show/electron"} electron
                and the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/muon"} muon
          %p Broad review and further developments:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dmitri+Sorokin"}> Dmitri Sorokin
              ,
              %em Introductory Notes on Non-linear Electrodynamics and its Applications
              (
              %a{:href => "https://arxiv.org/abs/2112.12118"}> arXiv:2112.12118
              )
          %p
            On
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/electro-magnetic+duality"} electro-magnetic duality
            %a.existingWikiWord{:href => "/nlab/show/S-duality"} S-duality
            of 4D DBI theory, and variants:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gary+Gibbons"}> Gary Gibbons
                , D. A. Rasheed:
                = succeed "," do
                  %em Electric-Magnetic Duality Rotations in Non-Linear Electrodynamics
                %strong 454
                1-2 (1995) 185-206 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9506035"}> arXiv:hep-th/9506035
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/0550-3213(95)00409-L"} doi:10.1016/0550-3213(95)00409-L
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gary+Gibbons"}> Gary Gibbons
                , D. A. Rasheed:
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SL
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo ,
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{R})
                    Invariance of Non-Linear Electrodynamics Coupled to An Axion and a Dilaton
                %strong 365
                1-4 (1996) 46-50 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9509141"}> arXiv:hep-th/9509141
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/0370-2693(95)01272-9"} doi:10.1016/0370-2693(95)01272-9
          %h3#for_single_abelian_dbranes For single (abelian) D-branes
          %p
            As the low energy
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            for single
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            the DBI action is due to
          %ul
            %li#FradkinTseytlin85
              %p
                %a.existingWikiWord{:href => "/nlab/show/Efim+Fradkin"}> Efim Fradkin
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Arkady+Tseytlin"} Arkady Tseytlin
                = succeed "," do
                  %em Non-linear electrodynamics from quantized strings
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0370-2693(85)90205-9"} doi:10.1016/0370-2693(85)90205-9
            %li#AbouelsaoodCallanNappiYost87
              %p
                A. Abouelsaood,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Curtis+Callan"} Curtis Callan
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Chiara+Nappi"} Chiara Nappi
                = succeed "," do
                  %em Open strings in background gauge fields
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0550-3213(87)90164-7"} doi:10.1016/0550-3213(87)90164-7
            %li#Leigh89
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Leigh"}> Robert Leigh
                ,
                = succeed "," do
                  %em Dirac-Born-Infeld Action from Dirichlet Sigma Model
                = succeed "," do
                  %a{:href => "http://inspirehep.net/record/26399"} spire:26399
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1142/S0217732389003099"} doi:10.1142/S0217732389003099
          %p
            and a full
            = succeed "-symmetric" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+sigma-model"} Green-Schwarz sigma-model
            for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
          %ul
            %li#CGNSW96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Cederwall"}> Martin Cederwall
                , Alexander von Gussich,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bengt+Nilsson"} Bengt Nilsson
                = succeed "," do
                  %em The Dirichlet Super-p-Branes in Ten-Dimensional Type IIA and IIB Supergravity
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9611159"} arXiv:hep-th/9611159
            %li#APPS97b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mina+Aganagic"}> Mina Aganagic
                , Jaemo Park, Costin Popescu,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
                = succeed "," do
                  %em Dual D-Brane Actions
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9702133"} arXiv:hep-th/9702133
          %p Review:
          %ul
            %li#Gibbons97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gary+Gibbons"}> Gary Gibbons
                ,
                = succeed "," do
                  %em Born-Infeld particles and Dirichlet p-branes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9709027"} arXiv:hep-th/9709027
            %li#Savvidy99
              %p
                Konstantin G. Savvidy,
                = succeed "," do
                  %em Born-Infeld Action in String Theory
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/hep-th/9906075"} arXiv:hep-th/9906075
                = succeed ")" do
                  %a{:href => "https://inspirehep.net/literature/501510"} spire:501510
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Arkady+Tseytlin"}> Arkady Tseytlin
                ,
                = succeed "," do
                  %em Born-Infeld action, supersymmetry and string theory
                %a.existingWikiWord{:href => "/nlab/show/Mikhail+Shifman"} Mikhail Shifman
                (ed.)
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/The+many+faces+of+the+superworld"} The many faces of the superworld
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/hep-th/9908105"} arXiv:hep-th/9908105
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1142/9789812793850_0025"} doi:10.1142/9789812793850_0025
            %li#Schwarz01
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"}> John Schwarz
                ,
                = succeed "," do
                  %em Comments on Born-Infeld Theory
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Atish+Dabholkar"} Atish Dabholkar
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sunil+Mukhi"} Sunil Mukhi
                = succeed "," do
                  %em
                    %a{:href => "http://inspirehep.net/record/944370"} Strings 2001: Proceedings, Strings 2001 Conference
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/hep-th/0103165"} arXiv:hep-th/0103165
                = succeed ")" do
                  %a{:href => "http://inspirehep.net/record/554347"} spire:554347
            %li
              %p
                Paul Koerber,
                = succeed "," do
                  %em Abelian and Non-abelian D-brane Effective Actions
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0405227"} arXiv:hep-th/0405227
            %li#Nastase15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Horatiu+Nastase"}> Horatiu Nastase
                , Section 9.2 and 9.4 of:
                = succeed "," do
                  %em Introduction to AdS/CFT correspondence
                = succeed "," do
                  %a{:href => "http://cds.cern.ch/record/1984145"} cds:1984145
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1017/CBO9781316090954"} doi:10.1017/CBO9781316090954
          %p
            Detailed discussion of the relation to the
            %a.existingWikiWord{:href => "/nlab/show/Polyakov+action"} Polyakov action
            and the
            %a.existingWikiWord{:href => "/nlab/show/Nambu-Goto+action"} Nambu-Goto action
            is in
          %ul
            %li#Nieto01
              J. A. Nieto,
              %em Remarks on Weyl invariant p-branes and Dp-branes
              (
              %a{:href => "http://arxiv.org/abs/hep-th/0110227"}> arXiv:hep-th/0110227
              )
          %p
            Discussion in terms of D-branes as
            %a.existingWikiWord{:href => "/nlab/show/leaves"} leaves
            of
            %a.existingWikiWord{:href => "/nlab/show/Dirac+structures"} Dirac structures
            on
            %a.existingWikiWord{:href => "/nlab/show/Courant+Lie+2-algebroids"} Courant Lie 2-algebroids
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/type+II+geometry"} type II geometry
          %ul
            %li#AsakawaSasaWatamura
              %a.existingWikiWord{:href => "/nlab/show/Tsuguhiko+Asakawa"}> Tsuguhiko Asakawa
              , Shuhei Sasa, Satoshi Watamura,
              %em D-branes in Generalized Geometry and Dirac-Born-Infeld Action
              (
              %a{:href => "http://arxiv.org/abs/1206.6964"}> arXiv:1206.6964
              )
          %p See also:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Cederwall"}> Martin Cederwall
                , Alexander von Gussich,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Aleksandar+Mikovic"} Aleksandar Mikovic
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bengt+Nilsson"} Bengt Nilsson
                = succeed "," do
                  %em On the Dirac-Born-Infeld Action for D-branes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9606173"} arXiv:hep-th/9606173
            %li
              %p
                Ian I. Kogan, Dimitri Polyakov,
                = succeed "," do
                  %em DBI Action from Closed Strings and D-brane second Quantization
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0208036"} arXiv:hep-th/0208036
          %p
            Discussion of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/loop+order"} one-loop corrections
          %ul
            %li
              Garrett Goon, Scott Melville, Johannes Noller,
              %em Quantum Corrections to Generic Branes: DBI, NLSM, and More
              (
              %a{:href => "https://arxiv.org/abs/2010.05913"}> arXiv:2010.05913
              )
          %p
            Derivation of the first DBI-correction from an
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            model via
            = succeed ":" do
              %a{:href => "exceptional+generalized+geometry#SuperExceptionalGeometryReferences"} super-exceptional geometry
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/super-exceptional+M5+flavor"} Super-exceptional M5-brane model: Emergence of SU(2)-flavor sector
              (
              %a{:href => "https://arxiv.org/abs/2006.00012"}> arXiv:2006.00012
              )
          %h3#for_coincident_nonabelian_dbranes For coincident (non-abelian) D-branes
          %p
            Proposals for the generalization of the DBI action to
            %a.existingWikiWord{:href => "/nlab/show/non-abelian+group"} non-abelian
            %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+fields"} Chan-Paton gauge fields
            (hence: for
            %a.existingWikiWord{:href => "/nlab/show/intersecting+branes"} coincident
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
          %p
            Via a plain
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/trace"} trace
          %ul
            %li
              T. Hagiwara,
              = succeed "," do
                %em A non-abelian Born-Infeld Lagrangian
              = succeed ")" do
                %a{:href => "https://iopscience.iop.org/article/10.1088/0305-4470/14/11/027"} doi:10.1088/0305-4470/14/11/027
          %p
            Via an antisymmetrized
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/trace"} trace
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Philip+Argyres"}> Philip Argyres
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Chiara+Nappi"} Chiara Nappi
              = succeed "," do
                %em Spin-1 effective actions from open strings
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/0550-3213(90)90305-W"} doi:10.1016/0550-3213(90)90305-W
          %p Via a combination of spacetime and gauge indices:
          %ul
            %li
              Jeong-Hyuck Park,
              = succeed "," do
                %em A Study of a Non-Abelian Generalization of the Born-Infeld Action
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9902081"} arXiv:hep-th/9902081
          %p
            The now widely accepted proposal via a symmetrized
            %a.existingWikiWord{:href => "/nlab/show/trace"} trace
            is due to
          %ul
            %li#Tseytlin97
              %a.existingWikiWord{:href => "/nlab/show/Arkady+Tseytlin"}> Arkady Tseytlin
              ,
              = succeed "," do
                %em On non-Abelian generalization of Born-Infeld action in string theory
              = succeed ")" do
                %a{:href => "http://inspirehep.net/record/439767"} spire:439767
          %p followed by
          %ul
            %li#Myers99
              %a.existingWikiWord{:href => "/nlab/show/Robert+Myers"}> Robert Myers
              ,
              = succeed "," do
                %em Dielectric-Branes
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9910053"} arXiv:hep-th/9910053
              %blockquote
                %p
                  (introducing the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Myers+effect"} Myers effect
          %p The symmetrized trace proposal has become widely accepted.
          %p Review includes:
          %ul
            %li#Chemissany04
              W. Chemissany,
              = succeed "," do
                %em On the way of finding the non-Abelian Born-Infeld theory
              %a{:href => "http://inspirehep.net/record/1286212"} spire:1286212
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/ChemissanyNonAbelianDBI04.pdf", :title => "pdf"} pdf
          %p Issues with this proposal at higher order have been found in:
          %ul
            %li#HashimotoTaylor97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Akikazu+Hashimoto"}> Akikazu Hashimoto
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Washington+Taylor"} Washington Taylor
                = succeed "," do
                  %em Fluctuation Spectra of Tilted and Intersecting D-branes from the Born-Infeld Action
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9703217"} arXiv:hep-th/9703217
            %li#Bain99
              %p
                P. Bain,
                = succeed "," do
                  %em On the non-abelian Born-Infeld action
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Green"} Michael Green
                = succeed "." do
                  %em Progress in String Theory and M-Theory
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/hep-th/9909154"} arXiv:hep-th/9909154
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/978-94-010-0852-5_12"} doi:10.1007/978-94-010-0852-5_12
            %li#BergshoeffBilalRooSevrin01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Adel+Bilal"} Adel Bilal
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mees+de+Roo"} Mees de Roo
                = succeed "," do
                  %em Supersymmetric non-abelian Born-Infeld revisited
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0105274"} arXiv:hep-th/0105274
          %p Correction terms have been proposed in:
          %ul
            %li#TaylorVanRaamsdonk99
              %a.existingWikiWord{:href => "/nlab/show/Washington+Taylor"}> Washington Taylor
              ,
              = succeed "," do
