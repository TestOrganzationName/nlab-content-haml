                    \\\
                    X &amp;\underset{i_1}{\longrightarrow}&amp;
                    Cyl(X) &amp;\underset{\in W}{\longrightarrow}&amp; Cyl(X) \underset{X}{\sqcup} Cyl(X)
                    \\\
                    \&amp;&amp; &amp;{}_{\mathllap{}}\searrow&amp; &amp; \searrow
                    \\\
