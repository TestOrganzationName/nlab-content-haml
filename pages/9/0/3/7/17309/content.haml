          %h2#idea Idea
          %p
            The extra structure of a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            over a
            %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            induces concrete constructions for expressing
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            between
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category of a model category
          %h2#definition Definition
          #PathAndCylinderObjectsInAModelCategory.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
            %ul
              %li
                A
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Path(X)
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a factorization of the
                %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∇
                        %mi X
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi X
                      %mo ×
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \nabla_X \colon X \to X \times X
                as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                      %mi i
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi p
                          %mn 0
                        %mo ,
                        %msub
                          %mi p
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mo ×
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\nabla_X
                    \\;\colon\;
                    X \underoverset{\in W}{i}{\longrightarrow} Path(X) \overset{(p_0,p_1)}{\longrightarrow} X \times X
                    \\,.
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X\to Path(X)
              is a weak equivalence. This is called a
              %strong good path object
              if in addition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Path(X) \to X \times X
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
            %ul
              %li
                A
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cyl
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cyl(X)
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a factorization of the
                %a.existingWikiWord{:href => "/nlab/show/codiagonal"} codiagonal
                (or “fold map”)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi X
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⊔
                      %mi X
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Delta_X \colon X \sqcup X \to X
                as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⊔
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %msub
                          %mi i
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mi p
                      %mrow
                        %mo ∈
                        %mi W
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_X
                    \\;\colon\;
                    X \sqcup X \overset{(i_0,i_1)}{\longrightarrow} Cyl(X) \underoverset{p}{\in W}{\longrightarrow} X
                    \\,.
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Cyl(X) \to X
              is a weak equivalence. This is called a
              %strong good cylinder object
              if in addition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊔
                    %mi X
                    %mo →
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \sqcup X \to Cyl(X)
              is a cofibration.
          #RemarkOnChoicesOfNonGoodPathAndCylinderObjects.num_remark
            %h6#remark Remark
            %p
              By the factorization axioms every object in a model category has both a good path object and as well as a good cylinder object according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
            %p
              For instance in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X\times [0,1]
              is a cylinder object, but not a good cylinder unless
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              itself is cofibrant (a
              %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
              in this case).
            %p
              More generally, the path object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Path(X)
              of def.
              %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
              is analogous to the
              %a.existingWikiWord{:href => "/nlab/show/powering"} powering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋔
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pitchfork(I,X)
              with an
              %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
              and the cyclinder object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cyl(X)
              is analogous to the
              %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
              with a cylinder object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ⊙
                      %mi X
                    %annotation{:encoding => "application/x-tex"} I\odot X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is fibrant/cofibrant, then these powers and copowers are in fact examples of (good) path and cylinder objects if the
              %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
              is sufficiently good.
          #LeftAndRightHomotopyInAModelCategory.num_defn
