          %h2#properties Properties
          %h3#basic_lemmas Basic lemmas
          #ComponentsOfGoodCylinderOfCofibrantAreAcyclicCofibrationsAndDually.num_lemma
            %h6#lemma Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊔
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %msub
                          %mi i
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mi p
                      %mrow
                        %mo ∈
                        %mi W
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \sqcup X \overset{(i_0,i_1)}{\longrightarrow} Cyl(X) \underoverset{p}{\in W}{\longrightarrow} X
              is a good
              %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
              for a
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              def.
              = succeed "," do
                %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 0
                    %mo ,
                    %msub
                      %mi i
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i_0, i_1 \colon X \to Cyl(X)
              are acyclic cofibrations.
            %p
              Dually, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                      %mi i
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi p
                          %mn 0
                        %mo ,
                        %msub
                          %mi p
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \underoverset{\in W}{i}{\longrightarrow} Path(X) \overset{(p_0,p_1)}{\longrightarrow} X \times X
            %p
              is a good path object for a
              %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
