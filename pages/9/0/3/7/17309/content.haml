                    \\\
                    {}^{\mathllap{i_0}}_{\mathllap{\in W \cap Cof}}\downarrow
                    \&amp;{}^{\mathllap{h}}\nearrow&amp;
                    \\downarrow^{\mathrlap{p_0,p_1}}_{\mathrlap{\in Fib}}
                    \\\
                    Cyl(X)
                    \&amp;\underset{(f \circ p,\eta)}{\longrightarrow}&amp; Y \times Y
                    }
                    \\,,
            %p
              where on the right we have the chosen path space object. Now the composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi η
                      %mo{:stretchy => "false"} ˜
                    %mo ≔
                    %mi h
                    %mo ∘
