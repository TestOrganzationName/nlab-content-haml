          %h3#equivalence_relation Equivalence relation
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant object
              in a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant object
              %a.existingWikiWord{:href => "/nlab/show/relations"} relations
              of
              %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %msub
                      %mo ⇒
                      %mi L
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \Rightarrow_L g
              and of
              %a.existingWikiWord{:href => "/nlab/show/right+homotopy"} right homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %msub
                      %mo ⇒
                      %mi R
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \Rightarrow_R g
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LeftAndRightHomotopyInAModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/hom+set"} hom set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(X,Y)
              coincide and are both
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relations"} equivalence relations
          .proof
            %h6#proof_4 Proof
            %p
              That both relations coincide under the (co-)fibrancy assumption follows directly from lemma
              = succeed "." do
                %a.maruku-ref{:href => "#LeftHomotopyWithCofibrantDomainImpliesRightHomotopyAndDually"}
            %p
              To see that left homotopy with domain
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} transitive relation
              first use lemma
              %a.maruku-ref{:href => "#GoodCylinderObjectsSupportEveryLeftHomotopyAndDually"}
              to obtain that every left homotopy is exhibited by a
              %em good
              cylinder object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cyl(X)
              and then lemma
              %a.maruku-ref{:href => "#ComponentsOfGoodCylinderOfCofibrantAreAcyclicCofibrationsAndDually"}
              to see that the cofiber coproduct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ⊔
                      %mi X
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cyl(X)\underset{X}{\sqcup} Cyl(X)
              in
