                %strong left homotopy
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:lspace => "verythinmathspace"} :
                      %mi f
                      %msub
                        %mo ⇒
                        %mi L
                      %mi g
                    %annotation{:encoding => "application/x-tex"} \eta \colon f \Rightarrow_L g
