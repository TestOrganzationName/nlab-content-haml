                        %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+theorem"} Eilenberg-Zilber theorem
                      %ul
                        %li
                          %a.existingWikiWord{:href => "/nlab/show/cochain+on+a+simplicial+set"} cochain on a simplicial set
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/K%C3%BCnneth+theorem"} Künneth theorem
          %h1#section_table_of_contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#construction"} Construction
              %li
                %a{:href => "#related_entries"} Related entries
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            it turns out that a host of common (co)homological constructions (such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group+homology"} group homology
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cyclic+homology"} cyclic homology
            %a.existingWikiWord{:href => "/nlab/show/homotopy+limits"} homotopy limits
            of
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            on
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            of
            %a.existingWikiWord{:href => "/nlab/show/presentations"} presentations
            of the given algebraic
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            (
            %a.existingWikiWord{:href => "/nlab/show/group"}> group
            ,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            = succeed "&rbrack;," do
              %a{:href => "#IvanovMikhailov15"} Ivanov &amp; Mikhailov 2015
            = succeed "&rbrack;." do
              %a{:href => "#IvanovMikhailov17"} Ivanov &amp; Mikhailov 2017
          %h2#construction Construction
          %p
            Consider
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Pres
                    %mo →
                    %mi Ring
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}F\colon Pres\to Ring
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            of
            %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            on the category of all free
            %a.existingWikiWord{:href => "/nlab/show/extensions"} extensions
            of the form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo →
                    %mi R
                    %mo →
                    %mi F
                    %mo →
                    %mi G
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1\to R\to F\to G\to 1
            %a.existingWikiWord{:href => "/nlab/show/extension"} extension
            (
            %a.existingWikiWord{:href => "/nlab/show/group+presentation"}> free presentations
            ) and sends it to the
            %a.existingWikiWord{:href => "/nlab/show/group+ring"} group ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}F
            %a.existingWikiWord{:href => "/nlab/show/ideals"} ideals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi f
                %annotation{:encoding => "application/x-tex"} \mathbf{f}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi r
                %annotation{:encoding => "application/x-tex"} \mathbf{r}
            in the (functorial) ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mi F
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}F
            that are defined as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mi F
                  %mo →
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{f}
                  \\;\coloneqq\;
                  ker(\mathbb{Z}F \to \mathbb{Z})
                  \\,,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi r
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mi F
                  %mo →
                  %mi ℤ
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{r}
                  \\;\coloneqq\;
                  ker(\mathbb{Z}F \to \mathbb{Z}G)
                  \\,.
          %p
            That is,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi f
                %annotation{:encoding => "application/x-tex"} \mathbf{f}
            is the
            %a.existingWikiWord{:href => "/nlab/show/augmentation+ideal"} augmentation ideal
            of the group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (w - 1)
            where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} w \in F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi r
                %annotation{:encoding => "application/x-tex"} \mathbf{r}
            is a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/subobject"} sub
            %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi f
                %annotation{:encoding => "application/x-tex"} \mathbf{f}
            generated by expressions of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (r - 1)
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} r \in R
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi f
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi r
                %annotation{:encoding => "application/x-tex"} \mathbf{f},\mathbf{r}
            are
            %a.existingWikiWord{:href => "/nlab/show/ideals"} ideals
            of the
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            of
            %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ZF
                  %annotation{:encoding => "application/x-tex"} ZF
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi rf
                  %mo ∩
                  %mstyle{:mathvariant => "bold"}
                    %mi fr
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mrow
                      %mi r
                      %mo +
                      %mi ff
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi r
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mo +
                  %mstyle{:mathvariant => "bold"}
                    %mi f
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi r
                    %mi k
                  %mstyle{:mathvariant => "bold"}
                    %mi f
                  %mo ,
                  %mi …
                %annotation{:encoding => "application/x-tex"} \mathbf{rf}\cap \mathbf{fr}, \mathbf{r+ff}, \mathbf{r}^{k+1}+\mathbf{f}\mathbf{r}^k\mathbf{f}, \dots
          %p
            These are
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            on the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/free+group"} free
            %a.existingWikiWord{:href => "/nlab/show/extensions"} extensions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pres
                %annotation{:encoding => "application/x-tex"} Pres
            with values in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Ab"} abelian groups
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pres
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi Pres
                %annotation{:encoding => "application/x-tex"} Pres(G)\subset Pres
            denote a fiber of a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pres
                  %mo →
                  %mi Gr
                %annotation{:encoding => "application/x-tex"} Pres\to Gr
            sending a free
            %a.existingWikiWord{:href => "/nlab/show/extension"} extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo →
                  %mi R
                  %mo →
                  %mi F
                  %mo →
                  %mi G
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1\to R\to F\to G\to 1
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-expression" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mrow
                        %mi f
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} r
                  %annotation{:encoding => "application/x-tex"} \mathbf{f\r}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi f
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi r
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} w(\mathbf{f},\mathbf{r})
            and a group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                    %mi i
                  %mo{:stretchy => "false"} [
                  %mi w
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi f
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi r
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msup
                    %mi lim
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi f
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi r
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %mi Pres
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} {}^i[w(\mathbf{f},\mathbf{r})](G) := lim^i (w(\mathbf{f},\mathbf{r})|_{Pres(G)}).
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi lim
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi ℱ
                  %mo :
                  %mi C
                  %mo →
                  %mi Ab
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} lim^i (\mathcal{F}: C\to Ab)
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/derived+functor+in+homological+algebra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              \-th right derived
            functor of the
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi lim
                    %mo :
                    %mi Fun
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi Ab
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Ab
                  %annotation{:encoding => "application/x-tex"} lim: Fun(C,Ab)\to Ab
          %p
            It turns out that by exploiting some features of the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pres
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pres(G)
            this construction can be made functorial in
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
            (in particular, its
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            is
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/contractible+space"} contractible
            = succeed "&rbrack;," do
              %a{:href => "#IvanovMikhailov15"} Ivanov &amp; Mikhailov 2015
            = succeed "&rbrack;" do
              %a{:href => "#IvanovMikhailov17"} Ivanov &amp; Mikhailov 2017
            %a.existingWikiWord{:href => "/nlab/show/derived+limit+functor"} higher limits
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/constant+functors"} constant functors
          %p
            Secondly, this category is strongly connected, in that the hom-set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} sf
                    %mi hom
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi c
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {\sf hom}(c,c')
            is not empty for any pair of objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} c'
            = succeed "-expression" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mrow
                        %mi f
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} r
                  %annotation{:encoding => "application/x-tex"} \mathbf{f\r}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi f
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi r
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} w(\mathbf{f},\mathbf{r})
            we associate a graded
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            from the category
            %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
            of
            %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            to the category
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                    %mi i
                  %mo{:stretchy => "false"} [
                  %mi w
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi f
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi r
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Gr
                  %mo →
                  %mi Ab
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"} {}^i[w(\mathbf{f},\mathbf{r})] \colon Gr \to Ab\,.
          %p
            In &amp;lbrack;
            %a{:href => "#GolubNikita24"}> Golub 2024
            \&amp;rbrack; author suggests a homotopy theoretic construction not using the homological algebra.
          %h2#related_entries Related entries
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/higher+limit+approach+to+homology"} higher limit approach to homology
          %h2#references References
          %p The original articles
          %ul
            %li#IvanovMikhailov15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sergei+O.+Ivanov"}> Sergei O. Ivanov
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Roman+Mikhailov"} Roman Mikhailov
                = succeed "," do
                  %em A higher limit approach to homology theories
                %strong 219
                6 (2015) 1915-1939 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1309.4920"}> arXiv:1309.4920
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.jpaa.2014.07.016"} doi:10.1016/j.jpaa.2014.07.016
            %li#IvanovMikhailov17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sergei+O.+Ivanov"}> Sergei O. Ivanov
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Roman+Mikhailov"} Roman Mikhailov
                = succeed "," do
                  %em
                    Higher limits, homology theories and
                    = succeed "-codes" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi fr
                          %annotation{:encoding => "application/x-tex"} \mathbf{fr}
                = succeed "," do
                  %em Combinatorial and Toric Homotopy
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1510.09044"} arXiv:1510.09044
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1142/9789813226579_0004"} doi:10.1142/9789813226579_0004
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sergei+O.+Ivanov"}> Sergei O. Ivanov
