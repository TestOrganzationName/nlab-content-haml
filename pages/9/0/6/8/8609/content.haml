                                    %mi X
                                    %mo *
                                  %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi X
                            %msup
                              %mi X
                              %mo *
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{X}{\sum} X^\ast A &amp;\longrightarrow&amp; A
                    \\\
                    \\downarrow^{\mathrlap{\underset{X}{\sum}X^\ast f}} &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    \\underset{X}{\sum} X^\ast B &amp;\longrightarrow&amp; B
                    }
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          .proof
            %h6#proof_3 Proof
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+reciprocity"} Frobenius reciprocity
              the diagram is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %mo ×
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %mi f
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi X
                            %mo ×
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi B
                    %mspace{:width => "2em"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X\times A &amp; \longrightarrow&amp; A
                    \\\
                    \\downarrow^{\mathrlap{(id,f)}} &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    X \times B &amp;\longrightarrow&amp; B
                    }
                    \\qquad.
          %h2#in_higher_category_theory In higher category theory
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be an (∞,1)-category. We still want to define the dependent sum as the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi X
                  %mo →
                  %msub
                    %mi C
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi Y
                %annotation{:encoding => "application/x-tex"} C_{/X} \to C_{/Y}
            given by composing with the functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to Y
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi tgt
                  %mo :
                  %msup
                    %mi C
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} tgt : C^{[1]} \to C
            is a cocartesian fibration classified by a functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mi C
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                    %mo :
                    %mi X
                    %mo ↦
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} L : C \to (\infty,1)Cat : X \mapsto C_{/X}
          %p
            Then for any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi f
                  %mo =
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Sigma_f = L(f)
            to be the dependent sum.
          %p
            Since the morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi z
                  %mo →
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi z
                  %mo →
                  %mi y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [z \to x] \to [z \to y]
            induced by composition are cocartesian morphisms, we see that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi f
                %annotation{:encoding => "application/x-tex"} \Sigma_f
            is indeed given by composition with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %p
            By proposition 6.1.1.1 and the following remarks of
            = succeed "," do
              %a{:href => "#Lurie"} Lurie
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has pullbacks, then this is also a cartesian fibration, and is classified by a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} R : C^{op} \to (\infty,1)Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo =
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi C
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi Y
                  %mo →
                  %msub
                    %mi C
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi X
                %annotation{:encoding => "application/x-tex"} f^* = R(f) : C_{/Y} \to C_{/X}
            is the functor computing pullbacks along
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi f
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \Sigma_f \dashv f^*
