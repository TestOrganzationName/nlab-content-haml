                                %mi A
                                %mo ,
                                %mi id
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi X
                            %mo ×
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi X
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %munder
                                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                    %mi X
                                  %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %munder
                                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                    %mi X
                                  %mi f
                                  %mo{:stretchy => "false"} )
                        %mtr
