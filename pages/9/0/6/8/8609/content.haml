          .proof
            %h6#proof_2 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#AbsoluteDependentSumPreservesFiberProducts"}
              it suffices to see that the diagram is a pullback in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              under
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \underset{X}{\sum}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Frobenius+reciprocity"} Frobenius reciprocity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
