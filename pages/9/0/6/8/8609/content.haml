          %h2#idea Idea
          %p
            The
            %em dependent sum
            is a
            %a.existingWikiWord{:href => "/nlab/show/universal+construction"} universal construction
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            to the situation where one factor may
            %em depend
            on the other. It is the
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            to the
            %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            functor between
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/slice+categories"} slice categories
          %p
            Beware that the term “sum” in “dependent sum” is really referring to
            %strong
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              %em
                \. The
                %a.existingWikiWord{:href => "/nlab/show/duality"} dual
                notion is that of
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi I
                %annotation{:encoding => "application/x-tex"} f \colon A \to I
            a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            such that
            %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            exist in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi 𝒞
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi I
                  %mo →
                  %msub
                    %mi 𝒞
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi A
                %annotation{:encoding => "application/x-tex"}
                  f^* \colon \mathcal{C}_{/I} \to \mathcal{C}_{/A}
          %p
            between the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/slice+categories"} slice categories
          .num_defn
            %h6#definition_2 Definition
            %p
              The
              %strong dependent sum
              or
              %strong dependent coproduct
              along the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi A
                    %mo →
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \sum_f \colon \mathcal{C}_{/A} \to \mathcal{C}_{/I}
              of the base change functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi A
                    %mover
                      %munder
                        %mo ←
                        %mrow
                          %msup
                            %mi f
                            %mo *
                      %mover
                        %mo →
                        %mrow
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mi f
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi I
                    %mspace{:width => "2em"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\sum_f \dashv f^* )
                    \\colon
                    \\mathcal{C}_{/A}
                    \\stackrel{\overset{\sum_f}{\to}}{\underset{f^*}{\leftarrow}}
                    \\mathcal{C}_{/I}
                    \\qquad.
          %p This is directly seen to be equivalent to the following.
          .num_defn
            %h6#definition_3 Definition
            %p
              The
              %strong dependent sum
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} f \colon A \to I
              is the
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                    %mo ≔
                    %mi f
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi A
                    %mo →
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\sum_f \coloneqq f\circ (-) \colon \mathcal{C}_{/A} \to \mathcal{C}_{/I}
            %p
              given by
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          %h2#properties Properties
          %h3#relation_to_the_product Relation to the product
          %p
            Assume that the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            has a
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} * \in \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
            be any
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            and assume that the terminal morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mo *
                %annotation{:encoding => "application/x-tex"} f \colon X \to *
            admits all
            %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
            along it.
          %p
            Notice that a
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            of some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mo *
                %annotation{:encoding => "application/x-tex"} A \to *
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mo *
                %annotation{:encoding => "application/x-tex"} X \to *
            is simply the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X \times A
            %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi A
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \times A \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi A
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} X \times A \to X
            as the image of the
            %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo *
                    %mo →
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} f^* \colon \mathcal{C}_{/*} \to \mathcal{C}_{/X}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi A
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \times A \to *
          .num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi A
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \times A \in \mathcal{C}
              is, if it exists, equivalently the dependent sum of the base change of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} A \to *
              along
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mo *
                    %annotation{:encoding => "application/x-tex"} X \to *
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %msup
                      %mi X
                      %mo *
                    %mi A
                    %mo ≃
                    %mi X
                    %mo ×
                    %mi A
                    %mo ∈
                    %mi 𝒞
                    %mspace{:width => "1em"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sum_{X} X^* A \simeq X \times A \in \mathcal{C}
                    \\quad .
          %p
            Here we write “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            ” also for the morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \to *
          %h3#relation_to_type_theory Relation to type theory
          %p
            Under the
            %a.existingWikiWord{:href => "/nlab/show/relation+between+category+theory+and+type+theory"} relation between category theory and type theory
            the dependent sum is the
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            of
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            \.
          %p
            Notice that under the identification of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/propositions+as+types"} propositions as types
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            (or rather their
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/bracket+types"} bracket types
            %a.existingWikiWord{:href => "/nlab/show/existential+quantification"} existential quantification
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∃
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ,
                    %mi P
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \exists x\colon X, P x
          %p
            The following table shows how the
            %a.existingWikiWord{:href => "/nlab/show/natural+deduction"} natural deduction
            rules for dependent sum types correspond to their
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            given by the dependent sum universal construction.
          %div
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
              for
              %a.existingWikiWord{:href => "/nlab/show/dependent+pair+types"} dependent pair types
              (aka “dependent sum types” or “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              \-types”):
            %div{:style => "margin: -30px 0px 20px 10px"}
              %img{:src => "/nlab/files/DependentPairTypeInference-230215.jpg", :width => "770px"}/
          %h3#RelationToSomeLimits Relation to some limits
          #AbsoluteDependentSumPreservesFiberProducts.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a category with
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              an object, then dependent sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %mo :
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{X}{\sum}: \mathcal{C}_{/X} \longrightarrow \mathcal{C}
            %p
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              and
              %a.existingWikiWord{:href => "/nlab/show/reflected+limit"} reflects
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fiber+products"} fiber products
          .proof
            %h6#proof Proof
            %p
              By
              %a{:href => "overcategory#LimitsInSliceViaLimitsOfCoconedDiagram"} this proposition
              limits over a
              %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in the
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              are computed as limits over the
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
              diagram under the cospan in the base category. By
              %a{:href => "final+functor#CoconeUnderCospan"} this proposition
              this inclusion is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/final+functor"} final functor
          #NaturalitySquareOfUnitIsPullback.num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a category with
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X\in \mathcal{C}
              any object, the
              %a.existingWikiWord{:href => "/nlab/show/naturality+square"} naturality square
              of the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi X
                      %mo ⊣
                      %msup
                        %mi X
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\underset{X}{\sum} \dashv X^\ast)
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              on any morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
