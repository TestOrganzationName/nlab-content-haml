                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              %a.existingWikiWord{:href => "/nlab/show/localization+of+a+module"} localization
              on the right.
          %h4#completion Completion
          #InfinityCompletion.num_defn
            %h6#definitionproposition Definition/Proposition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-module"} ∞-module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}
                \-complete
              if for all
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalInfinityModule"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo *
                    %annotation{:encoding => "application/x-tex"} Hom_A(L,N) \simeq \ast
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mi Mod
                      %mrow
                        %mi 𝔞
                        %mi comp
                    %mo ↪
                    %mi A
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    A Mod_{\mathfrak{a}comp}
                    \\hookrightarrow
                    A Mod
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%E2%88%9E-modules"} (∞,1)-category of ∞-modules
              on the
              = succeed "-complete" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕒
                    %annotation{:encoding => "application/x-tex"} \mathbb{a}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective sub-(∞,1)-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ♭
                      %mi 𝔞
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mi Mod
                    %mo ⟶
                    %mi A
                    %msub
                      %mi Mod
                      %mrow
                        %mi 𝔞
                        %mi comp
                    %mo ↪
                    %mi A
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    \\flat_{\mathfrak{a}} \colon A Mod \longrightarrow A Mod_{\mathfrak{a}comp} \hookrightarrow A Mod
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ↦
                    %msubsup
                      %mi N
                      %mi 𝔞
                      %mo ∧
                  %annotation{:encoding => "application/x-tex"}
                    N \mapsto N^{\wedge}_{\mathfrak{a}}
            %p
              is called
              = succeed "." do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi 𝔞
                      %annotation{:encoding => "application/x-tex"} \mathfrak{a}
                  \-completion
          %p
            (
            %a{:href => "#LurieCompletions"}> Lurie “Completions”, def. 4.2.1, lemma 4.2.2
            ).
          %p
            Definition
            %a.maruku-ref{:href => "#InfinityCompletion"}
            relates to the traditional definition, def.
            = succeed "," do
              %a.maruku-ref{:href => "#TraditionalDefinition"}
          .num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              a homotopically discrete
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-module"} ∞-module
              over the
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              which is a
              %a.existingWikiWord{:href => "/nlab/show/Noetherian+module"} Noetherian module
              in that all its submodules are finitely
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} finitely generated
              = succeed "-completion" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              in the sense of def.
              %a.maruku-ref{:href => "#InfinityCompletion"}
              coincides with the traditional definition def.
              = succeed "." do
                %a.maruku-ref{:href => "#TraditionalDefinition"}
          %p
            (
            %a{:href => "#LurieCompletions"}> Lurie “Completions”, prop. 4.3.6
            )
          %h2#properties Properties
          %h3#general_properties General properties
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mi Mod
                    %mrow
                      %mi 𝔞
                      %mi comp
                %annotation{:encoding => "application/x-tex"} A Mod_{\mathfrak{a} comp}
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable (∞,1)-category
          %p
            (
            %a{:href => "#LurieCompletions"}> Lurie “Completions”, prop. 4.1.17
            )
          %h3#Monoidalness Monoidalness
          %p
            We discuss how both
            = succeed "-completion" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ♭
                    %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \flat_{\mathfrak{a}}
            and
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            %a.existingWikiWord{:href => "/nlab/show/torsion+approximation"} torsion approximation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \Pi_{\mathfrak{a}}
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} A Mod
            are
            %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2C1%29-functors"} monoidal (∞,1)-functors
            with respect to the
            %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be an
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                  %mo ⊂
                  %msub
                    %mi π
                    %mn 0
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mathfrak{a} \subset \pi_0 A
            a
            %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} finitely generated
            ideal of its underlying
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
          .num_prop
            %h6#proposition_7 Proposition
            %p
              The completion reflection
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ♭
                        %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} \flat_{\mathfrak{a}}
              = succeed "," do
                %a.maruku-ref{:href => "#InfinityCompletion"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2C1%29-functor"} monoidal (∞,1)-functor
          %p
            (
            %a{:href => "#LurieCompletions"}> Lurie “Completions”, remark 4.2.6
            ).
          %p
            For the torsion approximation functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \Pi_{\mathfrak{a}}
            one gets something slightly weaker, it preserves “monoids without unit”:
          .num_prop
            %h6#proposition_8 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
              of
              = succeed "-torsion" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              = succeed "," do
                %a.maruku-ref{:href => "#TorsionInfinityModule"}
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} co-reflective
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mi Mod
                      %mrow
                        %mi 𝔞
                        %mi tor
                    %mover
                      %munder
                        %mo ⟵
                        %mrow
                          %msub
                            %mi Π
                            %mi 𝔞
                      %mo ↪
                    %mi A
                    %mi Mod
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A Mod_{\mathfrak{a}tor}
                    \\stackrel{\hookrightarrow}{\underset{\Pi_{\mathfrak{a}}}{\longleftarrow}}
                    A Mod
                    \\,.
            %p
              Moreover, the coreflector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \Pi_{\mathfrak{a}}
              is “
              %a.existingWikiWord{:href => "/nlab/show/smashing+localization"}> smashing
              ”, in that there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mi A
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} V \in A Mod
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi 𝔞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi V
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_{\mathfrak{a}}(-) \simeq V \wedge (-)
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a} = (\{x_i\}_i)
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %munder
                      %mo ⊗
                      %mi i
                    %msub
                      %mi V
                      %mi i
                  %annotation{:encoding => "application/x-tex"} V =\underset{i}{\otimes} V_i
              over all the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi x
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi A
                    %mo ⟶
                    %mi A
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi x
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega (A[x_i^{-1}]/A) \longrightarrow A \longrightarrow A[x_i^{-1}]
                    \\,.
          %p
            (
            %a{:href => "#LurieCompletions"}> Lurie “Completions”, prop. 4.1.12
            ).
          %p
            From the general properties of
            %a.existingWikiWord{:href => "/nlab/show/smashing+localization"} smashing localization
            it follows that
          .num_cor
            %h6#corollary Corollary
            %p
              The coreflection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi 𝔞
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mi Mod
                    %mo →
                    %mi A
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \Pi_{\mathfrak{a}} \colon A Mod \to A Mod
            %ol
              %li
                %p
                  preserves small
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
              %li
                %p
                  is a “
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2C1%29-functor"}> monoidal (∞,1)-functor
                  ” except possibly for preservation of units.
          %p
            See also (
            %a{:href => "#LurieCompletions"}> Lurie “Completions”, cor. 4.1.16
            ).
          %h3#relation_to_localization Relation to localization
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
            of
            = succeed "-completion" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \Pi_{\mathfrak{a}}
            is
            %a.existingWikiWord{:href => "/nlab/show/localization+of+a+module"} localization
            away from
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mi 𝔞
                    %mo ∧
                  %mo →
                  %mi id
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi 𝔞
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  (-)_{\mathfrak{a}}^{\wedge} \to id \to (-)[\mathfrak{a}^{-1}]
          %p
            with the completion functor of def.
            %a.maruku-ref{:href => "#InfinityCompletion"}
            on the left and the localization functor of prop.
            %a.maruku-ref{:href => "#LocalizationAwayByColimit"}
            on the right.
          %p
            (
            %a{:href => "#LurieCompletions"}> Lurie “Completions”, example 4.1.14, remark 4.1.20
            )
          %h3#RelationToTorsionApproximation Relation of formal completion to torsion approximation
          %p
            For suitable ideals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                  %mo ⊂
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}\subset A
            of a commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            or more generally of an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
            %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
            of
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            %a.existingWikiWord{:href => "/nlab/show/completion+of+a+module"} completion of A-modules
            forms together with
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            %a.existingWikiWord{:href => "/nlab/show/torsion+approximation"} torsion approximation
            an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+modality"} adjoint modality
            on the
            %br/
