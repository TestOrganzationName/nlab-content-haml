                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi 𝒳
                        %mo{:stretchy => "false"} )
                    %mi sFunc
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒳
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo ,
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\iota^\ast
                    \\;\colon\;
                    sFunc(\mathcal{X},\,\mathbf{C})
                    \\longrightarrow
                    \\underset{
                    i \in \pi_0(\mathcal{X})
                    }{\prod}
                    sFunc\big(
                    \\mathbf{B}\mathcal{X}(x_i,x_i)
