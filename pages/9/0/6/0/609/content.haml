                    \\big)
            %p
              is inverse to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p^\ast
              %a.maruku-eqref{:href => "#eq:ContractionOntoConnectedComponents"} (2)
              up to a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              whose component at any
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
