                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \mathbf{I}_{S}(0,0) \,\coloneqq\, \ast
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi I
                          %mi S
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \mathbf{I}_{S}(1,1) \,\coloneqq\, \ast
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi I
                          %mi S
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mo ∅
                      %annotation{:encoding => "application/x-tex"} \mathbf{I}_{S}(1,0) \,\coloneqq\, \varnothing
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi I
                          %mi S
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mi S
                      %annotation{:encoding => "application/x-tex"} \mathbf{I}_{S}(0,1) \,\coloneqq\, S
            %p
              (whence there is no non-trivial
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              to be defined).
            %p
              Now for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+functors"} enriched functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{I}_{\Delta[n]}
                    \\longrightarrow
                    [\mathbf{D},\,\mathbf{C}]
            %p
              are in
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              with the
              = succeed "-morphisms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mstyle{:mathvariant => "bold"}
                        %mi D
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\mathbf{D},\,\mathbf{C}]
            %p
              But by the
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+monoidal+category"} cartesian closure
              of
              %a.existingWikiWord{:href => "/nlab/show/VCat"} sSet Cat
              these are also in natural bijection to enriched functors of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                    %mo ×
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{D}
                    \\times
                    \\mathbf{I}_{\Delta[n]}
                    \\longrightarrow
                    \\mathbf{C}
            %p
              which are manifestly a simplicial diagram of
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              between the restrictions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{D} \times \{0\} \to \mathbf{C}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi D
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{D} \times \{1\} \to \mathbf{C}
              = succeed "-morphism" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n+1
