            %p
          %h3#CartesianClosedStructure Cartesian closure
          %p
          .num_prop
            %h6 Proposition
            %p
              The category of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+groupoids"} enriched groupoids
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed
          .proof
            %h6 Proof
            %p
              The ambient category of
              %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+categories"} sSet-enriched categories
              is cartesian closed (as any
              %a.existingWikiWord{:href => "/nlab/show/category+of+enriched+categories"}
                category of
                = succeed "-categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒱
                      %annotation{:encoding => "application/x-tex"} \mathcal{V}
              for
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed
              %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
              %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              %a.existingWikiWord{:href => "/nlab/show/enriched+product+categories"} enriched product categories
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+functor+categories"} enriched functor categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                    %mtext -
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathbf{D},\,\mathbf{C} \,\in\, sSet\text{-}Grpd
              also the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+product+category"} enriched product category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo ×
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                  %annotation{:encoding => "application/x-tex"} \mathbf{C} \times \mathbf{D}
              and the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathbf{D},\,\mathbf{C}]
              are in fact
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+groupoids"} enriched groupoids
            %p
              For the product this is immediate, the
              = succeed "-operation" do
                %a.existingWikiWord{:href => "/nlab/show/inverse+morphism"} inversion
            %p
              To see the statement for the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mi S
                  %annotation{:encoding => "application/x-tex"} \mathbf{I}_S
              for the
              %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+category"} sSet-enriched category
              with set objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0,1\}
              and
              %a.existingWikiWord{:href => "/nlab/show/hom+objects"} hom objects
              given by:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi I
                          %mi S
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mn 0
                        %mo{:stretchy => "false"} )
