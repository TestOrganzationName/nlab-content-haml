                    %mo ⟶
                    %mi F
                  %annotation{:encoding => "application/x-tex"} p^\ast \iota^\ast F\longrightarrow F
              obtained as the
              %a.existingWikiWord{:href => "/nlab/show/horizontal+composition"} horizontal composition
              (“
              %a.existingWikiWord{:href => "/nlab/show/whiskering"}> whiskering
              ” of enriched transformations, see
              = succeed ")" do
                %a{:href => "enriched+natural+transformation#RightWhiskering"} there
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              of the enriched transformation
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:ContractingHomotopy"} (3)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
