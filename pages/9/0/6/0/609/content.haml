                  any
                  %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+category"} sSet-enriched category
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
              between the two is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              (as a plain
              = succeed ")" do
