                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
              is moreover
              %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensored
              over
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to a product of categories of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thickmathspace"}
                  %annotation{:encoding => "application/x-tex"} \;
              %a.existingWikiWord{:href => "/nlab/show/group+actions"} group actions
              on objects in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sFunc
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi 𝒳
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo ,
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mi Act
