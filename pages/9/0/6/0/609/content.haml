              is the
              %a.existingWikiWord{:href => "/nlab/show/enriched+natural+transformation"} enriched natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
