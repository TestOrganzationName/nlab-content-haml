                            %mo{:stretchy => "false"} [
                            %mi x
                            %mo{:stretchy => "false"} ]
                    %mo ≔
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi x
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi x
                            %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \gamma_{x_{[x]}} \coloneqq id_{x_{[x]}}
              — as we may — then there is already an
              %a.existingWikiWord{:href => "/nlab/show/equality"} equality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∘
                    %mi ι
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"} p \circ \iota = id
              (hence a
              %a.existingWikiWord{:href => "/nlab/show/retraction"} retraction
              onto the skeleton).
          %p Some consequences:
          %p
          #sSetPresheavesOnSimplicialGroupoidsAreProductsOfsSetGroupActions.num_remark
