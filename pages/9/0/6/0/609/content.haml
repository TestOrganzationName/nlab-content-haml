            %p
          %p
          #BorelModelStructureOnSimplicialGroupActions.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
                on
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group+actions"} simplicial group actions
                over simplicial groupoids)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \,\in\, Grp(sSet)
              a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              with
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+groupoid"} enriched
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              denoted
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi 𝒢
                      %mo ∈
                      %mi sSet
                      %mtext -
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathcal{G} \in sSet\text{-}Grpd
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒢
                    %mo ⟶
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathcal{G} \longrightarrow sSet
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group+action"} simplicial group action
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %p
              Under this identification, the projective model structure on
              %a.existingWikiWord{:href => "/nlab/show/simplicial+functors"} simplicial functors
              (
              %a{:href => "model+structure+on+functors#ExistenceOfProjectiveStructureOnEnrichedFunctors"}> this Prop.
              ) is equivalently the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group+actions"} simplicial group actions
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sFunc
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒢
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi proj
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒢
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Borel
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sFunc\big(
                    \\mathbf{B}\mathcal{G}
                    ,\,
                    sSet
                    \\big)_{proj}
                    \\;\;
                    \=
                    \\;\;
                    \\mathcal{G}Act(sSet)_{Borel}
                    \\,.
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mo ∈
                    %mi sSet
                    %mtext -
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathcal{X} \in sSet\text{-}Grpd
              an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+groupoid"} enriched groupoid
              (Dwyer-Kan
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+groupoid"} simplicial groupoid
              %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi 𝒳
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \pi_0(\mathcal{X}) \simeq \{[x]\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"}
                    \\iota
                    \\,\colon\,
                    \\mathbf{B}(\mathcal{X}(x,x))
                    \\xhookrightarrow{\phantom{---}}
                    \\mathcal{X}
            %p
              is an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+adjoint+equivalence"} enriched adjoint equivalence
              (see discussion
              = succeed ")" do
                %a{:href => "simplicial+groupoid#RelationToSimplicialGroups"} there
              %a.existingWikiWord{:href => "/nlab/show/simplicial+functors"} simplicial functors
              (from
              = succeed ")" do
                %a{:href => "model+structure+on+functors#ExistenceOfProjectiveStructureOnEnrichedFunctors"} that Prop.
              %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred
              under the induced
              %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
              of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor+categories"} enriched functor categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sFunc
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝒳
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi proj
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mo ⊥
                          %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⟶
                        %mrow
                          %msup
                            %mi ι
                            %mo *
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi ι
                            %mo !
                    %mi sFunc
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                    %msub
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mi proj
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Borel
                  %annotation{:encoding => "application/x-tex"}
                    sFunc\big(
                    \\mathcal{X}
                    ,\,
                    sSet
                    \\big)_{proj}
                    \\underoverset
                    {\underset{\iota^\ast}{\longrightarrow}}
                    {\overset{\iota_!}{\longleftarrow}}
                    {\;\; \bot_{\simeq} \;\;}
                    sFunc\Big(
                    \\mathbf{B}\big(\mathcal{X}(x,x)\big)
                    ,\,
                    sSet
                    \\Big)_{proj}
                    \\;=\;
                    \\big(\mathcal{X}(x,x)\big) Act(sSet)_{Borel}
            %p
              By
              %a{:href => "transferred+model+structure#RightTransferAlongAdjointEquivalence"} this example
              it follows that morphisms in all three classes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
