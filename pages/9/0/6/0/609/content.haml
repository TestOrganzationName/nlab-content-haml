              %a.existingWikiWord{:href => "/nlab/show/product+category"} product
              of
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor+categories"} enriched functor categories
              on simplicial delooping groupoids (Exp.
              = succeed ")," do
                %a.maruku-ref{:href => "#SimplicialDeloopingGroupoids"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sFunc
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi 𝒳
                        %mo{:stretchy => "false"} )
                    %mi sFunc
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒳
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo ,
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sFunc(\mathcal{X},\,\mathbf{C})
                    \\;\simeq\;
                    \\underset{
                    i \in \pi_0(\mathcal{X})
                    }{\prod}
                    sFunc\big(
                    \\mathbf{B}\mathcal{X}(x_i,x_i)
