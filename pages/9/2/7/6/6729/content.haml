                          %mo{:stretchy => "false"} (
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (-)\otimes_k \Omega^\bullet_{poly}(\Delta[1])
          %h3#formal_cotangent_bundle Formal cotangent bundle
          %p
            Given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ∈
                  %msubsup
                    %mi dgcAlg
                    %mi k
                    %mi op
                %annotation{:encoding => "application/x-tex"} C \in dgcAlg_k^{op}
            as
            %a{:href => "#BasicDgGeometry"} above
            we want to consider its
            %em
              formal
              %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mi f
                      %mo *
                    %mi c
                  %annotation{:encoding => "application/x-tex"} T^\ast_f c
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
            around the
            %a.existingWikiWord{:href => "/nlab/show/zero+section"} zero section
            of the would-be actual
            %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
          .num_defn
            %h6#definition_2 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    Der(\mathcal{O}(C)) \in \mathcal{O}(C) Mod
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-Lie+algebra"} automorphism ∞-Lie algebra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              whose underlying cochain complex is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋯
                            %mo →
                            %mi Der
                            %mo{:stretchy => "false"} (
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi k
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msub
                                  %mi d
                                  %mrow
                                    %mi 𝒪
                                    %mo{:stretchy => "false"} (
                                    %mi C
                                    %mo{:stretchy => "false"} )
                                %mo ,
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} ]
                            %mi Der
                            %mo{:stretchy => "false"} (
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi k
                                %mo +
                                %mn 1
                            %mo ⟶
                            %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\cdots
                    \\to
                    Der(\mathcal{O}(C))_k
                    \\overset{[d_{\mathcal{O}(C)},-]}{\longrightarrow}
                    Der(\mathcal{O}(C))_{k+1}
                    \\longrightarrow
                    \\cdots
                    }
                    \\,.
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Der(\mathcal{O}(C))_k
              is the module of
              %a.existingWikiWord{:href => "/nlab/show/derivations"} derivations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo →
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi k
                  %annotation{:encoding => "application/x-tex"}
                    v \colon \mathcal{O}(C)^\bullet \to \mathcal{O}(C)^{\bullet + k}
            %p
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi d
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [d_{\mathcal{O}(C)}, -]
              is the graded commutator of derivations with the
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(C)
              regarded as a degree 1 derivation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi 𝒪
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_{\mathcal{O}(C)} \colon \mathcal{O}(C) \to \mathcal{O}(C)
            %p
              We say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(C)
              is
              %em smooth
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Der(\mathcal{O}(C))
              is cofibrant as an object on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}(C) Mod
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi T
                      %mi f
                      %mo *
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi Sym
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi cdgAlg
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}(T^*_f C)
                    \\coloneqq
                    Sym_{\mathcal{O}(C)} Der(\mathcal{O}(C))
                    \\in
                    cdgAlg_{\mathcal{O}(C)}
            %p
              for the free
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}(C)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Der
                      %mo{:stretchy => "false"} (
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Der(\mathcal{O}(C))
            %p We write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mi f
                      %mo *
                    %mi C
                    %mo ∈
                    %msubsup
                      %mi cdgAlg
                      %mi k
                      %mi op
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi C
                  %annotation{:encoding => "application/x-tex"}
                    T^*_f C \in cdgAlg^{op}_k/_C
            %p for its formal dual.
          .num_defn
            %h6#remark Remark
            %p
              Every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \in \mathcal{O}(C)
              defines a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi S
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %msubsup
                      %mi T
                      %mi f
                      %mo *
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    d S \colon C \to T^*_f C
            %p
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi dgcAlg
                      %mi k
                      %mi op
                  %annotation{:encoding => "application/x-tex"} dgcAlg_k^{op}
              which is dually given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %msub
                      %mi Sym
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Sym
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mover
                      %mi S
                      %mo{:stretchy => "false"} ^
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}(C)
                    \\leftarrow
                    Sym_{\mathcal{O}(C)} Der(\mathcal{O}(C))
                    \\;\colon\;
                    Sym_{\mathcal{O}(C)} [\hat S , -]
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi S
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat S : \mathcal{O}(C) \to \mathcal{O}(C)
              is the
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              and where for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v \in Der(\mathcal{O}(C))
              we set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mover
                      %mi S
                      %mo{:stretchy => "false"} ^
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi v
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [\hat S, v] = v(S)
                    \\,,
            %p
              which may be regarded as the multiplication operator given by the commutator of
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(C)
              as indicated.
          %h3#derived_critical_locus Derived critical locus
          #DerivedCriticalLocusWithFormalCotangentBundle.num_defn
            %h6#definition_3 Definition
            %p
              %strong (derived critical locus)
            %p
              The
              %strong derived critical locus
              of a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S \colon C \to \mathbb{A}^1
              in dgcAlg_k is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi d
                        %mi S
                        %mo =
                        %mn 0
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} C_{\{d S = 0\}}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi cdgAlg
                      %mi op
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi C
                  %annotation{:encoding => "application/x-tex"} cdgAlg^{op}/_{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mrow
                                %mo{:stretchy => "false"} {
                                %mi d
                                %mi S
                                %mo =
                                %mn 0
                                %mo{:stretchy => "false"} }
                          %mtd
                            %mo →
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇙
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mn 0
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi d
                                %mi S
                          %mtd
                            %msubsup
                              %mi T
                              %mi f
                              %mo *
                            %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C_{\{d S = 0\}} &amp;\to&amp; C
                    \\\
                    \\downarrow &amp;\swArrow&amp; \downarrow^{\mathrlap{0}}
                    \\\
                    C &amp;\stackrel{d S}{\to}&amp; T^*_f C
                    }
                    \\,.
          #PresentationByFreeDGCAlegbraOnMappingCone.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong (presentation by free dgc-algebra on mapping cone)
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is smooth in the sense that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} Der(\mathcal{O}(C)) \in \mathcal{O}(C) Mod
              is cofibrant, then the derived critical locus (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DerivedCriticalLocusWithFormalCotangentBundle"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi d
                        %mi S
                        %mo =
                        %mn 0
                        %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Sym
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                    %mrow
                      %mo (
                      %mi Cone
                      %mrow
                        %mo (
                        %mi Der
                        %mo{:stretchy => "false"} (
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mover
                              %mi S
                              %mo{:stretchy => "false"} ^
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ]
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo )
                    %munder
                      %mo ⊗
                      %mrow
                        %msub
                          %mi Sym
                          %mrow
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}(C_{\{d S = 0\}})
                    \\simeq
                    Sym_{\mathcal{O}(C)}
                    \\left(
                    Cone\left(
                    Der(\mathcal{O}(C)) \stackrel{[\hat S , -]}{\to} \mathcal{O}(C)
                    \\right)
                    \\right)
                    \\underset{Sym_{\mathcal{O}(C)}(\mathcal{O}(C))  }{\otimes}
                    \\mathcal{O}(C)
                    \\,,
            %p
              where on the right we have the free
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}(C)
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mover
                      %mi S
                      %mo{:stretchy => "false"} ^
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\hat S, -]
              with
              %a.existingWikiWord{:href => "/nlab/show/extension+of+scalars"} extension of scalars
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mover
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi id
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                      %mi C
                      %mo ×
                      %msup
                        %mi 𝔸
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}( C \overset{(id,0)}{\to} C \times \mathbb{A}^1 )
          .proof
            %h6#proof_2 Proof
            %p
              Using the
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              we may decompose the homotopy pullback into a
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              of two homotopy pullback squares as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mrow
                                %mo{:stretchy => "false"} {
                                %mi d
                                %mi S
                                %mo =
                                %mn 0
                                %mo{:stretchy => "false"} }
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇙
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mn 0
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi id
                                %mo ,
                                %mn 0
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi C
                            %mo ×
                            %msup
                              %mi 𝔸
                              %mn 1
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                          %mtd
                            %msubsup
                              %mi T
                              %mi f
                              %mo *
                            %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C_{\{d S = 0\}} &amp;\longrightarrow&amp; &amp;\longrightarrow&amp; C
                    \\\
                    \\downarrow &amp;\swArrow&amp; \downarrow &amp;\swArrow&amp; \downarrow^{\mathrlap{0}}
                    \\\
                    C
                    \&amp;\underset{(id,0)}{\longrightarrow}&amp;
                    C \times \mathbb{A}^1 &amp;\underset{}{\longrightarrow}&amp; T^*_f C
                    }
                    \\,.
            %p First consider the square on the right:
            %p
              By prop
              %a.maruku-ref{:href => "#SymOCAdjunction"}
              the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sym
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym_{\mathcal{O}(C)}
              is left Quillen. Hence if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Der(\mathcal{O}(C))
              is cofibrant in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(C) Mod
              then the homotopy pushout corresponding to the square on the right may be computed as the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sym
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym_{\mathcal{O}(C)}
              of the homotopy pushout in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}(C) Mod
            %p
              By the disucssion at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-modules"} model structure on dg-modules
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              construction for chain complexes.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Cone
                            %mrow
                              %mo (
                              %mi Der
                              %mo{:stretchy => "false"} (
                              %mi 𝒪
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mover
                                %mo →
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mover
                                    %mi S
                                    %mo{:stretchy => "false"} ^
                                  %mo ,
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} ]
                              %mi 𝒪
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo{:stretchy => "false"} )
                              %mo )
                          %mtd
                            %mo ←
                          %mtd
                            %mi Cone
                            %mrow
                              %mo (
                              %mi Der
                              %mo{:stretchy => "false"} (
                              %mi 𝒪
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mover
                                %mo →
                                %mi Id
                              %mi Der
                              %mo{:stretchy => "false"} (
                              %mi 𝒪
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mover
                                  %mi S
                                  %mo{:stretchy => "false"} ^
                                %mo ,
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} ]
                          %mtd
                            %mi Der
                            %mo{:stretchy => "false"} (
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Cone\left(
                    Der(\mathcal{O}(C)) \stackrel{[\hat S, -]}{\to} \mathcal{O}(C)
                    \\right)
                    \&amp;\leftarrow&amp;
                    Cone\left(
                    Der(\mathcal{O}(C)) \stackrel{Id}{\to} Der(\mathcal{O}(C))
                    \\right)
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    \\mathcal{O}(C)
                    \&amp;\stackrel{[\hat S, -]}{\leftarrow}&amp;
                    Der(\mathcal{O}(C))
                    }
                    \\,.
            %p More in detail, write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mrow
                      %mo (
                      %mi Der
                      %mo{:stretchy => "false"} (
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mi Id
                      %mi Der
                      %mo{:stretchy => "false"} (
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo ∈
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    Cone\left(
