                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"} Cone\left(Der(\mathcal{O}(C)) \stackrel{[\hat S, -]}{\to}  \mathcal{O}(C) \right)
              is
            #eq:TheBVComplex.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
