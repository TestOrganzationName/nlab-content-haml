                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cone(Der(\mathcal{O}(C)) \stackrel{[\hat S, -]}{\to} \mathcal{O}(C))
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mrow
                      %mo [
                      %mover
                        %mi S
                        %mo{:stretchy => "false"} ^
                      %mo +
                      %msub
                        %mi d
                        %mrow
                          %mi 𝒪
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mo −
                      %mo ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d
                    \=
                    \\left[
                    \\hat S
                    +
                    d_{\mathcal{O}(C)}
                    \\;,\;
                    \-
                    \\right]
                    \\,.
            %p
              Here the second term will be the differential of the
              %a.existingWikiWord{:href => "/nlab/show/BRST-complex"} BRST-complex
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔠
                    %annotation{:encoding => "application/x-tex"} \mathfrak{c}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/BRST-BV+complex"} BRST-BV complex
            %p
              For that to happen, however the two copies of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(C)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sym
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym_{\mathcal{O}(C)}(\mathcal{O}(C))
              need to be identified, this is achived by the remaining homotopy pushout corresponding to the square on the left
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mrow
                                %mo{:stretchy => "false"} {
                                %mi d
                                %mi S
                                %mo =
                                %mn 0
                                %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟵
                          %mtd
                            %msub
                              %mi Sym
                              %mrow
                                %mi 𝒪
                                %mo{:stretchy => "false"} (
                                %mi C
                                %mo{:stretchy => "false"} )
                            %mrow
                              %mo (
                              %mi Cone
                              %mrow
                                %mo (
                                %mi Der
                                %mo{:stretchy => "false"} (
                                %mi 𝒪
                                %mo{:stretchy => "false"} (
                                %mi C
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                                %mover
                                  %mo →
                                  %mrow
                                    %mo{:stretchy => "false"} [
                                    %mover
                                      %mi S
                                      %mo{:stretchy => "false"} ^
                                    %mo ,
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} ]
                                %mi 𝒪
                                %mo{:stretchy => "false"} (
                                %mi C
                                %mo{:stretchy => "false"} )
                                %mo )
                              %mo )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟵
                              %mrow
                          %mtd
                            %msub
                              %mi Sym
                              %mrow
                                %mi 𝒪
                                %mo{:stretchy => "false"} (
                                %mi C
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{O}(C_{\{d S = 0\}})
                    \&amp;\longleftarrow&amp;
                    Sym_{\mathcal{O}(C)}
                    \\left(
                    Cone\left(
                    Der(\mathcal{O}(C)) \stackrel{[\hat S, -]}{\to} \mathcal{O}(C)
                    \\right)
                    \\right)
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    \\mathcal{O}(C)
                    \&amp;\underset{}{\longleftarrow}&amp;
                    Sym_{\mathcal{O}(C)}(\mathcal{O}(C))
                    }
                    \\,.
            %p
              Since here the morphism on the right is the pushout of a cofibration, it is itself still a cofibration, and by assumption
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sym
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym_{\mathcal{O}(C)}(\mathcal{O}(C))
              is cofibrant. Therefore this homotopy pushout is given by the ordinary pushout, and that yields the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              as in the claim.
          %h3#ComparisonToBVBRSTExample BV-BRST complex
          %p
            Traditionally the
            %a.existingWikiWord{:href => "/nlab/show/BV-BRST+complex"} BV-BRST complex
            of a
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            is obtained by
          %ol
            %li
              %p
                choosing a
                %a.existingWikiWord{:href => "/nlab/show/Koszul-Tate+complex"} Koszul-Tate complex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi KT
                    %annotation{:encoding => "application/x-tex"} s_{KT}
                resolving the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/shell"} shell
            %li
              %p
                choosing a
                %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi BRST
                    %annotation{:encoding => "application/x-tex"} s_{BRST}
                exhibiting the
                %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge invariance
            %li
              %p
                appealing to
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homological+perturbation+theory"} homological perturbation theory
                %a.existingWikiWord{:href => "/nlab/show/BV-BRST+differential"} BV-BRST differential
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi BV
                      %mo =
                      %msub
                        %mi s
                        %mi KT
                      %mo +
                      %msub
                        %mi s
                        %mi BRST
                      %mo +
                      %mi more
                    %annotation{:encoding => "application/x-tex"}
                      s_{BV} = s_{KT} + s_{BRST} + more
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "BV-BRST+formalism#Henneaux90"} Henneaux 90. around (50)
          %p
            Vie the concept of the derived critical locus this process is systematized: Given just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi BRST
                %annotation{:encoding => "application/x-tex"} s_{BRST}
            and the Lagrangian, both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi KT
                %annotation{:encoding => "application/x-tex"} s_{KT}
            and “more” follows (if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi BRST
                %annotation{:encoding => "application/x-tex"} s_{BRST}
            does capture all the relevant gauge symmetries, that is) and the appearance of the
            %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
            finds its conceptual explanation.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            be a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
            over a space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %msub
                      %mi Sym
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} ⟨
                    %msup
                      %mi c
                      %mi a
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi d
                      %mi 𝔞
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{O}(\mathfrak{a})
                  \\;=\;
                  \\left(
                  Sym_{\mathcal{O}(X)}(\langle c^a\rangle)
                  \\;,\;
                  d_{\mathfrak{a}}
                  \\right)
          %p with differential given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi 𝔞
                  %mspace{:width => "thickmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mi f
                  %mo ↦
                  %msup
                    %mi c
                    %mi a
                  %msubsup
                    %mi R
                    %mi a
                    %mi i
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi i
                  %mi f
                %annotation{:encoding => "application/x-tex"}
                  d_{\mathfrak{a}}
                  \\;:\;
                  f \mapsto c^a R^i_a \frac{\partial}{\partial x^i} f
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi 𝔞
                  %mspace{:width => "thickmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi c
                    %mi a
                  %mo ↦
                  %mfrac
                    %mn 1
                    %mn 2
                  %msup
                    %mi C
                    %mi a
                  %msub
                    %mrow
                    %mrow
                      %mi b
                      %mi c
                  %msup
                    %mi c
                    %mi b
                  %mo ∧
                  %msup
                    %mi c
                    %mi c
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{\mathfrak{a}} \;:\;
                  c^a
                  \\mapsto
                  \\frac{1}{2} C^{a}{}_{b c} c^b \wedge c^c
                  \\,.
          %p
            for functions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in \mathcal{O}(X)
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi R
                      %mi a
                      %mi i
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mi i
                  %annotation{:encoding => "application/x-tex"} R^i_a \frac{\partial}{\partial x^i}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi a
                  %msub
                    %mrow
                    %mrow
                      %mi b
                      %mi c
                %annotation{:encoding => "application/x-tex"} C^{a}{}_{b c}
            and
            %a.existingWikiWord{:href => "/nlab/show/ghost"} ghost
            generators
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi c
                      %mi a
                  %annotation{:encoding => "application/x-tex"} c^a
          %p
            The “algebra of vector fields/
            %a.existingWikiWord{:href => "/nlab/show/derivations"}> derivations
            ”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Der
                  %mo{:stretchy => "false"} (
                  %mi 𝒪
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Der(\mathcal{O}(\mathfrak{a}))
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            is the
            %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-Lie+algebra"} automorphism ∞-Lie algebra
            whose underlying cochain complex is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mrow
                            %mo ⟨
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %msup
                                  %mi c
                                  %mi a
                            %mo ⟩
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi d
                                %mi 𝔞
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} ]
                        %mtd
                          %mrow
                            %mo ⟨
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %msup
                                  %mi x
                                  %mi i
                            %mo ⟩
                          %mo ⊕
                          %mrow
                            %mo ⟨
                            %msup
                              %mi c
                              %mi a
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %msup
                                  %mi c
                                  %mi b
                            %mo ⟩
                      %mtr
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                        %mtd
                        %mtd
                          %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\left\langle
                  \\frac{\partial}{\partial c^a}
                  \\right\rangle
                  \&amp;
                  \\overset{[d_{\mathfrak{a}}, -]}{\to}
                  \&amp;
                  \\left\langle
                  \\frac{\partial}{\partial x^i}
                  \\right\rangle
                  \\oplus
                  \\left\langle
                  c^a \frac{\partial}{\partial c^b}
                  \\right\rangle
                  \\\
                  \-1 &amp;&amp; 0
                  }
                  \\,.
          %p We check on generators that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mrow
                            %mo [
                            %msub
                              %mi d
                              %mi 𝔞
                            %mo ,
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %msup
                                  %mi c
                                  %mi a
                            %mo ]
                          %mo =
                          %msubsup
                            %mi R
                            %mi a
                            %mi i
                          %mfrac
                            %mo ∂
                            %mrow
                              %mo ∂
                              %msup
                                %mi x
                                %mi i
                          %mo +
                          %msup
                            %mi C
                            %mi b
                          %msub
                            %mrow
                            %mrow
                              %mi a
                              %mi c
                          %msup
                            %mi c
                            %mi c
                          %mfrac
                            %mo ∂
                            %mrow
                              %mo ∂
                              %msup
                                %mi c
                                %mi b
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\left[d_{\mathfrak{a}}, \frac{\partial}{\partial c^a} \right]
                  \=
                  R_a^i \frac{\partial}{\partial x^i}
                  +
                  C^b{}_{a c} c^c \frac{\partial}{\partial c^b}
                  \\end{aligned}
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mrow
                            %mo [
                            %msub
                              %mi d
                              %mi 𝔞
                            %mo ,
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %msup
                                  %mi x
                                  %mi i
                            %mo ]
                          %mo =
                          %msup
                            %mi c
                            %mi a
                          %mfrac
                            %mrow
                              %mo ∂
                              %msubsup
                                %mi R
                                %mi a
                                %mi j
                            %mrow
                              %mo ∂
                              %msup
                                %mi x
                                %mi i
                          %mfrac
                            %mo ∂
                            %mrow
                              %mo ∂
                              %msup
                                %mi x
                                %mi j
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\left[
                  d_{\mathfrak{a}}, \frac{\partial}{\partial x^i}
                  \\right]
                  \=
                  c^a \frac{\partial R_a^j}{\partial x^i} \frac{\partial}{\partial x^j}
                  \\end{aligned}
                  \\,.
          %p Now let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi 𝔞
                  %mo ⟶
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  S \;\colon\; \mathfrak{a} \longrightarrow \mathbb{R}
          %p be a morphism, dually a dgc-algebra homomorphism of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo ⟵
                  %mi 𝒪
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi S
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{O}(\mathfrak{a})
                  \\longleftarrow
                  \\mathcal{O}(\mathbb{R})
                  \\;\colon\;
                  S^*
                  \\,.
          %p This is equivalently a function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo ⟶
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  S \;\colon\; X \longrightarrow \mathbb{R}
          %p
            which is
            %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge invariant
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi d
                            %mi 𝔞
                          %mi S
                        %mtd
                          %mo =
                          %msup
                            %mi c
                            %mi a
                          %msubsup
                            %mi R
                            %mi a
                            %mi i
                          %mfrac
                            %mo ∂
                            %mrow
                              %mo ∂
                              %msup
                                %mi x
                                %mi i
                          %mi S
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  d_{\mathfrak{a}} S
                  \&amp; =
                  c^a R_a^i \frac{\partial}{\partial x^i} S
                  \\\
                  \&amp; = 0
                  \\end{aligned}
                  \\,.
          %p
            We have a contraction homomorphism of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(\mathfrak{a})
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mrow
                      %mi d
                      %mi S
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Der
                  %mo{:stretchy => "false"} (
                  %mi 𝒪
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi 𝒪
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\iota_{d S}
                  \\;\colon\;
                  Der(\mathcal{O}(\mathfrak{a}))
                  \\longrightarrow
                  \\mathcal{O}(\mathfrak{a})
                  \\,.
          %p
            and may form its
            %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
            %a.maruku-eqref{:href => "#eq:TheBVComplex"} (1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mrow
                            %mo ⟨
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %msup
                                  %mi c
                                  %mi a
                            %mo ⟩
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi d
                                %mi 𝔞
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} ]
                        %mtd
                          %mrow
                            %mo ⟨
                            %msup
                              %mi c
                              %mi a
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %msup
                                  %mi c
                                  %mi b
                            %mo ⟩
                          %mo ⊕
                          %mrow
                            %mo ⟨
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %msup
                                  %mi x
                                  %mi i
                            %mo ⟩
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi ι
                                  %mrow
                                    %mi d
                                    %mi S
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi 𝒪
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi d
                                %mi 𝔞
                        %mtd
                          %mrow
                            %mo ⟨
                            %msup
                              %mi c
                              %mi a
                            %mo ⟩
                      %mtr
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 2
                        %mtd
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                        %mtd
                        %mtd
                          %mn 0
                        %mtd
                        %mtd
                          %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\left\langle
                  \\frac{\partial}{\partial c^a}
                  \\right\rangle
                  \&amp;\stackrel{[d_{\mathfrak{a}}, -]}{\longrightarrow}&amp;
                  \\left\langle
                  c^a \frac{\partial}{\partial c^b}
                  \\right\rangle
                  \\oplus
                  \\left\langle
                  \\frac{\partial}{\partial x^i}
                  \\right\rangle
                  \\\
                  \&amp;&amp;
                  \&amp;\searrow^{\mathrlap{\iota_{d S}}}&amp;
                  \\\
                  \&amp;&amp;
                  \&amp;&amp;
                  \\mathcal{O}(X)
                  \&amp;\stackrel{d_{\mathfrak{a}}}{\to}&amp;
                  \\left\langle
                  c^a
                  \\right\rangle
                  \\\
                  \-2 &amp;&amp; -1 &amp;&amp; 0 &amp;&amp; 1
                  }
                  \\,.
          %p On the free algebra of this
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sym
                    %mrow
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mrow
                    %mo (
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ι
                          %mrow
                            %mi d
                            %mi S
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mo{:stretchy => "false"} ⟨
                    %msup
                      %mi c
                      %mi a
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  Sym_{\mathcal{O}(X)}
                  \\left(
                  Der(\mathcal{O}(\mathfrak{a}))[-1] \stackrel{\iota_{d S}}{\to} \mathcal{O}(X)\oplus \langle c^a\rangle)
                  \\right)
          %p we have the differential given on generators by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi c
                        %mi a
                  %mo ↦
                  %msubsup
                    %mi R
                    %mi a
                    %mi i
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi i
                  %mo +
                  %msup
                    %mi C
                    %mi b
                  %msub
                    %mrow
                    %mrow
                      %mi a
                      %mi c
                  %msup
                    %mi c
                    %mi c
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi c
                        %mi b
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\partial}{\partial c^a}
                  \\mapsto
                  R_a^i \frac{\partial}{\partial x^i} + C^b{}_{a c} c^c
                  \\frac{\partial}{\partial c^b}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi i
                  %mo ↦
                  %mfrac
                    %mrow
                      %mo ∂
                      %mi S
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi i
                  %mo +
                  %msup
                    %mi c
                    %mi a
                  %mfrac
                    %mrow
                      %mo ∂
                      %msubsup
                        %mi R
                        %mi a
                        %mi j
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi i
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi j
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\partial}{\partial x^i} \mapsto \frac{\partial S}{\partial x^i}
                  +
                  c^a \frac{\partial R_a^j}{\partial x^i} \frac{\partial}{\partial x^j}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mi i
                  %mo ↦
                  %msup
                    %mi c
                    %mi a
                  %msubsup
                    %mi R
                    %mi a
                    %mi i
                %annotation{:encoding => "application/x-tex"}
                  x^i \mapsto c^a R_a^i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi c
                    %mi a
                  %mo ↦
                  %mfrac
                    %mn 1
                    %mn 2
                  %msup
                    %mi C
                    %mi a
                  %msub
                    %mrow
                    %mrow
                      %mi b
                      %mi c
                  %msup
                    %mi c
                    %mi b
                  %mo ∧
                  %msup
                    %mi c
                    %mi c
                %annotation{:encoding => "application/x-tex"}
                  c^a \mapsto \frac{1}{2}C^a{}_{b c} c^b \wedge c^c
          %p
            and similarly after tensoring in order to identify the extra copy of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{O}(X)
            with the base
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(X)
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi R
                    %mi a
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle R_a\rangle
            is the full kernel of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mrow
                      %mi d
                      %mi S
                  %mo :
                  %mi Der
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \iota_{d S} : Der(C^\infty(X)) \to C^\infty(X)
            and there are no further relations, then this is the full
            %a.existingWikiWord{:href => "/nlab/show/BRST-BV+complex"} BRST-BV complex
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
