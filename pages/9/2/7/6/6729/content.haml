                                  %mi d
                                  %mrow
                                    %mi 𝒪
                                    %mo{:stretchy => "false"} (
                                    %mi C
                                    %mo{:stretchy => "false"} )
                                %mo ,
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} ]
                          %mtd
                            %mi Der
                            %mo{:stretchy => "false"} (
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} )
