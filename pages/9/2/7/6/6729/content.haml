                      %annotation{:encoding => "application/x-tex"} cdgAlg_k
                  (
                  %a{:href => "model+structure+on+dg-algebras#PathObjectsForUnboundedCommutative"}> here
                  ) this can be taken to be
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo ⊗
                            %mi k
                          %msubsup
                            %mi Ω
