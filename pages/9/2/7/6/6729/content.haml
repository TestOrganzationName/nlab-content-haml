                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo ⊕
                          %mtd
                            %msup
                              %mo ↘
                              %mrow
                                %mo ±
                                %mpadded{:width => "0"}
                                  %mi Id
                          %mtd
                            %mo ⊕
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mi Der
                            %mo{:stretchy => "false"} (
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
