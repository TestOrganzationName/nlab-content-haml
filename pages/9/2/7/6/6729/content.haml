                    \\right)
                    \\in
                    \\mathcal{O}(C) Mod
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              on the identity:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mi Der
                            %mo{:stretchy => "false"} (
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi k
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} [
                                %msub
                                  %mi d
                                  %mrow
                                    %mi 𝒪
                                    %mo{:stretchy => "false"} (
