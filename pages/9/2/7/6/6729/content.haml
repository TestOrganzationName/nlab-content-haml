            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mrow
                      %mo (
                      %mi Der
                      %mo{:stretchy => "false"} (
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mover
                            %mi S
