                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} /
                              %mrow
                                %msub
                                  %mi cdgAlg
                                  %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    cdgAlg_{\mathcal{O}(C)}
                    \&amp; \coloneqq
                    CMon(\mathcal{O}(C) Mod)
                    \\\
                    \&amp; \simeq
                    \\mathcal{O}(C)/_{cdgAlg_k}
                    \\end{aligned}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/category+of+monoids"} category of commutative monoids
              in
              = succeed "-modules," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}(C)
              %a.existingWikiWord{:href => "/nlab/show/coslice+category"} coslice category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi cdgAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} cdgAlg_k
              under
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}(C)
          #SymOCAdjunction.num_prop
            %h6#proposition Proposition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi cdgAlg
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cdgAlg_{\mathcal{O}(C)}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OCDGCAlgebras"}
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}(C)
              %a.existingWikiWord{:href => "/nlab/show/free-forgetful+adjunction"} free-forgetful adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi cdgAlg
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi U
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi Sym
                            %mrow
                              %mi 𝒪
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo{:stretchy => "false"} )
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    cdgAlg_{\mathcal{O}(C)}
                    \\underoverset
                    {\underset{U}{\longrightarrow}}
                    {\overset{Sym_{\mathcal{O}(C)}}{\longleftarrow}}
                    {\bot}
                    \\mathcal{O}(C) Mod
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            %p This is
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"}> combinatorial
                  ;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/proper+model+category"}> proper
                  \.
          .proof
            %h6#proof Proof
            %p
              This follows with the general discussion at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/dg-geometry"} dg-geometry
            %p
              We observe that the adjunction exhibits the
              %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
              on the left. By the statement discussed there, it is sufficient to check that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mi Mod
                      %annotation{:encoding => "application/x-tex"} \mathcal{O}(C) Mod
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
                %p
                  This follows because the
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-modules"} model structure on dg-modules
                  (as discussed there) is itself transferred along
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ′
                        %mo{:lspace => "verythinmathspace"} :
                        %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mi Mod
                        %mo →
                        %msup
                          %mi Ch
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        U' \colon \mathcal{O}(C) Mod \to Ch^\bullet(k)
                %p
                  from the cofibrantly generated
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+chain+complexes"} model structure on cochain complexes
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  preserves
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/filtered+colimits"} filtered colimits
                %p
                  This follows from the general fact
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo :
                        %mi CMon
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} U : CMon(\mathcal{C}) \to \mathcal{C}
                  creates filtered colimits for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  closed symmetric monoidal (see
                  = succeed ")" do
                    %a{:href => "category+of+monoids#FilteredColimits"} there
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mi Mod
                      %annotation{:encoding => "application/x-tex"} A Mod
                  is
                  %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
                  (see
                  = succeed ")." do
                    %a{:href => "model+structure+on+dg-modules#Properties"} there
                %p To check this explicitly:
                %p
                  Let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mo •
                        %mo{:lspace => "verythinmathspace"} :
                        %mi D
                        %mo →
                        %msub
                          %mi cdgAlg
                          %mi k
                      %annotation{:encoding => "application/x-tex"} A_\bullet \colon D \to cdgAlg_k
                  be a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/filtered+category"} filtered diagram
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi lim
                          %mo →
                        %mi U
                        %msub
                          %mi A
                          %mo •
                      %annotation{:encoding => "application/x-tex"} \lim_\to U A_\bullet
                  to a dg-algebra cocone: for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %msub
                          %mi A
                          %mi i
                        %mo →
                        %msub
                          %mi lim
                          %mo →
                        %mi U
                        %msub
                          %mi A
                          %mo •
                      %annotation{:encoding => "application/x-tex"} a \in A_i \to \lim_\to U A_\bullet
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %msub
                          %mi A
                          %mi j
                        %mo →
                        %msub
                          %mi lim
                          %mo →
                        %mi U
                        %msub
                          %mi A
                          %mo •
                      %annotation{:encoding => "application/x-tex"} b \in A_j \to \lim_\to U A_\bullet
                  there is by the assumption that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  is filtered a
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mi i
                          %mo →
                          %msub
                            %mi A
                            %mi l
                          %mo ←
                          %msub
                            %mi A
                            %mi j
                        %annotation{:encoding => "application/x-tex"} A_i \to A_l \leftarrow A_j
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %msub
                          %mi A
                          %mi l
                        %mo →
                        %msub
                          %mi lim
                          %mo →
                        %mi U
                        %msub
                          %mi A
                          %mo •
                      %annotation{:encoding => "application/x-tex"} U A_l \to \lim_{\to} U A_\bullet
                  to be an algebra homomorphism the product of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi lim
                          %mo →
                        %mi U
                        %msub
                          %mi A
                          %mo •
                      %annotation{:encoding => "application/x-tex"} \lim_\to U A_\bullet
                  has to be the image of this product in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mi l
                        %annotation{:encoding => "application/x-tex"} A_l
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mi l
                          %mo →
                          %msub
                            %mi lim
                            %mo →
                          %msub
                            %mi A
                            %mo •
                        %annotation{:encoding => "application/x-tex"} A_l \to \lim_\to A_\bullet
              %li
                %p
                  The left hand has functorial fibrant replacement (this is trivial, since every object is fibrant) and functorial
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/path+objects"} path objects
                %p
                  This follows by the same argument as for the path object in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
