                      %mi T
                      %msup
                        %mi Δ
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi ι
                        %mi v
                      %msub
                        %mi F
                        %mi A
                      %mo =
                      %mn 0
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\mathfrak{g})_{conn}(U)
                    \:
                    [k]
                    \\mapsto
                    \\left\{
                    \\Omega^\bullet_{si}(U \times \Delta^k)
                    \\stackrel{A}{\leftarrow}
                    W(\mathfrak{g})
                    \\;\;
                    |
                    \\;\;
                    \\forall v \in \Gamma(T \Delta^k) : \iota_v F_A = 0
                    \\right\}
          %p
            Here on the right we have in each case the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %a.existingWikiWord{:href => "/nlab/show/dgAlg"} dgAlg
            that make
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            %a.existingWikiWord{:href => "/nlab/show/dgAlg"} dgAlg
            as indicated, with the vertical morphisms being the canonical projections and inclusions. The functoriality in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi K
                  %mo →
                  %mi U
                %annotation{:encoding => "application/x-tex"} f : K \to U
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi l
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \rho : [k] \to [l]
            is by the evident precomposition with the pullback of differential forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ×
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi id
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo ×
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(U \times \Delta^k) \stackrel{(f,id)^*}{\to} \Omega^\bullet(K \times \Delta^k)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi l
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi id
                        %mo ,
                        %mi ρ
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(U \times \Delta^l) \stackrel{(id,\rho)^*}{\leftarrow} \Omega^\bullet(U, \times \Delta^k)
          #SequenceOfInclusionsOfCoefficients.un_prop
            %h6#proposition Proposition
            %p
              There are canonical morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [CartSp_{smooth}^{op},sSet]
              between these objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                          %mtd
                            %mo ↪
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi ChW
                          %mtd
                            %mo ↪
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi diff
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\exp(\mathfrak{g})_{conn}
                    \&amp;\hookrightarrow&amp;
                    \\exp(\mathfrak{g})_{ChW}
                    \&amp;\hookrightarrow&amp;
                    \\exp(\mathfrak{g})_{diff}
                    \\\
                    \&amp;&amp; &amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; &amp;&amp; \exp(\mathfrak{g})
                    }
                    \\,,
            %p
              where the horizontal morphisms are
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              and the vertical morphism is over each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} U \in CartSp
              an equivalence of
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              (it is a weak equivalence between fibrant objects in the projective
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
          .proof
            %h6#proof Proof
            %p
              The inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ChW
                    %mo ↪
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi dff
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_{ChW} \hookrightarrow \exp(\mathfrak{g})_{dff}
              is clear. The weak equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                    %mo →
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_{diff} \to \exp(\mathfrak{g})
              is discussed at
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              (but is also directly verified).
            %p
              To see the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mo ↪
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ChW
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_{conn} \hookrightarrow \exp(\mathfrak{g})_{ChW}
              we need to check that the horizonality condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi v
                    %msub
                      %mi F
                      %mi A
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \iota_v F_A = 0
              on the
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              of a
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              for all
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              tangent to the simplex implies that all the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle F_A\rangle
              are
              %em basic forms
              that “descend to
              = succeed "\u201D," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msubsup
                        %mi Ω
                        %mi si
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ×
                      %msup
                        %mi Δ
                        %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^\bullet(U) \to \Omega^\bullet_{si}(U \times \Delta^k)
            %p
              For this it is sufficient to show that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v \in \Gamma(T \Delta^k)
              we have
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi ι
                          %mi v
                        %mo{:stretchy => "false"} ⟨
                        %msub
                          %mi F
                          %mi A
                        %mo{:stretchy => "false"} ⟩
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \iota_v \langle F_A \rangle = 0
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℒ
                          %mi v
                        %mo{:stretchy => "false"} ⟨
                        %msub
                          %mi F
                          %mi A
                        %mo{:stretchy => "false"} ⟩
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \mathcal{L}_v \langle F_A \rangle = 0
            %p
              where in the second line we have the
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mi v
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}_v
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
            %p
              The first condition is evidently satisfied if already
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mi v
                      %msub
                        %mi F
                        %mi A
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \iota_v F_A = 0
              %a.existingWikiWord{:href => "/nlab/show/Cartan+calculus"} Cartan calculus
              and using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi dR
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d_{dR} \langle F_A\rangle = 0
              (which holds as a consequence of the definition of
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mi v
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi d
                    %msub
                      %mi ι
                      %mi v
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %msub
                      %mi ι
                      %mi v
                    %mi d
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}_v \langle F_A \rangle =
                    d \iota_v \langle F_A \rangle
                    +
                    \\iota_v d \langle F_A \rangle
                    \= 0
                    \\,.
          .un_lemma
            %h6#remark Remark
            %p
              For a general
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              the
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi A
                  %annotation{:encoding => "application/x-tex"} F_A
              themselves are not necessarily closed (rather they satisfy the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
              = succeed "s:" do
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi cosk
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo :
                  %mi sSet
                  %mo →
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} \mathbf{cosk}_{n+1} : sSet \to sSet
            be the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+coskeleton"} simplicial coskeleton
            functor. Its prolongation to simplicial presheaves we denote here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
