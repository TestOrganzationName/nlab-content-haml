            %h6#remark_3 Remark
            %p
              In full
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory+in+Smooth%E2%88%9EGrpd"} Chern-Weil theory in Smooth∞Grpd
              the fundamental object of interest is really
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_{diff}
              – the object of
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/pseudo-connection"} pseudo-connection
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctor"} ∞-anafunctor
              out of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})
              that presents the differential characteristic classes on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})
            %p
              This distinction is important: over objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} X \in
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              that are not
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
              = succeed "-connections" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
