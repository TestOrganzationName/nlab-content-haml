                                  %mo{:stretchy => "false"} ⟨
                                  %msub
                                    %mi F
                                    %mi A
                                  %mo{:stretchy => "false"} ⟩
                            %mtd
                              %mi inv
                              %mo{:stretchy => "false"} (
                              %mi 𝔤
                              %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\mathfrak{g})_{ChW}
                    \:
                    (U,[k])
                    \\mapsto
                    \\left\{
                    \\array{
                    \\Omega^\bullet_{si,vert}(U \times\Delta^k)
                    \&amp;\stackrel{A_{vert}}{\leftarrow}&amp;
                    CE(\mathfrak{g})
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    \\Omega^\bullet_{si}(U \times \Delta^k)
                    \&amp;\stackrel{A}{\leftarrow}&amp;
                    W(\mathfrak{g})
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    \\Omega^\bullet(U)
                    \&amp;\stackrel{\langle F_A\rangle}{\leftarrow}&amp;
                    inv(\mathfrak{g})
                    }
                    \\right\}
                    \\,.
            %p
              Define the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_{conn}
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mrow
                      %mo {
                      %msubsup
                        %mi Ω
                        %mi si
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ×
                      %msup
                        %mi Δ
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ←
                        %mi A
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ∀
                      %mi v
                      %mo ∈
                      %mi Γ
