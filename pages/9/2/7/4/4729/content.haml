                    \\array{
                    CE(\mathfrak{g}) &amp;\simeq&amp; \Omega^\bullet_{li \atop cl}(G)
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    W(\mathfrak{g}) &amp;\simeq &amp; \Omega^\bullet(\mathbf{E}G_{conn}) &amp; \simeq &amp; \Omega^\bullet(\mathbf{\Omega}(-,\mathfrak{g}))
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    inv(\mathfrak{g})
                    \&amp;\simeq&amp;
                    \\Omega^\bullet(\mathbf{B}G_{conn})
                    \&amp; \simeq &amp;
                    \\Omega^\bullet(\mathbf{\Omega}(-,\mathfrak{g})/G)
                    }
          %p
            We discuss now connections on those
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} G \in
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            is an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+group"} smooth ∞-group
            that arises from
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            of an
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mo ∈
                  %msub
                    %mi L
                    %mn ∞
                  %mover
                    %mo ↪
                    %mi CE
                %annotation{:encoding => "application/x-tex"} \mathfrak{g} \in L_\infty \stackrel{CE}{\hookrightarrow}
            %a.existingWikiWord{:href => "/nlab/show/dgAlg"} dgAlg
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                    %mi op
                %annotation{:encoding => "application/x-tex"} {}^{op}
            be an
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            over the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
            with
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
            and
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi dgAlg
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(X) \in dgAlg
            for the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
            of smooth
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi k
                %annotation{:encoding => "application/x-tex"} \Delta^k
            be the standard
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            regarded as a smooth
            %a.existingWikiWord{:href => "/nlab/show/manifold+with+corners"} manifold with corners
            in the standard way. Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi si
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{si}(X \times \Delta^k)
            for the sub-
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            of differential forms with sitting instants perpendicular to the boundary of the simplex, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mrow
                      %mi si
                      %mo ,
                      %mi vert
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{si,vert}(X\times \Delta^k)
            for the further sub-dg-algebra of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/vertical+differential+form"} vertical differential form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \times \Delta^k \to X
          .un_defn
            %h6#definition_2 Definition
            %p A morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(X)
                    \\leftarrow
                    W(\mathfrak{g})
                    \:
                    A
            %p
              in
              %a.existingWikiWord{:href => "/nlab/show/dgAlg"} dgAlg
              we call an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+valued+differential+forms"} L-∞ algebra valued differential form
              with values in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo :
                    %mi T
                    %mi X
                    %mo →
                    %mi inn
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A : T X \to inn(\mathfrak{g})
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
              to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} inner automorphism ∞-Lie algebra
            %p
              Its
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              is the composite of morphisms of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mi A
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %msub
                      %mi F
                      %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(X) \stackrel{A}{\leftarrow}
                    W(\mathfrak{g})
                    \\stackrel{F_{(-)}}{\leftarrow}
                    \\mathfrak{g}^*[2]
                    \:
                    F_{A}
            %p
              that injects the shifted generators into the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            %p
              Precisely if the curvatures vanish does the morphism factor through the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi A
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi CE
                              %mo{:stretchy => "false"} (
                              %mi 𝔤
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∃
                                    %msub
                                      %mi A
                                      %mi flat
                              %mo ↙
                            %mtd
                              %mo{:stretchy => "false"} ↑
                          %mtr
                            %mtd
                              %msup
                                %mi Ω
                                %mo •
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ←
                                %mi A
                            %mtd
                              %mi W
                              %mo{:stretchy => "false"} (
                              %mi 𝔤
                              %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    (F_A = 0)
                    \\;\;\Leftrightarrow
                    \\;\;
                    \\left(
                    \\array{
                    \&amp;&amp; CE(\mathfrak{g})
                    \\\
                    \&amp; {}^{\mathllap{\exists A_{flat}}}\swarrow &amp; \uparrow
                    \\\
                    \\Omega^\bullet(X) &amp;\stackrel{A}{\leftarrow}&amp; W(\mathfrak{g})
                    }
                    \\right)
            %p
              in which case we call
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %strong flat
            %p
              The
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              are the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mi A
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %msub
                          %mi F
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ⟩
                    %mi inv
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(X)
                    \\stackrel{A}{\leftarrow}
                    W(\mathfrak{g})
                    \\stackrel{\langle F_{(-)} \rangle}{\leftarrow}
                    inv(\mathfrak{g})
                    \:
                    \\langle F_A\rangle
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inv
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} inv(\mathfrak{g}) \to W(\mathfrak{g})
              is the inclusion of the
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
          %p
            We define now
            %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
            over the
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi smooth
                  %mo ↪
                %annotation{:encoding => "application/x-tex"} {}_{smooth} \hookrightarrow
            %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
          .un_defn
            %h6#definition_3 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g}) \in [CartSp_{smooth}^{op}, sSet]
              for the simplicial presheaf given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mrow
                      %mo {
                      %msubsup
                        %mi Ω
                        %mrow
                          %mi si
                          %mo ,
                          %mi vert
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ×
                      %msup
                        %mi Δ
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi A
                            %mi vert
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\mathfrak{g}) :
                    (U,[k])
                    \\mapsto
                    \\left\{
                    \\Omega^\bullet_{si,vert}(U \times\Delta^k)
                    \\stackrel{A_{vert}}{\leftarrow}
                    CE(\mathfrak{g})
                    \\right\}
            %p
              (the untruncated
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_{diff} \in [CartSp_{smooth}^{op}, sSet]
              for the simplicial presheaf given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msubsup
                                %mi Ω
                                %mrow
                                  %mi si
                                  %mo ,
                                  %mi vert
                                %mo •
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo ×
                              %msup
                                %mi Δ
                                %mi k
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ←
                                %mrow
                                  %msub
                                    %mi A
                                    %mi vert
                            %mtd
                              %mi CE
                              %mo{:stretchy => "false"} (
                              %mi 𝔤
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↑
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↑
                          %mtr
                            %mtd
                              %msubsup
                                %mi Ω
                                %mi si
                                %mo •
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo ×
                              %msup
                                %mi Δ
                                %mi k
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ←
                                %mi A
                            %mtd
                              %mi W
                              %mo{:stretchy => "false"} (
                              %mi 𝔤
                              %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\mathfrak{g})_{diff} :
                    (U,[k])
                    \\mapsto
                    \\left\{
                    \\array{
                    \\Omega^\bullet_{si,vert}(U \times\Delta^k)
                    \&amp;\stackrel{A_{vert}}{\leftarrow}&amp;
                    CE(\mathfrak{g})
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    \\Omega^\bullet_{si}(U \times \Delta^k)
                    \&amp;\stackrel{A}{\leftarrow}&amp;
                    W(\mathfrak{g})
                    }
                    \\right\}
                    \\,.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ChW
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_{ChW} \in [CartSp_{smooth}^{op}, sSet]
              for the simplicial presheaf given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ChW
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msubsup
                                %mi Ω
                                %mrow
                                  %mi si
                                  %mo ,
                                  %mi vert
                                %mo •
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo ×
                              %msup
                                %mi Δ
                                %mi k
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ←
                                %mrow
                                  %msub
                                    %mi A
                                    %mi vert
                            %mtd
                              %mi CE
                              %mo{:stretchy => "false"} (
                              %mi 𝔤
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↑
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↑
                          %mtr
                            %mtd
                              %msubsup
                                %mi Ω
                                %mi si
                                %mo •
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo ×
                              %msup
                                %mi Δ
                                %mi k
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ←
                                %mi A
