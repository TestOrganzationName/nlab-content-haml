                  %msubsup
                    %mi CartSp
                    %mi smooth
                    %mi op
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\tau_n \exp(\mathfrak{g}) \in [CartSp_{smooth}^{op}, sSet]
          %p
