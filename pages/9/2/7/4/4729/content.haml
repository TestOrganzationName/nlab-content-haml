                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              do
              %em not
              exhaust all nonabelian differential cocycles. This just means that not every differential class in this case does have a nice representative.
          %h2#examples Examples
          %h3#InfGaugeTrafo 1-Morphisms: integration of infinitesimal gauge transformations
          %p
            The 1-
            %a.existingWikiWord{:href => "/nlab/show/morphism"}> morphism
            s in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_{conn}(U)
            may be thought of as
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          .un_defn
            %h6#definition_5 Definition
            %p
              Given a 1-morphism in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})(X)
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(U \times \Delta^1)
                    \\leftarrow
                    W(\mathfrak{g})
                    \:
                    A
            %p consider the unique decomposition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msub
                      %mi A
                      %mi U
                    %mo +
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi vert
                    %mo :
                    %mo =
                    %mi λ
                    %mo ∧
                    %mi d
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A = A_U + ( A_{vert} := \lambda \wedge d s)  \; \;
                    \\,,
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi U
                  %annotation{:encoding => "application/x-tex"} A_U
              the horizonal differential form component and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %msup
                      %mi Δ
                      %mn 1
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} s : \Delta^1 = [0,1] \to \mathbb{R}
              the canonical
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coordinate"} coordinate
            %p
              We call
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              the
              %strong gauge parameter
              \. This is a function on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Delta^1
              with values in 0-forms on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              an ordinary
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+2-algebra"} Lie 2-algebra
          %p We describe now how this enccodes a gauge transformation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo :
                  %msub
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                  %msub
                    %mi A
                    %mi U
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo =
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\lambda : A_0(s=0) \stackrel{}{\to} A_U(s = 1)
                  \\,.
          .un_lemma
            %h6#observation Observation
            %p We have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi s
                    %msub
                      %mi A
                      %mi U
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi U
                    %mi λ
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi λ
                    %mo ∧
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi λ
                    %mo ∧
                    %mi A
                    %mo ∧
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                    %mo +
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi s
                    %msub
                      %mi F
                      %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{d}{d s} A_U
                    \=
                    (d_U \lambda + [\lambda \wedge A] + [\lambda \wedge A \wedge A] + \cdots)
                    +
                    \\iota_{\partial_s} F_A
                    \\,,
            %p
              where the sum is over all higher brackets of the
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          .proof
            %h6#proof_2 Proof
            %p
              This is the result of applying the contraction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %mo ∂
                        %mi s
                  %annotation{:encoding => "application/x-tex"} \iota_{\partial s}
              to the defining equation for the
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi A
                  %annotation{:encoding => "application/x-tex"} F_A
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              using the nature of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi A
                    %mo =
                    %msub
                      %mi d
                      %mi dR
                    %mi A
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ∧
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ∧
                    %mi A
                    %mo ∧
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    F_A = d_{dR} A + [A \wedge A] + [A \wedge A \wedge A] + \cdots
            %p
              and inserting the above decomposition for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          .un_def
            %h6#definition_6 Definition
            %p
              Define the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
                of the gauge parameter
              to be
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mi A
                    %mi λ
                    %mo :
                    %mo =
                    %mi d
                    %mi λ
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ∧
                    %mi λ
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ∧
                    %mi A
                    %mo ∧
                    %mi λ
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\nabla_A \lambda := d \lambda + [A \wedge \lambda] + [A \wedge A \wedge \lambda] + \cdots
                    \\,.
          %p In this notation we have
          %ul
            %li
              %p the general identity
              #eq:ShiftedGaugeTrafo.maruku-equation
                %span.maruku-eq-number (1)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mi d
                        %mrow
                          %mi d
                          %mi s
                      %msub
                        %mi A
                        %mi U
                      %mo =
                      %mo ∇
                      %mi λ
                      %mo +
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi F
                        %mi A
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi s
                    %annotation{:encoding => "application/x-tex"}
                      \\frac{d}{d s} A_U = \nabla \lambda + (F_A)_s
            %li
              %p
                the
                %strong horizontality
                or
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/rheonomy"} rheonomy
                constraint or
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"} second Ehresmann condition
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ι
                          %mrow
                            %msub
                              %mo ∂
                              %mi s
                        %msub
                          %mi F
                          %mi A
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \iota_{\partial_s} F_A = 0
                %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              #eq:GaugeTrafo.maruku-equation
                %span.maruku-eq-number (2)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mi d
                        %mrow
                          %mi d
                          %mi s
                      %msub
                        %mi A
                        %mi U
                      %mo =
                      %mo ∇
                      %mi λ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\frac{d}{d s} A_U = \nabla \lambda
                      
                      \\,.
          %p
            This is known as the equation for
            %strong
              infinitesimal
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            of an
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          .un_lemma
            %h6#observation_2 Observation
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi vert
                  %annotation{:encoding => "application/x-tex"} A_{vert}
              – and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              – defines an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(\lambda)
              in the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+group"} ∞-Lie group
              that integrates
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %p
              The unique solution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi U
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_U(s = 1)
              of the above
              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} s = 1
              for the initial values
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi U
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_U(s = 0)
              we may think of as the result of acting on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi U
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_U(0)
              with the gauge transformation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exp(\lambda)
          %h3#ordinary_connections_on_principal_1bundles Ordinary connections on principal 1-bundles
          .un_prop
            %h6#proposition_2 Proposition
            %p
              %strong (connections on ordinary bundles)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              with simply connected
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn}
              the
              %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie+algebra-valued+forms"} groupoid of Lie algebra-valued forms
              we have an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 1
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_1 \exp(\mathfrak{g})_{conn} \simeq \mathbf{B}G_{conn}
            %p
              betweenn the 1-truncated coefficient object for
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              = succeed "-connections" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/connections+on+a+bundle"} connections on a bundle
              (see there).
          .proof
            %h6#proof_3 Proof
            %p
              Notice that the sheaves of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^1(-,\mathfrak{g})
            %p
              On
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %a{:href => "#InfinitesimalGaugeTransformations"} above
              for a form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(U \times \Delta^1) \leftarrow W(\mathfrak{g}) : A
              decomposed into a horizontal and a verical pice as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msub
                      %mi A
                      %mi U
                    %mo +
                    %mi λ
                    %mo ∧
                    %mi d
                    %mi t
                  %annotation{:encoding => "application/x-tex"} A = A_U + \lambda \wedge d t
              that the condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi t
                    %msub
                      %mi F
                      %mi A
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \iota_{\partial_t} F_A = 0
              is equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi s
                    %mi A
                    %mo =
                    %msub
                      %mi d
                      %mi U
                    %mi λ
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi λ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\partial}{\partial s} A
                    \=
                    d_U \lambda + [\lambda, A]
                    \\,.
            %p
              For any initial value
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(0)
              this has the unique solution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi t
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo +
                            %msub
                              %mi d
                              %mi U
                            %mo{:stretchy => "false"} )
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Ad
                              %mrow
                                %mi g
                                %mo{:stretchy => "false"} (
                                %mi t
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi t
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mi θ
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A(t) &amp; = g(t)^{-1} (A + d_{U}) g(t)
                    \\\
                    \&amp; = Ad_{g(t)}(A) + g(t)^* \theta
                    \\end{aligned}
            %p
              (with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
