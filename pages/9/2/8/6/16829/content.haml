          %h3#vandermonde_identity Vandermonde identity
          %h3#stirling_number_identities Stirling number identities
          %h2#polynomial_identities Polynomial identities
          %p
            One method for proving
            %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
            identities (equations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mi q
                %annotation{:encoding => "application/x-tex"} p = q
            between polynomials
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ,
                  %mi q
                  %mo ∈
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi k
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} p, q \in \mathbb{C}[x_1, \ldots, x_k]
            in several variables) is first to give a bijective proof for the special case in which natural numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mi i
                %annotation{:encoding => "application/x-tex"} m_i
            are substituted for the variables
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
          %p
            More formally, two polynomials are equal,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(x_1, \ldots, x_k) = q(x_1, \ldots, x_k)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi m
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi m
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi q
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi m
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi m
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p(m_1, \ldots, m_k) = q(m_1, \ldots, m_k)
            for all choices of natural numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mi i
                  %annotation{:encoding => "application/x-tex"} m_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℕ
                    %mi k
                  %mo ⊆
                  %msup
                    %mi ℂ
                    %mi k
                %annotation{:encoding => "application/x-tex"} \mathbb{N}^k \subseteq \mathbb{C}^k
            is Zariski-dense (i.e., the closure of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℕ
                    %mi k
                %annotation{:encoding => "application/x-tex"} \mathbb{N}^k
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℂ
                    %mi k
                %annotation{:encoding => "application/x-tex"} \mathbb{C}^k
            equipped with the
            %a.existingWikiWord{:href => "/nlab/show/Zariski+topology"} Zariski topology
            is all of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^k
          %p This is intuitively obvious of course. As a public service, we prove a more general result.
          .num_prop
            %h6#proposition Proposition
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is an
              %a.existingWikiWord{:href => "/nlab/show/infinite+set"} infinite
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of an
              %a.existingWikiWord{:href => "/nlab/show/integral+domain"} integral domain
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi A
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} p(x_1, \ldots, x_k) \in A[x_1, \ldots, x_k]
              is uniquely determined by its values it takes at arguments
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi b
                        %mi k
                      %mo ∈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} b_1, \ldots, b_k \in B
          .proof
            %h6#proof Proof
            %p
              It suffices to show that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi b
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p(b_1, \ldots, b_k) = 0
              for every choice of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mi i
                      %mo ∈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} b_i \in B
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} p = 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k = 0
              is trivial.
            %p
              Assuming the assertion as induction hypothesis for case
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi A
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} p \in A[x_1, \ldots, x_k, x_{k+1}]
              satisfies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi b
                      %mi k
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p(b_1, \ldots, b_k, b) = 0
              for all choices
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mi i
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} b_i \in B
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} b \in B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} b \in B
              the polynomial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi A
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} p(x_1, \ldots, x_k, b) \in A[x_1, \ldots, x_k]
              is identically zero. Thus if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is the
              %a.existingWikiWord{:href => "/nlab/show/field+of+fractions"} field of fractions
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi x
                        %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} A[x_1, \ldots, x_k]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              as an element of the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+domain"} Euclidean domain
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F[x_{k+1}]
              under the obvious embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ≅
                    %mi A
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mi F
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} A[x_1, \ldots, x_k, x_{k+1}] \cong A[x_1, \ldots, x_k][x_{k+1}] \hookrightarrow F[x_{k+1}],
            %p
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              has infinitely many
              %a.existingWikiWord{:href => "/nlab/show/roots"} roots
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and thus in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
