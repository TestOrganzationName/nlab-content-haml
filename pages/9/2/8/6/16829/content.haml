                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            = succeed "-Pascal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mi n
                        %mi k
                      %mo )
                    %mi q
                  %mo =
                  %msub
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                        %mi k
                      %mo )
                    %mi q
                  %mo +
                  %msup
                    %mi q
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                  %msub
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                        %mrow
                          %mi k
                          %mo −
                          %mn 1
                      %mo )
                    %mi q
                  %mo .
                %annotation{:encoding => "application/x-tex"} \binom{n}{k}_q = \binom{n-1}{k}_q + q^{n-k}\binom{n-1}{k-1}_q.
          %p
            For, if we choose a standard affine hyperplane
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo =
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi x
                    %mi n
                  %mo =
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} H = \{x_n = 1\}
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔽
                      %mi q
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_q^n
            = succeed "-plane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
