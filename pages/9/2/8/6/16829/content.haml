                        %mo )
                      %mi q
                    %msup
                      %mi x
                      %mi k
                    %msup
                      %mi y
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                  %annotation{:encoding => "application/x-tex"} (x + y)^n = \sum_{k = 0}^n \binom{n}{k}_q x^k y^{n-k}
          %p
            However, an illuminating combinatorial interpretation of the
            = succeed "-binomial" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            %a.existingWikiWord{:href => "/nlab/show/Grassmannian"} Grassmannian
            consisting of
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
