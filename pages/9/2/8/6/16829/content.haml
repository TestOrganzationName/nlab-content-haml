              %semantics
                %mrow
                  %msubsup
                    %mi 𝔽
                    %mi q
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_q^n
            over a
            %a.existingWikiWord{:href => "/nlab/show/finite+field"} finite field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi q
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_q
            of cardinality
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
