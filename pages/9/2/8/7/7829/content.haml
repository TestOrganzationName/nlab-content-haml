          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Z
                %annotation{:encoding => "application/x-tex"} \pi \colon X \to Z
            be a
            = succeed "-parameterized" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
            %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            of odd
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
          %p
            Equip the corresponding collection of
            %a.existingWikiWord{:href => "/nlab/show/Dirac+operators"} Dirac operators
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi X
                %annotation{:encoding => "application/x-tex"} D_X
            with the
            %a.existingWikiWord{:href => "/nlab/show/boundary+condition"} boundary condition
            given by a choice of
            %a.existingWikiWord{:href => "/nlab/show/isometry"} isometry
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ker
                    %mo +
                  %msub
                    %mi D
                    %mrow
                      %mo ∂
                      %mi X
                  %mo ≃
                  %msup
                    %mi Ker
                    %mo −
                  %msub
                    %mi D
                    %mrow
                      %mo ∂
                      %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Ker^+ D_{\partial X} \simeq Ker^- D_{\partial X}
                  \\,.
          %p
            e.g. (
            %a{:href => "#M&#252;ller94"}> Müller 94, below (0.3)
            )
          %p Define then the exponentiated eta-invariant to be the element
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi X
                  %mo ≔
                  %mi exp
                  %mrow
                    %mo (
                    %mi π
                    %mi i
                    %mrow
                      %mo (
                      %msub
                        %mi η
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi dim
                      %mrow
                        %mo (
                        %mi ker
                        %msub
                          %mi D
                          %mi X
                        %mo )
                      %mo )
                    %mo )
                  %mo ∈
                  %msubsup
                    %mi Det
                    %mrow
                      %mo ∂
                      %mi X
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\tau_X
                  \\coloneqq
                  \\exp\left(
                  \\pi i
                  \\left(
                  \\eta_X(0)  + dim\left(ker D_X\right)
                  \\right)
                  \\right)
                  \\in
                  Det^{-1}_{\partial X}
          %p
            in the inverse of the
            %a.existingWikiWord{:href => "/nlab/show/determinant+line"} determinant line
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Det
                    %mrow
                      %mo ∂
                      %mi X
                  %mo ≔
                  %mrow
                    %mo (
                    %mi det
                    %mrow
                      %mo (
                      %msup
                        %mi ker
                        %mo −
                      %msub
                        %mi D
                        %mrow
                          %mo ∂
                          %mi X
                      %mo )
                    %mo )
                  %mo ⊗
                  %msup
                    %mrow
                      %mo (
                      %mi det
                      %mrow
                        %mo (
                        %msup
                          %mi ker
                          %mo +
                        %msub
                          %mi D
                          %mrow
                            %mo ∂
                            %mi X
                        %mo )
                      %mo )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Det_{\partial X}
                  \\coloneqq
                  \\left(
                  det\left(ker^- D_{\partial X}\right)
                  \\right)
                  \\otimes
                  \\left(
                  det\left(ker^+ D_{\partial X}\right)
                  \\right)^{-1}
                  \\,.
          %p
            (Here it is maybe noteworthy that, by the
            = succeed "," do
              %a{:href => "#OnOddDimensionalManifolds"} above
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ζ
                    %mi S
                  %mo =
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi π
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi η
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \zeta_S = \exp(i \pi\, \eta_X(0))
            is the
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Selberg+zeta+function"} Selberg zeta function
          %p
            In fact this is a smooth
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of the
            %a.existingWikiWord{:href => "/nlab/show/determinant+line+bundle"} determinant line bundle
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            varies.
          #ExponentiatedEtaSatisfiesSewing.num_prop
            %h6#proposition Proposition
            %p
              These sections given by the exponentiated eta invariant satisfy the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sewing+law"} sewing law
          %p
            This is due to (
            %a{:href => "#DaiFreed94"}> Dai-Freed 94
            ), reviewed in (
            %a{:href => "#Freed95a"}> Freed 95a
            ). See also (
            %a{:href => "#Witten15"}> Witten 15
            ) for discussion in relation to
            %a.existingWikiWord{:href => "/nlab/show/anomaly+cancellation"} anomaly cancellation
            of
            %a.existingWikiWord{:href => "/nlab/show/fermions"} fermions
            (specifically for the eta invariant in the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz mechanism
            see
            = succeed ")." do
              %a{:href => "Green-Schwarz+mechanism#Witten99"} Witten 99, section 2.2
          .num_remark
            %h6#remark_4 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#ExponentiatedEtaSatisfiesSewing"}
              means that the eta-invariant satisfies something like the Atiyah-axioms for
              %a.existingWikiWord{:href => "/nlab/show/TQFT"} TQFT
              (but of course
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              depends on a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} metric
              = succeed ")." do
                %a{:href => "#Bunke94"} Bunke 94
              = succeed "Indeed," do
                %br/
              %a.existingWikiWord{:href => "/nlab/show/analytic+torsion"} analytic torsion
              and the classical CS invariant) of the
              %a.existingWikiWord{:href => "/nlab/show/perturbation+theory"} perturbative
              %a.existingWikiWord{:href => "/nlab/show/path+integral+quantization"} path integral quantization
              of
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
              (
              %a{:href => "#Witten89"}> Witten 89 (2.17) (2.23)
              ), see at
              = succeed "." do
                %em
                  %a{:href => "Chern-Simons+theory#PerturbativePathIntegralQuantization"} Chern-Simons theory – Perturbative path integral quantization
          .num_remark
            %h6#remark_5 Remark
            %p
              Also the
              %a.existingWikiWord{:href => "/nlab/show/theta+function"} theta function
              is a section of, up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              = succeed ")." do
                %a{:href => "#Freed95b"} Freed 95b, p. 31
            %blockquote
              %p
                (and hopefully it coincides with the section given by the exponentiated
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
                under suitable conditions?)
          %h2#examples Examples
          %h3#for_dirac_operator_on_riemann_surfaces For Dirac operator on Riemann surfaces
          %p
            For the
            %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
            on a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Riemann+surface"} Riemann surface
            %a.existingWikiWord{:href => "/nlab/show/complex+curve"} complex curve
            the eta function was discussed in (
            %a{:href => "#Millson78"}> Millson 78
            ).
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/zeta+function+of+a+Riemann+surface"} zeta function of a Riemann surface
            for more on this case.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/e-invariant"} e-invariant
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/index+of+an+operator"} index of an operator
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Spin+Chern-Simons+theory"} Spin Chern-Simons theory
          %h2#references References
          %p
            The
            = succeed "-invariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+F.+Atiyah"}> Michael F. Atiyah
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Vijay+K.+Patodi"} Vijay K. Patodi
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Isadore+M.+Singer"} Isadore M. Singer
                = succeed "," do
                  %em Spectral asymmetry and Riemannian Geometry. I
                %strong 77
                1 (1975) 43-69 &amp;lbrack;
                %a{:href => "https://doi.org/10.1017/S0305004100049410"}> doi:10.1017/S0305004100049410
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://webhomes.maths.ed.ac.uk/~v1ranick/papers/aps001.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+F.+Atiyah"}> Michael F. Atiyah
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Vijay+K.+Patodi"} Vijay K. Patodi
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Isadore+M.+Singer"} Isadore M. Singer
                = succeed "," do
                  %em Spectral asymmetry and Riemannian geometry II
                %strong 78
                3 (1975) 405-432 &amp;lbrack;
                %a{:href => "https://doi.org/10.1017/S0305004100051872"}> doi:10.1017/S0305004100051872
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://webhomes.maths.ed.ac.uk/~v1ranick/papers/aps002.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+F.+Atiyah"}> Michael F. Atiyah
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Vijay+K.+Patodi"} Vijay K. Patodi
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Isadore+M.+Singer"} Isadore M. Singer
                = succeed "," do
                  %em Spectral asymmetry and Riemannian geometry III
                %strong 79
                1 (1976) 71-99 &amp;lbrack;
                %a{:href => "https://doi.org/10.1017/S0305004100052105"}> doi:10.1017/S0305004100052105
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://repository.ias.ac.in/33549/1/33549.pdf"} pdf
          %p
            as the
            %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            correction term for the
            %a.existingWikiWord{:href => "/nlab/show/analytic+index"} index formula
            on a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} manifold with boundary
          %p Introductions and surveys:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Michel+Bismut"}> Jean-Michel Bismut
                ,
                = succeed "," do
                  %em Local index theory, eta invariants and holomorphic torsion: a survey
            %li#Richardson
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ken+Richardson"}> Ken Richardson
                ,
                %em Introduction to the Eta invariant
                (
                %a{:href => "http://faculty.tcu.edu/richardson/Seminars/etaInvariant.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Xianzhe+Dai"}> Xianzhe Dai
                ,
                %em Eta invariant and holonomy
                Chern Centennial (2011) (
                %a{:href => "http://www.nim.nankai.edu.cn/activites/conferences/Chern-Centennial-20111024/ppt_pdf/1027pm-XZDai.pdf"}> pdf slides
                )
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "http://en.wikipedia.org/wiki/Eta_invariant"} Eta invariant
          %p Formulation in the broader context of bordism theory is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
              ,
              %em On the topological contents of eta invariants
              (
              %a{:href => "http://arxiv.org/abs/1103.4217"}> arXiv:1103.4217
              )
          %p
            Further discussion of the relation to
            %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            is in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Xianzhe+Dai"}> Xianzhe Dai
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Weiping+Zhang"} Weiping Zhang
                = succeed "," do
                  %em Eta invariant and holonomy, the even dimensional case
                %a{:href => "http://arxiv.org/abs/1205.0562"} arXiv:1205.0562
            %li
              %p
                %em Eta invariant and Selberg zeta function of odd type over convex co-compact hyperbolic manifolds
                (
                %a{:href => "http://www.imar.ro/~sergium/fisiere/Eta-Selberg2501.pdf"}> pdf
                )
          %p
            Discussion of relation to
            %a.existingWikiWord{:href => "/nlab/show/L-functions"} L-functions
            includes
          %ul
            %li#AtiyahDonellySinger83
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
                , H. Donnelly; ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Isadore+Singer"} Isadore Singer
                = succeed "," do
                  %em Eta invariants, signature defects of cusps, and values of L-functions
            %li#Podesta14
              %p
                Ricardo A. Podestá,
                %em The eta function and eta invariant of Z2r-manifolds
                (
                %a{:href => "http://arxiv.org/abs/1407.7454"}> ariv:1407.7454
                )
          %p
            Discussion of the case over
            %a.existingWikiWord{:href => "/nlab/show/Riemann+surfaces"} Riemann surfaces
            includes
          %ul
            %li#Millson78
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Millson"}> John Millson
                ,
                = succeed "," do
                  %em
                    Closed geodesic and the
                    = succeed "-invariant" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi η
                          %annotation{:encoding => "application/x-tex"} \eta
                = succeed ")" do
                  %a{:href => "http://www.jstor.org/stable/1970928"} jstor
            %li#Park01
              %p
                Jinsung Park,
                %em Eta invariants and regularized determinants for odd dimensional hyperbolic manifolds with cusps
                (
                %a{:href => "http://arxiv.org/abs/math/0111175"}> arXiv:0111175
                )
            %li#GuillarmouMoroianuPark09
              %p
                Colin Guillarmou, Sergiu Moroianu, Jinsung Park,
                %em Eta invariant and Selberg Zeta function of odd type over convex co-compact hyperbolic manifolds
                (
                %a{:href => "http://arxiv.org/abs/0901.4082"}> arXiv:0901.4082
                )
          %p
            Discussion in relation to
            %a.existingWikiWord{:href => "/nlab/show/analytic+torsion"} analytic torsion
            and
            %a.existingWikiWord{:href => "/nlab/show/perturbation+theory"} perturbative
            quantum
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            goes back to
          %ul
            %li#Witten89
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
              %em Quantum Field Theory and the Jones Polynomial
              Commun. Math. Phys. 121 (3) (1989) 351–399. MR0990772 (
              %a{:href => "http://projecteuclid.org/euclid.cmp/1104178138"}> project EUCLID
              )
          %p with more in
          %ul
            %li#Lott90
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Lott"}> John Lott
                ,
                = succeed "," do
                  %em Eta and torsion
                = succeed ")" do
                  %a{:href => "http://math.berkeley.edu/~lott/lhouches.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lisa+Jeffrey"}> Lisa Jeffrey
                \:
                = succeed "," do
                  %em Symplectic quantum mechanics and Chern-Simons gauge theory I
                %strong 54
                (2013) 052304 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/1210.6635"}> arxiv/1210.6635
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1063/1.4804152"} doi:10.1063/1.4804152
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lisa+Jeffrey"}> Lisa Jeffrey
                , Brendan McLellan:
                %em
                  Eta-Invariants and Anomalies in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(1)
                  Chern-Simons Theory
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1004.2913"}> arXiv:1004.2913
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://www.math.toronto.edu/mclellan/eta%20invariants%20and%20anomalies.pdf"} pdf
            %li#Young
              %p
                M. B. Young, section 2 of
                %em Chern-Simons theory, knots and moduli spaces of connections
                (
                %a{:href => "http://www.math.sunysb.edu/~myoung/CS.pdf"}> pdf
                )
          %p Discussion of the eta-invariant on manifolds with boundary is in
          %ul
            %li{:id => "M&#252;ller94"}
              %p
                Werner Müller,
                = succeed "," do
                  %em Eta invariants and manifolds with boundary
                = succeed ")" do
                  %a{:href => "http://www.maths.ed.ac.uk/~aar/papers/mueller.pdf"} pdf
            %li#Bunke94
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
                ,
                %em
                  The
                  = succeed "-Invariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi η
                        %annotation{:encoding => "application/x-tex"} \eta
                (
                %a{:href => "http://arxiv.org/abs/hep-th/9408162"}> arXiv:hep-th/9408162
                )
            %li#Witten15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                = succeed "," do
                  %em Anomalies revisited
                %a{:href => "https://strings2015.icts.res.in"} Strings2015
                (
                %a{:href => "https://strings2015.icts.res.in/talkDocuments/6-2.00-2.30-Edward-Witten.pdf"}> pdf slides
                )
          %p and regarding the result as taking values in the determinant line over the boundary is due to
          %ul
            %li#DaiFreed94
              %a.existingWikiWord{:href => "/nlab/show/Xianzhe+Dai"} Xianzhe Dai
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"} Daniel Freed
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi η
                      %annotation{:encoding => "application/x-tex"} \eta
                  \-Invariants and Determinant Lines
              %p
                5155–5194 and C. R. Acad. Sci. Paris (1995), 585–592 (
                %a{:href => "http://arxiv.org/abs/hep-th/9405012"}> arXiv:hep-th/9405012
                )
          %p with review and streamlined results in
          %ul
            %li#Freed95a
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
                ,
                %em Determinant line bundles revisited
                (
                %a{:href => "http://arxiv.org/abs/dg-ga/9505002"}> dg-ga/9505002
                )
            %li#Freed95b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
                ,
                = succeed "," do
                  %em On determinant line bundles
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
                = succeed ")" do
                  %a{:href => "http://www.math.utexas.edu/~dafr/Index/determinants.pdf"} revised pdf
