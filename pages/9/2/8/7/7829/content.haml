          #SeriesDefinition.num_defn
            %h6#definition_2 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/self-adjoint+operator"} self-adjoint operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              (usually first-order, such as a
              %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
              acting on
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of a
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              on a
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
              %a.existingWikiWord{:href => "/nlab/show/eigenvalues"} eigenvalues
              with multiplicities
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi λ
                        %mi n
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{\lambda_n\}
              %em eta function
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/series"} series
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi η
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi n
                                %mo =
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn ∞
                              %mrow
                                %msup
                                  %mo
                                  %mn ∞
                            %mi sgn
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi λ
                              %mi n
                            %mo{:stretchy => "false"} )
                            %mfrac
                              %mn 1
                              %mrow
                                %msup
                                  %mrow
                                    %mo{:stretchy => "false"} |
                                    %msub
                                      %mi λ
                                      %mi n
                                    %mo{:stretchy => "false"} |
                                  %mi s
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\eta(s)
                    \&amp; \coloneqq
                    \\underoverset{n = -\infty}{^\infty }{\sum} sgn(\lambda_n) \frac{1}{ {\vert \lambda_n\vert}^s}
                    \\end{aligned}
            %p
              expression wherever this
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/convergence"} converges
              %a.existingWikiWord{:href => "/nlab/show/analytic+continuation"} analytic continuation
              from there.
          .num_remark
            %h6#remark Remark
            %p
              At the
              %a.existingWikiWord{:href => "/nlab/show/special+values+of+L-functions"} special value
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} s = 1
              the series in def.
              %a.maruku-ref{:href => "#SeriesDefinition"}
              does not converge, but if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is indeed a
              %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
              then it is the expression of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Dirac+propagator"} Dirac propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              by
              %a.existingWikiWord{:href => "/nlab/show/analytic+continuation"} analytic continuation
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} s = 1
              is the
              %a.existingWikiWord{:href => "/nlab/show/regularization+%28physics%29"} regularized
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Dirac+propagator"} Dirac propagator
          .num_remark
            %h6#remark_2 Remark
            %p
              The eta function of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is related to the
              %a.existingWikiWord{:href => "/nlab/show/zeta+function+of+an+elliptic+differential+operator"} zeta function of an elliptic differential operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo =
                    %msup
                      %mi D
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} H = D^2
              (regarding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              as a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
              = succeed "-like" do
                %a.existingWikiWord{:href => "/nlab/show/supersymmetric+quantum+mechanics"} supersymmetric quantum mechanics
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "." do
                %a{:href => "#RelationToTheZetaFunction"} below
          #EtaInvariant.num_defn
            %h6#definition_3 Definition
            %p
              The
              %em eta invariant
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is the
              %a.existingWikiWord{:href => "/nlab/show/special+values+of+L-functions"} special value
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta(0)
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Richardson"} Richardson, first page
          .num_remark
            %h6#remark_3 Remark
            %p
              Def.
              %a.maruku-ref{:href => "#EtaInvariant"}
              means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \eta_0
              is the
              %a.existingWikiWord{:href => "/nlab/show/zeta+function+regularization"} regularized
              number of positive minus negative eigenvalues of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
          %p
            (Notice that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            itself happens to have only positive
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/eigenvalues"} eigenvalues
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/zeta+function+of+an+elliptic+differential+operator"} zeta function of an elliptic differential operator
          %h2#properties Properties
          %h3#relation_to_the_thetafunction__mellin_transform Relation to the theta-function / Mellin transform
          %p
            The eta function is a kind of odd version of the
            %a.existingWikiWord{:href => "/nlab/show/Mellin+transform"} Mellin transform
            of an odd version of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/theta+function"} theta function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi η
                    %mi D
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mn 1
                    %mrow
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo{:stretchy => "false"} )
                  %munderover
                    %mo ∫
                    %mn 0
                    %mn ∞
                  %msup
                    %mi t
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mn 2
                  %mi Tr
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mspace{:width => "thinmathspace"}
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi t
                  %msup
                    %mi D
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi d
                  %mi t
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\eta_D(s)
                  \=
                  \\frac{1}{\Gamma((s+1)/2)}
                  \\underoverset{0}{\infty}{\int}
                  t^{(s-1)/2}
                  Tr(D\,\exp(-t D^2))
                  \\,
                  d t
                  \\,.
          %p
            e.g. (
            %a{:href => "#M&#252;ller94"}> Müller 94 (0.2)
            ).
          %h3#RelationToTheZetaFunction Relation to the zeta function
          %h4#generally Generally
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            be a
            %a.existingWikiWord{:href => "/nlab/show/self-adjoint+operator"} self-adjoint operator
            such that
          %ol
            %li
              %p
                its eta function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta(s)
                is defined and
                %a.existingWikiWord{:href => "/nlab/show/analytic+function"} analytic
                at
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} s= 0
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi I
                      %mo ⊂
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} c \in I \subset \mathbb{R}
                in an interval such that no
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi c
                    %annotation{:encoding => "application/x-tex"} -c
                is an
                %a.existingWikiWord{:href => "/nlab/show/eigenvalue"} eigenvalue
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                such that both the eta series
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mrow
                          %mi D
                          %mo +
                          %mi c
                    %annotation{:encoding => "application/x-tex"} \eta_{D+c}
                and the
                %a.existingWikiWord{:href => "/nlab/show/zeta+function+of+an+elliptic+differential+operator"} zeta function
                series
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ζ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi D
                          %mo +
                          %mi c
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \zeta_{(D+c)^2}((s+1)/2)
                have a common lower bound
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo &gt;
                      %mi B
                    %annotation{:encoding => "application/x-tex"} s \gt B
                for the values on wich the series converges
          %p then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mi d
                    %mrow
                      %mi d
                      %mi c
                  %msub
                    %mi η
                    %mrow
                      %mi D
                      %mo +
                      %mi c
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi s
                  %msub
                    %mi ζ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo +
                      %mi c
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\frac{d}{d c} \eta_{D+c}(s) = s \zeta_{(D + c)^2}((s+1)/2)
                  \\,,
          %p
            where on the left we have the
            %a.existingWikiWord{:href => "/nlab/show/zeta+function+of+an+elliptic+differential+operator"} zeta function of an elliptic differential operator
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo +
                    %mi c
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} (D+c)^2
          %p
            (e.g.
            = succeed ")." do
              %a{:href => "#Richardson"} Richardson prop. 2
          %p
            In particular this means that under the above assumptions the
            %a.existingWikiWord{:href => "/nlab/show/functional+determinant"} functional determinant
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mn 2
                %annotation{:encoding => "application/x-tex"} D^2
            is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi D
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi exp
                  %mrow
                    %mo (
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi s
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi c
                    %msub
                      %mi η
                      %mi D
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  det (D^2)
                  \=
                  \\exp\left(
                  \\frac{\partial}{\partial s}\frac{\partial}{\partial c} \eta_{D}(0)
                  \\right)
                  \\,.
          %h4#OnOddDimensionalManifolds On odd-dimensional manifolds
          %p
            Under suitable conditions the exponentiated
            = succeed "-invariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi π
                  %mi i
                  %mi η
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(\pi i \eta(0))
            equals the
            %a.existingWikiWord{:href => "/nlab/show/Selberg+zeta+function"} Selberg zeta function
            of odd type. (
            %a{:href => "#Millson78"}> Millson 78
            ,
            = succeed "," do
              %a{:href => "#Park01"} Park 01, theorem 1.2
            = succeed ")." do
              %a{:href => "#GuillarmouMoroianuPark09"} Guillarmou-Moroianu-Park 09
          %h3#AnalogyWithLSeries Relation with L-function
          %p
            Relation of eta functions to
            %a.existingWikiWord{:href => "/nlab/show/Dirichlet+L-functions"} Dirichlet L-functions
            includes (
            %a{:href => "#AtiyahDonellySinger83"}> Atiyah-Donelly-Singer 83
            ,
            = succeed ")" do
              %a{:href => "#Podesta14"} Podesta 14
          %div
            %table
              %thead
                %tr
                  %th
                    context/
                    %a.existingWikiWord{:href => "/nlab/show/function+field+analogy"} function field analogy
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/theta+function"} theta function
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi θ
                        %annotation{:encoding => "application/x-tex"} \theta
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/zeta+function"} zeta function
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ζ
                        %annotation{:encoding => "application/x-tex"} \zeta
                    (=
                    %a.existingWikiWord{:href => "/nlab/show/Mellin+transform"} Mellin transform
                    of
                    = succeed ")" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi θ
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \theta(0,-)
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/L-function"} L-function
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi L
                            %mstyle{:mathvariant => "bold"}
                              %mi z
                        %annotation{:encoding => "application/x-tex"} L_{\mathbf{z}}
                    (=
                    %a.existingWikiWord{:href => "/nlab/show/Mellin+transform"} Mellin transform
                    of
                    = succeed ")" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi θ
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi z
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \theta(\mathbf{z},-)
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/eta+function"} eta function
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi η
                        %annotation{:encoding => "application/x-tex"} \eta
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/special+values+of+L-functions"} special values of L-functions
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/physics"}> physics
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/2d+CFT"} 2d CFT
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi θ
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi z
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi τ
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi Tr
