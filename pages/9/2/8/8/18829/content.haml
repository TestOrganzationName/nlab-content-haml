                    \&amp; \coloneqq
                    \\int \int f((x + t)/2) g( (t + y)/2 )
                    e^{ \tfrac{1}{i \hbar} \tfrac{1}{4} \omega( x-t, x+t ) + \tfrac{1}{i \hbar} \tfrac{1}{4} \omega(t-y, t + y)  }
                    \\, d^{2n} t
                    \\, d^{2n} (x-y)
                    \\\
                    \&amp; =
                    \\int \int
                    f(t/2) g( (t - (x - y))/2 )
                    e^{ \tfrac{1}{i \hbar} \tfrac{1}{4} \omega( (x+y) + (x - y) - t, t ) + \tfrac{1}{i \hbar} \tfrac{1}{4} \omega(t-(x+y), t - (x-y))  }
                    \\, d^{2n} t
                    \\, d^{2n} (x-y)
                    \\\
                    \&amp; =
                    \\int \int
                    f(t/2) g( \tilde t / 2)
                    e^{ \tfrac{1}{i \hbar} \tfrac{1}{4} \omega( (x+y) - \tilde t, t ) - \tfrac{1}{i \hbar} \tfrac{1}{4} \omega((x+y)-t, \tilde t)  }
                    \\, d^{2n} t
                    \\, d^{2n} \tilde t
                    \\\
                    \&amp; =
                    \\int \int
                    f(t) g( \tilde t )
                    e^{ \tfrac{1}{i \hbar} \tfrac{1}{4} \omega( (x+y) - 2 \tilde t, 2 t ) - \tfrac{1}{ii \hbar} \tfrac{1}{4} \omega((x+y)- 2 t, 2 \tilde t)  }
                    \\, d^{2n} t
                    \\, d^{2n} \tilde t
                    \\\
                    \\\
                    \&amp; =
                    \\int \int
                    f(t) g(\tilde t )
                    e^{ \tfrac{1}{i \hbar} \omega\left( \tfrac{1}{2}(x+y) - \tilde t, \tfrac{1}{2}(x + y) - t  \right)}
                    \\, d^{2n} t
                    \\, d^{2n} \tilde t
                    \\\
                    \&amp; =
                    (f \star_\omega g)((x+y)/2)
                    \\end{aligned}
            %p
              The first line just unwinds the definition of polarized sections from def.
              = succeed "," do
                %a.maruku-ref{:href => "#SymplecticGroupoidOfSymplecticVectorSpace"}
              %a.existingWikiWord{:href => "/nlab/show/change+of+integration+variables"} change of integration variables
              and finally in the last line we used prop.
              = succeed "." do
                %a.maruku-ref{:href => "#IntegralRepresentationOfStarProduct"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p{:id => "WickAlgebraOfNormalOrderedProductsOnKählerVectorspace"}
            %strong
              Example:
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              of
              %a.existingWikiWord{:href => "/nlab/show/normal+ordered+products"} normal ordered products
              on
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
          #AlmostKaehlerVectorSpace.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"}> Kähler vector space
                )
            %p
              An
              %em
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
              is a
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/linear+complex+structure"} linear complex structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              as well as two
              %a.existingWikiWord{:href => "/nlab/show/bilinear+forms"} bilinear forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ,
                    %mi g
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi V
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %mi V
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \omega, g \;\colon\; V \otimes_{\mathbb{R}} V \longrightarrow \mathbb{R}
              such that the following equivalent conditions hold:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mi v
                        %mo ,
                        %mi J
                        %mi w
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ω
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo ,
                        %mi w
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \omega(J v, J w) = \omega(v,w)
                  and
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi w
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi ω
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi J
                          %mi w
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} g(v,w) = \omega(v,J w)
              %li
                %p
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  regarded as a
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  and with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mo ,
                        %mi g
                      %annotation{:encoding => "application/x-tex"} \omega, g
                  regarded as constant
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/tensors"} tensors
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo ,
                        %mi ω
                        %mo ,
                        %mi g
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (V, \omega, g)
                  is an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/almost+K%C3%A4hler+manifold"} almost Kähler manifold
          #StandardAlmostKaehlerVectorSpaces.num_example
            %h6#example_5 Example
            %p
              %strong
                (standard
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+spaces"} Kähler vector spaces
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ≔
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} V \coloneqq \mathbb{R}^2
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              which is given by the canonical identification
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 2
                      %mo ≃
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^2 \simeq \mathbb{C}
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e_i)
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mi i
                    %msub
                      %mrow
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mn 0
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    J = (J^i{}_j)
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; -1
                    \\\
                    1 &amp; 0
                    }
                    \\right)
                    \\,.
            %p Moreover let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ω
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                            %mtd
                              %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\omega = (\omega_{i j}) \coloneqq \left( \array{0 &amp; 1 \\ -1 &amp; 0} \right)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g = (g_{i j}) \coloneqq \left( \array{ 1 &amp; 0 \\ 0 &amp; 1}  \right)
                    \\,.
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi J
                    %mo ,
                    %mi ω
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V, J, \omega, g)
              is a
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#AlmostKaehlerVectorSpace"}
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifold"} Kähler manifold
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              in the standard way and equipped with the
              %a.existingWikiWord{:href => "/nlab/show/bilinear+forms"} bilinear forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ,
                    %mi ω
                    %mi g
                  %annotation{:encoding => "application/x-tex"} J, \omega g
              extended as constant rank-2
              %a.existingWikiWord{:href => "/nlab/show/tensors"} tensors
              over this manifold.
            %p If we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    x,y \;\colon\; \mathbb{R}^2 \longrightarrow \mathbb{R}
            %p
              for the standard
              %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ≔
                    %mi x
                    %mo +
                    %mi i
                    %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    z \coloneqq x + i y \;\coloneqq\; \mathbb{R}^2 \to \mathbb{C}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi z
                      %mo ¯
                    %mo ≔
                    %mi x
                    %mo −
                    %mi i
                    %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{z} \coloneqq x - i y \;\coloneqq\; \mathbb{R}^2 \to \mathbb{C}
            %p for the corresponding complex coordinates, then this translates to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\omega
                    \\in
                    \\Omega^2(\mathbb{R}^2)
            %p
              being the
              %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ω
                          %mtd
                            %mo =
                            %mi d
                            %mi x
                            %mo ∧
                            %mi d
                            %mi y
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mn 2
                                  %mi i
                            %mi d
                            %mi z
                            %mo ∧
                            %mi d
                            %mover
                              %mi z
                              %mo ¯
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\omega
                    \&amp; =
                    d x \wedge d y
                    \\\
                    \&amp; =
                    \\tfrac{1}{2i} d z \wedge d \overline{z}
                    \\end{aligned}
            %p
              and with
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              %a.existingWikiWord{:href => "/nlab/show/tensor"} tensor
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %mi d
                    %mi x
                    %mo ⊗
                    %mi d
                    %mi x
                    %mo +
                    %mi d
                    %mi y
                    %mo ⊗
                    %mi d
                    %mi y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g = d x \otimes d x + d y \otimes d y
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Hermitian+form"} Hermitian form
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi h
                          %mtd
                            %mo =
                            %mi g
                            %mo −
                            %mi i
                            %mi ω
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi d
                            %mi z
                            %mo ⊗
                            %mi d
                            %mover
                              %mi z
                              %mo ¯
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    h
                    \&amp; =
                    g - i \omega
                    \\\
                    \&amp; =
                    d z \otimes d \overline{z}
                    \\end{aligned}
          %p
            (for more see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
            = succeed ")." do
              %a{:href => "Kähler+vector+space#StandardAlmostKaehlerVectorSpaces"} this example
          #WickAlgebraOfAlmostKaehlerVectorSpace.num_defn
            %h6#definition_6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
                of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                    %mo ,
                    %mi σ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{R}^{2n},\sigma, g)
              be a
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#AlmostKaehlerVectorSpace"}
              %em Wick algebra
              is the
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}[ [ \mathbb{R}^{2n}  ] ] [ [ \hbar ] ]
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StarPoduct"}
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            #eq:InStarProductTensorInvertingHermitianForm.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo ≔
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %msup
                      %mi ω
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo +
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\pi \coloneqq \tfrac{i}{2} \omega^{-1} + \tfrac{1}{2} g^{-1}
                    \\,,
            %p hence:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
