          #StarProductAlgebraOfKaehlerVectorSpaceIsStarAlgebra.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
                of
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
            %p
              Under
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
              the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋆
                      %mi π
                  %annotation{:encoding => "application/x-tex"} \star_\pi
              of a
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
              structure (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WickAlgebraOfAlmostKaehlerVectorSpace"}
              %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
              in that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %mo ∈
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A_1, A_2 \in \mathbb{C}[ [\mathbb{R}^{2n}] ][ [\hbar] ]
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mo (
                        %msub
                          %mi A
                          %mn 1
                        %msub
                          %mo ⋆
                          %mi π
                        %msub
                          %mi A
                          %mn 2
                        %mo )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi A
                      %mn 2
                      %mo *
                    %msub
                      %mo ⋆
                      %mi π
                    %msubsup
                      %mi A
                      %mn 1
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\left( A_1 \star_\pi A_2 \right)^\ast
                    \\;=\;
                    A_2^\ast \star_\pi A_1^\ast
          .proof
            %h6#proof_5 Proof
            %p
              This follows directly from that fact that in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo =
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %msup
                      %mi ω
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo +
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi = \tfrac{i}{2} \omega^{-1} + \tfrac{1}{2} g^{-1}
              the
              %a.existingWikiWord{:href => "/nlab/show/imaginary+part"} imaginary part
              coincides with the skew-symmetric part, so that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi π
                              %mo *
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi a
                                %mi b
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mi i
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ω
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi a
                                %mi b
                            %mo +
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi g
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi a
                                %mi b
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mi i
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ω
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi b
                                %mi a
                            %mo +
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi g
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi b
                                %mi a
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mi π
                              %mrow
                                %mi b
                                %mi a
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (\pi^\ast)^{a b}
                    \&amp; =
                    \-\tfrac{i}{2} (\omega^{-1})^{a b}
                    + \tfrac{1}{2} (g^{-1})^{a b}
                    \\\
                    \&amp; =
                    \\tfrac{i}{2} (\omega^{-1})^{b a}
                    +
                    \\tfrac{1}{2} (g^{-1})^{b a}
                    \\\
                    \&amp; = \pi^{b a}
                    \\,.
                    \\end{aligned}
          #WickAlgebraOfASingleMode.num_example
            %h6#example_6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
                of a single mode)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ≔
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo ≃
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V \coloneqq \mathbb{R}^2 \simeq Span(\{x,y\})
              be the standard
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
              according to example
              = succeed "," do
                %a.maruku-ref{:href => "#StandardAlmostKaehlerVectorSpaces"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %a.maruku-ref{:href => "#WickAlgebraOfAlmostKaehlerVectorSpace"}
              and show that this reproduces the traditional definition of products of “normal ordered” operators as
              = succeed "." do
                %a{:href => "#Idea"} above
            %p To that end, consider the complex linear combination of the coordinates to the canonical complex coordinates
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo +
                    %mi i
                    %mi y
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %mover
                      %mi z
                      %mo ¯
                    %mo ≔
                    %mi x
                    %mo −
                    %mi i
                    %mi y
                  %annotation{:encoding => "application/x-tex"}
                    z \;\coloneqq\; x + i y
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    \\overline{z} \coloneqq x - i y
            %p which we use in the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %msqrt
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi i
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %mi a
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %msqrt
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %mi i
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    a^\ast \;\coloneqq\; \tfrac{1}{\sqrt{2}}(x + i y)
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    a \;\coloneqq\; \tfrac{1}{\sqrt{2}}(x - i y)
            %p
              (with “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              ” the traditional symbol for the
              %em
                %a.existingWikiWord{:href => "/nlab/show/amplitude"} amplitude
              of a field mode).
            %p Now
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ω
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi y
                    %mo ⊗
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi x
                    %mo −
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi x
                    %mo ⊗
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi y
                  %annotation{:encoding => "application/x-tex"}
                    \\omega^{-1}
                    \=
                    \\frac{\partial}{\partial y} \otimes \frac{\partial}{\partial x}
                    \-
                    \\frac{\partial}{\partial x} \otimes \frac{\partial}{\partial y}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi x
                    %mo ⊗
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi x
                    %mo +
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi y
                    %mo ⊗
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi y
                  %annotation{:encoding => "application/x-tex"}
                    g^{-1}
                    \=
                    \\frac{\partial}{\partial x}
                    \\otimes
                    \\frac{\partial}{\partial x}
                    +
                    \\frac{\partial}{\partial y}
                    \\otimes
                    \\frac{\partial}{\partial y}
            %p so that with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi z
                    %mo =
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mrow
                      %mo (
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %mi x
                      %mo −
                      %mi i
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %mi y
                      %mo )
                    %mphantom
                      %mi AAAA
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mover
                          %mi z
                          %mo ¯
                    %mo =
                    %mfrac
                      %mn 1
                      %mn 2
                    %mrow
                      %mo (
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %mi x
                      %mo +
                      %mi i
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %mi y
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\partial}{\partial z}
                    \=
                    \\tfrac{1}{2}
                    \\left(
                    \\frac{\partial}{\partial x}
                    \-i
                    \\frac{\partial}{\partial y}
                    \\right)
                    \\phantom{AAAA}
                    \\frac{\partial}{\partial \overline{z}}
                    \=
                    \\frac{1}{2}
                    \\left(
                    \\frac{\partial}{\partial x}
                    +
                    i
                    \\frac{\partial}{\partial y}
                    \\right)
            %p we get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mrow
                                  %mi i
                                  %mi ℏ
                                %mn 2
                            %msup
                              %mi ω
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo +
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mi ℏ
                                %mn 2
                            %msup
                              %mi g
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                          %mtd
                            %mo =
                            %mn 2
                            %mi ℏ
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %mover
                                  %mi z
                                  %mo ¯
                            %mo ⊗
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %mi z
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi ℏ
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %mi a
                            %mo ⊗
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %msup
                                  %mi a
                                  %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\tfrac{i \hbar}{2}\omega^{-1} + \tfrac{\hbar}{2} g^{-1}
                    \&amp; =
                    2 \hbar
                    \\frac{\partial}{\partial \overline{z}}
                    \\otimes
                    \\frac{\partial}{\partial z}
                    \\\
                    \&amp; =
                    \\hbar \frac{\partial}{\partial a} \otimes \frac{\partial }{\partial a^\ast}
                    \\end{aligned}
            %p
              Using this, we find the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ⋆
                      %mi π
                    %mi B
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi prod
                    %mo ∘
                    %mi exp
                    %mrow
                      %mo (
                      %mi ℏ
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %mi a
                      %mo ⊗
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %msup
                            %mi a
