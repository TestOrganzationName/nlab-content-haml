                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo ⊗
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
