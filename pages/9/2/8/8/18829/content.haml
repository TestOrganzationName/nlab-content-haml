              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StarPoduct"}
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              (as well as
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PolynomialObservables"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi reg
