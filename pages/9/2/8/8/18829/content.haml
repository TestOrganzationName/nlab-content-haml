                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar] ]
                    \\,,\,
                    \\star_\Delta
                    \\right)
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FormalDeformationQuantization"}
              %a.existingWikiWord{:href => "/nlab/show/Peierls-Poisson+bracket"} Peierls-Poisson bracket
              on the
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
              (theorem
              = succeed ")," do
                %a.maruku-ref{:href => "#PPeierlsBracket"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
          %p
            (
            %a{:href => "deformation+quantization#Dito90"}> Dito 90
            ,
            %a{:href => "deformation+quantization#DuetschFredenhagen00"} Dütsch-Fredenhagen 00
            = succeed "," do
              %a{:href => "deformation+quantization#DuetschFredenhagen01"} Dütsch-Fredenhagen 01
            = succeed ")" do
              %a{:href => "deformation+quantization#HirschfeldHenselder02"} Hirshfeld-Henselder 02
          .proof
            %h6#proof_7 Proof
            %p
              As in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#PropagatorStarProduct"}
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              of the
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              of the
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              implies that all arguments go through as for
              %a.existingWikiWord{:href => "/nlab/show/star+products"} star products
              on
              %a.existingWikiWord{:href => "/nlab/show/polynomial+algebras"} polynomial algebras
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+spaces"} finite dimensional vector spaces
              %a.maruku-ref{:href => "#PPeierlsBracket"}
              the
              %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              is the
              %a.existingWikiWord{:href => "/nlab/show/integral+kernel"} integral kernel
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peierls-Poisson+bracket"} Peierls-Poisson bracket
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              from the definition of the
              %a.existingWikiWord{:href => "/nlab/show/Moyal+star+product"} Moyal star product
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#MoyalStarProduct"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo =
                    %mi Δ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi = \Delta
                    \\,.
            %p
              With this the statement follows by example
              = succeed "." do
                %a.maruku-ref{:href => "#MoyalStarProductIsFormalDeformationQuantization"}
          #TowardsQuantizationExtendingBeyondRegularPolynomialObservables.num_remark
            %h6#remark Remark
            %p
              %strong
                (extending
                %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
                beyond
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
            %p
              While cor.
              %a.maruku-ref{:href => "#FreeGaugeFixedLagrangianFieldTheoryQuantizationOfRegularObservables"}
              provides a
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
              of the
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              of any
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              are too small a subspace of that of all
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
            %p
              By example
              %a.maruku-ref{:href => "#RegularPolynomialLocalObservablesAreNecessarilyLinear"}
              the only
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalObservables"}
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              are the
              %a.existingWikiWord{:href => "/nlab/show/linear+observables"} linear observables
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LinearObservables"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              %a.existingWikiWord{:href => "/nlab/show/action+functionals"} action functionals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi int
                  %annotation{:encoding => "application/x-tex"} S_{int}
              induced from interaction
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi int
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}_{int}
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#ActionFunctional"}
            %p For example:
            %ul
              %li
                %p
                  For
                  %a.existingWikiWord{:href => "/nlab/show/quantum+electrodynamics"} quantum electrodynamics
                  on
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LagrangianQED"}
                  %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
                  %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ActionFunctional"}
                  %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/electron-photon+interaction"} electron-photon interaction
                  is a cubic
                  %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mi int
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mi i
                        %munder
                          %mo ∫
                          %mi Σ
                        %msub
                          %mi g
                          %mi sw
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi γ
                          %mi μ
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi α
                        %msub
                          %mrow
                          %mi β
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mover
                            %mstyle{:mathvariant => "bold"}
                              %mi Ψ
                            %mo ¯
                          %mi α
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi Ψ
                          %mi β
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi A
                          %mi a
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi dvol
                          %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        S_{int}
                        \\;=\;
                        i
                        \\underset{\Sigma}{\int}
                        g_{sw}(x)
                        \\,
                        (\gamma^\mu)^{\alpha}{}_\beta
                        \\,
                        \\overline{\mathbf{\Psi}}_\alpha(x)
                        \\cdot \mathbf{\Psi}^\beta(x)
                        \\cdot \mathbf{A}^a(x)
                        \\, dvol_\Sigma(x)
              %li
                %p
                  For
                  %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
                  %a.existingWikiWord{:href => "/nlab/show/phi%5En+theory"} phi^n theory
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#phintheoryLagrangian"}
                  %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
                  %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ActionFunctional"}
                  %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/phi%5En+interaction"} phi^n interaction
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mi int
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %mo ∫
                          %mi Σ
                        %msub
                          %mi g
                          %mi sw
                        %mspace{:width => "thinmathspace"}
                        %munder
                          %munder
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi Φ
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo ⋅
                              %mstyle{:mathvariant => "bold"}
                                %mi Φ
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mi ⋯
                              %mstyle{:mathvariant => "bold"}
                                %mi Φ
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo ⋅
                              %mstyle{:mathvariant => "bold"}
                                %mi Φ
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                            %mo ⏟
                          %mrow
                            %mi n
                            %mspace{:width => "thinmathspace"}
                            %mtext factors
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi dvol
                          %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        S_{int}
                        \\;=\;
                        \\underset{\Sigma}{\int}
                        g_{sw}
                        \\,
                        \\underset{
                        n \, \text{factors}
                        }{
                        \\underbrace{
                        \\mathbf{\Phi}(x)
                        \\cdot
                        \\mathbf{\Phi}(x)
                        \\cdots
                        \\mathbf{\Phi}(x)
                        \\cdot
                        \\mathbf{\Phi}(x)
                        }
                        }
                        \\,
                        dvol_\Sigma(x)
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
                  of order
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
            %p
              Therefore one needs to extend the
              %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
              provided by corollary
              %a.maruku-ref{:href => "#FreeGaugeFixedLagrangianFieldTheoryQuantizationOfRegularObservables"}
              to a larger subspace of
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              that includes at least the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            %p
              But prop.
              %a.maruku-ref{:href => "#SymmetricContribution"}
              characterizes the freedom in choosing a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
              %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              by a symmetric contribution. In view of prop.
              %a.maruku-ref{:href => "#PropagatorStarProduct"}
              and in view of of
              %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
              for the
              %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#HoermanderCriterionForProductOfDistributions"}
              %a.existingWikiWord{:href => "/nlab/show/integral+kernels"} integral kernels
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              such that the sum
            #eq:ShiftingCausalPropagatorBySymmetricContribution.maruku-equation
              %span.maruku-eq-number (9)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                    %mo =
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %mi Δ
                    %mo +
                    %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_H = \tfrac{i}{2}\Delta + H
            %p
              has a
              %em smaller
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WaveFrontSet"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \tfrac{i}{2}\Delta
              itself has. The smaller
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi WF
                      %mo{:stretchy => "false"} (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi i
                          %mn 2
                      %mi Δ
                      %mo +
                      %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} WF(\tfrac{i}{2}\Delta + H)
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              on which the corresponding
              %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
              exists.
            %p
              Now by prop.
              %a.maruku-ref{:href => "#SkewSymmetricPartOfHadmrdPropagatorIsCausalPropagatorForKleinGordonEquationOnMinkowskiSpacetime"}
              the
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H
              is of the form
              %a.maruku-eqref{:href => "#eq:ShiftingCausalPropagatorBySymmetricContribution"} (9)
              and by prop.
              %a.maruku-ref{:href => "#WaveFronSetsForKGPropagatorsOnMinkowski"}
              its
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              is only “half” that of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H
              does yield a
              %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
              of a subspace of
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              that includes all
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              %em
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
              = succeed "." do
                %em
                  %a{:href => "#FreeQuantumFields"} Free quantum fields
            %p
              With such a
              %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
              of the
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
              in hand, we may then finally obtain also a formal deformation quantization of
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interacting
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theories"} Lagrangian field theories
              by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbation theory
              %em
                %a{:href => "#Scattering"} Scattering
              and
              = succeed "." do
                %em
                  %a{:href => "#QuantumObservables"} Quantum observables
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            This concludes our discussion of some basic concepts of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            %a{:href => "#FreeQuantumFields"} next chapter
            we apply this to discuss the
            %a.existingWikiWord{:href => "/nlab/show/algebra+of+quantum+observables"} algebra of quantum observables
