                  %annotation{:encoding => "application/x-tex"}
                    PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar] ]
                    \\otimes
                    PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar] ]
                    \\overset{\star_{\tfrac{i}{2}\Delta}}{\longrightarrow}
                    PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar] ]
            %p
              and the resulting
              %a.existingWikiWord{:href => "/nlab/show/non-commutative+algebra"} non-commutative algebra
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
