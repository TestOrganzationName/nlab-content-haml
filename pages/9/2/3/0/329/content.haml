                        %mi g
                        %mo ∘
                        %mi f
                        %mo ⇒
                        %mi h
                        %mo ∘
                        %mi f
                      %annotation{:encoding => "application/x-tex"} \eta \triangleleft f\colon g \circ f \Rightarrow h \circ f
            %li
              %p
                for each
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                      %annotation{:encoding => "application/x-tex"} a,b,c
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ,
                        %mi g
                        %mo{:lspace => "verythinmathspace"} :
                        %mi a
                        %mo →
                        %mi b
                      %annotation{:encoding => "application/x-tex"} f,g\colon a \to b
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo{:lspace => "verythinmathspace"} :
                        %mi b
                        %mo →
                        %mi c
                      %annotation{:encoding => "application/x-tex"} h\colon b \to c
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo{:lspace => "verythinmathspace"} :
                        %mi f
                        %mo ⇒
                        %mi g
                      %annotation{:encoding => "application/x-tex"} \eta\colon f \Rightarrow g
                %em
                  right
                  %a.existingWikiWord{:href => "/nlab/show/whiskering"} whiskering
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo ▹
                        %mi η
                        %mo{:lspace => "verythinmathspace"} :
                        %mi h
                        %mo ∘
                        %mi f
                        %mo ⇒
                        %mi h
                        %mo ∘
                        %mi g
                      %annotation{:encoding => "application/x-tex"} h \triangleright \eta \colon h \circ f \Rightarrow h \circ g
          %p satisfying the following properties:
          %ol
            %li
              %p
                for each
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi a
                        %mo →
                        %mi b
                      %annotation{:encoding => "application/x-tex"} f\colon a \to b
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %msub
