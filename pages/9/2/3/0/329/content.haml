          %h1#strict_categories
            Strict
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          .maruku_toc
            %ul
              %li
                %a{:href => "#Idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %ul
                %li
                  %a{:href => "#DefinitionStrictTwoCategories"} Strict 2-categories
                %li
                  %a{:href => "#strict_2groupoids"} Strict 2-groupoids
                %li
                  %a{:href => "#details"} Details
                %li
                  %a{:href => "#detailedDefn"} More details
              %li
                %a{:href => "#AsSesquicategories"} 2-categories as sesquicategories
              %li
                %a{:href => "#remarks"} Remarks
              %li
                %a{:href => "#in_dependent_type_theory"} In dependent type theory
              %li
