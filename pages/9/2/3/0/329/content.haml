                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi θ
                        %mo{:lspace => "verythinmathspace"} :
                        %mi g
                        %mo ⇒
                        %mi h
                      %annotation{:encoding => "application/x-tex"} \theta\colon g \Rightarrow h
                %em
                  %a.existingWikiWord{:href => "/nlab/show/vertical+composition"} vertical composite
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi θ
                        %mo •
                        %mi η
                        %mo{:lspace => "verythinmathspace"} :
                        %mi f
                        %mo ⇒
                        %mi h
                      %annotation{:encoding => "application/x-tex"} \theta \bullet \eta\colon f \Rightarrow h
            %li
              %p
                for each
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                      %annotation{:encoding => "application/x-tex"} a,b,c
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi a
                        %mo →
                        %mi b
                      %annotation{:encoding => "application/x-tex"} f\colon a \to b
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ,
                        %mi h
                        %mo{:lspace => "verythinmathspace"} :
                        %mi b
                        %mo →
                        %mi c
                      %annotation{:encoding => "application/x-tex"} g,h\colon b \to c
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo{:lspace => "verythinmathspace"} :
                        %mi g
                        %mo ⇒
                        %mi h
