                  K(-, -)
                  \\;\colon\;
                  K^{op} \times K
                  \\longrightarrow
                  Cat
          %p
            such that composing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(-, -)
            with the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ob
                  %mo :
                  %mi Cat
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} ob: Cat \to Set
            (the one sending a category to its set of objects) gives
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi hom
                      %mi K
                    %mo :
                    %msup
                      %mi K
                      %mi op
                    %mo ×
                    %mi K
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \hom_K: K^{op} \times K \to Set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a, b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(a, b)
            are
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msub
                      %mi hom
                      %mi K
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in \hom_K(a, b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(a, b)
            are
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "-source" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            = succeed "-target" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(a, b)
            corresponds to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/vertical+composition"} vertical composition
          %p
            For each object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            and each morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi b
                  %mo →
                  %mi c
                %annotation{:encoding => "application/x-tex"} h: b \to c
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(a, h): K(a, b) \to K(a, c)
            = succeed ";" do
              %em
                right
                %a.existingWikiWord{:href => "/nlab/show/whiskering"} whiskering
            %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            (a morphism of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(a, b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo ▹
                  %mi η
                %annotation{:encoding => "application/x-tex"} h \triangleright \eta
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(b, c)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            and morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi a
                    %mo →
                    %mi b
                  %annotation{:encoding => "application/x-tex"} f: a \to b
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(f, c): K(b, c) \to K(a, c)
            = succeed ";" do
              %em
                left
                %a.existingWikiWord{:href => "/nlab/show/whiskering"} whiskering
            %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            (a morphism of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(b, c)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo ◃
                  %mi f
                %annotation{:encoding => "application/x-tex"} \eta \triangleleft f
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(a, c)
          %p
            The long list of compatibility properties enumerated in the previous subsection, all except the last, are concisely summarized in the definition of sesquicategory as recalled above. For example, property (8) just says that left
            %a.existingWikiWord{:href => "/nlab/show/whiskering"} whiskering
            preserves
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vertical+composition"} vertical composition
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            (a morphism in
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
          %p
            In summary, a sesquicategory consists of “stuff” and structure as described in the
            = succeed "," do
              %a{:href => "/nlab/show/strict+2-category#detailedDefn"} previous subsection
            %a.existingWikiWord{:href => "/nlab/show/interchange+axiom"} interchange axiom
            (12). Some further illumination of this point of view can be obtained by contemplating
            %a.existingWikiWord{:href => "/nlab/show/string+diagrams"} string diagrams
            for 2-categories, where the
            %a.existingWikiWord{:href => "/nlab/show/interchange+axiom"} interchange axiom
            corresponds to
            %a.existingWikiWord{:href => "/nlab/show/isotopies"} isotopies
            of (planar, progressive) string diagrams during which the relative heights of nodes labeled by 2-cells are interchanged.
          %h2#remarks Remarks
          %ul
            %li
              %p
                Strict 2-categories are the same as a
                %a.existingWikiWord{:href => "/nlab/show/strict+omega-categories"} strict omega-categories
                which are trivial in degree
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 3
                      %annotation{:encoding => "application/x-tex"} n \geq 3
            %li
              %p
                This is to be contrasted with a
                %em weak 2-category
                called a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
          %h2#in_dependent_type_theory In dependent type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
          %ul
            %li
              A strict 2-category could be a
              %a.existingWikiWord{:href => "/nlab/show/precategory"} precategory
              enriched over the
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              of
              %a.existingWikiWord{:href => "/nlab/show/strict+categories"} strict categories
            %li
              A strict 2-category could be a
              %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict category
              enriched over the cartesian monoidal category Cat of strict categories
            %li
              A strict 2-category could be a
              %a.existingWikiWord{:href => "/nlab/show/univalent+category"} univalent category
              enriched over the cartesian monoidal category Cat of strict categories
          %p
            The first definition is a naive translation of “strict 2-category” from set theory to dependent type theory, but in the absence of
            %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
            or a similar axiom, these strict 2-categories behave differently from the strict 2-categories as defined in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            %a.existingWikiWord{:href => "/nlab/show/0-truncation"} 0-truncation
            condition to the type of objects to ensure that the strict 2-categories actually behave like the strict 2-categories in set theory. The third definition satisfies the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/h-groupoids"} h-groupoids
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/strict+2-groupoid"} strict 2-groupoid
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/strict+2-functor"} strict 2-functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/strict+2-natural+transformation"} strict 2-natural transformation
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/strict+adjoint+2-functor"} strict adjoint 2-functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/strict+2-group"} strict 2-group
          %h2#history History
          %p
            As intimated above, the essential rules which abstractly govern the behavior of functors and natural transformations and their various compositions were made explicit by
            = succeed "," do
              %a{:href => "#Godement58"} Godement (1958)
            = succeed "." do
              %a{:href => "#Bénabou65"} Bénabou (1965)
            %a{:href => "#Godement58"} Godement (1958)
            were what we call
            %em
              %a.existingWikiWord{:href => "/nlab/show/vertical+composition"} vertical composition
            and
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/whiskering"} whiskering
            %a.existingWikiWord{:href => "/nlab/show/horizontal+composition"} horizontal composition
            of
            %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            being a derived operation (made unambiguous in the presence of the interchange axiom). Indeed,
            %a.existingWikiWord{:href => "/nlab/show/horizontal+composition"} horizontal composition
            is often called the
            = succeed "." do
              %em Godement product
          %p
            A few years after introducing 2-categories, Bénabou introduced the more general notion of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/bicategories"} bicategories
          %p
            Literature references for the abstract notion of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sesquicategory"} sesquicategory
            %a{:href => "#Street96"} Street (1996)
            together with the observation that 2-categories are special types of sesquicategories (page 535).
          %h2#References References
          %p
            The “five rules of functorial calculus” (
            %a{:href => "#AsSesquicategories"}> above
            ) were formulated (as:
            = succeed ")" do
              %em cinq règles de calcul fonctoriel
          %ul
            %li#Godement58
              %a.existingWikiWord{:href => "/nlab/show/Roger+Godement"}> Roger Godement
              , Appendice (pp. 269) of:
              = succeed "," do
                %em Topologie algébrique et theorie des faisceaux
              = succeed "," do
                %strong 1252
              = succeed "," do
                %a{:href => "https://www.editions-hermann.fr/livre/topologie-algebrique-et-theorie-des-faisceaux-roger-godement"} webpage
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Godement-TopologieAlgebrique.pdf", :title => "pdf"} pdf
          %p
            The definition of “
            %a.existingWikiWord{:href => "/nlab/show/double+categories"}> double categories
            ” (of which, at least in hindsight, strict 2-categories are an immediate special case) is due to:
          %ul
            %li#Ehresmann63
              %a.existingWikiWord{:href => "/nlab/show/Charles+Ehresmann"}> Charles Ehresmann
              ,
              = succeed "," do
                %em Catégories double et catégories structurées
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/files/Ehresmann-CategoriesDoubles.pdf", :title => "pdf"} pdf
              = succeed "&rbrack;" do
                %a{:href => "https://gallica.bnf.fr/ark:/12148/bpt6k3208j/f1246"} gallica
          %p
            also discussed (according to
            %a{:href => "https://www.jstor.org/stable/2314770"} reviewers
            who have seen the text) in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Charles+Ehresmann"}> Charles Ehresmann
              ,
              = succeed "," do
                %em Catégories et structures
          %p However, Ehresmann did not isolate the notion of strict 2-categories as such.
          %p
            But apparently inspired by
            %a{:href => "#Ehresmann63"} Ehresmann (1963)
            the actual definition of strict 2-categories is due to:
          %ul
            %li{:id => "Bénabou65"}
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"}> Jean Bénabou
                , Example (5) of:
                = succeed "," do
                  %em Catégories relatives
                %strong 260
                (1965) 3824-3827 &amp;lbrack;
                %a{:href => "https://gallica.bnf.fr/ark:/12148/bpt6k4019v/f37.item"}> gallica
                \&amp;rbrack;
              %blockquote
                %p
                  (conceived as
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
                  %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
                  and under the name “2-categories”)
            %li#Maranda65
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Marie+Maranda"}> Jean-Marie Maranda
                , Def. 1 in:
                = succeed "," do
                  %em Formal categories
                %strong 17
                (1965) 758-801 &amp;lbrack;
                %a{:href => "https://doi.org/10.4153/CJM-1965-076-0"}> doi:10.4153/CJM-1965-076-0
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://www.cambridge.org/core/services/aop-cambridge-core/content/view/A7C463460EB8CAC64C2CA340F870CF80/S0008414X00039729a.pdf/formal-categories.pdf"} pdf
              %blockquote
                %p
                  (conceived as
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
                  %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
                  and under the name “categories of the second type”)
            %li#EK65
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/G.+Max+Kelly"} G. Max Kelly
                = succeed "," do
                  %em Closed Categories
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"} S. Eilenberg
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/D.+K.+Harrison"} D. K. Harrison
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/S.+MacLane"} S. MacLane
                %a.existingWikiWord{:href => "/nlab/show/H.+R%C3%B6hrl"} H. Röhrl
                (eds.):
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Proceedings+of+the+Conference+on+Categorical+Algebra+-+La+Jolla+1965"} Proceedings of the Conference on Categorical Algebra - La Jolla 1965
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-642-99902-4"} doi:10.1007/978-3-642-99902-4
              %blockquote
                %p
                  (expressed entirely in components and under the name
                  = succeed ")" do
                    %em hypercategories
          %p
            and the notion is invoked for various purposes (such as in speaking of
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            as a 2-category) in:
          %ul
            %li{:id => "Bénabou68"}
              %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"}> Jean Bénabou
              ,
              = succeed "," do
                %em Structures algébriques dans les catégories
              %strong 10
              1 (1968) 1-126 &amp;lbrack;
              %a{:href => "http://www.numdam.org/item/?id=CTGDC_1968__10_1_1_0"}> doi:CTGDC_1968__10_1_1_0
              \&amp;rbrack;
          %p Exposition and review:
          %ul
            %li#Street96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
                , p. 535 in:
                = succeed "," do
                  %em Categorical Structures
                = succeed "," do
                  %a{:href => "https://doi.org/10.1016/S1570-7954(96)80019-2"} doi:10.1016/S1570-7954(96)80019-2
                = succeed "," do
                  %a{:href => "http://maths.mq.edu.au/~street/45.pdf"} pdf
