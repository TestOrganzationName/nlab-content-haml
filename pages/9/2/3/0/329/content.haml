            %li
              %p
                for each
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi a
                        %mo →
                        %mi b
                      %annotation{:encoding => "application/x-tex"} f\colon a \to b
                %em identity
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 1
                        %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi f
                      %mo ⇒
                      %mi f
                    %annotation{:encoding => "application/x-tex"} 1_f\colon f \Rightarrow f
                or
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} Id
                          %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi f
                        %mo ⇒
                        %mi f
                      %annotation{:encoding => "application/x-tex"} \Id_f\colon f \Rightarrow f
            %li
              %p
                for each
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ,
                        %mi g
                        %mo ,
                        %mi h
                        %mo{:lspace => "verythinmathspace"} :
                        %mi a
                        %mo →
                        %mi b
                      %annotation{:encoding => "application/x-tex"} f,g,h\colon a \to b
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo{:lspace => "verythinmathspace"} :
                        %mi f
                        %mo ⇒
                        %mi g
