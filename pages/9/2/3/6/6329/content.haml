          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#formulation"} Formulation
              %ul
                %li
                  %a{:href => "#with_global_time"} With global time
                %li
                  %a{:href => "#without_time"} Without time
                %li
                  %a{:href => "#in_local_field_theory"} In local field theory
              %li
