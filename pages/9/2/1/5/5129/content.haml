          %h2#definitions Definitions
          %p
          .num_defn
            %h6 Definition
            %p
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} p,q \in \mathbb{N}
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p,q)
                \-shuffle
              is a
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi μ
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi μ
                      %mi p
                    %mo ,
                    %msub
                      %mi ν
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi ν
                      %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\mu_1, \cdots, \mu_p, \nu_1, \cdots, \nu_q)
            %p
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi p
                    %mo +
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,2, \cdots, p+q)
              subject to the condition that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 1
                    %mo &lt;
                    %msub
                      %mi μ
                      %mn 2
                    %mo &lt;
                    %mi ⋯
                    %mo &lt;
                    %msub
                      %mi μ
                      %mi p
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_1 \lt \mu_2 \lt \cdots \lt \mu_p
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ν
                      %mn 1
                    %mo &lt;
                    %msub
                      %mi ν
                      %mn 2
                    %mo &lt;
                    %mi ⋯
                    %mo &lt;
                    %msub
                      %mi ν
                      %mi q
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\nu_1 \lt \nu_2 \lt \cdots \lt \nu_q
                    \\,.
            %p
              In more formal terms, a
              = succeed "-shuffle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
