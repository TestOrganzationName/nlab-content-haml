            relating the various
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,q)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/shuffles"} shuffles
          %p
            For example, consider this
            = succeed "-shuffle:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo &lt;
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo &lt;
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo &lt;
                          %mn 2
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{matrix}
                  (0\lt 1) &amp;-&amp; (0\lt 2) &amp;-&amp; (1\lt 2)
                  \\end{matrix}
          %p
            (This
            %a.existingWikiWord{:href => "/nlab/show/Hasse+diagram"} Hasse diagram
            has been laid out horizontally to save space. The bottom is to the left. The vertex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo &lt;
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (0\lt 1)
            corresponds to the shuffle with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 1
                    %mo =
                    %mn 0
                    %mo ,
                    %msub
                      %mi μ
                      %mn 1
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \mu_1 = 0, \mu_1 = 1
          %p
            We need here to explain the partial order. We take the ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            \-signature’ of the shuffle, that is, the ordered set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 1
                    %mo &lt;
                    %mi …
                    %mo &lt;
                    %msub
                      %mi μ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mu_1\lt\ldots \lt \mu_p
            = succeed "-signature" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
          .num_defn
            %h6#definition Definition
            %p
              Given two
              = succeed "-shuffles," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p,q)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %mo ,
                    %mi ν
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mu, \nu)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi μ
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                      %mo ,
                      %mi ν
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mu\prime,\nu\prime)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %mo ,
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                    %mo ,
                    %mi ν
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mu, \nu) \leq (\mu\prime,\nu\prime)
            %p
              if, for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              in the range
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ≤
                      %mi i
                      %mo ≤
                      %mi p
                    %annotation{:encoding => "application/x-tex"} 1\leq i\leq p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi i
                    %mo ≤
                    %msub
                      %mi μ
                      %mi i
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \mu_i \leq \mu_i\prime.
              We refer to this poset as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Shuff
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo ≤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Shuff(p,q),\leq)
          %p
            Going to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Shuff
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ≤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Shuff(3,1),\leq)
            = succeed "-shuffles," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (3,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} q = 1
            will mean that this poset is again
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/linear+order"} linear
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo &lt;
                          %mn 1
                          %mo &lt;
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo &lt;
                          %mn 1
                          %mo &lt;
                          %mn 3
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo &lt;
                          %mn 2
                          %mo &lt;
                          %mn 3
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo &lt;
                          %mn 2
                          %mo &lt;
                          %mn 3
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{matrix}
                  (0 \lt 1 \lt 2) &amp;-&amp; (0 \lt 1 \lt 3)&amp; - &amp;(0 \lt 2 \lt 3)&amp; - &amp;(1 \lt 2 \lt 3)
                  \\end{matrix}
          %p This is true in general:
          .num_lemma
            %h6#lemma Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p = 1
              or
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} q = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Shuff
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ≤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Shuff(p,q),\leq)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/linear+order"} linear poset
          .proof
            %h6#proof Proof
            %p
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi μ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu = (\mu_1)
              is a singleton, and the poset will be:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mtd
                            %mi …
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi q
                            %mo{:stretchy => "false"} )
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{matrix}
                    (0) &amp; - &amp; (1) &amp; - &amp; \ldots &amp; - &amp; (q).
                    \\end{matrix}
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} q = 1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ν
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ν
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \nu = (\nu_1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo &lt;
                            %mn 1
                            %mo &lt;
                            %mi …
                            %mo &lt;
                            %mi p
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo &lt;
                            %mn 1
                            %mo &lt;
                            %mi …
                            %mo &lt;
                            %mi p
                            %mo −
                            %mn 2
                            %mo &lt;
                            %mi p
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mtd
                            %mi …
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo &lt;
                            %mi …
                            %mo &lt;
                            %mi p
                            %mo{:stretchy => "false"} )
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{matrix}
                    (0 \lt 1 \lt \ldots \lt p-1) &amp; - &amp; (0 \lt 1 \lt \ldots \lt p-2 \lt p) &amp; - &amp; \ldots &amp; - &amp; (1 \lt \ldots \lt p),
                    \\end{matrix}
            %p
              where at each stage one misses out the single
              = succeed "-value." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ν
                    %annotation{:encoding => "application/x-tex"} \nu
          %p
            In all cases, each position is obtained from the one immediately to its ‘left’ by increasing
            %em one
            value, yet remaining with a shuffle. This is more clearly seen in the (2,2) example, which is no longer
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/linear+order"} linear
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo ,
                          %mn 2
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} |
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} |
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} |
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} |
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} |
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} |
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{matrix}
                  (0,2) &amp; - &amp; (1,2) &amp; - &amp; (2,2) \\
                  | &amp; &amp; | &amp; &amp; | \\
                  (0,1) &amp; - &amp; (1,1) &amp; - &amp; (2,1) \\
                  | &amp; &amp; | &amp; &amp; | \\
                  (0,0) &amp; - &amp; (1,0) &amp; - &amp; (2,0)
                  \\end{matrix}
          %p
            We can then look at the shuffle poset, noting again that it is not
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/linear+order"} linear
          %svg{:height => "88.916", :viewbox => "0 0 282.909 88.916", :width => "282.909", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
            %defs
              %g
                %g{:id => "H03RwfgYWA03Ed-e4SqgpGO2W9o=-glyph-0-0"}
                %g{:id => "H03RwfgYWA03Ed-e4SqgpGO2W9o=-glyph-0-1"}
                  %path{:d => "M 3.890625 2.90625 C 3.890625 2.875 3.890625 2.84375 3.6875 2.640625 C 2.484375 1.4375 1.8125 -0.53125 1.8125 -2.96875 C 1.8125 -5.296875 2.375 -7.296875 3.765625 -8.703125 C 3.890625 -8.8125 3.890625 -8.828125 3.890625 -8.875 C 3.890625 -8.9375 3.828125 -8.96875 3.78125 -8.96875 C 3.625 -8.96875 2.640625 -8.109375 2.0625 -6.9375 C 1.453125 -5.71875 1.171875 -4.453125 1.171875 -2.96875 C 1.171875 -1.90625 1.34375 -0.484375 1.953125 0.78125 C 2.671875 2.21875 3.640625 3 3.78125 3 C 3.828125 3 3.890625 2.96875 3.890625 2.90625 Z M 3.890625 2.90625 "}
