          %p
            The subgraph of those with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 3
                    %mo =
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} \mu_3 = 4
            = succeed "-example," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,2)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 3
                    %mo =
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} \mu_3 = 3
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Shuff
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Shuff(3,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Shuff
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Shuff(2,1)
            and so on. Taking
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Shuff
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 3
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} Shuff(2,1) \times \{3\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Shuff
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} {
                  %mn 4
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} Shuff(2,1) \times \{4\}
            within the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mn 3
                  %mo =
                  %mn 4
                %annotation{:encoding => "application/x-tex"} \mu_3 = 4
            block, the matching being given by, for instance,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ↔
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,1,3)\leftrightarrow(0,1,4)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 3
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 3
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 3
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mn 3
                  %mo ,
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mn 3
                  %mo ,
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 3
                  %mo ,
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (0,1,2)-(0,1,3) - (1,2,3)-(0,2,3)-(2,3,4)-(1,3,4)-(0,3,4) - (0,2,4) - (1,2,4) - (0,1,4),
          %p which is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Shuff
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⊕
                  %mi Shuff
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mn 2
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ×
                  %mo{:stretchy => "false"} {
                  %mn 4
                  %mo{:stretchy => "false"} }
                  %mo ,
                %annotation{:encoding => "application/x-tex"} Shuff(3,1)\oplus Shuff(2,2)^{op}\times \{4\},
          %p the ordinal sum, or join, of the anti-lex ordered shuffle sets. This sort of decomposition is quite general.
