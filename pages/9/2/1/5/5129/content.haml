                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(V)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+graded+Hopf+algebra"} differential graded Hopf algebra
          %h3#in_algebras
            In
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            In the definition of
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
            the
            %em unshuffle
            side of shuffles is used.
          %h2#Properties Properties
          %h3#basic_properties Basic properties
          %p
          #NumberOfShuffles.num_remark
            %h6 Remark
            %p
              %strong (number of shuffles)
              %br/
              The number of
              = succeed "-shuffles" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p,q)
              %a.existingWikiWord{:href => "/nlab/show/binomial+coefficient"} binomial coefficient
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo #
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                        %mrow
                          %mi p
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \#
                    Sh(p,q)
                    \\;\;=\;\;
                    \\left(
                    {p + q} \atop p
                    \\right)
                    \\,.
            %p
              Because, due to the preservation of order in the two “decks”, a shuffle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Aut
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi p
                    %mo +
                    %mi q
                    %mo{:stretchy => "false"} }
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \sigma \in Sh(p,q)  \subset Aut\big(\{1, \cdots, p + q\}\big)
              is fully determined by which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi p
                    %mo +
                    %mi q
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{1, \cdots, p + q\}
              are in the image of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mi p
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{1, \cdots p\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              out of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p + q
              elements.
          %h3#the_poset_of_shuffles
            The poset of
            = succeed "-shuffles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
