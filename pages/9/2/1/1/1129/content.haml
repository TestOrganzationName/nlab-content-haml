            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              an
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              the class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              of monomorphisms is the same as the class of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : A \to B
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi A
                    %mover
                      %mo →
                      %mi f
                    %mi B
                  %annotation{:encoding => "application/x-tex"} 0 \to A \stackrel{f}{\to} B
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
          .proof
            %h6#proof Proof
            %p
              By definition of
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              every monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↪
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \hookrightarrow B
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\to&amp; 0
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    B &amp;\to&amp; C
                    }
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              the (algebraic)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              %a{:href => "http://ncatlab.org/nlab/show/pullback#Pasting"} pasting law
              for pullbacks we find that also the left square in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    0 &amp;\to&amp; A &amp;\to&amp; 0
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    0 &amp;\to&amp; B &amp;\to&amp; C
                    }
            %p
              is a pullback, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} 0 \to A \to B
              is exact.
          #EquivalentCharacterizationOfInjectivesInAbelianCategories.num_cor
            %h6#corollary Corollary
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              of an abelian category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is then
              %strong injective
              if it satisfies the following equivalent conditions:
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msup
                          %mi C
                          %mi op
                        %mo →
                        %mi.mathscript 𝒜𝒷
                      %annotation{:encoding => "application/x-tex"} Hom_C(-, I) : C^{op} \to \mathscr{Ab}
                  is
                  %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi.mathscript 𝒜𝒷
                      %annotation{:encoding => "application/x-tex"} \mathscr{Ab}
                  is the category of abelian groups;
              %li
                %p
                  for all
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f : X \to Y
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo →
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} 0 \to X \to Y
                  is
                  %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
                  and for all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo :
                          %mi X
                          %mo →
                          %mi I
                        %annotation{:encoding => "application/x-tex"} k : X \to I
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo :
                        %mi Y
                        %mo →
                        %mi I
                      %annotation{:encoding => "application/x-tex"} h : Y \to I
                  such that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi h
                          %mo ∘
                          %mi f
                          %mo =
                          %mi k
                        %annotation{:encoding => "application/x-tex"} h\circ f = k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi k
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∃
                                  %mi h
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    0 &amp;\to&amp; X &amp;\stackrel{f}{\to}&amp; Y
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{k}} &amp; \swarrow_{\mathrlap{\exists h}}
                    \\\
                    \&amp;&amp;
                    I
                    }
                    \\,.
          %p
            By the
            %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
            of
            = succeed "." do
              %a{:href => "projective+module#NProjectiveIFFHomNExact"} this prop.
          %h3#in_chain_complexes In chain complexes
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/homotopically+injective+object"} homotopically injective object
            for a relevant generalization to categories of chain complexes, and its relationship to ordinary injectivity.
          %h2#examples Examples
          %h3#InjectiveModules Injective modules
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mi R
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} C = R Mod
            the category of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            %a.existingWikiWord{:href => "/nlab/show/injective+modules"} injective modules
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            (see there for more).
          %p
            The following criterion says that for identifying
            %a.existingWikiWord{:href => "/nlab/show/injective+modules"} injective modules
            it is sufficient to test the
            %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
            which characterizes injective objects by def.
            = succeed "," do
              %a.maruku-ref{:href => "#InjectiveObjects"}
            %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
            which include an
            %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
            into the base ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          #BaerTheorem.num_theorem
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Baer%27s+criterion"}> Baer's criterion
                )
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              holds, then a
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo ∈
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} Q \in R Mod
              is an
              %a.existingWikiWord{:href => "/nlab/show/injective+module"} injective module
              precisely if for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              any left
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
              regarded as an
              = succeed "-module," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi I
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} g : I \to Q
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              can be extended to all of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              along the inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ↪
                      %mi R
                    %annotation{:encoding => "application/x-tex"} I \hookrightarrow R
          %p
            This is due to (
            %a{:href => "#Baer"}> Baer
            ).
          .proof
            %h6#sketch_of_proof Sketch of proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %mo ↪
                    %mi N
                  %annotation{:encoding => "application/x-tex"} i \colon M \hookrightarrow N
              be a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} R Mod
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} f \colon M \to Q
              be a map. We must extend
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to a map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo{:lspace => "verythinmathspace"} :
                      %mi N
                      %mo →
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} h \colon N \to Q
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              whose elements are pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ′
                    %mo ,
                    %mi f
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M', f')
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} M'
              is an intermediate
              %a.existingWikiWord{:href => "/nlab/show/submodule"} submodule
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %mo ′
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} f' \colon M' \to Q
              is an extension of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ′
                    %mo ,
                    %mi f
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ″
                    %mo ,
                    %mi f
                    %mo ″
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M', f') \leq (M'', f'')
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} M''
              contains
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} M'
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} f''
              extends
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} f'
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Zorn%27s+lemma"} Zorn's lemma
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/maximal+element"} maximal element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo ′
                      %mo ,
                      %mi f
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (M', f')
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} M'
              is not all of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi N
                  %annotation{:encoding => "application/x-tex"} x \in N
              be an element not in
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} M'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f'
              extends to a map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ″
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mi x
                      %mo{:stretchy => "false"} ⟩
                      %mo +
                      %mi M
                      %mo ′
                      %mo →
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} M'' = \langle x \rangle + M' \to Q
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contradiction"} contradiction
            %p
              The set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi r
                    %mo ∈
                    %mi R
                    %mo :
                    %mi r
                    %mi x
                    %mo ∈
                    %mi M
                    %mo ′
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{r \in R: r x \in M'\}
              is an ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi I
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} g \colon I \to Q
              defined by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
