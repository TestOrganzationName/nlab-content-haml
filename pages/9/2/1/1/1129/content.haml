                  %annotation{:encoding => "application/x-tex"} g(j) = \sup \{i \in I : i \leq j\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/split+monomorphism"} split monomorphism
            %a.maruku-ref{:href => "#InjectivesCharacterisedBySplitting"}
