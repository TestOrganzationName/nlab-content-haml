                      %mo ,
                      %mi I
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi ℰ
                      %mo ∘
                      %msub
                        %mi p
                        %mo !
                    %annotation{:encoding => "application/x-tex"} p_* \circ [-, p^*I]_{\mathcal{E}/A} \cong [-, I]_{\mathcal{E}} \circ p_!
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mo !
                  %annotation{:encoding => "application/x-tex"} p_!
              preserves monomorphisms, and one can check that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
