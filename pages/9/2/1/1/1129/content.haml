            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi B
                  %mo →
                  %mi I
                %annotation{:encoding => "application/x-tex"} g: B \to I
            which extends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
