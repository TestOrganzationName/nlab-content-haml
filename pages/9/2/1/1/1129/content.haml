                    \&amp;
                    \\nearrow_{\mathrlap{\exists}}
                    \&amp;
                    \\big\downarrow
                    \\\
                    Z
                    \&amp;\longrightarrow&amp;
                    *
                    }
            %p
              and hence the
              = succeed "-injective" do
