          #DirectSumInjectives.num_corollary
            %h6#corollary_2 Corollary
            %p
              (Assume that the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              holds.) Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Noetherian+ring"} Noetherian ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi Q
                      %mi j
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{Q_j\}_{j \in J}
              be a collection of
              %a.existingWikiWord{:href => "/nlab/show/injective+modules"} injective modules
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                    %msub
                      %mi Q
                      %mi j
                  %annotation{:encoding => "application/x-tex"} Q = \bigoplus_{j \in J} Q_j
              is also injective.
          .proof
            %h6#proof_2 Proof
            %p
              By Baer’s criterion, theorem
              = succeed "," do
                %a.maruku-ref{:href => "#BaerTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi I
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} f \colon I \to Q
              extends to a map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo →
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} R \to Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is Noetherian,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is
              %a.existingWikiWord{:href => "/nlab/show/finitely+generated+module"} finitely generated
              as an
              = succeed "-module," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi x
                        %mi n
                    %annotation{:encoding => "application/x-tex"} x_1, \ldots, x_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Q
                    %mo →
                    %msub
                      %mi Q
                      %mi j
                  %annotation{:encoding => "application/x-tex"} p_j \colon Q \to Q_j
              be the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi j
                      %mo =
                      %msub
                        %mi p
                        %mi j
                      %mo ∘
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f_j = p_j \circ f
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi i
                    %annotation{:encoding => "application/x-tex"} x_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_j(x_i)
              is nonzero for only finitely many summands. Taking all of these summands together over all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              factors through
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                        %mo ′
                    %msub
                      %mi Q
                      %mi j
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                        %mo ′
                    %msub
                      %mi Q
                      %mi j
                    %mo ↪
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} \prod_{j \in J'} Q_j = \bigoplus_{j \in J'} Q_j \hookrightarrow Q
            %p
              for some finite
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo ′
                      %mo ⊂
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J' \subset J
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              of injectives is injective, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              extends to a map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo →
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi j
                          %mo ∈
                          %mi J
                          %mo ′
                      %msub
                        %mi Q
                        %mi j
                    %annotation{:encoding => "application/x-tex"} R \to \prod_{j \in J'} Q_j
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Conversely,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a
              %a.existingWikiWord{:href => "/nlab/show/Noetherian+ring"} Noetherian ring
              if
              %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
              of injective
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
              are injective.
          %p
            This is due to Bass and Papp. See (
            %a{:href => "#Lam"}> Lam, Theorem 3.46
            ).
          %h3#injective_abelian_groups Injective abelian groups
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mi ℤ
                  %mi Mod
                  %mo ≃
                %annotation{:encoding => "application/x-tex"} C = \mathbb{Z} Mod \simeq
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            be the
            %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
          #InjectiveAbelianGroupIsDivisibleGroup.num_prop
            %h6#proposition_6 Proposition
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              holds, then an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is an injective object in
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              precisely if it is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/divisible+group"} divisible group
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mi G
                      %mo =
                      %mi G
                    %annotation{:encoding => "application/x-tex"} n G = G
          %p
            This follows for instance using
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Baer%27s+criterion"} Baer's criterion
            = succeed "." do
              %a.maruku-ref{:href => "#BaerTheorem"}
          %p
            An explicit proof is spelled out at
            %a{:href => "https://planetmath.org/abeliangroupisdivisibleifandonlyifitisaninjectiveobject"} Planet math – abelian group is divisible if and only if it is an injective object
          .num_example
            %h6#example_2 Example
            %p
              By prop.
              %a.maruku-ref{:href => "#InjectiveAbelianGroupIsDivisibleGroup"}
              the following
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              are injective in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            %p
              The group of
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              is injective in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              and generally that underlying any
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              of characteristic zero. The additive group underlying any
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              is injective. The
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of any injective group by any other group is injective.
          .num_example
            %h6#example_3 Example
            %p
              %strong Not
              injective in
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              is for instance the
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n\mathbb{Z}
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo &gt;
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \gt 1
          %h3#in_toposes In toposes
          %p
            In any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            is an injective object, as is any
            %a.existingWikiWord{:href => "/nlab/show/powering"} power
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            (
            %a.existingWikiWord{:href => "/nlab/show/Mac+Lane-Moerdijk"}> Mac Lane-Moerdijk
            , IV.10).
          %p
            Also one can define various notions of
            %em internally
            injective objects. These turn out to be equivalent:
          #EquivalenceOfInternalNotionsOfInjectivity.num_prop
            %h6#proposition_7 Proposition
            %p
              In any
              %a.existingWikiWord{:href => "/nlab/show/elementary+topos"} elementary topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              with a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} I \in \mathcal{E}
              are equivalent.
            %ol
              %li
                The functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi I
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %msup
                        %mi ℰ
                        %mi op
                      %mo →
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} [-, I] : \mathcal{E}^op \to \mathcal{E}
                maps monomorphisms in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
                to epimorphisms.
              %li
                The functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi I
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %msup
                        %mi ℰ
                        %mi op
                      %mo →
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} [-, I] : \mathcal{E}^op \to \mathcal{E}
                maps monomorphisms in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
                to morphisms for which any global element of the target locally (after
                %a.existingWikiWord{:href => "/nlab/show/change+of+base"} change of base
                along an epimorphism) possesses a preimage.
              %li
                For any morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi A
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p : A \to 1
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mo *
                      %mi I
                    %annotation{:encoding => "application/x-tex"} p^*I
                has property 1. as an object of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℰ
                        %mo{:stretchy => "false"} /
                        %mi A
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}/A
              %li
                For any morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi A
                      %mo →
