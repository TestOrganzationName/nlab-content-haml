          %title
          %p
            %strong Gregory Maxwell Kelly
            (1930-2007) was a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theorist
          %ul
            %li
              %a{:href => "http://en.wikipedia.org/wiki/Max_Kelly"} Wikipedia entry
          %h2#selected_writings Selected writings
          %p
            Precursor discussion towards the notion of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gregory+Maxwell+Kelly"}> Gregory Maxwell Kelly
              \.
              = succeed "." do
                %em Tensor products in categories
              %strong 2
              1 (1965) 15-37 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0021-8693(65)90022-0"}> doi:10.1016/0021-8693(65)90022-0
              \&amp;rbrack;
          %p
            Introducing the notion of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/closed+categories"} closed categories
          %ul
            %li#EilenbergKelly66
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/G.+Max+Kelly"} G. Max Kelly
              = succeed "," do
                %em Closed Categories
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"} S. Eilenberg
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/D.+K.+Harrison"} D. K. Harrison
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/S.+MacLane"} S. MacLane
              %a.existingWikiWord{:href => "/nlab/show/H.+R%C3%B6hrl"} H. Röhrl
              (eds.):
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Proceedings+of+the+Conference+on+Categorical+Algebra+-+La+Jolla+1965"} Proceedings of the Conference on Categorical Algebra - La Jolla 1965
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/978-3-642-99902-4"} doi:10.1007/978-3-642-99902-4
          %p
            Introducing the notions of
            %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
            in general
            %a.existingWikiWord{:href => "/nlab/show/2-categories"} 2-categories
            and of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/enriched+adjoint+functors"} enriched adjoint functors
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"}> Max Kelly
              ,
              = succeed "," do
                %em Adjunction for enriched categories
              = succeed "," do
                %em Reports of the Midwest Category Seminar III
              = succeed "," do
                %strong 106
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/BFb0059145"} doi:10.1007/BFb0059145
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor+categories"} enriched functor categories
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Brian+Day"}> Brian Day
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"} Max Kelly
              = succeed "," do
                %em Enriched functor categories
              = succeed "," do
                %em Reports of the Midwest Category Seminar III
              %strong 106
              (1969) 178-191 &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/BFb0059146"}> doi:10.1007/BFb0059146
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://link.springer.com/content/pdf/10.1007/BFb0059146.pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            and
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            and
            %a.existingWikiWord{:href => "/nlab/show/exponential+objects"} exponential objects
            in the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
          %ul
            %li#DayKelly
              %a.existingWikiWord{:href => "/nlab/show/Brian+Day"}> Brian Day
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/G.+Max+Kelly"} G. Max Kelly
              = succeed "," do
                %em On topological quotients preserved by pullback or products
              %strong 67
              3 (1970) 553 - 558 (
              %a{:href => "https://doi.org/10.1017/S0305004100045850"}> doi:10.1017/S0305004100045850
              )
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/continuous+functors"} continuous functors
            (and introducing the notion of
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+systems"} orthogonal factorization systems
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+Freyd"}> Peter Freyd
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"} Max Kelly
              = succeed "," do
                %em Categories of continuous functors
              %strong 2
              (1972) 169-191 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0022-4049(72)90001-1"}> doi:10.1016/0022-4049(72)90001-1
              \&amp;rbrack;
          %p
            Introducing the notion of
            %a.existingWikiWord{:href => "/nlab/show/weighted+limits"} weighted limits
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"}> Francis Borceux
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gregory+Maxwell+Kelly"} Gregory Maxwell Kelly
              = succeed "," do
                %em A notion of limit for enriched categories
              %strong 12
              1 (1975) 49-72 &amp;lbrack;
              %a{:href => "https://doi.org/10.1017/S0004972700023637"}> doi:10.1017/S0004972700023637
              \&amp;rbrack;
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/coherence+theorem"} coherence theorem
            for
            %a.existingWikiWord{:href => "/nlab/show/compact+closed+categories"} compact closed categories
            (cf.
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/coherence+theorem+for+monoidal+categories"} coherence theorem for monoidal categories
          %ul
            %li#KellyLaplaza80
              %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"}> Max Kelly
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/M.+L.+Laplaza"} M. L. Laplaza
              = succeed "," do
                %em Coherence for compact closed categories
              %strong 19
              193-213 (1980) &amp;lbrack;
              %a{:hef => "https://doi.org/10.1016/0022-4049(80)90101-2"}> doi:10.1016/0022-4049(80)90101-2
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://core.ac.uk/download/pdf/82696829.pdf"} pdf
          %p
            Proof that the
            %a.existingWikiWord{:href => "/nlab/show/funny+tensor+product"} funny tensor product
            of
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            is the only other
            %a.existingWikiWord{:href => "/nlab/show/symmetric+closed+monoidal+category"} symmetric closed monoidal structure
            on
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            besides the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal structure
          %ul
            %li#FoltzLairKelly80
              %a.existingWikiWord{:href => "/nlab/show/Fran%C3%A7ois+Foltz"}> François Foltz
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Christian+Lair"} Christian Lair
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/G.+M.+Kelly"} G. M. Kelly
              = succeed "," do
                %em Algebraic categories with few monoidal biclosed structures or none
              %strong 17
              2 (1980) 171-177 &amp;lbrack;
              %a{:href => "https://core.ac.uk/download/pdf/82322397.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/0022-4049(80)90082-1"} doi:10.1016/0022-4049(80)90082-1
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"}> Max Kelly
                ,
                = succeed "," do
                  %em Basic Concepts of Enriched Category Theory
              %p
                Republished as: Reprints in Theory and Applications of Categories, No. 10 (2005) pp. 1-136 (
                %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/10/tr10abs.html"}> tac:10
                ,
                = succeed ")" do
                  %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/10/tr10.pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/sketches"} sketches
            and
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+categories"} locally presentable categories
            in the generality of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
          %ul
            %li#Kelly82
              %a.existingWikiWord{:href => "/nlab/show/G.+Max+Kelly"}> G. Max Kelly
              ,
              = succeed "," do
                %em Structures defined by finite limits in the enriched context, I
              %strong 23
              1 (1982) 3-42 &amp;lbrack;
              %a{:href => "http://archive.numdam.org/item/CTGDC_1982__23_1_3_0"}> numdam:CTGDC_1982__23_1_3_0
              \&amp;rbrack;
          %p
