                %mrow
                  %mfrac
                    %mrow
                      %mi d
                      %mi f
                    %mrow
                      %mi d
                      %mi x
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi c
                %annotation{:encoding => "application/x-tex"} \frac{d f}{d x}(0) = c
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %msup
                        %mi d
                        %mn 2
                      %mi f
                    %mrow
                      %mi d
                      %msup
                        %mi x
                        %mn 2
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 2
                  %mi b
                %annotation{:encoding => "application/x-tex"} \frac{d^2 f}{d x^2}(0) = 2 b
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %msup
                        %mi d
                        %mn 3
                      %mi f
                    %mrow
                      %mi d
                      %msup
                        %mi x
                        %mn 3
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 6
                  %mi a
                %annotation{:encoding => "application/x-tex"} \frac{d^3 f}{d x^3}(0) = 6 a
          %h2#properties Properties
          %h3#extrema Extrema
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            of a real cubic function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f:\mathbb{R} \to \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi a
                  %msup
                    %mi x
                    %mn 3
                  %mo +
                  %mi b
                  %msup
                    %mi x
                    %mn 2
                  %mo +
                  %mi c
                  %mi x
                  %mo +
                  %mi d
                %annotation{:encoding => "application/x-tex"} f(x) \coloneqq a x^3 + b x^2 + c x + d
            for real numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} a \in \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b \in \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} c \in \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} d \in \mathbb{R}
            is the function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi x
                    %mi f
                    %mo :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \delta_x f:\mathbb{R} \to \mathbb{R}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi x
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mn 3
                    %mi a
                    %msup
                      %mi x
                      %mn 2
                    %mo +
                    %mn 2
                    %mi b
                    %mi x
                    %mo +
                    %mi c
                  %annotation{:encoding => "application/x-tex"} \delta_x f(x) \coloneqq 3a x^2 + 2b x + c
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mo ∂
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi b
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo −
                    %mn 4
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mi c
                    %mo =
                    %mn 4
                    %msup
                      %mi b
                      %mn 2
                    %mo −
                    %mn 12
                    %mi a
                    %mi c
                  %annotation{:encoding => "application/x-tex"} \Delta_\partial = (2b)^2 - 4 (3a) c = 4b^2 - 12a c
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mo ∂
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Delta_\partial \gt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is
            %a.existingWikiWord{:href => "/nlab/show/monotonic"} monotonic
            on the entire domain of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \gt 0
            %a.existingWikiWord{:href => "/nlab/show/antitonic"} antitonic
            on the entire domain if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \lt 0
          %p
            Using the
            = succeed "," do
              %span.newWikiWord
                smooth quadratic formula
                %a{:href => "/nlab/new/smooth+quadratic+formula"} ?
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 1
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 2
                      %mi b
                      %mo +
                      %msub
                        %mi{:mathvariant => "normal"} sqrt
                        %mi{:mathvariant => "normal"} sm
                      %mo{:stretchy => "false"} (
                      %mn 4
                      %msup
                        %mi b
                        %mn 2
                      %mo −
                      %mn 12
                      %mi a
                      %mi c
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mn 6
                      %mi a
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 2
                      %mi b
                      %mo +
                      %mn 2
                      %msub
                        %mi{:mathvariant => "normal"} sqrt
                        %mi{:mathvariant => "normal"} sm
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi b
                        %mn 2
                      %mo −
                      %mn 3
                      %mi a
                      %mi c
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mn 6
                      %mi a
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi b
                      %mo +
                      %msub
                        %mi{:mathvariant => "normal"} sqrt
                        %mi{:mathvariant => "normal"} sm
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi b
                        %mn 2
                      %mo −
                      %mn 3
                      %mi a
                      %mi c
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mn 3
                      %mi a
                %annotation{:encoding => "application/x-tex"} x_1 = \frac{-2b + \mathrm{sqrt}_\mathrm{sm}(4b^2 - 12a c)}{6a} = \frac{-2b + 2 \mathrm{sqrt}_\mathrm{sm}(b^2 - 3a c)}{6a} = \frac{-b + \mathrm{sqrt}_\mathrm{sm}(b^2 - 3a c)}{3a}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 2
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 2
                      %mi b
                      %mo −
                      %msub
                        %mi{:mathvariant => "normal"} sqrt
                        %mi{:mathvariant => "normal"} sm
                      %mo{:stretchy => "false"} (
                      %mn 4
                      %msup
                        %mi b
                        %mn 2
                      %mo −
                      %mn 12
                      %mi a
                      %mi c
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mn 6
                      %mi a
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 2
                      %mi b
                      %mo −
                      %mn 2
                      %msub
                        %mi{:mathvariant => "normal"} sqrt
                        %mi{:mathvariant => "normal"} sm
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi b
                        %mn 2
                      %mo −
                      %mn 3
                      %mi a
                      %mi c
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mn 6
                      %mi a
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi b
                      %mo −
                      %msub
                        %mi{:mathvariant => "normal"} sqrt
                        %mi{:mathvariant => "normal"} sm
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi b
                        %mn 2
                      %mo −
                      %mn 3
                      %mi a
                      %mi c
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mn 3
                      %mi a
                %annotation{:encoding => "application/x-tex"} x_2 = \frac{-2b - \mathrm{sqrt}_\mathrm{sm}(4b^2 - 12a c)}{6a} = \frac{-2b - 2 \mathrm{sqrt}_\mathrm{sm}(b^2 - 3a c)}{6a} = \frac{-b - \mathrm{sqrt}_\mathrm{sm}(b^2 - 3a c)}{3a}
          %p
            For negative discriminant, there is no extrema. For zero discriminant, there is a
            %span.newWikiWord
              saddle point
              %a{:href => "/nlab/new/saddle+point"} ?
            at
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mfrac
                    %mi b
                    %mrow
                      %mn 3
                      %mi a
                %annotation{:encoding => "application/x-tex"} x = -\frac{b}{3a}
          %p
            If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a = 0
            = succeed ";" do
              %span.newWikiWord
                degenerate
                %a{:href => "/nlab/new/degenerate"} ?
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+quadratic+function"} real quadratic function
          %h3#inflection_point Inflection point
          %p
            THe inflection point of the real cubic function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f:\mathbb{R} \to \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi a
                  %msup
                    %mi x
                    %mn 3
                  %mo +
                  %mi b
                  %msup
                    %mi x
                    %mn 2
                  %mo +
                  %mi c
                  %mi x
                  %mo +
                  %mi d
                %annotation{:encoding => "application/x-tex"} f(x) \coloneqq a x^3 + b x^2 + c x + d
            for real numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} a \in \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b \in \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} c \in \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} d \in \mathbb{R}
            occurs at the zero of the second derivative of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi x
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 6
                  %mi a
                  %mi x
                  %mo +
                  %mn 2
                  %mi b
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \partial_x f(x) = 6 a x + 2b = 0
          %p which occurs at
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mfrac
                    %mi b
                    %mrow
                      %mn 3
                      %mi a
                %annotation{:encoding => "application/x-tex"} x = -\frac{b}{3a}
          %p The inflection point is to real cubic functions what the extremum was to real quadratic functions.
          %h3#in_constructive_mathematics In constructive mathematics
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            %a.existingWikiWord{:href => "/nlab/show/law+of+trichotomy"} law of trichotomy
            holds in the real numbers, so the three cases above cover every real number. However, in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi ℝ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f:\mathbb{R} \to \mathbb{R}
            such that one cannot decide whether
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            has two local extrema, a saddle point, or zero local extrema. Similarly, there exists real cubic functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi ℝ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f:\mathbb{R} \to \mathbb{R}
            such that one cannot decide whether the inflection point occurs to the left, the right, or on the
            = succeed "-intercept" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
          %h2#depressed_cubic_functions Depressed cubic functions
          %p
            An unnormalized depressed cubic function is a real cubic function whose inflection point occurs at
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x = 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi a
                    %msup
                      %mi x
                      %mn 3
                    %mo +
                    %mi p
                    %mi x
                    %mo +
                    %mi q
                  %annotation{:encoding => "application/x-tex"} g(x) \coloneqq a x^3 + p x + q
            = succeed "." do
