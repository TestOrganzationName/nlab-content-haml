                        %mo &lt;
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \Delta_\partial \lt 0
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
