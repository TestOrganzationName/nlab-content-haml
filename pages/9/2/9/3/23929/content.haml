          %h2#exact_zeroes Exact zeroes
          %h3#partial_inverse_functions Partial inverse functions
          %p
            Given a real cubic function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi a
                  %msup
                    %mi x
                    %mn 3
                  %mo +
                  %mi b
                  %msup
                    %mi x
                    %mn 2
                  %mo +
                  %mi c
                  %mi x
                  %mo +
                  %mi d
                %annotation{:encoding => "application/x-tex"} f(x) \coloneqq a x^3 + b x^2 + c x + d
            for real numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} a \in \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b \in \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} c \in \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} d \in \mathbb{R}
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi a
                    %mo{:stretchy => "false"} |
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \vert a \vert \gt 0
          %ul
            %li
              %p
                If the discriminant of the derivative of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is positive,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mo ∂
                        %mo &gt;
                        %mn 0
