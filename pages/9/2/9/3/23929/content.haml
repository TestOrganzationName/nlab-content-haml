          %h2#definition Definition
          %p
            A
            %strong real cubic function
            is a
            %a.existingWikiWord{:href => "/nlab/show/cubic+function"} cubic function
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %a.existingWikiWord{:href => "/nlab/show/solution"} solution
            to the fourth-order linear homogeneous
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+equation"} ordinary differential equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %msup
                        %mi d
                        %mn 4
                      %mi f
                    %mrow
                      %mi d
                      %msup
                        %mi x
                        %mn 4
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \frac{d^4 f}{d x^4} = 0
          %p with initial conditions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi d
                %annotation{:encoding => "application/x-tex"} f(0) = d
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
