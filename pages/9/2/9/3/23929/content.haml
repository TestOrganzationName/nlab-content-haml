                  %mrow
                    %mi f
                    %mo :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f:\mathbb{R} \to \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
