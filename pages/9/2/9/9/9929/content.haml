                  of the point);
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msup
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %msubsup
                          %mi c
                          %mn 1
                          %mi E
                        %mo ⊗
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo ⊗
                        %msubsup
                          %mi c
                          %mn 1
                          %mi E
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} E^\bullet(B U(1) \times B U(1)) \simeq E^\bullet(\ast)[ [ c_1^E \otimes 1 , 1 \otimes c_1^E ] ]
                  \.
          .proof
            %h6#proof Proof
            %p
              We may realize the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(1)
              as the infinite
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %mo =
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty = \underset{\longleftarrow}{\lim}_n \mathbb{C}P^n
              (
              %a{:href => "classifying+space#RealComplexProjectiveSpaceAsGrassmannian"}> exmpl.
              ). There is a standard
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n+1}
              with the result of attaching a single
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 2n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              (
              %a{:href => "complex+projective+space#CellComplexStructureOnComplexProjectiveSpace"}> prop.
              ). With this structure, the unique 2-cell inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 2
                    %mo ↪
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} i \;\colon\; S^2 \hookrightarrow \mathbb{C}P^\infty
              is identified with the canonical map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                      %mo →
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S^2 \to B U(1)
            %p
              Then consider the
              %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
              for the
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(\mathbb{C}P^n, E^\bullet(\ast))
                    \\;\Rightarrow\;
                    E^\bullet(\mathbb{C}P^n)
                    \\,.
            %p
              Since (
              %a{:href => "complex+projective+space#OrdinaryCohomologyOfComplexProjectiveSpace"}> prop.
              ) the
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              with
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              of projective space is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(\mathbb{C}P^n, \mathbb{Z}) \simeq \mathbb{Z}[c_1]/((c_1)^{n+1})
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
              represents a unit in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} H^2(S^2, \mathbb{Z})\simeq \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              is a
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              (
              %a{:href => "complex+projective+space#OrdinaryCohomologyOfComplexProjectiveSpace"}> prop.
              ), hence a
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
              in abelian groups (
              %a{:href => "projective+object#ProjectiveObjectsInAbAreFreeGroups"}> prop.
              ), the
              = succeed "-group" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ext
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msup
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} Ext^1(H_n(\mathbb{C}P^n), E^\bullet(\ast)) = 0
              %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
              (
              %a{:href => "universal+coefficient+theorem#OrdinaryStatementInCohomology"}> prop.
              ) gives that the second page of the spectral sequence is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi c
                      %mn 1
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(\mathbb{C}P^n, E^\bullet(\ast))
                    \\simeq
                    E^\bullet(\ast)[ c_1 ] / (c_1^{n+1})
                    \\,.
            %p
              By the standard construction of the
              %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
              (
              %a{:href => "Atiyah&#8211;Hirzebruch+spectral+sequence#ConstructionByFilteringTheBaseSpace"}> here
              ) in this identification the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
              is identified with a generator of the
              %a.existingWikiWord{:href => "/nlab/show/relative+cohomology"} relative cohomology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E^2((\mathbb{C}P^n)_2, (\mathbb{C}P^n)_1)
                    \\simeq
                    \\tilde E^2(S^2)
            %p
              (using, by the above, that this
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
              is the unique 2-cell of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              in the standard cell model).
            %p
              This means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
              is a permanent cocycle of the spectral sequence (in the kernel of all differentials) precisely if it arises via restriction from an element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^2(\mathbb{C}P^n)
              and hence precisely if there exists a complex orientation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                  %annotation{:encoding => "application/x-tex"} c_1^E
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
              is a permanent cocycle. (For the fully detailed argument, see (
              %a{:href => "#Pedrotti16"}> Pedrotti 16
              )).
            %p
              The same argument applied to all elements in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mi c
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} E^\bullet(\ast)[c]
              = succeed "-linearity" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^\bullet(\ast)
              = succeed ")," do
                %a{:href => "multiplicative+cohomology+theory#LinearityOfDifferentialsInSerreAHSSForMultiplicativeCohomologyTheory"} prop.
            %p
              Since the AHSS of a multiplicative cohomology theory is a
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+spectral+sequence"} multiplicative spectral sequence
              (
              %a{:href => "multiplicative+cohomology+theory#AHSSForMultiplicativeCohomologyTheoryIsMultiplicative"}> prop.
              ) this implies that the differentials in fact vanish on all elements of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi c
                        %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi c
                        %mn 1
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^\bullet(\ast) [c_1] / (c_1^{n+1})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ℰ
                      %mn ∞
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}_\infty^{\bullet,\bullet}
                    \\simeq
                    E^\bullet(\ast)[ c_1^{E} ] / ((c_1^E)^{n+1})
            %p or in more detail:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ℰ
                      %mn ∞
                      %mrow
                        %mi p
                        %mo ,
                        %mo •
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi E
                                %mo •
                              %mo{:stretchy => "false"} (
                              %mo *
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mtext if
                              %mspace{:width => "thickmathspace"}
                              %mi p
                              %mo ≤
                              %mn 2
                              %mi n
                              %mspace{:width => "thickmathspace"}
                              %mi and
                              %mspace{:width => "thickmathspace"}
                              %mi even
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}_\infty^{p,\bullet}
                    \\simeq
                    \\left\{
                    \\array{
                    E^\bullet(\ast) &amp; \text{if}\; p \leq  2n \; and\; even
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
            %p
              Moreover, since therefore all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ℰ
                      %mn ∞
                      %mrow
                        %mi p
                        %mo ,
                        %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_\infty^{p,\bullet}
              are
              %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^\bullet(\ast)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi F
                      %mi p
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F^{p+1} E^\bullet(X) \hookrightarrow F^{p}E^\bullet(X)
              are
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
