            for the multiplicative identity element in this ring.
          #ComplexOrientedCohomologyTheory.num_defn
            %h6#definition_2 Definition
            %p
              %strong (complex oriented cohomology theory)
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is
              %em complex orientable
              if the following equivalent conditions hold:
            %ol
              %li
                %p The morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi i
                          %mo *
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi E
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msup
                          %mi E
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        i^\ast \;\colon\; E^2(B U(1)) \longrightarrow E^2(S^2)
                %p
                  is
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/surjection"} surjective
              %li
                %p
                  The morphism on
                  %a.existingWikiWord{:href => "/nlab/show/reduced+cohomology"} reduced cohomology
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mover
                            %mi i
                            %mo{:stretchy => "false"} ˜
                          %mo *
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
