                    %mo ⟶
                    %msubsup
                      %mi ℰ
                      %mn ∞
                      %mrow
                        %mi p
                        %mo ,
                        %mo •
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to F^{p+1}E^{p+\bullet}(X)
                    \\longrightarrow F^{p}E^{p+\bullet}(X) \longrightarrow \mathcal{E}_\infty^{p,\bullet} \to 0
            %p
              %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split
              (since the
              = succeed "-group" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ext
