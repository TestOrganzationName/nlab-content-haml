                        %msup
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo{:stretchy => "false"} )
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ℰ
                      %mn ∞
                      %mrow
                        %mi p
                        %mo ,
                        %mo •
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
