                  %msup
                    %mi S
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi E
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
