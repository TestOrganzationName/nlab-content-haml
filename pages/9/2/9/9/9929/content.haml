                                %mn 2
                            %mo ,
                            %msub
                              %mi v
                              %mn 1
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %annotation{:encoding => "application/x-tex"} L_2 T(m)/\big(p^{[\tfrac{m}{2}]+2}, v_1 \big)
                      for
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi m
                            %mo &gt;
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} m \gt 1
                  %strong 24
                  (2018) 1123–1146
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  = succeed "]" do
                    %a{:href => "https://nyjm.albany.edu/j/2018/24-55v.pdf"} pdf
            %p
              Review of the bounded-dimensional orientations of
              %a{:href => "#Hopkins84"} Hopkins 1984 §1.2
              and further discussion:
