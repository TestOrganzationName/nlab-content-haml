                    \&amp;
                    \\mathbb{C}P^{n+1}
                    \&amp;
                    \\overset{ c_1^{E,n+1} }{\longrightarrow}
                    \&amp;
                    \\Omega^{\infty -2} E
                    \\\
                    \\big\uparrow
                    \&amp;\mathclap{^{_{(hpo)}}}&amp;
                    \\big\uparrow
                    \&amp;
                    \\nearrow \mathrlap{ {}_{c_1^{E,n}} }
                    \\\
                    S^{2n+1}
                    \&amp;\underset{h^{2n+1}_{\mathbb{C}}}{\longrightarrow}&amp;
                    \\mathbb{C}P^n
                    \\,.
                    }
            %p
              Moreover, by the defining
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi c
                      %mn 1
                      %mrow
                        %mi E
                        %mo ,
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1^{E,n+1}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi c
                      %mn 1
                      %mrow
                        %mi E
                        %mo ,
                        %mi n
                  %annotation{:encoding => "application/x-tex"} c_1^{E,n}
              is equivalently a choice of
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              which trivializes the pullback of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
