                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^\bullet(\ast)
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              homomorphisms (
              %a{:href => "multiplicative+cohomology+theory#RingAndModuleStructureOnCohomologyGroupsOfMultiplicativeCohomplogyTheory"}> prop.
              ) the
              %a{:href => "spectral+sequence#ExtensionProblem"} extension problem
              trivializes, in that all the
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi F
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %msup
                      %mi E
                      %mrow
                        %mi p
                        %mo +
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi F
                      %mi p
                    %msup
                      %mi E
                      %mrow
                        %mi p
                        %mo +
                        %mo •
                    %mo{:stretchy => "false"} (
