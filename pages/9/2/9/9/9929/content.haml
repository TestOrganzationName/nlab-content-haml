                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^\bullet(\mathbb{C}P^n)
                    \\simeq
                    \\underset{p}{\oplus} \mathcal{E}_\infty^{p,\bullet}
                    \\simeq
                    E^\bullet(\ast)[ c_1 ] / ((c_1^{E})^{n+1})
                    \\,.
            %p A first consequence is that the projection maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E^\bullet((\mathbb{C}P^\infty)_{2n+2})
                    \=
                    E^\bullet(\mathbb{C}P^{n+1})
                    \\to
                    E^\bullet(\mathbb{C}P^{n})
                    \=
                    E^\bullet((\mathbb{C}P^\infty)_{2n})
            %p
              are all
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/epimorphisms"} epimorphisms
              %a.existingWikiWord{:href => "/nlab/show/Mittag-Leffler+condition"} Mittag-Leffler condition
              (
              %a{:href => "lim1#MittagLefflerCondition"}> def.
              ,
              = succeed ")" do
                %a{:href => "lim1#MittagLefflerSatisfiedInParticularForTowerOfSurjections"} exmpl.
              %a.existingWikiWord{:href => "/nlab/show/Milnor+exact+sequence"} Milnor exact sequence
              for generalized cohomology (
              %a{:href => "lim1#MilorSequenceForReducedCohomologyOnCWComplex"}> prop.
              ) finally implies the claim:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msup
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi ℂ
                            %msup
                              %mi P
                              %mn ∞
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %munder
                                %mi lim
                                %mo ⟶
                              %mi n
                            %mi ℂ
                            %msup
                              %mi P
                              %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %munder
                                %mi lim
                                %mo ⟵
                              %mi n
                            %msup
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi ℂ
                            %msup
                              %mi P
                              %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %munder
                                %mi lim
                                %mo ⟵
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} [
                            %msubsup
                              %mi c
                              %mn 1
                              %mi E
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi c
                              %mn 1
                              %mi E
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} [
                            %msubsup
                              %mi c
                              %mn 1
                              %mi E
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ]
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    E^\bullet(B U(1))
                    \&amp; \simeq
                    E^\bullet(\mathbb{C}P^\infty)
                    \\\
                    \&amp; \simeq
                    E^\bullet( \underset{\longrightarrow}{\lim}_n \mathbb{C}P^n )
                    \\\
                    \&amp;\simeq \underset{\longleftarrow}{\lim}_n E^\bullet(\mathbb{C}P^n)
                    \\\
                    \&amp;\simeq \underset{\longleftarrow}{\lim}_n ( E^\bullet(\ast) [c_1^E] / ((c_1^E)^{n+1})  )
                    \\\
                    \&amp; \simeq E^\bullet(\ast)[ [ c_1^E ] ]
                    \\,,
                    \\end{aligned}
            %p
              where the last step is
              = succeed "." do
                %a{:href => "formal+scheme#FormalPowerSeries"} this prop.
          #ChoiceOfRingStructureOnGradedCohomologyGroupOfMultiplicativeCohomologyTheory.num_remark
            %h6#remark_4 Remark
            %p
              There is in general a choice to be made in interpreting the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
              of a
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              as a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %p
              a priori
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^\bullet(X)
              is a sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\{E^n(X)\}_{n \in \mathbb{Z}}
            %p
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi E
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi E
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    E^{n_1}(X) \otimes E^{n_2}(X)
                    \\longrightarrow
                    E^{n_1 + n_2}(X)
                    \\,,
            %p
              one for each pair
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mn 1
                      %mo ,
                      %msub
                        %mi n
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi ℤ
                      %mo ×
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} (n_1,n_2) \in \mathbb{Z}\times\mathbb{Z}
            %p
              In turning this into a single
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              by forming
              %a.existingWikiWord{:href => "/nlab/show/formal+sums"} formal sums
              of elements in the groups
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^n(X)
            %p
              In the former case the ring obtained is the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊕
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\oplus_{n \in \mathbb{N}} E^n(X)
            %p
              while in the latter case it is the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_{n \in \mathbb{N}} E^n (X)
                    \\,.
            %p
              These differ in general. For instance if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              with
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is infinite
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
              = succeed ")" do
                %a{:href => "complex+projective+space+OrdinaryCohomologyOfComplexProjectiveSpace"} prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℤ
                            %mtd
                              %mi n
                              %mspace{:width => "thickmathspace"}
                              %mi even
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                  %annotation{:encoding => "application/x-tex"}
                    E^n(X)
                    \=
                    \\left\{
                    \\array{
                    \\mathbb{Z} &amp; n \; even
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
            %p and the product operation is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %mn 2
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi E
                      %mrow
                        %mn 2
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi E
                      %mrow
                        %mn 2
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E^{2{n_1}}(X)\otimes E^{2 n_2}(X)
                    \\longrightarrow
                    E^{2(n_1 + n_2)}(X)
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} n_1, n_2
              (and zero in odd degrees, necessarily). Now taking the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of these, this is the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              on one generator (in degree 2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊕
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\oplus_{n \in \mathbb{N}} E^n(X) \;\simeq\; \mathbb{Z}[c_1]
                    \\,.
            %p
              But taking the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series+ring"} formal power series ring
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
