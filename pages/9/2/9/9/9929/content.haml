              vanishes on the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
              %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective module
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi ℰ
