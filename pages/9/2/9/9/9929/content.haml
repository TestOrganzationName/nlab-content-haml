              %a.existingWikiWord{:href => "/nlab/show/graded-commutative+ring"} graded
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E_\bullet
              is trivial in odd degrees (an
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/even+cohomology+theory"} even cohomology theory
          %p
            (see also
            = succeed ")" do
              %a{:href => "#LurieLecture"} Lurie, Lecture 6, Remark 4
          %h3#InTermsOfOrientations In terms of orientations of fibers of complex vector bundles
          %p
          #ComplexEOrientationsFromFirstEChernClass.num_remark
            %h6 Remark
            %p
              %strong
                (complex
                = succeed "-orientations" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                = succeed "-Chern" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
            %p
              To see that a generalized Chern class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                  %annotation{:encoding => "application/x-tex"} c^E_1
              in the
              %a{:href => "#DefInTermsOfGeneralizedFirstChernClass"} above sense
              indeed has to do with
              = succeed "," do
                %em complex orientations
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+line+bundles"} complex line bundles
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
              of the
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+bundle"} dual
              %a.existingWikiWord{:href => "/nlab/show/tautological+line+bundle"} tautological line bundle
              (see
              = succeed ")" do
                %a{:href => "tautological+line+bundle#DualTautologicalLineBundle"} there
