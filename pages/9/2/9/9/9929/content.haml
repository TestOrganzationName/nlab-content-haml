            %p In conclusion, this gives an isomorphism of graded rings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mo ⊕
                      %mi p
                    %msubsup
                      %mi ℰ
                      %mn ∞
                      %mrow
                        %mi p
                        %mo ,
                        %mo •
                    %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
