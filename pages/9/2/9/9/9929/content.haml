          %p
            with the
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            underlying
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
