                  %annotation{:encoding => "application/x-tex"} c_1^{E,n}
              to the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} 2n+1-sphere
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
