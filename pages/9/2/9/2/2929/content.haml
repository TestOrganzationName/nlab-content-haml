                    %annotation{:encoding => "application/x-tex"} \theta_Y \times 1_X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi α
                        %mi op
                      %mo :
                      %msup
                        %mi f
                        %mi op
                      %mo ≤
                      %msup
                        %mi g
                        %mi op
                    %annotation{:encoding => "application/x-tex"} \alpha^{op}: f^{op} \leq g^{op}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mi op
                    %mo =
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^{op} = f_*
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi g
                        %mi op
                      %mo =
                      %msub
                        %mi g
                        %mo *
                    %annotation{:encoding => "application/x-tex"} g^{op} = g_*
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mi op
                      %mo =
                      %msup
                        %mi g
                        %mi op
                    %annotation{:encoding => "application/x-tex"} f^{op} = g^{op}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mi op
                          %mi op
                      %mo =
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f^{op op} = f
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo =
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f = g
          %h2#the_beckchevalley_condition The Beck-Chevalley condition
          %p
            Bicategories of relations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                %annotation{:encoding => "application/x-tex"} \mathbf{B}
            satisfy a Beck-Chevalley condition, as follows. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Prod(B_0)
            denote the free category with finite products generated by the set of objects of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/free+cartesian+category"} free cartesian category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Prod(B_0)
            is finitely complete.
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Map(\mathbf{B})
            has finite products, there is a product-preserving functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo :
                  %mi Prod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Map
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi: Prod(B_0) \to \Map(\mathbf{B})
            which is the identity on objects. Again, according to the results of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/free+cartesian+category"} free cartesian category
          .num_lemma
            %h6#lemma Lemma
            %p
              If a diagram in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Prod(B_0)
              is a pullback square, then application of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              to that diagram is a pullback square in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Map
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Map(\mathbf{B})
          %p
            Let us call pullback squares of this form in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Map(\mathbf{B})
            %em product-based
            pullback squares.
          .num_prop
            %h6#proposition_7 Proposition
            %p Given a product-based pullback square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi W
                          %mtd
                            %mover
                              %mo →
                              %mi h
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mi k
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mi f
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %munder
                              %mo →
                              %mi g
                          %mtd
                            %mi Z
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    W &amp; \stackrel{h}{\to} &amp; X \\
                    k \downarrow &amp; &amp; \downarrow f \\
                    Y &amp; \underset{g}{\to} &amp; Z
                    }
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Map
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Map(\mathbf{B})
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mo *
                      %mi k
                      %mo =
                      %mi f
                      %msub
                        %mi g
                        %mo *
                    %annotation{:encoding => "application/x-tex"} h_* k = f g_*
          %p See Brady-Trimble for further details. The critical case to consider is the pullback square
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi Δ
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mi Δ
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mrow
                              %mi Δ
                              %mo ×
                              %mn 1
                      %mtr
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %mn 1
                              %mo ×
                              %mi Δ
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                          %mo ×
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp; \overset{\Delta}{\to} &amp; X \times X \\
                  \\mathllap{\Delta} \downarrow &amp; &amp; \downarrow \mathrlap{\Delta \times 1} \\
                  X \times X &amp; \underset{1 \times \Delta}{\to} &amp; X \times X \times X
                  }
          %p where the Beck-Chevalley condition is exactly the Frobenius condition.
          %p
            One way of interpreting this result is by viewing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                %annotation{:encoding => "application/x-tex"} \mathbf{B}
            as a hyperdoctrine or monoidal fibration over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Prod(B_0)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is the local hom-poset
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(B, 1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f: A \to B
            in the base induces a pullback functor, by precomposing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %mi B
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} R: B \to 1
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} \pi(f): A \to B
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Map(\mathbf{B})
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \pi(f)_*
          %h2#relation_to_allegories Relation to allegories
          %p
            Any bicategory of relations is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/allegory"} allegory
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pos
                  %annotation{:encoding => "application/x-tex"} Pos
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi S
                  %mo ∩
                  %mi T
                  %mo ≤
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ∩
                  %mi T
                  %msup
                    %mi S
                    %mi op
                  %mo{:stretchy => "false"} )
                  %mi S
                %annotation{:encoding => "application/x-tex"} R S \cap T \leq (R \cap T S^{op})S
          %p A proof of the modular law is given in the blog post by R.F.C. (“Bob”) Walters referenced below.
          %p In fact, we may prove a little more:
          .num_theorem
            %h6#theorem_2 Theorem
            %p The notion of bicategory of relations is equivalent to the notion of unitary pretabular allegory.
          .proof
            %h6#proof_7 Proof
            %p
              A bicategory of relations has a unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              in the sense of allegories:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                  is a partial unit: we have
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ε
                            %mn 1
                          %mo =
                          %msub
                            %mi id
                            %mn 1
                          %mo :
                          %mn 1
                          %mo →
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} \varepsilon_1 = id_1: 1 \to 1
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo :
                        %mn 1
                        %mo →
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} R: 1 \to 1
                  we have
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                          %mo =
                          %mi R
                          %msub
                            %mi ε
                            %mn 1
                          %mo ≤
                          %msub
                            %mi ε
                            %mn 1
                          %mo =
                          %msub
                            %mi id
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} R = R\varepsilon_1 \leq \varepsilon_1 = id_1
              %li
                %p
                  Any object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is the source of a map
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ε
                            %mi X
                          %mo :
                          %mi X
                          %mo →
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} \varepsilon_X: X \to 1
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                  is a unit.
            %p
              A bicategory of relations is also pretabular, for the maximal element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(X, Y)
              is tabulated as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mi X
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo *
                      %msub
                        %mi π
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} (\pi_X)_* \pi_Y
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \pi_X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \pi_Y
              are the product projections for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \times Y
            %p
              In the other direction, suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{A}
              is a unitary pretabular allegory. There is a faithful embedding, which preserves the unit, of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{A}
              into its coreflexive splitting, which is unitary and tabular, and hence equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} Rel
              of the regular category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Map
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Map(\mathbf{A})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{A}
              is a full sub-2-category of a bicategory of relations. Because the product of two Frobenius objects is again Frobenius, it suffices to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{A}
              is closed under products in its coreflexive splitting. The inclusion of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{A}
              into the latter preserves the unit and the property of being a map, and hence preserves top elements of hom sets, while any allegory functor must preserve tabulations. So the tabulation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi π
                      %mi X
                      %mrow
                        %mi X
                        %mi Y
                    %mo ,
                    %msubsup
                      %mi π
                      %mi Y
                      %mrow
                        %mi X
                        %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\pi^{X Y}_X, \pi^{X Y}_Y)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊤
                      %mrow
                        %mi X
                        %mi Y
                  %annotation{:encoding => "application/x-tex"} \top_{X Y}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{A}
              is a tabulation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊤
                      %mrow
                        %msub
                          %mn 1
                          %mi X
                        %msub
                          %mn 1
                          %mi Y
                  %annotation{:encoding => "application/x-tex"} \top_{1_X 1_Y}
              in the coreflexive splitting, and hence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 1
                        %mrow
                          %mi X
                          %mo ×
                          %mi Y
                      %mo ≅
                      %msub
                        %mn 1
                        %mi X
                      %mo ×
                      %msub
                        %mn 1
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} 1_{X \times Y} \cong 1_X \times 1_Y
          .num_prop
            %h6#proposition_8 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Rel C
              of
              %a.existingWikiWord{:href => "/nlab/show/Rel"} relations
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a bicategory of relations.
          .proof
            %h6#proof_8 Proof
            %p
              By theorem 1.6 of Carboni–Walters,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{A}
              is a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+bicategory"} Cartesian bicategory
              if:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Map
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Map(\mathbf{A})
                  has finite products.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi A
                      %annotation{:encoding => "application/x-tex"} \mathbf{A}
                  has local finite products, and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi id
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} id_1
                  is the top element of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbf{A}(1,1)
              %li
                %p The tensor product defined as
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo ⊗
                        %mi S
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mi R
                        %msub
                          %mi p
                          %mo *
                        %mo{:stretchy => "false"} )
                        %mo ∩
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ′
                        %mi S
                        %mi p
                        %msub
                          %mo ′
                          %mo *
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} R \otimes S =  (p R p_*) \cap (p' S p'_*)
                %p
                  is functorial, where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} p'
                  are the appropriate product projections.
            %p
              The first two are obvious, and for the third we may reason in the
              %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ⊗
                    %mn 1
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo =
                    %mi x
                    %mo ∧
                    %mi x
                    %mo ′
                    %mo =
                    %mi x
                    %mo ′
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1 \otimes 1 = [x = x \wedge x' = x'] = 1
            %p
              The formula whose meaning is by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi S
                    %mo ⊗
                    %mi R
                    %mo ′
                    %mi S
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} R S \otimes R' S'
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ∃
                    %mi y
                    %mo .
                    %mi R
                    %mi x
                    %mi y
                    %mo ∧
                    %mi S
                    %mi y
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mo ∃
                    %mi y
                    %mo ′
                    %mo .
                    %mi R
                    %mo ′
                    %mi x
                    %mo ′
                    %mi y
                    %mo ′
                    %mo ∧
                    %mi S
                    %mo ′
                    %mi y
                    %mo ′
                    %mi z
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\exists y. R x y \wedge S y z) \wedge (\exists y'. R' x' y' \wedge S' y' z')
            %p
              and we may use
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+reciprocity"} Frobenius reciprocity
              to get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                          %mtd
                            %mo ∃
                            %mi y
                            %mo .
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi x
                            %mi y
                            %mo ∧
                            %mi S
                            %mi y
                            %mi z
                            %mo ∧
                            %msup
                              %mi y
                              %mo *
                            %mo ∃
                            %mi y
                            %mo ′
                            %mo .
                            %mi R
                            %mo ′
                            %mi x
                            %mo ′
                            %mi y
                            %mo ′
                            %mo ∧
                            %mi S
                            %mo ′
                            %mi y
                            %mo ′
                            %mi z
                            %mo ′
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≡
                            %mo ∃
                            %mi y
                            %mo .
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi x
                            %mi y
                            %mo ∧
                            %mi S
                            %mi y
                            %mi z
                            %mo ∧
                            %mo ∃
                            %mi y
                            %mo ′
                            %mo .
                            %msup
                              %mi y
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mo ′
                            %mi x
                            %mo ′
                            %mi y
                            %mo ′
                            %mo ∧
                            %mi S
                            %mo ′
                            %mi y
                            %mo ′
                            %mi z
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≡
                            %mo ∃
                            %mi y
                            %mo ,
                            %mi y
                            %mo ′
                            %mo .
                            %mi R
                            %mi x
                            %mi y
                            %mo ∧
                            %mi S
                            %mi y
                            %mi z
                            %mo ∧
                            %mi R
                            %mo ′
                            %mi x
                            %mo ′
                            %mi y
                            %mo ′
                            %mo ∧
                            %mi S
                            %mo ′
                            %mi y
                            %mo ′
                            %mi z
                            %mo ′
                        %mtr
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \&amp; \exists y. (R x y \wedge S y z \wedge y^* \exists y'. R' x' y' \wedge S' y' z') \\
                    \&amp; \equiv \exists y. (R x y \wedge S y z \wedge  \exists y'. y^* (R' x' y'   \wedge S' y' z')) \\
                    \&amp; \equiv \exists y, y'. R x y \wedge S y z \wedge R' x' y' \wedge S' y' z' \\
                    \\end{aligned}
            %p
              which is the meaning of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ⊗
                      %mi R
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ⊗
                      %mi S
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (R \otimes R')(S \otimes S')
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo ∃
                    %mi x
                    %mo ′
                    %mo .
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ′
                    %mo ,
                    %mi x
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 3
                    %mo ,
                    %msub
                      %mi x
                      %mn 4
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mo ∃
                    %mi x
                    %mo ′
                    %mo .
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi x
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 3
                    %mo ,
                    %msub
                      %mi x
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 4
                    %mo ,
                    %mi x
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [\exists x'. (x_1, x_2) = (x', x') = (x_3, x_4)]
                    \= [\exists x'. (x_1, x') = (x_3, x_3) \wedge (x_2, x_2) = (x_4, x')]
            %p which follows from transitivity and symmetry of equality.
          %h2#see_also See also
          %p Other attempted axiomatizations of the same idea “something that acts like the category of relations in a regular category” include:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/allegories"} allegories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/1-category+equipped+with+relations"} 1-category equipped with relations
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/category+of+correspondences"} category of correspondences
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2Cn%29-category+of+correspondences"} (infinity,n)-category of correspondences
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aurelio+Carboni"}> Aurelio Carboni
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bob+Walters"} Bob Walters
                = succeed "," do
                  %em Cartesian Bicategories, I
                %a{:href => "https://doi.org/10.1016/0022-4049%2887%2990121-6"} article
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aurelio+Carboni"}> Aurelio Carboni
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"} Max Kelly
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bob+Walters"} Bob Walters
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Richard+Wood"} Richard Wood
                = succeed "," do
                  %em Cartesian Bicategories II
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/0708.1921"} arXiv:0708.1921
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bob+Walters"}> Bob Walters
                ,
                = succeed "," do
                  %a{:href => "http://rfcwalters.blogspot.com/2009/10/categorical-algebras-of-relations.html"} blog post
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/allegory"} allegory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Evan+Patterson"}> Evan Patterson
                ,
                = succeed "," do
                  %em Knowledge Representation in Bicategories of Relations
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1706.00526"} arXiv:1706.00526
          %p
            This article shows how one can model RDF (Resource Description Framework) and parts of OWL (Ontology Web Language) in bicategories of relations, whose internal logic is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/regular+logic"} regular logic
            %span.newWikiWord
              distributive bicategories of relations
              %a{:href => "/nlab/new/distributive+bicategories+of+relations"} ?
            whose internal logic is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coherent+logic"} coherent logic
