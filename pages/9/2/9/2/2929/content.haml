                      %mi Δ
                      %mi X
                    %mi g
                    %mo ≤
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ×
                    %mi g
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi Δ
                      %mi Y
