          %p
            Now given an evolutionary vector field, we want to consider the
            %a.existingWikiWord{:href => "/nlab/show/flow"} flow
            that it induces on the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
          #FlowOfFieldHistoriesAlongEvolutionaryVectorField.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/flow"} flow
                of
                %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
                along
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              be an
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
