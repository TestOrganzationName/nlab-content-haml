          .proof
            %h6#proof_3 Proof
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/Cartan%27s+homotopy+formula"} Cartan's homotopy formula
              for the
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartanHomotopyFormula"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \delta \mathbf{L}
              %a.maruku-eqref{:href => "#eq:dLDecomposition"} (?)
              and the fact that contraction
