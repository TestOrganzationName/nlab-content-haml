              is still
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vertical+vector+field"} vertical
              = succeed "," do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
