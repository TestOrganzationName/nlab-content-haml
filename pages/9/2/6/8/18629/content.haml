          #EvolutionaryVectorFieldLieAlgebra.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
                form a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} v_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} v_2
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorField"}
              %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
              of
              %a.existingWikiWord{:href => "/nlab/show/tangent+vector+fields"} tangent vector fields
              of their prolongations
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \hat v_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
