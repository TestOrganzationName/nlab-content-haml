                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    J^\infty_\Sigma E
                    \&amp;&amp; \overset{v}{\longrightarrow} &amp;&amp;
                    T_\Sigma E
                    \\\
                    \&amp; {}_{\mathllap{jb_{\infty,0}}}\searrow &amp;&amp; \swarrow_{\mathllap{}}
                    \\\
