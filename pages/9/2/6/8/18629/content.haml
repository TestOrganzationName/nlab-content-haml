              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi v
                      %mi a
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v^a \in C^\infty(J^\infty_\Sigma(E))
              are general
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              (while the cmponents are
              %a.existingWikiWord{:href => "/nlab/show/tangent+vectors"} tangent vectors
              along the field coordinates
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϕ
                        %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\phi^a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi μ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x^\mu)
              and not along the jet coordinates
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi ϕ
                        %mrow
                          %mo ,
                          %msub
                            %mi μ
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi μ
                            %mi k
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \phi^a_{,\mu_1 \cdots \mu_k}
            %p We write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mi E
                      %mi ev
                    %mrow
                      %mo (
                      %msub
                        %mi T
                        %mi Σ
                      %mi E
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_E^{ev}\left( T_\Sigma E \right)
                    \\;\in\;
                    \\Omega^{0,0}_\Sigma(E) Mod
            %p
              for the space of evolutionary vector fields, regarded as a
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              over the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi C
                      %mn ∞
                    %mrow
                      %mo (
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{0,0}_\Sigma(E)
                    \\;=\;
                    C^\infty\left( J^\infty_\Sigma(E) \right)
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#EvolutionaryVectorField"}
            %em depending
            on, possibly, the point in spacetime and the values of the field and all its derivatives (locally to finite order, by prop.
            = succeed ")." do
              %a.maruku-ref{:href => "#JetBundleIsLocallyProManifold"}
          %p
            This induces a corresponding infinitesimal change of the derivatives of the fields, called the
            %em prolongation
            of the evolutionary vector field:
          #EvolutionaryVectorFieldProlongation.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (prolongation of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorField"}
              %a.existingWikiWord{:href => "/nlab/show/tangent+vector+field"} tangent vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat v
              on the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat v
                  agrees on field coordinates (as opposed to jet coordinates) with
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi v
                        %annotation{:encoding => "application/x-tex"} v
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi jb
                          %mrow
                            %mn ∞
                            %mo ,
                            %mn 0
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi v
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        (jb_{\infty,0})_\ast(\hat v) = v
                        \\,,
                %p
                  which means in the special case that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mover
                          %mo →
                          %mi fb
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                  over
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                  that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat v
                  is of the form
                #eq:GenericComponentsForProlongationOfEvolutionaryVectorField.maruku-equation
                  %span.maruku-eq-number (1)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %munder
                            %mrow
                              %msup
                                %mi v
                                %mi a
                              %msub
                                %mo ∂
                                %mrow
                                  %msup
                                    %mi ϕ
                                    %mi a
                            %mo ⏟
                          %mrow
                            %mo =
                            %mi v
                        %mspace{:width => "thinmathspace"}
                        %mo +
                        %mspace{:width => "thinmathspace"}
                        %msubsup
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                          %mi μ
                          %mi a
                        %msub
                          %mo ∂
                          %mrow
                            %msubsup
                              %mi ϕ
                              %mrow
                                %mo ,
                                %mi μ
                              %mi a
                        %mo +
                        %msubsup
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                          %mrow
                            %msub
                              %mi μ
                              %mn 1
                            %msub
                              %mi μ
                              %mn 2
                          %mi a
                        %msub
                          %mo ∂
                          %mrow
                            %msubsup
                              %mi ϕ
                              %mrow
                                %mo ,
                                %msub
                                  %mi μ
                                  %mn 1
                                %msub
                                  %mi μ
                                  %mn 2
                              %mi a
                        %mo +
                        %mi ⋯
                      %annotation{:encoding => "application/x-tex"}
                        \\hat v
                        \\;=\;
                        \\underset{
                        \= v
                        }{
                        \\underbrace{
                        v^a \partial_{\phi^a}
                        }}
                        \\,+\,
                        \\hat v^a_{\mu} \partial_{\phi^a_{,\mu}}
                        +
                        \\hat v^a_{\mu_1 \mu_2} \partial_{\phi^a_{,\mu_1 \mu_2}}
                        +
                        \\cdots
              %li
                %p
                  contraction with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat v
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ContractionOfFormsWithVectorFields"}
                  %a.existingWikiWord{:href => "/nlab/show/total+derivative"} total spacetime derivative
                  (def.
                  = succeed "):" do
                    %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
                #eq:ProlongedEvolutionaryVectorFieldContractionAnticommutedWithHorizontalDerivative.maruku-equation
                  %span.maruku-eq-number (2)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ι
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                        %mo ∘
                        %mi d
                        %mo +
                        %mi d
                        %mo ∘
                        %msub
                          %mi ι
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                        %mo =
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\iota_{\hat v} \circ d + d \circ \iota_{\hat v} = 0
                        \\,.
            %p
              In particular
              %a.existingWikiWord{:href => "/nlab/show/Cartan%27s+homotopy+formula"} Cartan's homotopy formula
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartanHomotopyFormula"}
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}_{\hat v}
              holds with respect to the
              %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                    %annotation{:encoding => "application/x-tex"} \delta
            #eq:HomotopyFormulaForLieDerivativeAlongProlongationOfEvolutionaryVectorField.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %mo =
                    %mi δ
                    %mo ∘
                    %msub
                      %mi ι
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %mo +
                    %msub
                      %mi ι
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %mo ∘
                    %mi δ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}_{\hat v} = \delta \circ \iota_{\hat v} + \iota_{\hat v} \circ \delta
            %p
              Explicitly, in the special case that the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              is a
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              over
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat v
              is given by
            #eq:ProlongationOfEvolutionaryVectorFieldExplicit.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ^
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mn ∞
                    %mfrac
                      %mrow
                        %msup
                          %mi d
                          %mi n
                        %msup
                          %mi v
                          %mi a
                      %mrow
                        %mi d
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi μ
                              %mn 1
                        %mi ⋯
                        %mi d
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi μ
                              %mi n
                    %msub
                      %mo ∂
                      %mrow
                        %msubsup
                          %mi ϕ
                          %mrow
                            %msub
                              %mi μ
                              %mn 1
                            %mi ⋯
                            %msub
                              %mi μ
                              %mi n
                          %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hat v = \underoverset{n = 0}{\infty}{\sum} \frac{d^n v^a}{ d x^{\mu_1} \cdots d x^{\mu_n} } \partial_{\phi^a_{\mu_1 \cdots \mu_n}}
                    \\,.
          .proof
            %h6#proof Proof
            %p
              It is sufficient to prove the coordinate version of the statement. We prove this by
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              over the maximal jet order
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mrow
                        %msubsup
                          %mi ϕ
                          %mrow
                            %msub
                              %mi μ
                              %mn 1
                            %mi ⋯
                            %msub
                              %mi μ
                              %mi k
                          %mi a
                  %annotation{:encoding => "application/x-tex"} \partial_{\phi^a_{\mu_1 \cdots \mu_k}}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat v
              is given by the contraction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %mi δ
                    %msubsup
                      %mi ϕ
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi k
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \iota_{\hat v} \delta \phi^a_{\mu_1 \cdots \mu_k}
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ContractionOfFormsWithVectorFields"}
            %p
              Similarly (at “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = -1
              ”) the component of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} \partial_{\mu_1}
              is given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %mi d
                      %msup
                        %mi x
                        %mi μ
                    %annotation{:encoding => "application/x-tex"} \iota_{\hat v} d x^{\mu}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ι
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                            %mi d
                            %msup
                              %mi x
                              %mi μ
                          %mtd
                            %mo =
                            %mi d
                            %msub
                              %mi ι
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                            %msup
                              %mi x
                              %mi μ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\iota_{\hat v} d x^\mu
                    \&amp; =
                    d \iota_{\hat v} x^\mu
                    \\\
                    \&amp; =
                    0
                    \\end{aligned}
            %p
              Moreover, the coefficient of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mrow
                        %msup
                          %mi ϕ
                          %mi a
                  %annotation{:encoding => "application/x-tex"} \partial_{\phi^a}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat v
              is fixed by the first condition above to be
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %mi δ
                    %msup
                      %mi ϕ
                      %mi a
                    %mo =
                    %msup
                      %mi v
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{\hat v} \delta \phi^a
                    \=
                    v^a
                    \\,.
            %p
              This shows the statement for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
