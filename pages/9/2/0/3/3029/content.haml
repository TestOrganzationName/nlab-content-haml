                    g_1 g_2 g_3 \;,\; a_1 + a_2 + a_3
                    +
                    c(g_1, g_2) +  c\left(  g_1 g_2, g_3 \right)
                    \\right)
                    \\,.
            %p Bracketing the same three elements to the right yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mi g
                        %mn 1
                      %mo ,
                      %msub
                        %mi a
                        %mn 1
                      %mo )
                    %mo ⋅
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %msub
                          %mi g
                          %mn 2
                        %mo ,
                        %msub
                          %mi a
                          %mn 2
                        %mo )
                      %mo ⋅
                      %mrow
                        %mo (
                        %msub
                          %mi g
                          %mn 3
                        %mo ,
                        %msub
                          %mi a
                          %mn 3
                        %mo )
                      %mo )
                    %mo =
                    %mrow
                      %mo (
                      %msub
                        %mi g
                        %mn 1
                      %msub
                        %mi g
                        %mn 2
                      %msub
                        %mi g
                        %mn 3
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi a
                        %mn 1
                      %mo +
                      %msub
                        %mi a
                        %mn 2
                      %mo +
                      %msub
                        %mi a
                        %mn 3
                      %mo +
                      %mi c
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mn 2
                      %mo ,
                      %msub
                        %mi g
                        %mn 3
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi c
                      %mrow
                        %mo (
                        %msub
                          %mi g
                          %mn 1
                        %mo ,
                        %msub
                          %mi g
                          %mn 2
                        %msub
                          %mi g
                          %mn 3
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(g_1, a_1\right)
                    \\cdot
                    \\left(
                    \\left(g_2, a_2\right)
                    \\cdot
                    \\left(
                    g_3, a_3
                    \\right)
                    \\right)
                    \=
                    \\left(
                    g_1 g_2 g_3 \;,\; a_1 + a_2 + a_3
                    +
                    c(g_2, g_3) +  c\left(  g_1 , g_2 g_3 \right)
                    \\right)
                    \\,.
            %p The difference between the two expressions is read off to be precisely
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mn 1
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo ,
                    %msub
                      %mi g
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    1, (d c) (g_1, g_2, g_3)
                    \\big)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi c
                  %annotation{:encoding => "application/x-tex"} d c
              denotes the group cohomology differential of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              is a group 2-cocycle, hence we have an associative product.
            %p
              To see that it has inverses, notice that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g,a)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi a
                    %mo −
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo =
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi{:mathvariant => "normal"} e
                    %mo ,
                    %mi a
                    %mo −
                    %mi a
                    %mo −
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    (g,a)
                    \\cdot
                    \\big(
                    g^{-1}, - a - c(g,g^{-1})
                    \\big)
                    \=
                    \\big(
                    \\mathrm{e},
                    a - a - c(g,g^{-1})+ c(g,g^{-1})
                    \\big)
            %p
              and hence inverses are given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ,
                      %mi a
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi g
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi a
                      %mo −
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ,
                      %msup
                        %mi g
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (g,a)^{-1} = (g^{-1}, -a - c(g,g^{-1}))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %msub
                      %mo ×
                      %mi c
                    %mi A
                  %annotation{:encoding => "application/x-tex"} G \times_c A
              is indeed a group.
            %p
              By the discussion at
              %a{:href => "group+cohomology#Degree2"} group cohomology – degree-2
              we may assume without restriction that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              is a normalized cocycle, hence that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} e
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi{:mathvariant => "normal"} e
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} c(\mathrm{e},-) = c(-,\mathrm{e}) = 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi G
                    %msub
                      %mo ×
                      %mi c
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    i \colon A \to G \times_c A
            %p
              given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a \mapsto (e,a)
              is a group homomorphism. Moreover, the projection on the underlying sets evidently yields a group homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %msub
                      %mo ×
                      %mi c
                    %mi A
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} p \colon G \times_c A \to G
              given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi g
                    %annotation{:encoding => "application/x-tex"} (g,a) \mapsto g
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo ↪
                      %mi i
                    %mi G
                    %msub
                      %mo ×
                      %mi c
                    %mi A
                    %mover
                      %mo ⟶
                      %mi p
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    A
                    \\overset{i}{\hookrightarrow}
                    G \times_c A
                    \\overset{p}{\longrightarrow}
                    G
            %p
              is indeed a group extension. It is a
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
              again using the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              is normalized
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} c(g,e) = c(e,g) = 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} e
                    %mo ,
                    %mover
                      %mi a
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi a
                    %mo +
                    %mover
                      %mi a
                      %mo{:stretchy => "false"} ˜
                    %mo +
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} e
                    %mo ,
                    %mover
                      %mi a
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (g,a) \cdot (\mathrm{e},\tilde a)
                    \\;=\;
                    (g, a + \tilde a + 0)
                    \\;=\;
                    (\mathrm{e},\tilde a) \cdot (g,a)
                    \\,.
            %p
              Finally to see that the construction is independent of the choice of coycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              representing
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi c
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [c]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde c
              be another representative which differs by a
              %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} h \colon G \to A
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi h
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi h
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi h
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde c (g_1,g_2) \coloneqq c(g_1,g_2) - h(g_1) - h(g_2) + h(g_1 g_2)
                    \\,.
            %p We claim that then we have a homomorphism of central extensions (hence an isomorphism) of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mi G
                            %msub
                              %mo ×
                              %mi c
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mi G
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi id
                                    %mi G
                                  %mo ,
                                  %msub
                                    %mi p
                                    %mn 2
                                  %mo −
                                  %mi h
                                  %mo ∘
                                  %msub
                                    %mi p
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo =
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mi G
                            %msub
                              %mo ×
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ˜
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\to&amp; G \times_c A &amp;\to&amp; G
                    \\\
                    \\downarrow^{\mathrlap{id}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{(id_G, p_2 -h \circ p_1)}} &amp;&amp; \downarrow^{\mathrlap{=}}
                    \\\
                    A &amp;\to&amp; G \times_{\tilde c} A &amp;\to&amp; G
                    }
                    \\,.
            %p To see this we check for all elements that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
                            %mo ,
                            %msub
                              %mi a
                              %mn 1
                            %mo −
                            %mi h
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 2
                            %mo ,
                            %msub
                              %mi a
                              %mn 2
                            %mo −
                            %mi h
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
                            %msub
                              %mi g
                              %mn 2
                            %mo ,
                            %msub
                              %mi a
                              %mn 1
                            %mo +
                            %msub
                              %mi a
                              %mn 2
                            %mo −
                            %mi h
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mi h
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi c
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
                            %mo ,
                            %msub
                              %mi g
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
                            %msub
                              %mi g
                              %mn 2
                            %mo ,
                            %msub
                              %mi a
                              %mn 1
                            %mo +
                            %msub
                              %mi a
                              %mn 2
                            %mo +
                            %mover
                              %mi c
                              %mo{:stretchy => "false"} ˜
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
                            %mo ,
                            %msub
                              %mi g
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mi h
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
