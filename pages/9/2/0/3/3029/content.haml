                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; \mathbf{B}(A \to \hat G) &amp;\to &amp; \mathbf{B}(A \to 1) = \mathbf{B}^2 A
                    \\\
                    \&amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; {}^{\mathrlap{\simeq}}\downarrow
                    \\\
                    \&amp;&amp;  &amp;&amp; (A \to \hat G) &amp;\to&amp; \mathbf{B}A &amp;\to&amp; \mathbf{B}\hat G &amp;\to&amp;  \mathbf{B}G
                    \\\
                    \&amp;&amp; &amp;&amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    A &amp;\to&amp; \hat G &amp;\to&amp; G
                    }
                    \\,.
            %p
              In particular, the induced
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{c} : \mathbf{B}G \to \mathbf{B}^2 A
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              that classifies the delooped extension as a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}A
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
          .proof
            %h6#proof_10 Proof
            %p
              One sees directly that the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\hat G \to \mathbf{B}G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}(A \to \hat G ) \to \mathbf{B}^2 A
              as well as their loopings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \hat G \to G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} (A \to \hat G) \to G
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibrations"} Kan fibrations
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              this means that the set-theoretic
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              of these morphisms are models for their
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}(A \to \hat G) \to \mathbf{B}(A \to 1) = \mathbf{B}^2 A
              is manifestly
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \mathbf{B} \hat G
          #RelationBetweenComponentCocycleExtractionAndHomotopyTheory.num_remark
            %h6#remark_5 Remark
            %p
              The construction in def.
              %a.maruku-ref{:href => "#2CocycleExtractedFromCentralExtension"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rec
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi CentrExt
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi H
                      %mi Grp
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Rec \,\colon\, CentrExt(G,A) \to H^2_{Grp}(G,A)
            %p
              is precisely the result of moving set-theoretically through the
              %a.existingWikiWord{:href => "/nlab/show/zigzag"} zigzag
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo →
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo →
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo =
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{B}(A \to \hat G) &amp;\to&amp; \mathbf{B}(A \to 1) = \mathbf{B}^2 A
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    \\mathbf{B}G
                    }
            %p
              from the bottom left to the top right, and that this is well-defined on
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
              comes down to the statement that the vertical morphism is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            %p
              This is a nonabelian analog of the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              in the section
              = succeed "." do
                %em
                  %a{:href => "mapping%20cone#HomologyExactSequencesAndFiberSequences"} Homology exact sequences and fiber sequences
          %h4#PropertiesAbelianGroupExtensions Abelian group extensions
          .num_remark
            %h6#remark_6 Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi G
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} A, G \in
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ↪
                  %annotation{:encoding => "application/x-tex"} \hookrightarrow
              %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
              even a
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat G
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is not necessarily itself an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
          %p
            But by prop.
            %a.maruku-ref{:href => "#ExtractionAndReconstructionConsituteEquivalence"}
            above it is so if the group 2-cocycle that classifies the extension is symmetric:
          .num_defn
            %h6#definition_9 Definition
            %p
              A 2-cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo ×
                    %mi G
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} c \colon G \times G \to A
              in
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
              is
              %strong symmetric
              if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo ∈
                    %mi G
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 2
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\forall g_1, g_2 \in G
                    \:
                    \\;
                    c(g_1, g_2) = c(g_2, g_1)
                    \\,.
          .num_remark
            %h6#remark_7 Remark
            %p A group 2-cocycle cohomologous to a symmetric group 2-cocycle is itself symmetric. Hence we may speak of symmetric group cohomology classes in degree 2.
          .num_defn
            %h6#definition_10 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi Grp
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi sym
                    %mo ↪
                    %msubsup
                      %mi H
                      %mi Grp
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^2_{Grp}(G,A)_{sym} \hookrightarrow H^2_{Grp}(G,A)
            %p
              for the set (group) of classes of symmetric group 2-cocycles on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with coefficients in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          .num_defn
            %h6#definition_11 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ,
                      %mi A
                      %mo ∈
                      %mi Ab
                      %mo ↪
                      %mi Grp
                    %annotation{:encoding => "application/x-tex"} G,A \in Ab \hookrightarrow Grp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ext
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ext(G,A)
              for the subset of equivalence class of abelian group extensions of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
            The theory of
            %em abelian group extensions
            in
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            is naturally and classically treated with tools of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            = succeed "-functors." do
              %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
          %p
            For the time being see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/projective+resolution"} projective resolution
            the section
          %ul
            %li
              %em
                %a{:href => "projective+resolution#ProjectiveResolutionsForGroupCocycles"} Projective resolutions adapted to group cocycles
          %p and
          %ul
            %li
              %em
                %a{:href => "projective+resolution#DerivedHomFunctor"} Derived Hom-functor / Ext-functor
              \.
          %h3#SchreierTheory Extensions by non-abelian groups (Schreier theory)
          %p
            We discuss the classification theory for the general case of
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+group"} nonabelian group
            extensions, first in the form of
          %ul
            %li
              %em
                %a{:href => "#SchreierTheoryTraditional"} Traditional Schreier theory
          %p
            and then more abstractly in the language of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            in
          %ul
            %li
              %em
                %a{:href => "#SchreierTheorynPOV"} Homotopy theory perspective on Schreier theory
          %h4#SchreierTheoryTraditional Traditional description
          %p
            %a.existingWikiWord{:href => "/nlab/show/Otto+Schreier"} Otto Schreier
            (1926) and
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"} Eilenberg
            %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"} Mac Lane
            (late 1940-s) developed a theory of classification of nonabelian extensions of abstract groups leading to the low dimensional
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+group+cohomology"} nonabelian group cohomology
            %strong Schreier’s theory
            of nonabelian group extensions.
          %p
            The traditional Schreier-Mac Lane way to obtain nonabelian group 2-cocycle from a group extension as above starts with choosing a set-theoretic section of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi G
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p:G\to B
          %p
            %strong Note.
            The exposition which follows in this long “traditional” section of this entry is mainly from personal notes of Zoran Škoda from 1997.
          %p
            Each element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            defines an inner automorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi(g)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mi k
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi(g)(k) = g k g^{-1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi K
                %annotation{:encoding => "application/x-tex"} \phi|_K
            takes (by definition) values in the subgroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Int
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Int(K)
            of inner automorphisms of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi G
                  %mo →
                  %mi Inn
                  %mo{:stretchy => "false"} (
                  %mi G
