              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mn 1
                      %mo =
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
