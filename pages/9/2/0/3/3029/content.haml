          #ExtractionAndReconstructionConsituteEquivalence.num_prop
            %h6#proposition_8 Proposition
            %p
              The two morphisms of def.
              %a.maruku-ref{:href => "#CentralExtensionAssociatedTo2Cocycle"}
              and def.
              %a.maruku-ref{:href => "#2CocycleExtractedFromCentralExtension"}
              exhibit the
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi Grp
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo →
                        %mi Rec
                      %munderover
                        %mo ←
                        %mo ≃
                        %mi Extr
                    %mi CentrExt
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
