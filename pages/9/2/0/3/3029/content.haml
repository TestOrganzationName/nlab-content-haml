          %h2#idea Idea
          %p
            A
            %em group extension
            of a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            by a group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is third group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat G
            that sits in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} A \to \hat G \to G
          %h2#Definition Definition
          #GroupExtension.num_defn
            %h6#definition_2 Definition
            %p
              Two consecutive
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              of
              %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            #eq:shortExtension.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo ↪
                      %mi i
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo →
                      %mi p
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    A
                    \\overset{i}\hookrightarrow \hat G\overset{p}\to G
            %p
              are a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  is all of the
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  of
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi im
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} ker(p)\simeq im(i)
            %p
              We say that such a short exact sequence exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat G
              as an
              %strong extension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↪
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} A \hookrightarrow \hat G
              factors through the
              %a.existingWikiWord{:href => "/nlab/show/center"} center
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat G
              we say that this is a
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
          .num_remark
            %h6#remark Remark
            %p
              Sometimes in the literature one sees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat G
              called an extension “of
