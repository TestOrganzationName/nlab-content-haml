              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msub
                      %mo ×
                      %mi c
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(G \times_c A) \to U(G)
              given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi id
                        %mrow
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mi U
