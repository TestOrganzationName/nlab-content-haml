          %p
            Assume the
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            in the ambient
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/foundations"} foundations
          #2CocycleExtractedFromCentralExtension.num_defn
            %h6#definition_7 Definition
            %p
              %strong (2-cocycle extracted from central extension)
            %p
              Given a central extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} A \to \hat G \to G
              define a group 2-cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo :
                    %mi G
                    %mo ×
                    %mi G
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} c : G \times G \to A
              as follows.
            %p
              Choose a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo :
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma : U(G) \to U(\hat G)
              of the underlying
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              (which exists by the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              and the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} p : \hat G \to G
              is by definition an
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∈
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
