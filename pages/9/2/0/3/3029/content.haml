          .num_prop
            %h6#proposition_11 Proposition
            %p The following are equivalent
            %ul
              %li
                %p
                  (i) extension
                  %a.maruku-eqref{:href => "#eq:shortExtension"} (1)
                  is split
              %li
                %p
                  (ii) for extension
                  %a.maruku-eqref{:href => "#eq:shortExtension"} (1)
                  there is a subgroup
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi B
                          %mn 1
                        %mo ⊂
                        %mi G
                      %annotation{:encoding => "application/x-tex"} B_1 \subset G
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi B
                          %mn 1
                        %mo ∩
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} B_1 \cap i(K) = 1
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi B
                          %mn 1
                        %mi i
