                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo →
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo =
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mo ≃
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo →
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
