                  (b_1,k_1)(b_2,k_2) = (b_1b_2,\chi(b_1,b_2)[\psi(b_2)^{-1}(k_1)] k_2).
          %p
            According to this formula,
            %em
              all the information about the multiplication is encoded in functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo :
                    %mi B
                    %mo ×
                    %mi B
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \chi : B \times B \rightarrow K
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo :
                      %mi B
                      %mo →
                      %mi Aut
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \psi : B \rightarrow Aut(K)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            at this point. However,
            = succeed "." do
              %em
                not every pair
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi χ
                      %mo ,
                      %mi ψ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\chi,\psi)
                will give some multiplication rule on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ×
                      %mi K
                    %annotation{:encoding => "application/x-tex"} B \times K
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} a,b,c \in B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo =
                  %msub
                    %mi e
                    %mi K
                %annotation{:encoding => "application/x-tex"} e = e_K
            be the unity element in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mi b
                  %mo ,
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mi b
                  %mi c
                  %mo ,
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi c
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [(a,e)(b,e)](c,e) = (a b, \chi(a,b))(c,e) =
                  (a b c, \chi(a b,c) \psi(c)^{-1}(\chi(a,b))).
          %p From the other side, this has to be the same, by associativity, to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi bc
                  %mo ,
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mi b
                  %mi c
                  %mo ,
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (a,e)[(b,e)(c,e)] = (a,e)(bc,\chi(b,c)) = (a b c,\chi(a,b c)\chi(b,c))
          %p
            where we took into account that expressions like
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ψ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi e
                  %annotation{:encoding => "application/x-tex"} [\psi^{-1}(b)(e)] = e
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \psi(b)
            is an
            %em automorphism
            for each
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} b \in B
          %p Comparing the expressions above we obtain
          #eq:psi1.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi c
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi for
                  %mi all
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi c
                  %mo ∈
                  %mi B
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\chi(a b,c)\psi(c)^{-1}(\chi(a,b)) = \chi(a,b c)\chi(b,c),
                  for all a,b,c \in B.
          %p
            If the pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi χ
                  %mo ,
                  %mi ψ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\chi,\psi)
            is constructed as above, then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ψ
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mi ψ
                          %mo{:stretchy => "false"} (
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mi k
                        %mtd
                          %mo =
                        %mtd
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %mi σ
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %mi σ
                          %mo{:stretchy => "false"} (
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mi k
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mi σ
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mi σ
                          %mo{:stretchy => "false"} (
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mi k
                          %mi σ
                          %mo{:stretchy => "false"} (
                          %mi b
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mi σ
                          %mo{:stretchy => "false"} (
                          %mi a
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mi σ
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mi χ
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mi k
                          %mi χ
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mi σ
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mi b
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mi ψ
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mi b
                          %mo{:stretchy => "false"} )
                          %msub
                            %mi Ad
                            %mi K
                          %mo{:stretchy => "false"} (
                          %mi χ
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mi k
                          %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\psi(a)\psi(b)k &amp; = &amp; \phi(\sigma(a))\phi(\sigma(b))k \\
                  \&amp; = &amp; \sigma(a)\sigma(b)k\sigma(b)^{-1}\sigma(a)^{-1} \\
                  \&amp; = &amp; \sigma(a b)\chi(a,b)k\chi(a,b)^{-1}\sigma(a b)^{-1} \\
                  \&amp; = &amp; \psi(a b) Ad_K(\chi(a,b)) k,
                  }
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ad
                    %mi K
                %annotation{:encoding => "application/x-tex"} Ad_K
            is the canonical map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo →
                    %mi Int
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K \rightarrow Int(K)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ↦
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi k
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} k\mapsto k(-)k^{-1}
          %p Thus we obtain the relation
          #eq:psi2.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mi b
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi Ad
                    %mi K
                  %mo{:stretchy => "false"} (
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\psi(a)\psi(b) = \psi(a b) Ad_K(\chi(a,b))
          .num_defn
            %h6#definition_12 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              be two groups. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo :
                    %mi B
                    %mo ×
                    %mi B
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \chi: B \times B \rightarrow K
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo :
                    %mi B
                    %mo →
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \psi : B \rightarrow Aut(K)
              satisfy
              %a.maruku-eqref{:href => "#eq:psi1"} (4)
              and
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:psi2"} (5)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %msub
                      %mi b
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %msub
                      %mi b
                      %mn 2
                    %mo ∈
                    %mi B
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\chi(b_1,b_2)| b_1,b_2 \in B\}
              is a factor system (This term is due Schreier(1924)) or a
              = succeed "," do
                %strong nonabelian group 2-cocycle with automorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mi b
                    %mo ∈
                    %mi B
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\psi(b) | b \in B \}
              – a system of automorphisms
          %p
            A 2-cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                %annotation{:encoding => "application/x-tex"} \chi
            is
            %strong counital
            if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi e
                  %annotation{:encoding => "application/x-tex"} \chi(b,e) = \chi(e,b) = e
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} b \in B
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is commutative, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \psi
            is always a homomorphism (cf.
            = succeed ")." do
              %a.maruku-eqref{:href => "#eq:psi2"} (5)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is a right
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \psi(-)^{-1}
            = succeed "-module\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mi ψ
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (K,\psi,\chi)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \psi
            is trivial (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Id
                    %mi K
                  %mo ,
                  %mo ∀
                  %mi b
                  %mo ∈
                  %mi B
                %annotation{:encoding => "application/x-tex"} \psi(b) = Id_K, \forall b \in B
            ) then the cocycle condition
            %a.maruku-eqref{:href => "#eq:psi1"} (4)
            becomes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\chi(a b,c)\chi(a,b) = \chi(a,b c)\chi(b,c).
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              If formulas
              %a.maruku-eqref{:href => "#eq:psi1"} (4)
              and
              %a.maruku-eqref{:href => "#eq:psi2"} (5)
              are both satisfied, then the formula
              %a.maruku-eqref{:href => "#eq:mrule"} (3)
              for multiplication of pairs defines a group multiplication on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ×
                      %mi K
                    %annotation{:encoding => "application/x-tex"} B \times K
              %a.maruku-eqref{:href => "#eq:mrule"} (3)
              is called the
              %strong cocycle cross product
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              with cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} \chi
              and action
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi χ
                      %mo{:stretchy => "false"} (
                      %mo ⋅
                      %mo ,
                      %mo ⋅
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi e
                        %mi K
                    %annotation{:encoding => "application/x-tex"} \chi(\cdot,\cdot) = e_K
              = succeed "." do
                %strong (external) semidirect product
          .proof
            %h6#proof_11 Proof
            %p
              We have checked above the
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
              for pairs of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,e)
              etc. This was useful to find the cocycle condition correctly. Now the general associativity should be a similar calculation with general elements. Using
              %a.maruku-eqref{:href => "#eq:psi1"} (4)
              and
              %a.maruku-eqref{:href => "#eq:psi2"} (5)
              it can be done.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ψ
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mi ψ
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo{:stretchy => "false"} )
                            %mi k
                          %mtd
                            %mo =
                          %mtd
                            %mi ψ
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi Ad
                              %mi K
                            %mo{:stretchy => "false"} (
                            %mi χ
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ,
                            %mi e
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mi ψ
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mi χ
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ,
                            %mi e
                            %mo{:stretchy => "false"} )
                            %mi k
                            %mi χ
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ,
                            %mi e
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\psi(a)\psi(e)k &amp; =&amp; \psi(a)Ad_K(\chi(a,e))k \\
                    \&amp; = &amp;\psi(a)\chi(a,e)k\chi(a,e)^{-1}
                    }
            %p
              where we used
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:psi2"} (5)
            %p
              Thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ad
                      %mi K
                    %mo{:stretchy => "false"} (
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ad_K(\chi(a,e)) = \psi(e)
              and therefore it does not depend on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
            %p
              Then use
              %a.maruku-eqref{:href => "#eq:psi1"} (4)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo =
                    %mi c
                    %mo =
                    %mi e
                  %annotation{:encoding => "application/x-tex"} b = c = e
              to get
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo{:stretchy => "false"} (
                      %mi e
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi χ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi χ
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo ∀
                      %mi a
                      %mo ∈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \psi(e)^{-1}(\chi(a,e)) = \chi(e,e), \forall a \in B
            %p
              Thus
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi χ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi e
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi χ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mi χ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi χ
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \chi(a,e)^{-1}(\chi(a,e))\chi(a,e) = \chi(e,e)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi(a,e)
              does not depend on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
            %p
              Now we claim that the
              %em unit
              element is given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi χ
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi e
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (e, \chi(e,e)^{-1})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ,
                            %mi b
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo ,
                            %mi χ
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo ,
                            %mi e
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ,
                            %mi χ
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ,
                            %mi e
                            %mo{:stretchy => "false"} )
                            %mi ψ
                            %mo{:stretchy => "false"} (
                            %mi e
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mo{:stretchy => "false"} )
                            %mi χ
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo ,
                            %mi e
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ,
                            %mi χ
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ,
                            %mi e
                            %mo{:stretchy => "false"} )
                            %mi χ
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo ,
                            %mi e
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi b
                            %mi χ
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo ,
                            %mi e
                            %mo{:stretchy => "false"} )
                            %mi χ
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo ,
                            %mi e
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (a,b)(e,\chi(e,e)^{-1}) &amp; = &amp; (a, \chi(a,e) \psi(e)^{-1}(b)\chi(e,e)^{-1}) \\
                    \&amp; = &amp; (a, \chi(a,e)\chi(e,e)^{-1}b\chi(e,e)\chi(e,e)^{-1})
                    }
            %p
              what is equal to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b)
              by just proved statement that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi(a,e)
              does not depend on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
            %p
              Now use
              %a.maruku-eqref{:href => "#eq:psi1"} (4)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi b
                    %mo =
                    %mi e
                  %annotation{:encoding => "application/x-tex"} a = b = e
              to get
            #eq:psiac.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ∀
                    %mi c
                    %mo ∈
                    %mi B
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\psi(c)^{-1}(\chi(e,e)) = \chi(e,c), \forall c \in B.
            %p
              Thus we can verify that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e, \chi(e,e)^{-1})
              is a left unit too by a calculation as follows. Namely
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e,\chi(e,e)^{-1})(a,b)= (a,\chi(e,a)\psi(a)^{-1}(\chi(e,e)^{-1})b)
            %p
              by the definition of the product. Then by
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:psiac"} (6)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,\psi(a)^{-1}(\chi(e,e))\psi(a)^{-1}(\chi(e,e)^{-1})b)
            %p
              and, because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \psi(a)^{-1}
              is an antiautomorphism, this is finally equal to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (a,b)
            %p
              Now check that each element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b)
              can be factorized as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi χ
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi e
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (a,e)(e,\chi(e,e)^{-1}b)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b)
              has an inverse it is then enough to show that both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,e)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e,\chi(e,e)^{-1}b)
              have inverses.
            %p
              Claim: the inverse of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,e)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi a
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} (a^{-1},\chi(a,a)^{-1}\chi(e,e)^{-1}).
            %p To this aim, we calculate
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} (a,e)(a^{-1},\chi(a,a^{-1})^{-1}\chi(e,e)^{-1}) = (e,\chi(a,a^{-1})\psi(a^{-1})^{-1}(e)\chi(a,a^{-1})^{-1}\chi(e,e)^{-1}) =(e,\chi(e,e^{-1}),
            %p
              because
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi e
                    %annotation{:encoding => "application/x-tex"} \psi(a)^{-1}(e) = e
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} (a,e)(a^{-1},\chi(a,a^{-1})^{-1}\chi(e,e)^{-1}) = (e,\chi(a,a^{-1})\psi(a^{-1})^{-1}(e)\chi(a,a^{-1})^{-1}\chi(e,e)^{-1}) = (e,\chi(e,e^{-1}),
            %p
              because
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi e
                    %annotation{:encoding => "application/x-tex"} \psi(a)^{-1}(e) = e
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (a^{-1},\chi(a,a^{-1})^{-1}\chi(e,e)^{-1})(a,e) =
                    (e,\chi(a^{-1},a)\psi(a)^{-1}(\chi(a,a^{-1}) \chi(e,e)^{-1}))
            %p
              what equals
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi χ
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi e
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (e,\chi(e,e)^{-1})
            %p
              Indeed,
              %a.maruku-eqref{:href => "#eq:psi1"} (4)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi a
                    %mo ,
                    %mi b
                    %mo =
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi c
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a = a, b = a^{-1}, c = a
              reads
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi(e,a) \psi(a)^{-1}(\chi(a, a^{-1}))
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo =
                      %mi χ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mi χ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi a
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} =\chi(a,e)\chi(a^{-1},a)
            %p
              Then apply
              %a.maruku-eqref{:href => "#eq:psiac"} (6)
              and take inverse of both sides to obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi a
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\psi(a)^{-1}(\chi(a,a^{-1})^{-1}\chi(e,e)^{-1}))
                    \= \chi(a^{-1},a)^{-1}\chi(a,e)^{-1}.
            %p
              Then recall that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi(a,e)
              does not depend on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              and multiply by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi(a^{-1},a)
              from the left.
            %p
              Claim: the inverse of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e,\chi(e,e)^{-1}k)
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi χ
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %msup
                        %mi k
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (e,\chi(e,e)k^{-1})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              vs.
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi k
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} k^{-1}
          %p
            Given groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
