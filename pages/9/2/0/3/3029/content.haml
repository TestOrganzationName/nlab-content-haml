                    %mi K
                %annotation{:encoding => "application/x-tex"} k_1 = e_K
            we have therefore
          #eq:equiv1.maruku-equation
            %span.maruku-eq-number (7)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
