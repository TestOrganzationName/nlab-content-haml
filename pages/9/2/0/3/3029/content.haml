              of groups precisely if the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi A
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}A \to \mathbf{B}\hat G \to \mathbf{B}G
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
              in the
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
          %p
            This says that group extensions are special cases of the general notion discussed at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+extension"} ∞-group extension
          #MorphismOfGroupExtensions.num_defn
            %h6#definition_4 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of extensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo →
                    %msub
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ^
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f : \hat G_1 \to \hat G_2
              of a given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              by a given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
              of this form which fits into a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mover
                                %mi G
                                %mo{:stretchy => "false"} ^
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                          %mtd
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mover
                                %mi G
                                %mo{:stretchy => "false"} ^
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \hat G_1
                    \\\
                    \&amp; \nearrow &amp;&amp; \searrow
                    \\\
                    A &amp;&amp;\downarrow^{\mathrlap{f}}&amp;&amp; G
                    \\\
                    \&amp; \searrow &amp;&amp; \nearrow
                    \\\
                    \&amp;&amp; \hat G_2
                    }
                    \\,.
          .num_prop
            %h6#proposition Proposition
            %p
              A morphism of extensions as in def.
              %a.maruku-ref{:href => "#MorphismOfGroupExtensions"}
              is necessarily an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            #eq:equivExt.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 1
                            %mo →
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi i
                          %mtd
                            %msub
                              %mover
                                %mi G
                                %mo{:stretchy => "false"} ^
                              %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mi p
                          %mtd
                            %mi G
                          %mtd
                            %mo →
                            %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo =
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi ϵ
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo =
                          %mtd
                        %mtr
                          %mtd
                            %mn 1
                            %mo →
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi i
                                %mo ′
                          %mtd
                            %msub
                              %mover
                                %mi G
                                %mo{:stretchy => "false"} ^
                              %mn 2
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi p
                                %mo ′
                          %mtd
                            %mi G
                          %mtd
                            %mo →
                            %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    1\to &amp;A&amp;\stackrel{i}\to &amp;\hat G_1&amp;\stackrel{p}\to &amp;G&amp;\to 1
                    \\\
                    \&amp;\downarrow\mathrlap{=}&amp;&amp;\downarrow\mathrlap\epsilon&amp;&amp;\downarrow\mathrlap=&amp;
                    \\\
                    1\to &amp;A&amp;\stackrel{i'}\to &amp;\hat G_2&amp;\stackrel{p'}\to&amp; G&amp;\to 1
                    }
                    \\,.
          .proof
            %h6#proof Proof
            %p
              By the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/short+five+lemma"} short five lemma
          %h2#properties Properties
          %p We discuss properties of group extensions in stages,
          %ul
            %li
              %p
                %a{:href => "#PropertiesGeneral"} General properties
            %li
              %p
                %a{:href => "#PropertiesCentralGroupExtensions"} Central group extensions
            %li
              %p
                %a{:href => "#PropertiesAbelianGroupExtensions"} Abelian group extensions
            %li
              %p
                %a{:href => "#SchreierTheory"} Schreier theory for nonabelian extensions
          %h3#PropertiesGeneral General
          %h4#fibers_of_extensions_are_normal_subgroups Fibers of extensions are normal subgroups
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↪
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} A \hookrightarrow \hat G \to G
              a group extension, the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↪
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} A \hookrightarrow \hat G
              is a
              %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
              inclusion.
          .proof
            %h6#proof_2 Proof
            %p
              We need to check that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                    %mo ↪
                    %mi G
                  %annotation{:encoding => "application/x-tex"} a \in A \hookrightarrow G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
              the result of the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mi a
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} g a g^{-1}
              formed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat G
              is again in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mover
                        %mo ↪
                        %mi i
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} A \stackrel{i}{\hookrightarrow} \hat G
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} p : \hat G \to G
              is a group homomorphism we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mi a
                            %msup
                              %mi g
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi q
                            %mo{:stretchy => "false"} )
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mi p
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi g
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi g
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi g
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p(g a g^{-1}) &amp; = p(q) p(a) p(g^{-1})
                    \\\
                    \&amp; = p(g) p(a) p(g)^{-1}
                    \\\
                    \&amp; = p(g) p(g)^{-1}
                    \\\
                    \&amp; = 1
                    \\end{aligned}
            %p
              and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mi a
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} g a g^{-1}
              is in the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
          %h4#Torsors Extensions as torsors / principal bundles
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo →
                      %mi i
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo →
                      %mi p
                    %mi G
                  %annotation{:encoding => "application/x-tex"} A \stackrel{i}{\to} \hat G \stackrel{p}{\to} G
              a group extension, we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} p : \hat G \to G
              is an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              where the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat G
              is defined by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo :
                    %mi A
                    %mo ×
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi Id
                        %mo{:stretchy => "false"} )
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo ×
                      %mi G
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo →
                      %mo ⋅
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\rho : A \times \hat G \stackrel{(i,Id)}{\to} \hat G \times_G \hat G \stackrel{\cdot}{\to} \hat G
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              is indeed an action
              %em over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ×
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi ρ
                          %mtd
                          %mtd
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi p
                                  %mo ∘
                                  %msub
                                    %mi p
                                    %mn 2
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \times \hat G &amp;&amp;\stackrel{\rho}{\to}&amp;&amp; \hat G
                    \\\
                    \&amp; {}_{\mathllap{ p \circ p_2}}\searrow &amp;&amp; \swarrow_{\mathrlap{p}}
                    \\\
                    \&amp;&amp;  G
                    }
            %p
              follows from the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is a group homomorphism and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is in its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is actually
              %em equal
              to the kernel gives the principality condition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo ,
                    %msub
                      %mi p
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                    %mo ×
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo →
                      %mo ≃
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo ×
                      %mi G
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\rho, p_2) : A\times \hat G \stackrel{\simeq}{\to} \hat G \times_G \hat G
                    \\,.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            an
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            we may understand the
            = succeed "-torsor/" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat G
            as the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}A
            %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi BG
                %annotation{:encoding => "application/x-tex"} \mathbf{B} \hat G \to \mathbf{BG}
            that is classified by (is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of) the 2-
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in
            %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi A
                %annotation{:encoding => "application/x-tex"} c : \mathbf{B}G \to \mathbf{B}^2 A
            that classifies the extension.
          %p All this is then summarized by the statement that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mi G
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi A
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mover
                    %mo →
                    %mi c
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  A \to \hat G \to G \to \mathbf{B}A \to \mathbf{B}\hat G \to \mathbf{B}G \stackrel{c}{\to}
                  \\mathbf{B}^2 A
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
            in
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            (or in
            %a.existingWikiWord{:href => "/nlab/show/LieGrpd"} LieGrpd
            if we have
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            extensions, etc).
          %p
            Here we may think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \mathbf{B}\hat G
            as being the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}A
            %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            classified by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
          %h4#SplitExtensionsAndSemidirectProductGroups Split extensions and semidirect product groups
          #SplitExtension.num_defn
            %h6#definition_5 Definition
            %p
              A group extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo →
                      %mi p
                    %mi G
                  %annotation{:encoding => "application/x-tex"} A \to \hat G \stackrel{p}{\to} G
              is called
              %strong split
              if there is a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi G
                      %mo →
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \sigma \colon G \to \hat G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∘
                      %mi σ
                      %mo =
                      %msub
                        %mi id
                        %mi G
                    %annotation{:encoding => "application/x-tex"} p \circ \sigma = id_G
          .num_remark
            %h6#remark_2 Remark
            %p
              It is important here that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              is itself required to be a group homomorphism, not just a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              on the underlying sets. The latter always exists as soon as the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              holds, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              by definition.
          #SplitExtensionsAreSemidirectProducts.num_prop
            %h6#proposition_4 Proposition
            %p
              Split extensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat G
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.maruku-ref{:href => "#SplitExtension"}
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+groups"} semidirect product groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↪
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo ≃
                    %mi A
                    %msub
                      %mo ⋊
                      %mi ρ
                    %mi G
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    A \hookrightarrow \hat G \simeq A \rtimes_\rho G \to G
            %p
              for some
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo ×
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \rho \colon G \times A  \to A
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
            This means that the underlying set is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msub
                    %mo ⋊
                    %mi ρ
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(A \rtimes_\rho G) = U(A) \times U(G)
            and the group operation in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo ⋊
                    %mi ρ
                  %mi G
                %annotation{:encoding => "application/x-tex"} A \rtimes_\rho G
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
                  %msub
                    %mi g
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 2
                  %mo ,
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 1
                  %mo ⋅
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi g
                    %mn 1
                  %mo ⋅
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (a_1, g_1) \cdot (a_2, g_2)
                  \=
                  (a_1 \cdot \rho(g_1)(a_2) , g_1 \cdot g_2)
                  \\,.
          %p
            The inclusion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  a \mapsto (a,e)
          %p
            and the projection to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi g
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (a,g) \mapsto g
                  \\,.
          .proof
            %h6#proof_4 Proof
            %p
              Given a split extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo →
                      %mi i
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo →
                      %mi p
                    %mi G
                  %annotation{:encoding => "application/x-tex"} A \stackrel{i}{\to} \hat G \stackrel{p}{\to} G
              with splitting
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi G
                      %mo →
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \sigma \colon G \to \hat G
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              by the restriction of the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi ad
                  %annotation{:encoding => "application/x-tex"} \rho_{ad}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat G
              on itself to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ×
                    %mi G
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi σ
                        %mo{:stretchy => "false"} )
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo ×
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ρ
                          %mi ad
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"}
                    \\rho
                    \\colon
                    A \times G
                    \\stackrel{(i,\sigma)}{\to}
                    \\hat G \times \hat G
                    \\stackrel{\rho_{ad}}{\to}
                    \\hat G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ⋅
                    %mi a
                    %mo ⋅
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (a,g) \mapsto \sigma(g)^{-1} \cdot a \cdot \sigma(g)
                    \\,.
            %p Then (…)
          .num_prop
            %h6#proposition_5 Proposition
            %p
              A split extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} A \to \hat G \to G
              is a
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
              precisely if the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              induced from it as in prop.
              %a.maruku-ref{:href => "#SplitExtensionsAreSemidirectProducts"}
              is trivial.
          .proof
            %h6#proof_5 Proof
            %p
              For it to be a central extension the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi A
                    %msub
                      %mo ⋊
                      %mi ρ
                    %mi G
                  %annotation{:encoding => "application/x-tex"} A \to A \rtimes_\rho G
              has to land in the
              %a.existingWikiWord{:href => "/nlab/show/center"} center
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %msub
                        %mo ⋊
                        %mi ρ
                      %mi G
                    %annotation{:encoding => "application/x-tex"} A \rtimes_\rho G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a \in A
              have to commute as elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi A
                    %msub
                      %mo ⋊
                      %mi ρ
                    %mi G
                  %annotation{:encoding => "application/x-tex"} (a,e) \in A \rtimes_\rho G
              with all elements of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %msub
                        %mo ⋊
                        %mi ρ
                      %mi G
                    %annotation{:encoding => "application/x-tex"} A \rtimes_\rho G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi A
                    %msub
                      %mo ⋊
                      %mi ρ
                    %mi G
                  %annotation{:encoding => "application/x-tex"} (e,g) \in A \rtimes_\rho G
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} g \in G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (a,e) \cdot (e,g) = (a, g)
            %p but
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (e,g) \cdot (a,e) = (\rho(g)(a), g)
                    \\,.
            %p
              For these to be equal for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho(g)
