                    H^2_{Grp}(G,A) \stackrel{\underoverset{\simeq}{Extr}{\leftarrow}}{\underset{Rec}{\to}} CentrExt(G,A)
                    \\,.
          .proof
            %h6#proof_8 Proof
            %p
              Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi c
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %msubsup
                        %mi H
                        %mi Grp
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [c] \in H^2_{Grp}(G,A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo ≔
                    %mi G
                    %msub
                      %mo ×
                      %mi c
                    %mi A
