          %h2#idea Idea
          %p
            A
            %em multi trace observable
            in a
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            is a
            %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
            in
            %a.existingWikiWord{:href => "/nlab/show/single+trace+operators"} single trace operators
            (see there for more background).
          %h2#properties Properties
          %h3#under_adscft_correspondence Under AdS/CFT correspondence
          %p
            Under the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/AdS%2FCFT+correspondence"} AdS/CFT correspondence
            %a.existingWikiWord{:href => "/nlab/show/single+trace+observables"} single trace observables
            in the gauge theory correspond to single particle/string excitations on the
            = succeed "-side," do
              %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            = succeed "," do
              %a{:href => "#Liu98"} Liu 98, p. 6 (7 of 39)
            = succeed "," do
              %a{:href => "#AndrianapoliFerrara99"} Andrianapoli-Ferrara 99, p. 13
            = succeed "," do
              %a{:href => "#ChalmersSchalm00"} Chalmers-Schalm 00, Section 7
            = succeed ")" do
              %a{:href => "#AharonyGubserMaldacenaOoguriOz9"} Aharony-Gubser-Maldacena-Ooguri-Oz 99, p. 75
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/asymptotic+boundary"} asymptotic
            %a.existingWikiWord{:href => "/nlab/show/boundary+conditions"} boundary conditions
            for
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            on the AdS-side
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} →
                  %mo ,
                  %mi r
                  %mo{:stretchy => "false"} )
                  %msub
                    %mover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi r
                        %mo →
                        %mn 0
                    %mi i
                  %msub
                    %mi α
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi r
                    %mrow
                      %mi d
                      %mo −
                      %msub
                        %mi λ
                        %mi i
                  %mo +
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  \\Phi(\vec x, r)
                  \\overset{r \to 0}
                  \\sum_i
                  \\alpha_i (\vec x)
                  r^{d -\lambda_i}
                  +
                  \\cdots
          %p
            that correspond to multi-trace observables
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi 𝒪
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(\{\mathcal{O}_i\})
            have
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            given by the
            %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            of the multi-trace
            %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
            by its single-trace variables
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi i
                  %mo =
                  %msub
                    %mo ∂
                    %mrow
                      %msub
                        %mi 𝒪
                        %mi i
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi 𝒪
                    %mi i
                  %mo{:stretchy => "false"} ⟩
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\alpha_i
                  \=
                  \\partial_{\mathcal{O}_i}
                  W
                  (\{\langle\mathcal{O}_i\rangle\})
          %p
            (
            %a{:href => "#Witten01"}> Witten 01, Section 3
            )
          %h2#examples Examples
          %div
            %h3#AsLieWeightSystemsInBMNModel Chord diagrams as multi-trace observables in the BMN matrix model
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetric
              %a.existingWikiWord{:href => "/nlab/show/states"} states
              of the
              %a.existingWikiWord{:href => "/nlab/show/BMN+matrix+model"} BMN matrix model
              are temporally constant complex matrices which are
              %a.existingWikiWord{:href => "/nlab/show/complex+number"} complex
              %a.existingWikiWord{:href => "/nlab/show/metric+Lie+representations"} metric Lie representations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo ⊗
                    %mi V
                    %mover
                      %mo →
                      %mi ρ
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \otimes V \overset{\rho}{\to} V
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}=
              %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
              (interpreted as
              %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-sphere"} fuzzy 2-sphere
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometries"} noncommutative geometries
              of
              %a.existingWikiWord{:href => "/nlab/show/giant+gravitons"} giant gravitons
              or equivalently as
              %a.existingWikiWord{:href => "/nlab/show/fuzzy+funnels"} fuzzy funnels
              of
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/D0-D2+brane+bound+states"} D0-D2 brane bound states
            %p
              A
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-sphere"} fuzzy 2-sphere
              %a.existingWikiWord{:href => "/nlab/show/rotation"} rotation
              %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
              %a.existingWikiWord{:href => "/nlab/show/multi-trace+observable"} multi-trace observable
              on these supersymmetric states is hence an expression of the following form:
            %center
              %img{:src => "https://ncatlab.org/nlab/files/InvariantMultiTraceObservableOnBMNModelStates.jpg", :width => "600"}/
            %blockquote
              %p
                (from
                = succeed ")" do
                  %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Sati-Schreiber 19c
            %p
              Here we are showing the corresponding
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/string+diagram"} string diagram
              %a.existingWikiWord{:href => "/nlab/show/Penrose+notation"} Penrose notation
              for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metric+Lie+representations"} metric Lie representations
            %ol
              %li
                %p
                  these multi-trace observables are encoded by
                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+chord+diagrams"} Sullivan chord diagrams
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
              %li
                %p
                  their value on the supersymmetric states
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔰𝔲
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mi V
                        %mover
                          %mo →
                          %mi ρ
                        %mi V
                      %annotation{:encoding => "application/x-tex"} \mathfrak{su}(2) \otimes V \overset{\rho}{\to}V
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
                  of the corresponding
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+system"} Lie algebra weight system
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi w
                          %mrow
                            %msub
                              %mrow
                              %mi V
                      %annotation{:encoding => "application/x-tex"} w_{{}_V}
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                        %annotation{:encoding => "application/x-tex"} D
            %p
              Or equivalently, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi D
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat D
              is a
              %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagram"} horizontal chord diagram
              whose
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permuted
              closure is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              (see
              = succeed ")" do
                %a{:href => "horizontal+chord+diagram#ClosureToSullivanChordDiagrams"} here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi w
                      %mrow
                        %mi V
                        %mo ,
                        %mi σ
                  %annotation{:encoding => "application/x-tex"} w_{V,\sigma}
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi D
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat D
            %center
              %img{:src => "https://ncatlab.org/nlab/files/MultiTraceObservableFromSullivanChordDiagramII.jpg", :width => "800"}/
            %blockquote
              %p
                (from
                = succeed ")" do
                  %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Sati-Schreiber 19c
            %p
              But since
              %a.existingWikiWord{:href => "/nlab/show/all+horizontal+weight+systems+are+partitioned+Lie+algebra+weight+systems"} all horizontal weight systems are partitioned Lie algebra weight systems
              this way, this identifies supersymmetric states of the BMN matrix model as seen by invariant multi-trace observables as
              %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagrams"} horizontal chord diagrams
              evaluated in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+systems"} Lie algebra weight systems
          %h2#references References
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/multi-trace+operators"} multi-trace operators
            in
            %a.existingWikiWord{:href => "/nlab/show/super+Yang-Mills+theory"} super Yang-Mills theory
            and of their
            %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+duality"} AdS-CFT dual
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            incarnation:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tom+Banks"}> Tom Banks
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Douglas"} Michael Douglas
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gary+Horowitz"} Gary Horowitz
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Emil+Martinec"} Emil Martinec
                %em AdS Dynamics from Conformal Field Theory
                (
                %a{:href => "https://arxiv.org/abs/hep-th/9808016"}> arXiv:hep-th/9808016
                ,
                = succeed ")" do
                  %a{:href => "http://inspirehep.net/record/474214"} spire:474214
            %li#Liu98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hong+Liu"}> Hong Liu
                ,
                = succeed "," do
                  %em Scattering in Anti-de Sitter Space and Operator Product Expansion
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9811152"} arXiv:hep-th/9811152
            %li#AndrianapoliFerrara99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Laura+Andrianopoli"}> Laura Andrianopoli
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sergio+Ferrara"} Sergio Ferrara
                = succeed "," do
                  %em
                    On short and long
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo ,
                          %mn 2
                          %mo{:stretchy => "false"} /
                          %mn 4
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SU(2,2/4)
                    multiplets in the AdS/CFT correspondence
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9812067"} arXiv:hep-th/9812067
            %li#ChalmersSchalm00
              %p
                Gordon Chalmers, Koenraad Schalm,
                = succeed "," do
                  %em Holographic Normal Ordering and Multi-particle States in the AdS/CFT Correspondence
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9901144"} arXiv:hep-th/9901144
            %li#AharonyGubserMaldacenaOoguriOz99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ofer+Aharony"}> Ofer Aharony
