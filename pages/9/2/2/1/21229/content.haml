            %h3#QuantumHadrodynamicsReferences Walecka hadrodynamics with nucleon fields
            %p
              On
              %a.existingWikiWord{:href => "/nlab/show/quantum+hadrodynamics"} quantum hadrodynamics
              (
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativivist
              %a.existingWikiWord{:href => "/nlab/show/effective+field+theory"} effective field theory
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/nuclear+physics"} nuclear physics
              %a.existingWikiWord{:href => "/nlab/show/interaction"} coupling
              %a.existingWikiWord{:href => "/nlab/show/mesons"} mesons
              and
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/nucleons"} nucleons
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Walecka+model"} Walecka model
              %a.existingWikiWord{:href => "/nlab/show/nucleons"} nucleons
              appearing as explicit
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
              (as opposed to being
              %a.existingWikiWord{:href => "/nlab/show/soliton"} solitonic
              %a.existingWikiWord{:href => "/nlab/show/Skyrmions"} Skyrmions
              in the
              %a.existingWikiWord{:href => "/nlab/show/pion+field"} pion field
              as in
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/chiral+perturbation+theory"} chiral perturbation theory
            %p Precursor:
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Hans-Peter+Duerr"}> Hans-Peter Duerr
                ,
                = succeed "," do
                  %em Relativistic Effects in Nuclear Forces
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1103/PhysRev.103.469"} doi:10.1103/PhysRev.103.469
            %p
              The original
              %a.existingWikiWord{:href => "/nlab/show/Walecka+model"} Walecka model
              (
              %em> QHD-I model
              ), with
              %a.existingWikiWord{:href => "/nlab/show/nucleons"} nucleons
              coupled to
              %a.existingWikiWord{:href => "/nlab/show/sigma-mesons"} sigma-mesons
              and
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/omega-mesons"} omega-mesons
            %ul
              %li#Walecka74
                %a.existingWikiWord{:href => "/nlab/show/John+Dirk+Walecka"}> John Dirk Walecka
                ,
                = succeed "," do
                  %em A Theory of highly condensed matter
                = succeed "," do
                  %a{:href => "http://inspirehep.net/record/91609?ln=en"} spire:91609
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0003-4916(74)90208-5"} dpi:10.1016/0003-4916(74)90208-5
            %p
              Inclusion into the
              %a.existingWikiWord{:href => "/nlab/show/Walecka+model"} Walecka model
              also of the
              %a.existingWikiWord{:href => "/nlab/show/pion"} pion
              and the
              %a.existingWikiWord{:href => "/nlab/show/rho-meson"} rho-meson
              (the
              = succeed "):" do
                %em QHD-II model
            %ul
