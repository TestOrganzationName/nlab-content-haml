                = succeed "-form" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %mi k
                      %annotation{:encoding => "application/x-tex"} 2k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(\Omega)
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
              %p
                Prove that the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi k
                    %annotation{:encoding => "application/x-tex"} 2k
                form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(\Omega)
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                projects uniquely to a
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi k
                    %annotation{:encoding => "application/x-tex"} 2k
                form on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                and call it
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde{f}(\Omega)
                i.e.,
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi π
                          %mo *
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ˜
                        %mo{:stretchy => "false"} (
                        %mi Ω
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo =
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi Ω
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi^*\big(\tilde{f}(\Omega)\big) = f(\Omega)
            %li
              %p
                Next step is to prove that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde{f}(\Omega)
                is closed
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi k
                    %annotation{:encoding => "application/x-tex"} 2k
                form on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde{f}(\Omega)
                is closed, it suffices to prove that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(\Omega)
                is closed.
            %li
              %p
                For a
                %strong special
                = succeed "-form" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi φ
                    %annotation{:encoding => "application/x-tex"} \varphi
                on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                %a.existingWikiWord{:href => "/nlab/show/exterior+differential"} exterior differential
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi φ
                    %annotation{:encoding => "application/x-tex"} d\varphi
                coincides with the exterior covariant differential
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mi φ
                    %annotation{:encoding => "application/x-tex"} D\varphi
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi φ
                    %annotation{:encoding => "application/x-tex"} \varphi
                i.e.,
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mi φ
                        %mo =
                        %mi D
                        %mi φ
                      %annotation{:encoding => "application/x-tex"} d\varphi=D\varphi
                %strong special
                property is that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi φ
                      %mo =
                      %msup
                        %mi π
                        %mo *
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \varphi=\pi^*\sigma
                for some
                = succeed "-form" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
            %li
              %p
                As
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(\Omega)
                has that
                %strong special
                property, we see that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi Ω
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo =
                        %mi D
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi Ω
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} d\big(f(\Omega)\big) = D\big(f(\Omega)\big)
            %li
              %p
                By Bianchi’s identity, we have
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mi Ω
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} D\Omega=0
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mi Ω
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} D\Omega=0
                implies that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} D(f(\Omega))=0
                i.e.,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d(f(\Omega))=D(f(\Omega))=0
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %msup
                        %mi I
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f\in I^k(G)
                i.e.,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(\Omega)
                is a closed
                = succeed "-form" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %mi k
                      %annotation{:encoding => "application/x-tex"} 2k
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde{f}(\Omega)
                is a closed
                = succeed "-form" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %mi k
                      %annotation{:encoding => "application/x-tex"} 2k
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mrow
                            %mn 2
                            %mi k
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo ,
                        %mi ℝ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H^{2k}(M,\mathbb{R})
            %li
              %p
                Next step is to prove that, this assignment
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ↦
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f\mapsto \tilde{f}(\Omega)
                does not depend on the connection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
                that we have started with i.e., for connections
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \Gamma_0
                (with curvature form
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Ω
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \Omega_0
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Gamma_1
                (with curvature form
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Ω
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \Omega_1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ω
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde{f}(\Omega_0)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde{f}(\Omega_1)
                are in the same equivalence class i.e.,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ω
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde{f}(\Omega_0)-\tilde{f}(\Omega_1)
                is an exact form i.e.,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ω
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi d
                      %mover
                        %mi Φ
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde{f}(\Omega_0)-\tilde{f}(\Omega_1)=d\tilde{\Phi}
                for some
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi k
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 2k-1
                form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Φ
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde{\Phi}
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
            %li
              %p
                Using lemma
                = succeed "," do
                  %a.maruku-ref{:href => "#useful"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ω
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi d
                      %mover
                        %mi Φ
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde{f}(\Omega_0)-\tilde{f}(\Omega_1)=d\tilde{\Phi}
                for some
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi k
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 2k-1
                form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Φ
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde{\Phi}
                on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ω
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi d
                      %mi Φ
                    %annotation{:encoding => "application/x-tex"} f(\Omega_0)-f(\Omega_1)=d \Phi
                for some
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi k
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 2k-1
                form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                    %annotation{:encoding => "application/x-tex"} \Phi
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                that projects to a unique
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi k
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 2k-1
                form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Φ
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde{\Phi}
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
            %li
              %p
                We then see that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ω
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi d
                      %mi Φ
                    %annotation{:encoding => "application/x-tex"} f(\Omega_0)-f(\Omega_1)=d \Phi
                for some
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi k
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 2k-1
                form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                    %annotation{:encoding => "application/x-tex"} \Phi
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                that projects to a unique
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi k
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 2k-1
                form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Φ
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde{\Phi}
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ↦
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f\mapsto f(\Omega)
                is independent of the connection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
                that we have started with. We can extend this linearly to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msup
                          %mi H
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo ,
                        %mi ℝ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} I(G)\rightarrow H^*(M,\mathbb{R})
          %p
            Given a principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi P
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} \pi \,\colon\, P\rightarrow M
            the morphism defined above
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi H
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} I(G)\rightarrow H^*(M,\mathbb{R})
            is called the Weil homomorphism.
          %h2#refined_chernweil_homomorphism Refined Chern–Weil homomorphism
          %p
            We describe the
            %em refined
            Chern–Weil homomorphism (which associates a class in
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            to a
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            with
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
          %p
            The modern construction is rather short and elegant, and appears in the work of Bunke–Nikolaus–Völkl and Schreiber. Exposition is in
            = succeed "." do
              %a{:href => "#ADH21"} Amabel, Debray &amp; Haine 2021, Part II
          %p
            The input data is an arbitrary
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            on the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/level"} level
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %msup
                    %mi H
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi G
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c\in H^k(B G,\mathbf{Z})
            whose image under the homomomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi G
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Z
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi H
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi G
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^k(B G,\mathbf{Z}) \to H^k(B G,\mathbf{R})
          %p
            equals the image of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p
            The output data is a morphism of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-sheaves
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mo ∇
                  %mi G
                  %mo →
                  %msup
                    %mi B
                    %mrow
                      %mn 2
                      %mi k
                      %mo −
                      %mn 1
                  %mi{:mathvariant => "normal"} U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B_\nabla G\to B^{2k-1} \mathrm{U}(1)
          %p
            whose image under the characteristic class map equals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            and under the curvature map equals the classical Chern–Weil homomorphism associated to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p
            Perhaps the quickest way to construct this refinement is to observe that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mrow
                      %mn 2
                      %mi k
                      %mo −
                      %mn 1
                  %mi{:mathvariant => "normal"} U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B^{2k-1} \mathrm{U}(1)
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi closed
                    %mrow
                      %mn 2
                      %mi k
                %annotation{:encoding => "application/x-tex"} \Omega^{2k}_{closed}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mrow
                      %mn 2
                      %mi k
                  %mstyle{:mathvariant => "bold"}
                    %mi Z
                %annotation{:encoding => "application/x-tex"} B^{2k}\mathbf{Z}
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mrow
                        %mn 2
                        %mi k
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                  %annotation{:encoding => "application/x-tex"} B^{2k}\mathbf{R}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mo ∇
                  %mi G
                  %mo →
                  %msup
                    %mi B
                    %mrow
                      %mn 2
                      %mi k
                  %mstyle{:mathvariant => "bold"}
                    %mi Z
                  %mo ,
                  %mspace{:width => "2em"}
                  %msub
                    %mi B
                    %mo ∇
                  %mi G
                  %mo →
                  %msubsup
                    %mi Ω
                    %mi closed
                    %mrow
                      %mn 2
                      %mi k
                  %mo .
                %annotation{:encoding => "application/x-tex"} B_\nabla G\to B^{2k} \mathbf{Z}, \qquad B_\nabla G\to \Omega^{2k}_{closed}.
          %p
            The former map is given by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            via the classical Chern–Weil homomorphism. They are compatible by assumption on the input data.
          %h2#refined_chernweil_homomorphism_old_construction Refined Chern–Weil homomorphism: old construction
          %p
            Here is a description of an older construction in terms of the
            %a.existingWikiWord{:href => "/nlab/show/universal+connection"} universal connection
            on the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
            = succeed ")." do
              %a{:href => "#HopkinsSinger"} HopkinsSinger, section 3.3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is compact, which is not necessary in the other approaches.
          %ul
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                be a
                %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %li
              %p
                with
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %li
              %p
                and write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi inv
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} inv(\mathfrak{g})
                for the
                %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
                of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                (which has trivial differential).
            %li
              %p
                Write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                      %mi G
                    %annotation{:encoding => "application/x-tex"} B^{(n)}G
                for the smooth level
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %li
              %p
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi G
                      %mo :
                      %mo =
                      %msub
                        %mrow
                          %msub
                            %mi lim
                            %mo →
                        %mi n
                      %msup
                        %mi B
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                      %mi G
                    %annotation{:encoding => "application/x-tex"} B G := {\lim_\to}_n B^{(n)}G
                for the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
            %li
              %p
                Write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∇
                        %mi univ
                    %annotation{:encoding => "application/x-tex"} \nabla_{univ}
                for the
                %a.existingWikiWord{:href => "/nlab/show/universal+connection"} universal connection
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mi G
                        %mo →
                        %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"} E G \to B G
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi c
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %msup
                        %mi H
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mi G
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [c] \in H^k(B G, \mathbb{Z})
                be a
                %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            %li
              %p
                and choose a refinement
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %msubsup
                        %mi H
                        %mi diff
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [\hat \mathbf{c}] \in H_{diff}^k(B G)
                in
                %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
                represented by a
                %a.existingWikiWord{:href => "/nlab/show/differential+function+complex"} differential function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi h
                      %mo ,
                      %mi w
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi C
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mi G
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msup
                        %mi C
                        %mrow
                          %mi k
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mi G
                      %mo ,
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mi C
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mi G
                      %mo ,
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi k
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (c, h, w) \in C^k(B G, \mathbb{Z}) \times C^{k-1}(B G, \mathbb{R}) \times (W(\mathfrak{g}) \simeq C^k(B G, \mathbb{R}))^k
                      \\,.
          .num_defn
            %h6#definition Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              a smoth
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              with smooth classifying map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} f : X \to B G
              and
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∇
                    %annotation{:encoding => "application/x-tex"} \nabla
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CS
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo ,
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mo ∇
                      %mi univ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CS(\nabla, f^* \nabla_{univ})
              for the
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+form"} Chern-Simons form
              for the interpolation between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              and the pullback of the universal connection along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              Then defined the cocycle in
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
              given by the
