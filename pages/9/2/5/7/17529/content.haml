          #FundamentalTheoremOfFinitelyGeneratedAbelianGroups.num_theorem
            %h6#theorem Theorem
            %p
              %strong (fundamental theorem of finitely generated abelian groups)
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/finitely+generated+object"} finitely generated
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of
              %a.existingWikiWord{:href => "/nlab/show/p-primary+groups"} p-primary
              %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mi k
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p^k \mathbb{Z}
              (for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              a
              %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              a
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              ) and copies of the
              %a.existingWikiWord{:href => "/nlab/show/infinite+cyclic+group"} infinite cyclic group
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℤ
                      %mi n
                    %mo ⊕
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mi i
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msubsup
                      %mi p
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mi i
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A
                    \\;\simeq\;
                    \\mathbb{Z}^n
                    \\oplus
                    \\underset{i}{\bigoplus}
                    \\mathbb{Z}/p_i^{k_i} \mathbb{Z}
                    \\,.
            %p
              The summands of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mi k
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p^k \mathbb{Z}
              are also called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/p-primary+group"} p-primary
                components
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                  %annotation{:encoding => "application/x-tex"} p_i
              need not all be distinct.
            %p
              %strong> fundamental theorem of finite abelian groups
              \:
            %p
              In particular every
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              is of this form for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n = 0
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
            %p
              %strong> fundamental theorem of cyclic groups
              \:
            %p
              In particular every
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n\mathbb{Z}
              is a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of cyclic groups of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mi ℤ
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mi i
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msubsup
                      %mi p
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mi i
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}/n\mathbb{Z}
                    \\simeq
                    \\underset{i}{\bigoplus} \mathbb{Z}/ p_i^{k_i} \mathbb{Z}
            %p
              where all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                  %annotation{:encoding => "application/x-tex"} p_i
              are distinct and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi i
                  %annotation{:encoding => "application/x-tex"} k_i
              is the maximal power of the
              %a.existingWikiWord{:href => "/nlab/show/prime+factor"} prime factor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                  %annotation{:encoding => "application/x-tex"} p_i
              in the prime decomposition of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              Specifically, for each natural number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              dividing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              it contains
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi d
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/d\mathbb{Z}
              as the
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              generated by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo{:stretchy => "false"} /
                      %mi d
                      %mo ∈
                      %mi ℤ
                      %mo →
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi n
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n/d \in \mathbb{Z}\to \mathbb{Z}/n\mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/lattice+of+subgroups"} lattice of subgroups
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n\mathbb{Z}
              is the
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              of the lattice of natural numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \leq n
              ordered by inclusion.
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#Roman12"} Roman 12, theorem 13.4
            = succeed ")" do
              %a{:href => "#Navarro03"} Navarro 03
          %p
            This is a special case of the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/structure+theorem+for+finitely+generated+modules+over+a+principal+ideal+domain"} structure theorem for finitely generated modules over a principal ideal domain
          %h2#examples Examples
          %p The following examples may be useful for illustrative or instructional purposes.
          #TwoFiniteGroupsOfOrderp2.num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              of
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p^2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbb{Z}/p\mathbb{Z}) \oplus (\mathbb{Z}/p\mathbb{Z})
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mn 2
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}/p^2 \mathbb{Z}
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} p = 2
              the first is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Klein+4-group"} Klein 4-group
          .num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p_2
              two distinct
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+numbers"} prime numbers
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                      %mo ≠
                      %msub
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_1 \neq p_2
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              of order
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                      %msub
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_1 p_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi p
                      %mn 1
                    %mi ℤ
                    %mo ⊕
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi p
                      %mn 2
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}/p_1 \mathbb{Z}
                    \\oplus
                    \\mathbb{Z}/p_2 \mathbb{Z}
                    \\,.
            %p
              This is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi p
                      %mn 1
                    %msub
                      %mi p
                      %mn 2
                    %mi ℤ
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi p
                      %mn 1
                    %mi ℤ
                    %mo ⊕
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi p
                      %mn 2
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}/p_1 p_2 \mathbb{Z}
                    \\simeq
                    \\mathbb{Z}/p_1 \mathbb{Z}
                    \\oplus
                    \\mathbb{Z}/p_2 \mathbb{Z}
                    \\,.
            %p
              The isomorphism is given by sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mn 2
                      %mo ,
                      %msub
                        %mi p
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p_2,p_1)
          .num_example
            %h6#example_3 Example
            %p
              Moving up, for two distinct prime numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi p
                        %mn 1
                        %mn 2
                      %msub
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_1^2 p_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi p
                      %mn 1
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi p
                      %mn 1
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi p
                      %mn 2
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{Z}/p_1 \mathbb{Z})\oplus (\mathbb{Z}/p_1 \mathbb{Z}) \oplus (\mathbb{Z}/p_2 \mathbb{Z})
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msubsup
                        %mi p
                        %mn 1
                        %mn 2
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                      %mo ⊕
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi p
                        %mn 2
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{Z}/p_1^2 \mathbb{Z})\oplus (\mathbb{Z}/p_2 \mathbb{Z})
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              of order
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi p
                        %mn 1
                        %mn 2
                      %msub
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_1^2 p_2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 12
                      %mi ℤ
                      %mo ≅
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 4
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                      %mo ⊕
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 3
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/12\mathbb{Z} \cong (\mathbb{Z}/4 \mathbb{Z})\oplus (\mathbb{Z}/3 \mathbb{Z})
          .num_example
            %h6#example_4 Example
            %p
              Similarly, there are four abelian groups of order
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi p
                        %mn 1
                        %mn 2
                      %msubsup
                        %mi p
                        %mn 2
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_1^2 p_2^2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi p
                        %mn 1
                        %mn 3
                      %msub
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_1^3 p_2
            %p
              More generally, theorem
              %a.maruku-ref{:href => "#FundamentalTheoremOfFinitelyGeneratedAbelianGroups"}
              may be used to compute exactly how many abelian groups there are of any finite
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              (up to
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+factorization"} prime factorization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mi k
                  %annotation{:encoding => "application/x-tex"} p^k
              appearing therein, consider how many ways it can be written as a product of positive powers of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/partition"} partition
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              yields an abelian group of order
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mi k
                    %annotation{:encoding => "application/x-tex"} p^k
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              are then multiplied.
            %p
              Of all these abelian groups of order
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              of order
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} k= [k]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mi k
                  %annotation{:encoding => "application/x-tex"} p^k
              for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
          %h2#GraphicalRepresentation Graphical representation
          #PrimaryDecompositionGraphicalRepresentation.num_remark
            %h6#remark Remark
            %p
              Theorem
              %a.maruku-ref{:href => "#FundamentalTheoremOfFinitelyGeneratedAbelianGroups"}
              says that for any
              %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/p-primary+group"} p-primary part
              of any finitely generated abelian group is determined uniquely up to
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              by
            %ul
              %li
                %p
                  a total number
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
                  of powers of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/partition"} partition
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo =
                          %msub
                            %mi k
                            %mn 1
                          %mo +
                          %msub
                            %mi k
                            %mn 2
                          %mo +
                          %mi ⋯
                          %mo +
                          %msub
                            %mi k
                            %mi q
                        %annotation{:encoding => "application/x-tex"} k = k_1 + k_2 + \cdots + k_q
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/p-primary+group"} p-primary group
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi q
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mrow
                        %msub
                          %mi k
                          %mi i
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underoverset{i = 1}{q}{\bigoplus} \mathbb{Z}/p^{k_i} \mathbb{Z}
                    \\,.
            %p
              In the context of
              %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequences"} Adams spectral sequences
              it is conventional to depict this information graphically by
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  dots;
              %li
                %p
                  of which sequences of length
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi k
                          %mi i
                      %annotation{:encoding => "application/x-tex"} k_i
                  are connected by vertical lines, for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo ∈
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} i \in \{1, \cdots, q\}
            %p
              For example the graphical representation of the
              = succeed "-primary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                    %mo ⊕
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                    %mo ⊕
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mn 3
                    %mi ℤ
                    %mo ⊕
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mn 4
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}/p\mathbb{Z}
                    \\oplus
                    \\mathbb{Z}/p\mathbb{Z}
                    \\oplus
                    \\mathbb{Z}/p^3 \mathbb{Z}
                    \\oplus
                    \\mathbb{Z}/p^4\mathbb{Z}
            %p is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo •
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} |
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo •
                          %mtd
                            %mo •
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mo{:stretchy => "false"} |
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo •
                          %mtd
                            %mo •
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mo{:stretchy => "false"} |
                        %mtr
                          %mtd
                            %mo •
                          %mtd
                            %mo •
                          %mtd
                            %mo •
                          %mtd
                            %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;&amp; \bullet
                    \\\
                    \&amp;&amp; &amp; \vert
                    \\\
                    \&amp;&amp; \bullet &amp; \bullet
                    \\\
                    \&amp;&amp; \vert &amp; \vert
                    \\\
                    \&amp;&amp; \bullet &amp; \bullet
                    \\\
                    \&amp;&amp; \vert &amp; \vert
                    \\\
                    \\bullet &amp; \bullet &amp; \bullet &amp; \bullet
                    }
                    \\,.
            %p
              This notation comes from the convention of drawing stable pages of
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+spectral+sequence"} multiplicative
              %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequences"} Adams spectral sequences
              and reading them as encoding the
              %a{:href => "spectral+sequence#ExtensionProblem"} extension problem
              for computing the homotopy groups that the spectral sequence converges to:
            %ul
              %li
                %p
                  a dot at the top of a vertical sequence of dots denotes the group
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mi p
                          %mi ℤ
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p\mathbb{Z}
              %li
                %p
                  inductively, a dot vetically below a sequence of dots denotes a
                  %a.existingWikiWord{:href => "/nlab/show/group+extension"} group extension
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi p
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p\mathbb{Z}
                  by the group represented by the sequence of dots above;
              %li
                %p
                  a vertical line between two dots means that the the generator of the group corresponding to the upper dot is, regarded after inclusion into the group extension, the product by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  of the generator of the group corresponding to the lower dot, regarded as represented by the generator of the group extension.
            %p So for instance
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo •
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} |
                        %mtr
                          %mtd
                            %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\bullet
                    \\\
                    \\vert
                    \\\
                    \\bullet
                    }
            %p
              stands for an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              which forms a
              %a.existingWikiWord{:href => "/nlab/show/group+extension"} group extension
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mi p
                            %mi ℤ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mi p
                            %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{Z}/p\mathbb{Z}
                    \\\
                    \\downarrow
                    \\\
                    A
                    \\\
                    \\downarrow
                    \\\
                    \\mathbb{Z}/p\mathbb{Z}
                    }
            %p
              such that multiplication by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              takes the generator of the bottom copy of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p\mathbb{Z}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p\mathbb{Z}
            %p
              This means that of the two possible choices of extensions (by example
              = succeed ")" do
                %a.maruku-ref{:href => "#TwoFiniteGroupsOfOrderp2"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              corresponds to the non-trivial extension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi p
                        %mn 2
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} A = \mathbb{Z}/p^2\mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mi p
                            %mi ℤ
                          %mtd
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi p
                              %mn 2
                            %mi ℤ
                          %mtd
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mi p
                            %mi ℤ
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{Z}/p\mathbb{Z} &amp;
                    \\\
                    \\downarrow
                    \\\
                    \\mathbb{Z}/p^2 \mathbb{Z} &amp;
                    \\\
                    \\downarrow
                    \\\
                    \\mathbb{Z}/p\mathbb{Z} &amp;
                    }
            %p
              the image of the generator 1 of the first group in the middle group is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo =
                      %mi p
                      %mo ⋅
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p = p \cdot 1
            %p Conversely, the notation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo •
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                            %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\bullet
                    \\\
                    \\\
                    \\bullet
                    }
            %p
              stands for an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              which forms a
              %a.existingWikiWord{:href => "/nlab/show/group+extension"} group extension
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mi p
                            %mi ℤ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mi p
                            %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{Z}/p\mathbb{Z}
                    \\\
                    \\downarrow
                    \\\
                    A
                    \\\
                    \\downarrow
                    \\\
                    \\mathbb{Z}/p\mathbb{Z}
                    }
            %p
              such that multiplication by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              of the generator of the top group in the middle group does
              %em not
              yield the generator of the bottom group.
            %p
              This means that of the two possible choices (by example
              = succeed ")" do
                %a.maruku-ref{:href => "#TwoFiniteGroupsOfOrderp2"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              corresponds to the
              %em trivial
              extension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mi ℤ
                      %mo ⊕
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} A = \mathbb{Z}/p\mathbb{Z} \oplus \mathbb{Z}/p\mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mi p
                            %mi ℤ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mi p
                            %mi ℤ
                            %mo ⊕
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mi p
                            %mi ℤ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mi p
                            %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{Z}/p\mathbb{Z}
                    \\\
                    \\downarrow
                    \\\
                    \\mathbb{Z}/p\mathbb{Z}
                    \\oplus
                    \\mathbb{Z}/p\mathbb{Z}
                    \\\
                    \\downarrow
                    \\\
                    \\mathbb{Z}/p\mathbb{Z}
                    }
            %p
              the generator 1 of the top group maps to the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,0)
              in the middle group, and multiplication of that by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,0)
              instead of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (0,1)
            %p Similarly
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo •
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} |
                        %mtr
                          %mtd
                            %mo •
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} |
                        %mtr
                          %mtd
                            %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\bullet
                    \\\
                    \\vert
                    \\\
                    \\bullet
                    \\\
                    \\vert
                    \\\
                    \\bullet
                    }
            %p
              is to be read as the result of appending to the previous case a dot
              = succeed "," do
                %em below
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi p
                              %mn 2
                            %mi ℤ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mi p
                            %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{Z}/p^2 \mathbb{Z}
                    \\\
                    \\downarrow
                    \\\
                    A
                    \\\
                    \\downarrow
                    \\\
                    \\mathbb{Z}/p \mathbb{Z}
                    }
            %p
              such that
              = succeed "-times" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi p
                        %mn 3
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} A = \mathbb{Z}/p^3 \mathbb{Z}
            %p And so on.
            %p
              For example the stable page of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}_2
              %a.existingWikiWord{:href => "/nlab/show/classical+Adams+spectral+sequence"} classical Adams spectral sequence
              for computation of the
              %a.existingWikiWord{:href => "/nlab/show/p-primary+group"} 2-primary part
              of the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mi t
                        %mo −
                        %mi s
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_{t-s}(\mathbb{S})
              has in (“internal”) degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo −
                    %mi s
                    %mo ≤
                    %mn 13
                  %annotation{:encoding => "application/x-tex"} t-s \leq 13
              the following non-trivial entries:
            %p
              %img{:src => "http://ncatlab.org/nlab/files/ClassicalAdamsSpectralSequence.jpg", :width => "600"}/
            %p
              (graphics taken from (
              %a.existingWikiWord{:href => "/nlab/show/Symmetric+spectra"}> Schwede 12
              )))
            %p
              Ignoring here the diagonal lines (which denote multiplication by the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} h_1
              that encodes the additional
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(\mathbb{S})
              which here we are not concerned with) and applying the above prescription, we read off for instance that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 8
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \pi_3(\mathbb{S}) \simeq \mathbb{Z}/8\mathbb{Z}
              (because all three dots are connected) while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 8
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi ℤ
                    %mo ⊕
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \pi_8(\mathbb{S}) \simeq \mathbb{Z}/2\mathbb{Z}\oplus \mathbb{Z}/2\mathbb{Z}
              (because here the two dots are not connected). In total
            %table
              %thead
                %tr
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo =
                        %annotation{:encoding => "application/x-tex"} k =
                  %th 0
                  %th 1
                  %th 2
                  %th 3
                  %th 4
                  %th 5
                  %th 6
                  %th 7
                  %th 8
                  %th 9
                  %th 10
                  %th 11
                  %th 12
                  %th 13
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mi k
                          %mo{:stretchy => "false"} (
                          %mi 𝕊
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo{:stretchy => "false"} )
                          %mo =
                        %annotation{:encoding => "application/x-tex"} \pi_k(\mathbb{S})_{(2)} =
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ℤ
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}_{(2)}
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 8
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/8
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} 0
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} 0
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
