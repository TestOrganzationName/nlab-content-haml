                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_g \colon \tilde g \mapsto
                    \\left\{
                    \\array{
                    1 &amp; | g = \tilde g
                    \\\
                    0 &amp; | otherwise
                    }
                    \\right.
                    \\,.
            %p
              In terms of this the product in the group algebra is called the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/convolution+product"} convolution product
              on functions.
          .num_remark
            %h6#remark_3 Remark
            %p
              The notion of group algebra is a special case of that of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groupoid+algebra"} groupoid algebra
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+algebra"} category algebra
          %h3#for_profinite_groups For profinite groups
          %p
            The completed group ring of a
            %a.existingWikiWord{:href => "/nlab/show/profinite+group"} profinite group
            is a pseudocompact ring. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℤ
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat{\mathbb{Z}}
            be the
            %a.existingWikiWord{:href => "/nlab/show/profinite+completion"} profinite completion
            of the ring of integers,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℤ
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat{\mathbb{Z}}
            is itself a
            %a.existingWikiWord{:href => "/nlab/show/pseudocompact+ring"} pseudocompact ring
            as it is the inverse limit of its
            %em finite
            quotients. Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a profinite group.
          %p
            The
            = succeed "," do
              %em completed group algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ℤ
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} [
                    %mspace{:width => "negativethinmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "negativethinmathspace"}
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat{\mathbb{Z}}[\![G]\!]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℤ
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat{\mathbb{Z}}
            is the inverse limit of the ordinary group algebras,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ℤ
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat{\mathbb{Z}}[G/U]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi U
                %annotation{:encoding => "application/x-tex"} G/U
            (for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            in the directed set,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega(G)
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ℤ
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat{\mathbb{Z}}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℤ
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} [
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %msub
                    %mi lim
                    %mrow
                      %mi U
                      %mo ∈
                      %mi Ω
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                  %mover
                    %mi ℤ
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi U
                  %mo{:stretchy => "false"} ]
                  %mo .
                %annotation{:encoding => "application/x-tex"} \hat{\mathbb{Z}}[\![G]\!] = lim_{U\in \Omega(G)} \hat{\mathbb{Z}}[G/U].
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            a pseudocompact ring, it is then easy to construct the corresponding pseudo-compact group algebra of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            over
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %h3#ForTopologicalGroups For topological groups
          %p
            Discussion of group algebras in the generality of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+groups"} locally compact topological groups
          %p
            e.g.
            %a{:href => "#Dixmier77"} Dixmier (1977) §13.2
          %h2#properties Properties
          %h3#general General
          .num_prop
            %h6#proposition Proposition
            %p
              A group algebra is in particular a
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
              and a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded algebra
          %p
            The following states a
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the construction of the group algebra.
          .num_remark
            %h6#remark_4 Remark
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo ⊣
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ×
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Alg
                      %mi R
                    %munderover
                      %mrow
                      %munder
                        %mo ⟶
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo ×
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                      %mover
                        %mo ←
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mi R
                          %mo{:stretchy => "false"} [
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} ]
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"}
                    (R[-]\dashv (-)^\times)
                    \\;\colon\;
                    Alg_R
                    \\underoverset
                    {
                    \\underset{
                    \\;\;\;
                    (-)^\times
                    \\;\;\;
                    }{
                    \\longrightarrow
                    }
                    }
                    {
                    \\overset{
                    \\;\;\;
                    R[-]
                    \\;\;\;
                    }{
                    \\leftarrow
                    }
                    }
                    {}
                    Grp
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/Algebras"} Algebras
              (
              %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
              over
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Groups"} Groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[-]
              forms
              %a.existingWikiWord{:href => "/nlab/show/group+rings"} group rings
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} (-)^\times
              assigns to an
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
          .num_remark
            %h6#remark_5 Remark
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of rings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R[G] \to End(V)
              of the group ring to the
              %a.existingWikiWord{:href => "/nlab/show/endomorphism+ring"} endomorphism ring
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is equivalently a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi G
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} R[G]
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              Any
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo →
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p \colon G \to Aut(V)
              to the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              extends to to a morphism of rings.
            %p
              This observation is used extensively in the theory of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+representation"} group representations
              = succeed "." do
                %em
                  %a{:href => "http://ncatlab.org/nlab/show/module#AbelianGroupsWithGAction"} module – Abelian groups with G-action as modules over a ring
          %p
          #ComplexGroupAlgebraOfFiniteGroupAsDirectSumOfEndomorphismAlgebras.num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              with
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of
              %a.existingWikiWord{:href => "/nlab/show/irreducible+representations"} irreducible representations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi V
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi Irreps
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ∼
                  %annotation{:encoding => "application/x-tex"} [V] \in Irreps_{\mathbb{C}}(G)_{/\sim}
              over the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of the linear
              %a.existingWikiWord{:href => "/nlab/show/endomorphism+algebras"} endomorphism algebras
              of the
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+spaces"} complex vector spaces
              underlying the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/irreps"} irreps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊕
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi V
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msub
                          %mi Irreps
                          %mi ℂ
                        %mo{:stretchy => "false"} (
                        %mi G
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mo ∼
                    %msub
                      %mi End
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C}[G]
                    \\;\simeq\;
                    \\underset{
                    [V] \in Irreps_{\mathbb{C}}(G)_{/\sim}
                    }{ \oplus }
                    End_{\mathbb{C}}(V)
            %p
          (e.g.
          = succeed ")" do
            %a{:href => "#FultonHarris91"} Fulton-Harris 91, Prop. 3.29
          .proof
            %h6 Proof
            %p
              For every representation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/group+action"} group action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mover
                      %mo ⟶
                      %mrow
                    %msub
                      %mi Aut
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi End
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    G
                    \\overset{}{\longrightarrow}
                    Aut_{\mathbb{C}}(V)
                    \\hookrightarrow
                    End_{\mathbb{C}}(V)
            %p
              %a.existingWikiWord{:href => "/nlab/show/extension"} extends
              uniquely to an
              %a.existingWikiWord{:href => "/nlab/show/algebra+homomorphism"} algebra homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi ϕ
                          %mi V
                    %msub
                      %mi End
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C}[G]
                    \\overset{ \phi_V }{\longrightarrow}
                    End_{\mathbb{C}}(V)
                    \\,.
            %p
              Observe that this is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is irreducible.
            %p
              We claim that the resulting homomorphism to the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ϕ
                          %mi V
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi V
                            %mo{:stretchy => "false"} ]
                    %munder
                      %mo ⊕
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi V
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msub
                          %mi Irreps
                          %mi ℂ
                        %mo{:stretchy => "false"} (
                        %mi G
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mo ∼
                    %msub
                      %mi End
                      %mi ℂ
