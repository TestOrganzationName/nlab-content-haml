          .num_theorem
            %h6#theorem Theorem
            %p
              (
              %a.existingWikiWord{:href => "/nlab/show/Maschke%27s+theorem"}> Maschke's theorem
              )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi k
                  %annotation{:encoding => "application/x-tex"} R = k
              be a field.
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[G]
              is a
              %a.existingWikiWord{:href => "/nlab/show/semi-simple+algebra"} semi-simple algebra
              precisely if the
              %a.existingWikiWord{:href => "/nlab/show/order"} order
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is not divisible by the
              %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          %p
            The following is proven in
            = succeed "," do
              %a{:href => "#Gilmer92"} Gilmer 1992
          %p
          .num_theorem
            %h6 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
