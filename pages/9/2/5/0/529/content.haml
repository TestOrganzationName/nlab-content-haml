                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{rcl}
                    U(g, 0) \cdot U(g', 0)
                    \&amp;=&amp;
                    U\big(g g', \omega(g,g')\big)
                    \\\
                    \&amp;=&amp;
                    U\big(\mathrm{e}, \omega(g,g')\big)
                    \\cdot
                    U(g g', 0)
                    \\,.
                    \\end{array}
            %p
              This looks, up to the
              %a.existingWikiWord{:href => "/nlab/show/center"} central
              correction factor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi{:mathvariant => "normal"} e
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ,
                      %mi g
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} U\big(\mathrm{e}, \omega(g,g')\big)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %p
              To bring out this relation, consider now the
              %a.existingWikiWord{:href => "/nlab/show/quotient+algebra"} quotient algebra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi G
                      %mi ω
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}\big(G^\omega\big)
              by the canonical
              %a.existingWikiWord{:href => "/nlab/show/augmentation+ideal"} augmentation ideal
              of the group algebra of the extension group, ie. by the two-sided
              %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi G
                      %mi ω
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}\big(G^\omega\big)
              generated by the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
              %a.existingWikiWord{:href => "/nlab/show/algebra+homomorphism"} algebra homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi ℂ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi ℝ
                          %mo{:stretchy => "false"} /
                          %mi ℤ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mi ϵ
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                        %mtd
                          %mi ℂ
                      %mtr
                        %mtd
                          %mi U
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi{:mathvariant => "normal"} e
                          %mo ,
                          %mi r
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mo ↦
                        %mtd
                          %msup
                            %mi e
                            %mrow
                              %mn 2
                              %mi π
                              %mi{:mathvariant => "normal"} i
                              %mi r
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    \\mathbb{C}\big(\mathbb{R}/\mathbb{Z}\big)
                    \&amp;\xrightarrow{\;\; \epsilon \;\;}&amp;
                    \\mathbb{C}
                    \\\
                    U\big(
                    \\mathrm{e},
                    r
                    \\big)
                    \&amp;\mapsto&amp;
                    e^{2 \pi \mathrm{i} r }
                    \\mathrlap{\,.}
                    \\end{array}
            %p
              In other words, in this quotient of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi G
                      %mi ω
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}\big(G^\omega\big)
              we enforce the
              %a.existingWikiWord{:href => "/nlab/show/relations"} relations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "right center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi{:mathvariant => "normal"} e
                          %mo ,
                          %mi r
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ∼
                        %mtd
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mi π
                          %mi{:mathvariant => "normal"} i
                          %mi r
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi{:mathvariant => "normal"} e
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mi π
                          %mi{:mathvariant => "normal"} i
                          %mi r
                          %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{rcl}
                    U(\mathrm{e}, r)
                    \&amp;\sim&amp;
                    exp(2 \pi \mathrm{i} r )
                    \\,
                    U(\mathrm{e}, 0)
                    \\\
                    \&amp;=&amp;
                    exp(2 \pi \mathrm{i} r )
                    \\end{array}
            %p
              (using in the last step that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} e
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathrm{e}, 0)
              is the
              %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi G
                        %mi ω
                    %annotation{:encoding => "application/x-tex"} G^\omega
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} e
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(\mathrm{e}, 0)
              is the
              %a.existingWikiWord{:href => "/nlab/show/unit+element"} unit element
              in its group algebra).
            %p
              Therefore the
              %a.existingWikiWord{:href => "/nlab/show/quotient+algebra"} quotient algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi G
                      %mi ω
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} /
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}\big(G^\omega\big)\big/ ker(\epsilon)
              is that generated by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi U
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi G
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} U(G) \,=\, U\big(G \times \{0\}\big)
              subject to the relations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mn 2
                        %mi π
                        %mi{:mathvariant => "normal"} i
                        %mi ω
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo ,
                        %mi g
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ⋅
                    %mi g
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U(g) \cdot U(g')
                    \\;=\;
                    e^{ 2 \pi \mathrm{i} \omega(g,g') }
                    \\,
                    U(g\cdot g')
                    \\,.
            %p
              This is the
              = succeed "-twisted" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mi ω
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^\omega(G)
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi G
                      %mi ω
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} /
                    %mi{:mathvariant => "normal"} ker
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℂ
                      %mi ω
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C}\big(
                    G^\omega
                    \\big)
                    \\big/
                    \\mathrm{ker}(\epsilon)
                    \\;\;
                    \\simeq
                    \\;\;
                    \\mathbb{C}^\omega(G)
                    \\,.
            %p
          %p
            With due care, this situation generalizes from
            %a.existingWikiWord{:href => "/nlab/show/discrete+groups"} discrete groups
            to suitable (eg.
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+groups"} locally compact
            %a.existingWikiWord{:href => "/nlab/show/topological+groups"} topological groups
            (
            %a{:href => "#EdwardsLewis69a"}> Edwards &amp; Lewis 1969a
            ,
            = succeed ")." do
              %a{:href => "#EdwardsLewis69b"} 1969b
          %p
          .num_remark
            %h6 Example
            %p
              %strong
                (
                %a{:href => "#BinzHoneggerRieckers07"}> Binz, Honegger &amp; Rieckers 2007
                )
              %br/
              It is in this way that the group algebra of a (
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete
              %a.existingWikiWord{:href => "/nlab/show/Heisenberg+group"} Heisenberg group
              (which is a
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
              of an
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %a.existingWikiWord{:href => "/nlab/show/Weyl+group"} Weyl group
              (whose
              %a.existingWikiWord{:href => "/nlab/show/Weyl+relations"} Weyl relations
              are those of a twisted additive group algebra).
          %h3#RelationToUniversalEnvelopingAlgebra Relation to universal enveloping algebras
          %p
            Concerning group algebras of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+groups"} algebraic groups
          %blockquote
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/universal+enveloping+algebra"} universal enveloping algebra
              of a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              is the analogue of the usual
              %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
              of a group. It has the analogous function of exhibiting the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+modules"} Lie algebra modules
              as a category of
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
              for an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
              structure. By dualization, one obtains a commutative Hopf algebra which, in the case where the Lie algebra is that of an irreducible
              %a.existingWikiWord{:href => "/nlab/show/algebraic+group"} algebraic group
              over a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/characteristic+0"} characteristic 0
          %p
            (quoted from
            = succeed "," do
              %a{:href => "universal+enveloping+algebra#Hochschild81"} Hochschild 1981, p. 221
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cohn+localization"} Cohn localization
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/groupoid+algebra"}> groupoid algebra
                ,
                %a.existingWikiWord{:href => "/nlab/show/category+algebra"} category algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/augmentation+ideal"} augmentation ideal
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/pseudocompact+ring"} pseudocompact ring
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+%E2%88%9E-ring"} ∞-group ∞-ring
          %h2#references References
          %h3#general_2 General
          %p Original discussion:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hermann+Weyl"}> Hermann Weyl
              , §III.13 in:
              = succeed "," do
                %em Gruppentheorie und Quantenmechanik
              = succeed "," do
                %em The Theory of Groups and Quantum Mechanics
              = succeed "," do
                %a{:href => "https://store.doverpublications.com/0486602699.html"} ISBN:0486602699
              = succeed "&rbrack;" do
                %a{:href => "https://archive.org/details/ost-chemistry-quantumtheoryofa029235mbp/page/n15/mode/2up"} ark:/13960/t1kh1w36w
          %p Exposition:
          %ul
            %li
              D. S. Passman:
              = succeed "," do
                %em What is a Group Ring?
              %strong 83
              3 (1976) &amp;lbrack;
              %a{:href => "https://doi.org/10.1080/00029890.1976.11994069"}> doi:10.1080/00029890.1976.11994069
              \&amp;rbrack;
          %p Monographs:
          %p
            for the case of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+groups"} locally compact topological groups
          %ul
            %li#Dixmier77
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacques+Dixmier"}> Jacques Dixmier
                , §13.2 in:
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^\ast
                    \-algebras
            %li#Landsman17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Klaas+Landsman"}> Klaas Landsman
                , §C.18 in:
                = succeed "," do
                  %em Foundations of quantum theory – From classical concepts to Operator algebras
                = succeed "," do
                  %a{:href => "https://link.springer.com/book/10.1007/978-3-319-51777-3"} doi:10.1007/978-3-319-51777-3
                = succeed "&rbrack;" do
                  %a{:href => "https://link.springer.com/content/pdf/10.1007%2F978-3-319-51777-3.pdf"} pdf
          %p
            for the case of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/finite+groups"} finite groups
          %ul
            %li#FultonHarris91
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Fulton"}> William Fulton
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Joe+Harris"} Joe Harris
                = succeed "," do
                  %em Representation Theory: a First Course
                = succeed "&rbrack;" do
                  %a{:href => "https://link.springer.com/book/10.1007/978-1-4612-0979-9"} doi:10.1007/978-1-4612-0979-9
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/A.+P.+Balachandran"}> A. P. Balachandran
                , S. G. Jo,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Giuseppe+Marmo"} Giuseppe Marmo
                = succeed "," do
                  %em Group Theory and Hopf Algebras – Lectures for Physicists
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1142/7872"} doi:10.1142/7872
          %p Lecture notes:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kiyoshi+Igusa"}> Kiyoshi Igusa
                ,
                = succeed "," do
                  %em Algebra II, part D: representations of groups
                = succeed ")" do
                  %a{:href => "http://people.brandeis.edu/~igusa/Math101bS07/Math101b_notesD1a.pdf"} pdf
            %li
              %p
                Andrei Yafaev,
                %em Group algebras
                (
                %a{:href => "http://www.ucl.ac.uk/~ucahaya/GroupAlgebras.pdf"}> pdf
                )
          %p
            On twisted group algebras and their relation to plain group algebras of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/group+extensions"} group extensions
          %ul
            %li
              %p
                C. M. Edwards,
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^\ast
                    \-algebras of central group extensions I
                %strong 10
                3 (1969) 229-246 &amp;lbrack;
                %a{:href => "http://www.numdam.org/item/?id=AIHPA_1969__10_3_229_0"}> numdam:AIHPA_1969__10_3_229_0
                \&amp;rbrack;
            %li#EdwardsLewis69a
              %p
                C. M. Edwards,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+T.+Lewis"} John T. Lewis
                = succeed "," do
                  %em Twisted group algebras I
                %strong 13
                (1969) 119–130 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF01649871"}> doi:10.1007/BF01649871
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://projecteuclid.org/journals/communications-in-mathematical-physics/volume-13/issue-2/Twisted-group-algebras-I/cmp/1103841535.full"} euclid:cmp/1103841535
            %li#EdwardsLewis69b
              %p
                C. M. Edwards,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+T.+Lewis"} John T. Lewis
                = succeed "," do
                  %em Twisted group algebras II
                %strong 13
                (1969) 131–141 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF01649872"}> doi:10.1007/BF01649872
                \&amp;rbrack;
            %li#Nachbin93
              %p
                Leopoldo Nachbin (ed.),
                = succeed "," do
                  %em Twisted Group Algebras
                = succeed "," do
                  %em Group Representations Volume 2
                %strong 177
                (1993) 65-103 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/S0304-0208(09)70147-1"}> doi:10.1016/S0304-0208(09)70147-1
                \&amp;rbrack;
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/universal+localization"} universal localization
            of group rings (see also at
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Snaith%27s+theorem"} Snaith's theorem
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/M.+Farber"}> M. Farber
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pierre+Vogel"} Pierre Vogel
                = succeed "," do
                  %em The Cohn localization of the free group ring
                = succeed ")" do
                  %a{:href => "http://www.maths.ed.ac.uk/~aar/papers/fv.pdf"} pdf
            %li
              %p
                Davidson, Nicholas,
                %em Modules Over Localized Group Rings for Groups Mapping Onto Free Groups
                (2011). Boise State University Theses and Dissertations. Paper 170. (
                %a{:href => "http://scholarworks.boisestate.edu/td/170/"}> web
                )
          %p On the case of profinite groups:
          %ul
            %li
              A. Brumer,
              = succeed "," do
                %em Pseudocompact algebras, profinite groups and class formations
              %strong 4
              (1966) 442-470,
              = succeed "," do
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=202790"} MR202790
              %a{:href => "http://dx.doi.org/10.1016/0021-8693(66)90034-2"} doi
              %a{:href => "http://deepblue.lib.umich.edu/bitstream/handle/2027.42/33410/0000811.pdf?sequence=1"} pdf
          %h3#in_physics In physics
          %p
            On group algebras as
            %a.existingWikiWord{:href => "/nlab/show/strict+deformation+quantization"} strict
            %a.existingWikiWord{:href => "/nlab/show/deformation+quantizations"} deformation quantizations
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie-Poisson+manifolds"} Lie-Poisson manifolds
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+A.+Rieffel"}> Marc A. Rieffel
                ,
                = succeed "," do
                  %em Lie Group Convolution Algebras as Deformation Quantizations of Linear Poisson Structures
                %strong 112
                4 (1990) 657-685 &amp;lbrack;
                %a{:href => "https://doi.org/10.2307/2374874"}> doi:10.2307/2374874
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://www.jstor.org/stable/2374874"} jstor:2374874
            %li#Rieffel90
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+Rieffel"}> Marc Rieffel
                , Ex. 7, Ex. 8 in:
                = succeed "," do
                  %em Deformation quantization and operator algebras
                = succeed "," do
                  %strong 51
                = succeed "," do
                  %a{:href => "http://math.berkeley.edu/~rieffel/papers/deformation.pdf"} pdf
                %a.existingWikiWord{:href => "/nlab/files/Rieffel-DefQuantization.pdf", :title => "pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=1077400"} MR91h:46120
          %p
            Strengthening of the original result, including generalization to
            %a.existingWikiWord{:href => "/nlab/show/groupoid+algebras"} groupoid algebras
            of
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} integrating
            given
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nicolaas+P.+Landsman"}> Nicolaas P. Landsman
                , §3.4 in:
                %em Classical and quantum representation theory
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9411172"}> arXiv:hep-th/9411172
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nicolaas+P.+Landsman"}> Nicolaas P. Landsman
                , Ex. 2 in:
                = succeed "," do
                  %em
                    Lie Groupoid
                    = succeed "-Algebras" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi C
                              %mo *
                          %annotation{:encoding => "application/x-tex"} C^\ast
                %strong 206
                (1999) 367–381 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/s002200050709"}> doi:10.1007/s002200050709
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nicolaas+P.+Landsman"}> Nicolaas P. Landsman
                , B. Ramazan, Ex. 11.1 in:
                = succeed "," do
                  %em Quantization of Poisson algebras associated to Lie algebroids
                = succeed "," do
                  %em Groupoids in Analysis, Geometry, and Physics
                %strong 282
                (2001) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math-ph/0001005"}> arXiv:math-ph/0001005
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://www.ams.org/books/conm/282"} ams:conm/282
          %p See also:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Klaas+Landsman"}> Klaas Landsman
                ,
                = succeed "," do
                  %em Strict deformation quantization of a particle in external gravitational and Yang-Mills fields
                %strong 12
                2 (1993) 93-132 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0393-0440(93)90010-C"}> doi:10.1016/0393-0440(93)90010-C
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nicolaas+P.+Landsman"}> Nicolaas P. Landsman
                , p. 27 in:
                %em Classical and quantum representation theory
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9411172"}> arXiv:hep-th/9411172
                \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/group+algebras"} group algebras
            of (
            %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete
            %a.existingWikiWord{:href => "/nlab/show/Heisenberg+groups"} Heisenberg groups
            as
            %a.existingWikiWord{:href => "/nlab/show/strict+deformation+quantizations"} strict deformation quantizations
            of
            %a.existingWikiWord{:href => "/nlab/show/presymplectic+manifold"} pre-
            %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+spaces"} symplectic
            %a.existingWikiWord{:href => "/nlab/show/topological+vector+spaces"} topological vector spaces
            by
            %a.existingWikiWord{:href => "/nlab/show/continuous+field+of+C-star+algebras"} continuous fields of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Weyl+algebras"} Weyl algebras
          %ul
            %li#BinzHoneggerRieckers07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ernst+Binz"}> Ernst Binz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Reinhard+Honegger"} Reinhard Honegger
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alfred+Rieckers"} Alfred Rieckers
                = succeed "," do
                  %em Infinite dimensional Heisenberg group algebra and field-theoretic strict deformation quantization
                %strong 38
                1 (2007) &amp;lbrack;
                %a{:href => "https://ijpam.eu/contents/2007-38-1/6/index.html"}> ijpam:2007-38-1/6
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://www.ijpam.eu/contents/2007-38-1/6/6.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Reinhard+Honegger"}> Reinhard Honegger
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alfred+Rieckers"} Alfred Rieckers
                = succeed "," do
                  %em Heisenberg Group Algebra and Strict Weyl Quantization
                = succeed "," do
                  %em Photons in Fock Space and Beyond, Volume I: From Classical to Quantized Radiation Systems
                = succeed "," do
                  %a{:href => "https://doi.org/10.1142/9789814696586_0023"} doi;10.1142/9789814696586_0023
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1142/9251-vol1"} doi:10.1142/9251-vol1
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetric
            %a.existingWikiWord{:href => "/nlab/show/WZW+model"} WZW model
            using group algebra:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Matthias+Blau"}> Matthias Blau
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/George+Thompson"} George Thompson
              = succeed "," do
                %em
                  Equivariant Kähler Geometry and Localization in the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G/G
                  Model
              %strong 439
              (1995) 367-394 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0550-3213(95)00058-Z"}> doi:10.1016/0550-3213(95)00058-Z
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/hep-th/9407042"} arXiv:hep-th/9407042
          %p
            Group algebras play a role in the relation between
            %a.existingWikiWord{:href => "/nlab/show/ordered+abelian+groups"} ordered abelian groups
            and divisibility in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/integral+domains"} integral domains
          %ul
            %li#Gilmer92
              %a.existingWikiWord{:href => "/nlab/show/Robert+Gilmer"}> Robert Gilmer
              \:
              = succeed "," do
                %em Multiplicative Ideal Theory
          %p
            On the group algebra of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
          %ul
            %li
              Darij Grinberg.
              %em An introduction to the symmetric group algebra
              (2025). (
              %a{:href => "https://arxiv.org/abs/2507.20706"}> arXiv:2507.20706
              ).
