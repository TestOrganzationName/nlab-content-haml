          .num_defn
            %h6#definition_2 Definition
            %p
              The
              %strong
                group
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[G]
              is the
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
