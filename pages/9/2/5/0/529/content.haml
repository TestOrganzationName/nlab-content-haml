          .num_remark
            %h6#remark Remark
            %p
              By the discussion at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[G]
              is a
              %a.existingWikiWord{:href => "/nlab/show/formal+linear+combination"} formal linear combination
              of
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              elements in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                    %msub
                      %mi r
                      %mi g
                    %mo ⋅
                    %mi g
                  %annotation{:encoding => "application/x-tex"}
                    r = \sum_{g \in G} r_g \cdot g
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∀
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mi g
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \forall_{g \in G} (r_g \in R)
              and only finitely many of the coefficients different from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} 0 \in R
            %p The addition of algebra elements is given by the componentwise addition of coefficients
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo +
                    %mover
                      %mi r
                      %mo{:stretchy => "false"} ˜
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mi g
                    %mo +
                    %msub
                      %mover
                        %mi r
                        %mo{:stretchy => "false"} ˜
                      %mi g
                    %mo{:stretchy => "false"} )
                    %mi g
                  %annotation{:encoding => "application/x-tex"}
                    r + \tilde r =
                    \\sum_{g \in G} (r_g + \tilde r_g) g
            %p
              and the multiplication is given by the
              %a.existingWikiWord{:href => "/nlab/show/convolution+product"} convolution product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi r
                            %mover
                              %mi r
                              %mo{:stretchy => "false"} ˜
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi g
                                %mo ∈
                                %mi G
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mover
                                  %mi g
                                  %mo{:stretchy => "false"} ˜
                                %mo ∈
                                %mi G
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi r
                              %mi g
                            %msub
                              %mover
                                %mi r
                                %mo{:stretchy => "false"} ˜
                              %mover
                                %mi g
                                %mo{:stretchy => "false"} ˜
                            %mo{:stretchy => "false"} )
                            %mi g
                            %mo ⋅
                            %mover
                              %mi g
                              %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi q
                                %mo ∈
                                %mi G
                            %mrow
                              %mo (
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi k
                                  %mo ∈
                                  %mi G
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi r
                                %mrow
                                  %mi q
                                  %mo ⋅
                                  %msup
                                    %mi k
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                              %msub
                                %mi r
                                %mi k
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mi q
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    r \tilde r
                    \&amp; =
                    \\sum_{g \in G}
                    \\sum_{\tilde g \in G}
                    (r_g \tilde r_{\tilde g}) g \cdot \tilde g
                    \\\
                    \&amp; =
                    \\sum_{q \in G}
                    \\left(
                    \\sum_{k \in G}  (r_{q\cdot k^{-1}} r_k)
                    \\right) q
                    \\,.
                    \\end{aligned}
          .num_remark
            %h6#remark_2 Remark
            %p
              The
