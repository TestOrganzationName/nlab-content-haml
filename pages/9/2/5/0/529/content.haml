                  %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                  %a.existingWikiWord{:href => "/nlab/show/module"} module
                  is the the
                  %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
                  over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/underlying+set"} underlying set
