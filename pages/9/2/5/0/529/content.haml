            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is the
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            whose elements are
            %a.existingWikiWord{:href => "/nlab/show/formal+linear+combinations"} formal linear combinations
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            of the elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and whose multiplication is given on these
            %a.existingWikiWord{:href => "/nlab/show/basis"} basis
            elements by the group operation in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %h2#definition Definition
          %h3#ForDiscreteGroups For discrete groups
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
