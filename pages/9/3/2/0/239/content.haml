          %h2#references References
          %p
            Tensor products were introduced by
            %a.existingWikiWord{:href => "/nlab/show/Hassler+Whitney"} Hassler Whitney
            in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hassler+Whitney"}> Hassler Whitney
              ,
              = succeed "," do
                %em Tensor products of Abelian groups
              = succeed "." do
                %a{:href => "https://doi.org/10.1215/s0012-7094-38-00442-9"} doi
          %p Lecture notes:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Keith+Conrad"}> Keith Conrad
              ,
              %em Tensor products
              \&amp;lbrack;part I:
              %a{:href => "http://www.math.uconn.edu/~kconrad/blurbs/linmultialg/tensorprod.pdf"}> pdf
              ,
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/files/Conrad-TensorProductsI", :title => "pdf"} pdf
              = succeed "," do
                %a{:href => "https://kconrad.math.uconn.edu/blurbs/linmultialg/tensorprod2.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Conrad-TensorProductsII", :title => "pdf"} pdf
          %p For more on the
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product of vector spaces
          %p see there.
          %p
            For the
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theoretic
            formalization of tensor products see the references at
          %ul
            %li
              %em
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              and
              %em
                %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
          %p
            Formalization of tensor products in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/dependent+linear+type+theory"} dependent linear type theory
          %ul
            %li#Riley22Thesis
              %a.existingWikiWord{:href => "/nlab/show/Mitchell+Riley"}> Mitchell Riley
              ,
              = succeed "," do
                %em A Bunched Homotopy Type Theory for Synthetic Stable Homotopy Theory
              = succeed "," do
                %a{:href => "https://doi.org/10.14418/wes01.3.139"} doi:10.14418/wes01.3.139
              = succeed "," do
                %a{:href => "https://digitalcollections.wesleyan.edu/object/ir%3A3269"} ir:3269
              = succeed "&rbrack;" do
                %a{:href => "https://mvr.hosting.nyu.edu/pubs/thesis.pdf"} pdf
