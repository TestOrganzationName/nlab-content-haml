                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} d_{W(\mathfrak{g})}\mu
              into the shifted copy of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
              in the Weil algebra, thus exhibiting the modified
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              as an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
          #TheInvariantPolynomials.num_cor
