          %h2#FactorizationOfTheLInfintiyCocycle
            Factorization of the
            = succeed "-cocycle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          #FactorizationOfTheCocycle.num_prop
            %h6#proposition Proposition
            %p
              The
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo :
                    %mi 𝔰𝔬
                    %mo →
                    %msup
                      %mi b
                      %mn 2
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\mu : \mathfrak{so} \to b^2 \mathbb{R}
            %p factors as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔬
                    %mover
                      %mo →
                      %mrow
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                    %msup
                      %mi b
                      %mn 2
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{so} \stackrel{}{\to} (b \mathbb{R} \to \mathfrak{string})
                    \\stackrel{}{\to}
                    b^2 \mathbb{R}
            %p given dually on CE-algebras by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔰𝔬
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msup
                                  %mi t
                                  %mi a
                                %mo ↦
                                %msup
                                  %mi t
                                  %mi a
                            %mtr
                              %mtd
                                %mi b
                                %mo ↦
                                %mn 0
                            %mtr
                              %mtd
                                %mi c
                                %mo ↦
                                %mi μ
                        %mo )
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi c
                                %mo ↦
                                %mi c
                        %mo )
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mn 2
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{so})
                    \\stackrel{
                    \\left(
                    \\array{
                    t^a \mapsto t^a
                    \\\
                    b \mapsto 0
                    \\\
                    c \mapsto \mu
                    }
                    \\right)
                    }{\leftarrow}
                    CE(b \mathbb{R} \to \mathfrak{string})
                    \\stackrel{
                    \\left(
                    \\array{
                    c \mapsto c
                    }
                    \\right)
                    }{\leftarrow}
                    CE(b^2 \mathbb{R})
                    \\,.
            %p
              The left morphism is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
          .proof
            %h6#proof Proof
            %p
              To see that we have a quasi-isomorphism, notice that the dg-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(b \mathbb{R} \to \mathfrak{string})
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
              to the one with generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi t
                      %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t^a, b, c'\}
              and differentials
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi d
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msup
                                  %mi 𝔤
                                  %mo *
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mo{:stretchy => "false"} ]
                              %mo *
                        %mtr
                          %mtd
                            %mi d
                            %mi b
                          %mtd
                            %mo =
                            %mi c
                            %mo ′
                        %mtr
                          %mtd
                            %mi d
                            %mi c
                            %mo ′
                          %mtd
                            %mo =
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d|_{\mathfrak{g}^*} &amp; = [-,-]^*
                    \\\
                    d  b &amp; = c'
                    \\\
                    d c' &amp; =  0
                    \\end{aligned}
                    \\,,
            %p
              where the isomorphism is given by the identity on the
              = succeed "s" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi t
                        %mi a
                    %annotation{:encoding => "application/x-tex"} t^a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              and by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ↦
                    %mi c
                    %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi μ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    c \mapsto c' + \mu
                    \\,.
            %p
              The primed dg-algebra is the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi inn
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mi ℝ
