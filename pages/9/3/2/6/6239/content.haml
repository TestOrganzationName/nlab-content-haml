                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (b \mathbb{R} \to \mathfrak{string})
                %p
                  in
                  = succeed ";" do
                    %a{:href => "#ModifiedWeilAlgebra"} The modified Weil algebra
              %li
                %p construct the desired factorization by factoring itself through two fairly evident morphisms into and out of the modified Weil algebra,
                %p
                  in
                  = succeed "." do
                    %a{:href => "TheLInftyDifferentialLift"} The differential lift
          %h3#ModifiedWeilAlgebra The modified Weil algebra
          %p
            Our factorization
            %a{:href => ""} below
            makes use of an isomorphic copy of the Weil algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
