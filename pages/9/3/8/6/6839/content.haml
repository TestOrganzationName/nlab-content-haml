          %h2#pregroupoids_derived_from_a_groupoid Pregroupoids derived from a groupoid
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi G
                    %mn 0
                  %mo →
                  %msub
                    %mi G
                    %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} G:=\{G_0\to G_1\}
            a groupoid,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi B
                  %mo ⊂
                  %msub
                    %mi G
                    %mn 0
                %annotation{:encoding => "application/x-tex"} A,B\subset G_0
            subsets.
          %p
            Then the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G(A,B)
            defined to be the set of arrows in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 1
                %annotation{:encoding => "application/x-tex"} G_1
            whose source is in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and whose target is in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            equipped with the two evident structure maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo :
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} s:G(A,B)\to A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo :
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} t:G(A,B)\to B
          %p
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/heap"} pregroupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mi B
                %annotation{:encoding => "application/x-tex"} A=B
            this is a full subgroupoid of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %h2#pregroupoid_associated_to_a_principal_bundle Pregroupoid associated to a principal bundle
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi P
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} p:P\to A
            be a principal right
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo ←
                    %mi p
                  %mi P
                  %mover
                    %mo →
                    %mo !
                  %mo *
                %annotation{:encoding => "application/x-tex"} A\xleftarrow{p}P\xrightarrow{!} *
            is a pregroupoid.
          %h2#the_category_of_pregroupoids The category of pregroupoids
          %p
            There is a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi PGrpd
                %annotation{:encoding => "application/x-tex"} \mathbf{PGrpd}
            with pregroupoids as objects and triples
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 0
                  %mo ,
                  %mi c
                  %mo ,
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c_0,c,c_1)
            of morphisms making
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo ←
                            %mi a
                        %mtd
                          %msup
                            %mo
                            %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi b
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %msub
                            %mrow
                            %mrow
                              %msub
                                %mi c
                                %mn 0
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mi c
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mrow
                              %msub
                                %mi c
                                %mn 1
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msup
                            %mi A
                            %mstyle{:scriptlevel => "0"}
                              %mo ′
                        %mtd
                          %mover
                            %mo ←
                            %mrow
                              %msup
                                %mi a
                                %mstyle{:scriptlevel => "0"}
