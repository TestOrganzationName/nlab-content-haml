                            %mi B
                            %mstyle{:scriptlevel => "0"}
                              %mo ′
                %annotation{:encoding => "application/x-tex"} \array{A&amp;\xleftarrow{a}&amp;^X&amp;\xrightarrow{b}&amp;B\\ {}_{c_0}\downarrow&amp;&amp;{}_c\downarrow&amp;&amp;{}_{c_1}\downarrow\\A^\prime&amp;\xleftarrow{a^\prime}&amp;X^\prime&amp;\xrightarrow{b^\prime}&amp;B^\prime}
          %p commute.
          %p There is a forgetful functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo :
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %mi Grpd
                            %mo →
                            %mi PGrpd
                        %mtr
                          %mtd
                            %mi G
                            %mo →
                            %mi G
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi G
                              %mn 0
                            %mo ,
                            %msub
                              %mi G
                              %mn 0
                            %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V:\begin{cases}Grpd\to PGrpd\\G\to G(G_0,G_0)\end{cases}
          %h2#groupoids_associated_to_a_pregroupoid Groupoids associated to a pregroupoid
          %p
            There are three candidates of a groupoid associated to a pregroupoid:
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi PP
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} PP^{-1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi P
                %annotation{:encoding => "application/x-tex"} P^{-1}P
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E(P)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi PP
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} PP^{-1}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi P
                %annotation{:encoding => "application/x-tex"} P^{-1}P
            are called edges of the pregroupoid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(P)
            is called enveloping groupoid for the pregroupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(P)
            contains the edges of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            as subgroupoids.
          %h3#the_ehresmann_groupoid_
            The Ehresmann groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi PP
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} PP^{-1}
          %p
            For a pregroupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo ←
                    %mi α
                  %mi P
                  %mover
                    %mo →
                    %mi β
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\xleftarrow{\alpha} P\xrightarrow{\beta} B
            the
            %strong Ehresmann groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi PP
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} PP^{-1}
            is defined by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi PP
                    %mn 0
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo :
                  %mo =
                  %mi A
                %annotation{:encoding => "application/x-tex"} PP^{-1}_0:=A
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi PP
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %msup
                    %mi a
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msup
                    %mi xy
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi a
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi a
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} /
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} PP^{-1}(a,a^\prime):=xy^{-1}:=\{(x,y)|\alpha(x)=a,\,\alpha(y)=a^\prime\}/\sim
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∼
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x,y)\sim(u,z)
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo =
                  %msup
                    %mi xy
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi z
                %annotation{:encoding => "application/x-tex"} u=xy^{-1}z
          %h3#the_inverse_ehresmann_groupoid_
            The ‘’inverse Ehresmann’‘ groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi PP
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} PP^{-1}
          %p
            For a pregroupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo ←
                    %mi α
                  %mi P
                  %mover
                    %mo →
                    %mi β
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\xleftarrow{\alpha} P\xrightarrow{\beta} B
            the
            %strong ‘’inverse Ehresmann’‘ groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi P
                %annotation{:encoding => "application/x-tex"} P^{-1}P
            is defined by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msub
                    %mi P
                    %mn 0
                  %mo :
                  %mo =
                  %mi B
                %annotation{:encoding => "application/x-tex"} P^{-1}P_0:=B
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %msup
                    %mi b
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msup
                    %mi y
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi z
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mi β
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi b
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi b
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} /
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} P^{-1}P(b,b^\prime):=y^{-1}z:=\{(y,z)|\beta(y)=b,\,\alpha(z)=b^\prime\}/\sim
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ∼
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (y,z)\sim(x,u)
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo =
                  %msup
                    %mi xy
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi z
                %annotation{:encoding => "application/x-tex"} u=xy^{-1}z
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is a principal
            = succeed "-bundle," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi P
                %annotation{:encoding => "application/x-tex"} P^{-1}P
            is canonically isomorphic to the one object groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %msup
                              %mi P
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi P
                            %mo →
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi y
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi z
                            %mo :
                            %mi y
                            %mo →
                            %mi z
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mi g
                            %mo ,
                          %mtd
                            %mi yg
                            %mo =
                            %mi z
                %annotation{:encoding => "application/x-tex"} \begin{cases}P^{-1}P\to G\\(y^{-1}z:y\to z)\to g,&amp;yg=z\end{cases}
          %h2#the_enveloping_groupoid_
            The enveloping groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(P)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo ←
                    %mi α
                  %mi P
                  %mover
                    %mo →
                    %mi β
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\xleftarrow{\alpha} P\xrightarrow{\beta} B
            be a pregroupoid.
          %p
            The
            %strong
              enveloping groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E(P)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            is defined by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi P
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 0
                  %mo :
                  %mo =
                  %mi A
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %mi B
                %annotation{:encoding => "application/x-tex"} E(P)_0:=A\coprod B
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi P
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo :
                    %mo =
                    %msup
                      %mi PP
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %msup
                      %mi P
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi P
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi P
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %msup
                      %mi P
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} E(P)_1:=PP^{-1}\coprod P^{-1}P\coprod P\coprod P^{-1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} P^{-1}
            denotes the pregroupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            interchanged. And calculations (see
            %a{:href => "http://home.imf.au.dk/kock/pbgc4.pdf"} arxiv
            p.9) show that this is a groupoid.
          %h2#properties Properties
          %ul
            %li
              %p
                The edges of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                act on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                principally on the left and the right, respectively and the actions commute with each other.
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi P
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p:P\to A
                be a principal
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                bundle. Then there is a groupoid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 0
                      %mo =
                      %mi A
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mo *
                    %annotation{:encoding => "application/x-tex"} E_0=A\coprod *
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mn 1
                        %mo =
                        %mi P
                      %annotation{:encoding => "application/x-tex"} E_1=P
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo =
                      %mi E
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo ,
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G=E(*,*)
            %li
              %p
                The functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi PGrdp
                      %mo →
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} E(-):PGrdp\to Grpd
                is a faithful left adjoint to the forgetful functor
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
