                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \ast
                    \\\
                    \&amp; \swarrow &amp;\swArrow_{h_1}&amp; \searrow
                    \\\
                    \\mathbf{B}G
                    \&amp;&amp;
                    \\stackrel{\phi_1}{\longrightarrow}
                    \&amp;&amp;
                    \\mathbf{B}H
                    \\\
                    {}^{\mathllap{id}}\downarrow &amp;&amp; \Downarrow^{\mathrlap{h}} &amp;&amp; \downarrow^{\mathrlap{id}}
                    \\\
                    \\mathbf{B}G
                    \&amp;&amp;\underset{\phi_2}{\longrightarrow} &amp;&amp;
                    \\mathbf{B}H
                    }
                    \\;\;\;\;\;
                    \=
                    \\;\;\;\;\;
                    \\array{
                    \&amp;&amp; \ast
                    \\\
                    \&amp; \swarrow &amp;\swArrow_{h_2}&amp; \searrow
                    \\\
                    \\mathbf{B}G
                    \&amp;&amp;
                    \\underset{\phi_2}{\longrightarrow}
                    \&amp;&amp;
                    \\mathbf{B}H
                    }
                    \\,.
            %p
              But this says in components that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mn 2
                      %mo =
                      %msub
                        %mi h
                        %mn 1
                      %mo ⋅
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h_2 = h_1\cdot h
              %em at most one
              morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Grpd
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi H
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Grpd^{\ast/}((\mathbf{B}G,\ast),(\mathbf{B}H,\ast))
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo ,
                    %msub
                      %mi h
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi_1,h_1)
              to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ϕ
                        %mn 2
                      %mo ,
                      %msub
                        %mi h
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\phi_2,h_2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo =
                    %msub
                      %mi Ad
                      %mi h
                    %mo ∘
                    %msub
                      %mi ϕ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi_2 = Ad_h \circ \phi_1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mn 2
                      %mo =
                      %msub
                        %mi h
                        %mn 1
                      %mo ⋅
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h_2 = h_1\cdot h
            %p
              But since, by the previous argument, the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
              takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo ,
                    %msub
                      %mi h
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi_1,h_1)
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ad
                        %mrow
                          %msubsup
                            %mi h
                            %mn 1
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                      %mo ∘
                      %msub
                        %mi ϕ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} Ad_{h_1^{-1}} \circ \phi_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo ,
                    %msub
                      %mi h
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi_1,h_1)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo ,
                    %msub
                      %mi h
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi_2,h_2)
              are taken to the same group homomorphism by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ad
                      %mrow
                        %msubsup
                          %mi h
                          %mn 2
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mo ∘
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo =
                    %msub
                      %mi Ad
                      %mrow
                        %msup
                          %mi h
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo ⋅
                        %msubsup
                          %mi h
                          %mn 1
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mo ∘
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo =
                    %msub
                      %mi Ad
                      %mrow
                        %msubsup
                          %mi h
                          %mn 1
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mo ∘
                    %msub
                      %mi ϕ
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ad_{h_2^{-1}} \circ \phi_2
                    \=
                    Ad_{h^{-1}\cdot h_1^{-1}}\circ \phi_2
                    \=
                    Ad_{h_1^{-1}} \circ \phi_1
                    \\,.
            %p
              This establishes that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
              is also an equivalence on all
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hom-groupoids"} hom-groupoids
          %p
            This proof also shows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}(-)
            is in fact the inverse equivalence:
          .num_cor
            %h6#corollary Corollary
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%282%2C1%29-categories"} equivalence of (2,1)-categories
              between pointed connected groupoids and plain groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grp
                    %mover
                      %munder
                        %mo ⟶
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                      %munderover
                        %mo ⟵
                        %mo ≃
                        %mrow
                          %msub
                            %mi π
                            %mn 1
                          %mo =
                          %msub
                            %mi Ω
