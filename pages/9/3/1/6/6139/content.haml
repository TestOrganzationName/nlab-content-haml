              of the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{*}
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} k-1
              %a.existingWikiWord{:href => "/nlab/show/connected"} connected
              (i.e. their first
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+in+an+%28%E2%88%9E%2C1%29-topos"} homotopy sheaves
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
