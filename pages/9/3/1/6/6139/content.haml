                                  %mi h
                                  %mn 1
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mn 1
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi H
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi id
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo ⇓
                              %mpadded{:width => "0"}
                                %mi h
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mn 2
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi H
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
