                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k-1)
              %a.existingWikiWord{:href => "/nlab/show/connected"} connected
              objects and the groupal
              %a.existingWikiWord{:href => "/nlab/show/Ek-algebra"} Ek-algebra
              objects in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
