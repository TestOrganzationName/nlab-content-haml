          %p
            This is
            %em
              %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra, theorem 5.2.6.10
          %p
            Specifically for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/May+recognition+theorem"} May recognition theorem
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              equipped with an action of the
              %a.existingWikiWord{:href => "/nlab/show/little+cubes+operad"} little cubes operad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_k
              and suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is grouplike. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is homotopy equivalent to a
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi k
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Omega^k X
              for some pointed topological space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            This is
            %em
              %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra, theorem 5.2.6.15
          #LoopingDeloopingDegree1InTopos.num_remark
            %h6#remark_2 Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = 1
              we have a looping/delooping equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo ⟶
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                      %mover
                        %mo ⟵
                        %mi Ω
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo ≥
                        %mn 1
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    Grp(\mathbf{H})
                    \\stackrel{\overset{\Omega}{\longleftarrow}}{\underset{\mathbf{B}}{\longrightarrow}}
                    \\mathbf{H}_{\geq 1}^{\ast /}
            %p
              between pointed connected objects in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              and grouplike
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebra"} A-∞ algebra
              objects in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              objects in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .num_remark
            %h6#remark_3 Remark
            %p
              If the ambient
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              has
              %a.existingWikiWord{:href => "/nlab/show/homotopy+dimension"} homotopy dimension
              0 then every connected object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              admits a point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo →
                      %mi E
                    %annotation{:encoding => "application/x-tex"} * \to E
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              of pointed connected objects differs from that of unpointed connected objects (because in the latter the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            %p
              The connected objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
