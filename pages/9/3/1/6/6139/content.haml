                        %mrow
                          %msup
                            %mi h
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                      %mo ∘
                      %mi ϕ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi G
                      %mo ⟶
                      %mi H
                    %annotation{:encoding => "application/x-tex"} Ad_{h^{-1}} \circ \phi \;\colon\; G \longrightarrow H
              %a.maruku-ref{:href => "#piAs2Functor"}
              this functor as forming loops:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mrow
                        %mo {
                        %mrow
