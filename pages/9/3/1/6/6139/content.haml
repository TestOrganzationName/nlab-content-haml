          #LoopingDeloopingForHigherStacks.num_theorem
            %h6#theorem Theorem
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
