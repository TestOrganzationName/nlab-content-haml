            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            forms
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/loop+space+objects"} loop space objects
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/May+recognition+theorem"} May recognition theorem
          %p
            Concretely, this is
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
            by a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
