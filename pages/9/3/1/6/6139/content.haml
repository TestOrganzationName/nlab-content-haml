                    \\\
                    \\ast &amp;&amp; \swArrow_{\mathrlap{g}} &amp;&amp; \ast
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; \mathbf{B}G
