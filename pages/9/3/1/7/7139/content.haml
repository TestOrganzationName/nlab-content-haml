                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mn 6
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{e^{2\pi i j/6}\} \cup \{e^{2\pi i j/6} + e^{2\pi i (j+1)/6}\}
          %h4#the_groups___
            The groups
            = succeed "," do
