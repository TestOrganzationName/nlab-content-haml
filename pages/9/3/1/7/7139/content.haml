                    %mo{:stretchy => "false"} )
                    %mn 8
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}^8 \cup (\mathbb{Z} + \frac1{2})^8
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
