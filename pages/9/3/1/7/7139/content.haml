                %semantics
                  %mrow
                    %mo ±
                    %mi j
                  %annotation{:encoding => "application/x-tex"} \pm j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ±
                  %mi k
                %annotation{:encoding => "application/x-tex"} \pm k
            and the 16 unit quaternions given by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ε
                    %mn 0
                  %mn 1
                  %mo +
                  %msub
                    %mi ε
                    %mn 1
                  %mi i
                  %mo +
                  %msub
                    %mi ε
                    %mn 2
                  %mi j
                  %mo +
                  %msub
                    %mi ε
                    %mn 3
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac1{2}(\varepsilon_0 1 + \varepsilon_1 i + \varepsilon_2 j + \varepsilon_3 k)
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ε
                      %mn 0
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi ε
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} }
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} (\varepsilon_0, \ldots, \varepsilon_3) \in \{-1, 1\}^4
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            under multiplication, and this group is isomorphic to the
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/binary+tetrahedral+group"} binary tetrahedral group
          %p The Coxeter diagram is:
          %h4#the_group__2
            The group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
