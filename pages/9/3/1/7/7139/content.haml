                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mn 8
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x = (x_1, \ldots, x_8)
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℤ
                    %mn 8
                  %mo ∪
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo +
                  %mfrac
                    %mn 1
                    %mn 2
