                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi F
                              %mn 4
                          %annotation{:encoding => "application/x-tex"} F_4
                  %li
                    %a{:href => "#the_group__2"}
                      The group
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi G
                              %mn 2
                          %annotation{:encoding => "application/x-tex"} G_2
                  %li
                    %a{:href => "#CoxeterGroupH4"}
                      The groups
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi H
                                %mn 3
                            %annotation{:encoding => "application/x-tex"} H_3
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi H
                              %mn 4
                          %annotation{:encoding => "application/x-tex"} H_4
                %li
                  %a{:href => "#affine_reflection_groups"} Affine reflection groups
                %li
                  %a{:href => "#hyperbolic_reflection_groups"} Hyperbolic reflection groups
              %li
                %a{:href => "#properties_of_coxeter_groups"} Properties of Coxeter groups
              %ul
                %li
                  %a{:href => "#sketch_of_proof"} Sketch of proof
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %em Coxeter group
            is a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            determined by a
            = succeed "," do
              %em Coxeter matrix
            = succeed "." do
              %span.newWikiWord
                reflection group
                %a{:href => "/nlab/new/reflection+group"} ?
          %h2#definition Definition
          %p
            A
            %em Coxeter matrix
            over an index
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is a symmetric
            %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo{:lspace => "verythinmathspace"} :
                  %mi I
                  %mo ×
                  %mi I
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 3
                  %mo ,
                  %mi …
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} M \colon I \times I \to \{1, 2, 3, \ldots, \infty\}
          %p
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} M(i, i) = 1
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} M(i, j) \gt 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo =
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} m_{i,j} = M(i, j)
            %strong Coxeter group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mi M
                %annotation{:encoding => "application/x-tex"} W_M
            is the group presented as having generators
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi i
                  %annotation{:encoding => "application/x-tex"} s_i
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi s
                    %mi i
                  %msub
                    %mi s
                    %mi j
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi m
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} (s_i s_j)^{m_{i, j}} = 1
          %p
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i, j \in I
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo ≠
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} m_{i, j} \neq \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                %annotation{:encoding => "application/x-tex"} m_{i, j}
            is the order of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                  %msub
                    %mi s
                    %mi j
                %annotation{:encoding => "application/x-tex"} s_i s_j
            (as is easily shown), and these orders determine the group.
          %p
            A Coxeter group is usually more properly regarded as a
            %a.existingWikiWord{:href => "/nlab/show/group+presentation"} group presentation
            rather than as an abstract group, but there is less than perfect consistency on this point in the literature. The
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                %annotation{:encoding => "application/x-tex"} s_i
            are
            %a.existingWikiWord{:href => "/nlab/show/involutions"} involutions
            that play the role of reflections generating the group.
          %p
            Often Coxeter groups are specified by means of
            = succeed "." do
              %strong Coxeter diagrams
            %a.existingWikiWord{:href => "/nlab/show/graph"} multigraph
            whose vertices are indexed by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %mo −
                  %mn 2
                %annotation{:encoding => "application/x-tex"} m_{i, j} - 2
            edges between distinct vertices
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                  %annotation{:encoding => "application/x-tex"} i, j
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi i
                  %annotation{:encoding => "application/x-tex"} s_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi j
                %annotation{:encoding => "application/x-tex"} s_j
            commute precisely when there are no edges between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
          %h2#examples Examples
          %h3#finite_reflection_groups Finite reflection groups
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a finite dimensional real
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a finite group generated by linear reflections of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            (each pointwise fixing a linear hyperplane and preserving the Euclidean metric). Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a Coxeter group. Such finite Coxeter groups are also called
            %strong spherical Coxeter groups
            (being subgroups of isometry groups of Euclidean spheres).
          %p
            In this case, each generating reflection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                %annotation{:encoding => "application/x-tex"} s_i
            is the mirror reflection specified by the fixed hyperplane
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi i
                  %annotation{:encoding => "application/x-tex"} H_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mi v
                    %mi i
                %annotation{:encoding => "application/x-tex"} s_i(v_i) = -v_i
            for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi i
                %annotation{:encoding => "application/x-tex"} v_i
            orthogonal to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi i
                  %annotation{:encoding => "application/x-tex"} H_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                %annotation{:encoding => "application/x-tex"} m_{i, j}
            is the order of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi i
                    %msub
                      %mi s
                      %mi j
                  %annotation{:encoding => "application/x-tex"} s_i s_j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi m
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                %annotation{:encoding => "application/x-tex"} \pi/m_{i, j}
            is the dihedral angle between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi i
                %annotation{:encoding => "application/x-tex"} H_i
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi j
                  %annotation{:encoding => "application/x-tex"} H_j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi s
                    %mi i
                  %msub
                    %mi s
                    %mi j
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi m
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} (s_i s_j)^{m_{i, j}} = 1
            suffice to specify the structure of the group, roughly because the dihedral angles uniquely determine a hyperplane arrangement up to an element of the orthogonal group, and the hyperplane arrangement determines the group in kaleidoscopic fashion, using the hyperplanes as mirrors.
          %p
            Finite reflection groups have been completely classified. Notice that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            are finite reflection groups on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            respectively, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ×
                  %mi H
                %annotation{:encoding => "application/x-tex"} G \times H
            is a finite reflection group on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ×
                    %mi W
                  %annotation{:encoding => "application/x-tex"} V \times W
            = succeed "," do
              %strong reducible
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a reflection group on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ×
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} V \times \mathbb{R}
            in a trivial way, but we ignore such
            %em inessential extensions
            in our descriptions below. Thus it will suffice to consider only irreducible, essential finite reflection groups. The dimension of the Euclidean space on which the group acts will be indicated by a subscript (with mild and fixable exceptions for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 7
                %annotation{:encoding => "application/x-tex"} E_7
            and
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 6
                  %annotation{:encoding => "application/x-tex"} E_6
          %p
            Irreducible essential finite reflection groups fall into four infinite families
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} A_n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi n
                    %mo =
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} B_n = C_n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D_n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I_2(m)
          %ol
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 6
                  %annotation{:encoding => "application/x-tex"} E_6
              ,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 7
                    %annotation{:encoding => "application/x-tex"} E_7
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 8
                    %annotation{:encoding => "application/x-tex"} E_8
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} F_4
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G_2
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} H_3
              ,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} H_4
          %p
            The Coxeter matrices which specify these groups are often and traditionally encoded in the form of
            = succeed "," do
              %strong Coxeter diagrams
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            dots, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo −
                  %mn 2
                %annotation{:encoding => "application/x-tex"} k-2
            line segments between dots
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo =
                    %mi k
                  %annotation{:encoding => "application/x-tex"} m_{i, j} = k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} k = 2
            (no line segments) means
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                %annotation{:encoding => "application/x-tex"} s_i
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi j
                %annotation{:encoding => "application/x-tex"} s_j
            commute. Coxeter diagrams are highly convenient; for example, there are a number of “coincidences” where various Coxeter groups in different families A-I are isomorphic, and these coincidences are visually apparent by seeing that their Coxeter diagrams are isomorphic. Similarly, the Coxeter diagram of a reducible group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ×
                  %mi H
                %annotation{:encoding => "application/x-tex"} G \times H
            is the disjoint union of the Coxeter diagrams for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            separately, and so in the irreducible case we are only interested in
            %em connected
            Coxeter diagrams.
          %h4#the_family_
            The family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi n
                %annotation{:encoding => "application/x-tex"} A_n
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi n
                %annotation{:encoding => "application/x-tex"} A_n
            is the isometry group of a regular
            = succeed "-simplex," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S_{n+1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                %annotation{:encoding => "application/x-tex"} s_i
            is identified with the permutation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mi i
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i i+1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mrow
                        %mi i
                        %mo ,
                        %mi i
                        %mo +
                        %mn 1
                    %mo =
                    %msub
                      %mi m
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                        %mo ,
                        %mi i
                    %mo =
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} m_{i, i+1} = m_{i+1, i} = 3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} m_{i, j} = 2
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi i
                      %mo −
                      %mi j
                      %mo{:stretchy => "false"} |
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} {|i-j|} \geq 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi s
                    %mi i
                  %msub
                    %mi s
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 3
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} (s_i s_{i+1})^3 = 1
            may be rewritten as a braid relation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                  %msub
                    %mi s
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %msub
                    %mi s
                    %mi i
                  %mo =
                  %msub
                    %mi s
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %msub
                    %mi s
                    %mi i
                  %msub
                    %mi s
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} s_i s_{i+1} s_i = s_{i+1} s_i s_{i+1}
          %p
            since the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                %annotation{:encoding => "application/x-tex"} s_i
            are involutions.
          %h4#the_family__2
            The family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi n
                %annotation{:encoding => "application/x-tex"} B_n
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi n
                  %mo =
                  %msub
                    %mi C
                    %mi n
                %annotation{:encoding => "application/x-tex"} B_n = C_n
            is the isometry group of a regular
            = succeed "-cube" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} }
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{-1, 1\}^n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi n
                    %mo ⋉
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℤ
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S_n \ltimes (\mathbb{Z}_2)^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi s
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo ,
                  %msub
                    %mi t
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} s_1, \ldots, s_{n-1}, t_{n-1}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                %annotation{:encoding => "application/x-tex"} s_i
            is the reflection through the hyperplane
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi i
                  %mo =
                  %msub
                    %mi x
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} x_i = x_{i+1}
            (i.e., swap the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mi th
                %annotation{:encoding => "application/x-tex"} i^{th}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo +
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi st
                %annotation{:encoding => "application/x-tex"} (i+1)^{st}
            coordinates), and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} t_{n-1}
            is the reflection through the hyperplane
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x_n = 0
          %p
            so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %msub
                    %mi t
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} s_{n-1} t_{n-1}
            is of order 4, but
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                  %msub
                    %mi t
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} s_i t_{n-1}
            is otherwise of order 2 (i.e.,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                %annotation{:encoding => "application/x-tex"} s_i
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} t_{n-1}
            commute).
          %p
            %strong Remark:
            The distinction between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi n
                %annotation{:encoding => "application/x-tex"} B_n
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                %annotation{:encoding => "application/x-tex"} C_n
            is not apparent at the level of Coxeter groups, but rather at the level of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/root+system"} root systems
          %h4#the_family__3
            The family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi n
                %annotation{:encoding => "application/x-tex"} D_n
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi n
                %annotation{:encoding => "application/x-tex"} D_n
            is the linear isometry group on the set of integral vectors in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            of length
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \sqrt{2}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 2n(n-1)
            many. It is not an isometry group of a regular solid, but it is a subgroup of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi n
                %annotation{:encoding => "application/x-tex"} B_n
            of index 2. In this case there are involutions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mn 1
                  %mo ,
                  %mi …
                  %msub
                    %mi s
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo ,
                  %msub
                    %mi t
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} s_1, \ldots s_{n-1}, t_{n-1}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                %annotation{:encoding => "application/x-tex"} s_i
            is as described for the case
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi n
                  %annotation{:encoding => "application/x-tex"} B_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} t_{n-1}
            swaps and negates the last two coordinates. The Coxeter diagram looks like this:
          %p
            We see by examining the Coxeter diagrams that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 3
                    %mo ≅
                    %msub
                      %mi D
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} A_3 \cong D_3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mn 4
                %annotation{:encoding => "application/x-tex"} D_4
            on the other hand admits a symmetry of order 3, called
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/triality"} triality
          %h4#the_family__4
            The family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} I_2(m)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/dihedral+group"} dihedral group
            of order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi n
                %annotation{:encoding => "application/x-tex"} 2 n
            is the isometry group of a regular
            = succeed "-gon" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi e
                    %mrow
                      %mn 2
                      %mi π
                      %mi i
                      %mi j
                      %mo{:stretchy => "false"} /
                      %mi n
                  %mo :
                  %mn 1
                  %mo ≤
                  %mi j
                  %mo ≤
                  %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{e^{2\pi i j/n}: 1 \leq j \leq n\}
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mn 1
                    %mo ≅
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^1 \cong \mathbb{R}^2
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo +
                    %msup
                      %mi e
                      %mrow
                        %mn 2
                        %mi π
                        %mi i
                        %mo{:stretchy => "false"} /
                        %mi n
                  %annotation{:encoding => "application/x-tex"} 1 + e^{2\pi i/n}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo −
                  %mn 2
                %annotation{:encoding => "application/x-tex"} m-2
            edges between two vertices. There are coincidences
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 2
