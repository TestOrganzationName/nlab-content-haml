                  %mo{:stretchy => "false"} {
                  %msup
                    %mi e
                    %mrow
                      %mn 2
                      %mi π
                      %mi i
                      %mi j
                      %mo{:stretchy => "false"} /
                      %mn 6
                  %mo +
