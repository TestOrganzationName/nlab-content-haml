                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A^0(\bullet)
          %h2#formal_group_laws_and_landwebers_criterion Formal group laws and Landweber’s criterion
          %p
            %a.existingWikiWord{:href => "/nlab/show/formal+group+law"}> Formal group law
            s of dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            are classified by
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %a.existingWikiWord{:href => "/nlab/show/Lazard+ring"} Lazard ring
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %p
            We can define
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi A
                      %mi f
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi MP
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %mi MP
                        %mo{:stretchy => "false"} (
                        %mo •
                        %mo{:stretchy => "false"} )
                    %mi R
                  %annotation{:encoding => "application/x-tex"} A_f^n(X)=MP^n(X)\otimes_{MP(\bullet)}R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi MP
                %annotation{:encoding => "application/x-tex"} MP
            denotes
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+cobordism+cohomology+theory"} complex cobordism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi MP
                  %mo{:stretchy => "false"} (
                  %mo •
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} MP(\bullet)
            is isomorphic to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lazard+ring"} Lazard's ring
          %p
            %strong Definition.
            A sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi v
                    %mi n
                %annotation{:encoding => "application/x-tex"} v_0,\ldots,v_n
            of elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is regular if
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi v
                    %mrow
                      %mi k
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R/(v_0,\ldots,v_{k-1})
            given by multiplication by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi k
                %annotation{:encoding => "application/x-tex"} v_k
            are injective for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0\le k\le n
          %p
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Landweber+criterion"} Landweber criterion
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x,y)
            be a formal group law and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            a prime,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi i
                %annotation{:encoding => "application/x-tex"} v_i
            the coefficient of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mrow
                      %msup
                        %mi p
                        %mi i
                %annotation{:encoding => "application/x-tex"} x^{p^i}
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi p
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                    %msub
                      %mo +
                      %mi f
                    %mi ⋯
                    %msub
                      %mo +
                      %mi fx
                  %annotation{:encoding => "application/x-tex"} [p]_f(x)=x+_f\cdots+_fx
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi v
                    %mi i
                %annotation{:encoding => "application/x-tex"} v_0,\ldots,v_i
            form a regular sequence for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x,y)
            gives a
            %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
            via the formula with
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            above.
          %p
            %strong Example.
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                    %mo +
                    %mi y
                  %annotation{:encoding => "application/x-tex"} g_a(x,y)=x+y
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi p
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi px
                  %annotation{:encoding => "application/x-tex"} [p]_a(x)=px
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 0
                    %mo =
                    %mi p
                  %annotation{:encoding => "application/x-tex"} v_0=p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi i
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} v_i=0
            for all
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} i\ge1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R/(p)\to R/(p)
            must be injective. The last statement implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            contains the rational numbers as a subring.
          %p
            Note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi HP
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi k
                  %msup
                    %mi H
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                      %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} HP^*(X,R)=\prod_k H^{n+2k}(X,R)
            is a
            %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
            over any
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %p
            %strong Example.
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi m
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi xy
                  %annotation{:encoding => "application/x-tex"} g_m(x,y)=xy
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi p
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi m
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi p
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} [p]_m(x)=(x+1)^p-1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 0
                    %mo =
                    %mi p
                  %annotation{:encoding => "application/x-tex"} v_0=p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 1
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} v_1=1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi i
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} v_i=0
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo &gt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} i \gt 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi K
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi MP
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %mi MP
                      %mo{:stretchy => "false"} (
                      %mo •
                      %mo{:stretchy => "false"} )
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} K^*(X)=MP^*(X)\otimes_{MP(\bullet)} \mathbb{Z}
            is a cohomology theory.
          %h2#formal_groups_from_formal_group_laws Formal groups from formal group laws
          %p
            Given a commutative topological
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and a
            %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x,y)
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(a,b)
            converges for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} a,b\in A
            and the formula giving an inverse to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            converges for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a\in A
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %msub
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,+_f)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %msub
                      %mo +
                      %mi f
                    %mi b
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a+_f b=f(a,b)
          %p
            %strong Example.
            For any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            the pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (N(A),+_f)
            is an abelian group, where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(A)
            denotes the set of nilpotent elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            %strong Example.
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be an oriented complex oriented cohomology theory. Then computing
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            on some algebra. Recall that
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            are
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classified
            by maps from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %mo ×
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty \times \mathbb{C}P^\infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %mo ×
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %mo →
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty \times \mathbb{C}P^\infty \to \mathbb{C}P^\infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %mo ×
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %mo →
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} X\to \mathbb{C}P^\infty \times \mathbb{C}P^\infty \to \mathbb{C}P^\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            in the cohomology of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                  %mo ×
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty \times \mathbb{C}P^\infty
            is a formal group law. The image of this formal group law in the cohomology of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            makes sense if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a finite cell complex so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A^0(X)
            is a nilpotent algebra.
          %p
            %strong Question:
            When do two formal group laws yield isomorphic groups?
          %p
            %strong Definiton.
            A homomorphism of formal group laws
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a formal power series
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo ∈
                  %mi A
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \phi\in A[x]
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi(f(x,y))=g(\phi(x),\phi(y))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            is zero.) Hence formal group laws form a category.
          %p
            %strong Example.
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            contains rational numbers as a subring, then we have two canonical homomorphisms. The first one is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi g
                      %mi a
                    %mo →
                    %msub
                      %mi g
                      %mi m
                  %annotation{:encoding => "application/x-tex"} \exp\colon g_a\to g_m
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo &gt;
                        %mn 0
                    %msup
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} /
                    %mi k
                    %mo !
                  %annotation{:encoding => "application/x-tex"} \exp(x)=\sum_{k \gt 0}x^k/k!
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi log
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi g
                      %mi m
                    %mo →
                    %msub
                      %mi g
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \log\colon g_m\to g_a
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi log
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo &gt;
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %msup
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} /
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \log(x)=\sum_{k \gt 0}(-1)^{k+1}x^k/k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi K
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mi ℤ
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} K^n(X)\otimes_{\mathbb{Z}} \mathbb{Q}
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi kH
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_kH^{n+2k}(X,\mathbb{Q})
          %p
            %strong Formal groups.
            A
            %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
            is a group in the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/formal+scheme"} formal scheme
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/formal+scheme"} formal scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Y
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat{Y}
            is defined for any
            %a.existingWikiWord{:href => "/nlab/show/closed+subscheme"} closed immersion
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \hookrightarrow X
            %a.existingWikiWord{:href => "/nlab/show/formal+scheme"} formal scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Y
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat Y
            is the
            = succeed "-jet" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            inside of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            %strong Definition.
            The locally
            %a.existingWikiWord{:href => "/nlab/show/ringed+space"} ringed space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Y
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat Y
            is defined as the
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            with structure sheaf
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi lim
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi ℐ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} lim O_X/{\mathcal{I}}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℐ
                %annotation{:encoding => "application/x-tex"} \mathcal{I}
            is the defining sheaf of ideals of the closed immersion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y\hookrightarrow X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is a closed subscheme of
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            %strong Examples.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mover
                    %mi Y
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} X=\hat Y
            when
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y=X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Spec
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathrm{Spec} k[t]=X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y=V(t)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo =
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo ,
                    %msup
                      %mi t
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat X=k[t,t^{-1}]
          %p
            In fact not every locally noetherian formal scheme can be obtained as a completion of a single noetherian scheme in another scheme; such formal schemes are called
            = succeed "." do
              %em algebraizable
          %p
            %strong Definition. (formal spectrum)
            The
            %a.existingWikiWord{:href => "/nlab/show/formal+spectrum"} formal spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Spf
                  %mi R
                %annotation{:encoding => "application/x-tex"} \mathrm{Spf} R
            of a commutative noetherian ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            with a specified ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ⊂
                  %mi R
                %annotation{:encoding => "application/x-tex"} I \subset R
            whose powers define a local basis of a topology around
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            which is Hausdorff, is the locally
            %a.existingWikiWord{:href => "/nlab/show/ringed+space"} ringed space
            with the underlying
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Spec
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mi I
                %annotation{:encoding => "application/x-tex"} \mathrm{Spec} R/I
            whose global sections of the
            %a.existingWikiWord{:href => "/nlab/show/structure+sheaf"} structure sheaf
            are the
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mrow
                      %mi{:mathvariant => "normal"} Spf
                      %mi R
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} Spf
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mi lim
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi I
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  O_{\mathrm{Spf} R}(\mathrm{Spf} R)=\lim_n (R/I^n)
                  \\,.
          %p (This is incomplete description, one needs to talk sheaves of ideals instead)
          %h3#formal_group_laws_from_elliptic_curve formal group laws from elliptic curve
          %p
            Recall from the above that a given a
            %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} F(x,y) \in R[ [x,y] ]
            we get te structure of a
            %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
            on the
            %a.existingWikiWord{:href => "/nlab/show/formal+spectrum"} formal spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spf
                %annotation{:encoding => "application/x-tex"} Spf
            by taking the product to be given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Spf
                          %mi R
                          %mo{:stretchy => "false"} [
                          %mo{:stretchy => "false"} [
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ]
                          %mo ≃
                          %mi Spf
                          %mo{:stretchy => "false"} [
                          %mo{:stretchy => "false"} [
                          %mi x
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ]
                          %mo ×
                          %mi Spf
                          %mi R
                          %mo{:stretchy => "false"} [
                          %mo{:stretchy => "false"} [
                          %mi y
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo →
                        %mtd
                          %mi Spf
                          %mi R
                          %mo{:stretchy => "false"} [
                          %mo{:stretchy => "false"} [
                          %mi z
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ←
                          %mo{:stretchy => "false"} |
                        %mtd
                          %mi z
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Spf R[[x,y]] \simeq
                  Spf[[x]] \times Spf R[[y]]
                  \&amp;\to&amp; Spf R[[z]]
                  \\\
                  f(x,y)&amp;\leftarrow |&amp; z
                  }
          %p
            Isomorphic
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
            = succeed "s)" do
              %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
            has
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ≃
                    %mi Spf
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi z
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} G \simeq Spf R[ [z] ]
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
          %p
            Now we get
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
          %p
            %strong Definition
            An
            %strong
              %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            over a commutative
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            in the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            that is a relative 1-dimensional, ,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+scheme"} smooth curve
            %a.existingWikiWord{:href => "/nlab/show/proper+scheme"} proper
            curve over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %p
            This implies that it has
            %a.existingWikiWord{:href => "/nlab/show/genus"} genus
            1. (by a direct argument of the Chern class of the tangent bundle.)
          %p
            Given an
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi Spec
                    %mi R
                  %annotation{:encoding => "application/x-tex"} E \to Spec R
            %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat E
            by completing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            along its identity
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \sigma_0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi σ
                        %mn 0
                  %mi E
                %annotation{:encoding => "application/x-tex"}
                  E \to Spec(R) \stackrel{\sigma_0}{\to} E
          %p
            (the one dual to the map that maps everything to
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} 0 \in R
            %a.existingWikiWord{:href => "/nlab/show/ringed+space"} ringed space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} ^
                  %mo ,
                  %msub
                    %mover
                      %mi O
                      %mo{:stretchy => "false"} ^
                    %mrow
                      %mi E
                      %mo ,
                      %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\hat E, \hat O_{E,0})
          %p
            %strong example
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/structure+sheaf"} structure sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi O
                      %mo{:stretchy => "false"} ^
                    %mrow
                      %mi E
                      %mo ,
                      %mn 0
                  %mo ≃
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi z
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \hat O_{E,0} \simeq k[ [z] ]
          %p then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi O
                      %mo{:stretchy => "false"} ^
                    %mrow
                      %mi E
                      %mo ×
                      %mi E
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mover
                      %mi O
                      %mo{:stretchy => "false"} ^
                    %mrow
                      %mi E
                      %mo ,
                      %mn 0
                  %msub
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ^
                    %mi k
                  %msub
                    %mover
                      %mi O
                      %mo{:stretchy => "false"} ^
                    %mrow
                      %mi E
                      %mo ,
                      %mn 0
                  %mo ≃
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\hat O_{E \times E, (0,0)} \simeq
                  \\hat O_{E,0}
                  \\hat \otimes_k
                  \\hat O_{E,0}
                  \\simeq
                  k[[x,y]]
          %p
            %strong example
            %strong (Jacobi quartics)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi y
                    %mn 2
                  %mo =
                  %mn 1
                  %mo −
                  %mn 2
                  %mi δ
                  %msup
                    %mi x
                    %mn 2
                  %mo +
                  %mi ϵ
                  %msup
                    %mi x
                    %mn 4
                %annotation{:encoding => "application/x-tex"}
                  y^2 = 1- 2 \delta x^2 + \epsilon x^4
          %p
            defines
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Y
                      %mi Z
                    %mo ,
                    %mi ϵ
                    %mo ,
                    %mi δ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R = \mathbb{Z}[Y_Z,\epsilon, \delta]
          %p
            The corresponding
            %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
            is
            %strong Euler’s formal group law
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mi x
                      %msqrt
                        %mrow
                          %mn 1
                          %mo −
                          %mn 2
                          %mi δ
                          %msup
                            %mi y
                            %mn 2
                          %mo +
                          %mi ϵ
                          %msup
                            %mi y
                            %mn 4
                      %mo +
                      %mi y
                      %msqrt
                        %mrow
                          %mn 1
                          %mo −
                          %mn 2
                          %mi δ
                          %msup
                            %mi x
                            %mn 2
                          %mo +
                          %mi ϵ
                          %msup
                            %mi x
                            %mn 4
                    %mrow
                      %mn 1
                      %mo −
                      %mi ϵ
                      %msup
                        %mi x
                        %mn 2
                      %msup
                        %mi y
                        %mn 2
                %annotation{:encoding => "application/x-tex"}
                  f(x,y) = \frac{x\sqrt{1- 2 \delta y^2 + \epsilon y^4}
                  + y \sqrt{1- 2 \delta x^2 + \epsilon x^4}}
                  {1- \epsilon x^2 y^2}
          %p
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo :
                  %mo =
                  %mi ϵ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi δ
                    %mn 2
                  %mo −
                  %mi ϵ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo ≠
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \Delta := \epsilon(\delta^2 - \epsilon)^2 \neq 0
            then this is a non-trivial elliptic curve.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \Delta = 0
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi G
                    %mi m
                  %mo ,
                  %msub
                    %mi G
                    %mi a
                %annotation{:encoding => "application/x-tex"} f(x,y) \simeq G_m, G_a
            (additive or multiplicative formal group law corresponding to
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            and
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/KU"} KU
          %h2#weakly_periodic_cohomology_theories_and_formal_groups weakly periodic cohomology theories and formal groups
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative
            %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/weakly+periodic+cohomology+theory"} weakly periodic
            if the natural map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %msup
                        %mi A
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                  %msup
                    %mi A
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≃
                  %msup
                    %mi A
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A^2({*}) \otimes_{A^0({*})} A^n({*}) \stackrel{\simeq}{\to}
                  A^{n+2}({*})
          %p
            is an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
          %p
            Compare with the notion of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/periodic+cohomology+theory"} periodic cohomology theory
          %h1#relation_to_formal_groups Relation to formal groups
          %p
            One reason why weakly periodic cohomology theories are of interest is that their
            %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
            over the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
            defines a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
          %p
            To get a
            %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
            from a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weakly+periodic+cohomology+theory"} weakly periodic
            %a.existingWikiWord{:href => "/nlab/show/even+cohomology+theory"} even
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative
            %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A^\bullet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mo •
                %annotation{:encoding => "application/x-tex"} A^\bullet
            from a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mn 0
                  %mo :
                  %mo *
                  %mo →
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                %annotation{:encoding => "application/x-tex"}
                  i_0 : {*} \to \mathbb{C}P^\infty
          %p and take the kernel
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo :
                  %mo =
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi i
                    %mn 0
                    %mo *
                  %mo :
                  %msup
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  J := ker(i_0^* : A^0(\mathbb{C}P^\infty) \to A^0({*}))
          %p
            to be the
            %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
            that we complete along to define the
            %a.existingWikiWord{:href => "/nlab/show/formal+scheme"} formal scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spf
                  %msup
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spf A^0(\mathbb{C}P^\infty)
            (see there for details).
          %p
            Notice that the map from the point is unique only up to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
          %p
            The fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is weakly periodic allows to reconstruct the
            %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
            essentially from this
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/formal+scheme"} formal scheme
          %p
            To get a
            %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
            from this we proceed as follows: if the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Lie
                  %mo{:stretchy => "false"} (
                  %mi Spf
                  %msup
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Lie(Spf A^0(\mathbb{C}P^\infty))
            of the
            %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Lie
                  %mo{:stretchy => "false"} (
                  %mi Spf
                  %msup
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi i
                    %mn 0
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi i
                    %mn 0
                    %mo *
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  Lie(Spf A^0(\mathbb{C}P^\infty))
                  \\simeq
                  ker(i_0^*)/ker(i_0^*)^2
          %p
            is a free
            = succeed "-module," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A^0({*})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            and this gives an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spf
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Spf
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Spf(A^0(\mathbb{C}P^\infty)) \simeq Spf(A^0({*})[[t]])
          %p
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi A
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} A^0(\mathbb{C}P^\infty) A^0({*})[ [t] ]
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi i
                    %mn 0
                    %mo *
                %annotation{:encoding => "application/x-tex"} i_0^*
            “forgets the
            = succeed "-coordinate\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
          %p
            %strong Definition
            An
            %strong elliptic cohomology theory
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is
          %ul
            %li
              %p
                a commutative
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            %li
              %p
                an
                %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} /
                      %mi R
                    %annotation{:encoding => "application/x-tex"} E/R
            %li
              %p
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/weakly+periodic+cohomology+theory"} weakly periodic
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative
                %a.existingWikiWord{:href => "/nlab/show/even+cohomology+theory"} even
                %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mo •
                    %annotation{:encoding => "application/x-tex"} A^\bullet
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"}> isomorphism
                s
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi R
                    %annotation{:encoding => "application/x-tex"} A^0({*}) \simeq R
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi E
                          %mo{:stretchy => "false"} ^
                        %mo ≃
                        %mi Spf
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi A
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi ℂ
                        %msup
                          %mi P
                          %mn ∞
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \hat E \simeq Spf(A^0(\mathbb{C}P^\infty))
          %p So we have on one side
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ^
                        %mtd
                          %mover
                            %mo →
                            %mo ≃
                        %mtd
                          %mi Spf
                          %msup
                            %mi A
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mi ℂ
                          %msup
                            %mi P
                            %mn ∞
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi Spec
                          %mi R
                        %mtd
                          %mover
                            %mo →
                            %mo ≃
                        %mtd
                          %mi Spec
                          %msup
                            %mi A
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msub
                                %mi σ
                                %mn 0
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ^
                        %mtd
                          %mover
                            %mo →
                            %mo ≃
                        %mtd
                          %mi Spf
                          %msup
                            %mi A
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mi ℂ
                          %msup
                            %mi P
                            %mn ∞
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\hat E &amp;\stackrel{\simeq}{\to}&amp; Spf A^0(\mathbb{C}P^\infty)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  Spec R &amp;\stackrel{\simeq}{\to}&amp;
                  Spec A^0({*})
                  \\\
                  \\downarrow^{\sigma_0} &amp;&amp; \downarrow
                  \\\
                  \\hat E &amp;\stackrel{\simeq}{\to}&amp; Spf A^0(\mathbb{C}P^\infty)
                  }
          %p
            We can check that the
            %a.existingWikiWord{:href => "/nlab/show/Landweber+exactness+criterion"} Landweber exactness criterion
            is satisfied for the
            %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Jacobi+quartic"} Jacobi quartic
            %span.newWikiWord
              Euler's formal group law
              %a{:href => "/nlab/new/Euler%27s+formal+group+law"} ?
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi ϵ
                    %mo ,
                    %mi δ
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[\Delta^{-1}, \epsilon, \delta, 1/2]
            %a.existingWikiWord{:href => "/nlab/show/elliptic+cohomology"} elliptic cohomology
            theory.
