          %h2#statement Statement
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            an
            %a.existingWikiWord{:href => "/nlab/show/integer"} integer
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≢
                    %mn 0
                    %mrow
                      %mo{:lspace => "mediummathspace"} (
                      %mo{:rspace => "thinmathspace"} mod
                      %mi p
                      %mo{:rspace => "mediummathspace"} )
                  %annotation{:encoding => "application/x-tex"} x \nequiv 0 \pmod{p}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %mo ≡
                    %mn 1
                    %mrow
                      %mo{:lspace => "mediummathspace"} (
                      %mo{:rspace => "thinmathspace"} mod
                      %mi p
                      %mo{:rspace => "mediummathspace"} )
                  %annotation{:encoding => "application/x-tex"} x^{p-1} \equiv 1 \pmod{p}
          %p
            This useful result is in a sense trivial, since the
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/(p)
            is a finite
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
            %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            of
            %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p-1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mrow
                      %mi ord
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} x^{ord(G)} = 1
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            in a
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi a
                    %mrow
                      %mi q
                      %mo −
                      %mn 1
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} a^{q-1} = 1
            for any nonzero
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            in a finite field with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            elements.
          %h2#refinements Refinements
          %p
            A stronger result is that the group of units of a finite field with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            elements is
            %em
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic
            of order
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} q-1
            = succeed "." do
              %a{:href => "/nlab/show/root#rootsunity"} here
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a commutative
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_p
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/associative+unital+algebra"} algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ↦
                  %msup
                    %mi a
                    %mi p
                %annotation{:encoding => "application/x-tex"} a \mapsto a^p
            is an algebra endomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \sigma: A \to A
            (the preservation of addition follows easily from the
            %a.existingWikiWord{:href => "/nlab/show/binomial+theorem"} binomial theorem
            and the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mi p
                      %mi k
                    %mo )
                  %mo ≡
                  %mn 0
                  %mrow
                    %mo{:lspace => "mediummathspace"} (
                    %mo{:rspace => "thinmathspace"} mod
                    %mi p
                    %mo{:rspace => "mediummathspace"} )
                %annotation{:encoding => "application/x-tex"} \binom{p}{k} \equiv 0 \pmod{p}
            when
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo &lt;
                    %mi k
                    %mo &lt;
                    %mi p
                  %annotation{:encoding => "application/x-tex"} 0 \lt k \lt p
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/freshman%27s+dream"} freshman's dream
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo :
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo →
                  %msub
                    %mi 𝔽
                    %mi q
                %annotation{:encoding => "application/x-tex"} \sigma: \mathbb{F}_q \to \mathbb{F}_q
            is a field
            %em automorphism
            on a field with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %msup
                    %mi p
                    %mi k
                %annotation{:encoding => "application/x-tex"} q = p^k
            elements, since after all
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi σ
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi a
                    %mrow
                      %msup
                        %mi p
                        %mi k
                  %mo =
                  %msup
                    %mi a
                    %mi q
                  %mo =
                  %msup
                    %mi a
                    %mrow
                      %mi q
                      %mo −
                      %mn 1
                  %mi a
                  %mo =
