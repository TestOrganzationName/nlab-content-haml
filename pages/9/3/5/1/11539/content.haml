          .num_theorem
            %h6#theorem Theorem
            %p
              %strong (Agrawal, Kayal, Saxena)
              For given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              be the least positive integer such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ord
                        %mi r
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo &gt;
                      %mo{:stretchy => "false"} (
                      %mi log
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} ord_r(n) \gt (log(n))^2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is prime if and only if either
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≤
                        %mi r
                      %annotation{:encoding => "application/x-tex"} n \leq r
                  and whenever
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 1
                          %mo ≤
                          %mi a
                          %mo ≤
                          %mi r
                        %annotation{:encoding => "application/x-tex"} 1 \leq a \leq r
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo =
                        %mi gcd
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} 1 = \gcd(a, n)
                  or
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo =
                          %mi gcd
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi n
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} n = \gcd(a, n)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo &lt;
                        %mi n
                      %annotation{:encoding => "application/x-tex"} r \lt n
                  and whenever
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  is an integer such that
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 1
                          %mo ≤
                          %mi a
                          %mo ≤
                          %msqrt
                            %mrow
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi r
                              %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi log
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} 1 \leq a \leq \sqrt{\phi(r)} \cdot log(n)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo −
                        %mi a
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi n
                        %mo ≡
                        %msup
                          %mi x
                          %mi n
                        %mo −
                        %mi a
                        %mrow
                          %mo{:lspace => "mediummathspace"} (
                          %mo{:rspace => "thinmathspace"} mod
                          %mrow
                            %msup
                              %mi x
                              %mi r
                            %mo −
                            %mn 1
                            %mo ,
                            %mi n
                          %mo{:rspace => "mediummathspace"} )
                        %mo .
                      %annotation{:encoding => "application/x-tex"} (x - a)^n \equiv x^n - a \pmod{x^r - 1, n}.
          %p
            From this result, one can extract an algorithm that decides primality of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            in time bounded by a polynomial in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi log
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} log(n)
          .num_lemma
            %h6#lemma_2 Lemma
            %p
              For each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≤
                    %mi max
                    %mo{:stretchy => "false"} {
                    %mn 3
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi log
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 5
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} r \leq \max \{3, (log(n))^5\}
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ord
                        %mi r
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo &gt;
                      %mo{:stretchy => "false"} (
                      %mi log
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} ord_r(n) \gt (log(n))^2
          %p
            These results form the basis for the first algorithm for deciding primality that is general (applies to any integer
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Riemann+hypothesis"} Riemann hypothesis
