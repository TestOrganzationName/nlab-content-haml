          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Fermat+quotient"} Fermat quotient
          %h2#references References
          %p
            Named after
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Pierre+de+Fermat"} Pierre de Fermat
          %ul
            %li
              Manindra Agrawal, Neeraj Kayal, and Nitin Saxena,
              = succeed "," do
                %em PRIMES is in P
              = succeed ")" do
                %a{:href => "http://www.cse.iitk.ac.in/users/manindra/algebra/primality_v6.pdf"} pdf
