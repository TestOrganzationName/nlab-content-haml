                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∃
                                  %mover
                                    %mi f
                                    %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                            %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\hookrightarrow &amp; X
                    \\\
                    {}^{\mathllap{f}}\downarrow &amp; \swarrow_{\mathrlap{\exists \hat f} }
                    \\\
                    \\mathbb{R}
                    }
            %p
              Therefore one also says that
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                is an
                %a.existingWikiWord{:href => "/nlab/show/absolute+extensor"} absolute extensor
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topology"} topology
          .proof
            %h6#proof Proof
            %p
              We produce a
              %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              of approximations to the desired extension by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequence"} Cauchy sequence
              and conclude by observing that this implies that its
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              is an extension of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              as desired.
            %p For the induction step, let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\hat f_n \;\colon\; X \longrightarrow \mathbb{R}
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              such that the difference of its restriction to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bounded+function"} bounded function
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi n
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} c_n \in (0,\infty) \subset \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi a
                        %mo ∈
                        %mi A
                    %mrow
                      %mo (
                      %mrow
                        %mo ‖
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo −
                        %msub
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ^
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ‖
                      %mo ≤
                      %msub
                        %mi c
                        %mi n
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{a \in A}{\forall}
                    \\left(
                    { \left\Vert f(a) - \hat f_n (a) \right\Vert } \leq c_n
                    \\right)
                    \\,.
            %p
              Consider then the
              %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
              subsets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo −
                    %mo ≔
                    %msup
                      %mrow
                        %mo (
                        %mi f
                        %mo −
                        %msub
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ^
                          %mi n
                        %msub
                          %mo{:stretchy => "false"} |
                          %mi A
                        %mo )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi c
                      %mi n
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi c
                      %mi n
                    %mo{:stretchy => "false"} /
                    %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mphantom
                      %mi AAAA
                    %msub
                      %mi S
                      %mo +
                    %mo ≔
                    %msup
                      %mrow
                        %mo (
                        %mi f
                        %mo −
                        %msub
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ^
                          %mi n
                        %msub
                          %mo{:stretchy => "false"} |
                          %mi A
                        %mo )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mi n
                    %mo{:stretchy => "false"} /
                    %mn 3
                    %mo ,
                    %msub
                      %mi c
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S_- \coloneqq \left( f - \hat f_n\vert_A \right)^{-1}\big( [-c_n, -c_n/3] \big)
                    \\phantom{AAAA}
                    S_+ \coloneqq \left( f - \hat f_n\vert_A \right)^{-1}\big( [c_n/3, c_n] \big)
                    \\,.
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/closed+intervals"} closed intervals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi c
                      %mi n
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi c
                      %mi n
                    %mo{:stretchy => "false"} /
                    %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mi n
                    %mo{:stretchy => "false"} /
                    %mn 3
                    %mo ,
                    %msub
                      %mi c
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} [-c_n,-c_n/3], [c_n/3, c_n] \subset \mathbb{R}
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo −
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi A
                  %annotation{:encoding => "application/x-tex"} f - \hat f_n\vert_A
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subsets+are+closed+in+a+closed+subspace+precisely+if+they+are+closed+in+the+ambient+space"} subsets are closed in a closed subspace precisely if they are closed in the ambient space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Therefore, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/normal+topological+space"} normal
              by assumption, it follows with
              %a.existingWikiWord{:href => "/nlab/show/Urysohn%27s+lemma"} Urysohn's lemma
              that there is a continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \;\colon\; X \longrightarrow \mathbb{R}
            %p with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mrow
                      %mo (
                      %mn 0
                      %mo ≤
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mn 1
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{x \in X}{\forall} \left( 0 \leq \phi(x) \leq 1 \right)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi S
                          %mo +
                    %mo =
                    %mn 1
                    %mphantom
                      %mi AAAA
                    %mi ϕ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi S
                          %mo −
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi\vert_{S_+} = 1
                    \\phantom{AAAA}
                    \\phi\vert_{S_-} = 0
                    \\,.
            %p Consider then the continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %mn 2
                          %msub
                            %mi c
                            %mi n
                        %mn 3
                    %mi ϕ
                    %mo −
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %msub
                            %mi c
                            %mi n
                        %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    g_{n+1}
                    \\;\coloneqq\;
                    \\tfrac{2 c_n}{3} \phi
                    \-
                    \\tfrac{c_n}{3}
            %p This now satisfies
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi S
                          %mo +
                    %mo =
                    %mfrac
                      %mrow
                        %msub
                          %mi c
                          %mi n
                      %mn 3
                    %mphantom
                      %mi AAAA
                    %msub
                      %mi g
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi S
                          %mo −
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mfrac
                      %mrow
                        %msub
                          %mi c
                          %mi n
                      %mn 3
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g_{n+1}\vert_{S_+} = \frac{c_n}{3}
                    \\phantom{AAAA}
                    g_{n+1}\vert_{S_-} = -\frac{c_n}{3}
                    \\,.
            %p with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mrow
                      %mo (
                      %mrow
                        %mo ‖
                        %msub
                          %mi g
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ‖
                      %mo ≤
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %msub
                              %mi c
                              %mi n
                          %mn 3
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{x \in X}{\forall} \left(
                    \\left \Vert g_{n+1} (x) \right\Vert
                    \\leq
                    \\tfrac{c_n}{3}
                    \\right)
                    \\,.
            %p Moreover, observe that this function satisfies
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi a
                        %mo ∈
                        %mi A
                    %mrow
                      %mo (
                      %mrow
                        %mo ‖
                        %mi f
                        %mo −
                        %msub
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ^
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo −
                        %msub
                          %mi g
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ‖
                      %mo ≤
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %mn 2
                            %msub
                              %mi c
                              %mi n
                          %mn 3
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{a \in A}{\forall}
                    \\left(
                    \\left\Vert f - \hat f_n(a) - g_{n+1}(a)  \right\Vert
                    \\leq \tfrac{2 c_n}{3}
                    \\right)
                    \\,.
            %p To wit, this is because
            %ol
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %msub
                          %mi S
                          %mo +
                      %annotation{:encoding => "application/x-tex"} a \in S_+
                  we have
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %msub
                                %mi c
                                %mi n
                            %mn 3
                      %annotation{:encoding => "application/x-tex"} g_{n+1}(a) = \tfrac{c_n}{3}
                  and
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo −
                          %msub
                            %mover
                              %mi f
                              %mo{:stretchy => "false"} ^
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi c
                            %mi n
                          %mo{:stretchy => "false"} /
                          %mn 3
                          %mo ,
                          %msub
                            %mi c
                            %mi n
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} f(a) - \hat f_{n}(a) \in [c_n/3,c_n]
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %msub
                          %mi S
                          %mo −
                      %annotation{:encoding => "application/x-tex"} a \in S_-
                  we have
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %msub
                                %mi c
                                %mi n
                            %mn 3
                      %annotation{:encoding => "application/x-tex"} g_{n+1}(a) = -\tfrac{c_n}{3}
                  and
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo −
                          %msub
                            %mover
                              %mi f
                              %mo{:stretchy => "false"} ^
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mo{:stretchy => "false"} [
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mi c
                            %mi n
                          %mo{:stretchy => "false"} /
                          %mn 3
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mi c
                            %mi n
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} f(a) - \hat f_{n}(a) \in [-c_n/3,-c_n]
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %mi Y
                        %mo ∖
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi S
                          %mo +
                        %mo ∪
                        %msub
                          %mi S
                          %mo −
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} a \in Y \setminus \{S_+ \cup S_-\}
                  we have
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mi c
                          %mi n
                        %mo{:stretchy => "false"} /
                        %mn 3
                        %mo ,
                        %msub
                          %mi c
                          %mi n
                        %mo{:stretchy => "false"} /
                        %mn 3
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} g(a) \in [-c_n/3,c_n/3]
                  as well as
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo −
                          %msub
                            %mover
                              %mi f
                              %mo{:stretchy => "false"} ^
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mo{:stretchy => "false"} [
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mi c
                            %mi n
                          %mo{:stretchy => "false"} /
                          %mn 3
                          %mo ,
                          %msub
                            %mi c
                            %mi n
                          %mo{:stretchy => "false"} /
                          %mn 3
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} f(a) - \hat f_{n}(a) \in [-c_n/3, c_n/3]
            %p It follows that if we set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ≔
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo +
                    %msub
                      %mi g
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\hat f_{n+1} \coloneqq \hat f_n + g_{n+1}
            %p then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi a
                        %mo ∈
                        %mi A
                    %mrow
                      %mo (
                      %mrow
                        %mo ‖
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo −
                        %msub
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ^
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ‖
                      %mo ≤
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %mn 2
                            %msub
                              %mi c
                              %mi n
                          %mn 3
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{a \in A}{\forall}
                    \\left(
                    { \left\Vert f(a) - \hat f_{n+1}(a) \right\Vert }
                    \\leq
                    \\tfrac{2 c_n}{3}
                    \\right)
                    \\,.
            %p This gives the induction step.
            %p
              To start the induction, first assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is bounded by a constant
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} c_0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 0
                    %mo ≔
                    %msub
                      %mi const
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hat f_0 \coloneqq const_0
                    \\,.
            %p
              Hence
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              now gives a
              %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              of continuous functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    (\hat f_n)_{n \in \mathbb{N}}
            %p with the property that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi a
                        %mo ∈
                        %mi A
                    %mrow
                      %mo (
                      %mrow
                        %mo ‖
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo −
                        %msub
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ^
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ‖
                      %mo ≤
                      %msup
                        %mrow
                          %mo (
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 2
                              %mn 3
                          %mo )
                        %mi n
                      %msub
                        %mi c
                        %mn 0
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{a \in A}{\forall}
                    \\left(
                    \\left\Vert f(a) -\hat f_n(a) \right\Vert
                    \\leq \left( \tfrac{2}{3}\right)^n c_0
                    \\right)
                    \\,.
            %p
              Moreover, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n_1, n_2 \in \mathbb{N}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 2
                    %mo ≥
                    %msub
                      %mi n
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} n_2 \geq n_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %msub
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ^
                                %mrow
                                  %msub
                                    %mi n
                                    %mn 2
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo −
                              %msub
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ^
                                %mrow
                                  %msub
                                    %mi n
                                    %mn 1
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ‖
                          %mtd
                            %mo =
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %msub
                                %mi g
                                %mrow
                                  %msub
                                    %mi n
                                    %mn 1
                                  %mo +
                                  %mn 1
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo +
                              %msub
                                %mi g
                                %mrow
                                  %msub
                                    %mi n
                                    %mn 1
                                  %mo +
                                  %mn 2
                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
                              %mo +
                              %mi ⋯
                              %mo +
                              %msub
                                %mi g
                                %mrow
                                  %msub
                                    %mi n
                                    %mn 2
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ‖
                        %mtr
                          %mtd
                          %mtd
                            %mo ≤
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi k
                                %mo =
                                %msub
                                  %mi n
                                  %mn 1
                                %mo +
                                %mn 1
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %msup
                                    %mn 3
                                    %mi k
                            %msub
                              %mi c
                              %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo ≤
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi k
                                %mo =
                                %msub
                                  %mi n
                                  %mn 1
                                %mo +
                                %mn 1
                              %mn ∞
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %msup
                                    %mn 3
                                    %mi k
                            %msub
                              %mi c
                              %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    {\Vert \hat f_{n_2}(x) - \hat f_{n_1}(x) \Vert}
                    \&amp; =
                    {\Vert g_{n_1 + 1}(x) + g_{n_1 + 2}(c) + \cdots + g_{n_2}(x) \Vert}
                    \\\
                    \&amp; \leq
                    \\underoverset{k = n_1+1}{n_2}{\sum}
                    \\tfrac{1}{3^{k}} c_0
                    \\\
                    \&amp; \leq
                    \\underoverset{k = n_1+1}{\infty}{\sum}
                    \\tfrac{1}{3^{k}} c_0
                    \\end{aligned}
            %p
              That the
              %a.existingWikiWord{:href => "/nlab/show/geometric+series"} geometric series
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mn ∞
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %msup
                      %mn 3
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \sum_{k = 0}^\infty 1/3^k
              %a.existingWikiWord{:href => "/nlab/show/convergence+of+a+sequence"} converges
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mi n
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %msup
                      %mn 3
                      %mi k
                    %mover
                      %mo ⟶
                      %mrow
                        %mi n
                        %mo →
                        %mn ∞
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 1
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 3
                    %mo =
                    %mn 3
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\underoverset{k = 0}{n}{\sum} 1/3^k
                    \\overset{n \to \infty}{\longrightarrow}
                    \\frac{1}{1 - 1/3} = 3/2
            %p
              this becomes arbitrarily small for large
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} n_1
            %p
              This means that the sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} (\hat f_{n+1})_{n\in \mathbb{N}}
              is a
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequence"} Cauchy sequence
              in the
              %a.existingWikiWord{:href => "/nlab/show/supremum+norm"} supremum norm
              for real-valued functions.
            %p
              Since uniform Cauchy sequences of continuous functions with values in a
              %a.existingWikiWord{:href => "/nlab/show/complete+space"} complete
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              %a.existingWikiWord{:href => "/nlab/show/uniform+convergence"} converge uniformly
              to a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              (
              %a{:href => "uniform+convergence#FunctionsUniformCauchySequence"}> this prop.
              ) this implies that the sequence
              %a.existingWikiWord{:href => "/nlab/show/uniform+convergence"} converges uniformly
              to a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            %p
              Finally consider the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is not a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bounded+function"} bounded function
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mn 1
                    %mover
                      %mo →
                      %mo ≃
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %msub
                      %mi c
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi \colon \mathbb{R}^1 \overset{\simeq}{\to} (-c_0,c_0) \subset \mathbb{R}^1
              between the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              and an
              %a.existingWikiWord{:href => "/nlab/show/open+interval"} open interval
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \phi \circ f
              is a continous function bounded by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} c_0
              and hence the above argument gives an extension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mi ϕ
                          %mo ∘
                          %mi f
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat {\phi \circ f}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %mover
                      %mrow
                        %mi ϕ
                        %mo ∘
                        %mi f
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \phi^{-1} \circ \widehat{ \phi \circ f }
              is an extension of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          %h3#Manifolds For smooth functions
          %p
            See
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Whitney+extension+theorem"} Whitney extension theorem
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Steenrod-Wockel+approximation+theorem"} Steenrod-Wockel approximation theorem
          %h3#for_smooth_loci For smooth loci
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕃
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mn ∞
                  %msup
                    %mi Ring
                    %mi fin
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                %annotation{:encoding => "application/x-tex"} \mathbb{L} = (C^\infty Ring^{fin})^{op}
            be the category of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+loci"} smooth loci
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of finitely generated
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/generalized+smooth+algebra"} generalized smooth algebra
            %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
            %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ↪
                    %mi 𝕃
                  %annotation{:encoding => "application/x-tex"} \hookrightarrow \mathbb{L}
          .num_defn
            %h6#definition Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi J
                  %annotation{:encoding => "application/x-tex"} A = C^\infty(\mathbb{R}^n)/J
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi I
                  %annotation{:encoding => "application/x-tex"} B = C^\infty(\mathbb{R}^n)/I
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊂
                    %mi J
                  %annotation{:encoding => "application/x-tex"} I \subset J
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} B \to A
              the projection of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/generalized+smooth+algebra"} generalized smooth algebra
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mi A
                    %mo →
                    %mi ℓ
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \ell A \to \ell B
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕃
                  %annotation{:encoding => "application/x-tex"} \mathbb{L}
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \ell A
              as a
              %strong closed smooth sublocus
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℓ
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \ell B
          .num_lemma
            %h6#lemma Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi g
                      %mi i
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msubsup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{g_i \in C^\infty(X)\}_{i = 1}^n
              be
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x\in X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi i
                    %mo :
                    %msub
                      %mi g
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \forall i : g_i(x)= 0
              we have the
              %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msub
                      %mi g
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi T
                      %mi x
                    %mi X
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} (d g_i) : T_x X \to \mathbb{R}^n
              is a surjection, then the ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi g
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g_1, \cdots, g_n)
              coincides with the ideal of functions that vanish on the zero-set of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mi i
                    %annotation{:encoding => "application/x-tex"} g_i
          %p
            This is lemma 2.1 in Chapter I of (
            %a{:href => "#MoerdijkReyes"}> MoerdijkReyes
            ).
          .num_prop
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mi A
                    %mo ↪
                    %mi ℓ
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \ell A \hookrightarrow \ell B
              is a closed sublocus of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \ell B
              then every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mi A
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \ell A \to R
              extends to a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mi B
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \ell B \to R
          %p
            This is prop. 1.6 in Chapter II of (
            %a{:href => "#MoerdijkReyes"}> MoerdijkReyes
            ).
          .proof
            %h6#proof_2 Proof
            %p
              Since we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi ℓ
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R = \ell C^\infty(\mathbb{R})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R})
              is the free
              %a.existingWikiWord{:href => "/nlab/show/generalized+smooth+algebra"} generalized smooth algebra
              on a single generator, a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mi A
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \ell A \to R
              is precisely an element of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi J
                    %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^n)/J
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^n)
              which in particular defines an element in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi I
                    %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^n)/I
