          .num_theorem
            %h6#theorem Theorem
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/normal+topological+space"} normal topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \subset X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f \colon A \to \mathbb{R}
              to the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              (with its
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \hat f \colon X \to \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/extension"} extending
              it, i.e. such that
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
