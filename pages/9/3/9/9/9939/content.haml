                  %mo ≔
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Σ
                    %mo •
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [X,Y]_\bullet \coloneqq [\Sigma^\bullet X,Y]
            for the corresponding
            %a.existingWikiWord{:href => "/nlab/show/graded+abelian+group"} graded abelian group
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#GradedAbelianGroupStructureOnHomsInTheHomotopyCategory"}> def.
            ).
          #EAcyclicAndLocalSpectra.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E \in Ho(Spectra)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            %ol
              %li
                %p
                  a spectrum
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                    \-acyclic
                  if the
                  %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                          %mo ∧
                          %mi X
                          %mo ≃
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} E \wedge X \simeq 0
              %li
                %p
                  a morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f \colon X \to Y
                  of spectra is an
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                    \-equivalence
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo ∧
                        %mi f
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi E
                        %mo ∧
                        %mi X
                        %mo →
                        %mi E
                        %mo ∧
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} E \wedge f \;\colon\; E \wedge X \to E \wedge Y
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Ho
                          %mo{:stretchy => "false"} (
                          %mi Spectra
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Ho(Spectra)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E_\bullet(f)
                  is an isomorphism in
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
              %li
                %p
                  a spectrum
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                    \-local
                  if the following equivalent conditions hold
                %ol
                  %li
                    %p
                      for every
                      = succeed "-equivalence" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi E
                            %annotation{:encoding => "application/x-tex"} E
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi f
                          %annotation{:encoding => "application/x-tex"} f
                      then
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi f
                            %mo ,
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo •
                          %annotation{:encoding => "application/x-tex"} [f,X]_\bullet
                      is an isomorphism;
                  %li
                    %p
                      every
                      %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Y
                            %mo ⟶
                            %mi X
                          %annotation{:encoding => "application/x-tex"} Y \longrightarrow X
                      out of an
                      = succeed "-acyclic" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi E
                            %annotation{:encoding => "application/x-tex"} E
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Y
                          %annotation{:encoding => "application/x-tex"} Y
                      is
                      %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero
                      in
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi Ho
                              %mo{:stretchy => "false"} (
                              %mi Spectra
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} Ho(Spectra)
          %p
            (
            %a{:href => "#Bousfield79"}> Bousfield 79, §1
            ) see also for instance (
            %a{:href => "#Lurie10"}> Lurie, Lecture 20, example 4
            )
          #TwoConditionsOnELocalSpectrumAreEquivalent.num_lemma
            %h6#lemma Lemma
            %p
              The two conditions in the last item of def.
              %a.maruku-ref{:href => "#EAcyclicAndLocalSpectra"}
              are indeed equivalent.
          .proof
            %h6#proof Proof
            %p
              Notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Ho(Spectra)
              being
              = succeed "-acyclic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ⟶
                    %mi A
                  %annotation{:encoding => "application/x-tex"} 0 \longrightarrow A
              is an
              = succeed "-equivalence." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p
              Hence one direction of the claim is trivial. For the other direction we need to show that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"} [-,X]_\bullet
              to give an isomorphism on all
              = succeed "-equivalences" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              = succeed "-equivalences" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} 0 \to A
            %p
              Given a morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f \colon A \to B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ⟶
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} B \longrightarrow B/A
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              is a
              %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyCategoryIsTriangulated"}> prop.
              ) the defining axioms of triangulated categories (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#CategoryWithCofiberSequences"}> def.
              ,
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#TrianglesMayBeShiftedToTheLeft"} lemma
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
