                              %mo{:stretchy => "false"} ]
                              %mo •
                          %mtd
                            %mo ⟵
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi B
                            %mo ,
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo •
                          %mtd
                            %mo ⟵
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi B
                            %mo{:stretchy => "false"} /
                            %mi A
                            %mo ,
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo •
                          %mtd
                            %mo ⟵
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi A
                            %mo ,
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mo •
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    0
                    \&amp;\longleftarrow&amp;
                    [A,X]_\bullet
                    \&amp;\longleftarrow&amp;
                    [A,X]_\bullet
                    \&amp;\longleftarrow&amp;
                    0
                    \&amp;\longleftarrow&amp;
                    [A,X]_{\bullet+1}
                    \\\
                    \\uparrow
                    \&amp;&amp;
                    \\uparrow^{\mathrlap{id}}
                    \&amp;&amp;
                    \\uparrow^{\mathrlap{[f,X]_\bullet}}
                    \&amp;&amp;
                    \\uparrow
                    \&amp;&amp;
                    \\uparrow^{\mathrlap{id}}
                    \\\
                    [B/A,X]_{\bullet+1}
                    \&amp;\longleftarrow&amp;
                    [A,X]_\bullet
                    \&amp;\longleftarrow&amp;
                    [B,X]_\bullet
                    \&amp;\longleftarrow&amp;
                    [B/A,X]_\bullet
                    \&amp;\longleftarrow&amp;
                    [A,X]_{\bullet+1}
                    }
                    \\,,
            %p
              where now both horizontal sequences are
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences"} long exact sequences
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#LongFiberSequencesOfMapsOfSpectra"}> prop.
              ).
            %p
              Hence if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mo ⟶
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} [B/A,X]_\bullet \longrightarrow 0
              is an isomorphism, then all four outer vertical morphisms in this diagram are isomorphisms, and then the
              %a.existingWikiWord{:href => "/nlab/show/five-lemma"} five-lemma
              implies that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"} [f,X]_\bullet
              is an isomorphism.
            %p
              Hence it is now sufficient to observe that with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f \colon A \to B
              an
              = succeed "-equivalence," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} B/A
              is
              = succeed "-acyclic." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p
              To see this, notice that by the
              %a.existingWikiWord{:href => "/nlab/show/tensor+triangulated+category"} tensor triangulated
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#TensorTriangulatedStructureOnStableHomotopyCategory"}> prop.
              ) the
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              preserves homotopy cofiber sequences, so that there is a homotopy cofiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∧
                    %mi A
                    %mover
                      %mo ⟶
                      %mrow
                        %mi E
                        %mo ∧
                        %mi f
                    %mi E
                    %mo ∧
                    %mi B
                    %mo ⟶
                    %mi E
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi E
                    %mo ∧
                    %mi Σ
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E \wedge A
                    \\overset{E \wedge f}{\longrightarrow}
                    E \wedge B
                    \\longrightarrow
                    E \wedge (B/A)
                    \\longrightarrow
                    E \wedge \Sigma A
                    \\,.
            %p
              But if the first morphism here is an isomorphism, then the axioms of a
              %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#CategoryWithCofiberSequences"}> def.
              ) imply that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ∧
                      %mi B
                      %mo{:stretchy => "false"} /
                      %mi A
                      %mo ≃
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} E \wedge B / A \simeq 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                            %mo ∧
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi E
                                %mo ∧
                                %mi f
                          %mtd
                            %mi E
                            %mo ∧
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                            %mo ∧
                            %mi B
                            %mo{:stretchy => "false"} /
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                            %mo ∧
                            %mi Σ
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi E
                                  %mo ∧
                                  %mi f
                                  %msup
                                    %mo{:stretchy => "false"} )
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                        %mtr
                          %mtd
                            %mi E
                            %mo ∧
                            %mi A
                          %mtd
                            %munder
                              %mo ⟶
                              %mi id
                          %mtd
                            %mi E
                            %mo ∧
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mn 0
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                            %mo ∧
                            %mi Σ
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E \wedge A
                    \&amp;\overset{E \wedge f}{\longrightarrow}&amp;
                    E \wedge B
                    \&amp;\longrightarrow&amp;
                    E \wedge B/A
                    \&amp;\longrightarrow&amp;
                    E \wedge \Sigma A
                    \\\
                    \\downarrow^{\mathrlap{id}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{(E\wedge f)^{-1}}}
                    \&amp;&amp;
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{id}}
                    \\\
                    E \wedge A
                    \&amp;\underset{id}{\longrightarrow}&amp;
                    E \wedge A
                    \&amp;\longrightarrow&amp;
                    0
                    \&amp;\longrightarrow&amp;
                    E \wedge \Sigma A
                    }
                    \\,.
            %p
              Then since two of the three vertical morphisms on the left are isomorphisms, so is the third (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#TwoOutOfThreeForMorphismsOfDistinguishedTriangles"}> lemma
              ).
          #ELocalizationOfSpectra.num_defn
            %h6#definition_3 Definition
            %p
              Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ,
                      %mi X
                      %mo ∈
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi Spectra
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E,X \in Ho(Spectra)
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                \-localization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
            %ol
              %li
                %p
                  an
                  = succeed "-local" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mi E
                        %mi X
                      %annotation{:encoding => "application/x-tex"} L_E X
              %li
                %p
                  an
                  = succeed "-equivalence" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ⟶
                          %msub
                            %mi L
                            %mi E
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X \longrightarrow L_E X
            %p
              according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#EAcyclicAndLocalSpectra"}
          %p
            We discuss now that
            = succeed "-Localizations" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "," do
              %a.maruku-ref{:href => "#KappaCellSpectrumWitnessingELocalization"}
            = succeed "-local" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "-null," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          #KappaCellSpectrumWitnessingELocalization.num_lemma
            %h6#lemma_2 Lemma
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              there exists a spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              such that any spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed ")" do
                %a.maruku-ref{:href => "#EAcyclicAndLocalSpectra"}
              = succeed "-null," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mi is
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mtext -local
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    X \;is\; E\text{-local}
                    \\;\;\;\;
                    \\Leftrightarrow
                    \\;\;\;\;
                    [A,X]_\ast = 0
            %p and such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is
                  = succeed "-acyclic" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  = succeed ");" do
                    %a.maruku-ref{:href => "#EAcyclicAndLocalSpectra"}
              %li
                %p
                  there exists an infinite
                  %a.existingWikiWord{:href => "/nlab/show/cardinal+number"} cardinal number
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi κ
                      %annotation{:encoding => "application/x-tex"} \kappa
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  %a.existingWikiWord{:href => "/nlab/show/CW+spectrum"} CW spectrum
                  (hence a
                  %a.existingWikiWord{:href => "/nlab/show/CW+spectrum"} CW spectrum
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#CWSpectrum"}> def.
                  ) with at most
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi κ
                      %annotation{:encoding => "application/x-tex"} \kappa
                  many cells);
              %li
                %p
                  the class of
                  = succeed "-acyclic" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  = succeed ")" do
                    %a.maruku-ref{:href => "#EAcyclicAndLocalSpectra"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  under
                %ol
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                  %li
                    %p
                      the relation that if in a
                      %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequence"} homotopy cofiber sequence
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi X
                              %mn 1
                            %mo →
                            %msub
                              %mi X
                              %mn 2
                            %mo →
                            %msub
                              %mi X
                              %mn 3
                          %annotation{:encoding => "application/x-tex"} X_1 \to X_2 \to X_3
                      two of the spectra are in the class, then so is the third.
          %p
            (
            %a{:href => "#Bousfield79"}> Bousfield 79, lemma 1.13 with lemma 1.14
            ) review includes (
            %a{:href => "Bauer11"}> Bauer 11, p.2,3
            ,
            = succeed ")" do
              %a{:href => "#VanKoughnett13"} VanKoughnett 13, p. 8
          #ELocalizationCofiber.num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E \in Ho(Spectra)
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              sits in a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequence"} homotopy cofiber sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi η
                          %mi X
                    %msub
                      %mi L
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    G_E(X)
                    \\longrightarrow
                    X
                    \\overset{\eta_X}{\longrightarrow}
                    L_E(X)
                    \\,,
            %p
              and
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G_E(X)
                  is
                  = succeed "-acyclic," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} L_E(X)
                  is
                  = succeed "-local," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
            %p
              according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#EAcyclicAndLocalSpectra"}
          %p
            (
            %a{:href => "#Bousfield79"}> Bousfield 79, theorem 1.1
            ) see also for instance (
            %a{:href => "#Lurie10"}> Lurie, Lecture 20, example 4
            )
          .proof
            %h6#proof_2 Proof
            %p
              Consider the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-spectrum
              spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              whose existence is asserted by lemma
              = succeed "." do
                %a.maruku-ref{:href => "#KappaCellSpectrumWitnessingELocalization"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi A
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi A
                    %mo →
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    I_A
                    \\coloneqq
                    \\{A \to Cone(A)\}
            %p
              denote the set containing as its single element the canonical morphism (of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              into the standard
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi cofib
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %mi A
                    %mo ∧
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi A
                    %mo ∧
                    %mi I
                  %annotation{:encoding => "application/x-tex"}
                    Cone(A)
                    \\coloneqq
                    cofib( A \to A \wedge I_+ )
                    \\simeq
                    A \wedge I
            %p
              of the inclusion of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              into its standard
              %a.existingWikiWord{:href => "/nlab/show/cylinder+spectrum"} cylinder spectrum
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StandardCylinderSpectrumSequential"}> def.
              ).
            %p
              Since the standard cylinder spectrum on a CW-spectrum is a
              %a.existingWikiWord{:href => "/nlab/show/good+cylinder+object"} good cylinder object
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#CylinderSpectrumOverCWSpectrumIsGood"}> prop.
              ) this means (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomsOutOfCofibrantIntoFibrantComputeHomotopyCategory"}> lemma
              ) that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any fibrant sequential spectrum, and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \longrightarrow X
              any morphism, then an extension along the cone inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                            %mi Cone
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\longrightarrow&amp; X
                    \\\
                    \\downarrow &amp; \nearrow
                    \\\
                    Cone(A)
                    }
            %p
              equivalently exhibits a null-homotopy of the top morphism. Hence the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo →
                      %mi Cone
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A \to Cone(A))
              %a.existingWikiWord{:href => "/nlab/show/injective+objects"} injective objects
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              are precisely those spectra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              for which
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi A
                      %mo ,
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mo •
                      %mo ≃
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} [A,X]_\bullet \simeq 0
            %p
              Moreover, due to the degreewise nature of the smash tensoring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                    %mo ∧
                    %mi I
                  %annotation{:encoding => "application/x-tex"} Cone(A) = A \wedge I
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#TensoringAndPoweringOfSequentialSpectra"}> def
              ), the inclusion morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \to Cone(A)
              is degreewise the inclusion of a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              into its standard cone, which is a
              %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              inclusion (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopologicalCylinderOnCWComplexIsGoodCylinderObject"}> prop.
              ).
            %p
              By
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#kappaCellSpectrumIsKappaSmall"} this lemma
              the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %a.existingWikiWord{:href => "/nlab/show/cell+spectrum"} cell spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
                \-small object
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ClassOfMorphismsWithSmallDomains"}> def.
              ) with respect to morphisms of spectra which are degreewise
              %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              inclusion
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              \.
            %p
              Hence the
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              applies (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#SmallObjectArgument"}> prop.
              ) and gives for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a factorization of the terminal morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \to \ast
              as an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi A
                    %annotation{:encoding => "application/x-tex"} I_A
              %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopologicalCCellComplex"}> def.
              ) followed by an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi A
                    %annotation{:encoding => "application/x-tex"} I_A
              %a.existingWikiWord{:href => "/nlab/show/injective+morphism"} injective morphism
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#RightLiftingProperty"}> def.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi I
                          %mi A
                        %mi Cell
                    %msub
                      %mi L
                      %mi E
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi I
                          %mi A
                        %mi Inj
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X
                    \\overset{I_A Cell}{\longrightarrow}
                    L_E X
                    \\overset{I_A Inj}{\longrightarrow}
                    \\ast
                    \\,.
            %p
              By the above, this means that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi A
                      %mo ,
                      %msub
                        %mi L
                        %mi E
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} [A, L_E X] = 0
              %a.maruku-ref{:href => "#KappaCellSpectrumWitnessingELocalization"}
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi E
                    %mi X
                  %annotation{:encoding => "application/x-tex"} L_E X
              is
              = succeed "-local." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p
              It remains to see that the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi L
                      %mi E
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \to L_E X
              is
              = succeed "-acyclic:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/tensor+triangulated+category"} tensor triangulated
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#TensorTriangulatedStructureOnStableHomotopyCategory"}> prop.
              ) it is sufficient to show that the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              is
              = succeed "-acyclic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              is the transfinite composition of a sequence of homotopy pushouts. By lemma
              %a.maruku-ref{:href => "#KappaCellSpectrumWitnessingELocalization"}
              and applying the pasting law again, all these homotopy pushouts produce
              = succeed "-acyclic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "-acyclic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "-acyclic." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "-spheres" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ")." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#CompactSubsetsAreSmallInCellComplexes"} lemma
          .num_lemma
            %h6#lemma_3 Lemma
            %p
              The morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi L
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to L_E (X)
              in prop.
              %a.maruku-ref{:href => "#ELocalizationCofiber"}
              exhibits an
              = succeed "-localization" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              according to def.
              %a.maruku-ref{:href => "#ELocalizationOfSpectra"}
          .proof
            %h6#proof_3 Proof
            %p
              It only remains to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi L
                      %mi E
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \to L_E X
              is an
              = succeed "-equivalence." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/tensor+triangulated+category"} tensor triangulated
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#TensorTriangulatedStructureOnStableHomotopyCategory"}> prop.
              ) the
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              preserves homotopy cofiber sequences, so that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∧
                    %msub
                      %mi G
                      %mi E
                    %mi X
                    %mo ⟶
                    %mi E
                    %mo ∧
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mi E
                        %mo ∧
                        %msub
                          %mi η
                          %mi X
                    %mi E
                    %mo ∧
                    %msub
                      %mi L
                      %mi E
                    %mi X
                    %mo ⟶
                    %mi E
                    %mo ∧
                    %mi Σ
                    %msub
                      %mi G
                      %mi E
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    E \wedge G_E X
                    \\longrightarrow
                    E \wedge X
                    \\overset{E \wedge \eta_X}{\longrightarrow}
                    E \wedge L_E X
                    \\longrightarrow
                    E \wedge \Sigma G_E X
            %p
              is also a homotopy cofiber sequence. But now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∧
                    %msub
                      %mi G
                      %mi E
                    %mi X
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} E \wedge G_E X \simeq 0
              by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ELocalizationCofiber"}
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#CategoryWithCofiberSequences"} def.
              %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyCategoryIsTriangulated"}> prop.
              ) imply that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∧
                    %mi η
                  %annotation{:encoding => "application/x-tex"} E \wedge \eta
              is an isomorphism.
          #Acyclification.num_remark
            %h6#remark Remark
            %p
              Hence where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi E
                  %annotation{:encoding => "application/x-tex"} L_E
              is traditionally called “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              \-localization”,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi E
                  %annotation{:encoding => "application/x-tex"} G_E
              might be called “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              \-acyclification”, though that terminology is not used commonly.
          %h2#properties Properties
          %h3#localization_at_moore_spectra_of_abelian_groups Localization at Moore spectra of abelian groups
          %p
            A basic special case of
            = succeed "-localization" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi S
                  %mi A
                %annotation{:encoding => "application/x-tex"} E = S A
            the
            %a.existingWikiWord{:href => "/nlab/show/Moore+spectrum"} Moore spectrum
            of an
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (
            %a{:href => "#Bousfield79"}> Bousfield 79, section 2
            ). For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %msub
                    %mi ℤ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A = \mathbb{Z}_{(p)}
            this is
            %a.existingWikiWord{:href => "/nlab/show/p-localization"} p-localization
            and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %msub
                    %mi 𝔽
                    %mi p
                %annotation{:encoding => "application/x-tex"} A = \mathbb{F}_p
            this is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/p-completion"} p-completion
            %a.maruku-ref{:href => "#pLocalization"}
            and
            %a.maruku-ref{:href => "#pCompletion"}
            below for more.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A_2
              two
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              then the following are equivalent
            %ol
              %li
                %p
                  the Bousfield localizations at their
                  %a.existingWikiWord{:href => "/nlab/show/Moore+spectra"} Moore spectra
                  are equivalent
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mrow
                            %mi S
                            %msub
                              %mi A
                              %mn 1
                        %mo ≃
                        %msub
                          %mi L
                          %mrow
                            %mi S
                            %msub
                              %mi A
                              %mn 2
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        L_{S A_1} \simeq L_{S A_2}
                        \\,;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} A_1
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} A_2
                  have the same
                  = succeed "," do
                    %em type of acyclicity
                %ol
                  %li
                    %p
                      every
                      %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
                      is invertible in
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi A
                              %mn 1
                          %annotation{:encoding => "application/x-tex"} A_1
                      precisely if it is in
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi A
                                %mn 2
                            %annotation{:encoding => "application/x-tex"} A_2
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi A
                              %mn 1
                          %annotation{:encoding => "application/x-tex"} A_1
                      is a
                      %a.existingWikiWord{:href => "/nlab/show/torsion+group"} torsion group
                      precisely if
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi A
                              %mn 2
                          %annotation{:encoding => "application/x-tex"} A_2
                      is.
          %p
            (
            %a{:href => "#Bousfield79"}> Bousfield 79, prop. 2.3
            ) recalled e.g. in (
            %a{:href => "#VanKoughnett13"}> VanKoughnett 13, prop. 4.2
            ).
          %p
            This means that given an abelian group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            then
          %ul
            %li
              %p
                either
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is not torsion, then
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mrow
                          %mi S
                          %mi A
                      %mo ≃
                      %msub
                        %mi L
                        %mrow
                          %mi S
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi I
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      L_{S A} \simeq L_{S \mathbb{Z}[I^{-1}]}
                      \\,,
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                is the set of primes invertible in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi I
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ↪
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[I^{-1}] \hookrightarrow \mathbb{Q}
                is the
                %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} localization
                at these primes of the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %li
              %p
                or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is torsion, then
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mrow
                          %mi S
                          %mi A
                      %mo ≃
                      %msub
                        %mi L
                        %mrow
                          %mi S
                          %mo{:stretchy => "false"} (
                          %msub
                            %mo ⊕
                            %mi q
                          %msub
                            %mi 𝔽
                            %mi q
                          %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      L_{S A }\simeq L_{S(\oplus_q \mathbb{F}_q )  }
                      \\,,
              %p
                where the
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                is over all
                %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
                of order
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi q
                      %annotation{:encoding => "application/x-tex"} q
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
                a prime not invertible in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
          %h3#relation_to_nilpotent_completion Relation to nilpotent completion
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be an
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be any
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
          #CanonicalMapFromELocalizationToTotalization.num_remark
            %h6#remark_2 Remark
            %p There is a canonical map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi E
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                    %msub
                      %munder
                        %mi lim
                        %mo ←
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                    %msub
                      %mo ∧
                      %mi S
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    L_E X \stackrel{}{\longrightarrow} \underset{\leftarrow}{\lim}_n (E^{\wedge^{n+1}_S}\wedge_S X)
            %p
              from the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+spectra"} Bousfield localization of spectra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              into the
              %a.existingWikiWord{:href => "/nlab/show/totalization"} totalization
              of the canonical
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
              (see at
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/nilpotent+completion"} nilpotent completion
          %p
            We now consider conditions for this morphism to be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
          #CoreOfARing.num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %em core
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mi R
                  %annotation{:encoding => "application/x-tex"} c R
              is the
              %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mi R
                    %mo ⟶
                    %mi R
                    %mover
                      %mo ⟶
                      %mo ⟶
                    %mi R
                    %mo ⊗
                    %mi R
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    c R
                    \\longrightarrow
                    R
                    \\stackrel{\longrightarrow}{\longrightarrow}
                    R \otimes R
                    \\,.
          #SufficientConditionsForTotalizationToBeELocalization.num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be a
              %a.existingWikiWord{:href => "/nlab/show/connective+spectrum"} connective
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              such that the core of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_0(E)
              = succeed "," do
                %a.maruku-ref{:href => "#CoreOfARing"}
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} localization
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/integers"} integers
                  at a set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
                  of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/primes"} primes
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi c
                          %msub
                            %mi π
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi J
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} c \pi_0(E) \simeq \mathbb{Z}[J^{-1}]
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_n
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ≥
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} n \geq 2
            %p
              Then the map in remark
              %a.maruku-ref{:href => "#CanonicalMapFromELocalizationToTotalization"}
              is an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi E
                    %mi X
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ←
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                    %msub
                      %mo ∧
                      %mi S
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L_E X \stackrel{\simeq}{\longrightarrow}
                    \\underset{\leftarrow}{\lim}_n (E^{\wedge^{n+1}_S}\wedge_S X)
                    \\,.
          %p
            (
            %a{:href => "#Bousfield79"}> Bousfield 79
            ) see also for instance (
            %a{:href => "#Bauer11"}> Bauer 11, p.2
            )
          %p
            For more discussion of
            %a.existingWikiWord{:href => "/nlab/show/E-infinity+geometry"} E-infinity
            (derived)
            %a.existingWikiWord{:href => "/nlab/show/formal+completions"} formal completions
            via totalizations of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Amitsur+complexes"} Amitsur complexes
            = succeed ")." do
              %a{:href => "completion+of+a+module#Carlsson07"} Carlsson 07
          %h3#fracture_theorem Fracture theorem
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/fracture+theorem"} fracture theorem
            says how Bousfield localization at a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
            of spectra is a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            of Bousfield localization separately. See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/fracture+theorem"} fracture theorem
            for more on this.
          %h2#examples Examples
          %h3#general General
          #EModulesAreELocal.num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-module"} ∞-module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is
              = succeed "-local," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %a.maruku-ref{:href => "#EAcyclicAndLocalSpectra"}
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Lurie10"} Lurie, Lecture 20, example 5
          .num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              an
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+algebra"} E-∞ algebra
              over an
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-module"} ∞-module
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                    %msub
                      %mo ∧
                      %mi S
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo ⟶
                    %mi Spectra
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^{\wedge_S^{\bullet+1}}\wedge_S X \;\colon\; \Delta \longrightarrow Spectra
                    \\,.
            %p
              By example
              %a.maruku-ref{:href => "#EModulesAreELocal"}
              each term is
              = succeed "-local," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/totalization"} totalization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %munder
                      %mi lim
                      %mo ←
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                    %msub
                      %mo ∧
                      %mi S
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \longrightarrow \underset{\leftarrow}{\lim} E^{\wedge_S^{\bullet+1}} \wedge_S X
            %p
              factors through the
              = succeed "-localization" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %msub
                      %mi L
                      %mi E
                    %mi X
                    %mo ⟶
                    %munder
                      %mi lim
                      %mo ←
                    %msup
                      %mi E
                      %mrow
                        %msubsup
                          %mo ∧
                          %mi S
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                    %msub
                      %mo ∧
                      %mi S
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \longrightarrow
                    L_E X
                    \\longrightarrow
                    \\underset{\leftarrow}{\lim} E^{\wedge_S^{\bullet+1}} \wedge_S X
                    \\,.
            %p
              Under suitable condition the second map here is indeed an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
              %a.existingWikiWord{:href => "/nlab/show/totalization"} totalization
              of the dual
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              exhibits the
              = succeed "-localization." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            %p
              (see also e.g.
              = succeed ")" do
                %a{:href => "#Bauer11"} Bauer 11, p. 2
          %h3#rationalization Rationalization
          #Rationalization.num_example
            %h6#example_3 Example
            %p
              Bousfield localization at the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Moore+spectrum"} Moore spectrum
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mi ℚ
                    %mo ≃
                    %mi H
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} S \mathbb{Q}\simeq H\mathbb{Q}
              of the
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              is
              %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            %p
              The corresponding
              = succeed "-acyclification" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              = succeed ")" do
                %a.maruku-ref{:href => "#Acyclification"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/torsion+approximation"} torsion approximation
          %p
            e.g. (
            %a{:href => "#Bauer11"}> Bauer 11, example 1.7
            )
          %h3#localization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            \-Localization
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            a
            %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
            write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_{(p)}
            for the
            %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} localization
            of the
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %em at
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p)
            %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} localized at
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %em except
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            inverted; equivalently the subring of the
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            with denominator not divisible by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          #pLocalization.num_example
            %h6#example_4 Example
            %p
              The Bousfield localization at the
              %a.existingWikiWord{:href => "/nlab/show/Moore+spectrum"} Moore spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %msub
                      %mi ℤ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \mathbb{Z}_{(p)}
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/p-localization"} p-localization
          %p
            (
            %a{:href => "#Bousfield79"}> Bousfield 79
            ),
            = succeed ")." do
              %a{:href => "#Bauer11"} Bauer 11, example 1.7
            %em
              %a.existingWikiWord{:href => "/nlab/show/localization+of+a+space"} localization of a space
            for details on this.
          #pLocalizationIsSmashing.num_prop
            %h6#proposition_4 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              \-localization is a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/smashing+localization"} smashing localization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mrow
                        %mi S
                        %msub
                          %mi ℤ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                    %mi X
                    %mo ≃
                    %mi S
                    %msub
                      %mi ℤ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L_{S \mathbb{Z}_{(p)}} X
                    \\simeq
                    S \mathbb{Z}_{(p)} \wedge X
                    \\,.
          %p
            (
            %a{:href => "#Bousfield79"}> Bousfield 79, prop. 2.4
            ) recalled e.g. as (
            %a{:href => "#VanKoughnett13"}> van Koughnett 13, prop. 4.3
            ).
          %h3#completion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            \-Completion
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi p
                  %mo =
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{F}_p = \mathbb{Z}/(p)
          %p
            for the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            %a.existingWikiWord{:href => "/nlab/show/finite+field"} finite field
            of
            %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          .num_defn
            %h6#definition_5 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mn ∞
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}/p^\infty \coloneqq (\mathbb{Z}[p^{-1}])/\mathbb{Z}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} localization
              of the
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              away from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              followed by the quotient by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          %p
            e.g. (
            %a{:href => "#Bousfield79"}> Bousfield 79, p. 6
            )
          .num_remark
            %h6#remark_3 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi ℤ
                    %mo ⟶
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mn ∞
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to \mathbb{Z} \longrightarrow \mathbb{Z}[p^{-1}] \longrightarrow \mathbb{Z}/p^\infty \to 0
            %p
              induces the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              (in
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              %a.existingWikiWord{:href => "/nlab/show/Moore+spectra"} Moore spectra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi S
                    %mi ℤ
                    %mo ⟶
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega S(\mathbb{Z}/p^\infty) \longrightarrow S\mathbb{Z} \longrightarrow S(\mathbb{Z}[p^{-1}])
                    \\,.
            %p
              As in
              %a{:href => "#Bousfield79"} Bousfield 79, p. 6
              one also writes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Ω
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^{-1} (\mathbb{Z}/p^\infty)
                    \\coloneqq
                    \\Omega S(\mathbb{Z}/p^\infty)
                    \\,.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              The localization of spectra at the
              %a.existingWikiWord{:href => "/nlab/show/Moore+spectrum"} Moore spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} S\mathbb{F}_p
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/mapping+spectrum"} mapping spectrum
              out of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi p
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} S^{-1} \mathbb{Z}/p^\infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mrow
                        %mi S
                        %msub
                          %mi 𝔽
                          %mi p
                    %mi X
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi Ω
                    %mi S
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mn ∞
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L_{S \mathbb{F}_p} X
                    \\simeq
                    [\Omega S \mathbb{Z}/p^\infty, X]
                    \\,.
          %p
            (
            %a{:href => "#Bousfield79"}> Bousfield 79, prop. 2.5
            )
          %p
            Fact:
            = succeed "-localizaton" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_p
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/p-completion"} p-completion
            = succeed "." do
              %a{:href => "#LurieProper"} Lurie “Proper Morphisms…”, section 4
          .num_example
            %h6#example_5 Example
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ≔
                    %mi H
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    E \coloneqq H \mathbb{Z}/p\mathbb{Z}
            %p
              be the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              under the
              %a{:href => "module+spectrum#StableDoldKanCorrespondence"} stable Dold-Kan corespondence
              is
              = succeed "-local," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %a.maruku-ref{:href => "#AcyclicAndLocal"}
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              groups being
              = succeed "-modules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[p^{-1}]
            %p
              The
              = succeed "-localization" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/p-completion"} p-completion
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Lurie10"} Lurie, Lecture 20, example 8
          %p More generally
          #pCompletion.num_example
            %h6#example_6 Example
            %p
              Bousfield localization at the
              %a.existingWikiWord{:href => "/nlab/show/Moore+spectrum"} Moore spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} S \mathbb{F}_p
              is
              %a.existingWikiWord{:href => "/nlab/show/p-completion"} p-completion
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/p-adic+homotopy+theory"} p-adic homotopy theory
          %p
            E.g. (
            %a{:href => "#Bauer11"}> Bauer 11, example 1.7
            ). See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/localization+of+a+space"} localization of a space
            for more on this.
          %h3#telescopic_localization Telescopic localization
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/telescopic+localization"} telescopic localization
          %h3#chromatic_localization Chromatic localization
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/chromatic+localization"} chromatic localization
          %h2#related_concepts Related concepts
          %ul
