            equipped with
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            %a.existingWikiWord{:href => "/nlab/show/tangential+structure"} tangential structure
            on its
            %a.existingWikiWord{:href => "/nlab/show/stable+tangent+bundle"} stable tangent bundle
            and equipped with a
            %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivialization
            (stable
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/framed+manifold"} framing
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
          %p
            The corresponding
            %a.existingWikiWord{:href => "/nlab/show/bordism+classes"} bordism classes
            form a
            %a.existingWikiWord{:href => "/nlab/show/bordism+ring"} bordism ring
            denoted
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mo •
                      %mrow
                        %mi{:mathvariant => "normal"} U
                        %mo ,
                        %mi fr
                  %annotation{:encoding => "application/x-tex"} \Omega^{\mathrm{U},fr}_\bullet
          %h2#properties Properties
          %h3#RepresentingSpectrum Representing spectrum
          %p
            In generalization to how the complex
            %a.existingWikiWord{:href => "/nlab/show/cobordism+ring"} cobordism ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mrow
                      %mn 2
                      %mi k
                    %mi U
                %annotation{:encoding => "application/x-tex"} \Omega^U_{2k}
            is represented by
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of
            %a.existingWikiWord{:href => "/nlab/show/maps"} maps
            into the
            %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/MU"} MU
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mrow
                      %mn 2
                      %mi k
                    %mrow
                      %mi{:mathvariant => "normal"} U
                      %mo ,
                      %mi fr
                %annotation{:encoding => "application/x-tex"} \Omega^{\mathrm{U},fr}_{2k}
            is represented by maps into the
            %a.existingWikiWord{:href => "/nlab/show/quotient+spaces"} quotient spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi MU
                    %mrow
                      %mn 2
                      %mi k
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi k
                %annotation{:encoding => "application/x-tex"} MU_{2k}/S^{2k}
            (for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi k
                  %mo =
                  %mi Th
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℂ
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Th
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℂ
                    %mi k
                  %msub
                    %mo ×
                    %mrow
                      %mi{:mathvariant => "normal"} U
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                  %mi E
                  %mi{:mathvariant => "normal"} U
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi M
