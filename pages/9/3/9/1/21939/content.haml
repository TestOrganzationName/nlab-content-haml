              \-manifold
            (
            %a{:href => "#ConnerFloyd66"}> Conner-Floyd 66, Section 16
            ,
            = succeed ")" do
              %a{:href => "#ConnerSmith69"} Conner-Smith 69, Sections 6, 13
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
