                  %msub
                    %mi MU
                    %mrow
                      %mn 2
                      %mi k
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi k
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
