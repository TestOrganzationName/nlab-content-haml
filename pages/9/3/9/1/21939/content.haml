              %semantics
                %mrow
                  %mi MFr
                %annotation{:encoding => "application/x-tex"} MFr
          #AShortExactSequenceOfUFrBordismRings.num_prop
            %h6#proposition Proposition
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              degree, the underlying
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              of the
              %a.existingWikiWord{:href => "/nlab/show/bordism+rings"} bordism rings
              for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/MU"} MU
              %a.existingWikiWord{:href => "/nlab/show/MFr"} MFr
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi MUFr
                  %annotation{:encoding => "application/x-tex"} MUFr
              %a.maruku-eqref{:href => "#eq:UFrCobordismRing"} (3)
              sit in
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
              of this form:
            #eq:ShortExactSequenceOfUFrBordismRings.maruku-equation
              %span.maruku-eq-number (6)
