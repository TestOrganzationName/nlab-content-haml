                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi MFr
                        %annotation{:encoding => "application/x-tex"} MFr
                %li
                  %a{:href => "#relation_to_todd_classes_and_the_einvariant"} Relation to Todd classes and the e-invariant
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            In joint generalization of the
            %a.existingWikiWord{:href => "/nlab/show/cobordism+cohomology+theories"} cobordism cohomology theories
            %a.existingWikiWord{:href => "/nlab/show/MU"} MU
            and
            %a.existingWikiWord{:href => "/nlab/show/MFr"} MFr
            of
            %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
            = succeed "-manifolds" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "-manifolds," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fr
                  %annotation{:encoding => "application/x-tex"} Fr
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi fr
                    %mo{:stretchy => "false"} )
