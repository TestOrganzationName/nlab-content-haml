          %h3#relation_to_todd_classes_and_the_einvariant Relation to Todd classes and the e-invariant
          #EInvariantIsToddClassOnCoboundingUFrManifold.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/e-invariant+is+Todd+class+of+cobounding+%28U%2Cfr%29-manifold"}> e-invariant is Todd class of cobounding (U,fr)-manifold
                )
            %p
              Evaluation of the
              %a.existingWikiWord{:href => "/nlab/show/Todd+class"} Todd class
              on
              = succeed "-manifolds" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi fr
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (U,fr)
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              which are
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              on actual
              = succeed "-manifolds." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              %a.maruku-eqref{:href => "#eq:ShortExactSequenceOfUFrBordismRings"} (6)
              that assigning to
              = succeed "-manifolds" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Fr
                    %annotation{:encoding => "application/x-tex"} Fr
              = succeed "-manifolds" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi fr
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (U,fr)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Q%2FZ"} Q/Z
            %p
              Under the
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+isomorphism"} Pontrjagin-Thom isomorphism
              between the
              %a.existingWikiWord{:href => "/nlab/show/framed+bordism+ring"} framed bordism ring
              and the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+group+of+spheres"} stable homotopy group of spheres
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi π
                        %mo •
                        %mi s
                    %annotation{:encoding => "application/x-tex"} \pi^s_\bullet
              %a.existingWikiWord{:href => "/nlab/show/Adams+e-invariant"} Adams e-invariant
              in
              = succeed ":" do
                %a{:href => "Adams+e-invariant#TheEInvariantAsAnElementOfQModZ"} its Q/Z-incarnation
            #eq:ToddClassesOnShortExactSequenceOfUFrBordismRings.maruku-equation
