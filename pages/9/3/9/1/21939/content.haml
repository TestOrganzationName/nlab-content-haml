            (
            %a{:href => "#ConnerFloyd66"}> Conner-Floyd 66, p. 97
            )
          %p
            Hence the representing spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
