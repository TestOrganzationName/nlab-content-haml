            the canonical inclusion):
          #eq:InTermsOfHomotopyGroupsOfQuotientedThomSpace.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mo •
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} U
                      %mo ,
                      %mi fr
                      %mo{:stretchy => "false"} )
