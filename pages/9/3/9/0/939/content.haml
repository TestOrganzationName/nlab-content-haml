                  satisfying the equations
                  %a.existingWikiWord{:href => "/nlab/show/monad#BicategoryOfMonads"} here
              %li
                %p
                  Two
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                  (in
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
