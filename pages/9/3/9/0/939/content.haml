                        %mi s
                      %annotation{:encoding => "application/x-tex"} \nu \colon s s \Rightarrow s
                  commuting with the intertwiners of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
