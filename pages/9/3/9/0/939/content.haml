                          %mi A
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbf{Mnd}(A)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                        %mo{:lspace => "verythinmathspace"} :
                        %mn 1
                        %mo ⇒
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo ,
                        %mi λ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \sigma \colon 1 \Rightarrow (s,\lambda)
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ν
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} (
