                  %a{:href => "#monad_distributing_over_a_comonad"} Monad distributing over a comonad
                %li
                  %a{:href => "#ComonadDistributingOverMonad"} Comonad distributing over monad
              %li
                %a{:href => "#algebras_for_a_distributive_law"} Algebras for a distributive law
              %li
