          %h2#idea Idea
          %p
            What is called
            %em Bredon cohomology
            after (
            %a{:href => "#Bredon67a"}> Bredon 67a
            ,
            = succeed ")" do
              %a{:href => "#Bredon67a"} Bredon 67a
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant cohomology
            which uses the “fine”
            %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
            of
            %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
            that by
            %a.existingWikiWord{:href => "/nlab/show/Elmendorf%27s+theorem"} Elmendorf's theorem
            is equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-presheaves
            over
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel homotopy theory
            %em
              %a{:href => "equivariant+cohomology#Idea"} Equivariant cohomology – Idea
            for more motivation.
          %p
            For more technical details see there
            = succeed "." do
              %em
                %a{:href => "equivariant+cohomology#Bredon"} equivariant cohomology – Bredon equivariant cohomology
          %h2#Definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Orb
                    %mi G
                %annotation{:encoding => "application/x-tex"} Orb_G
            for its
            %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
            and write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi PSh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Orb
                    %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSh_\infty(Orb_G)
            for the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Orb
                      %mi G
                  %annotation{:encoding => "application/x-tex"} Orb_G
            %a.existingWikiWord{:href => "/nlab/show/Elmendorf%27s+theorem"} Elmendorf's theorem
            this is
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalent
            to the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            of
            %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
            with weak equivalences the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "-wise" do
              %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
            %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
            for all closed subgroups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            (“the
            = succeed "\u201D):" do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %msubsup
                        %mi Orb
                        %mi G
                        %mi op
                  %mo ≔
                  %msub
                    %mi L
                    %mi fpwe
                  %mi G
                  %mi Top
                  %mo ≃
                  %msub
                    %mi PSh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Orb
                    %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}^{Orb_G^{op}} \coloneqq  L_{fpwe} G Top \simeq PSh_\infty(Orb_G)
                  \\,.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/spectrum+object"} spectrum object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ∈
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %msubsup
                        %mi Orb
                        %mi G
                        %mi op
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E \in Stab(\mathbf{H}^{Orb_G^{op}})
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %msubsup
                        %mi Orb
                        %mi G
                        %mi op
                %annotation{:encoding => "application/x-tex"} \mathbf{H}^{Orb_G^{op}}
            is what is called a
            %a.existingWikiWord{:href => "/nlab/show/spectrum+with+G-action"} spectrum with G-action
            or, for better or worse, a “
            %a.existingWikiWord{:href => "/nlab/show/naive+G-spectrum"}> naive G-spectrum
            ”.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/G-space"} G-space
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %msubsup
                        %mi Orb
                        %mi G
                        %mi op
                %annotation{:encoding => "application/x-tex"} \mathbf{H}^{Orb_G^{op}}
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            might be called
            %em generalized Bredon cohomology
            (in the “generalized” sense of
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
          %p
            Specifically for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi Ab
                  %mo{:stretchy => "false"} (
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Orb
                    %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in Ab(Sh(Orb_G))
            an
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf"} abelian sheaf
            then there is an
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+object"} Eilenberg-MacLane object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %msubsup
                        %mi Orb
                        %mi G
                        %mi op
                %annotation{:encoding => "application/x-tex"}
                  K(n,A) \in \mathbf{H}^{Orb_G^{op}}
          %p
            whose
            %a.existingWikiWord{:href => "/nlab/show/categorical+homotopy+groups+in+an+%28infinity%2C1%29-topos"} categorical homotopy groups
            are concentrated in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Then
            %em ordinary Bredon cohomology
            (in the “ordinary” sense of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is cohomology in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %msubsup
                        %mi Orb
                        %mi G
                        %mi op
                %annotation{:encoding => "application/x-tex"} \mathbf{H}^{Orb_G^{op}}
            with coefficients in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(n,A)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi G
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi π
                    %mn 0
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %msubsup
                        %mi Orb
                        %mi G
                        %mi op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H_G^n(X,A) \simeq \pi_0 \mathbf{H}^{Orb_G^{op}}(X,A)
          %p
            (see the general discussion at
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
          %p
            If here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is presented by a
            %a.existingWikiWord{:href => "/nlab/show/G-CW+complex"} G-CW complex
            and hence is cofibrant in the
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure that presents the
            %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
            (see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Elmendorf%27s+theorem"} Elmendorf's theorem
            for details), then the
            %a.existingWikiWord{:href => "/nlab/show/derived+hom+space"} derived hom space
            on the right above is equivalently given by the ordinary
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/fixed+points"} fixed points
            of the ordinary
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            of the
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            underlying the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/G-spaces"} G-spaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi G
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H_G^n(X,A) \simeq \pi_0 [X,A]_G
                  \\,.
          %p
            In this form ordinary Bredon cohomology is expressed in (
            %a{:href => "#Bredon67a"}> Bredon 67a, p. 3
            ,
            = succeed ")," do
              %a{:href => "#Bredon67b"} Bredon 67b, Theorem (2.11), (6.1)
            = succeed ")." do
              %a{:href => "#GreenleesMay"} Greenlees-May, p. 10
          %p
            The definition of Bredon cohomology which is more popular (
            %a{:href => "#Bredon67a"}> Bredon 67a, p. 2
            ,
            = succeed ")" do
              %a{:href => "#Bredon67b"} Bredon 67b, I.6
            = succeed "-model" do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            again as a presheaf on the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Orb
                    %mi G
                    %mi op
                  %mo ⟶
                  %msub
                    %mi Ch
                    %mo •
                %annotation{:encoding => "application/x-tex"}
                  C_\bullet(X) \;\colon\; Orb_G^{op}\longrightarrow Ch_\bullet
          %p by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi H
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi H
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  C_n(X)(G/H) \coloneqq H_n((X^n)^H, (X^{n-1})^H, \mathbb{Z})
                  \\,,
          %p
            where on the right we have the
            %a.existingWikiWord{:href => "/nlab/show/relative+homology"} relative homology
            of the
            %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
            decomposition underlying the
            %a.existingWikiWord{:href => "/nlab/show/G-CW+complex"} G-CW complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in degrees as indicated. The
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            on these chain complexes is defined in the obvious way (…).
          %p
            Then one has an expression for
            %em ordinary Bredon cohomology
            similar to that of
            %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
            as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi G
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Hom
                    %mrow
                      %msub
                        %mi Orb
                        %mi G
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H_G^n(X,A) \simeq H_n(Hom_{Orb_G}(C_\bullet(X), A))
                  \\,.
          %p
            (due to
            = succeed "," do
              %a{:href => "#Bredon67"} Bredon 67
            = succeed "))." do
              %a{:href => "#GreenleesMay"} Greenlees-May, p. 9
          %p
            More generally there is
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RO
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} RO(G)
            %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant cohomology
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/genuine+G-spectra"} genuine G-spectra
            %em also
            sometimes still referred to as “Bredon cohomology”. For more on this see at
            = succeed "." do
              %em
                %a{:href => "equivariant%20cohomology#Bredon"} equivariant cohomology – Bredon cohonology
          %h2#examples Examples
          %h3#with_coefficients_in_representation_ring With coefficients in representation ring
          %div
            %p
              %strong
                Incarnations of
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/rational+equivariant+K-theory"} rational equivariant K-theory
            %table
              %thead
                %tr
                  %th
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
                    theory
                  %th definition/equivalence due to
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ≃
                          %msubsup
                            %mi K
                            %mi G
                            %mn 0
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi X
                          %mo ;
                          %mi ℂ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %annotation{:encoding => "application/x-tex"} \simeq K_G^0\big(X; \mathbb{C} \big)
                  %td{:style => "text-align: left;"}
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/rational+equivariant+K-theory"} rational equivariant K-theory
                  %td{:style => "text-align: left;"}
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ≃
                          %msup
                            %mi H
                            %mi ev
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi g
                              %mo ∈
                              %mi G
                          %msup
                            %mi X
                            %mi g
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo{:stretchy => "false"} /
                          %mi G
                          %mo ;
                          %mi ℂ
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %annotation{:encoding => "application/x-tex"} \simeq H^{ev}\Big( \big(\underset{g \in G}{\coprod} X^g\big)/G; \mathbb{C}  \Big)
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/delocalized+equivariant+cohomology"} delocalized equivariant cohomology
                  %td{:style => "text-align: left;"}
                    %a{:href => "delocalized+equivariant+cohomology#ConnesBaum89"} Baum-Connes 89, Thm. 1.19
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ≃
                          %msubsup
                            %mi H
                            %mi CR
                            %mi ev
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mo ≺
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi X
                          %mspace{:width => "negativethinmathspace"}
                          %mo ⫽
                          %mspace{:width => "negativethinmathspace"}
                          %mi G
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ;
                          %mspace{:width => "thinmathspace"}
                          %mi ℂ
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %annotation{:encoding => "application/x-tex"} \simeq H^{ev}_{CR}\Big( \prec \big( X \!\sslash\! G\big);\, \mathbb{C}  \Big)
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Chen-Ruan+cohomology"} Chen-Ruan cohomology
                    %br/
                    of
                    %a.existingWikiWord{:href => "/nlab/show/global+quotient+orbifold"} global quotient orbifold
                  %td{:style => "text-align: left;"}
                    %a{:href => "Chen-Ruan+cohomology#ChenRuan00"} Chen-Ruan 00, Sec. 3.1
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ≃
                          %msubsup
                            %mi H
                            %mi G
                            %mi ev
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mi X
                          %mo ;
                          %mspace{:width => "thinmathspace"}
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi H
                          %mo ↦
                          %mi ℂ
                          %mo ⊗
                          %mi Rep
                          %mo{:stretchy => "false"} (
                          %mi H
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %annotation{:encoding => "application/x-tex"} \simeq H^{ev}_G\Big( X; \, \big(G/H \mapsto \mathbb{C} \otimes Rep(H)\big)  \Big)
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Bredon+cohomology"} Bredon cohomology
                    %br/
                    with
                    %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
