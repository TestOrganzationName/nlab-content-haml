            %p On the local connection forms this acts as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mo ↦
                        %mtd
                          %mi A
                          %mo +
                          %mi α
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %mo ↦
                        %mtd
                          %mi B
                          %mo +
                          %mi d
                          %mi α
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccl}
                    A &amp;\mapsto&amp; A + \alpha
                    \\\
                    B &amp;\mapsto&amp; B + d \alpha
                    \\mathrlap{\,.}
                    \\end{array}
            %p This is the famous gauge transformation law known from the string theory literature.
            %p
          %h3#the_open_string_sigmamodel The open string sigma-model
          .num_remark
            %h6#remark_2 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
              inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ι
                          %mi X
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Q \stackrel{\iota_X}{\to} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
              for an
              %a.existingWikiWord{:href => "/nlab/show/open+string"} open string
              with
              %a.existingWikiWord{:href => "/nlab/show/worldsheet"} worldsheet
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mi Σ
                      %mover
                        %mo ↪
                        %mrow
                          %msub
                            %mi ι
                            %mi Σ
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \partial \Sigma \stackrel{\iota_\Sigma}{\hookrightarrow} \Sigma
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
              configuration of the open string
              %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
              is a map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ι
                      %mi Σ
                    %mo →
                    %msub
                      %mi ι
                      %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \;\colon\; \iota_\Sigma \to \iota_X
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %msup
                            %mi Δ
                            %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}^{\Delta^1}
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo ∂
                            %mi Σ
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mi bdr
                          %mtd
                            %mi Q
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi Σ
                          %mtd
                            %mo ⇙
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi X
                        %mtr
                          %mtd
                            %mi Σ
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mi bulk
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\partial \Sigma &amp;\stackrel{\phi_{bdr}}{\to}&amp; Q
                    \\\
                    \\downarrow^{\mathrlap{\iota_\Sigma}}
                    \&amp;\swArrow&amp;
                    \\downarrow^{\mathrlap{\iota_X}}
                    \\\
                    \\Sigma &amp;\stackrel{\phi_{bulk}}{\to}&amp; X
                    }
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              ordinary
              %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
              just says that a field configuration is a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi bulk
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Σ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi_{bulk} \;\colon\; \Sigma \to X
              subject to the constraint that it takes the
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              %a.existingWikiWord{:href => "/nlab/show/trajectory"} trajectory
              of an
              %a.existingWikiWord{:href => "/nlab/show/open+string"} open string
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
