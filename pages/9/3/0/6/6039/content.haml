                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma, X]
              yields a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of the
              %a.existingWikiWord{:href => "/nlab/show/complex+line+bundle"} complex line bundle
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
              to the pullback of the ordinary transgression over the mapping space out of the boundary: we have a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi Σ
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mn 2
                                %mi π
                                %mi i
                                %msub
                                  %mo ∫
                                  %mi Σ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi ℂ
                            %mo ⫽
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mo
                                  %mrow
                                    %mo{:stretchy => "false"} [
                                    %mo ∂
                                    %mi Σ
                                    %mo ,
                                    %mi X
                                    %mo{:stretchy => "false"} ]
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mo
                                  %mover
                                    %mi ρ
                                    %mo ¯
                                %msub
                                  %mo
                                  %mi conn
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mo ∂
                            %mi Σ
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mn 2
                                %mi π
                                %mi i
                                %msub
                                  %mo ∫
                                  %mrow
                                    %mo ∂
                                    %mi Σ
                                %mo{:stretchy => "false"} )
