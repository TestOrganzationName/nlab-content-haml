                    %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Aut
                    %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\alpha
                  \\;\colon\;
                  G
                  \\xrightarrow{\;}
                  Aut_{Grp}(\Gamma)
          %p
            be a
            %a.existingWikiWord{:href => "/nlab/show/group+action"} group action
            by
            %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
            %a.existingWikiWord{:href => "/nlab/show/center+of+a+group"} center
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi G
                %annotation{:encoding => "application/x-tex"} C(G) \subset G
            is
            %a.existingWikiWord{:href => "/nlab/show/trivial+action"} trivial
            (for example when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            has
            %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial
            center to start with):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi id
                    %mi Γ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\alpha_{\vert C(G)}
                  \\;=\;
                  id_{\Gamma}
                  \\,.
          %p
            In that case the above statement
            %a.maruku-eqref{:href => "#eq:ExistenceOfConjugationsForNearbyHomomorphisms"} (1)
            generalizes to say that
            %em
              nearby
              %a.existingWikiWord{:href => "/nlab/show/crossed+homomorphisms"} crossed homomorphisms
              are
              = succeed "." do
                %a{:href => "crossed+homomorphism#AdjointActionOnCrossedHomomorphisms"} crossed conjugate
          %p
            More precisely, notice (
            %a{:href => "crossed+homomorphism#CrossedHomomorphismsAreSplittingsOfTheSemidirectProductGroup"}> this Prop.
            ) that a
            %a.existingWikiWord{:href => "/nlab/show/crossed+homomorphism"} crossed homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi G
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \phi \;\colon\; G \xrightarrow{\;} \Gamma
            is equivalently a plain
            %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi G
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %mi Γ
                  %mo ⋊
                  %mi G
                %annotation{:encoding => "application/x-tex"} (\phi(-),\,(-)) \,\colon\, G \xrightarrow{\;} \Gamma \rtimes G
            to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \phi'
            is nearby if it is so as a plain homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\phi'(-),(-))
            to the semidirect product group (i.e. we consider
            %a.existingWikiWord{:href => "/nlab/show/neighbourhoods"} neighbourhoods
            of crossed homomorphism in the sense of neighbourhoods of the points which they represent in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi Γ
                    %mo ⋊
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(G,\Gamma \rtimes G))
          %p
            Then the above statement
            %a.maruku-eqref{:href => "#eq:ExistenceOfConjugationsForNearbyHomomorphisms"} (1)
            says that there is an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi Γ
                  %mo ⋊
                  %mi G
                %annotation{:encoding => "application/x-tex"} (\gamma,\,h) \,\in\, \Gamma \rtimes G
            such that
          #eq:ConjugationOfHomomorphismsToSemidirectProductGroup.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo ∀
                    %mrow
                      %mi g
                      %mo ∈
                      %mi G
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi ϕ
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi g
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi γ
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi h
                  %msup
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ⋅
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi g
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⋅
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi γ
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi h
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\underset{g \in G}{\forall}
                  \\;\;\;\;\;
                  \\big(
                  \\phi'(g),\,g
                  \\big)
                  \\;\;
                  \=
                  \\;\;
                  \\big(
                  \\gamma, \, h
                  \\big)^{-1}
                  \\cdot
                  \\big(
                  \\phi(g),\,g
                  \\big)
                  \\cdot
                  \\big(
                  \\gamma, \, h
                  \\big)
                  \\,.
          %p
            In order for such a conjugation to be a
            %a{:href => "crossed+homomorphism#AdjointActionOnCrossedHomomorphisms"} crossed conjugation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \phi'
            = succeed "-component" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo =
                    %mi{:mathvariant => "normal"} e
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi G
                  %annotation{:encoding => "application/x-tex"} h = \mathrm{e} \,\in\, G
          %p
            Now, the further conjugation of
            %a.maruku-eqref{:href => "#eq:ConjugationOfHomomorphismsToSemidirectProductGroup"} (4)
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi{:mathvariant => "normal"} e
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi h
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} \big(\mathrm{e},\,h^{-1}\big)
            yields:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mi α
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi h
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi ϕ
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi g
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi{:mathvariant => "normal"} e
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi h
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⋅
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi γ
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi h
                  %msup
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ⋅
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi g
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⋅
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi γ
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi h
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⋅
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi{:mathvariant => "normal"} e
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi h
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Big(
                  \\alpha(h^{-1})
                  \\big(
                  \\phi'(g)
                  \\big)
                  ,\, g
                  \\Big)
                  \\;\;
                  \=
                  \\;\;
                  \\big(
                  \\mathrm{e},\, h
                  \\big)
                  \\cdot
                  \\big(
                  \\gamma, \, h
                  \\big)^{-1}
                  \\cdot
                  \\big(
                  \\phi(g),\,g
                  \\big)
                  \\cdot
                  \\big(
                  \\gamma, \, h
                  \\big)
                  \\cdot
                  \\big(
                  \\mathrm{e},\, h^{-1}
                  \\big)
                  \\,.
          %p
            But we know that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo ∈
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} h \in C(G)
            is in the
            %a.existingWikiWord{:href => "/nlab/show/center+of+a+group"} center
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.maruku-eqref{:href => "#eq:ConjugationOfHomomorphismsToSemidirectProductGroup"} (4)
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            must be the identity, by construction of crossed homomorphisms.
          %p
            Therefore, by the assumption that the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            restricts along the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ↪
                    %mspace{:width => "thickmathspace"}
                  %mi G
                %annotation{:encoding => "application/x-tex"} C(G) \xhookrightarrow{\;} G
            to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/trivial+action"} trivial action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi h
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha(h^{-1})\big( \phi(g) \big) \,=\, \phi(g)
            and it follows that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi γ
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi h
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⋅
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi{:mathvariant => "normal"} e
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi h
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi γ
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} e
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\big(
                  \\gamma, \, h
                  \\big)
                  \\cdot
                  \\big(
                  \\mathrm{e},\, h^{-1}
                  \\big)
                  \\;\;
                  \=
                  \\;\;
                  \\big(
                  \\gamma, \, \mathrm{e}
                  \\big)
          %p exhibits the required crossed conjugation:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi γ
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ⋅
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\phi'(-) \;=\;  \gamma^{-1} \cdot \phi(-) \cdot \alpha(-)(\gamma)
                  \\,.
          %h3#ForNonCompactGroups For non-Lie groups
          %ul
            %li
              %p
                While the
                %a.existingWikiWord{:href => "/nlab/show/projective+unitary+group"} projective unitary group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                    %annotation{:encoding => "application/x-tex"} \Gamma \,\coloneqq\,
                %a.existingWikiWord{:href => "/nlab/show/PU%28%E2%84%8B%29"} PU(ℋ)
                on a
                %a.existingWikiWord{:href => "/nlab/show/separable+Hilbert+space"} separable Hilbert space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} \mathcal{H}
                is not a (finite-dimensional)
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
                and hence outside the scope of assumption for the above general theorem, the conclusion still holds, at least for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/PU%28%E2%84%8B%29"} PU(ℋ)
                %a.existingWikiWord{:href => "/nlab/show/G-space"} -space
                of homomorphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
