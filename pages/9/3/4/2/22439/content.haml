                %strong 2
                (2015 3070–3078
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://arxiv.org/abs/1412.6821"} arXiv:1412.6821
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
