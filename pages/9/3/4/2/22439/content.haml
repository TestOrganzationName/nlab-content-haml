            %li
              %p
                Raphael Reinauer, Matteo Caorsi, Nicolas Berkouk,
                %em Persformer: A Transformer Architecture for Topological Machine Learning
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
