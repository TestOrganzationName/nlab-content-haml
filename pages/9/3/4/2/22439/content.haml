                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "https://proceedings.neurips.cc/paper/2015"} ISBN:9781510825024
                %a{:href => "https://dl.acm.org/doi/10.5555/2969442.2969582"} doi:10.5555/2969442.2969582
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li#RSL
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bastian+Rieck"}> Bastian Rieck
                , Filip Sadlo, Heike Leitte,
                = succeed "," do
                  %em Topological Machine Learning with Persistence Indicator Functions
                %em Topological Methods in Data Analysis and Visualization V
                TopoInVis (2017) 87-101 Mathematics and Visualization. Springer,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1907.13496"} arXiv:1907.13496
                %a{:href => "https://doi.org/10.1007/978-3-030-43036-8_6"} doi:10.1007/978-3-030-43036-8_6
