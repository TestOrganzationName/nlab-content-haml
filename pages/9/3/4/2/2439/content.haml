          %h2#AlgebraOverSuperpoints Algebra in the topos over superpoints
          %p
            We now consider
            %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            over
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/super+points"} super points
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Super%E2%88%9EGrpd"} Super∞Grpd
          %h3#the_topos The topos
          .num_defn
            %h6#definition_11 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SuperPoint
                  %annotation{:encoding => "application/x-tex"} SuperPoint
              for the
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SuperSet
                    %mo :
                    %mo =
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi SuperPoint
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    SuperSet := Sh(SuperPoint)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              (a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Super
                    %mn ∞
                    %mi Grpd
                    %mo :
                    %mo =
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi SuperPoint
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Super \infty Grpd := Sh_{(\infty,1)}(SuperPoint)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-sheaf (∞,1)-topos
              over this site: the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/super+%E2%88%9E-groupoid"} super ∞-groupoid
          %h3#AlgebraInToposOverSuperPoints-TheLineObject
            The line object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
          #EmbeddingOfSupermanifoldsIntoSheavesOnSuperpoints.num_defn
            %h6#definition_12 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %mi SuperSmthMfd
                    %mo ↪
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi SuperPoint
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    j \colon SuperSmthMfd \hookrightarrow Sh(SuperPoint)
            %p
              for the restricted
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              of
              %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
              given by the canonical inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SuperPoint
                      %mo ↪
                      %mi SuperSmoothManifold
                    %annotation{:encoding => "application/x-tex"} SuperPoint \hookrightarrow SuperSmoothManifold
          #TheRealLine.num_defn
            %h6#definition_13 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo :
                    %mo =
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi SuperPoint
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R} := j(\mathbb{R}) \in Sh(SuperPoint)
            %p
              for the presheaf represented by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              structure this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ∈
                    %mi Ring
                    %mo{:stretchy => "false"} (
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi SuperPoint
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R} \in Ring(Sh(SuperPoint))
                    \\,.
          .num_remark
            %h6#remark_4 Remark
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
              (in the section
              = succeed ")" do
                %a{:href => "http://ncatlab.org/nlab/show/supermanifold#AsLocallyRingedSpacesProperties"} As locally ringed spaces - Properties
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              sends the formal dual of a
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
              to its even subalgebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo :
                    %mi Spec
                    %msup
                      %mo ∧
                      %mo •
                    %mi V
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %mi V
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi even
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}  : Spec \wedge^\bullet V \mapsto (\wedge^\bullet V)_{even}
                    \\,.
            %p
              This is canonically equipped with the structure of a (unital)
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SuperSet
                    %annotation{:encoding => "application/x-tex"} SuperSet
          %p
            In (
            %a{:href => "#Sachse"}> Sachse
            ) this appears around (21).
          %h3#SuperModulesAsbbKModules
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            \-Modules
