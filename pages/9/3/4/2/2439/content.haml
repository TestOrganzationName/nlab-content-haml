            %h6#definition_14 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Mod
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi SuperSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mod_{\mathbb{R}}(SuperSet)
              for the
              %a.existingWikiWord{:href => "/nlab/show/Mod"} category of modules
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              of def.
              %a.maruku-ref{:href => "#TheRealLine"}
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SuperSet
                    %annotation{:encoding => "application/x-tex"} SuperSet
          #EmbeddingOfSVectIntoKMod.num_prop
            %h6#proposition_5 Proposition
            %p
              The restriction of the embedding of def.
              %a.maruku-ref{:href => "#EmbeddingOfSupermanifoldsIntoSheavesOnSuperpoints"}
              to supermanifolds which are
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              is a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %msub
                      %mi SVect
                      %mi ℝ
                    %mo =
                    %msub
                      %mi Mod
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi Mod
                      %mi 𝕂
                    %mo{:stretchy => "false"} (
                    %mi SuperSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    j : SVect_{\mathbb{R}} = Mod_{\mathbb{R}}(Set) \hookrightarrow Mod_{\mathbb{K}}(SuperSet)
            %p
              from real
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              to internal modules over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              that sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %msub
                      %mi SVect
                      %mi ℝ
                  %annotation{:encoding => "application/x-tex"} V \in SVect_{\mathbb{R}}
              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Spec
                    %mi Λ
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi Λ
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %mi V
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi even
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Λ
                      %mi even
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %msub
                      %mi V
                      %mi even
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Λ
                      %mi odd
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %msub
                      %mi V
                      %mi odd
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    j(V) : Spec \Lambda \mapsto (\Lambda \otimes_\mathbb{R} V)_{even}
                    \=
                    (\Lambda_{even} \otimes_\mathbb{R} V_{even})
                    \\oplus
                    (\Lambda_{odd} \otimes_\mathbb{R} V_{odd})
                    \\,.
            %p
              This is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
          %p
            This appears as (
            %a{:href => "#Sachse"}> Sachse, corollary 3.2
            ).
          .proof
            %h6#proof Proof
            %p
              The proof is a variation on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
          %p
            This means that ordinary
            %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
            are embedded as a
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            in
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+points"} super points
          %h3#associative_and_lie_superalgebras Associative and Lie Superalgebras
          .num_prop
            %h6#proposition_6 Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              from prop
              %a.maruku-ref{:href => "#EmbeddingOfSVectIntoKMod"}
              induces a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi SAlg
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
