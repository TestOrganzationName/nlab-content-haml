                %a.existingWikiWord{:href => "/nlab/show/particle"} particle
                on the
                %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                of the
                %a.existingWikiWord{:href => "/nlab/show/string"} string
                ending on a
                %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
                (by K-theoretic
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/geometric+quantization+by+push-forward"} geometric quantization by push-forward
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/D-brane+charge"} D-brane charge
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi B
                              %mi BU
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≃
                            %mtd
                              %mi B
                              %mi K
                              %mo{:stretchy => "false"} (
                              %mi ℤ
                              %mo ,
                              %mn 2
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %mi B
                              %msub
                                %mi gl
                                %mn 1
                              %mo{:stretchy => "false"} (
                              %mi KU
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %mi KU
                              %mtext -
                              %mi Mod
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      B BU(1)
                      \&amp;\simeq&amp;
                      B K(\mathbb{Z},2)
                      \&amp;\to&amp;
                      B gl_1(KU)
                      \&amp;\to&amp;
                      KU \text{-}Mod
                      }
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi KU
                    %annotation{:encoding => "application/x-tex"} KU
                the
                %a.existingWikiWord{:href => "/nlab/show/complex+K-theory+spectrum"} complex K-theory spectrum
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
                %a{:href => "infinity-group%20of%20units#AugmentedDefinition"} graded ∞-group of units
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi gl
                        %mn 1
                        %mi gr
                      %mo{:stretchy => "false"} (
                      %mi KU
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi 𝕊
                    %annotation{:encoding => "application/x-tex"}
                      gl^{gr}_1(KU) \to \mathbb{S}
              %p
                hence are graded by the second
                %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi 𝕊
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      \\pi_2(\mathbb{S}) \simeq \mathbb{Z}_2
              %p of the sphere spectrum.
            %li
              %p
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo =
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} d = 2
                  %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/local+coefficients"} local coefficients
                for
                %a.existingWikiWord{:href => "/nlab/show/quantization"} quantizing
                the
                %a.existingWikiWord{:href => "/nlab/show/string"} string
                (on the
                %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                of the
                %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
                ending on an
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/M9-brane"} M9-brane
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi B
                              %msup
                                %mi B
                                %mn 2
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≃
                            %mtd
                              %mi B
                              %mi K
                              %mo{:stretchy => "false"} (
                              %mi ℤ
                              %mo ,
                              %mn 3
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %mi B
                              %msub
                                %mi gl
                                %mn 1
                              %mo{:stretchy => "false"} (
                              %mi tmf
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %mi tmf
                              %mtext -
                              %mi Mod
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      B B^2 U(1)
                      \&amp;\simeq&amp;
                      B K(\mathbb{Z},3)
                      \&amp;\to&amp;
                      B gl_1(tmf)
                      \&amp;\to&amp;
                      tmf \text{-}Mod
                      }
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi gl
                        %mn 1
                        %mi gr
                      %mo{:stretchy => "false"} (
                      %mi tmf
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi 𝕊
                    %annotation{:encoding => "application/x-tex"}
                      gl^{gr}_1(tmf) \to \mathbb{S}
              %p
                hence are graded by the third
                %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 3
                      %mo{:stretchy => "false"} (
                      %mi 𝕊
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi ℤ
                        %mn 24
                    %annotation{:encoding => "application/x-tex"}
                      \\pi_3(\mathbb{S}) \simeq \mathbb{Z}_{24}
              %p of the sphere spectrum.
            %li
              %p
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo =
                        %mn 5
                      %annotation{:encoding => "application/x-tex"} d = 5
                  %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/local+coefficients"} local coefficients
                for
                %a.existingWikiWord{:href => "/nlab/show/quantization"} quantizing
                the
                %a.existingWikiWord{:href => "/nlab/show/Yang+monopole"} Yang monopole
                (on the
                %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                of the
                %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
                ending on an
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/M9-brane"} M9-brane
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi B
                              %msup
                                %mi B
                                %mn 5
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≃
                            %mtd
                              %mi B
                              %mi K
                              %mo{:stretchy => "false"} (
                              %mi ℤ
                              %mo ,
                              %mn 6
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %mi B
                              %msub
                                %mi gl
                                %mn 1
                              %mo{:stretchy => "false"} (
                              %mi K
                              %mo{:stretchy => "false"} (
                              %mn 5
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %mi K
                              %mo{:stretchy => "false"} (
                              %mn 5
                              %mo{:stretchy => "false"} )
                              %mtext -
                              %mi Mod
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      B B^5 U(1)
                      \&amp;\simeq&amp;
                      B K(\mathbb{Z},6)
                      \&amp;\to&amp;
                      B gl_1(K(5))
                      \&amp;\to&amp;
                      K(5) \text{-}Mod
                      }
                      \\,,
              %p and hence the characteristic twists are in degree 6 of the group of units, hence of the graded group of units
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi gl
                        %mn 1
                        %mi gr
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mn 5
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi 𝕊
                    %annotation{:encoding => "application/x-tex"}
                      gl^{gr}_1(K(5)) \to \mathbb{S}
              %p
                hence are graded by the sixth
                %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 6
                      %mo{:stretchy => "false"} (
                      %mi 𝕊
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      \\pi_6(\mathbb{S}) \simeq \mathbb{Z}_{2}
              %p of the sphere spectrum.
          %h2#AssociativeSuperalgebras Associative superalgebras
          %h3#definition Definition
          %h4#superalgebras Superalgebras
          %p
            An ordinary
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            (a
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            with a linear and associative and unital product operation) is a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            in the
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
          %p
            Throughout, fix a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            of
            %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
            0.
          #SuperVectorSpaces.num_defn
            %h6#definition_2 Definition
            %p
              Write
              %a.existingWikiWord{:href => "/nlab/show/SVect"} SVect
              for the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal structure
            %p
              Objects are vector spaces with a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              decomposition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msub
                      %mi V
                      %mi even
                    %mo ⊕
                    %msub
                      %mi V
                      %mi odd
                  %annotation{:encoding => "application/x-tex"}
                    V = V_{even} \oplus V_{odd}
            %p
              and the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              is given in terms of that on vector spaces by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊗
                    %mi W
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi even
                    %mo ⊗
                    %msub
                      %mi W
                      %mi even
                    %mo ⊕
                    %msub
                      %mi V
                      %mi odd
                    %mo ⊗
                    %msub
                      %mi W
                      %mi odd
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi even
                    %mo ⊗
                    %msub
                      %mi W
                      %mi odd
                    %mo ⊕
                    %msub
                      %mi V
                      %mi odd
                    %mo ⊗
                    %msub
                      %mi W
                      %mi even
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    V \otimes W =
                    (V_{even} \otimes W_{even} \oplus V_{odd}\otimes W_{odd})
                    \\oplus
                    (V_{even} \otimes W_{odd} \oplus V_{odd} \otimes W_{even})
            %p but equipped with the non-trivial braiding morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mrow
                        %mi V
                        %mo ,
                        %mi W
                    %mo :
                    %mi V
                    %mo ⊗
                    %mi W
                    %mo →
                    %mi W
                    %mo ⊗
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    b_{V, W} : V \otimes W \to W \otimes V
            %p
              that is the usual braiding isomorphism of
              %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi even
                    %mo ⊗
                    %msub
                      %mi W
                      %mi even
                  %annotation{:encoding => "application/x-tex"} V_{even} \otimes W_{even}
              and on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi even
                    %mo ⊗
                    %msub
                      %mi W
                      %mi odd
                    %mo ⊕
                    %msub
                      %mi V
                      %mi odd
                    %mo ⊗
                    %msub
                      %mi W
                      %mi even
                  %annotation{:encoding => "application/x-tex"} V_{even} \otimes W_{odd} \oplus V_{odd} \otimes W_{even}
              but is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-1)
              times this on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi odd
                      %mo ⊗
                      %msub
                        %mi W
                        %mi odd
                    %annotation{:encoding => "application/x-tex"} V_{odd}\otimes W_{odd}
          #SuperAlgebras.num_defn
            %h6#definition_3 Definition
            %p
              A
              %strong super (associative) algebra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              in the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %a.existingWikiWord{:href => "/nlab/show/SVect"} SVect
              of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/graded+commutative+algebra"} (graded)-commutative (associative) algebra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+a+symmetric+monoidal+category"} commutative monoid
              in the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %a.existingWikiWord{:href => "/nlab/show/SVect"} SVect
              of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
          %p
            This means that a commutative superalgebra is a
            %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %msub
                    %mi A
                    %mi even
                  %mo ⊕
                  %msub
                    %mi A
                    %mi odd
                %annotation{:encoding => "application/x-tex"}
                  A = A_{even} \oplus A_{odd}
          %p equipped with a morphism of super vector spaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi A
                  %mo ⊗
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  (-)\cdot (-) : A \otimes A \to A
          %p
            that is associative and commutative in the usual sense. Specifically for the commutativity this means that with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo ∈
                  %msub
                    %mi A
                    %mi odd
                %annotation{:encoding => "application/x-tex"} a,b  \in A_{odd}
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ⋅
                  %mi b
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi b
                  %mo ⋅
                  %mi a
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  a \cdot b = - b \cdot a
                  \\,.
          %p
            Whereas if either of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            is in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi even
                %annotation{:encoding => "application/x-tex"} A_{even}
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ⋅
                  %mi b
                  %mo =
                  %mi b
                  %mo ⋅
                  %mi a
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  a \cdot b = b \cdot a
                  \\,.
          %h4#RelatedNotions Related notions
          #Center.num_defn
            %h6#definition_4 Definition
            %p
              The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/center"} center
              of a superalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the sub-superalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi A
                  %annotation{:encoding => "application/x-tex"} Z(A) \hookrightarrow A
              spanned by all those elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} z \in A
              of homogeneous degree which graded-commute with all other homogeneous elements
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
          #Opposite.num_defn
            %h6#definition_5 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              a superalgebra, its
              %strong opposite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi op
                  %annotation{:encoding => "application/x-tex"} A^{op}
              is the superalgebra with the same underlying
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %msub
                      %mo ⋅
                      %mrow
                        %msup
                          %mi A
                          %mi op
                    %msub
                      %mi a
                      %mn 2
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %msub
                            %mi a
                            %mn 1
                          %mo{:stretchy => "false"} |
                        %mrow
                          %mo{:stretchy => "false"} |
                          %msub
                            %mi a
                            %mn 2
                          %mo{:stretchy => "false"} |
                    %msub
                      %mi a
                      %mn 2
                    %msub
                      %mo ⋅
                      %mi A
                    %msub
                      %mi a
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    a_1 \cdot_{A^{op}} a_2 \coloneqq (-1)^{{\vert a_1\vert}{\vert a_2\vert}} a_2 \cdot_{A} a_1
                    \\,.
          #CentralSimple.num_defn
            %h6#definition_6 Definition
            %p
              A superalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is called
              %strong central simple
              if
            %ol
              %li
                %p
                  its
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/center"} center
                  %a.maruku-ref{:href => "#Center"}
                  is the ground field;
              %li
                %p
                  its only 2-sided graded
                  %a.existingWikiWord{:href => "/nlab/show/ideals"} ideals
                  are
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  itself.
          #AlgWithBimodules.num_defn
            %h6#definition_7 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi sVect
                    %mo ≃
                    %mi sAlg
                  %annotation{:encoding => "application/x-tex"} 2sVect \simeq sAlg
              for the
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              equivalent to the one whose
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              are superalgebra,
              %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
              are
              %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
              and
              %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
              are intertwiners. This is naturally a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+2-category"} monoidal 2-category
          #2sVect.num_defn
            %h6#remark Remark
            %p
              By the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/2-vector+space"} 2-vector space
              this is equivalently the 2-category of
              = succeed "." do
                %strong super 2-vector spaces
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} Equivalence
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi sVect
                    %mo ≃
                    %mi sAlg
                  %annotation{:encoding => "application/x-tex"} 2sVect \simeq sAlg
              is also called
              %em
                %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"} Morita equivalence
              of super-algebras.
          #Azumaya.num_defn
            %h6#definition_8 Definition
            %p
              A superalgebra is an
              %a.existingWikiWord{:href => "/nlab/show/Azumaya+algebra"} Azumaya algebra
              if it is an invertible object in the
              %a.existingWikiWord{:href => "/nlab/show/monoidal+2-category"} monoidal 2-category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mn 2
                      %mi Vect
                      %mo ≃
                      %mi sAlg
                    %annotation{:encoding => "application/x-tex"} s2Vect \simeq sAlg
              = succeed "." do
                %a.maruku-ref{:href => "#AlgWithBimodules"}
          .num_remark
            %h6#remark_2 Remark
            %p
              The group of
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of Azumaya super algebras is called the super
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Brauer+group"} Brauer group
          %h3#examples Examples
          %h4#endomorphisms_algebras_matrix_algebras Endomorphisms algebras, matrix algebras
          #EndomorphismSuperalgebra.num_defn
            %h6#definition_9 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mi SVect
                  %annotation{:encoding => "application/x-tex"} V \in SVect
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              %a.existingWikiWord{:href => "/nlab/show/endomorphism+ring"} endomorphism ring
              is canonically a super-algebra. Superalgebras isomorphic to ones of this form, are also called
              = succeed "." do
                %strong matrix super algebras
          #EndomorphismSuperalgebrasAreCentralSimple.num_prop
            %h6#proposition Proposition
            %p
              A matrix superalgebra, def.
              %a.maruku-ref{:href => "#EndomorphismSuperalgebra"}
              is central simple, def.
              = succeed "." do
                %a.maruku-ref{:href => "#CentralSimple"}
          %h4#grassmann_algebra Grassmann algebra
          %ul
            %li
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              a
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              or
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
              the
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \wedge^\bullet V
              is a super algebra. This are the
              %em free
              superalgebras.
          %h4#clifford_algebra Clifford algebra
          %p
            An class of examples of non-(graded)-commutative superalgebra are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
          %p
            In fact, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            equipped with symmetric
            %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle -,- \rangle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∧
                    %mo •
                  %mi V
                %annotation{:encoding => "application/x-tex"} \wedge^\bullet V
            be the
            %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
            %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cl(V, \langle -,- \rangle)
            is the
            %a.existingWikiWord{:href => "/nlab/show/deformation+quantization"} deformation quantization
            of this.
          #ComplexCl1.num_example
            %h6#example Example
            %p
              There is a superalgebra over the
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi ℂ
                    %mo ⊕
                    %mi ℂ
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A = \mathbb{C} \oplus \mathbb{C}\langle u\rangle
                    \\,,
            %p
              where the single odd generator satisfies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ⋅
                      %mi u
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} u \cdot u = 1
          %h3#Properties Properties
          %h4#RelationToOrdinaryCommutativeAlgebra Relation to ordinary commutative algebras
          #InclusionOfCommutativeSuperalgebras.num_defn
            %h6#definition_10 Definition
            %p
              Given some
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi CAlg
                      %mi k
                    %mo ↪
                    %msub
                      %mi SCAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\iota \colon CAlg_k \hookrightarrow SCAlg_k
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of ordinary
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              into
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebras"} supercommutative superalgebras
              (as those having trivial odd part).
          #AdjointsToInclusionOfPlainAlgebra.num_prop
            %h6#proposition_2 Proposition
            %p
              The inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              of def.
              %a.maruku-ref{:href => "#InclusionOfCommutativeSuperalgebras"}
              has
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi even
                      %annotation{:encoding => "application/x-tex"} (-)_{even}
                  given by restricting a superalgebra to its even part;
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi odd
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (-)/((-)_{odd})
                  given by forming the “
                  %a.existingWikiWord{:href => "/nlab/show/body"}> body
                  ”, the
                  %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
                  by the ideal generated by the odd part (by the “
                  %a.existingWikiWord{:href => "/nlab/show/soul"}> soul
                  ”).
          %p
            This is immediate, but conceptually important, it is made explicit for instance in (
            %a{:href => "#CarchediRoytenberg12"}> Carchedi-Roytenberg 12, example 3.18
            ).
          #AdjointTripleBetweenPlainAndSuperalgebra.num_remark
            %h6#remark_3 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#AdjointsToInclusionOfPlainAlgebra"}
              gives an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CAlg
                      %mi k
                    %mover
                      %mover
                        %munder
                          %mo ⟵
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi even
                        %mo ↪
                      %mover
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi odd
                          %mo{:stretchy => "false"} )
                    %msub
                      %mi SCAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    CAlg_k \stackrel{\overset{(-)/((-)_{odd})}{\longleftarrow}}{\stackrel{\hookrightarrow}{\underset{(-)_{even}}{\longleftarrow}}}
                    SCAlg_k
            %p
              and hence an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+cylinder"} adjoint cylinder
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modalities"} adjoint modalities
              (
              %a.existingWikiWord{:href => "/nlab/show/fermionic+modality"} fermionic modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊣
                  %annotation{:encoding => "application/x-tex"} \dashv
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/bosonic+modality"} bosonic modality
              %em
                %a.existingWikiWord{:href => "/nlab/show/super+smooth+infinity-groupoid"} super smooth infinity-groupoid
              for more on this.
          %h4#relation_to_matrix_algebras Relation to matrix algebras
          .num_prop
            %h6#proposition_3 Proposition
            %p
              A superalgebra is isomorphic to a matrix algebra, def.
              = succeed "," do
                %a.maruku-ref{:href => "#EndomorphismSuperalgebra"}
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalent
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi sVect
                      %mo ≃
                      %mi Alg
                    %annotation{:encoding => "application/x-tex"} 2 sVect \simeq Alg
              = succeed "," do
                %a.maruku-ref{:href => "#AlgWithBimodules"}
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"} Morita equivalent
          %h4#Picard2Groupoid Picard 3-group, Brauer group
          %p
            We discuss the
            %a.existingWikiWord{:href => "/nlab/show/Picard+3-group"} Picard 3-group
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi sVect
                    %mo ≃
                    %mi sAlg
                  %annotation{:encoding => "application/x-tex"} 2sVect \simeq sAlg
            = succeed "," do
              %a.maruku-ref{:href => "#AlgWithBimodules"}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Brauer+group"} Brauer group
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/super+line+2-bundle"} super line 2-bundle
          #AzumayaAreCentralSimple.num_theorem
            %h6#theorem Theorem
            %p
              A superalgebra is invertible/Azumaya, def.
              = succeed "," do
                %a.maruku-ref{:href => "#Azumaya"}
              = succeed "." do
                %a.maruku-ref{:href => "#CentralSimple"}
          %p
            This is due to (
            %a{:href => "#Wall"}> Wall
            ).
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Brauer+group"} Brauer group
              of superalgebras over the
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"} cyclic group of order 2
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              is cyclic of order 8:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sBr
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    sBr(\mathbb{C}) \simeq \mathbb{Z}_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sBr
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi ℤ
                      %mn 8
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sBr(\mathbb{R}) \simeq \mathbb{Z}_8
                    \\,.
            %p
              The non-trivial element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sBr
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sBr(\mathbb{R})
              is that presented by the superalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo ⊕
                    %mi ℂ
                    %mi u
