                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              into the internal
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SuperSet
                    %annotation{:encoding => "application/x-tex"} SuperSet
          %p
            This appears as (
            %a{:href => "#Sachse"}> Sachse, corollary 3.3
            ).
          %h2#properties_2 Properties
          %p (…)
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/super+module"}> super module
                ,
                %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/supercommutative+algebra"}> supercommutative algebra
                ,
                %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebra"} differential graded-commutative superalgebra
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+differential+graded-commutative+superalgebras"} model structure on differential graded-commutative superalgebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/smooth+superalgebra"} smooth superalgebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/super+2-algebra"} super 2-algebra
          %h2#references References
          %h3#general General
          %p
            The concept of
            %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
            and the
            %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} super-sign rule
            is due to
          %ul
            %li#Grassmann1844
              %a.existingWikiWord{:href => "/nlab/show/Hermann+Grassmann"}> Hermann Grassmann
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Ausdehnungslehre"} Ausdehnungslehre
              (1844):
          %p Early modern account:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Felix+A.+Berezin"} Felix A. Berezin
              (edited by
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/Alexandre+A.+Kirillov"} Alexandre A. Kirillov
              = succeed "," do
                %em Introduction to Superanalysis
              = succeed "," do
                %strong 9
              = succeed "&rbrack;" do
                %a{:href => "https://link.springer.com/book/10.1007/978-94-017-1963-6"} doi:10.1007/978-94-017-1963-6
          %p Review of basic superalgebra:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yuri+Manin"}> Yuri Manin
                , Chapter 3 in:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Gauge+Field+Theory+and+Complex+Geometry"} Gauge Field Theory and Complex Geometry
                = succeed "," do
                  %strong 289
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-662-07386-5"} doi:10.1007/978-3-662-07386-5
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dennis+Westra"}> Dennis Westra
                ,
                = succeed "," do
                  %em Superrings and supergroups
                = succeed ")" do
                  %a{:href => "http://www.mat.univie.ac.at/~michor/westra_diss.pdf"} pdf
            %li#DeligneMorgan99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Morgan"} John Morgan
                = succeed "," do
                  %em
                    Notes on Supersymmetry (following
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/Joseph+Bernstein"} Joseph Bernstein
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Quantum+Fields+and+Strings"}> Quantum Fields and Strings
                    , A course for mathematicians
                = succeed "," do
                  %strong 1
                = succeed "," do
                  %a{:href => "https://bookstore.ams.org/qft-1-2-s"} ISBN:978-0-8218-2014-8
                = succeed "," do
                  %a{:href => "http://www.math.ias.edu/qft"} web version
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/DeligneMorgan-NotesOnSusy.pdf", :title => "pdf"} pdf
            %li{:id => "Mirković04"}
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ivan+Mirkovi%C4%87"}> Ivan Mirković
                , Sec 1 in:
                = succeed "," do
                  %em Notes on Super Math
                = succeed "," do
                  %em
                    %a{:href => "https://people.math.umass.edu/~mirkovic/0.SEMINARS/1.QFT/Fall.04.html"} Quantum Field Theory Seminar
                = succeed "," do
                  %a{:href => "https://people.math.umass.edu/~mirkovic/0.SEMINARS/1.QFT/1.SuperMath/8.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Mirkovic-NotesOnSupermathematics.pdf", :title => "pdf"} pdf
          %p
            Discussion of superalgebra as algebra in certain
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
            %a.existingWikiWord{:href => "/nlab/show/tensor+categories"} tensor categories
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
              ,
              %em Catégorie Tensorielle
              (
              %a{:href => "https://www.math.ias.edu/files/deligne/Tensorielles.pdf"}> pdf
              )
          %p
            (see also at
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Deligne%27s+theorem+on+tensor+categories"} Deligne's theorem on tensor categories
          %p Lecture notes include
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Five+lectures+on+supersymmetry"} Five lectures on supersymmetry
          %p
            The observation that the study of super-structures in mathematics is usefully regarded as taking place over the
            %a.existingWikiWord{:href => "/nlab/show/base+topos"} base topos
            on the
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            of
            %a.existingWikiWord{:href => "/nlab/show/super+points"} super points
            has been made around 1984 in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Albert+Schwarz"}> Albert Schwarz
                ,
                = succeed "," do
                  %em On the definition of superspace
                = succeed ")" do
                  %a{:href => "http://www.mathnet.ru/links/b12306f831b8c37d32d5ba8511d60c93/tmf5111.pdf"} russian original pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Voronov"}> Alexander Voronov
                ,
                %em Maps of supermanifolds
                , Teoret. Mat. Fiz. (1984) Volume 60, Number 1, Pages 43–48
          %p and in
          %ul
            %li
              V. Molotkov.,
              %em
                Infinite-dimensional
                = succeed "-supermanifolds" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi ℤ
                          %mn 2
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2^k
              , ICTP preprints, IC/84/183, 1984.
          %p A summary/review is in the appendix of
          %ul
            %li#KonechnySchwarz
              %p
                Anatoly Konechny and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Albert+Schwarz"} Albert Schwarz
              %p
                %em
                  On
                  = succeed "-dimensional" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo ⊕
                          %mi l
                          %mo{:stretchy => "false"} |
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (k \oplus l|q)
                in
                %em Supersymmetry and Quantum Field Theory
                (
                %a.existingWikiWord{:href => "/nlab/show/Dmitry+Volkov"} Dmitry Volkov
                memorial volume) Springer-Verlag, 1998, Lecture Notes in Physics, 509 , J. Wess and V. Akulov (editors)(
                %a{:href => "http://arxiv.org/abs/hep-th/9706003"}> arXiv:hep-th/9706003
                )
              %p
                %em
                  Theory of
                  = succeed "-dimensional" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo ⊕
                          %mi l
                          %mo{:stretchy => "false"} |
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (k \oplus l|q)
                Sel. math., New ser. 6 (2000) 471 - 486
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Albert+Schwarz"}> Albert Schwarz
                , I. Shapiro,
                %em Supergeometry and Arithmetic Geometry
                (
                %a{:href => "http://arxiv.org/abs/hep-th/0605119"}> arXiv:hep-th/0605119
                )
          %p
            For more along these lines see also the references at
            %em
              %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
            and at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/super+infinity-groupoid"} super infinity-groupoid
          %p
            Discussion in terms of
            %a.existingWikiWord{:href => "/nlab/show/smooth+algebras"} smooth algebras
            (
            %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+supergeometry"}> synthetic differential supergeometry
            ) is in
          %ul
            %li#CarchediRoytenberg12
              %a.existingWikiWord{:href => "/nlab/show/David+Carchedi"}> David Carchedi
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dmitry+Roytenberg"} Dmitry Roytenberg
              = succeed "," do
                %em On theories of superalgebras of differentiable functions
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/1211.6134"} arxiv:1211.6134
              = succeed ")" do
                %a{:href => "http://www.tac.mta.ca/tac/volumes/28/30/28-30abs.html"} TAC
          %h3#brauer_groups_and_picard_2groupoid Brauer groups and Picard 2-groupoid
          %p
            %a.existingWikiWord{:href => "/nlab/show/Brauer+groups"} Brauer groups
            of superalgebras are discussed in
          %ul#Freed
            %li
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
              , Lectures on twisted K-theory and orientifolds (
              %a{:href => "http://www.ma.utexas.edu/users/dafr/ESI.pdf"}> pdf
              )
          %ul#Wall
            %li
              %a.existingWikiWord{:href => "/nlab/show/C.+T.+C.+Wall"}> C. T. C. Wall
              ,
              = succeed "," do
                %em Graded Brauer groups
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
                ,
                %em Notes on spinors
                in
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Quantum+Fields+and+Strings"} Quantum Fields and Strings
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Donovan"}> Peter Donovan
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Max+Karoubi"} Max Karoubi
                = succeed "," do
                  %em Graded Brauer groups and K-theory with local coefficients
                = succeed ")" do
                  %a{:href => "http://www.math.jussieu.fr/~karoubi/Donavan.K.pdf"} pdf
          %p
            See also at
            %em
              %a.existingWikiWord{:href => "/nlab/show/super+line+2-bundle"} super line 2-bundle
            for more on this.
          %p
            Discussion of superalgebra as induced from free groupal symmetric monoidal categories (
            %a.existingWikiWord{:href => "/nlab/show/abelian+2-groups"}> abelian 2-groups
            ) and hence ultimately from the
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            is in
          %ul
            %li#Kapranov13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mikhail+Kapranov"}> Mikhail Kapranov
                ,
                = succeed "," do
                  %em Categorification of supersymmetry and stable homotopy groups of spheres
                %em
                  %a{:href => "https://web.archive.org/web/20130617191515/http://mathserver.neu.edu/~bwebster/ACRT/"} Algebra, Combinatorics and Representation Theory: in memory of Andrei Zelevinsky (1953-2013)
                (April 2013) &amp;lbrack;
                %a.existingWikiWord{:href => "/nlab/files/Webster-ACRTAbstracts2013.pdf", :title => "pdf"}> pdf
                , video:
                %a{:href => "https://www.youtube.com/watch?v=WBsZrcYOrxI"}> YT
                \&amp;rbrack;
              %blockquote
                %p
                  %strong> Abstract:
                  \. The “minimal sign skeleton” necessary to formulate the
                  %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} Koszul sign rule
                  is a certain
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Picard+category"} Picard category
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
                  with all
                  %a.existingWikiWord{:href => "/nlab/show/invertible+object"} objects
                  and
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/invertible+morphism"} morphisms invertible
                  = succeed "\u2018s" do
                    %a.existingWikiWord{:href => "/nlab/show/Grothendieck"} Grothendieck
                  %a.existingWikiWord{:href => "/nlab/show/n-truncation"} truncation
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} spherical spectrum
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  in degrees 0 and 1, so that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mo ±
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{\pm 1\}
                  appears as the
                  %a.existingWikiWord{:href => "/nlab/show/first+stable+homotopy+group+of+spheres"} first stable homotopy group of spheres
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mi n
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \pi_{n+1}(S^n)
                  = succeed "\u201D" do
                    %a.existingWikiWord{:href => "/nlab/show/higher+structures"} higher
                  %a.existingWikiWord{:href => "/nlab/show/categorification"} categorified
                  versions of
                  %a.existingWikiWord{:href => "/nlab/show/super-algebra"} super-mathematics
                  which utilize deeper structure of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi S
                          %annotation{:encoding => "application/x-tex"} S
                  %a.existingWikiWord{:href => "/nlab/show/categorification"} categorified
                  version of the concept of a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/supercommutative+algebra"} supercommutative algebra
                %p
                  (cf.
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/super+2-algebra"} super 2-algebra
                  and
                  = succeed ")" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/spectral+super-scheme"} spectral super-scheme
            %li#Kapranov15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mikhail+Kapranov"}> Mikhail Kapranov
                ,
                = succeed "," do
                  %em Supergeometry in mathematics and physics
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gabriel+Catren"} Gabriel Catren
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mathieu+Anel"} Mathieu Anel
                %em
                  %a.existingWikiWord{:href => "/nlab/show/New+Spaces+for+Mathematics+and+Physics"} New Spaces for Mathematics and Physics
                (
                %a{:href => "http://arxiv.org/abs/1512.07042"}> arXiv:1512.07042
                )
            %li#Kapranov15b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mikhail+Kapranov"}> Mikhail Kapranov
                ,
                = succeed "," do
                  %em Super-geometry
                = succeed "," do
                  %em
                    %a{:href => "http://ercpqg-espace.sciencesconf.org/program"} New Spaces for Mathematics &amp; Physics
                = succeed "&rbrack;" do
                  %a{:href => "https://www.youtube.com/watch?v=bjsNwKYT8JE"} video recording
