            %li
              %p
                %a{:href => "#ExpositionQuantumSigmaModels"} Quantum sigma-models
          %p
            We draw from (
            %a{:href => "#FHLT"}> FHLT, section 3
            ).
          %h3#ExpositionQuantumFieldTheory Quantum field theory
          %h4#definition Definition
          %p
            For our purposes here, a
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"} symmetric monoidal functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo :
                  %msubsup
                    %mi Bord
                    %mi n
                    %mi S
                  %mo →
                  %mi 𝒞
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Z : Bord_n^S \to \mathcal{C}
                  \\,,
          %p where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Bord
                        %mi n
                        %mi S
                    %annotation{:encoding => "application/x-tex"} Bord_n^S
                is a
                %a.existingWikiWord{:href => "/nlab/show/cobordism+category"} category of n-dimensional cobordisms
                that are equipped with some
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
              %ul
                %li
                  %p
                    its
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/object"} object
                    = succeed "-" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (n-1)
                    = succeed "al" do
                      %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                    = succeed "s;" do
                      %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
                %li
                  %p
                    its
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                    = succeed "es" do
                      %a.existingWikiWord{:href => "/nlab/show/isomorphism+class"} isomorphism class
                    = succeed "-" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
                    = succeed "al" do
                      %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
                %li
                  %p
                    and all manifolds are equipped with
                    %em
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi S
                          %annotation{:encoding => "application/x-tex"} S
                      \-
                      %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                    \. For instance
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                    could be
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Riemannian+structure"} Riemannian structure
                    \. Then we would call
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Z
                        %annotation{:encoding => "application/x-tex"} Z
                    a
                    %a.existingWikiWord{:href => "/nlab/show/Euclidean+quantum+field+theory"} Euclidean quantum field theory
                    (confusingly). If
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                    is “no structure” then we call
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Z
                        %annotation{:encoding => "application/x-tex"} Z
                    a
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/topological+quantum+field+theory"} topological quantum field theory
                %li
                  %p
                    the
                    = succeed "-structure" do
                      %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                    %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
                    of manifolds
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Σ
                            %mn 1
                          %mo ⊗
                          %msub
                            %mi Σ
                            %mn 2
                          %mo :
                          %mo =
                          %msub
                            %mi Σ
                            %mn 1
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %msub
                            %mi Σ
                            %mn 2
                          %mspace{:width => "thinmathspace"}
                          %mo ;
                        %annotation{:encoding => "application/x-tex"}
                          \\Sigma_1 \otimes \Sigma_2 := \Sigma_1 \coprod \Sigma_2
                          \\,;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                is some
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
          %p We think of data as follows:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Bord
                        %mi n
                        %mi S
                    %annotation{:encoding => "application/x-tex"} Bord_n^S
                is a model for
                %em being
                and
                %em becoming
                in
                %a.existingWikiWord{:href => "/nlab/show/physics"} physics
                (following
                = succeed "\u2018s" do
                  %a.existingWikiWord{:href => "/nlab/show/Bill+Lawvere"} Bill Lawvere
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Bord
                        %mi n
                        %mi S
                    %annotation{:encoding => "application/x-tex"} Bord_n^S
                are archetypes of
                %em physical spaces that are
                and the morphisms are
                %em physical spaces that evolve
                ;
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Z(\Sigma)
                that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
                assigns to any
                = succeed "-manifold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n-1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                is to be thought of as the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/space"} space
                  of all possible
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/state"} state
                over the space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                of a the physical system to be modeled;
            %li
              %p
                so
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                is the category of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/n-vector+space"} n-vector space
                %em
                  spaces of
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/state"} state
                of the quantum theory can be picked;
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi Σ
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Σ
                        %mi in
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Σ
                        %mi out
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Z(\hat \Sigma) : Z(\Sigma_{in}) \to Z(\Sigma_{out})
                that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                assigns to any
                %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Σ
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat \Sigma
                with incoming
                %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi in
                    %annotation{:encoding => "application/x-tex"} \Sigma_{in}
                and outgoing boundary
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi out
                    %annotation{:encoding => "application/x-tex"} \Sigma_{out}
                is the
                %a.existingWikiWord{:href => "/nlab/show/propagator"} propagator
                along
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi Σ
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat \Sigma
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo ∈
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Σ
                        %mi in
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \psi \in Z(\Sigma_{in})
                of the system over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi in
                    %annotation{:encoding => "application/x-tex"} \Sigma_{in}
                to the state
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %mi Ψ
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi Σ
                        %mi out
                    %annotation{:encoding => "application/x-tex"} Z(\Psi) \in \Sigma_{out}
                that is the result of the evolution of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
                along
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Σ
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat \Sigma
                by the
                %em dynamics
                of the system. Or conversely: the action of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
                encodes what this dynamics is supposed to be.
          %p
            Notice that since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            is required to be a symmetric monoidal functor it sends disjoint unions of manifolds to
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Σ
                    %mn 1
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %msub
                    %mi Σ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Σ
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Σ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F(\Sigma_1 \coprod \Sigma_2) \simeq Z(\Sigma_1) \otimes Z(\Sigma_2)
                  \\,.
          %p
            Moreover, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Σ
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat \Sigma
            a closed
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mover
                    %mo →
                    %mover
                      %mi Σ
                      %mo{:stretchy => "false"} ^
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \emptyset \stackrel{\hat \Sigma}{\to} \emptyset
            from the
            %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
            manifold to itself, we have that
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %mi ∅
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} Z(\emptyset) = \mathbf{1}
                is the tensor unit of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi Σ
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi End
                      %mo{:stretchy => "false"} (
                      %mi 𝟙
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Z(\hat \Sigma)  \in End(\mathbb{1})
                is an
                %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
                of this tensor unit, a
                %em number
                as seen internal to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                – this is the
                %em invariant
                associated to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Σ
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat \Sigma
                by
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Z
                      %annotation{:encoding => "application/x-tex"} Z
                %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
                over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi Σ
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat \Sigma
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
                as being a rule for computing such invariants by building them up from smaller pieces. This is the
                %em locaity
                of quantum field theory.
          %h4#ExpositionQFTExamples Examples
          %ul
            %li
              %p
                A simple but archetypical example is this: let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo :
                      %mo =
                      %mi Riem
                    %annotation{:encoding => "application/x-tex"} S := Riem
                be
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian structure
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Bord
                        %mn 1
                        %mi Riem
                    %annotation{:encoding => "application/x-tex"} Bord_1^{Riem}
                of 1-dimensional cobordisms equipped with Riemannian structure is generated (as a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/interval"} interval
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo •
                      %mover
                        %mo →
                        %mi t
                      %mo •
                    %annotation{:encoding => "application/x-tex"}
                      \\bullet \stackrel{t}{\to} \bullet
              %p
                equipped with a
                %a.existingWikiWord{:href => "/nlab/show/length"} length
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ∈
                        %msub
                          %mi ℝ
                          %mo +
                      %annotation{:encoding => "application/x-tex"} t \in \mathbb{R}_+
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo •
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi t
                            %mn 1
                      %mo •
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi t
                            %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mo •
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi t
                            %mn 1
                          %mo +
                          %msub
                            %mi t
                            %mn 2
                      %mo •
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (\bullet \stackrel{t_1}{\to} \bullet \stackrel{t_2}{\to})
                      \=
                      (\bullet \stackrel{t_1 + t_2}{\to} \bullet)
                      \\,.
              %p
                Therefore a 1-dimensional
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+quantum+field+theory"} Euclidean quantum field theory
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo :
                      %msubsup
                        %mi Bord
                        %mn 1
                        %mi Riem
                      %mo →
                      %mi Vect
                    %annotation{:encoding => "application/x-tex"}
                      Z : Bord_1^{Riem} \to Vect
              %p is specified by
              %ul
                %li
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℋ
                        %annotation{:encoding => "application/x-tex"} \mathcal{H}
                    (“of
                    = succeed "s\u201D)" do
                      %a.existingWikiWord{:href => "/nlab/show/state"} state
                %li
                  %p
                    for each
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi t
                          %mo ∈
                          %msub
                            %mi ℝ
                            %mo +
                        %annotation{:encoding => "application/x-tex"} t \in \mathbb{R}_+
                    a linear endomorphism
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi t
                          %mo{:stretchy => "false"} )
                          %mo :
                          %mi ℋ
                          %mo →
                          %mi ℋ
                        %annotation{:encoding => "application/x-tex"}
                          U(t) : \mathcal{H} \to \mathcal{H}
                  %p such that
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi t
                            %mn 1
                          %mo +
                          %msub
                            %mi t
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi U
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi t
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi U
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi t
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          U(t_1 + t_2) = U(t_2) \circ U(t_1)
                          \\,.
              %p
                This is just a system of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
                respects the
                %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
                on the space of morphisms in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Bord
                        %mn 1
                        %mi Riem
                    %annotation{:encoding => "application/x-tex"} Bord_1^{Riem}
                then there will be a linear map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mi H
                      %mo :
                      %mi ℋ
                      %mo →
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} i H : \mathcal{H} \to \mathcal{H}
                such that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mi H
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      U(t) = \exp(i H t)
                      \\,.
              %p
                This
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                is called the
                %a.existingWikiWord{:href => "/nlab/show/Hamilton+operator"} Hamilton operator
                of the system.
              %p
                (We are glossing here over some technical fine print in the definition of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Bord
                          %mn 1
                          %mi Riem
                      %annotation{:encoding => "application/x-tex"} Bord_1^{Riem}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} \mathcal{H}
                may indeed be an infinite-dimensional vector space. See
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/%281%2C1%29-dimensional+Euclidean+field+theories+and+K-theory"} (1,1)-dimensional Euclidean field theories and K-theory
          %h3#ExpositionClassicalFieldTheory Classical field theory
          %p
            A special class of examples of
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %a{:href => "#ExpositionQuantumFieldTheory"} above
            %a.existingWikiWord{:href => "/nlab/show/deformation+quantization"} deformations
            or
            %em
              %a.existingWikiWord{:href => "/nlab/show/path+integral"} averages
            of similar, but simpler structure:
            %em
              %a.existingWikiWord{:href => "/nlab/show/classical+field+theories"} classical field theories
            \. The process that constructs a quantum field theory out of a classical field theory is called
            %em
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            \. This is discussed
            = succeed "." do
              %a{:href => "#ExpositionQuantization"} below
            = succeed "." do
              %a{:href => "http://nlab.mathforge.org/schreiber/show/infinity-Chern-Simons+theory#DiscreteTargets"} of Dijkgraaf-Witten type
          %p
            For our purposes here, a
            %a.existingWikiWord{:href => "/nlab/show/classical+field+theory"} classical field theory
            of dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is
          %ul
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"} symmetric monoidal functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msubsup
                        %mi Bord
                        %mi n
                        %mi S
                      %mo →
                      %mi Span
                      %mo{:stretchy => "false"} (
                      %mi Grpd
                      %mo ,
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\exp(i S(-)) : Bord_n^S \to Span(Grpd, \mathcal{C})
                      \\,,
              %p where
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi Bord
                            %mi n
                            %mi S
                        %annotation{:encoding => "application/x-tex"} Bord_n^S
                    is the same
                    %a.existingWikiWord{:href => "/nlab/show/category+of+cobordisms"} category of cobordisms
                    as before;
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Span
                          %mo{:stretchy => "false"} (
                          %mi Grpd
                          %mo ,
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Span(Grpd, \mathcal{C})
                    is the
                    %a.existingWikiWord{:href => "/nlab/show/category+of+spans"} category of spans
                    of
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/object"}> object
                        s are
                        = succeed "s" do
                          %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi K
                            %annotation{:encoding => "application/x-tex"} K
                        equipped with
                        = succeed "s" do
                          %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                        = succeed ";" do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mi ϕ
                                %mo :
                                %mi K
                                %mo →
                                %mi 𝒞
                              %annotation{:encoding => "application/x-tex"} \phi : K \to \mathcal{C}
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/morphism"}> morphism
                        s
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi K
                                %mn 1
                              %mo ,
                              %msub
                                %mi ϕ
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo →
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi K
                                %mn 2
                              %mo ,
                              %msub
                                %mi ϕ
                                %mn 2
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} (K_1, \phi_1) \to (K_2, \phi_2)
                        are
                        = succeed "s" do
                          %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                      .maruku-equation
                        %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                    %mtd
                                    %mtd
                                      %mover
                                        %mi K
                                        %mo{:stretchy => "false"} ^
                                  %mtr
                                    %mtd
                                    %mtd
                                      %mo ↙
                                    %mtd
                                    %mtd
                                      %mo ↘
                                  %mtr
                                    %mtd
                                      %msub
                                        %mi K
                                        %mn 1
                                    %mtd
                                    %mtd
                                      %mo ⇙
                                    %mtd
                                    %mtd
                                      %msub
                                        %mi K
                                        %mn 2
                                  %mtr
                                    %mtd
                                    %mtd
                                      %mo ↘
                                    %mtd
                                    %mtd
                                      %mo ↙
                                  %mtr
                                    %mtd
                                    %mtd
                                    %mtd
                                      %mi 𝒞
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                            %annotation{:encoding => "application/x-tex"}
                              \\array{
                              \&amp;&amp; \hat K
                              \\\
                              \&amp; \swarrow &amp;&amp; \searrow
                              \\\
                              K_1 &amp;&amp;\swArrow&amp;&amp; K_2
                              \\\
                              \&amp; \searrow &amp;&amp; \swarrow
                              \\\
                              \&amp;&amp; \mathcal{C}
                              }
                              \\,,
                      %p
                        where in the middle we have a
                        = succeed ";" do
                          %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                        of morphism is by forming
                        = succeed "s:" do
                          %a.existingWikiWord{:href => "/nlab/show/2-pullback"} 2-pullback
                      .maruku-equation
                        %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %msub
                                %mover
                                  %mi K
                                  %mo{:stretchy => "false"} ^
                                %mn 2
                              %mo ∘
                              %msub
                                %mover
                                  %mi K
                                  %mo{:stretchy => "false"} ^
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo =
                              %msub
                                %mover
                                  %mi K
                                  %mo{:stretchy => "false"} ^
                                %mn 1
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                                %mrow
                                  %msub
                                    %mi K
                                    %mn 2
                              %msub
                                %mover
                                  %mi K
                                  %mo{:stretchy => "false"} ^
                                %mn 2
                              %mspace{:width => "thinmathspace"}
                              %mo .
                            %annotation{:encoding => "application/x-tex"}
                              (\hat K_2 \circ \hat K_1) = \hat K_1 \prod_{K_2} \hat K_2
                              \\,.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Σ
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %msub
                    %mi Σ
                    %mn 1
                  %mo →
                  %msub
                    %mi Σ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \hat \Sigma : \Sigma_1 \to \Sigma_2
            be a
            %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi Σ
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi Conf
                              %mover
                                %mi Σ
                                %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                  %msub
                                    %mo{:stretchy => "false"} |
                                    %mi in
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                  %msub
                                    %mo{:stretchy => "false"} |
                                    %mi out
                        %mtr
                          %mtd
                            %msub
                              %mi Conf
                              %mrow
                                %msub
                                  %mi Σ
                                  %mn 1
                          %mtd
                          %mtd
                            %msub
                              %mo ⇙
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mi S
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mover
                                    %mi Σ
                                    %mo{:stretchy => "false"} ^
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msub
                              %mi Conf
                              %mrow
                                %msub
                                  %mi Σ
                                  %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %msub
                                  %mi V
                                  %mrow
                                    %msub
                                      %mi Σ
                                      %mn 1
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi V
                                    %mrow
                                      %msub
                                        %mi Σ
                                        %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi 𝒞
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S(-))_{\Sigma} =
                  \\left(
                  \\array{
                  \&amp;&amp; Conf_{\hat \Sigma}
                  \\\
                  \&amp; {}^{\mathllap{(-)|_{in}}}\swarrow &amp;&amp; \searrow^{\mathrlap{(-)|_{out}}}
                  \\\
                  Conf_{\Sigma_1} &amp;&amp;\swArrow_{\exp(i S(-)_{\hat \Sigma})}&amp;&amp; Conf_{\Sigma_2}
                  \\\
                  \&amp; {}_{V_{\Sigma_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{V_{\Sigma_2}}}
                  \\\
                  \&amp;&amp; \mathcal{C}
                  }
                  \\right)
          %p
            the value of a classical field theory on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Σ
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat \Sigma
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Conf
                        %mrow
                          %msub
                            %mi Σ
                            %mn 1
                    %annotation{:encoding => "application/x-tex"} Conf_{\Sigma_1}
                is the
                %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
                of a
                %a.existingWikiWord{:href => "/nlab/show/classical+field+theory"} classical field theory
                over
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Σ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \Sigma_1
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Sigma_1
                and
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Conf
                          %mrow
                            %msub
                              %mi Σ
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} Conf_{\Sigma_2}
              %p
                Here a “physical field” can be something like the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
                = succeed "-models" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Sigma_1
                sitting in some
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Conf
                        %mover
                          %mi Σ
                          %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} Conf_{\hat \Sigma}
                is similarly the groupoid of field configurations on the whole cobordism,
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi Σ
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat \Sigma
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Conf
                        %mover
                          %mi Σ
                          %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} Conf_{\hat \Sigma}
                of a way of a
                %a.existingWikiWord{:href => "/nlab/show/brane"} brane
                of shape
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Sigma_1
                sitting in some
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Conf
                        %mover
                          %mi Sigma
                          %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} Conf_{\hat Sigma}
                is a
                %em trajectory
                of that brane in that target space, along which it evolves from shape
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Sigma_1
                to shape
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Σ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \Sigma_2
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mrow
                          %msub
                            %mi Σ
                            %mi i
                      %mo :
                      %msub
                        %mi Conf
                        %mrow
                          %msub
                            %mi Σ
                            %mi i
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} V_{\Sigma_i} : Conf_{\Sigma_i} \to \mathcal{C}
                is the
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying map
                of a kind of
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                over configuration space: a
                %a.existingWikiWord{:href => "/nlab/show/state"} state
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo ∈
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Σ
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \psi \in Z(\Sigma_1)
                of the
                %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
                that will be associated to this
                %a.existingWikiWord{:href => "/nlab/show/classical+field+theory"} classical field theory
                by
                %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
                will be a
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                of this vector bundle. Such a section is to be thought of as a generalization of a
          %p
            %a.existingWikiWord{:href => "/nlab/show/probability+distribution"} probability distribution
            on the space of classical field configurations. The
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi c
                %annotation{:encoding => "application/x-tex"} V_{c}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mrow
                      %msub
                        %mi Σ
                        %mn 1
                %annotation{:encoding => "application/x-tex"} V_{\Sigma_1}
            over a configuration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %msub
                    %mi Conf
                    %mrow
                      %msub
                        %mi Σ
                        %mn 1
                %annotation{:encoding => "application/x-tex"} c \in Conf_{\Sigma_1}
            may be thought of as an
            %em internal state
            of the brane of shape
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \Sigma_1
            sitting in target space.
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} )
                        %mover
                          %mi Σ
                          %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \exp(i S(-))_{\hat \Sigma}
                is the
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                that defines the classical field theory: the component
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} )
                        %mover
                          %mi Σ
                          %mo{:stretchy => "false"} ^
                      %mo :
                      %msub
                        %mi V
                        %mrow
                          %mi γ
                          %msub
                            %mo{:stretchy => "false"} |
                            %mi in
                      %mo →
                      %msub
                        %mi V
                        %mrow
                          %mi γ
                          %msub
                            %mo{:stretchy => "false"} |
                            %mi out
                    %annotation{:encoding => "application/x-tex"}
                      \\exp(i S(\gamma))_{\hat \Sigma}
                      \:
                      V_{\gamma|_{in}}
                      \\to
                      V_{\gamma|_{out}}
          %p
            of this
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            on a trajectory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo ∈
                  %msub
                    %mi Conf
                    %mover
                      %mi Σ
                      %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \gamma \in Conf_{\hat \Sigma}
            going from a configuration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi in
                %annotation{:encoding => "application/x-tex"} \gamma|_{in}
            to a configuration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi out
                %annotation{:encoding => "application/x-tex"} \gamma|_{out}
            is a morphism in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            that maps the internal states of the ingoing configuration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mi Σ
                        %mn 1
                %annotation{:encoding => "application/x-tex"} \gamma|_{\Sigma_1}
            to the internal states of the outgoing configuration
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi Σ
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \gamma|_{\Sigma_2}
            %em classical dynamics
            of the system.
          %p
            Notice that this way a classical field theory is taken to be a special case of a
            = succeed "," do
              %a{:href => "#ExpositionQuantumFieldTheory"} quantum field theory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi Grpd
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span(Grpd, \mathcal{C})
            = succeed "." do
              %span.newWikiWord
                classical field theory as quantum field theory
                %a{:href => "/nlab/new/classical+field+theory+as+quantum+field+theory"} ?
          %h3#ExpositionQuantization Quantization
          %p
            We assume now that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            has
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/biproduct"} biproduct
          %p
            Then for every
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi K
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \phi : K \to \mathcal{C}
            the
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∫
                    %mi K
                  %mi ϕ
                  %mo ∈
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"}
                  \\int^{K} \phi \in \mathcal{C}
          %p
            exists, and (using the existence of
            = succeed "s)" do
              %a.existingWikiWord{:href => "/nlab/show/biproduct"} biproduct
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mo :
                  %mi Span
                  %mo{:stretchy => "false"} (
                  %mi Grpd
                  %mo ,
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝒞
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int : Span(Grpd, \mathcal{C}) \to \mathcal{C}
                  \\,.
          %p
            We call this the
            %em
              %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            functor.
          %p For
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msubsup
                    %mi Bord
                    %mi n
                    %mi S
                  %mo →
                  %mi Span
                  %mo{:stretchy => "false"} (
                  %mi Grpd
                  %mo ,
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S(-)) : Bord_n^S \to Span(Grpd, \mathcal{C})
          %p
            a
            = succeed "," do
              %a{:href => "#ExpositionClassicalFieldTheory"} classical field theory
            %a{:href => "#ExpositionQuantumFieldTheory"} quantum field theory
            by forming the composite functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo :
                  %mo =
                  %mo ∫
                  %mo ∘
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msubsup
                    %mi Bord
                    %mi n
                    %mi S
                  %mover
                    %mo →
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mi Span
                  %mo{:stretchy => "false"} (
                  %mi Grpd
                  %mo ,
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ∫
                  %mi 𝒞
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Z
                  \:=
                  \\int \circ \exp(i S(-))
                  \:
                  Bord_n^S
                  \\stackrel{\exp(i S(-))}{\to}
                  Span(Grpd, \mathcal{C})
                  \\stackrel{\int}{\to}
                  \\mathcal{C}
                  \\,.
          %p
            This
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            we call the
            %em
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(i S(-))
          %p It acts
          %ul
            %li
              %p
                on
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi Σ
                                %mi in
                            %mtd
                              %mo ↦
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi V
                                %mrow
                                  %msub
                                    %mi Σ
                                    %mi in
                              %mo :
                              %msub
                                %mi Conf
                                %mrow
                                  %msub
                                    %mi Σ
                                    %mi in
                              %mo →
                              %mi 𝒞
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ↦
                              %msub
                                %mi ℋ
                                %mrow
                                  %msub
                                    %mi Σ
                                    %mi in
                              %mo :
                              %mo =
                              %msup
                                %mo ∫
                                %mi K
                              %msub
                                %mi V
                                %mrow
                                  %msub
                                    %mi Σ
                                    %mi in
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\Sigma_{in} &amp; \mapsto (V_{\Sigma_{in}} : Conf_{\Sigma_{in}} \to \mathcal{C})
                      \\\
                      \&amp; \mapsto \mathcal{H}_{\Sigma_{in}} := \int^K V_{\Sigma_{in}}
                      \\end{aligned}
              %p
                the vector bundle on the
                %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
                over some boundary
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi in
                    %annotation{:encoding => "application/x-tex"} \Sigma_{in}
                of
                %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
                to its space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℋ
                        %mrow
                          %msub
                            %mi Σ
                            %mi in
                    %annotation{:encoding => "application/x-tex"} \mathcal{H}_{\Sigma_{in}}
                of
                %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge invariant
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/section"} section
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℋ
                        %mrow
                          %msub
                            %mi Σ
                            %mi in
                    %annotation{:encoding => "application/x-tex"} \mathcal{H}_{\Sigma_{in}}
                is the famous
                %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
                of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/state"} state
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %li
              %p
                on
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mover
                                %mi Σ
                                %mo{:stretchy => "false"} ^
                            %mtd
                              %mo ↦
                              %mo{:stretchy => "false"} (
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mi i
                              %mi S
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo{:stretchy => "false"} )
                                %mover
                                  %mi Σ
                                  %mo{:stretchy => "false"} ^
                              %mo :
                              %mi γ
                              %mo ↦
                              %msub
                                %mi V
                                %mrow
                                  %mi γ
                                  %msub
                                    %mo{:stretchy => "false"} |
                                    %mi in
                              %mo →
                              %msub
                                %mi V
                                %mrow
                                  %mi γ
                                  %msub
                                    %mo{:stretchy => "false"} |
                                    %mi out
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ↦
                              %mo{:stretchy => "false"} (
                              %msup
                                %mo ∫
                                %mi K
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mi i
                              %mi S
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo{:stretchy => "false"} )
                                %mover
                                  %mi Σ
                                  %mo{:stretchy => "false"} ^
                              %mo :
                              %msub
                                %mi ℋ
                                %mrow
                                  %msub
                                    %mi Σ
                                    %mn 1
                              %mo →
                              %msub
                                %mi ℋ
                                %mrow
                                  %msub
                                    %mi Σ
                                    %mn 2
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\hat \Sigma &amp; \mapsto
                      (\exp(i S(-))_{\hat \Sigma} : \gamma \mapsto
                      V_{\gamma|_{in}} \to V_{\gamma|_{out}})
                      \\\
                      \&amp; \mapsto
                      (\int^K \exp(i S(-))_{\hat \Sigma}
                      \:
                      \\mathcal{H}_{\Sigma_1} \to \mathcal{H}_{\Sigma_2}
                      )
                      \\end{aligned}
              %p
                to the
                %a.existingWikiWord{:href => "/nlab/show/integral+transform"} integral transform
                that it defines, weighted by the
                %a.existingWikiWord{:href => "/nlab/show/groupoid+cardinality"} groupoid cardinality
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Conf
                        %mover
                          %mi Σ
                          %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} Conf_{\hat \Sigma}
                \: the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
                \.
          %h3#ExpositionClassicalSigmaModels
            Classical
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p
            A
            %em
              classical
              = succeed "-model" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
            is a
            %a{:href => "#ExpositionClassicalFieldTheory"} classical field theory
            such that
          %ul
            %li
              %p
                the
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Conf
                        %mi Σ
                    %annotation{:encoding => "application/x-tex"} Conf_{\Sigma}
                are
                %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}(\Sigma,X)
                in some suitable category – some
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"} higher topos
                in fact – , for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                some fixed
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                of that category called
                %em
                  %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
                ;
            %li
              %p
                the bundles
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi Σ
                      %mo :
                      %msub
                        %mi Conf
                        %mi Σ
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} V_{\Sigma} : Conf_{\Sigma} \to \mathcal{C}
                “of internal states” over these mapping spaces are
              %ul
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
                    to these
                    = succeed "s\u2026" do
                      %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
                %li
                  %p
                    …of an
                    = succeed "\u2026" do
                      %a.existingWikiWord{:href => "/nlab/show/associated+infinity-bundle"} associated higher bundle
                %li
                  %p
                    …asscociated to a
                    %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
                    on
                    = succeed "\u2026" do
                      %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
                %li
                  %p …encoded by a classifying morphism
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi α
                          %mo :
                          %mi X
                          %mo →
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          \\alpha : X \to \mathbf{B}^{n} U(1)
                  %p
                    into the
                    %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle n-group
                    in
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                          %annotation{:encoding => "application/x-tex"} \mathbf{H}
                    %a.existingWikiWord{:href => "/nlab/show/connection+on+an+infinity-bundle"} n-connection
                    = succeed "\u2026" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo ∇
                          %annotation{:encoding => "application/x-tex"} \nabla
                %li
                  %p
                    …where the
                    %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} association
                    is via a
                    %a.existingWikiWord{:href => "/nlab/show/representation"} representation
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ρ
                          %mo :
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mi Vect
                        %annotation{:encoding => "application/x-tex"}
                          \\rho : \mathbf{B}^{n+1} U(1) \to (n+1) Vect
                  %p
                    on
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/n-vector+spaces"} n-vector spaces
              %p
                One calls
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo ,
                      %mo ∇
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\alpha,\nabla)
                the
                %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
                of the
                = succeed "-model." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
            %li
              %p
                The
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} )
                        %mover
                          %mi Σ
                          %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \exp(i S(-))_{\hat \Sigma}
                are given by the
                %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∇
                    %annotation{:encoding => "application/x-tex"} \nabla
                over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi Σ
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat \Sigma
          %p
            So an
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represented
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            on some
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
          %p
            More specifically and more simply, in cases where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is just a
            %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete ∞-groupoid
            – the case of
            = succeed "," do
              %a{:href => "http://nlab.mathforge.org/schreiber/show/infinity-Chern-Simons%20theory#DiscreteTargets"} sigma-models of Dijkgraaf-Witten type
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is necessarily
            = succeed "," do
              %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+%28infinity%2C1%29-topos%20--%20structures#FlatDifferentialCohomology"} flat
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            is given just by the morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi X
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\alpha : X \to \mathbf{B}^{n} U(1)
                  \\,.
          %p
            Then for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Σ
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat \Sigma
            a closed
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            of the sigma-model on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            on a field configuration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo :
                  %mover
                    %mi Σ
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \gamma : \hat \Sigma \to X
            has the value
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} )
                    %mover
                      %mi Σ
                      %mo{:stretchy => "false"} ^
                  %mo =
                  %msub
                    %mo ∫
                    %mover
                      %mi Σ
                      %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} [
                  %mi α
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S(\gamma))_{\hat \Sigma}
                  \=
                  \\int_{\hat \Sigma} [\alpha]
          %p
            being the evaluation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi α
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\alpha]
            regarded as a class in
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi Σ
                    %mo{:stretchy => "false"} ^
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^n(\hat \Sigma, U(1))
            evaluated on the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+class"} fundamental class
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            One says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi α
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\alpha]
            is the
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian"} Lagrangian
            of the theory.
          %h3#ExpositionQuantumSigmaModels
            Quantum
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p (…)
          %h2#references References
          %ul#FHLT
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dan+Freed"}> Dan Freed
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mike+Hopkins"} Mike Hopkins
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Jacob Lurie
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Constantin+Teleman"} Constantin Teleman
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Topological+Quantum+Field+Theories+from+Compact+Lie+Groups"} Topological Quantum Field Theories from Compact Lie Groups
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/0905.0731"} arXiv:0905.0731
