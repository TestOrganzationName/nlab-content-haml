          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#statement"} Statement
              %ul
                %li
                  %a{:href => "#a_version_for_simplicial_abelian_groups"} A version for simplicial abelian groups:
                %li
                  %a{:href => "#cosimplicial_version"} Cosimplicial version
                %li
                  %a{:href => "#crossed_complex_version"} Crossed complex version
                %li
                  %a{:href => "#the_eilenberg__zilber_theorem_for_simplicial_sets"} The Eilenberg - Zilber theorem for simplicial sets
              %li
