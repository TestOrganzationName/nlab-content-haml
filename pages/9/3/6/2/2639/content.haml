                              %mo ≃
                              %mspace{:width => "thickmathspace"}
                            %mi R
                          %mi Tot
                          %msub
                            %mi C
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi Sing
                          %mi X
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %msub
                            %mi C
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi Sing
                          %mi Y
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mi Tot
                          %msub
                            %mi C
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %msub
                            %mi C
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  C_\bullet(X \times Y)
                  \&amp; \coloneqq
                  C_\bullet( \mathbb{Z}[Sing X \times Sing Y] )
                  \\\
                  \&amp;=
                  C_\bullet( diag \mathbb{Z}[Sing X_\bullet]
                  \\otimes \mathbb{Z}[Sing Y_\bullet] )
                  \\\
                  \&amp;
                  \\underoverset{\;\simeq\;}{R}{\longrightarrow}
                  Tot
                  C_\bullet(\mathbb{Z}[Sing X]) \otimes C_\bullet(\mathbb{Z}[Sing Y])
                  \\\
                  \&amp;
                  \=
                  Tot C_\bullet(X) \otimes C_\bullet(Y)
                  \\end{aligned}
          %p
            and hence in particular an isomorphism in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
          %p By following through these maps one can obtain an explicit description of the quasi isomorphism if need be.
          %h3#transgression_in_group_cohomology Transgression in group cohomology
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/transgression+in+group+cohomology"} transgression in group cohomology
          %h2#references References
          %p Original references:
          %ul
            %li#EilenbergZilber53
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Joseph+Zilber"} Joseph Zilber
                = succeed "," do
                  %em On Products of Complexes
                = succeed ")" do
                  %a{:href => "https://www.jstor.org/stable/2372629"} jstor:2372629
            %li#EilenbergMacLane54
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"} Saunders MacLane
                = succeed "," do
                  %em
                    On the Groups
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi H
                            %mo{:stretchy => "false"} (
                            %mi Π
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} H(\Pi,n)
                = succeed "," do
                  %a{:href => "https://www.jstor.org/stable/1969702"} jstor:1969702
                = succeed ")" do
                  %a{:href => "https://doi.org/10.2307/2372629"} doi:10.2307/2372629
          %p
            using the definition of the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+map"} Eilenberg-Zilber map
            in:
          %ul
            %li#EilenbergMacLane53
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"} Saunders MacLane
              = succeed "," do
                %em
                  On the groups
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mi Π
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H(\Pi,n)
              %em
                , Ann. of Math. (2) 58, (1953), 55–106. (
                %a{:href => "https://www.jstor.org/stable/1969820"}> jstor:1969820
                )
          %p Review in:
          %ul
            %li#Dold95
              %a.existingWikiWord{:href => "/nlab/show/Albrecht+Dold"}> Albrecht Dold
              , Section VI 12.1 in
              = succeed "," do
                %em Lectures on Algebraic Topology
              = succeed "," do
                %a{:href => "https://www.springer.com/gp/book/9783540586609"} doi:10.1007/978-3-642-67821-9
              = succeed ")" do
                %a{:href => "https://link.springer.com/content/pdf/bfm%3A978-3-642-67821-9%2F1.pdf"} pdf
          %p A weak version of the simplicial statement:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Charles+Weibel"}> Charles Weibel
              , Theorem 8.5.1 in:
              %em An introduction to homological algebra
          %p The stronger version as stated above:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Albrecht+Dold"}> Albrecht Dold
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dieter+Puppe"} Dieter Puppe
              = succeed "," do
                %em Homologie nicht-additiver Funktoren. Anwendungen
              %strong 11
              (1961) pp. 201-312. (
              %a{:href => "http://archive.numdam.org/item/AIF_1961__11__201_0"}> numdam:AIF_1961__11__201_0
              ,
              = succeed ")" do
                %a{:href => "http://archive.numdam.org/article/AIF_1961__11__201_0.pdf"} pdf
          %p
            where is is ascribed to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Cartier"} Pierre Cartier
            %a{:href => "http://www.maths.abdn.ac.uk/~bensondj/papers/g/goerss-jardine/ch-4.dvi"} chapter 4
            of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"}> Paul Goerss
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/J.+F.+Jardine"} J. F. Jardine
              %em
                %a.existingWikiWord{:href => "/nlab/show/Simplicial+homotopy+theory"} Simplicial homotopy theory
              %p
                (
                %a{:href => "https://link.springer.com/book/10.1007/978-3-0346-0189-4"}> doi:10.1007/978-3-0346-0189-4
                ,
                = succeed ")" do
                  %a{:href => "http://web.archive.org/web/19990208220238/http://www.math.uwo.ca/~jardine/papers/simp-sets/"} webpage
          %p The cosimplicial version of the theorem appears as:
          %ul
            %li
              L. Grunenfelder and M. Mastnak, Theorem A.3 in:
              %em Cohomology of abelian matched pairs and the Kac sequence
              (
              %a{:href => "http://arxiv.org/abs/math/0212124"}> arXiv:math/0212124
              )
          %p The crossed complex version is given in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andy+Tonks"}> A.P. Tonks
                ,
                = succeed "." do
                  %em On the Eilenberg-Zilber Theorem for crossed complexes
              %p
                (for more detail see Tonks’
                = succeed ")," do
                  %a{:href => "https://groupoids.org.uk/pdffiles/tonksthesis.pdf"} thesis
          %p
            and on page 360 of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Nonabelian+Algebraic+Topology"} Nonabelian Algebraic Topology
