        #revision
          %p This entry is about a section of the text
          %ul
            %li
              Michel
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Demazure%2C+lectures+on+p-divisible+groups"} Demazure, lectures on p-divisible groups
              %a{:href => "http://sites.google.com/site/mtnpdivisblegroupsworkshop/lecture-notes-on-p-divisible-groups"} web
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be an
              %a.existingWikiWord{:href => "/nlab/show/affine+scheme"} affine
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+scheme"} k-group
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/completion"} completion
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/Cartier+duality"} Cartier dual
                  %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi D
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \hat D(G)
                  of
                  %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is a connected formal group.
              %li
                %p
                  Any
                  %a.existingWikiWord{:href => "/nlab/show/multiplicative+group+scheme"} multiplicative subgroup
                  of
                  %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is zero.
              %li
                %p
                  For any subgroup
                  %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                  of
                  %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  with
                  %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo ≠
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} H\neq 0
                  we have
                  = succeed "." do
                    %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Gr
                            %mi k
                          %mo{:stretchy => "false"} (
                          %mi H
                          %mo ,
                          %msub
                            %mi α
                            %mi k
                          %mo{:stretchy => "false"} )
                          %mo ≠
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} Gr_k(H,\alpha_k)\neq 0
              %li
                %p
                  Any algebraic quotient of
                  %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is an extension of subgroups of
                  = succeed "." do
                    %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi α
                            %mi k
                        %annotation{:encoding => "application/x-tex"} \alpha_k
              %li
                %p
                  (If
                  = succeed "," do
                    %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo ≠
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} p\neq 0)
                  = succeed "." do
                    %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∩
                          %mi Im
                          %msubsup
                            %mi V
                            %mi G
                            %mi n
                          %mo =
                          %mi e
                        %annotation{:encoding => "application/x-tex"} \cap Im V^n_G =e
          .num_defn
            %h6#definition_and_remark Definition and Remark
            %ol
              %li
                %p
                  A group satisfying the conditions of the previous theorem is called
                  = succeed "." do
                    %em
                      %span.newWikiWord
                        unipotent k-group
                        %a{:href => "/nlab/new/unipotent+k-group"} ?
              %li
                %p
                  Unipotent groups correspond by duality to connected formal
                  = succeed "-groups." do
                    %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
              %li
                %p
                  The category
                  %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ACu
                          %mi k
                      %annotation{:encoding => "application/x-tex"} ACu_k
                  of affine commutative unipotent groups form a thick subcategory of
                  %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi AC
                          %mi k
                      %annotation{:encoding => "application/x-tex"} AC_k
                  which is stable under limits.
          %p The following theorem is the dual to the theorem of the previos chapter.
          .num_theorem
            %h6#theorem_2 Theorem
            %ol
              %li
                %p
                  An affine
                  %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  group is in a unique way an extension of a unipotent group by a multiplicative group.
              %li
                %p
                  This extension splits if
                  %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  is perfect.
              %li
                %p
                  If
                  %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  is perfect any finite group is uniquely the product of four subgroups which are respectively
                  %span.newWikiWord
                    étale
                    %a{:href => "/nlab/new/%C3%A9tale+group+scheme"} ?
                  multiplicative, étale unipotent,
                  %span.newWikiWord
                    infinitesimal
                    %a{:href => "/nlab/new/infinitesimal+group+scheme"} ?
                  multiplicative and infinitesimal unipotent.
              %li
                %p
                  The category
                  %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mi k
                      %annotation{:encoding => "application/x-tex"} F_k
                  of finite commutative
                  = succeed "-groups" do
                    %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  = succeed "," do
                    %math#mathml_72b84c42c047db1d4aaf905881f27948f2449d81_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Fem
