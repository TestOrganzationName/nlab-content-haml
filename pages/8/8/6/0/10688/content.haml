          %h2#idea Idea
          %p
            The
            %em EHP spectral sequence
            (we follow
            = succeed ")" do
              %a{:href => "#Mahowald85"} Mahowald 85
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
            for computation of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+of+spheres"} homotopy groups of spheres
            induced from the
            %a.existingWikiWord{:href => "/nlab/show/filtration"} filtration
            of the underlying homotopy type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn ∞
                  %msup
                    %mi Σ
                    %mn ∞
                  %msup
                    %mi S
                    %mn 0
                  %mo =
                  %msup
                    %mi Ω
                    %mn ∞
                  %mi 𝕊
                %annotation{:encoding => "application/x-tex"} \Omega^\infty \Sigma^\infty S^0 = \Omega^\infty \mathbb{S}
            of the
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            by
            %a.existingWikiWord{:href => "/nlab/show/suspensions"} suspensions
            (German:
            = succeed "inh\u00E4ngung):" do
              %em E
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi n
                  %msup
                    %mi S
                    %mi n
                  %mover
                    %mo ⟶
                    %mi E
                  %msup
                    %mi Ω
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^n S^n \stackrel{E}{\longrightarrow} \Omega^{n+1} S^{n+1}
                  \\,.
          %p
            More concretely, (
            %a{:href => "#James57"}> James 57
            ) constructed maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %msup
                    %mi S
                    %mi n
                  %mover
                    %mo ⟶
                    %mi H
                  %mi Ω
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\Omega S^n \stackrel{H}{\longrightarrow} \Omega S^{2n-1}
          %p
            (for
            = succeed "opf" do
              %em H
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Hopf+invariant"} Hopf invariant
            %a.existingWikiWord{:href => "/nlab/show/p-localization"} 2-locally
            these fit with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            into
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequences"} homotopy fiber sequences
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                  %mover
                    %mo ⟶
                    %mi P
                  %msup
                    %mi Ω
                    %mi n
                  %msup
                    %mi S
                    %mi n
                  %mover
                    %mo ⟶
                    %mi E
                  %msup
                    %mi Ω
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mover
                    %mo ⟶
                    %mi H
                  %msup
                    %mi Ω
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^{n+2} S^{2n+1}
                  \\stackrel{P}{\longrightarrow}
                  \\Omega^n S^n
                  \\stackrel{E}{\longrightarrow}
                  \\Omega^{n+1} S^{n+1}
                  \\stackrel{H}{\longrightarrow}
                  \\Omega^{n+1}S^{2n+1}
                  \\,.
          %p
            (Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is by definition the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Whitehead+product"} Whitehead product
          %p
            This “EHP-
            %a.existingWikiWord{:href => "/nlab/show/long+homotopy+fiber+sequence"}> long homotopy fiber sequence
            ” gives rise to the corresponding
            %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
            and so to an
            %a.existingWikiWord{:href => "/nlab/show/exact+couple"} exact couple
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %munder
                            %mo ⊕
                            %mrow
                              %mi s
                              %mo ,
                              %mi t
                          %msub
                            %mi π
                            %mrow
                              %mi s
                              %mo +
                              %mi t
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Ω
                            %mrow
                              %mi s
                              %mo +
                              %mn 1
                          %msup
                            %mi S
                            %mrow
                              %mi s
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mover
                            %mo ⟶
                            %mi i
                        %mtd
                        %mtd
                          %msub
                            %mi π
                            %mrow
                              %mi s
                              %mo +
                              %mi t
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Ω
                            %mrow
                              %mi s
                              %mo +
                              %mn 1
                          %msup
                            %mi S
                            %mrow
                              %mi s
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ↖
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %munder
                            %mo ⊕
                            %mrow
                              %mi s
                              %mo ,
                              %mi t
                          %msub
                            %mi π
                            %mrow
                              %mi t
                              %mo +
                              %mi s
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Ω
                            %mrow
                              %mi s
                              %mo +
                              %mn 1
                          %msup
                            %mi S
                            %mrow
                              %mn 2
                              %mi s
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\underset{s,t}{\oplus} \pi_{s+t}(\Omega^{s+1}S^{s+1})
                  \&amp;&amp; \stackrel{i}{\longrightarrow} &amp;&amp;
                  \\pi_{s+t}(\Omega^{s+1}S^{s+1})
                  \\\
                  \&amp; \nwarrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp;
                  \\underset{s,t}{\oplus}
                  \\pi_{t+s}(\Omega^{s+1}S^{2s+1})
                  }
                  \\,.
          %p
            The corresponding
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
            is the EHP spectral sequence proper. It converges, 2-locally, to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
            = succeed "-page" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} E_1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mn 1
                    %mrow
                      %mi k
                      %mo ,
                      %mi n
                  %mo =
                  %msub
                    %mi π
                    %mrow
                      %mi k
                      %mo +
                      %mi n
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi π
                    %mo •
                    %mi 𝕊
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  E^{k,n}_1 = \pi_{k+n}(S^{2n-1}) \;\Rightarrow\; \pi_\bullet^{\mathbb{S}}
                  \\,.
          %p
            For more general
            %a.existingWikiWord{:href => "/nlab/show/prime+numbers"} prime numbers
            than just 2, (
            %a{:href => "#Toda62"}> Toda 62
            ) found analogous fibrations, which hence give EHP spectral sequences for general
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %p
            The EHP spectral sequence is often used used in the context of the
            %a.existingWikiWord{:href => "/nlab/show/Adams-Novikov+spectral+sequence"} Adams-Novikov spectral sequence
            for
            %a.existingWikiWord{:href => "/nlab/show/p-localization"} p-localization
            at some prime
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %h2#constructions_of_
            Constructions of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
          %p
            For James’ fiber sequence, the essential property required of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is to realize the isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi the
                  %mspace{:width => "mediummathspace"}
                  %mi map
                  %mspace{:width => "mediummathspace"}
                  %mi H
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi cohomology
                      %mspace{:width => "mediummathspace"}
                      %mi pullback
                  %mo :
                  %msup
                    %mi H
                    %mrow
                      %mn 2
                      %mi n
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %msup
                    %mi 𝕊
                    %mrow
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ∼
                  %msup
                    %mi H
                    %mrow
                      %mn 2
                      %mi n
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %msup
                    %mi 𝕊
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} (the\:map\:H)^{cohomology\:pullback} : H^{2n}(\Omega\mathbb{S}^{2n+1})\overset{\sim}{\to} H^{2n}(\Omega \mathbb{S}^{n+1}) .
          %p
            The remaining corollaries then follow using the fact cohomology pullback is a ring homomorphism, and the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi mod
                  %mn 2
                %annotation{:encoding => "application/x-tex"} mod 2
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Leray-Serre+spectral+sequence"} Leray-Serre spectral sequence
          %h3#via_the_james_model Via the James model
          %p
            Using the James model of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi Σ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega\Sigma X
            as a quotient space of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi colim
                      %mi n
                    %msup
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} colim_n X^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is constructed by recursion:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo #
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi x
                    %mn 0
                  %mo ∧
                  %msub
                    %mi x
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo ∧
                  %msub
                    %mi x
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H([x_0 , \dots, x_{n+1}]) = H([x_0,\dots,x_n]) \# ([x_0 \wedge x_{n+1} , \dots , x_n\wedge x_{n+1}])
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo #
                %annotation{:encoding => "application/x-tex"} \#
            denotes concatenation and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∧
                %annotation{:encoding => "application/x-tex"} \wedge
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi i
                  %mo ∧
                  %msub
                    %mi x
                    %mi j
                %annotation{:encoding => "application/x-tex"} x_i\wedge x_j
            w.r.t.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi k
                  %mo ∧
                  %msub
                    %mi x
                    %mi l
                %annotation{:encoding => "application/x-tex"} x_k\wedge x_l
            depends only on the relative orders of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ,
                    %mi k
                    %mo ,
                    %mi l
                  %annotation{:encoding => "application/x-tex"} i,j,k,l
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is well-defined on the quotient space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi Σ
                    %mi X
                    %mo →
                    %mi Ω
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega\Sigma X \to \Omega \Sigma(X\wedge X)
          %p
            In particular, the restriction to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mn 2
                  %mi X
                %annotation{:encoding => "application/x-tex"} J_2 X
            factors through
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∧
                  %mi X
                  %mo →
                  %mi Ω
                  %mi Σ
                  %mi X
                  %mo ∧
                  %mi X
                %annotation{:encoding => "application/x-tex"} X\wedge X \to \Omega\Sigma X\wedge X
            as the cofiber of the inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi J
                      %mn 2
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \to J_2 X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %msup
                      %mi 𝕊
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X\simeq \mathbb{S}^n
          %h3#via_pushoutpullback_comparisons Via pushout/pullback comparisons
          %p
            Starting with the three-legged cospan
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mover
                        %mo ⟶
                        %mo ⟶
                      %mo ⟶
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}} *
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                          %mo →
                        %mtd
                        %mtd
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mi Σ
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Σ
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mi Σ
                          %mi X
                          %mo ∨
                          %mi Σ
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %mo ↗
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo ↖
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                        %mtd
                        %mtd
                          %mo →
                        %mtd
                        %mtd
                        %mtd
                          %mi Σ
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X    &amp;    &amp;              &amp; \to &amp;       &amp;     &amp;    * \\
                  \&amp; \searrow &amp;             &amp;   &amp;     &amp; \swarrow \\
                  \&amp;       &amp;   *   &amp; \to &amp;   \Sigma X \\
                  \\downarrow &amp; &amp; \downarrow &amp;     &amp; \downarrow &amp; &amp; \downarrow \\
                  \&amp;    &amp; \Sigma X &amp; \to &amp; \Sigma X \vee \Sigma X \\
                  \&amp; \nearrow  &amp; &amp;     &amp;   &amp;       \nwarrow \\
                  *       &amp;      &amp;         &amp; \to &amp;       &amp;      &amp; \Sigma X
                  }
          %p Construct pullbacks in some pair of parallel squares, and compare them by naturality
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Ω
                          %mi Σ
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                          %mo →
                        %mtd
                        %mtd
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Ω
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} (
                          %mi Ω
                          %mi Σ
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ⋆
                          %mo{:stretchy => "false"} (
                          %mi Ω
                          %mi Σ
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi Σ
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Σ
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mi Σ
                          %mi X
                          %mo ∨
                          %mi Σ
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %mo ↗
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo ↖
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                        %mtd
                        %mtd
                          %mo →
                        %mtd
                        %mtd
                        %mtd
                          %mi Σ
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Omega\Sigma X &amp;   &amp;           &amp; \to &amp;           &amp;           &amp; * \\
                  \&amp; \searrow &amp;           &amp;     &amp;           &amp; \swarrow \\
                  \&amp;   &amp; \Omega((\Omega\Sigma X)\star(\Omega\Sigma X)) &amp; \to &amp; \Sigma X \\
                  \\downarrow   &amp;    &amp; \downarrow &amp;     &amp; \downarrow &amp;        &amp; \downarrow \\
                  \&amp;       &amp; \Sigma X   &amp; \to &amp; \Sigma X \vee \Sigma X \\
                  \&amp; \nearrow &amp;         &amp;     &amp;               &amp; \nwarrow \\
                  *     &amp;          &amp;         &amp; \to &amp;            &amp;          &amp; \Sigma X
                  }
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \star
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/join"} reduced join
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mi Ω
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \Sigma\Omega \to 1
            give natural maps, e.g.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %mi ev
                  %mo ∘
                  %mi τ
                  %mo ∘
                  %mi ev
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi Ω
