                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⋆
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mi Σ
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ⋆
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \Omega( ev \circ \tau \circ ev ) : \Omega((\Omega\Sigma X) \star (\Omega\Sigma X)) \to \Omega( X \star X) .
          %p The composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi Σ
                  %mi X
                  %mo →
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mi Σ
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⋆
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mi Σ
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ⋆
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega \Sigma X \to \Omega((\Omega\Sigma X)\star(\Omega\Sigma X)) \to \Omega(X\star X)
          %p
            is a candidate
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Freudenthal+suspension+theorem"} Freudenthal suspension theorem
                may be obtained from the EHP spectral sequence;
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Goodwillie+spectral+sequence"} Goodwillie spectral sequence
                of the identity functor at the point also computes homotopy groups of spheres, the interplay of the two is discussed in (
                %a{:href => "#Behrens10"}> Behrens 10
                )
          %h2#references References
          %p Original articles include
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ioan+Mackenzie+James"}> Ioan Mackenzie James
                ,
                = succeed "," do
                  %em Reduced product spaces
            %li#James57
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ioan+Mackenzie+James"}> Ioan Mackenzie James
                ,
                = succeed "," do
                  %em On the Suspension Sequence
                = succeed ")" do
                  %a{:href => "http://www.jstor.org/stable/1969666"} jstor
            %li#Toda62
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hiroshi+Toda"}> Hiroshi Toda
                ,
                = succeed "," do
                  %em Composition methods in homotopy groups of spheres
            %li#Mahowald85
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Mahowald"}> Mark Mahowald
                ,
                = succeed "." do
                  %em Lin’s theorem and the EHP sequence
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Hilton"} Peter Hilton
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marcel+B%C3%B6kstedt"}> Marcel Bökstedt
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Anne+Marie+Svane"} Anne Marie Svane
                %em A generalization of the stable EHP spectral sequence
                (
                %a{:href => "http://arxiv.org/abs/1208.3938"}> arXiv:1208.3938
                )
          %p
            Relation to the
            %a.existingWikiWord{:href => "/nlab/show/Goodwillie+spectral+sequence"} Goodwillie spectral sequence
            is discussed in
          %ul
            %li#Behrens10
              %a.existingWikiWord{:href => "/nlab/show/Mark+Behrens"}> Mark Behrens
              ,
              %em The Goodwillie tower and the EHP sequence
              (
              %a{:href => "http://arxiv.org/abs/1009.1125"}> arXiv:1009.1125
              )
          %p
            An algebraic version of the EHP spectral sequence for the
            %a.existingWikiWord{:href => "/nlab/show/Lambda-algebra"} Lambda-algebra
            and used for computation of the second page of the
            %a.existingWikiWord{:href => "/nlab/show/classical+Adams+spectral+sequence"} classical Adams spectral sequence
            (the
            = succeed ")," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Curtis+algorithm"} Curtis algorithm
          %ul
            %li#Kochmann96
              %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochman"}> Stanley Kochman
              , around prop. 5.2.6 of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
          %p Review:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"} Michael Hopkins
                (notes by
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/Akhil+Mathew"} Akhil Mathew
                = succeed "," do
                  %em Spectra and stable homotopy theory
                = succeed "," do
                  %a{:href => "http://math.uchicago.edu/~amathew/256y.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/HopkinsMathewStableHomotopyTheory.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Mahowald"}> Mark Mahowald
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Doug+Ravenel"} Doug Ravenel
                %em Towards a Global Understanding of the Homotopy Groups of Spheres
                (
                %a{:href => "http://www.math.rochester.edu/people/faculty/doug/mypapers/global.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Doug+Ravenel"}> Doug Ravenel
                , chapter 1, section 5 of
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Complex+cobordism+and+stable+homotopy+groups+of+spheres"} Complex cobordism and stable homotopy groups of spheres
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/eom"}> eom
                ,
                %em
                  %a{:href => "https://www.encyclopediaofmath.org/index.php/EHP_spectral_sequence"} EHP spectral sequence
