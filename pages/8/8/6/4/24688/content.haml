          %p Brief introductions:
          %ul
            %li
              %p
                %em> From zero to manifold diagrams
                , TallCat Seminar Talk, (
                %a{:href => "https://www.youtube.com/watch?v=67RAzY-13r4"}> video
                )
            %li
              %p
                %em>
                  %a{:href => "https://golem.ph.utexas.edu/category/2023/03/an_invitation_to_geometric_hig.html"} An Invitation to Geometric Higher Categories
                ,
                = succeed "-Category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Dorn"}> Christoph Dorn
                ,
                = succeed "," do
                  %em Manifold Diagrams – A Brief Report
                %a{:href => "https://ncatlab.org/nlab/show/Center+for+Quantum+and+Topological+Systems#DornNov2023"} talk at
                %a.existingWikiWord{:href => "/nlab/show/CQTS"} CQTS
                (15 Nov 2023) &amp;lbrack;
                %a.existingWikiWord{:href => "/nlab/files/Dorn-ManifoldDiagramsReport.pdf", :title => "pdf"}> pdf
