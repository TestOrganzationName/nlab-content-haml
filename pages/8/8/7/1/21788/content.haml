                          %mrow
                            %mo |
                            %mi g
                            %mo |
                    %annotation{:encoding => "application/x-tex"} q^{j/\left\vert g \right\vert }
                are such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                acts on them by multiplication with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
