            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/twisted+ad-equivariant+K-theory"} twisted ad-equivariant K-theory
          %h2#references References
          %p
            As
            %a.existingWikiWord{:href => "/nlab/show/elliptic+cohomology"} elliptic cohomology
            over the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Tate+sphere"} Tate sphere
          %ul
            %li#AHS01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Matthew+Ando"}> Matthew Ando
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"} Michael Hopkins
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Neil+Strickland"} Neil Strickland
                = succeed "," do
                  %em Elliptic spectra, the Witten genus and the theorem of the cube
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/s002220100175"} doi:10.1007/s002220100175
            %li#Lurie09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                = succeed "," do
