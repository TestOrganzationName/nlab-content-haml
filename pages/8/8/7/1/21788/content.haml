                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %a.existingWikiWord{:href => "/nlab/show/fixed+loci"} fixed loci
            for equivariance group the
            %a.existingWikiWord{:href => "/nlab/show/centralizer"} centralizer
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
          %p
            on those elements which satisfy the
            = succeed ":" do
              %em rotation condition
          %p
            %strong#RotationCondition> Rotation condition
            \.
            = succeed "." do
              %em
                The
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
