            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Zhen+Huan"}> Zhen Huan
                ,
                %em Quasi-elliptic cohomology and its Spectrum
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1703.06562"}> arXiv:1703.06562
                \&amp;rbrack;
            %li#Huan18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Zhen+Huan"}> Zhen Huan
                ,
                = succeed "," do
                  %em Quasi-Elliptic Cohomology I
                %strong 337
                (2018) 107-138 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1805.06305"}> arXiv:1805.06305
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.aim.2018.08.007"} doi:10.1016/j.aim.2018.08.007
          %p with a streamlined account in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Zhen+Huan"}> Zhen Huan
                ,
                %em Quasi-theories
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1809.06651"}> arXiv:1809.06651
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Zhen+Huan"}> Zhen Huan
