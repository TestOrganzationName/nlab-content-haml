                %a{:href => "http://www.math.harvard.edu/~lurie/papers/survey.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-642-01200-6_9"} doi:10.1007/978-3-642-01200-6_9
          %p
            As completed
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
            %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
            of
            %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
          %ul
            %li#KM04
              %a.existingWikiWord{:href => "/nlab/show/Nitu+Kitchloo"}> Nitu Kitchloo
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jack+Morava"} Jack Morava
              %em Thom Prospectra for Loopgroup representations
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/math/0404541"}> arXiv:math/0404541
              \&amp;rbrack;
          %p
            As a form of
            %a.existingWikiWord{:href => "/nlab/show/equivariant+elliptic+cohomology"} equivariant elliptic cohomology
            (
            %a.existingWikiWord{:href => "/nlab/show/twisted+ad-equivariant+Tate+K-theory"}> twisted ad-equivariant Tate K-theory
            ):
          %ul
            %li#Ganter07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nora+Ganter"}> Nora Ganter
                , Section 3.1 in:
                %em Stringy power operations in Tate K-theory
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math/0701565"}> arXiv:math/0701565
                \&amp;rbrack;
            %li#Ganter13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nora+Ganter"}> Nora Ganter
                \:
                = succeed "," do
                  %em Power operations in orbifold Tate K-theory
                %strong 15
                1 (2013) 313-342 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1301.2754"}> arXiv:1301.2754
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://projecteuclid.org/journals/homology-homotopy-and-applications/volume-15/issue-1/Power-operations-in-orbifold-Tate-K-theory/hha/1383943680.full"} euclid:hha/1383943680
              %blockquote
                %p
                  (cf.
                  = succeed ")" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/orbifold+K-theory"} orbifold K-theory
            %li#Rezk14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
                ,
                %em Quasi-Elliptic Cohomology
                (2014) &amp;lbrack;
                %a.existingWikiWord{:href => "/nlab/files/Rezk-QuasiEllipticCohomology.pdf", :title => "pdf"}> pdf
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Zhen+Huan"}> Zhen Huan
                ,
                %em Quasi-elliptic cohomology
                (2017) &amp;lbrack;
                %a{:href => "http://hdl.handle.net/2142/97268"}> hdl:2142/97268
                \&amp;rbrack;
            %li
