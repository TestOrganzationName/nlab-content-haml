          %p Review:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Zhen+Huan"}> Zhen Huan
              ,
              = succeed "," do
                %em Quasi-elliptic cohomology theory and the twisted, twisted Real theories
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.48660/20050059"} doi:10.48660/20050059
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/simply-connected+topological+space"} simply-connected
            = succeed ":" do
