                %a{:href => "/nlab/new/measure+algebra"} ?
            %li
              %a.existingWikiWord{:href => "/nlab/show/%CF%83-complete+Boolean+algebra"}> σ-complete Boolean algebra
              ,
              %span.newWikiWord
                monotone-complete
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^*
                %a{:href => "/nlab/new/monotone-complete+%24C%5E%2A%24-algebra"} ?
            %li
              %span.newWikiWord>
                point-free measure theory
                %a{:href => "/nlab/new/point-free+measure+theory"} ?
              ,
              %a.existingWikiWord{:href => "/nlab/show/measurable+Gelfand+duality"} measurable Gelfand duality
            %li
              %a.existingWikiWord{:href => "/nlab/show/Stone+duality"}> Stone duality
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gelfand+duality"} Gelfand duality
              %a.existingWikiWord{:href => "/nlab/show/Isbell+duality"} Isbell duality
            %li
              %a.existingWikiWord{:href => "/nlab/show/categorical+approaches+to+probability+theory"} categorical approaches to probability theory
          %h2#references References
          %ul
            %li
              %p
                Roman Sikorski,
