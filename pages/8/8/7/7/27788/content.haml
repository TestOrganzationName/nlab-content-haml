                %a{:href => "/nlab/new/point-free+measure+theory"} ?
          %p
            It is closely related to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/point-free+topology"} point-free topology
            %a.existingWikiWord{:href => "/nlab/show/measurable+Gelfand+duality"} measurable Gelfand duality
            and to the duality between
            %a.existingWikiWord{:href => "/nlab/show/measure+spaces"}
              %em measure
              spaces
            (not
            = succeed ")" do
              %em measurable
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/measurable+locales"} measurable locales
          %h2#main_concepts Main concepts
          %p
            Recall that a
            %a.existingWikiWord{:href => "/nlab/show/measurable+space"} measurable space
            is a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/%CF%83-algebra"} σ-algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            of subsets of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/measure"} measure
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
            %a.existingWikiWord{:href => "/nlab/show/events"} events
            to which one assigns a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/probability"} probability
          %p
            In
            = succeed "," do
              %span.newWikiWord
                point-free measure theory
                %a{:href => "/nlab/new/point-free+measure+theory"} ?
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/point-free+topology"} point-free topology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the
            %a.existingWikiWord{:href => "/nlab/show/poset"} ordered
            structure of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          %h3#from_measurable_spaces_to_complete_boolean_algebras From measurable spaces to σ-complete Boolean algebras
          %p
            Given a measurable space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi Σ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\Sigma_X)
            %a.existingWikiWord{:href => "/nlab/show/%CF%83-algebra"} σ-algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi X
                %annotation{:encoding => "application/x-tex"} \Sigma_X
            is by definition closed under complements and countable unions. In other words it is a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/%CF%83-complete+Boolean+algebra"} σ-complete Boolean algebra
            (also known as
            = succeed ")." do
              %strong Boolean σ-algebra
          %p
            Given a measurable map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi Σ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi Σ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:(X,\Sigma_X)\to (Y,\Sigma_Y)
