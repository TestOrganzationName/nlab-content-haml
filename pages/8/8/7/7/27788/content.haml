                  %em Boolean Algebras
            %li
              %p
                Sean Moss and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paolo+Perrone"} Paolo Perrone
                = succeed "," do
                  %em Probability monads with submonads of deterministic states
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/2204.07003"} arXiv
            %li
              %p
                Ruiyuan Chen,
                = succeed "." do
                  %em A universal characterization of standard Borel spaces
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1908.10510"} arXiv
            %li#fritz_lorenzin
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tobias+Fritz"} Tobias Fritz
                and Antonio Lorenzin,
                = succeed "," do
                  %em Categories of abstract and noncommutative measurable spaces
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/2504.13708"} arXiv
          %h3#introductory_material Introductory material
