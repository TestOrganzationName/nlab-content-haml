              %a{:href => "U-duality#HullTownsend94"}> Hull-Townsend 94, table 1, table 2
              )
          %h3#FundamentalRepresentationAndBraneCharges Fundamental representation and brane charges
          %p
            The first
            %a.existingWikiWord{:href => "/nlab/show/fundamental+representation"} fundamental representation
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 11
                  %annotation{:encoding => "application/x-tex"} E_{11}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi l
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} l_1
            = succeed ")," do
              %a{:href => "#West04"} West 04
            %a.existingWikiWord{:href => "/nlab/show/representations"} representations
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mn 11
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL(11)
            the representations in which the
            %a.existingWikiWord{:href => "/nlab/show/charges"} charges
            of the
            %a.existingWikiWord{:href => "/nlab/show/M-branes"} M-branes
            and other
            %a.existingWikiWord{:href => "/nlab/show/BPS+states"} BPS states
            transform.
          %p
            According to (
            %a{:href => "#NicolaiFischbacher03"}> Nicolai-Fischbacher 03, first three rows of table 2 on p. 72
            ,
            = succeed "," do
              %a{:href => "#West04"} West 04
            = succeed ")" do
              %a{:href => "#KleinschmidtWest04"} Kleinschmidt-West 04
            = succeed ")," do
              %a{:href => "#West11"} West 11, (2.17)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi l
                    %mn 1
                %annotation{:encoding => "application/x-tex"} l_1
            under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mn 11
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL(11)
            starts out as so:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi l
                    %mn 1
                  %mo ≃
                  %munder
                    %munder
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 10
                            %mo ,
                            %mn 1
                      %mo ⏟
                    %mrow
                      %mi level
                      %mspace{:width => "thinmathspace"}
                      %mn 0
                  %mo ⊕
                  %munder
                    %munder
                      %mrow
                        %msup
                          %mo ∧
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 10
                            %mo ,
                            %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                      %mo ⏟
                    %mrow
                      %mi level
                      %mspace{:width => "thinmathspace"}
                      %mn 1
                  %mo ⊕
                  %munder
                    %munder
                      %mrow
                        %msup
                          %mo ∧
                          %mn 5
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 10
                            %mo ,
                            %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                      %mo ⏟
                    %mrow
                      %mi level
                      %mspace{:width => "thinmathspace"}
                      %mn 2
                  %mo ⊕
                  %munder
                    %munder
                      %mrow
                        %msup
                          %mo ∧
                          %mn 7
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 10
                            %mo ,
                            %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                        %msub
                          %mo ⊗
                          %mi s
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 10
                            %mo ,
                            %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mo ⊕
                        %msup
                          %mo ∧
                          %mn 8
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 10
                            %mo ,
                            %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                      %mo ⏟
                    %mrow
                      %mi level
                      %mspace{:width => "thinmathspace"}
                      %mn 3
                  %mo ⊕
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  l_1
                  \\simeq
                  \\underset{level\,0}{
                  \\underbrace{
                  \\mathbb{R}^{10,1}
                  }}
                  \\oplus
                  \\underset{level\,1}{
                  \\underbrace{
                  \\wedge^2 (\mathbb{R}^{10,1})^\ast
                  }}
                  \\oplus
                  \\underset{level\,2}{
                  \\underbrace{
                  \\wedge^5 (\mathbb{R}^{10,1})^\ast
                  }}
                  \\oplus
                  \\underset{level\,3}{\underbrace{
                  \\wedge^7 (\mathbb{R}^{10,1})^\ast \otimes_s (\mathbb{R}^{10,1})^\ast
                  \\oplus
                  \\wedge^8 (\mathbb{R}^{10,1})^\ast
                  }}
                  \\oplus
                  \\cdots
          %p
            Here the
            = succeed "-truncation" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
