          %h2#idea Idea
          %p
            The
            %em Yang-Mills moduli space
            (short
            = succeed "," do
              %em YM moduli space
            = succeed ")" do
              %em instanton moduli space
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+equations"} Yang-Mills equations
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/gauge"} gauge
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Donaldson%27s+theorem"} Donaldson's theorem
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Simon+Donaldson"} Simon Donaldson
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Fields+medal"} Fields medal
            %a.existingWikiWord{:href => "/nlab/show/Donaldson+invariants"} Donaldson invariants
            used to study
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/4-manifolds"} 4-manifolds
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Seiberg-Witten+moduli+space"} Seiberg-Witten moduli space
            %a.existingWikiWord{:href => "/nlab/show/Chen+Ning+Yang"} Chen Ning Yang
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Robert+Mills"} Robert Mills
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+equations"} Yang-Mills equations
            in 1954.
          %p
            In four dimensions, important subspaces of the Yang-Mills moduli space are the
            %em self-dual Yang-Mills moduli space
            (short
            = succeed "," do
              %em SDYM moduli space
            = succeed ")" do
              %em self-dual instanton moduli space
            %a.existingWikiWord{:href => "/nlab/show/self-dual+Yang-Mills+equations"} self-dual Yang-Mills equations
            up to gauge and the
            %em anti self-dual Yang-Mills moduli space
            (short
            = succeed "," do
              %em ASDYM moduli space
            = succeed ")" do
              %em anti self-dual instanton moduli space
            %a.existingWikiWord{:href => "/nlab/show/anti+self-dual+Yang-Mills+equations"} anti self-dual Yang-Mills equations
            up to gauge. See also
            %a.existingWikiWord{:href => "/nlab/show/D%3D4+Yang-Mills+theory"} D=4 Yang-Mills theory
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/self-dual+Yang-Mills+theory"} self-dual Yang-Mills theory
          %h2#Definition Definition
          %p Consider
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                a
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %li
              %p
                with
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo{:lspace => "verythinmathspace"} :
                      %mi P
                      %mo ↠
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \pi\colon P\twoheadrightarrow X
                a smooth
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"}
                  principal
                  = succeed "-bundle" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
            %li
              %p
                over a
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Ω
                    %mi conn
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ;
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⊂
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ;
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{A}
                  \\;\coloneqq\;
                  \\Omega^1_{conn}(P;\mathfrak{g})
                  \\;\subset\;
                  \\Omega^1(P;\mathfrak{g})
                  \\,,
          %p
            for the set of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+1-forms"} Lie algebra valued
            %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"} Ehresmann
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+principal+bundle"} connection
            %a.existingWikiWord{:href => "/nlab/show/differential+1-form"} 1-forms
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p
            This is an
            %a.existingWikiWord{:href => "/nlab/show/infinite-dimensional+manifold"} infinite-dimensional
            affine space,
            %a.existingWikiWord{:href => "/nlab/show/group+action"} acted on
            by the group of
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformations"} gauge transformations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Γ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi Ad
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{G}
                  \\;\coloneqq\;
                  Aut(P)
                  \\simeq
                  \\Gamma\big(Ad(P)\big)
          %p with quotient
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "right center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mi 𝒜
                      %mtd
                        %mover
                          %mo →
                          %mrow
                            %mphantom
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo −
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ]
                            %mphantom
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo −
                      %mtd
                        %mi 𝒜
                        %mo{:stretchy => "false"} /
                        %mi 𝒢
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{rcl}
                  \\mathcal{A}
                  \&amp;\xrightarrow{\phantom{--}[-]\phantom{--}}&amp;
                  \\mathcal{A}/\mathcal{G}
                  \\end{array}
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+equations"} Yang-Mills equations
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi A
                    %mo ⋆
                    %msub
                      %mi F
                      %mi A
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d_A \star F_A=0
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge invariant
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℳ
