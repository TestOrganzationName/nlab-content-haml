                        %mi b
                    %annotation{:encoding => "application/x-tex"} \phi_a \vdash \bigvee_{b\in U}\phi_{b}
                (if
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
