                      %mo{:stretchy => "false"} {
                      %msub
                        %mi ϕ
                        %mi c
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi c
                      %mo ◃
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:stretchy => "false"} }
                      %mo ∧
                      %mi c
                      %mo ◃
                      %mo{:stretchy => "false"} {
                      %mi b
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \phi_a \wedge \phi_b \vdash \bigvee\{\phi_c\mid c\triangleleft\{a\} \wedge c\triangleleft\{b\}\}
            %li
              %p
