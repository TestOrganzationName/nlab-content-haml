          %title Uniform convergence spaces
          %h1#uniform_convergence_spaces Uniform convergence spaces
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#motivation"} Motivation
              %li
                %a{:href => "#definitions"} Definitions
              %li
                %a{:href => "#terminology_warning"} Terminology warning
              %li
