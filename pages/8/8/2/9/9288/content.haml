            %p
              %strong
                2-Tannaka duality for
                %a.existingWikiWord{:href => "/nlab/show/module+categories"} module categories
                over
                %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/2-category+of+module+categories"} 2-category of module categories
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Mod
                            %mi A
                        %annotation{:encoding => "application/x-tex"} Mod_A
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                    \-
                    %a.existingWikiWord{:href => "/nlab/show/2-algebra"} 2-algebra
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi Mod
