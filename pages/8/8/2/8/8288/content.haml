                      %semantics
                        %mrow
                          %mi ℬ
                        %annotation{:encoding => "application/x-tex"} \mathcal{B}
          %p
            For instance (
            %a{:href => "#Schapira"}> Schapira, def. 4.6.5
            ).
          %p
            With the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℐ
                  %mo ,
                  %mi 𝒫
                  %mo ⊂
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{I},\mathcal{P}\subset \mathcal{A}
            as above, we say:
          #FProjectivesResolution.num_defn
            %h6#definition_6 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} A \in \mathcal{A}
            %ul
              %li
                %p
                  an
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
                    \-injective resolution
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi I
                          %mo •
                        %mo ∈
                        %msup
                          %mi Ch
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi ℐ
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msup
                          %mi Ch
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} I^\bullet \in Ch^\bullet(\mathcal{I}) \subset Ch^\bullet(\mathcal{A})
                  and a
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mo ≃
                              %mi qi
                        %msup
                          %mi I
                          %mo •
                      %annotation{:encoding => "application/x-tex"}
                        A \stackrel{\simeq_{qi}}{\to} I^\bullet
              %li
                %p
                  an
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
                    \-projective resolution
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Q
                          %mo •
                        %mo ∈
                        %msub
                          %mi Ch
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi 𝒫
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msup
                          %mi Ch
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Q_\bullet \in Ch_\bullet(\mathcal{P}) \subset Ch^\bullet(\mathcal{A})
                  and a
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Q
                          %mo •
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mo ≃
                              %mi qi
                        %mi A
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Q_\bullet \stackrel{\simeq_{qi}}{\to} A
                        \\,.
          %p
            Let now
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            have enough projectives / enough injectives, respectively.
          #FAcyclicObjectsAreFProjectiveObjects.num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒜
                    %mo →
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{A} \to \mathcal{B}
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/additive+functor"} additive functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ac
                    %mo ⊂
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} Ac \subset \mathcal{A}
              be the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              on the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/acyclic+objects"} acyclic objects
            %ul
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℐ
                        %mo ≔
                        %mi Ac
                      %annotation{:encoding => "application/x-tex"} \mathcal{I} \coloneqq Ac
                  is a subcategory of
                  = succeed "-injective" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/right+exact+functor"} right exact
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒫
                        %mo ≔
                        %mi Ac
                      %annotation{:encoding => "application/x-tex"} \mathcal{P} \coloneqq Ac
                  is a subcategory of
                  = succeed "-projective" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
          .proof
            %h6#proof Proof
            %p
              Consider the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is left exact. The other case works dually.
            %p
              The first condition of def.
              %a.maruku-ref{:href => "#FInjectives"}
              is satisfied because every
              %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective object
              is an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %a.existingWikiWord{:href => "/nlab/show/acyclic+object"} acyclic object
              and by assumption there are enough of these.
            %p
              For the second and third condition of def.
              %a.maruku-ref{:href => "#FInjectives"}
              use that there is the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
              prop.
              %a.maruku-ref{:href => "#LongExactSequenceOfRightDerivedFunctorsFromShortExactSequence"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi A
                    %mo →
                    %mi B
                    %mo →
                    %mi C
                    %mo →
                    %msup
                      %mi R
                      %mn 1
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi R
                      %mn 1
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi R
                      %mn 1
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi R
                      %mn 2
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi R
                      %mn 2
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi R
                      %mn 2
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo ⋅
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to A \to B \to C \to R^1 F(A) \to R^1 F(B) \to R^1 F(C) \to R^2 F(A) \to R^2 F(B) \to R^2 F(C) \to \cdot
                    \\,.
            %p
              For the second condition, by assumption on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              and definition of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %a.existingWikiWord{:href => "/nlab/show/acyclic+object"} acyclic object
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi n
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} R^n F(A) \simeq 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi n
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} R^n F(B) \simeq 0
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
              and hence short exact sequences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mn 0
                    %mo →
                    %msup
                      %mi R
                      %mi n
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to 0 \to R^n F(C) \to 0
            %p
              which imply that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi n
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} R^n F(C)\simeq 0
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is acyclic.
            %p
              Similarly, the third condition is equivalent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi R
                        %mn 1
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} R^1 F(A) \simeq 0
          #FAcyclicResolution.num_example
            %h6#example_2 Example
            %p
              The
              = succeed "-projective/injective" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %a.existingWikiWord{:href => "/nlab/show/acyclic+objects"} acyclic objects
              as in example
              %a.maruku-ref{:href => "#FAcyclicObjectsAreFProjectiveObjects"}
              are called
              = succeed "." do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  \-acyclic resolutions
          %h3#ResolutionOfAChainComplex Resolution of a chain complex
          %p
            The above definition
            %a.maruku-ref{:href => "#ProjectiveResolution"}
            of a projective resolution of an object has an immediate generalization to resolutions of chain complexes.
          #ProjectiveResolutionOfChainComplex.num_defn
            %h6#definition_7 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet \in Ch_\bullet(\mathcal{A})
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              %strong projective resolution
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              of chain complexes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi Q
                      %mrow
                        %mo •
                        %mo ,
                        %mn 2
                    %mo →
                    %msub
                      %mi Q
                      %mrow
                        %mo •
                        %mo ,
                        %mn 1
                    %mo →
                    %msub
                      %mi Q
                      %mrow
                        %mo •
                        %mo ,
                        %mn 0
                    %mo →
                    %msub
                      %mi C
                      %mo •
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to Q_{\bullet,2}
                    \\to Q_{\bullet,1}
                    \\to  Q_{\bullet,0}
                    \\to C_\bullet
                    \\to 0
            %p
              such that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mrow
                        %mi n
                        %mo ,
                        %mo •
                    %mo →
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Q_{n,\bullet} \to C_n
              is a projective resolution of the object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi n
                    %annotation{:encoding => "application/x-tex"} C_n
              = succeed "." do
                %a.maruku-ref{:href => "#ProjectiveResolution"}
          .num_remark
            %h6#remark_3 Remark
            %p
              A projective resolution as above may in particular also be regarded as a
              %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                  %annotation{:encoding => "application/x-tex"} Q_{\bullet, \bullet}
              equipped with a morphism of double complex to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              regarded as a vertically constant double complex.
          %p For purposes of computations one is often interested in the following stronger notion.
          %p
            For any chain complex
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mo •
                  %annotation{:encoding => "application/x-tex"} Z_\bullet
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mo •
                  %annotation{:encoding => "application/x-tex"} B_\bullet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo •
                %annotation{:encoding => "application/x-tex"} H_\bullet
            for the graded objects of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
            %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homology+groups"} homology groups
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
          #FullyProjectiveResolutionOfChainComplex.num_defn
            %h6#definition_8 Definition
            %p
              A projective resolution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo →
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} Q_{\bullet,\bullet} \to C_\bullet
              of a chain complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mo •
                    %annotation{:encoding => "application/x-tex"} C_\bullet
              = succeed "," do
                %a.maruku-ref{:href => "#ProjectiveResolutionOfChainComplex"}
              %strong fully projective
              (or
              = succeed ")" do
                %strong proper
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the induced sequence of (horizontal)
              %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi Z
                      %mrow
                        %mo •
                        %mo ,
                        %mn 2
                    %mo →
                    %msub
                      %mi Z
                      %mrow
                        %mo •
                        %mo ,
                        %mn 1
                    %mo →
                    %msub
                      %mi Z
                      %mrow
                        %mo •
                        %mo ,
                        %mn 0
                    %mo →
                    %mi Z
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    Z_{\bullet,2}
                    \\to
                    Z_{\bullet,1}
                    \\to
                    Z_{\bullet,0}
                    \\to
                    Z(C)_\bullet
                    \\to
                    0
            %p
              and (horizontal)
              %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi B
                      %mrow
                        %mo •
                        %mo ,
                        %mn 2
                    %mo →
                    %msub
                      %mi B
                      %mrow
                        %mo •
                        %mo ,
                        %mn 1
                    %mo →
                    %msub
                      %mi B
                      %mrow
                        %mo •
                        %mo ,
                        %mn 0
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    B_{\bullet,2}
                    \\to
                    B_{\bullet,1}
                    \\to
                    B_{\bullet,0}
                    \\to
                    B(C)_\bullet
                    \\to
                    0
            %p
              and (horizontal)
              %a.existingWikiWord{:href => "/nlab/show/homology+groups"} homology groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mo •
                        %mo ,
                        %mn 2
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mo •
                        %mo ,
                        %mn 1
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mo •
                        %mo ,
                        %mn 0
                    %mo →
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    H_{\bullet,2}
                    \\to
                    H_{\bullet,1}
                    \\to
                    H_{\bullet,0}
                    \\to
                    H(C)_\bullet
                    \\to
                    0
            %p
              are each projective resolutions, def.
              = succeed "," do
                %a.maruku-ref{:href => "#ProjectiveResolution"}
          %h2#properties Properties
          %h3#ExistenceAndConstruction Existence and construction of resolutions for objects
          %p
            We first discuss the existence of injective/projective resolutions, and then the
            %a.existingWikiWord{:href => "/nlab/show/functor"} functoriality
            of their constructions.
          #ExistenceOfInjectiveResolutions.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              be an
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              with
              %a.existingWikiWord{:href => "/nlab/show/injective+object"} enough injectives
              (such as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              for some
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            %p
              Then every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{A}
              has an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/injective+resolution"} injective resolution
              = succeed "." do
                %a.maruku-ref{:href => "#InjectiveResolution"}
          .proof
            %h6#proof_2 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{A}
              be the given object. By remark
              %a.maruku-ref{:href => "#InjectiveResolutionInComponents"}
              we need to construct an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi X
                    %mo →
                    %msup
                      %mi J
                      %mn 0
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mn 0
                    %msup
                      %mi J
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mn 1
                    %msup
                      %mi J
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mn 2
                    %mi ⋯
                    %mo →
                    %msup
                      %mi J
                      %mi n
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    0 \to X \to J^0 \stackrel{d^0}{\to} J^1 \stackrel{d^1}{\to}
                    J^2 \stackrel{d^2}{\to} \cdots \to J^n \to \cdots
            %p
              such that all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mo ⋅
                  %annotation{:encoding => "application/x-tex"} J^\cdot
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/injective+objects"} injective objects
            %p
              We now construct by
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              on the degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %p
              In the first step, by the assumption of enough enjectives we find an injective object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} J^0
              and a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↪
                    %msup
                      %mi J
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    X \hookrightarrow J^0
            %p
              hence an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi X
                    %mo →
                    %msup
                      %mi J
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to X \to J^0
                    \\,.
            %p
              Assume then by induction hypothesis that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msup
                      %mi J
                      %mn 0
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mn 0
                    %mi ⋯
                    %mo →
                    %msup
                      %mi J
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %msup
                      %mi J
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    X \to J^0 \stackrel{d^0}{\to} \cdots \to J^{n-1} \stackrel{d^{n-1}}{\to} J^n
            %p
              has been constructed, where all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mo ⋅
                  %annotation{:encoding => "application/x-tex"} J^\cdot
              are injective objects. Forming the
              %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi d
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} d^{n-1}
              yields the
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi J
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %msup
                      %mi J
                      %mi n
                    %mover
                      %mo →
                      %mi p
                    %msup
                      %mi J
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi J
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to J^{n-1} \stackrel{d^{n-1}}{\to} J^n \stackrel{p}{\to} J^n/J^{n-1} \to 0
                    \\,.
            %p
              By the assumption that there are enough injectives in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              we may now again find a monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi J
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mover
                      %mo ↪
                      %mi i
                    %msup
                      %mi J
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} J^n/J^{n-1} \stackrel{i}{\hookrightarrow} J^{n+1}
              into an injective object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi J
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} J^{n+1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %msup
                      %mi J
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi d
                          %mi n
                        %mo ≔
                        %mi i
                        %mo ∘
                        %mi p
                    %msup
                      %mi J
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    J^{n-1} \stackrel{d^{n-1}}{\to} J^n \stackrel{d^n \coloneqq i \circ p}{\longrightarrow} J^{n+1}
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
              in the middle term. Therefore we now have an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi X
                    %mo →
                    %msup
                      %mi J
                      %mn 0
                    %mo →
                    %mi ⋯
                    %mo →
                    %msup
                      %mi J
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %msup
                      %mi J
                      %mi n
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mi n
                    %msup
                      %mi J
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    0 \to X \to J^0 \to \cdots \to J^{n-1} \stackrel{d^{n-1}}{\to} J^n \stackrel{d^{n}}{\to} J^{n+1}
            %p
              which completes the
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              step.
          %p
            The following proposition is
            %a.existingWikiWord{:href => "/nlab/show/duality"} formally dual
            to prop.
            = succeed "." do
              %a.maruku-ref{:href => "#ExistenceOfInjectiveResolutions"}
          #ExistenceOfInjectiveResolutions.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              be an
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              with
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} enough projectives
              (such as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              for some
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            %p
              Then every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{A}
              has a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+resolution"} projective resolution
              = succeed "." do
                %a.maruku-ref{:href => "#ProjectiveResolution"}
          .proof
            %h6#proof_3 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{A}
              be the given object. By remark
              %a.maruku-ref{:href => "#ProjectiveResolutionInComponents"}
              we need to construct an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 2
                    %msub
                      %mi J
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 1
                    %msub
                      %mi J
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %msub
                      %mi J
                      %mn 0
                    %mo →
                    %mi X
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \stackrel{\partial_2}{\to}
                    J_2 \stackrel{\partial_1}{\to}
                    J_1 \stackrel{\partial_0}{\to}
                    J_0 \to X \to 0
            %p
              such that all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mo ⋅
                  %annotation{:encoding => "application/x-tex"} J_\cdot
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/projective+objects"} projective objects
            %p
              We now construct by
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              on the degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %p
              In the first step, by the assumption of enough projectives we find a projective object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} J_0
              and an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mn 0
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    J_0 \to X
            %p
              hence an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mn 0
                    %mo →
                    %mi X
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    J_0 \to X \to 0
                    \\,.
            %p
              Assume then by induction hypothesis that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi n
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %msub
                      %mi J
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo →
                    %mi ⋯
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %msub
                      %mi J
                      %mn 0
                    %mo →
                    %mi X
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    J_n \stackrel{\partial_{n-1}}{\to}
                    J_{n-1}
                    \\to
                    \\cdots
                    \\stackrel{\partial_0}{\to}
                    J_0
                    \\to
                    X
                    \\to
                    0
            %p
              has been constructed, where all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mo ⋅
                  %annotation{:encoding => "application/x-tex"} J_\cdot
              are projective objects. Forming the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \partial_{n-1}
              yields the
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi i
                    %msub
                      %mi J
                      %mi n
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %msub
                      %mi J
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to ker(\partial_{n-1})
                    \\stackrel{i}{\to}
                    J_n \stackrel{\partial_{n-1}}{\to}
                    J_{n-1}
                    \\to
                    0
                    \\,.
            %p
              By the assumption that there are enough projectives in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              we may now again find an epimorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %msub
                      %mi J
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo →
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p : J_{n+1} \to ker(\partial_{n-1})
              out of a projective object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} J_{n+1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mi n
                        %mo ≔
                        %mi i
                        %mo ∘
                        %mi p
                    %msub
                      %mi J
                      %mi n
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    J_{n+1} \stackrel{\partial_{n} \coloneqq i\circ p}{\to}
                    J_n \stackrel{\partial_{n-1}}{\to}
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
              in the middle term. Therefore we now have an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mi n
                    %msub
                      %mi J
                      %mi n
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %mi ⋯
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %msub
                      %mi J
                      %mn 0
                    %mo →
                    %mi X
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    J_{n+1}
                    \\stackrel{\partial_n}{\to}
                    J_n
                    \\stackrel{\partial_{n-1}}{\to}
                    \\cdots
                    \\stackrel{\partial_0}{\to}
                    J_0
                    \\to
                    X
                    \\to
                    0
                    \\,,
            %p
              which completes the
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              step.
          #MapsOutOfExactIntoInjectiveAreNullHomotopic.num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo •
                    %mo :
                    %msup
                      %mi X
                      %mo •
                    %mo →
                    %msup
                      %mi J
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f^\bullet : X^\bullet \to J^\bullet
              be a
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              of cochain complexes in non-negative degree, out of an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %msub
                      %mo ≃
                      %mi qi
                    %msup
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} 0 \simeq_{qi} X^\bullet
              to a degreewise injective complex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi J
                        %mo •
                    %annotation{:encoding => "application/x-tex"} J^\bullet
              %a.existingWikiWord{:href => "/nlab/show/null+homotopy"} null homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %mn 0
                    %mo ⇒
                    %msup
                      %mi f
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\eta : 0 \Rightarrow f^\bullet
          .proof
            %h6#proof_4 Proof
            %p
              By definition of
              %a.existingWikiWord{:href => "/nlab/show/chain+homotopy"} chain homotopy
              we need to construct a sequence of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi η
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo :
                    %msup
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo →
                    %msup
                      %mi J
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} (\eta^{n+1} : X^{n+1} \to J^{n})_{n \in \mathbb{N}}
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mi n
                    %mo =
                    %msup
                      %mi η
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∘
                    %msubsup
                      %mi d
                      %mi X
                      %mi n
                    %mo +
                    %msubsup
                      %mi d
                      %mi J
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ∘
                    %msup
                      %mi η
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f^n = \eta^{n+1} \circ d^n_X + d^{n-1}_J \circ \eta^n
                    \\,.
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi η
                        %mn 0
                      %mo ≔
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \eta^0 \coloneqq 0
            %p
              Then in the induction step assume that for given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              we have constructed
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi η
                      %mrow
                        %mo •
                        %mo ≤
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \eta^{\bullet \leq n}
              satisfying the above conditions.
            %p First define now
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mi n
                    %mo ≔
                    %msup
                      %mi f
                      %mi n
                    %mo −
                    %msubsup
                      %mi d
                      %mi J
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ∘
                    %msup
                      %mi η
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    g^n \coloneqq f^n - d_J^{n-1} \circ \eta^n
            %p and observe that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi g
                              %mi n
                            %mo ∘
                            %msubsup
                              %mi d
                              %mi X
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mo =
                            %msup
                              %mi f
                              %mi n
                            %mo ∘
                            %msubsup
                              %mi d
                              %mi X
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo −
                            %msubsup
                              %mi d
                              %mi J
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ∘
                            %msup
                              %mi η
                              %mi n
                            %mo ∘
                            %msubsup
                              %mi d
                              %mi X
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mi f
                              %mi n
                            %mo ∘
                            %msubsup
                              %mi d
                              %mi X
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo −
                            %msubsup
                              %mi d
                              %mi J
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ∘
                            %msup
                              %mi f
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo +
                            %msubsup
                              %mi d
                              %mi J
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ∘
                            %msubsup
                              %mi d
                              %mi J
                              %mrow
                                %mi n
                                %mo −
                                %mn 2
                            %mo ∘
                            %msup
                              %mi η
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                            %mo +
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    g^n \circ d_X^{n-1}
                    \&amp; =
                    f^n \circ d^{n-1}_X - d^{n-1}_J \circ \eta^n \circ d^{n-1}_X
                    \\\
                    \&amp; = f^n \circ d^{n-1}_X - d^{n-1}_J \circ f^{n-1}
                    + d^{n-1}_J \circ d^{n-2}_J \circ \eta^{n-1}
                    \\\
                    \&amp; = 0 + 0
                    \\\
                    \&amp; 0
                    \\end{aligned}
                    \\,.
            %p
              This means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mi n
                  %annotation{:encoding => "application/x-tex"} g^n
              factors as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi n
                    %mo →
                    %msup
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi d
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi g
                          %mi n
                    %msup
                      %mi J
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    X^n \to X^n / im(d^{n-1}_X) \stackrel{g^n}{\to} J^n
                    \\,,
            %p
              where the first map is the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            %p
              Observe then that by exactness of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X^\bullet
              the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi d
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msubsup
                          %mi d
                          %mi X
                          %mi n
                    %msup
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X^n / im(d^{n-1}_X) \stackrel{d^n_X}{\to} X^{n+1}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi X
                              %mi n
                            %mo{:stretchy => "false"} /
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi d
                              %mi X
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msubsup
                                  %mi d
                                  %mi X
                                  %mi n
                          %mtd
                            %msup
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi g
                                    %mi n
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi η
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mi J
                              %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X^n / im(d^{n-1}_X) &amp;\stackrel{d^n_X}{\to}&amp; X^{n+1}
                    \\\
                    \\downarrow^{\mathrlap{g^n}} &amp; \swarrow_{\mathrlap{\eta^{n+1}}}
                    \\\
                    J^n   }
                    \\,,
            %p
              where the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi η
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \eta^{n+1}
              may be found due to the defining
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              of the
              %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mi n
                  %annotation{:encoding => "application/x-tex"} J^n
              against the top monomorphism.
            %p
              Observing that the
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commutativity
              of this diagram is the chain homotopy condition involving
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi η
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \eta^n
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi η
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \eta^{n+1}
          .num_remark
            %h6#remark_4 Remark
            %p
              Without the assumption above that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mo •
                  %annotation{:encoding => "application/x-tex"} J^\bullet
              is injective, such a null-homotopy indeed need not exist. Basic counterexamples are discussed in the section
              %a{:href => "homotopy+category+of+chain+complexes#ChainHomotopiesThatOughtToExistButDoNot"} Chain homotopies that ought to exist but do not
              at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+chain+complexes"} homotopy category of chain complexes
          %p
            The formally dual statement of prop
            %a.maruku-ref{:href => "#MapsOutOfExactIntoInjectiveAreNullHomotopic"}
            is the following.
          #MapsProjectiveIntoExactAreNullHomotopic.num_prop
            %h6#lemma Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo :
                    %msub
                      %mi P
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet : P_\bullet \to Y_\bullet
              be a
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              of
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              in non-negative degree, into an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %msub
                      %mo ≃
                      %mi qi
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} 0 \simeq_{qi} Y_\bullet
              from a degreewise
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective
              complex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi P
                        %mo •
                    %annotation{:encoding => "application/x-tex"} P^\bullet
              %a.existingWikiWord{:href => "/nlab/show/null+homotopy"} null homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %mn 0
                    %mo ⇒
                    %msub
                      %mi f
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\eta : 0 \Rightarrow f_\bullet
          .proof
            %h6#proof_5 Proof
            %p
              This is formally dual to the proof of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#MapsOutOfExactIntoInjectiveAreNullHomotopic"}
          %p The following proposition says that, when injectively resolving objects, the morphisms between these objects lift to the resolutions, uniquely up to chain homotopy.
          #InjectiveResolutionOfCodomainRespectsMorphisms.num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              be a morphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi Y
                    %mo :
                    %mi Y
                    %mover
                      %mo →
                      %mo ∼
                    %msup
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    i_Y : Y \stackrel{\sim}{\to} Y^\bullet
            %p
              be an injective resolution of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi X
                    %mo :
                    %mi X
                    %mover
                      %mo →
                      %mo ∼
                    %msup
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    i_X : X \stackrel{\sim}{\to} X^\bullet
            %p
              any
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              that is a
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              (possibly but not necessarily an injective resolution). Then there is a
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo •
                    %mo :
                    %msup
                      %mi X
                      %mo •
                    %mo →
                    %msup
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f^\bullet : X^\bullet \to Y^\bullet
              giving a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mo ∼
                          %mtd
                            %msup
                              %mi X
                              %mo •
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mo •
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mo ∼
                          %mtd
                            %msup
                              %mi Y
                              %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\stackrel{\sim}{\to}&amp; X^\bullet
                    \\\
                    \\downarrow^{\mathrlap{f}} &amp;&amp; \downarrow^{\mathrlap{f^\bullet}}
                    \\\
                    Y &amp;\stackrel{\sim}{\to}&amp; Y^\bullet
                    }
                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              By definition of
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              we need to construct
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mi n
                    %mo :
                    %msup
                      %mi X
                      %mi n
                    %mo →
                    %msup
                      %mi Y
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} (f^n : X^n \to Y^n)_{n \in \mathbb{N}}
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi X
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msubsup
                                  %mi d
                                  %mi X
                                  %mi n
                          %mtd
                            %msup
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mi n
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mi Y
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msubsup
                                  %mi d
                                  %mi Y
                                  %mi n
                          %mtd
                            %msup
                              %mi Y
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X^{n} &amp;\stackrel{d^n_X}{\to}&amp; X^{n+1}
                    \\\
                    \\downarrow^{\mathrlap{f^n}} &amp;&amp; \downarrow^{\mathrlap{f^{n+1}}}
                    \\\
                    Y^{n} &amp;\stackrel{d^n_Y}{\to}&amp; Y^{n+1}
                    }
            %p
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commute
              (the defining condition on a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi i
                                  %mi X
                          %mtd
                            %msup
                              %mi X
                              %mn 0
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mn 0
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi i
                                  %mi Y
                          %mtd
                            %msup
                              %mi Y
                              %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\stackrel{i_X}{\to}&amp; X^0
                    \\\
                    \\downarrow^{f} &amp;&amp; \downarrow^{\mathrlap{f^0}}
                    \\\
                    Y &amp;\stackrel{i_Y}{\to}&amp; Y^0
                    }
            %p
              commutes in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              (which makes the full diagram in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch^\bullet(\mathcal{A})
              commute).
            %p
              We construct these
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo •
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} f^\bullet = (f^n)_{n \in \mathbb{N}}
              by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
            %p
              To start the induction, the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} f^0
              in the first diagram above can be found by the defining
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              of the
              %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Y^0
              against the
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mi X
                    %annotation{:encoding => "application/x-tex"} i_X
            %p
              Assume then that for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              component maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo •
                        %mo ≤
                        %mi n
                  %annotation{:encoding => "application/x-tex"} f^{\bullet \leq n}
              have been obtained such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi d
                      %mi Y
                      %mi k
                    %mo ∘
                    %msup
                      %mi f
                      %mi k
                    %mo =
                    %msup
                      %mi f
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo ∘
                    %msubsup
                      %mi d
                      %mi X
                      %mi k
                  %annotation{:encoding => "application/x-tex"} d^k_Y\circ f^k = f^{k+1}\circ d^k_X
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi k
                    %mo &lt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \leq k \lt n
              \. In order to construct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} f^{n+1}
              consider the following diagram, which we will describe/construct stepwise from left to right:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi X
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %msup
                              %mi X
                              %mi n
                            %mo{:stretchy => "false"} /
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi d
                              %mi X
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ↪
                              %mrow
                                %msubsup
                                  %mi d
                                  %mi X
                                  %mi n
                          %mtd
                            %msup
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mi n
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi g
                                    %mi n
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi h
                                    %mi n
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mi Y
                              %mi n
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %msubsup
                                  %mi d
                                  %mi Y
                                  %mi n
                          %mtd
                            %msup
                              %mi Y
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X^n &amp;\stackrel{}{\to}&amp; X^n/im(d^{n-1}_X) &amp;\stackrel{d^n_X}{\hookrightarrow}&amp; X^{n+1}
                    \\\
                    {}^{\mathllap{f^n}}\downarrow &amp; \searrow^{\mathrlap{g^n}}
                    \&amp; \downarrow^{\mathrlap{h^n}} &amp; \swarrow_{\mathrlap{f^{n+1}}}
                    \\\
                    Y^n &amp;\underset{d^n_Y}{\to}&amp; Y^{n+1}
                    }
                    \\,.
            %p
              Here the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f^n
              on the left is given by induction assumption and we define the diagonal morphism to be the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mi n
                    %mo ≔
                    %msubsup
                      %mi d
                      %mi Y
                      %mi n
                    %mo ∘
                    %msup
                      %mi f
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g^n \coloneqq d^n_Y \circ f^n
                    \\,.
            %p
              Observe then that by the chain map property of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo •
                        %mo ≤
                        %mi n
                  %annotation{:encoding => "application/x-tex"} f^{\bullet \leq n}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi d
                      %mi Y
                      %mi n
                    %mo ∘
                    %msup
                      %mi f
                      %mi n
                    %mo ∘
                    %msubsup
                      %mi d
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo =
                    %msubsup
                      %mi d
                      %mi Y
                      %mi n
                    %mo ∘
                    %msubsup
                      %mi d
                      %mi Y
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ∘
                    %msup
                      %mi f
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    d^n_Y \circ f^n \circ d^{n-1}_X = d^n_Y \circ d^{n-1}_Y \circ f^{n-1} = 0
            %p
              and therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mi n
                  %annotation{:encoding => "application/x-tex"} g^n
              factors through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi d
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^n/im(d^{n-1}_X)
              via some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi h
                      %mi n
                  %annotation{:encoding => "application/x-tex"} h^n
              as indicated in the middle of the above diagram. Finally the morphism on the top right is a monomorphism by the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X^{\bullet}
              is
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
              in positive degrees (being
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphic
              to a complex concentrated in degree 0) and so a lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} f^{n+1}
              as shown on the far right of the diagram exists by the defining lifting property of the injective object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Y
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} Y^{n+1}
            %p
              The total outer diagram now commutes, being built from commuting sub-diagrams, and this is the required chain map property of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo •
                        %mo ≤
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} f^{\bullet \leq n+1}
              This completes the induction step.
          #HomotopyUniquenessOfResolutionOfMorphism.num_prop
            %h6#proposition_5 Proposition
            %p
              The morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet
              in prop.
              %a.maruku-ref{:href => "#InjectiveResolutionOfCodomainRespectsMorphisms"}
              is the unique one up to
              %a.existingWikiWord{:href => "/nlab/show/chain+homotopy"} chain homotopy
              making the given diagram commute.
          .proof
            %h6#proof_7 Proof
            %p
              Given two chain maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi g
                      %mn 1
                      %mo •
                    %mo ,
                    %msubsup
                      %mi g
                      %mo •
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} g_1^\bullet, g^2_\bullet
              making the diagram commute, a
              %a.existingWikiWord{:href => "/nlab/show/chain+homotopy"} chain homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi g
                      %mn 1
                      %mo •
                    %mo ⇒
                    %msubsup
                      %mi g
                      %mn 2
                      %mo •
                  %annotation{:encoding => "application/x-tex"} g_1^\bullet \Rightarrow g_2^\bullet
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/null+homotopy"} null homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ⇒
                    %msubsup
                      %mi g
                      %mn 2
                      %mo •
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msubsup
                      %mi g
                      %mn 1
                      %mo •
                  %annotation{:encoding => "application/x-tex"} 0 \Rightarrow g_2^\bullet - g_1^\bullet
              of the difference, which sits in a square of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %munderover
                              %mo →
                              %mrow
                                %msup
                                  %mi h
                                  %mo •
                              %mo ∼
                          %mtd
                            %msup
                              %mi X
                              %mo •
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mn 0
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mo •
                                  %mo ≔
                                  %msubsup
                                    %mi g
                                    %mn 2
                                    %mo •
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %msubsup
                                    %mi g
                                    %mn 1
                                    %mo •
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mo ∼
                          %mtd
                            %msup
                              %mi Y
                              %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\underoverset{h^\bullet}{\sim}{\to}&amp; X^\bullet
                    \\\
                    \\downarrow^{\mathrlap{0}} &amp;&amp; \downarrow^{\mathrlap{f^\bullet \coloneqq g_2^\bullet - g_1^\bullet}}
                    \\\
                    Y &amp;\stackrel{\sim}{\to}&amp; Y^\bullet
                    }
