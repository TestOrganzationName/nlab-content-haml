                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                \-
                %a.existingWikiWord{:href => "/nlab/show/acyclic+resolutions"} acyclic resolutions
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mo ,
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} \mathcal{A}, \mathcal{B}
            be
            %a.existingWikiWord{:href => "/nlab/show/abelian+categories"} abelian categories
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒜
                  %mo →
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} F \colon \mathcal{A} \to \mathcal{B}
            be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/additive+functor"} additive functor
          #FInjectives.num_defn
            %h6#definition_4 Definition
            %p
              Assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact
              %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℐ
                    %mo ⊂
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{I} \subset \mathcal{A}
              is called
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                \-injective
              (or: consisting of
              = succeed "-injective" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            %ol
              %li
                %p
                  for every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ∈
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} A \in \mathcal{A}
                  there is a
                  %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo →
                        %mover
                          %mi A
                          %mo{:stretchy => "false"} ˜
                      %annotation{:encoding => "application/x-tex"} A \to \tilde A
                  into an object
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi A
                            %mo{:stretchy => "false"} ˜
                          %mo ∈
                          %mi ℐ
                          %mo ⊂
                          %mi 𝒜
                        %annotation{:encoding => "application/x-tex"} \tilde A \in \mathcal{I} \subset \mathcal{A}
              %li
                %p
