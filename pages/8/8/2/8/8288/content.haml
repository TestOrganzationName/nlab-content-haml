              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/right+exact+functor"} right exact
              %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo ⊂
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{P} \subset \mathcal{A}
              is called
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                \-projective
              (or: consisting of
              = succeed "-projective" do
