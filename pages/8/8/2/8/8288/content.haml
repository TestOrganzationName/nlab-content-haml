          .num_prop
            %h6#proposition_12 Proposition
            %p
              The construction in def.
              %a.maruku-ref{:href => "#ProjectiveResolutionForZAsZGModule"}
              defines
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
