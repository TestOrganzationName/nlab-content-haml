                        %mi i
                        %mo +
                        %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi g
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi g
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} ]
