                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0 \to A \to B \to C \to 0
              a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              in an
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/injective+object"} enough injectives
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of cochain complexes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %mi C
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi A
                              %mo •
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi B
                              %mo •
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi C
                              %mo •
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    0 &amp;\to&amp; A &amp;\to&amp; B &amp;\to&amp; C &amp;\to&amp; 0
                    \\\
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{}}
                    \\\
                    0 &amp;\to&amp; A^\bullet &amp;\to&amp; B^\bullet &amp;\to&amp; C^\bullet &amp;\to&amp; 0
                    }
            %p where
            %ul
              %li each vertical morphism is an injective resolution;
            %p and in addition
            %ul
              %li the bottom row is again a short exact sequence of cochain complexes.
          .proof
            %h6#proof_9 Proof
            %p
              To construct this, let for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi n
                    %mo ≔
                    %msup
                      %mi A
                      %mi n
                    %mo ⊕
                    %msup
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    B^n \coloneqq A^n \oplus C^n
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              and let the bottom horizontal morphisms be the canonical inclusion and projection maps of the direct sum.
            %p
              Let then furthermore (in
              %a.existingWikiWord{:href => "/nlab/show/matrix+calculus"} matrix calculus
              notation)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi j
                      %mn 0
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msubsup
                                %mi j
                                %mi A
                                %mn 0
                          %mtr
                            %mtd
                              %msubsup
                                %mi j
                                %mi B
                                %mn 0
                      %mo )
                    %mo :
                    %mi B
                    %mo →
                    %msup
                      %mi A
                      %mn 0
                    %mo ⊕
                    %msup
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    j^0 =
                    \\left(
                    \\array{
                    j^0_A
                    \\\
                    j^0_B
                    }
                    \\right)
                    \: B \to A^0 \oplus C^0
            %p be given in the second component by the given composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi j
                      %mi B
                      %mn 0
                    %mo :
                    %mi B
                    %mo →
                    %mi C
                    %mo →
                    %msup
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    j^0_B : B \to C \to C^0
            %p and in the first component we take
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi j
                      %mi A
                      %mn 0
                    %mo :
                    %mi B
                    %mo →
                    %msup
                      %mi A
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    j^0_A : B \to A^0
            %p to be given by a lift in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi A
                              %mn 0
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi j
                                    %mi A
                                    %mn 0
                        %mtr
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\to&amp; A^0
                    \\\
                    \\downarrow &amp; \nearrow_{\mathrlap{j^0_A}}
                    \\\
                    B
                    }
                    \\,,
            %p
              which exists by the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              of the
              %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} A^0
              (since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A^\bullet
              is an injective resolution) against the
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \to B
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            %p Let the differentials be given by (…).
            %p
              This establishes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi j
                      %mo •
                  %annotation{:encoding => "application/x-tex"} j^\bullet
              such that the above diagram commutes and the bottom row is degreewise a short exact sequence, in fact a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split exact sequence
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi j
                      %mo •
                  %annotation{:encoding => "application/x-tex"} j^\bullet
              is indeed a quasi-isomorphism, consider the
              %a.existingWikiWord{:href => "/nlab/show/homology+long+exact+sequence"} homology long exact sequence
              associated to the short exact sequence of cochain complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi A
                      %mo •
                    %mo →
                    %msup
                      %mi B
                      %mo •
                    %mo →
                    %msup
                      %mi C
                      %mo •
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0 \to A^\bullet \to B^\bullet \to C^\bullet \to 0
              (…).
          %h3#ExistenceAndConstructionOfResolutionsOfComplexes Existence and construction of resolutions of complexes
          .num_defn
            %h6#definition_9 Definition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              has
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+object"} enough projectives
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet \in Ch_\bullet(\mathcal{A})
              has a fully projective (proper) resolution, def.
              = succeed "." do
                %a.maruku-ref{:href => "#FullyProjectiveResolutionOfChainComplex"}
          .proof
            %h6#proof_10 Proof
            %p
              Notice that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              we have
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/chains"} chains
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
              %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
              and
              %a.existingWikiWord{:href => "/nlab/show/homology+groups"} homology groups
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi B
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Z
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to B_n(C) \to Z_n(C) \to H_n(C) \to 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi Z
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi C
                      %mi n
                    %mo →
                    %msub
                      %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to Z_n(C) \to C_n \to B_{n-1}(C) \to 0
                    \\,.
            %p
              Now by prop.
              %a.maruku-ref{:href => "#ExistenceOfInjectiveResolutions"}
              we find for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              projective resolutions of the objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_n(C)
              and
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B_n(C)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo ,
                        %mo •
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_{n,\bullet} \stackrel{\simeq_{qi}}{\to} H_n(C)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mrow
                        %mi n
                        %mo ,
                        %mo •
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %msub
                      %mi B
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    B_{n,\bullet} \stackrel{\simeq_{qi}}{\to} B_n(C)
                    \\,.
            %p
              Moreover, by prop.
              %a.maruku-ref{:href => "#ProjectiveResolutionOfExactSequenceByExactSequence"}
              we find for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              a projective resolution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mrow
                        %mi p
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %msub
                      %mi Z
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z_{p,\bullet}(C) \stackrel{\simeq_{qi}}{\to} Z_n(C)
              of the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z_p(C)
              such that its fits into a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of chain complexes with the previous two chosen resolutions:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi B
                      %mrow
                        %mi n
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Z
                      %mrow
                        %mi n
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to B_{n,\bullet}(C) \to Z_{n,\bullet}(C) \to H_{n,0}(C) \to 0
                    \\,.
            %p
              Analogously, we find for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              a projective resolution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mi n
                        %mo ,
                        %mo •
                    %mo →
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} C_{n,\bullet} \to C_n
              that sits in a short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi Z
                      %mrow
                        %mi n
                        %mo ,
                        %mo •
                    %mo →
                    %msub
                      %mi C
                      %mrow
                        %mi n
                        %mo ,
                        %mo •
                    %mo →
                    %msub
                      %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                        %mo ,
                        %mo •
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to Z_{n,\bullet} \to C_{n,\bullet} \to B_{n+1,\bullet} \to 0
                    \\,.
            %p Using the exactness of these sequences one checks now that
            %ol
              %li
                %p
                  The
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi C
                          %mrow
                            %mi n
                            %mo ,
                            %mo •
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi n
                            %mo ∈
                            %mi ℕ
                      %annotation{:encoding => "application/x-tex"} \{C_{n,\bullet}\}_{n \in \mathbb{N}}
                  arrange into a
                  %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
                  by taking the horizontal differential to be the composite
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mrow
                            %mi n
                            %mo ,
                            %mi k
                        %mo →
                        %msub
                          %mi B
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                            %mo ,
                            %mi k
                        %mo ↪
                        %msub
                          %mi Z
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                            %mo ,
                            %mi k
                        %mo →
                        %msub
                          %mi C
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                            %mo ,
                            %mi k
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        C_{n,k} \to B_{n+1,k} \hookrightarrow Z_{n+1,k} \to C_{n+1,k}
                        \\,;
              %li
                %p
                  this
                  %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mrow
                            %mo •
                            %mo ,
                            %mo •
                      %annotation{:encoding => "application/x-tex"} C_{\bullet,\bullet}
                  is indeed a fully projective resolution of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi C
                            %mo •
                        %annotation{:encoding => "application/x-tex"} C_\bullet
          %h3#FunctorialResolutions Functorial resolutions and derived functors
          %p
            We discuss how the injective/projective resolutions constructed in
            %em
              %a{:href => "#ExistenceAndConstruction"} Existence and construction
            are
            %a.existingWikiWord{:href => "/nlab/show/functor"} functorial
            if regarded in the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+chain+complexes"} homotopy category of chain complexes
            and how this yields the construction of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/derived+functors+in+homological+algebra"} derived functors in homological algebra
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒦
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi 𝒦
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{K}^{+}(\mathcal{A}) \hookrightarrow \mathcal{K}(\mathcal{A})
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+chain+complexes"} homotopy category of chain complexes
            on the one bounded above or bounded below, respectively. Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒦
                    %mo +
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℐ
                    %mi 𝒜
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msup
                    %mi 𝒦
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{K}^+(\mathcal{I}_{\mathcal{A}})
                  \\hookrightarrow
                  \\mathcal{K}^+(\mathcal{A})
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            on the degreewise
            %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective
            complexes, and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒦
                    %mo −
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒫
                    %mi 𝒜
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msup
                    %mi 𝒦
                    %mo −
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{K}^-(\mathcal{P}_{\mathcal{A}})
                  \\hookrightarrow
                  \\mathcal{K}^-(\mathcal{A})
          %p
            for the full subcategory on the degreewise
            %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective
            objects.
          #InjectiveResolutionFunctors.num_theorem
            %h6#theorem Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              has
              %a{:href => "injective+object#EnoughInjectives"} enough injectives
              then there exists a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %mi 𝒜
                    %mo →
                    %msup
                      %mi 𝒦
                      %mo +
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℐ
                      %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    P : \mathcal{A} \to \mathcal{K}^+(\mathcal{I}_{\mathcal{A}})
            %p
              together with a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi P
                    %mo ≃
                    %msub
                      %mi id
                      %mi 𝒜
                  %annotation{:encoding => "application/x-tex"}
                    H^0(-) \circ P \simeq id_{\mathcal{A}}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi P
                    %mo ≃
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^{n \geq 1}(-) \circ P \simeq 0
                    \\,.
          .proof
            %h6#proof_11 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#ExistenceOfInjectiveResolutions"}
              every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo •
                    %mo ∈
                    %msup
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^\bullet \in Ch^\bullet(\mathcal{A})
              has an injective resolution. Proposition
              %a.maruku-ref{:href => "#InjectiveResolutionOfCodomainRespectsMorphisms"}
              says that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msup
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X \to X^\bullet
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msup
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ˜
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X \to \tilde X^\bullet
              two resolutions the there is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo •
                    %mo →
                    %msup
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ˜
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X^\bullet \to \tilde X^\bullet
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒦
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}^+()
              and prop.
              %a.maruku-ref{:href => "#HomotopyUniquenessOfResolutionOfMorphism"}
              says that this morphism is unique in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒦
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mi 𝒜
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{K}^+(\mathcal{A})
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒦
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}^+(\mathcal{A})
              (since the composite with the reverse lifted morphism, also being unique, has to be the identity).
            %p
              So choose one such injective resolution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} P(X)^\bullet
              for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X^\bullet
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              any morphism in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %a.maruku-ref{:href => "#ExistenceOfInjectiveResolutions"}
              again says that it can be lifted to a morphism between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} P(X)^\bullet
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} P(Y)^\bullet
              and proposition
              %a.maruku-ref{:href => "#InjectiveResolutionOfCodomainRespectsMorphisms"}
              says that there is a unique such image in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒦
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}^+(\mathcal{A})
              for morphism making the given diagram commute.
            %p
              This implies that this assignment of morphisms is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functorial
          %p Dually we have:
          #ProjectiveResolutionFunctors.num_theorem
            %h6#theorem_2 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              has
              %a{:href => "projectice+object#EnoughInjectives"} enough projectives
              then there exists a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo :
                    %mi 𝒜
                    %mo →
                    %msup
                      %mi 𝒦
                      %mo −
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒫
                      %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Q : \mathcal{A} \to \mathcal{K}^-(\mathcal{P}_{\mathcal{A}})
            %p
              together with a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi P
                    %mo ≃
                    %msub
                      %mi id
                      %mi 𝒜
                  %annotation{:encoding => "application/x-tex"}
                    H_0(-) \circ P \simeq id_{\mathcal{A}}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi P
                    %mo ≃
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_{n \geq 1}(-) \circ P \simeq 0
                    \\,.
          %p
            This is sufficient for the definition and construction of (non-total)
            %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
            in the next definition
            = succeed "." do
              %a.maruku-ref{:href => "#RightDerivedFunctorOfLeftExactFunctor"}
          .num_defn
            %h6#definition_10 Definition
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/additive+functor"} additive functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi 𝒜
                      %mo →
                      %mi 𝒜
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} F : \mathcal{A} \to \mathcal{A}'
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ch_\bullet(F) \colon Ch_\bullet(\mathcal{A}) \to Ch_\bullet(\mathcal{A}')
            %p
              between
              %a.existingWikiWord{:href => "/nlab/show/categories+of+chain+complexes"} categories of chain complexes
              (its “prolongation”) by applying it to each
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              and to all the diagrams in the definition of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              %a.existingWikiWord{:href => "/nlab/show/chain+homotopies"} chain homotopies
              and hence it passes to the quotient given by the strong
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+chain+complexes"} homotopy category of chain complexes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒦
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒦
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒦
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{K}(F) \colon \mathcal{K}(\mathcal{A}) \to \mathcal{K}(\mathcal{A}')
                    \\,.
          .num_remark
            %h6#remark_5 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}'
              have
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+object"} enough projectives
              %a.existingWikiWord{:href => "/nlab/show/derived+categories"} derived categories
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒟
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi 𝒦
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒫
                      %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}_\bullet(\mathcal{A})
                    \\simeq
                    \\mathcal{K}_\bullet(\mathcal{P}_{\mathcal{A}})
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒟
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi 𝒦
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℐ
                      %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}^\bullet(\mathcal{A}) \simeq \mathcal{K}^\bullet(\mathcal{I}_{\mathcal{A}})
            %p
              etc. One wants to accordingly
              %em derive
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒟
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi 𝒟
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}_\bullet(\mathcal{A}) \to \mathcal{D}_\bullet(\mathcal{A})
              between these derived categories. It is immediate to achive this on the domain category, there we can simply precompose and form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo →
                    %msub
                      %mi 𝒟
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi 𝒦
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒫
                      %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi 𝒦
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi 𝒦
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} )
                    %mi 𝒦
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{A}
                    \\to
                    \\mathcal{D}_\bullet(\mathcal{A})
                    \\simeq
                    \\mathcal{K}(\mathcal{P}_{\mathcal{A}})
                    \\hookrightarrow
                    \\mathcal{K}(\mathcal{A})
                    \\stackrel{\mathcal{K}(F)}{\to}
                    \\mathcal{K}(\mathcal{A}')
                    \\,.
            %p
              But the resulting composite lands in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒦
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}(\mathcal{A}')
              and in general does not factor through the inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒟
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi 𝒜
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi 𝒦
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒫
                        %mrow
                          %mi 𝒜
                          %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi 𝒦
                      %mo{:stretchy => "false"} (
                      %mi 𝒜
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}_\bullet(\mathcal{A}') = \mathcal{K}(\mathcal{P}_{\mathcal{A}'}) \hookrightarrow \mathcal{K}(\mathcal{A}')
            %p
              By applying a projective resolution functor
              = succeed "," do
                %em on chain complexes
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
