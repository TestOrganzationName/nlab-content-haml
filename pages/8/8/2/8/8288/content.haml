                      %mrow
                        %mn 0
                        %mo →
                        %mi A
                        %mo →
                        %mi B
                        %mo →
                        %mi C
                        %mo →
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0 \to A \to B \to C \to 0
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
