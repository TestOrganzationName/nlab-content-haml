                  %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo →
                        %mi A
                        %mo →
                        %mi B
                        %mo →
                        %mi C
                        %mo →
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0 \to A \to B \to C \to 0
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                        %mo ∈
                        %mi ℐ
