            %p
              be given by sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} 1 \in \mathbb{Z}
              to the single basis element in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Q
                        %mn 0
                        %mi u
                      %mo ≔
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi G
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} [
                      %mo *
                      %mo{:stretchy => "false"} ]
                      %mo ≃
                      %mi ℤ
