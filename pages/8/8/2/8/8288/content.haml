                            %mi C
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    0 &amp;\to&amp; A_\bullet &amp;\to&amp; B_\bullet &amp;\to&amp; C_\bullet &amp;\to&amp; 0
                    \\\
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{f_\bullet}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{g_\bullet}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{h_\bullet}}
                    \\\
                    0 &amp;\to&amp; A &amp;\stackrel{i}{\to}&amp; B &amp;\stackrel{p}{\to}&amp; C &amp;\to&amp; 0
                    }
            %p where
            %ul
              %li each vertical morphism is a projective resolution;
            %p and in addition
            %ul
              %li the top row is again a short exact sequence of chain complexes.
          %p
            This appears for instance in (
            %a{:href => "#May"}> May, lemma 3.4
            ) or (
            %a{:href => "#Murfet"}> Murfet, cor. 33
            ).
          .proof
            %h6#proof_8 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#ExistenceOfInjectiveResolutions"}
              we can choose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mo •
                    %annotation{:encoding => "application/x-tex"} h_\bullet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mo •
                  %annotation{:encoding => "application/x-tex"} g_\bullet
              such as to obtain a short exact sequence of chain complexes, hence degreewise a short exact sequence, in the two row.
            %p
              To construct this, let for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi n
                    %mo ≔
                    %msub
                      %mi A
                      %mi n
                    %mo ⊕
                    %mi C
                    %mo :
                    %mi n
                  %annotation{:encoding => "application/x-tex"}
                    B_n \coloneqq A_n \oplus C:n
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              and let the top horizontal morphisms be the canonical inclusion and projection maps of the direct sum.
            %p
              Let then furthermore (in
              %a.existingWikiWord{:href => "/nlab/show/matrix+calculus"} matrix calculus
              notation)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 0
                    %mo =
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi j
                                %mn 0
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi A
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi j
                                %mn 0
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi B
                      %mo )
                    %mo :
                    %msub
                      %mi A
                      %mn 0
                    %mo ⊕
                    %msub
                      %mi C
                      %mn 0
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    g_0 =
                    \\left(
                    \\array{
                    (j_0)_A
                    \&amp;
                    (j_0)_B
                    }
                    \\right)
                    \: A_0 \oplus C_0 \to B
            %p be given in the first component by the given composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 0
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi A
                    %mo :
                    %msub
                      %mi A
                      %mn 0
                    %mo ⊕
                    %msub
                      %mi C
                      %mn 0
                    %mover
                      %mo →
                      %mrow
                    %msub
                      %mi A
                      %mn 0
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mn 0
                    %mi A
                    %mover
                      %mo ↪
                      %mi i
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    (g_0)_A : A_0 \oplus C_0 \stackrel{}{\to} A_0 \stackrel{f_0}{\to} A \stackrel{i}{\hookrightarrow} B
            %p and in the second component we take
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi j
                      %mn 0
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi C
                    %mo :
                    %msub
                      %mi A
                      %mn 0
                    %mo ⊕
                    %msub
                      %mi C
                      %mn 0
                    %mo →
                    %msub
                      %mi C
                      %mn 0
                    %mover
                      %mo →
                      %mi ζ
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    (j_0)_C : A_0 \oplus C_0 \to C_0 \stackrel{\zeta}{\to} B
            %p to be given by a lift in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi ζ
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mn 0
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi h
                                  %mn 0
                          %mtd
                            %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; B
                    \\\
                    \&amp; {}^{\mathllap{\zeta}}\nearrow &amp; \downarrow^{\mathrlap{p}}
                    \\\
                    C_0 &amp;\stackrel{h_0}{\to}&amp; C
                    }
                    \\,,
            %p
              which exists by the
              %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
              of the
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} C_0
              (since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              is a projective resolution) against the
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} p : B \to C
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            %p In total this gives in degree 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
