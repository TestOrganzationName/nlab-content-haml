                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ,
                        %mi C
                        %mo ∈
                        %mi 𝒫
                        %mo ⊂
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} B, C \in \mathcal{P} \subset \mathcal{A}
                  also
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo ∈
                          %mi 𝒫
                          %mo ⊂
                          %mi 𝒜
                        %annotation{:encoding => "application/x-tex"} A \in \mathcal{P} \subset \mathcal{A}
              %li
                %p
                  for every
                  %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
