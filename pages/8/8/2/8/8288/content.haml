                  %annotation{:encoding => "application/x-tex"} g_1 \in G \hookrightarrow \mathbb{Z}[G]
              times the basis element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
