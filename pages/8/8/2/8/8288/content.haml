                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} Q^u_0 \coloneqq \mathbb{Z}[G][*] \simeq \mathbb{Z}[G]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
