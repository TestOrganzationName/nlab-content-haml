                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_{n-1} (g_1, \cdots, g_n)
                    \\coloneqq
                    g_1 [g_2, \cdots, g_n]
                    +
                    \\sum_{i = 1}^{n-1} (-1)^i [g_1, \cdots, g_i g_{i+1}, g_{i+2}, \cdots, g_n]
                    +
