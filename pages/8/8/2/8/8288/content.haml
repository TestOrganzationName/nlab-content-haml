                        %mi n
                      %mi F
                    %annotation{:encoding => "application/x-tex"} R^n F
          %p
            We now discuss how the derived functor of an additive functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            may also be computed not necessarily with genuine injective/projective resolutions, but with (just)
            = succeed "-injective/" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "-projective" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "-acyclic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "." do
              %a{:href => "#FResolutions"} above
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            be an
            %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/injective+object"} enough injectives
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒜
                  %mo →
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} F \colon \mathcal{A} \to \mathcal{B}
            be an
            %a.existingWikiWord{:href => "/nlab/show/additive+functor"} additive
            %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact functor
            with
            %a.existingWikiWord{:href => "/nlab/show/right+derived+functor"} right derived functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mo •
                    %mi F
                  %annotation{:encoding => "application/x-tex"} R_\bullet F
            = succeed "." do
              %a.maruku-ref{:href => "#RightDerivedFunctorOfLeftExactFunctor"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℐ
                  %mo ⊂
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{I} \subset \mathcal{A}
            be a subcategory of
            = succeed "-injective" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "." do
              %a.maruku-ref{:href => "#FInjectives"}
          #FPreservesNullnessOfFInjectiveComplexes.num_lemma
            %h6#lemma_4 Lemma
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo •
                    %mo ∈
                    %msup
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℐ
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A^\bullet \in Ch^\bullet(\mathcal{I}) \subset Ch^\bullet(\mathcal{A})
              is
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphic
              to 0,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    X^\bullet \stackrel{\simeq_{qi}}{\to} 0
            %p
              then also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℬ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(X^\bullet) \in Ch^\bullet(\mathcal{B})
              is quasi-isomorphic to 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F(X^\bullet) \stackrel{\simeq_{qi}}{\to} 0
                    \\,.
          .proof
            %h6#proof_15 Proof
            %p
              Consider the following collection of
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
              obtained from the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X^\bullet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi X
                      %mn 0
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mn 0
                    %msup
                      %mi X
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mn 1
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to X^0 \stackrel{d^0}{\to} X^1 \stackrel{d^1}{\to} im(d^1) \to 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi X
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mn 2
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to im(d^1) \to X^2 \stackrel{d^2}{\to} im(d^2) \to 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi X
                      %mn 3
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mn 3
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to im(d^2) \to X^3 \stackrel{d^3}{\to} im(d^3) \to 0
            %p
              and so on. Going by
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              through this list and using the second condition in def.
              %a.maruku-ref{:href => "#FInjectives"}
              we have that all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} im(d^n)
              are in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℐ
                    %annotation{:encoding => "application/x-tex"} \mathcal{I}
              %a.maruku-ref{:href => "#FInjectives"}
              says that all the sequences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi d
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to F(im(d^n)) \to F(X^n+1) \to F(im(d^{n+1})) \to 0
            %p
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} exact
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    0 \to F(X^0)\to F(X^1) \to F(X^2) \to \cdots
            %p
              is exact, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(X^\bullet)
              is quasi-isomorphic to 0.
          #DerivedFFromFInjectiveResolution.num_theorem
            %h6#theorem_3 Theorem
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} A \in \mathcal{A}
              an object with
              = succeed "-injective" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mo ≃
                            %mi qi
                      %msubsup
                        %mi I
                        %mi F
                        %mo •
                    %annotation{:encoding => "application/x-tex"} A \stackrel{\simeq_{qi}}{\to} I_F^\bullet
              = succeed "," do
                %a.maruku-ref{:href => "#FProjectivesResolution"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi n
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi I
                      %mi F
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    R^n F(A) \simeq H^n(F(I_F^\bullet))
            %p
              between the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.maruku-ref{:href => "#RightDerivedFunctorOfLeftExactFunctor"}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              evaluated on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              applied to the
              = succeed "-injective" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi I
                        %mi F
                        %mo •
                    %annotation{:encoding => "application/x-tex"} I_F^\bullet
          .proof
            %h6#proof_16 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#ExistenceOfInjectiveResolutions"}
              we can also find an injective resolution
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mo ≃
                            %mi qi
                      %msup
                        %mi I
                        %mo •
                    %annotation{:encoding => "application/x-tex"} A \stackrel{\simeq_{qi}}{\to} I^\bullet
              %a.maruku-ref{:href => "#InjectiveResolutionOfCodomainRespectsMorphisms"}
              there is a lift of the identity on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to a
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi I
                      %mi F
                      %mo •
                    %mo →
                    %msup
                      %mi I
                      %mo •
                  %annotation{:encoding => "application/x-tex"} I^\bullet_F \to I^\bullet
              such that the
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mo ≃
                                  %mi qi
                          %mtd
                            %msubsup
                              %mi I
                              %mi F
                              %mo •
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mo ≃
                                  %mi qi
                          %mtd
                            %msup
                              %mi I
                              %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\stackrel{\simeq_{qi}}{\to}&amp; I_F^\bullet
                    \\\
                    \\downarrow^{\mathrlap{id}} &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    A &amp;\stackrel{\simeq_{qi}}{\to}&amp; I^\bullet
                    }
            %p
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commutes
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ch
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi 𝒜
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ch^\bullet(\mathcal{A})
              %a.existingWikiWord{:href => "/nlab/show/2-out-of-3"} 2-out-of-3
              property of
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
              it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a quasi-isomorphism
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cone(f) \in Ch^\bullet(\mathcal{A})
              be the
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mo •
                    %mo →
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I^\bullet \to Cone(f)
              be the canonical
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              into it. By the explicit formulas for mapping cones, we have that
            %ol
              %li
                %p
                  there is an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi Cone
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi Cone
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} F(Cone(f)) \simeq Cone(F(f))
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cone
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msup
                          %mi Ch
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi ℐ
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msup
                          %mi Ch
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cone(f) \in Ch^\bullet(\mathcal{I})\subset Ch^\bullet(\mathcal{A})
                  (because
                  = succeed "-injective" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            %p
              The first implies that we have a
              %a.existingWikiWord{:href => "/nlab/show/homology+exact+sequence"} homology exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi I
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi I
                      %mi F
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi I
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi I
                      %mi F
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \to H^n(I^\bullet) \to H^n(I_F^\bullet) \to H^n(Cone(f)^\bullet)
                    \\to H^{n+1}(I^\bullet) \to H^{n+1}(I_F^\bullet) \to H^{n+1}(Cone(f)^\bullet) \to \cdots
                    \\,.
            %p
              Observe that with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f^\bullet
              a quasi-isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cone(f^\bullet)
              is quasi-isomorphic to 0. Therefore The second item above implies with lemma
              %a.maruku-ref{:href => "#FPreservesNullnessOfFInjectiveComplexes"}
              that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(Cone(f))
              is quasi-isomorphic to 0. This finally means that the above homology exact sequences consists of exact pieces of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi R
                      %mi n
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi I
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi I
                      %mi F
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to (R^n F(A)\coloneqq H^n(I^\bullet) \stackrel{\simeq}{\to} H^n(I_F^\bullet) \to 0
                    \\,.
          %h3#DerivedHomFunctor
            Derived Hom-functor/
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Ext
                %annotation{:encoding => "application/x-tex"} Ext
            \-functor and extensions
          %p
            Consider the
            %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/hom+functor"} hom functor
          #ExtFunctorAsRightDerivedContravariantHom.num_defn
            %h6#definition_13 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} A \in \mathcal{A}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi R
                      %mi n
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ext^n(-,A) \coloneqq R^n Hom(-,A)
            %p
              for the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+derived+functor"} right derived functor
              = succeed "." do
                %a.maruku-ref{:href => "#RightDerivedFunctorOfLeftExactFunctor"}
          %p
            We discuss the use of projective resolutions in the computation of
            = succeed "-functors" do
              %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/group+extensions"} group extensions
          #Extensions.num_defn
            %h6#definition_14 Definition
            %p
              Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ,
                      %mi G
                      %mo ∈
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} A, G \in \mathcal{A}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/extension"} extension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi A
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi G
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to A \to \hat G \to G \to 0
                    \\,.
            %p
              Two extensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ^
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \hat G_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ^
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \hat G_2
              are called
              %em equivalent
              if there is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo →
                    %msub
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ^
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f : \hat G_1 \to \hat G_2
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              such that we have a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mover
                                %mi G
                                %mo{:stretchy => "false"} ^
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                          %mtd
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mover
                                %mi G
                                %mo{:stretchy => "false"} ^
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \hat G_1
                    \\\
                    \&amp; \nearrow &amp;&amp; \searrow
                    \\\
                    A &amp;&amp;\downarrow^{\mathrlap{f}}&amp;&amp; G
                    \\\
                    \&amp; \searrow &amp;&amp; \nearrow
                    \\\
                    \&amp;&amp; \hat G_2
                    }
                    \\,.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ext
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ext(G,A)
              for the set of
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of extensions of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          #MorphismOfExtensionIsIsomorphism.num_remark
            %h6#remark_7 Remark
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/short+five+lemma"} short five lemma
              a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              as above is necessarily an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              and hence we indeed have an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
          #MapFromExtensionsToExtGroup.num_defn
            %h6#definition_15 Definition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              has
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+object"} enough projectives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Extr
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Ext
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Extr \colon Ext(G,A) \to Ext^1(G,A)
            %p
              from the group of extensions, def.
              = succeed "," do
                %a.maruku-ref{:href => "#Extensions"}
              %a.existingWikiWord{:href => "/nlab/show/Ext+functor"} Ext functor
              group as follows. Choose any projective resolution
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Y
                        %mo •
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mo ≃
                            %mi qi
                      %mi G
                    %annotation{:encoding => "application/x-tex"} Y_\bullet \stackrel{\simeq_{qi}}{\to} G
              = succeed "." do
                %a.maruku-ref{:href => "#ExistenceOfInjectiveResolutions"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi G
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} A \to \hat G \to G\to 0
              as a resolution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\cdots &amp;\to&amp; 0 &amp;\to&amp; 0 &amp;\to&amp; A &amp;\to&amp; \hat G
                    \\\
                    \&amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    \\cdots &amp;\to&amp; 0 &amp;\to&amp; 0 &amp;\to&amp; 0 &amp;\to&amp; G
                    }
            %p
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.maruku-ref{:href => "#ProjectiveResolutionInComponents"}
              %a.maruku-ref{:href => "#InjectiveResolutionOfCodomainRespectsMorphisms"}
              there exists then a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Y
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mo ∂
                                    %mn 1
                                    %mi Y
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi Y
                              %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mi c
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mo ∂
                                    %mn 0
                                    %mi Y
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi Y
                              %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mover
                              %mo →
                              %mi id
                          %mtd
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y_2 &amp;\to&amp; 0
                    \\\
                    \\downarrow^{\mathrlap{\partial_1^{Y}}} &amp;&amp; \downarrow
                    \\\
                    Y_1 &amp;\stackrel{c}{\to}&amp; A
                    \\\
                    \\downarrow^{\mathrlap{\partial_0^Y}} &amp;&amp; \downarrow
                    \\\
                    Y_0 &amp;\to&amp; \hat G
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    G &amp;\stackrel{id}{\to}&amp; G
                    }
            %p
              lifting the identity map on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              to a
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              between the two resolutions.
            %p
              By the commutativity of the top square, the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              is 1-
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Y
                        %mo •
                      %mo ,
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom(Y_\bullet,N)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ext
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %msup
                        %mi H
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Y
                        %mo •
                      %mo ,
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ext^1(G,A) \coloneqq H^1(Hom(Y_\bullet,N))
          .num_prop
            %h6#proposition_8 Proposition
            %p
              The construction of def.
              %a.maruku-ref{:href => "#MapFromExtensionsToExtGroup"}
