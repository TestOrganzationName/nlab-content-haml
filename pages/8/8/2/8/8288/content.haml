            %p be given on basis elements by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi g
