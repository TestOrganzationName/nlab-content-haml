                    \\,.
            %p In the lowest degrees we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∘
                    %msub
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %msub
                      %mi id
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon \circ s_{-1} = id_{\mathbb{Z}}
            %p because
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mo *
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon(s_{-1}(1)) = \epsilon([*]) = \epsilon(e) = 1
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mn 0
                    %mo ∘
                    %msub
                      %mi s
                      %mn 0
                    %mo +
                    %msub
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %mi ϵ
                    %mo =
                    %msub
                      %mi id
                      %mrow
                        %msubsup
                          %mi Q
                          %mn 0
                          %mi u
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_0 \circ s_0 + s_{-1}\circ \epsilon = id_{Q^u_0}
            %p
              because for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mo ∂
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi s
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} [
                            %mo *
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo +
                            %msub
                              %mi s
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi ϵ
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} [
                            %mo *
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mo ∂
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mi g
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                            %mo +
                            %msub
                              %mi s
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi g
                            %mo{:stretchy => "false"} [
                            %mo *
                            %mo{:stretchy => "false"} ]
                            %mo −
                            %mo{:stretchy => "false"} [
                            %mo *
                            %mo{:stretchy => "false"} ]
                            %mo +
                            %mo{:stretchy => "false"} [
                            %mo *
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi g
                            %mo{:stretchy => "false"} [
                            %mo *
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\partial_0 (s_0(g[*])) + s_{-1}(\epsilon(g[*]))
                    \&amp; =
                    \\partial_0( [g] ) + s_{-1}(1)
                    \\\
                    \&amp; = g[*] - [*] + [*]
                    \\\
                    \&amp; =
                    g[*]
                    \\end{aligned}
                    \\,.
            %p
              For all remaining
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
              we find
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi n
                    %mo ∘
                    %msub
                      %mi s
                      %mi n
                    %mo +
                    %msub
                      %mi s
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ∘
                    %msub
                      %mo ∂
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo =
                    %msub
                      %mi id
                      %mrow
                        %msubsup
                          %mi Q
                          %mi n
                          %mi u
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_n \circ  s_n + s_{n-1} \circ \partial_{n-1}
                    \=
                    id_{Q^u_n}
            %p by a lengthy but straightforward computation. This shows that every cycle is a boundary, hence that we have a resolution.
            %p
              Finally, since the chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Q
                      %mo •
                      %mi u
                  %annotation{:encoding => "application/x-tex"} Q^u_\bullet
              consists by construction degreewise of
              %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
              hence in particular of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective module
          .num_prop
            %h6#propoition Propoition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              equipped with a linear
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              and for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi grp
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^n_{grp}(G, A)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is equivalently given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi H
                              %mi Grp
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msubsup
                              %mi Ext
                              %mrow
                                %mi ℤ
                                %mo{:stretchy => "false"} [
                                %mi G
                                %mo{:stretchy => "false"} ]
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi H
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Hom
                              %mrow
                                %mi ℤ
                                %mo{:stretchy => "false"} [
                                %mi G
                                %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Q
                              %mi n
                              %mi u
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi H
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Hom
                              %mrow
                                %mi ℤ
                                %mo{:stretchy => "false"} [
                                %mi G
                                %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Q
                              %mi n
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    H^n_{Grp}(G,A) &amp; \simeq Ext^n_{\mathbb{Z}[G]}(\mathbb{Z}, A)
                    \\\
                    \&amp; \simeq H^n(Hom_{\mathbb{Z}[G]}(Q^u_n, A))
                    \\\
                    \&amp; \simeq H^n(Hom_{\mathbb{Z}[G]}(Q_n, A))
                    \\,.
                    \\end{aligned}
                    \\,,
            %p
              where on the right we canonically regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A \in \mathbb{Z}[G]
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
          .proof
            %h6#proof_22 Proof
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/free+functor"} free functor
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} [
                        %mi G
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi F
                      %mi n
                      %mi u
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mi Set
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo ×
                        %mi n
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathbb{Z}[G]}(F^u_n, A)
                    \\simeq
                    Hom_{Set}(U(G)^{\times n}, U(A))
            %p
              is the set of
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
              from
              = succeed "-tuples" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              to elements of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} [
                        %mi G
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{\mathbb{Z}[G]}(\partial_{n}, A)
              precisely if they are
              %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
              in the
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
              (by comparison with the explicit formulas there) and that they are group cohomology
              %a.existingWikiWord{:href => "/nlab/show/coboundaries"} coboundaries
              precisely if they are in the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi G
                          %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo ∂
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom_{\mathbb{Z}[G]}(\partial_{n-1}, A)
            %p
              Similarly one finds that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^n(Hom(F_n, A)))
              is the sub-group of
              %em normalized
              cocycles. By the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
              these already support the entire group cohomology (every cocycle is comologous to a normalized one).
          %h3#CohomologyOfCyclicGroups Cohomology of cyclic groups
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %msub
                    %mi C
                    %mi k
                %annotation{:encoding => "application/x-tex"} G = C_k
            be a
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            of finite
            %a.existingWikiWord{:href => "/nlab/show/order"} order
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %em
                %a{:href => "http://ncatlab.org/nlab/show/group+cohomology#InTermsOfHomologicalAlgebra"} group cohomology - In terms of homological algebra
          %p
            Define special elements in the
            %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo ≔
                  %mn 1
                  %mo +
                  %mi g
                  %mo +
                  %msup
                    %mi g
                    %mn 2
                  %mo +
                  %mi …
                  %mo +
                  %msup
                    %mi g
                    %mrow
                      %mi k
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} N \coloneqq 1 + g + g^2 + \ldots + g^{k-1}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ≔
                  %mi g
                  %mo −
                  %mn 1
                  %mo ,
                %annotation{:encoding => "application/x-tex"} D \coloneqq g - 1,
          %p
            and denote the corresponding multiplications by these elements by the same letters
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ,
                    %mi D
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℤ
                    %mi G
                    %mo →
                    %mi ℤ
                    %mi G
                  %annotation{:encoding => "application/x-tex"} N, D \colon \mathbb{Z}G \to \mathbb{Z}G
          %p
            Then a very simple and useful projective resolution of the trivial
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            is based on an
            %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}G
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi …
                  %mover
                    %mo →
                    %mi N
                  %mi ℤ
                  %mi G
                  %mover
                    %mo →
                    %mi D
                  %mi ℤ
                  %mi G
                  %mover
                    %mo →
                    %mi N
                  %mi ℤ
                  %mi G
                  %mover
                    %mo →
                    %mi D
                  %mi ℤ
                  %mi G
                  %mo →
                  %mi ℤ
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \ldots \stackrel{N}{\to} \mathbb{Z}G \stackrel{D}{\to} \mathbb{Z}G \stackrel{N}{\to} \mathbb{Z}G \stackrel{D}{\to} \mathbb{Z}G \to \mathbb{Z} \to 0
          %p
            where the last map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mi G
                  %mo →
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}G \to \mathbb{Z}
            is induced from the trivial group homomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} G \to 1
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            of all group elements.
          %p
            It follows from this resolution that the
            %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cohomology groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mi k
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^n(C_k, A)
            for a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi k
                  %annotation{:encoding => "application/x-tex"} C_k
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are periodic of order 2:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mi k
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mi k
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H^{n+2}(C_k, A) \cong H^n(C_k, A)
          %p
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
          .num_prop
            %h6#proposition_13 Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo =
                      %msub
                        %mi C
                        %mi k
                    %annotation{:encoding => "application/x-tex"} G = C_k
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi A
                          %mi G
                        %mo =
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo →
                        %mi A
                      %annotation{:encoding => "application/x-tex"} H^0(G, A) = A^G = \ker(D) \colon A \to A
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mrow
                            %mn 2
                            %mi j
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H^{2 j + 1}(G, A) = \ker(N)/im(D)
                  for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi j
                          %mo ≥
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} j \geq 0
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mrow
                            %mn 2
                            %mi j
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H^{2 j}(G, A) = \ker(D)/im(N)
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi j
                          %mo ≥
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} j \geq 1
          %p
            A well-known calculation in the cohomology of cyclic groups is
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Hilbert%27s+Theorem+90"} Hilbert's Theorem 90
          .num_theorem
            %h6#theorem_4 Theorem
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              be a finite
              %a.existingWikiWord{:href => "/nlab/show/Galois+extension"} Galois extension
              of a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/Galois+group"} Galois group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} G = \langle g \rangle
              of order
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi K
                      %mo *
                  %annotation{:encoding => "application/x-tex"} K^\ast
              as a
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ,
                      %msup
                        %mi K
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} H^1(G, K^\ast) = 0
          .proof
            %h6#proof_23 Proof
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo ∈
                      %mi ℤ
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \sigma \in \mathbb{Z}G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              on an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo ∈
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \beta \in K
              by exponential notation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi β
                        %mi σ
                    %annotation{:encoding => "application/x-tex"} \beta^\sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %mi ℤ
                    %mi G
                  %annotation{:encoding => "application/x-tex"} N \in \mathbb{Z}G
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi β
                      %mi N
                    %mo =
                    %msup
                      %mi β
                      %mrow
                        %mn 1
                        %mo +
                        %mi g
                        %mo +
                        %mi …
                        %mo +
                        %msup
                          %mi g
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %mo =
                    %mi β
                    %mo ⋅
                    %msup
                      %mi β
                      %mi g
                    %mo ⋅
                    %mi …
                    %msup
                      %mi β
                      %mrow
                        %msup
                          %mi g
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                  %annotation{:encoding => "application/x-tex"} \beta^N = \beta^{1 + g + \ldots + g^{n-1}} = \beta \cdot \beta^g \cdot \ldots \beta^{g^{n-1}}
            %p
              which is precisely the
              %em norm
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N(\beta)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} N(\beta) = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \alpha \in K
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo =
                      %mi α
                      %mo{:stretchy => "false"} /
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \beta = \alpha/g(\alpha)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ,
                    %mi g
                    %mo ,
                    %mi …
                    %mo ,
                    %msup
                      %mi g
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo :
                    %msup
                      %mi K
                      %mo *
                    %mo →
                    %msup
                      %mi K
                      %mo *
                  %annotation{:encoding => "application/x-tex"} 1, g, \ldots, g^{n-1}: K^\ast \to K^\ast
              are, when considered as elements in a vector space of
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              = succeed "-linearly" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo +
                    %mi β
                    %mi g
                    %mo +
                    %msup
                      %mi β
                      %mrow
                        %mn 1
                        %mo +
                        %mi g
                    %msup
                      %mi g
                      %mn 2
                    %mo +
                    %mi …
                    %mo +
                    %msup
                      %mi β
                      %mrow
                        %mn 1
                        %mo +
                        %mi g
                        %mo +
                        %mi …
                        %mo +
                        %msup
                          %mi g
                          %mrow
                            %mi n
                            %mo −
                            %mn 2
                    %msup
                      %mi g
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} 1 + \beta g + \beta^{1+g}g^2 + \ldots + \beta^{1 + g + \ldots + g^{n-2}}g^{n-1}
            %p
              is not identically zero, and therefore there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo ∈
                    %msup
                      %mi K
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \theta \in K^\ast
              such that the element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo =
                    %mi θ
                    %mo +
                    %mi β
                    %msup
                      %mi θ
                      %mi g
                    %mo +
                    %msup
                      %mi β
                      %mrow
                        %mn 1
                        %mo +
                        %mi g
                    %msup
                      %mi θ
                      %mrow
                        %msup
                          %mi g
                          %mn 2
                    %mo +
                    %mi …
                    %mo +
                    %msup
                      %mi β
                      %mrow
                        %mn 1
                        %mo +
                        %mi g
                        %mo +
                        %mi …
                        %mo +
                        %msup
                          %mi g
                          %mrow
                            %mi n
                            %mo −
                            %mn 2
                    %msup
                      %mi θ
                      %mrow
                        %msup
                          %mi g
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                  %annotation{:encoding => "application/x-tex"} \alpha = \theta + \beta \theta^g + \beta^{1+g}\theta^{g^2} + \ldots + \beta^{1 + g + \ldots + g^{n-2}}\theta^{g^{n-1}}
            %p
              is non-zero. Using the fact that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} N(\beta) = 1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %msup
                        %mi α
                        %mi g
                      %mo =
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \beta \alpha^g = \alpha
          %p
            The next result may be thought of as establishing “independence of characters” (where “
            %a.existingWikiWord{:href => "/nlab/show/group+character"}> characters
            ” are valued in the
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative group
            of a field):
          .num_lemma
            %h6#lemma_5 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi χ
                      %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo →
                    %msup
                      %mi K
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \chi_1, \ldots, \chi_n \colon G \to K^\ast
              be distinct monoid
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi χ
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \chi_i
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/linear+independence"} linearly independent
          .proof
            %h6#proof_24 Proof
            %p
              A single
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo →
                    %msup
                      %mi K
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \chi \colon G \to K^\ast
              obviously forms a linearly independent set. Now suppose we have an equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %msub
                      %mi χ
                      %mn 1
                    %mo +
                    %mi …
                    %mo +
                    %msub
                      %mi a
                      %mi n
                    %msub
                      %mi χ
                      %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a_1 \chi_1 + \ldots + a_n \chi_n = 0
            %p
              where
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mi i
                      %mo ∈
                      %mi K
                    %annotation{:encoding => "application/x-tex"} a_i \in K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is as small as possible. In particular, no
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi i
                  %annotation{:encoding => "application/x-tex"} a_i
              is equal to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n \geq 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi χ
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ≠
                      %msub
                        %mi χ
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \chi_1(g) \neq \chi_2(g)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} h \in G
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %msub
                      %mi χ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi …
                    %mo +
                    %msub
                      %mi a
                      %mi n
                    %msub
                      %mi χ
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a_1 \chi_1(g h) + \ldots + a_n \chi_n(g h) = 0
            %p so that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %msub
                      %mi χ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi χ
                      %mn 1
                    %mo +
                    %mi …
                    %mo +
                    %msub
                      %mi a
                      %mi n
                    %msub
                      %mi χ
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi χ
                      %mi n
                    %mo =
                    %mn 0
                    %mo .
                  %annotation{:encoding => "application/x-tex"} a_1 \chi_1(g) \chi_1 + \ldots + a_n \chi_n(g)\chi_n = 0.
            %p
              Dividing equation 2 by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi_1(g)
              and subtracting from it equation 1, the first term cancels, and we are left with a shorter relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 2
                    %mfrac
                      %mrow
                        %msub
                          %mi χ
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi χ
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                    %mo −
                    %msub
                      %mi a
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi χ
                      %mn 2
                    %mo +
                    %mi …
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} (a_2\frac{\chi_2(g)}{\chi_1(g)} - a_2)\chi_2 + \ldots = 0
            %p
              which is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contradiction"} contradiction
