            %p
              one finds that these satisfy the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+identities"} simplicial identities
              and that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mi n
                      %mo =
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
