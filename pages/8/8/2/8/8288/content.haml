                        %mi i
                      %msubsup
                        %mo ∂
                        %mi n
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \partial_n = \sum_{i = 0}^n (-1)^i \partial^i_n
            %p
              That the augmentation map is a
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              is equivalent, by remark
              = succeed "," do
                %a.maruku-ref{:href => "#ProjectiveResolutionInComponents"}
              %a.existingWikiWord{:href => "/nlab/show/augmentation"} augmentation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 2
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi G
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 1
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mi ϵ
                    %mi ℤ
                    %mo →
                    %mn 0
