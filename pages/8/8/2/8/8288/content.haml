          %p Sometimes one needs to construct resolutions of sequences of morphisms in a more controled way, for instance such that some degreewise exactness is preserved:
          #ProjectiveResolutionOfExactSequenceByExactSequence.num_lemma
            %h6#lemma_2 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi A
                    %mover
                      %mo →
                      %mi i
                    %mi B
                    %mover
                      %mo →
                      %mi p
                    %mi C
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0 \to A \stackrel{i}{\to} B \stackrel{p}{\to} C \to 0
              a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              in an
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+object"} enough projectives
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi A
                              %mo •
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi B
                              %mo •
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi C
                              %mo •
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mo •
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi g
                                    %mo •
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi h
                                    %mo •
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi i
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mi p
