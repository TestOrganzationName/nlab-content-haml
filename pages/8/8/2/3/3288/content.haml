                          %mn 1
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi W
                        %mrow
                          %mn 2
                          %mn 1
                      %mo →
                      %msub
                        %mi W
                        %mrow
                          %mn 1
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} \phi_{2 1} \colon W_{2 1} \to W_{1 2}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ×
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} S^1 \times T M
              is smooth.
            %p
              Consider the composition
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mrow
                          %mn 2
                          %mn 1
                      %msub
                        %mi ϕ
                        %mrow
                          %mn 1
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi_{2 1}\phi_{1 2}(t,v)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ϕ
                              %mrow
                                %mn 2
                                %mn 1
                            %msub
                              %mi ϕ
                              %mrow
                                %mn 1
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi ϕ
                              %mrow
                                %mn 2
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %msub
                              %mi θ
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %msub
                              %mi θ
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %msub
                              %mi θ
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi π
                            %mo ×
                            %msub
                              %mi η
                              %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi α
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi η
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi θ
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi π
                            %mo ×
                            %msub
                              %mi η
                              %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi α
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi η
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi π
                            %mo ×
                            %msub
                              %mi η
                              %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi π
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi η
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\phi_{2 1} \phi_{1 2}(t,v) &amp;= \phi_{2 1}(t, \theta_1(t,v))\\
                    \&amp;=(t, \theta_2(t,\theta_1(t,v))) \\
                    \&amp;=(t, (\pi \times \eta_1)^{-1}(\alpha_1(t), \eta_2(\theta_1(t,v)))) \\
                    \&amp;= (t, (\pi \times \eta_1)^{-1}(\alpha_1(t), \eta_1(v))) \\
                    \&amp;= (t, (\pi \times \eta_1)^{-1}(\pi(v), \eta_1(v))) \\
                    \&amp;= (t,v)
                    \\end{aligned}
            %p
              The penultimate line is because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msubsup
                      %mi α
                      %mn 1
                      %mo *
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} (t,v) \in \alpha_1^* T M
              so
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi α
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi(v) = \alpha_1(t)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mn 2
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi_{2 1}
              is the inverse of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mn 1
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi_{1 2}
              and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mn 1
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi_{1 2}
              is a diffeomorphism. Thus the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mn 1
                        %mn 2
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \phi_{1 2}^L
              is a diffeomorphism from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ψ
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 1
                    %mo ∩
                    %msub
                      %mi U
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Psi_1^{-1}(U_1 \cap U_2)
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ψ
                        %mn 2
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mn 1
                      %mo ∩
                      %msub
                        %mi U
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Psi_2^{-1}(U_1 \cap U_2)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ψ
                        %mn 2
                      %msubsup
                        %mi ψ
                        %mrow
                          %mn 1
                          %mn 2
                        %mi L
                      %mo =
                      %msub
                        %mi Ψ
                        %mn 2
                      %msub
                        %mi Φ
                        %mrow
                          %mn 1
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} \Psi_2 \psi_{1 2}^L = \Psi_2 \Phi_{1 2}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ψ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Psi_1
              which satisfies:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ψ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi η
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi_1(\gamma)(t) = \eta_1(\tilde{\gamma})(t).
            %p On the other side,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi ϕ
                              %mrow
                                %mn 1
                                %mn 2
                              %mi L
                            %mo{:stretchy => "false"} (
                            %mi γ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi ϕ
                              %mrow
                                %mn 1
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %mi γ
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %msub
                              %mi θ
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %mover
                              %mi γ
                              %mo{:stretchy => "false"} ˜
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi π
                            %mo ×
                            %msub
                              %mi η
                              %mn 2
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi α
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi η
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi γ
                              %mo{:stretchy => "false"} ˜
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\phi_{1 2}^L (\gamma)(t) &amp;= \phi_{1 2}(\gamma(t)) \\
                    \= (t, \theta_1(t, \tilde{\gamma}(t))) \\
                    \= (t, (\pi \times \eta_2)^{-1}(\alpha_2(t), \eta_1(\tilde{\gamma}(t)))).
                    \\end{aligned}
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ψ
                      %mn 2
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mn 1
                        %mn 2
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi η
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo ×
                    %msub
                      %mi η
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi η
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi η
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi_2 \phi_{1 2}^L(\gamma)(t) = \eta_2(\pi \times \eta_2)^{-1}(\alpha_2(t), \eta_1(\tilde{\gamma}(t))) = \eta_1(\tilde{\gamma})(t).
            %p
              Thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mn 1
                        %mn 2
                      %mi L
                    %mo =
                    %msub
                      %mi Φ
                      %mrow
                        %mn 1
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi_{1 2}^L = \Phi_{1 2}
              and so the transition functions are diffeomorphisms.
          #extension.num_remark
            %h6#remark Remark
            %p
              This construction easily generalises quite widely. Very little of the structure of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
              was used at all: that mainly came in in the smooth structure of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} L \mathbb{R}^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              was the local addition and thus one could regard this as a construction of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+additive+space"} locally additive spaces
          %h3#SmoothStruc Relation between Fréchet-manifold structure and diffeological structure
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+manifold"} Fréchet manifold
            structure on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi X
                  %annotation{:encoding => "application/x-tex"} L X
            %a{:href => "#FrechetManifoldStructure"} above
            agrees with the standard
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeology
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mi X
                %annotation{:encoding => "application/x-tex"} L X
            in the following sense.
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi Frech
                  %mo →
                  %mi Diff
                %annotation{:encoding => "application/x-tex"}
                  F: Frech \to Diff
          %p
            from
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Frechet+manifold"} Fréchet manifold
            %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
            defined in the same way as the well-known functor from
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            = succeed "s:" do
              %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo :
                    %mi U
                    %mo →
                    %mi L
                    %mi X
                  %annotation{:encoding => "application/x-tex"} c : U \to L X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is an object in the domain category, e.g. an open subset of some
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
          %p
            (Notice that a theorem of M. Losik says that the functor F is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful
          %p
            Now there are two diffeologies on
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi X
                  %annotation{:encoding => "application/x-tex"} L X
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            on the category
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            obtained as regarding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mi X
                %annotation{:encoding => "application/x-tex"} L X
            as the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            with respect to the
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+sheaves"} closed monoidal structure on sheaves
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mi X
                  %mo =
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mi U
                  %mo ↦
                  %msub
                    %mi Hom
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi CartSp
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ×
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  L X = [S^1,X] : U \mapsto Hom_{Sh(CartSp)}(S^1 \times Y(U), X)
          %p
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            denotes the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
          %p
            This means that a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %mi U
                  %mo →
                  %mi L
                  %mi X
                %annotation{:encoding => "application/x-tex"} c : U \to L X
            is a plot if and only if the associated map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ×
                  %msup
                    %mi S
                    %mn 1
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \times S^1 \to X
            is smooth. The second diffeology is the one obtained from the functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %p
            These two diffeologies
            %em coincide
            – in the sense that every plot of one is a plot of the other. In particular, they have the same sets of smooth functions.
          %p
            A detailed proof of this is in (
            %a{:href => "#Waldorf"}> Waldorf, lemma A.1.7
            )
          %h3#GStructures
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            \-Structures on smooth loop spaces
          %p
            The usual notions of
            %em
              %a.existingWikiWord{:href => "/nlab/show/G-structures"} G-structures
            for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/string+structure"} string structure
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is supposed to induce a kind of orientation structure on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Omega X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is supposed to induce a kind of spin structure on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Omega X
          %p
            Formalizations of such “smooth loop space
            = succeed "-structures\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ")," do
              %a{:href => "#Stolz"} Stolz-Teichner 2005
            = succeed ")" do
              %a{:href => "#Waldorf11"} Waldorf 2011
            = succeed ")." do
              %a{:href => "#Waldorf16"} Waldorf 2016
            %a.existingWikiWord{:href => "/nlab/show/string+structure"} string structure
            on the underlying space is discussed in (
            %a{:href => "#Waldorf14"}> Waldorf 14
            ).
          %h3#AsLoopObj As the loop space object of the smooth path groupoid
          %p
            Given the notion of the smooth
            %a.existingWikiWord{:href => "/nlab/show/path+groupoid"} path groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒫
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{P}_1(X)
            of the smooth space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em space
            as the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
          %p We say this in detail now.
          %h4#recollection_of_the_situation_in_
            Recollection of the situation in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
          %p
            First briefly recall the situation for
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            = succeed "s:" do
              %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
          %p
            The ordinary procedure is that we regard a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            as an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            and produce its
            %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
            at a chosen
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} base point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mo *
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} x : {*} \to X
            as the
            %a.existingWikiWord{:href => "/nlab/show/limit+in+a+quasi-category"} (∞,1)-pullback
            of the base point along itself:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi Ω
                            %mi x
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi x
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mover
                            %mo →
                            %mi x
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Omega_x X &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;\swArrow&amp; \downarrow^{\mathrlap{x}}
                  \\\
                  {*} &amp;\stackrel{x}{\to}&amp; X
                  }
                  \\,.
          %p
            %strong In words
            this is the simple statement that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mi x
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega_x X
            is the space of all
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopies
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            from the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mo *
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} x : {*} \to X
            to itself. Any one such homotopy is itself a continuous map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo :
                  %mi I
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \gamma : I \to X
            from the
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} standard interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} I = [0,1]
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %h4#generalization_to_lie_groupoids
            Generalization to
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            You might think: well, now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Diff
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \in Sh_{(\infty,1)}(Diff)
            be a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            regarded as a
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
            object in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
            or maybe better in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi CartSp
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(CartSp)
            on
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            – i.e. of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-groupoid"} Lie ∞-groupoid
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Q
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi x
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mover
                            %mo →
                            %mi x
                        %mtd
                          %mi X
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi CartSp
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Q &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;\swArrow&amp; \downarrow^{\mathrlap{x}}
                  \\\
                  {*} &amp;\stackrel{x}{\to}&amp; X
                  }
                  \\;\;\;\;\;\;\;\;\;\;\;\;
                  \\in Sh_{(\infty,1)}(CartSp)
          %p
            to obtain the smooth loop space. But it doesn’t: the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            here is
            = succeed "!" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} Q = {*}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            regarded as a representable object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Diff
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(Diff)
            is really a
            %a.existingWikiWord{:href => "/nlab/show/discrete+category"} categorically discrete
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of objects, but no nontrivial morphisms. And the “homotopies” in the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            are homotopies as seen by the
            %em
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            going from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} {*} \to X
            to itself, so the homotopy pullback is the point.
          %p
            Why then did it work in
            = succeed "?" do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            is really the collection of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            %em on the point
            \:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sing
                  %mo :
                  %mi Top
                  %mover
                    %mo →
                    %mo ≃
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Sing : Top \stackrel{\simeq}{\to} Sh_{(\infty,1)}({*})
                  \\,.
          %p
            Under this identification, a topological space is
            %em not
            identified with a
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
            object! The only representable object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}({*})
            is of course the
            %a.existingWikiWord{:href => "/nlab/show/point"} point
            itself, the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %em singular simplicial complex
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sing(X)
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Sing
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Hom
                    %mi Top
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi Δ
                    %mi Top
                    %mo •
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi SSet
                %annotation{:encoding => "application/x-tex"}
                  \\Pi(X) = Sing(X) = Hom_{Top}(\Delta^\bullet_{Top},X) \in SSet
          %p
            instead of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            when we regard the topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as an object of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of topological spaces! For more on this, see the discussion at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
          %p
            If instead we had interpreted the topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as a representable object, hence as a
            %a.existingWikiWord{:href => "/nlab/show/discrete+category"} categorically discrete
            object in the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/topological+%E2%88%9E-groupoid"} topological ∞-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            above: its
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            would have been the point. From this perspective now it is clear how the abstract notion of
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            corresponds to the geometrically expected one: for a geometric
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            of its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
          %p
            This statement can be given sense in all contexts where the underlying
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            of our ambient
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/space"} space
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/lined+topos"} lined topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is the standard
            %em line
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            %em geometric paths
            in a space. Taking these geometric paths to be the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
            then makes the geometric paths into “categorical paths”, i.e. into morphisms. These then are what the abstract definition of
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            can see.
          %p
            And indeed, whenever the underlying
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/space"} space
            %a.existingWikiWord{:href => "/nlab/show/lined+topos"} lined topos
            the corresponding
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            comes equipped with a generalization of the topological
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
            construction: we can associate to every
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            its
            %a.existingWikiWord{:href => "/schreiber/show/path+%E2%88%9E-groupoid"} path ∞-groupoid
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X)
            are given by paths in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as seen by the given
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/space"} space
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            and are using a correspondingly different notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
          %h4#the_concrete_definition The concrete definition
          %p
            So for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi CartSp
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(CartSp)
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-groupoid"} Lie ∞-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mi X
                  %mo ↪
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {*} \to X \hookrightarrow \Pi(X)
            along itself in the
            %a.existingWikiWord{:href => "/schreiber/show/path+%E2%88%9E-groupoid"} path ∞-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X)
            does indeed produce the expected
            %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-groupoid"} Lie ∞-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mi x
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega_x X
            in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi Ω
                            %mi x
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi x
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mover
                            %mo →
                            %mi x
                        %mtd
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi CartSp
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Omega_x X &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;\swArrow&amp; \downarrow^{\mathrlap{x}}
                  \\\
                  {*} &amp;\stackrel{x}{\to}&amp; \Pi(X)
                  }
                  \\;\;\;\;\;\;\;\;\;\;\;\;
                  \\in Sh_{(\infty,1)}(CartSp)
          %p whose
          %ul
            %li
              %p
                smooth space of objects is the smooth space of smooth loops in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                based at
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
            %li
              %p
                smooth space of morphisms is the smooth space of smooth
                = succeed "-homotopies" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %li
              %p etc;
          %p
            Here we want not the full loop
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %a.existingWikiWord{:href => "/nlab/show/0-category"} 0-groupoid
            just of loops. There are several choices for how exactly to do this, depending on which higher morphisms we just discard, and which we use to identify 1-morphisms. Whatever we do, we end up with some notion of smooth
            %a.existingWikiWord{:href => "/nlab/show/path+groupoid"} path groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒫
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{P}_1(X)
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X)
          %p
            Then, accordingly, forming the
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            of this
            %a.existingWikiWord{:href => "/nlab/show/path+groupoid"} path groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒫
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{P}_1(X)
            yields the smooth space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LoopSpace
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} LoopSpace(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi LoopSpace
                            %mi x
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi x
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mover
                            %mo →
                            %mi x
                        %mtd
                          %msub
                            %mi 𝒫
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  LoopSpace_x(X) &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;\swArrow&amp; \downarrow^{\mathrlap{x}}
                  \\\
                  {*} &amp;\stackrel{x}{\to}&amp; \mathcal{P}_1(X)
                  }
          %p
            which is the smooth subspace of the smooth space of morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒫
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{P}_1(X)
            of those morphisms that start and end at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            When unwrapping what all this means, one sees that the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi LoopSpace
                    %mi x
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi CartSp
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} LoopSpace_x(X) \in Sh_{(\infty,1)}(CartSp)
            that we obtain this way is nothing but the image under the embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi CartSp
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi CartSp
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(CartSp) \hookrightarrow Sh_{(\infty,1)}(CartSp)
            of ordinary
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaves
            into
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/quotient+object"} quotient
            of the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [I,X]
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+sheaves"} closed monoidal structure on sheaves
            %a.existingWikiWord{:href => "/nlab/show/concrete+sheaf"} concrete sheaf
            and as such it is precisely the smooth loop space regarded as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dirac+operator+on+smooth+loop+space"} Dirac operator on smooth loop space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dirac-Ramond+operator"}> Dirac-Ramond operator
                ,
                %a.existingWikiWord{:href => "/nlab/show/Witten+genus"} Witten genus
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/free+loop+orbifold"}> free loop orbifold
                ,
                %a.existingWikiWord{:href => "/nlab/show/inertia+orbifold"} inertia orbifold
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/loop+space"}> loop space
                ,
                %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/stringor+bundle"} stringor bundle
          %h2#references References
          %p A general standard reference on generalized smooth spaces is
          %ul
            %li#km
              Kriegl and Michor,
              %em A Convenient Setting of Global Analysis
          %p
            The structure of loop spaces as Fréchet manifolds is covered in chapter 42 of
            %a{:href => "#km"} KM
            and in various other articles, many of which cover extensions of the basic construction to other mapping spaces. In particular,
          %ul
            %li
              %p
                Michor,
                %em Manifolds of differentiable mappings
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=583436"} MR583436 (83g:58009)
            %li
              %p
                Michor,
                %em A convenient setting for differential geometry and global analysis (I and II)
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=764972"} MR764972 (86g:58014a)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Stacey"}> Andrew Stacey
                ,
                %em The Differential Topology of Loop Spaces
                %a{:href => "http://www.math.ntnu.no/~stacey/Seminars/diffloop.html"} main page
                (Note: this was designed as an “easy reader” version of
                = succeed ")" do
                  %a{:href => "#km"} KM
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Stacey"}> Andrew Stacey
                ,
                %em Constructing Smooth Manifolds of Loop Spaces
                %a{:href => "http://www.math.ntnu.no/~stacey/Research/Papers/smooth.html"} main page
          %p
            The relation of this
            %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+manifold"} Fréchet manifold
            structure to the canonical
            %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
            structure is discussed in
          %ul
            %li#Waldorf
              %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"}> Konrad Waldorf
              ,
              %em Transgression to Loop Spaces and its Inverse I
              (
              %a{:href => "http://arxiv.org/abs/0911.3212"}> arXiv:0911.3212
              )
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/G-structures"} G-structures
            on smooth loop spaces is in the following articles.
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            structure on loop space and its
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            from
            %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
            on target space (cf.
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/stringor+bundle"} stringor bundle
          %ul
            %li#Waldorf11
              %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"}> Konrad Waldorf
              ,
              = succeed "," do
                %em A Loop Space Formulation for Geometric Lifting Problems
              %strong 90
              1 (2011) 129-144 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/1007.5373"}> arXiv:1007.5373
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1017/S1446788711001182"} doi:10.1017/S1446788711001182
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
            on loop spaces and its
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            from
            %a.existingWikiWord{:href => "/nlab/show/string+structure"} string structure
            on target space:
          %ul
            %li#Stolz
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stephan+Stolz"}> Stephan Stolz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Teichner"} Peter Teichner
                %em The spinor bundle on loop space
                (2005) &amp;lbrack;
                %a{:href => "http://people.mpim-bonn.mpg.de/teichner/Math/ewExternalFiles/MPI.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Stolz-Teichner-SpinorOnLoopSpace.pdf", :title => "pdf"} pdf
            %li#Waldorf16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"}> Konrad Waldorf
                ,
                = succeed "," do
                  %em Spin structures on loop spaces that characterize string manifolds
                %strong 16
                (2016) 675-709 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/1209.1731"}> arXiv:1209.1731
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.2140/agt.2016.16.675"} doi:10.2140/agt.2016.16.675
            %li#Waldorf14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"}> Konrad Waldorf
                ,
                %em String geometry vs. spin geometry on loop spaces
                (
                %a{:href => "http://arxiv.org/abs/1403.5656"}> arXiv:1403.5656
                )
          %p See also:
          %ul
            %li#SperaWurzbacher07
              %p
                Mauro Spera, Tilman Wurzbacher,
                = succeed "," do
                  %em Twistor spaces and spinors over loop spaces
                %strong 338
                (2007) 801–843 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/s00208-007-0085-3"}> doi:10.1007/s00208-007-0085-3
                \&amp;rbrack;
            %li
              %p
                Alessandra Capotosti,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/From+String+structures+to+Spin+structures+on+loop+spaces"} From String structures to Spin structures on loop spaces
          %p There are also sketchy notes in
          %ul
            %li#Melrose
              %a.existingWikiWord{:href => "/nlab/show/Richard+Melrose"}> Richard Melrose
              ,
              = succeed "," do
                %em Analysis on loop spaces
              = succeed ")" do
                %a{:href => "http://math.mit.edu/~rbm/18.158-S13/18-158-S13.pdf"} pdf
          %p
            For the motivation of much of this via the
            %a.existingWikiWord{:href => "/nlab/show/Dirac-Ramond+operator"} Dirac-Ramond operator
            and the
            %a.existingWikiWord{:href => "/nlab/show/Witten+genus"} Witten genus
            see the references there.
          %p
            This entry was created in parallel with
            %a{:href => "http://mathoverflow.net/questions/12652/loop-spaces-as-generalized-smooth-spaces-or-as-infinite-dimensional-manifolds"} this MO thread
            from which parts of it is taken.
