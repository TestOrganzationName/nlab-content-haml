            %em twisted
            version of this space.
          %p
            The key piece of structure needed on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is that of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/local+addition"} local addition
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mi M
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \eta \colon T M \to M
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo{:lspace => "verythinmathspace"} :
                  %mi T
                  %mi M
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} \eta \colon T M \to M
            be a local addition on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
