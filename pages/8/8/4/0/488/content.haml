                  %mi Ω
                  %mo ×
                  %mi Ω
                  %mo ×
                  %mi Ω
                  %mover
                    %mo →
                    %mrow
                      %mo ⇒
                      %mo ×
                      %mn 1
                  %mi Ω
                  %mo ×
                  %mi Ω
                  %mover
                    %mo →
                    %mo ⇒
                  %mi Ω
                  %mspace{:width => "1em"}
                  %mo .
                %annotation{:encoding => "application/x-tex"} \Omega\simeq\Omega\times 1\overset{1\times(\chi_U,\chi_U)}{\to}\Omega\times\Omega\times\Omega\overset{\Rightarrow\times 1}{\to}\Omega\times \Omega\overset{\Rightarrow}{\to}\Omega\quad .
          %p
            The corresponding quasi-closed subtoposes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
