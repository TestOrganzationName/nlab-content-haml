                %annotation{:encoding => "application/x-tex"} U = \neg\neg U
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℰ
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ′
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{E}_{c(U')}
            translates to asking that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ⇒
                  %mi U
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %mi U
                  %mo ′
                %annotation{:encoding => "application/x-tex"} U = (U \Rightarrow U') \Rightarrow U'
            in the Heyting algebra of subterminal objects of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
          .num_prop
            %h6#proposition_4 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is Boolean iff the only dense subtopos of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              itself.
          %p
            %strong> Proof
            \. Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            is Boolean.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℰ
                    %mrow
                      %mo ¬
                      %mo ¬
                  %mo =
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\neg\neg}=\mathcal{E}
            is the smallest dense subtopos (cf.
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/double+negation"} double negation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            is not Boolean then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℰ
                    %mrow
                      %mo ¬
                      %mo ¬
                %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\neg\neg}
            is a second dense subtopos.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              In a
              %a.existingWikiWord{:href => "/nlab/show/lattice+of+subtoposes"} lattice of subtoposes
              the 2-valued Boolean toposes are the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/atoms"} atoms
          %p
            See
            = succeed "." do
              %a{:href => "subtopos#BooleantoposesAreAtoms"} this proposition
          .num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              be a topos. Then automorphisms of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              correspond bijectively to
              %a.existingWikiWord{:href => "/nlab/show/closed+subtopos"} closed
              Boolean subtoposes. The group operation on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Aut(\Omega)
              corresponds to symmetric difference of subtoposes.
          %p
            This result appears in
            = succeed "." do
              %a{:href => "#Johnstone79"} Johnstone (1979)
            = succeed "," do
              %a{:href => "#Johnstone"} Johnstone (2002)
          %h2#examples Examples
          %ul
            %li
              %p
                With
                %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
                in the meta-logic, every
                %a.existingWikiWord{:href => "/nlab/show/well-pointed+topos"} well-pointed topos
                is a Boolean topos. This includes
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                and models of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/ETCS"} ETCS
            %li
              %p
                The topos of
                %a.existingWikiWord{:href => "/nlab/show/G-sets"} G-sets
                for a group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                is always a Boolean topos, because the set-theoretic complement of a sub-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-set is itself a sub-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-set.
            %li
              %p
                More generally, a
                %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
                on a category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is Boolean if and only if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %li
              %p
                The topos of sheaves on a
                %a.existingWikiWord{:href => "/nlab/show/Boolean+algebra"} Boolean algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                for the
                %a.existingWikiWord{:href => "/nlab/show/coherent+category"} coherent topology
                is Boolean if and only if the Boolean algebra is finite. Indeed, in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(B)
                the sections of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \Omega
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} b \in B
                are the ideals of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ↓
                        %mi b
                        %mo ⩽
                        %mi B
                      %annotation{:encoding => "application/x-tex"} \downarrow b \leqslant B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1+1
                are the principal ideals, and these coincide just when
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                is finite.
            %li
              %p
                The topos of
                %a.existingWikiWord{:href => "/nlab/show/canonical+topology"} canonical
                sheaves on a complete
                %a.existingWikiWord{:href => "/nlab/show/Boolean+algebra"} Boolean algebra
                is Boolean (note this includes the finite case above).
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
                is any topos, the category of
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaves
                for the
                %a.existingWikiWord{:href => "/nlab/show/double+negation"} double-negation topology
                is a Boolean
                %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %li
              %p
                Any topos satisfying the
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
                is Boolean. This result is due to R. Diaconescu (
                %a{:href => "#Diaconescu75"}> 1975
                ); see
                %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
                for a brief discussion.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Barr%27s+theorem"} Barr's theorem
                implies that any topos
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
                can be covered by a Boolean topos
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℱ
                      %annotation{:encoding => "application/x-tex"} \mathcal{F}
                %a.existingWikiWord{:href => "/nlab/show/surjective+geometric+morphism"} surjective geometric morphism
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi ℱ
                        %mo →
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"} f \colon \mathcal{F} \to \mathcal{E}
          %h2#relation_to_measure_theory Relation to measure theory
          %p
            Boolean toposes are closely related to
            %a.existingWikiWord{:href => "/nlab/show/measurable+spaces"} measurable spaces
            (e.g
            = succeed "," do
              %a{:href => "#Jackson06"} Jackson 06
            = succeed ")." do
              %a{:href => "#Henry14"} Henry 14
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Boolean+category"} Boolean category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Boolean+domain"} Boolean domain
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/double+negation"} double negation
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/de+Morgan+topos"} de Morgan topos
          %h2#references References
          %h3#general General
          %ul
            %li#BlassScedrov75
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andreas+Blass"}> Andreas Blass
                , Andrej Scedrov,
                %em Boolean Classifying Topoi
                , JPAA
                %strong 28
                (1983) pp.15-30.
            %li#Diaconescu75
              %p
                Radu Diaconescu,
                %em Axiom of Choice and Complementation
                , Trans. AMS
                %strong 51
                no.1 (1975) pp.176-178. (
                %a{:href => "http://www.ams.org/journals/proc/1975-051-01/S0002-9939-1975-0373893-X/S0002-9939-1975-0373893-X.pdf"}> pdf
                )
            %li#Johnstone79
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
                ,
                %em
                  Automorphisms of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ω
                      %annotation{:encoding => "application/x-tex"} \Omega
                , Algebra Universalis
                %strong 9
                (1979) pp.1-7.
            %li#Johnstone
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"} Sketches of an Elephant
                    vols. I,II
          %h3#ReferencesRelationToMeasureTheory Relation to measure theory
          %p
            On relation of Boolean toposes to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/measure+theory"} measure theory
          %ul
            %li#Jackson06
              %p
                Matthew Jackson,
                = succeed "," do
                  %em A sheaf-theoretic approach to measure theory
                = succeed "," do
                  %a{:href => "http://www.andrew.cmu.edu/~awodey/students/jackson.pdf"} pdf
                = succeed ")" do
                  %a{:href => "http://d-scholarship.pitt.edu/7348"} d-scholarship:7348
            %li#Henry14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simon+Henry"}> Simon Henry
                ,
                = succeed "," do
                  %em Measure theory over boolean toposes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1411.1605"} arXiv:1411.1605
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Asgar+Jamneshan"}> Asgar Jamneshan
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Terence+Tao"} Terence Tao
