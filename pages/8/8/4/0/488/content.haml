                %annotation{:encoding => "application/x-tex"} Sh_{\neg\neg}(Sh_{c(U)}(\mathcal{E}))
            of the
            %a.existingWikiWord{:href => "/nlab/show/closed+subtopos"} closed subtoposes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
