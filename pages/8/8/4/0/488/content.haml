                    %semantics
                      %mrow
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}
                  is a Boolean topos;
              %li
                %p
                  Every
                  %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}
                  is Boolean.
              %li
                %p
                  Every
                  %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}
                  is an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/open+subtopos"} open subtopos
              %li
                %p
                  Every
                  %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
