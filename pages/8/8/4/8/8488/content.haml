          %h2#definition Definition
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo ∈
                  %msup
                    %mi Ω
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \omega \in \Omega^{n+1}(X)
            an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-plectic+geometry"} n-plectic geometry
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} v \in \Gamma(X)
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
            %strong Hamiltonian form
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            is, if it exists, a
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo ∈
                  %msup
                    %mi Ω
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} h \in \Omega^n(X)
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mi v
                  %mi ω
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi h
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\iota_{v} \omega = \mathbf{d} h
                  \\,.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n = 1
            this reduces to the notion of a
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            on a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
          %p
            If a Hamiltonian form for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            exists then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            is called a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
          %p
            The Hamiltonian forms are the local
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/classical+observables"} classical observables
            %a.existingWikiWord{:href => "/nlab/show/prequantum+observables"} prequantum observables
