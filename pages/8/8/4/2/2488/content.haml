          #DiagonalCharacterization.num_prop
            %h6#proposition_3 Proposition
            %p
              In an
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
