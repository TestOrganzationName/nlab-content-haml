                    %msub
                      %mi τ
                      %mrow
                        %mo ≤
                        %mi k
                    %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi j
                    %mi L
                    %msub
                      %mi τ
                      %mrow
                        %mo ≤
                        %mi k
                    %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    L \tau_{\leq k} \prod_j i(X_j)
                    \\stackrel{\simeq}{\to}
                    L \prod_j \tau_{\leq k} i(X_j)
                    \\simeq
                    \\prod_j L \tau_{\leq k} i(X_j)
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ∘
