              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y \in Y
              are then given by the ordinary fibers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ¯
                      %mi y
                  %annotation{:encoding => "application/x-tex"} \bar X_y
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar f
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
            %p
              This way, the statement is reduced to the following fact: a
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ¯
                      %mi y
                  %annotation{:encoding => "application/x-tex"} \bar X_y
              is
              = succeed "-truncated" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fibers
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ¯
                      %mi y
                    %mo →
                    %msub
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ¯
                      %mi y
                    %mo ×
                    %msub
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ¯
                      %mi y
                  %annotation{:encoding => "application/x-tex"} \bar X_y \to \bar X_y \times \bar X_y
              are
              = succeed "-truncated." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k-1)
            %p
              We now write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ¯
                      %mi y
                  %annotation{:encoding => "application/x-tex"} \bar X_y
              for simplicity. To see the last statement, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo *
                    %mo →
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} (a,b) : * \to X \times X
              and compute the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Q
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi a
                                  %mo ,
                                  %mi b
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                            %mo ×
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Q &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{(a,b)}}
                    \\\
                    X &amp;\to&amp; X \times X
                    }
            %p
              as usual by replacing the right vertical morphism with the fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi I
                    %msub
                      %mo ×
                      %mrow
                        %mi X
                        %mo ×
                        %mi X
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} (X \times X)^I \times_{X \times X} (a,b) \to X \times X
              and then forming the ordinary pullback. This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is equivalent to the space of paths
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P_{a,b}X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
              %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space objects
              at endpoints of paths produces a new path space; see, for instance, section 4 of
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/BrownAHT"} BrownAHT
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected"} connected
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo →
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \to b
              gives an isomorphism from the homotopy groups of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P_{a,b} X
              to those of the
              %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
