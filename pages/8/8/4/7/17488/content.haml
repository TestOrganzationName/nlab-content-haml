                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mo ≔
                    %msub
                      %munder
                        %mi lim
