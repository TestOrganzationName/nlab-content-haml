                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\underset{\longrightarrow}{\lim}_{i} \Omega Z_{i,k}
                    \&amp; =
