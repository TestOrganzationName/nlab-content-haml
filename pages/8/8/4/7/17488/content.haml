                    \\end{aligned}
                    \\,.
            %p Finally, let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Q
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_X \colon X \to Q X
            %p
              be degreewise the inclusion of the first component (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi i
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} i = 0
              ) into the colimit. By construction, this is a homomorphism of sequential spectra (according to def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SequentialSpectrumViaAdjunctStructureMaps"}
          #PropertiesOfSpectrificationForTopologicalSequentialSpectra.num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X\in SeqSpec(Top_{cg})
              be a
              %a.existingWikiWord{:href => "/nlab/show/sequential+prespectrum"} sequential prespectrum
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Q
                    %mi X
                  %annotation{:encoding => "application/x-tex"} j_X \colon X \to Q X
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#SpectrificationForTopologicalSequentialSpectra"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mi X
                      %annotation{:encoding => "application/x-tex"} Q X
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#OmegaSpectrum"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi X
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Q
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \eta_X \colon X \to Q X
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalence"} stable weak homotopy equivalence
                  (def.
                  = succeed "):" do
                    %a.maruku-ref{:href => "#StableWeakHomotopyEquivalenceOfSequentialTopologicalSpectra"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi X
                      %annotation{:encoding => "application/x-tex"} \eta_X
                  is a level weak equivalence (is in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi W
                            %mi strict
                        %annotation{:encoding => "application/x-tex"} W_{strict}
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ClassesOfMorphismsOfTheStrictModelStructureOnSequentialSpectra"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              %li
                %p
                  a morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f \colon X  \to Y
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalence"} stable weak homotopy equivalence
                  (def.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#StableWeakHomotopyEquivalenceOfSequentialTopologicalSpectra"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi Q
                        %mi X
                        %mo →
                        %mi Q
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Q f \colon Q X \to Q Y
                  is a level weak equivalence (is in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi W
                            %mi strict
                        %annotation{:encoding => "application/x-tex"} W_{strict}
                  = succeed ")." do
                    %a.maruku-ref{:href => "#ClassesOfMorphismsOfTheStrictModelStructureOnSequentialSpectra"}
          %p
            (
            %a{:href => "#Schwede97"}> Schwede 97, lemma 2.1.3 and remark before section 2.2
            )
          .proof
            %h6#proof_5 Proof
            %p
              Since the colimit defining
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Q X
              is a
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi k
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} X_k \to (Q X)_k
              is itself a relative cell complex. Since
              %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+spaces"} compact topological spaces
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#CompactSubsetsAreSmallInCellComplexes"} lemma
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet((Q X)_k)
              is in the image of a finite stage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Z
                      %mrow
                        %mi i
                        %mo ,
                        %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(Z_{i,k})
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} i \in \mathbb{N}
            %p Regarding first statement:
            %p
              Since each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi σ
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mi i
                        %mo ,
                        %mi k
                  %annotation{:encoding => "application/x-tex"} \tilde \sigma_{i,k}
              by construction is a weak homotopy equivalence followed by an inclusion of stages in the colimit, as any element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_q((Q X)_k)
              is sent along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mover
                        %mi σ
                        %mo{:stretchy => "false"} ˜
                      %mi k
                      %mrow
                        %mi Q
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \tilde \sigma^{Q X}_k
              it passes through one such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi σ
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mi i
                        %mo ,
                        %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_q(\tilde \sigma_{i ,k})
              at some stage
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
            %p Regarding the second statement:
            %p
              By the previous statement and by example
              = succeed "," do
                %a.maruku-ref{:href => "#StableHomotopyGroupsOfOmegaSpectrum"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi η
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(\eta_X) \colon \pi_\bullet(X)\to \pi_\bullet(Q X)
              is given in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q \geq 0
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %munder
                        %mrow
                          %msub
                            %munder
                              %mi lim
                              %mo ⟶
                            %mrow
                              %mi k
                              %mo ∈
                              %mi ℕ
                          %msub
                            %mi π
                            %mrow
                              %mi q
                              %mo +
                              %mi k
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mi k
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mo ≃
                        %msub
                          %munder
                            %mi lim
                            %mo ⟶
                          %mi k
                        %msub
                          %mi π
                          %mi q
                        %mrow
                          %mo (
                          %msup
                            %mi Ω
                            %mi k
                          %msub
                            %mi X
                            %mi k
                          %mo )
                    %mo ⟶
                    %msub
                      %mi π
                      %mi q
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    \\simeq \underset{\longrightarrow}{\lim}_k  \pi_q \left(\Omega^k X_k\right)
                    }
                    {
                    \\underbrace{
                    \\underset{\longrightarrow}{\lim}_{k \in \mathbb{N}}  \pi_{q+k}(X_k)
                    }}
                    \\longrightarrow
                    \\pi_q \left(
                    (Q X)_0
                    \\right)
            %p
              and similarly in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo &lt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} q\lt 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              we compute on the right:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi π
                              %mi q
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
