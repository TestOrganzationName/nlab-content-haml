                            %mo ×
                            %msub
                              %mi X
                              %mn 2
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi id
                                    %mrow
