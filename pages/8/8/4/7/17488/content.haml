              from theorem
              = succeed "." do
                %a.maruku-ref{:href => "#StrictModelStructureOnSequentialPrespectraIsModelCategory"}
          %p
            (
            %a{:href => "#Schwede97"}> Schwede 97, lemma 2.1.3 (e)
            )
          .proof
            %h6#proof_26 Proof
            %p
