                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi l
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi A
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi σ
                                  %mi n
                                  %mi A
                          %mtd
                            %msub
                              %mi A
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^1 \wedge X_n &amp;\stackrel{\sigma_n^X}{\longrightarrow}&amp; X_{n+1}
                    \\\
                    \\downarrow^{\mathrlap{S^1 \wedge f_n}} &amp;&amp; \downarrow^{\mathrlap{f_{n+1}}}
                    \&amp; \searrow^{\mathrlap{h_{n+1}}}
                    \\\
                    S^1 \wedge Y_n &amp;\stackrel{\sigma_n^Y}{\longrightarrow}&amp; Y_{n+1}
                    \&amp;&amp;
                    \\\
                    \&amp; \searrow^{\mathrlap{S^1 \wedge l_n}} &amp;&amp; \searrow^{\mathrlap{l_{n+1}}} &amp; \downarrow
                    \\\
                    \&amp;&amp; S^1 \wedge A_n &amp;\stackrel{\sigma_n^A}{\longrightarrow}&amp; A_{n+1}
                    }
                    \\,.
            %p
              This is a
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
              under the commuting square for the structure maps, and therefore the outer diagram is equivalently a morphism out of the
              %a.existingWikiWord{:href => "/nlab/show/domain"} domain
              of the
              %a.existingWikiWord{:href => "/nlab/show/pushout+product"} pushout product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                    %mo □
                    %msubsup
                      %mi σ
                      %mi n
                      %mi X
                  %annotation{:encoding => "application/x-tex"} f_n \Box \sigma_n^X
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#PushoutProduct"}> def.
              ), while the compatible lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi l
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} l_{n+1}
              is equivalently a lift against this
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/pushout+product"} pushout product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi Y
                              %mi n
                            %munder
                              %mo ⊔
                              %mrow
                                %msup
                                  %mi S
                                  %mn 1
                                %mo ∧
                                %msub
                                  %mi X
                                  %mi n
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msubsup
                                  %mi σ
                                  %mi n
                                  %mi A
                                %mo ∘
                                %msup
                                  %mi S
                                  %mn 1
                                %mo ∧
                                %msub
                                  %mi l
                                  %mi n
                                %mo ,
                                %mspace{:width => "thickmathspace"}
                                %msub
                                  %mi h
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi A
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
