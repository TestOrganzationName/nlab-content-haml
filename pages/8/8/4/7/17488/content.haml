                            %msub
                              %mi Y
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
