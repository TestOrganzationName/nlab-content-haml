                            %mi Y
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo =
                            %mo{:stretchy => "false"} ↓
