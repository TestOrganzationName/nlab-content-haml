                            %mi Ω
                            %mi Y
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi A
                            %mo ,
                            %mi hofib
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
