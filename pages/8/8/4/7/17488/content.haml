                                        %mi X
                                        %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                            %mo ⊔
                            %msub
                              %mi X
                              %mn 2
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
