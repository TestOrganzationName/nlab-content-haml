                        %mi stable
                    %annotation{:encoding => "application/x-tex"} J_{seq}^{stable}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
          %p
            This completes the proof of theorem
            = succeed "." do
              %a.maruku-ref{:href => "#AlternativeStableModelStructureOnSequentialSpectraIsModelCategory"}
          %h2#StableHomotopyCategory The stable homotopy category
          #TheStableHomotopyCategory.num_defn
            %h6#definition_26 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ho(Spectra)
                    \\coloneqq
                    Ho(SeqSpec(Top_{cg})_{stable})
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomotopyCategoryOfAModelCategory"}> defn.
              ) of the stable
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+topological+sequential+spectra"} model structure on topological sequential spectra
              from theorem
              = succeed "." do
                %a.maruku-ref{:href => "#StableModelStructureOnSequentialSpectraIsModelCategory"}
            %p
              This is called the
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            of def.
            %a.maruku-ref{:href => "#TheStableHomotopyCategory"}
            inherits particularly nice properties that are usefully axiomatized for themselves. This axiomatics is called
            %em
              %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
            structure (def.
            %a.maruku-ref{:href => "#CategoryWithCofiberSequences"}
            below) where the “triangles” are referring to the structure of the long fiber sequences and long cofiber sequences (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LongFiberSequence"}> prop.
            ) which happen to coincide in stable homotopy theory.
          %h3#Additivity Additivity
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Spectra
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ho(Spectra)
            is the analog in
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            of the category
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            of
            %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            %em not
            an
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            is, but a homotopy-theoretic version of that to which we turn
            = succeed "," do
              %a{:href => "#TriangulatedStructure"} below
            %em is
            an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #StableHomotopyCategoryHasCoproducts.num_lemma
            %h6#lemma_18 Lemma
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TheStableHomotopyCategory"}
              %a.existingWikiWord{:href => "/nlab/show/finite+product"} finite
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              %a.existingWikiWord{:href => "/nlab/show/wedge+sums"} wedge sums
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#WedgeSumOfSpectra"}
              %a.existingWikiWord{:href => "/nlab/show/CW-spectra"} CW-spectra
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CWSpectrum"}
          .proof
            %h6#proof_46 Proof
            %p Having finite coproducts means
            %ol
              %li
                %p
                  having empty coproducts, hence
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/initial+objects"} initial objects
              %li
                %p and having binary coproducts.
            %p Regarding the initial object:
            %p
              The spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn ∞
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty \ast
              (
              %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#SuspensionSpectrum"}
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              and a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SeqSpec
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi cg
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})
              %a.existingWikiWord{:href => "/nlab/show/cylinder+spectrum"} cylinder spectrum
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#StandardCylinderSpectrumSequential"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Σ
                        %mn ∞
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi I
                        %mo +
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mi Σ
                        %mn ∞
                      %mo *
                    %annotation{:encoding => "application/x-tex"} (\Sigma^\infty \ast) \wedge (I_+)\simeq \Sigma^\infty \ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              any fibrant-cofibrant spectrum, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi Spectra
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mn ∞
                    %mo *
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mn ∞
                    %mo *
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{Ho(Spectra)}(\Sigma^\infty \ast, Z)
                    \\simeq
                    Hom_{SeqSpec}(\Sigma^\infty \ast, Z)/_\sim
                    \\simeq
                    \\ast
            %p
              and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn ∞
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty \ast
              also represents the initial object in the stable homotopy category.
            %p Now regarding binary coproducts:
            %p
              By prop.
              %a.maruku-ref{:href => "#CWApproximationForSequentialSpectra"}
              and prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CellSpectraAreCofibrantInModelStructureOnTopologicalSequentialSpectra"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-spectrum
              %a.maruku-ref{:href => "#ClosureOfCWSpectra"}
              the
              %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∨
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \vee Y
              of two CW-spectra is still a CW-spectrum, hence still cofibrant.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              be fibrant and cofibrant replacement functors, respectively, as in the section_
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TheHomotopyCategory"} Classical homotopy theory – The homotopy category
              %em .
            %p
              We claim now that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∨
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(X \vee Y) \in Ho(Spectra)
              is the coproduct of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P X
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} P Y
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi Spectra
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomotopyCategoryOfAModelCategory"}> def.
              ) this is equivalent to claiming that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              any stable fibrant spectrum (hence an
              %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              by theorem
              = succeed ")" do
                %a.maruku-ref{:href => "#StableModelStructureOnSequentialSpectraIsModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∨
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Q
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mo ≃
                    %msub
                      %mi Hom
                      %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %mo ,
                    %mi Q
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mo ×
                    %msub
                      %mi Hom
                      %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi Y
                    %mo ,
                    %mi Q
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{SeqSpec}(P(X \vee Y), Q Z)/_\sim
                    \\simeq
                    Hom_{SeqSpec}(P X, Q Z)/_\sim \times Hom_{SeqSpec}(P Y, Q Z)/_\sim
            %p
              between
              = succeed "-classes" do
                %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
            %p
              But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∨
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \vee Y
              is cofibrant and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              is fibrant, there is a natural isomorphism (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomsOutOfCofibrantIntoFibrantComputeHomotopyCategory"}> prop.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∨
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Q
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi Hom
                      %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∨
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{SeqSpec}(P(X \vee Y), Q Z)/_\sim
                    \\overset{\simeq}{\longrightarrow}
                    Hom_{SeqSpec}(X \vee Y, Z)/_\sim
                    \\,.
            %p
              Now the wedge sum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∨
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \vee Y
              is the coproduct in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SeqSpec
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi cg
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})
              = succeed ")" do
                %a.maruku-ref{:href => "#TensoringAndPoweringOfSequentialSpectra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∨
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∨
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (X \vee Y) \wedge (I_+) \simeq (X \wedge (I_+)) \vee (Y\wedge (I_+))
            %p
              (due to the fact that the
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              of compactly generated
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              distributes this way over wedge sum of pointed spaces). This means that also left homotopies out of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∨
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \vee Y
              are in natural bijection with pairs of left homotopies out of the summands separately, and hence that there is a natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∨
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi Hom
                      %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mo ×
                    %msub
                      %mi Hom
                      %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{SeqSpec}(X \vee Y, Z)/_\sim
                    \\overset{\simeq}{\longrightarrow}
                    Hom_{SeqSpec}(X,Z)/_\sim \times Hom_{SeqSpec}(Y,Z)/_\sim
                    \\,.
            %p
              Finally we may apply the inverse of the natural isomorphism used before (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomsOutOfCofibrantIntoFibrantComputeHomotopyCategory"}> prop.
              ) to obtain in total
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mo ×
                    %msub
                      %mi Hom
                      %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi Hom
                      %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %mo ,
                    %mi Q
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mo ×
                    %msub
                      %mi Hom
                      %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi Y
                    %mo ,
                    %mi Q
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{SeqSpec}(X,Z)/_\sim \times Hom_{SeqSpec}(Y,Z)/_\sim
                    \\overset{\simeq}{\longrightarrow}
                    Hom_{SeqSpec}(P X,Q Z)/_\sim \times Hom_{SeqSpec}(P Y,Q Z)/_\sim
                    \\,.
            %p The composite of all these isomorphisms proves the claim.
          #GroupStructureOnHomsInStableHomotopyCategory.num_defn
            %h6#definition_27 Definition
            %p
              Define
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              structure on the
              %a.existingWikiWord{:href => "/nlab/show/pointed+set"} pointed
              %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              of the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TheStableHomotopyCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"}
                    [X,Y] \in Grp
            %p
              induced from the fact (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LoopingAsFunctorOnHomotopyCategory"}> prop.
              ) that the
              %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              of any
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
              into an object in the image of the canonical loop space functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              inherit group structure, together with the fact (theorem
              = succeed ")" do
                %a.maruku-ref{:href => "#StableModelStructureOnSequentiaSpectraIsStableModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              are inverse to each other, so that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Ω
                    %mi Σ
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [X,Y]
                    \\simeq
                    [X, \Omega \Sigma Y]
                    \\,,
          #StableHomotopyCategoryIsAbEnriched.num_lemma
            %h6#lemma_19 Lemma
            %p
              The group structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X,Y]
              in def.
              %a.maruku-ref{:href => "#GroupStructureOnHomsInStableHomotopyCategory"}
              is
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
              and
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              is
              %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear
              with respect to this group structure. (Hence this makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              an
              = succeed ".)" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enriched category
          .proof
            %h6#proof_47 Proof
            %p
              Recall (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LoopingAsFunctorOnHomotopyCategory"}> prop
              ,
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ConcatenatedLoopSpaceObject"} rmk.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi Δ
                          %mi X
                    %mi X
                    %mo ×
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ,
                        %mi g
                        %mo{:stretchy => "false"} )
                    %mi Ω
                    %mi Σ
                    %mi Y
                    %mo ×
                    %mi Ω
                    %mi Σ
                    %mi Y
                    %mover
                      %mo ⟶
                      %mrow
                    %mi Ω
                    %mi Σ
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X
                    \\overset{\Delta_X}{\to}
                    X \times X
                    \\overset{(f,g)}{\longrightarrow}
                    \\Omega \Sigma Y \times \Omega \Sigma Y
                    \\overset{}{\longrightarrow}
                    \\Omega \Sigma Y
                    \\,.
            %p
              That the group structure is abelian follows via the
              %a.existingWikiWord{:href => "/nlab/show/Eckmann-Hilton+argument"} Eckmann-Hilton argument
              from the fact that there is always a compatible second (and indeed arbitrarily many compatible) further group structures, since, by stability
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
