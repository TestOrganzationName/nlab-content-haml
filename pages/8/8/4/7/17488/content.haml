                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi A
                            %mo ,
                            %mi Ω
                            %mi Σ
                            %mi Y
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [A, \Omega X]
                    \&amp;\longrightarrow&amp;
                    [A,\Omega Y]
                    \&amp;\longrightarrow&amp;
                    [A,hofib(f)]
                    \&amp;\longrightarrow&amp;
                    [A,X]
                    \&amp;\longrightarrow&amp;
                    [A,Y]
                    \\\
                    {}^{\mathllap{=}}\downarrow
                    \&amp;&amp;
                    {}^{\mathllap{=}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{[A,\phi]}}_{}
                    \&amp;&amp;
