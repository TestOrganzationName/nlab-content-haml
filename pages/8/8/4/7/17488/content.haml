                  %annotation{:encoding => "application/x-tex"} id \overset{\eta}{\to} Q
              to obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
