          %h3#TopologicalEnrichment Topological enrichment
          %p
            We discuss here how the
            %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            of homomorphisms between any two sequential spectra is naturally equipped with a topology, and how these
            %em
              %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
            interact well with the strict model structure on sequential spectra from theorem
            = succeed "." do
              %a.maruku-ref{:href => "#StrictModelStructureOnSequentialPrespectraIsModelCategory"}
            %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#CompactlyGeneratedMappingSpaces"}> def.
            ) with the
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on compactly generated topological spaces
            discussed at
            = succeed "." do
              %em
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopologicalEnrichment"} Classical homotopy theory – Topological enrichment
            %a{:href => "#ProofOfTheStableModelStructureOnSequentialSpectra"} the proof of the stable model structure
            and it paves the way to the discussion of fully fledged
            %em
              %a.existingWikiWord{:href => "/nlab/show/mapping+spectra"} mapping spectra
            below in
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1-2"} part 1.2
          #HomSpaceBetweenSequentialSpectra.num_defn
            %h6#definition_16 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X, Y \in SeqSpec(Top_{cg})
              two
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SequentialSpectra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    SeqSpec(X,Y) \in Top_{cg}^{\ast/}
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
              whose underlying set is the
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi SeqSpec
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Top
                          %mi cg
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{SeqSpec(Top_{cg})}(X,Y)
              of homomorphisms from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %a.existingWikiWord{:href => "/nlab/show/final+topology"} final topology
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#InitialAndFinalTopologies"}> def.
              ) generated by those functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi K
                    %mo ⟶
                    %msub
                      %mi Hom
                      %mrow
                        %mi SeqSpec
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Top
                          %mi cg
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\phi
