                              %mi Y
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi B
                              %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_n &amp;\stackrel{h_n}{\longrightarrow}&amp; A_n
                    \\\
                    \\downarrow^{\mathrlap{f_n}} &amp;\nearrow_{\mathrlap{l_n}}&amp; \downarrow
                    \\\
                    Y_n &amp;\longrightarrow&amp; B_n
