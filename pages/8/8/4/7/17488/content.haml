          #StandardAndAlternativeSuspensionAreNotDirectlyComparable.num_remark
            %h6#remark_5 Remark
            %p
              There is no direct
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              between the standard suspension (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SequentialSpectrumRealSuspension"}
              = succeed ")." do
                %a.maruku-ref{:href => "#SequentialSpectrumFakeSuspension"}
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1-2"} Part 1.2
              = succeed ")." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#PointedTopologicalSpacesWithSmashIsSymmetricMonoidalCategory"} this example
            %p
              Namely a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Σ
                    %mi X
                    %mo ⟶
                    %mi X
                    %mo ∧
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi \colon \Sigma X \longrightarrow X \wedge S^1
              (or alternatively the other way around) would have to make the following diagrams commute:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi id
                                  %mrow
                                    %msup
                                      %mi S
                                      %mn 1
                                %mo ∧
                                %msub
                                  %mi ϕ
                                  %mi n
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mi n
                            %mo ∧
                            %msup
                              %mi S
                              %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi S
                                    %mn 1
                                  %mo ∧
                                  %msub
                                    %mi σ
                                    %mi n
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi nc
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi σ
                                    %mi n
                                  %mo ∧
                                  %msup
                                    %mi S
                                    %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ∧
                            %msup
                              %mi S
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^1 \wedge S^1 \wedge X_n
                    \&amp;\overset{id_{S^1} \wedge \phi_n}{\longrightarrow}&amp;
                    S^1 \wedge X_n \wedge S^1
                    \\\
                    {}^{\mathllap{S^1 \wedge \sigma_n}}\downarrow
                    \&amp;(nc)&amp;
                    \\downarrow^{\mathrlap{\sigma_n \wedge S^1}}
                    \\\
                    S^1 \wedge X_{n+1}
                    \&amp;\underset{\phi_{n+1}}{\longrightarrow}&amp;
                    X_{n+1} \wedge S^1
                    }
            %p
              and
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturally
              so in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              The only evident option is to have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              be the
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              homomorphisms of the
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi n
                    %mo =
                    %msub
                      %mi τ
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                        %mo ,
                        %msub
                          %mi X
                          %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msub
                      %mi X
                      %mi n
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi X
                      %mi n
                    %mo ∧
                    %msup
                      %mi S
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_n = \tau_{S^1, X_n}
                    \\;\colon\;
                    S^1 \wedge X_{n}
                    \\overset{\simeq}{\to}
                    X_{n} \wedge S^1
                    \\,.
            %p
              It may superficially look like this makes the above diagram commute, but it does not. To make this explicit, consider labeling the two copies of the circle appearing here as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi S
                      %mi a
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1_a
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi S
                        %mi b
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1_b
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi S
                              %mi a
                              %mn 1
                            %mo ∧
                            %msubsup
                              %mi S
                              %mi b
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %msubsup
                              %mi S
                              %mi a
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mi n
                            %mo ∧
                            %msubsup
                              %mi S
                              %mi b
                              %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msubsup
                                    %mi S
                                    %mi a
                                    %mn 1
                                  %mo ∧
                                  %msub
                                    %mi σ
                                    %mi n
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi nc
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi σ
                                    %mi n
                                  %mo ∧
                                  %msubsup
                                    %mi S
                                    %mi b
                                    %mn 1
                        %mtr
                          %mtd
                            %msubsup
                              %mi S
                              %mi a
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ∧
                            %msubsup
                              %mi S
                              %mi b
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S_a^1 \wedge S_b^1 \wedge X_n
                    \&amp;\longrightarrow&amp;
                    S_a^1 \wedge X_n \wedge S_b^1
                    \\\
                    {}^{\mathllap{S^1_a \wedge \sigma_n}}\downarrow
                    \&amp;(nc)&amp;
                    \\downarrow^{\mathrlap{\sigma_n \wedge S^1_b}}
                    \\\
                    S_a^1 \wedge X_{n+1} &amp;\underset{}{\longrightarrow}&amp; X_{n+1} \wedge S_b^1
                    }
            %p
              If we had
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi S
                      %mi a
                      %mn 1
                    %mo ∧
                    %msub
                      %mi σ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^1_a \wedge \sigma_n
              on the left and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi n
                    %mo ∧
                    %msubsup
                      %mi S
                      %mi a
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma_n \wedge S^1_a
              on the right, then the
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturality
              of the
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              would indeed give a commuting diagram. But since this is not the case, the only way to achieve this would be by exchanging in the top left
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi S
                      %mi a
                      %mn 1
                    %mo ∧
                    %msubsup
                      %mi S
                      %mi b
                      %mn 1
                    %mo ⟶
                    %msubsup
                      %mi S
                      %mi b
                      %mn 1
                    %mo ∧
                    %msubsup
                      %mi S
                      %mi a
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^1_a \wedge S^1_b \longrightarrow S^1_b \wedge S^1_a
                    \\,.
            %p
              However, this map is non-trivial. It represents
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} -1
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi S
                        %mn 2
                      %mo ,
                      %msup
                        %mi S
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mo *
                      %mo =
                      %msub
                        %mi π
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} [S^2, S^2]_\ast = \pi_2(S^2) = \mathbb{Z}
            %p
              But this technical problem points to its own solutions: if we were to restrict to the homotopy category of spectra which had structure maps only of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                      %mo ∧
                      %msub
                        %mi X
                        %mi n
                      %mo →
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo +
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} S^2 \wedge X_n \to X_{n+2}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi S
                      %mi a
                      %mn 2
                    %mo ∧
                    %msubsup
                      %mi S
                      %mi b
                      %mn 1
                    %mo ⟶
                    %msubsup
                      %mi S
                      %mi b
                      %mn 1
                    %mo ∧
                    %msubsup
                      %mi S
                      %mi a
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    S^2_a \wedge S^1_b \longrightarrow S^1_b \wedge S^2_a
            %p
              and this map is indeed trivial, up to homotopy. This we make precise as lemma
              %a.maruku-ref{:href => "#IsomorphismBetweenStandardAndAlternativeSuspensionInHomotopyCategory"}
              below.
            %p
              More generally, the kind of issue encountered here is taken care of by the concept of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1-2"} Part 1.2
          #ShiftingCommutesWithLoopingAndSuspensionOfSequentialSpectra.num_defn
            %h6#remark_6 Remark
            %p
              The looping and suspension operations in def.
              %a.maruku-ref{:href => "#SequentialSpectrumRealSuspension"}
              and def.
              %a.maruku-ref{:href => "#SequentialSpectrumFakeSuspension"}
              commute with shifting, def.
              = succeed "." do
                %a.maruku-ref{:href => "#ShiftedSpectrum"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Sigma (X[1])
              etc. we may omit the parenthesis.
          #AdjunctionsBetweenLoopingAndDeloopingForSeqSpec.num_prop
            %h6#proposition_9 Proposition
            %p
              The constructions from def.
              = succeed "," do
                %a.maruku-ref{:href => "#SequentialSpectrumRealSuspension"}
              %a.maruku-ref{:href => "#ShiftedSpectrum"}
              and def.
              %a.maruku-ref{:href => "#SequentialSpectrumFakeSuspension"}
              form pairs of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SeqSpec
                    %mo →
                    %mi SeqSpec
                  %annotation{:encoding => "application/x-tex"} SeqSpec \to SeqSpec
              like so:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ⊣
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} (-)[-1] \dashv (-)[1]
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ∧
                        %msup
                          %mi S
                          %mn 1
                        %mo ⊣
                        %mi Maps
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 1
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo *
                      %annotation{:encoding => "application/x-tex"} (-)\wedge S^1 \dashv Maps(S^1,-)_\ast
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi Σ
                        %mo ⊣
                        %mi Ω
                      %annotation{:encoding => "application/x-tex"} \Sigma \dashv \Omega
                  \.
          .proof
            %h6#proof_9 Proof
            %p Regarding the first statement:
            %p
              A morphism of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X[-1] \longrightarrow Y
              has components of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋮
                          %mtd
                          %mtd
                            %mi ⋮
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 2
                          %mtd
                            %msub
                              %mi Y
                              %mn 3
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 2
                          %mtd
                            %msub
                              %mi Y
                              %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 0
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 1
                          %mtd
                            %msub
                              %mi Y
                              %mn 1
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 0
                                %mo =
                                %mn 0
                          %mtd
                            %msub
                              %mi Y
                              %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\vdots &amp;&amp; \vdots
                    \\\
                    X_2 &amp;\overset{f_2}{\longrightarrow}&amp; Y_3
                    \\\
                    X_1 &amp;\overset{f_2}{\longrightarrow}&amp; Y_2
                    \\\
                    X_0 &amp;\overset{f_1}{\longrightarrow}&amp; Y_1
                    \\\
                    \\ast &amp;\overset{f_0 = 0}{\longrightarrow}&amp; Y_0
                    }
            %p and the compatibility condition with the structure maps in lowest degree is automatically satisfied
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi S
                                  %mn 1
                                %mo ∧
                                %msub
                                  %mi f
                                  %mn 0
                                %mo{:stretchy => "false"} )
                                %mo =
                                %mn 0
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi Y
                              %mn 0
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msubsup
                                    %mi σ
                                    %mn 0
                                    %mrow
                                      %mi X
                                      %mo{:stretchy => "false"} [
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                                      %mo{:stretchy => "false"} ]
                                  %mo =
                                  %mn 0
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi σ
                                    %mn 0
                                    %mi Y
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 0
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 1
                          %mtd
                            %msub
                              %mi Y
                              %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\ast &amp;\overset{(S^1 \wedge f_0) = 0}{\longrightarrow}&amp; S^1 \wedge Y_0
                    \\\
                    {}^{\mathllap{\sigma^{X[-1]}_0 = 0}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\sigma^Y_0}}
                    \\\
                    X_0 &amp;\overset{f_1}{\longrightarrow}&amp; Y_1
                    }
                    \\,.
            %p Therefore this is equivalent to components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋮
                          %mtd
                          %mtd
                            %mi ⋮
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 2
                          %mtd
                            %msub
                              %mi Y
                              %mn 3
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 2
                          %mtd
                            %msub
                              %mi Y
                              %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 0
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 1
                          %mtd
                            %msub
                              %mi Y
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\vdots &amp;&amp; \vdots
                    \\\
                    X_2 &amp;\overset{f_2}{\longrightarrow}&amp; Y_3
                    \\\
                    X_1 &amp;\overset{f_2}{\longrightarrow}&amp; Y_2
                    \\\
                    X_0 &amp;\overset{f_1}{\longrightarrow}&amp; Y_1
                    }
            %p
              hence to a morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⟶
                      %mi Y
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} X \longrightarrow Y[1]
            %p
              The second statement is a special case of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#AdjunctionBetweenSmashTensoringAndPowering"}
            %p Regarding the third statement:
            %p
              This follows by applying the (
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊣
                  %annotation{:encoding => "application/x-tex"} \dashv
              = succeed ")-adjunction" do
                %a.existingWikiWord{:href => "/nlab/show/pointed+mapping+space"} pointed mapping space
            %p
              Morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Σ
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\colon \Sigma X \to Y
              in the sense of def.
              %a.maruku-ref{:href => "#SequentialSpectra"}
              are in components given by commuting diagrams of this form:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msup
                                  %mi S
                                  %mn 1
                                %mo ∧
                                %msub
                                  %mi f
                                  %mi n
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi Y
                              %mi n
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi S
                                    %mn 1
                                  %mo ∧
                                  %msubsup
                                    %mi σ
                                    %mi n
                                    %mi X
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi σ
                                    %mi n
                                    %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                          %mtd
                            %msub
                              %mi Y
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^1 \wedge S^1 \wedge X_{n}
                    \&amp;\overset{S^1 \wedge f_{n}}{\longrightarrow}&amp;
                    S^1 \wedge Y_{n}
                    \\\
                    {}^{\mathllap{S^1 \wedge \sigma_n^X}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\sigma^Y_n}}
                    \\\
                    S^1 \wedge X_{n+1} &amp;\underset{f_{n+1}}{\longrightarrow}&amp; Y_{n+1}
                    }
                    \\,.
            %p Applying the adjunction isomorphism diagonally gives a natural bijection to diagrams of this form:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mi n
                          %mtd
                            %msub
                              %mi Y
                              %mi n
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msubsup
                                    %mi σ
                                    %mi n
                                    %mi X
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mover
                                      %mi σ
                                      %mo{:stretchy => "false"} ˜
                                    %mi n
                                    %mi Y
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                            %munder
                              %mo ⟶
                              %mover
                                %mrow
                                  %msub
                                    %mi f
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                                %mo ˜
                          %mtd
                            %mi Maps
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mn 1
                            %mo ,
                            %msub
                              %mi Y
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^1 \wedge X_n &amp;\overset{f_n}{\longrightarrow}&amp; Y_n
                    \\\
                    {}^{\mathllap{\sigma^X_n}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\tilde \sigma^Y_n}}
                    \\\
                    X_{n+1} &amp;\underset{\widetilde {f_{n+1}}}{\longrightarrow}&amp; Maps(S^1,Y_{n+1})_\ast
                    }
                    \\,.
            %p
              (To see this in full detail, for instance for the
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of the left and bottom morphism: chase the identity
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                  %annotation{:encoding => "application/x-tex"} id_{S^1 \wedge X_{n+1}}
              in both ways
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ,
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ,
                            %mi Maps
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mn 1
                            %mo ,
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo{:stretchy => "false"} )
                        %mtr
