            %h6#proof_54 Proof
            %p Regarding the first case:
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∘
                    %mi f
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} g \circ f = 0
              by lemma
              = succeed "," do
                %a.maruku-ref{:href => "#CompositesInADistinguishedTriangleAreZero"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi g
                      %mo ,
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo ,
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} im([g,X]_\ast) \subset ker([f,X]_\ast)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \psi \colon B \to X
              is in the kernel of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                  %annotation{:encoding => "application/x-tex"} [f,X]_\ast
              in that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo ∘
                      %mi f
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \psi \circ f = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi \colon B/A \to X
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo ∘
                      %mi g
                      %mo =
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \phi \circ g = \psi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi B
                            %mo{:stretchy => "false"} /
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi h
