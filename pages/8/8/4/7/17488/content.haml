                              %mi b
                          %mtd
                            %mi X
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mi η
                          %mtd
                            %mi Ω
                            %mi Σ
                            %mi X
                            %mo ≃
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
