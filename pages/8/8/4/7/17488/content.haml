                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo =
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mi A
