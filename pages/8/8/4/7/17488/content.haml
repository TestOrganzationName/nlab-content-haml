                %semantics
                  %mrow
                    %mi Σ
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \Sigma a
              is an isomorphism. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
