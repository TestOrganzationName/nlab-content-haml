              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi seq
                        %mi stable
                    %annotation{:encoding => "application/x-tex"} J_{seq}^{stable}
              %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              followed by a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi seq
                        %mi stable
                    %annotation{:encoding => "application/x-tex"} J_{seq}^{stable}
              %a.existingWikiWord{:href => "/nlab/show/injective+morphism"} injective morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
