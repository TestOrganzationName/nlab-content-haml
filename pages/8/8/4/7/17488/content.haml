              %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
              against
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/retract+argument"} retract argument
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#RetractArgument"}> prop.
              ) implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a retract of the relative
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
