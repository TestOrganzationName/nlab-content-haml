                        %mi τ
                    %msub
                      %mi L
                      %mn 2
                    %msub
                      %mi R
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi X
                    %mo ∧
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
