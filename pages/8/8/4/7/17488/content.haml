                    \\simeq
                    L_2 R_2 (\Sigma X)
                    \\underoverset{\simeq}{L_2 \tau}{\longrightarrow}
                    L_2 R_2 (X \wedge S^1)
                    \\simeq
                    X \wedge S^1
            %p
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
