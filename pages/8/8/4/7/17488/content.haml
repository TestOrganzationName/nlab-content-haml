                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝕊
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                  %annotation{:encoding => "application/x-tex"} [\mathbb{S},X]_\ast
              is given by left homotopy classes of morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn ∞
                    %msup
                      %mi S
                      %mn 0
                    %mo =
                    %msub
                      %mi 𝕊
                      %mi std
                    %mo ⟶
                    %mi Q
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma^\infty S^0 = \mathbb{S}_{std} \longrightarrow Q X
            %p
