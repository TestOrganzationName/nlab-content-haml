            %h6#proof_37 Proof
            %p
              By lemma
              = succeed "," do
                %a.maruku-ref{:href => "#StandardSuspensionOfSequentialSpectraRepresentsCanonicalSuspension"}
              = succeed "." do
                %a.maruku-ref{:href => "#SequentialSpectrumRealSuspension"}
              %a.maruku-ref{:href => "#IsomorphismBetweenStandardAndAlternativeSuspensionInHomotopyCategory"}
              this is naturally isomorphic – on the level of the homotopy category – to the alternative suspension operation of def.
              = succeed "." do
                %a.maruku-ref{:href => "#SequentialSpectrumFakeSuspension"}
              = succeed "." do
                %a.maruku-ref{:href => "#FakeSuspensionInducesEquivalenceOfHomotopyCategories"}
          %p In fact this lifts to a Quillen equivalence:
          #AlternativeLoopingAndSuspensionIsQuillenEquivalenceOnStableModelStructure.num_prop
            %h6#proposition_26 Proposition
            %p
              The
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo ⊣
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Sigma \dashv \Omega)
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              from prop.
              %a.maruku-ref{:href => "#AdjunctionsBetweenLoopingAndDeloopingForSeqSpec"}
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#QuillenEquivalence"}> def.
              ) with respect to the stable model structure of theorem
              = succeed ":" do
                %a.maruku-ref{:href => "#StableModelStructureOnSequentialSpectraIsModelCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SeqSpec
