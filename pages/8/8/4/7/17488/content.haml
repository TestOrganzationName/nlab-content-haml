              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is a stable weak homotopy equivalence, and hence by assumption and by
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              so is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.maruku-ref{:href => "#KInjectiveStableEquivalencesAreStrictEquivalencesForSequentialSpectra"}
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
