              is a
              %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-spectrum
              and hence cofibrant, by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CellSpectraAreCofibrantInModelStructureOnTopologicalSequentialSpectra"}
              %a.maruku-ref{:href => "#CylinderSpectrumOverCWSpectrumIsGood"}
              that left homotopies out of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi str
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{str}
              are represented by the standard sequential
              %a.existingWikiWord{:href => "/nlab/show/cylinder+spectrum"} cylinder spectrum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
