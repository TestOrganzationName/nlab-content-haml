                    \\,.
            %p
              which is degreewise a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              = succeed "." do
                %a.maruku-ref{:href => "#StrictModelStructureOnSequentialPrespectraIsModelCategory"}
          .proof
            %h6#proof_18 Proof
            %p
              First let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mn 0
                    %mo ⟶
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \hat X_0 \longrightarrow X_0
              be a CW-approximation of the component space in degree 0, via prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CWApproximationForContinuousFunctions"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
