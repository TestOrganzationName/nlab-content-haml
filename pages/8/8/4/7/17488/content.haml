          #SuspensionAndLoopingOnPointedTopologicalSpaces.num_defn
            %h6#definition Definition
            %p
              The
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"} reduced suspension
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} looping
              operation on
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#CategoryOfPointedObjects"}> def.
              )
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#kTop"}> def.
              ) is the smash-tensor/hom-
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#SmashHomAdjunctionOnPointedCompactlyGeneratedTopologicalSpaces"}> cor.
              ) for the standard
              %a.existingWikiWord{:href => "/nlab/show/1-sphere"} 1-sphere
              smash product from the left:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ⊣
                    %mi Ω
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mspace{:width => "thickmathspace"}
                    %munderover
                      %mo ⊥
                      %munder
                        %mo →
                        %mrow
                          %mi Maps
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mn 1
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                          %mo ∧
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Sigma \dashv \Omega)
                    \\;\colon\;
                    Top_{cg}^{\ast/}
                    \\;
                    \\underoverset
                    {\xrightarrow[Maps(S^1,-)_\ast]{}}
                    {\xleftarrow{S^1 \wedge (-)}}
                    {\bot}
                    \\;
                    Top_{cg}^{\ast/}
                    \\,.
          #SuspensionAndLoopAdjunctionInClassicalHomotopyTheory.num_prop
            %h6#proposition Proposition
            %p
              With respect to the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure
              on pointed compactly generated topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} (Top^{\ast/}_{cg})_{Quillen}
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ClassicalModelStructureOnCompactlyGeneratedTopologicalSpaces"}> thm.
              ,
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ModelStructureOnSliceCategory"} prop.
            %ol
              %li
                %p
                  the adjunction in def.
                  %a.maruku-ref{:href => "#SuspensionAndLoopingOnPointedTopologicalSpaces"}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#QuillenAdjunction"}> def.
                  )
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo ⊣
                        %mi Ω
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi Top
                          %mi cg
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi Quillen
                        %munderover
                          %mo ⊥
                          %munder
                            %mo ⟶
                            %mrow
                              %mi Maps
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi S
                                %mn 1
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mo{:stretchy => "false"} )
                                %mo *
                          %mover
                            %mo ⟵
                            %mrow
                              %msup
                                %mi S
                                %mn 1
