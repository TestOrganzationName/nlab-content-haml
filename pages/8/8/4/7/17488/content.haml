                  %semantics
                    %mrow
                      %mi SeqSpec
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi cg
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})
              = succeed "-adjunction" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
