              (formed via prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#LimitsAndColimitsOfSequentialSpectra"}
              %a.existingWikiWord{:href => "/nlab/show/cylinder+spectrum"} cylinder spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \wedge (I_+)
              of example
              = succeed ":" do
                %a.maruku-ref{:href => "#StandardCylinderSpectrumSequential"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∧
                    %msup
                      %mi S
                      %mn 1
                    %mo ≃
                    %mi cofib
                    %mrow
                      %mo (
                      %mi X
                      %mo ∨
                      %mi X
                      %mo →
                      %mi X
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi I
                        %mo +
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \wedge S^1
                    \\simeq
                    cofib\left(
                    X \vee X \to X \wedge (I_+)
                    \\right)
                    \\,.
          .proof
            %h6#proof_8 Proof
            %p
              This is immediate from the componentwise construction of the smash tensoring and the componentwise computation of colimits of spectra via prop.
              = succeed "." do
                %a.maruku-ref{:href => "#LimitsAndColimitsOfSequentialSpectra"}
          %p
            This means that once we know that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∨
                  %mi X
                  %mo →
                  %mi X
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi I
                    %mo +
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X\vee X \to X \wedge (I_+)
            is suitably a cofibration (to which we turn
            = succeed ")" do
              %a{:href => "#CWSpectra"} below
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})
            %a.maruku-ref{:href => "#IsomorphismBetweenStandardAndAlternativeSuspensionInHomotopyCategory"}
            below) they will become isomorphic in the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#TheStableHomotopyCategory"}
          #ShiftedSpectrum.num_defn
