                                  %msubsup
                                    %mi σ
                                    %mi n
                                    %mi X
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi l
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                            %mo ↗
