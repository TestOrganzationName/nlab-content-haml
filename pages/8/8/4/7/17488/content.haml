                    X
                    \\\
                    {}^{\mathllap{=}}\downarrow
                    \&amp;(1)&amp;
                    \\downarrow^{\mathrlap{\phi}}_{\mathrlap{\simeq}}
                    \&amp;(2)&amp;
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    \\Omega Y
                    \&amp;\underset{c}{\longrightarrow}&amp;
                    \\Omega hocof(f)
                    \&amp;\underset{d}{\longrightarrow}&amp;
                    \\Omega \Sigma X
                    }
                    \\,.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be represented by a
              %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-spectrum
              (by prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#CWApproximationForSequentialSpectra"}
              = succeed ")." do
                %a.maruku-ref{:href => "#CellSpectraAreCofibrantInModelStructureOnTopologicalSequentialSpectra"}
              %a.maruku-ref{:href => "#CylinderSpectrumOverCWSpectrumIsGood"}
              and the
              %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#FactorizationLemma"}> lemma
              ) this implies that the standard
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              construction on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#MappingConeAndMappingCocone"}> def.
              ) is a model for the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#StandardTopologicalMappingConeIsHomotopyCofiber"}> exmpl.
              ):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hocof
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    hocof(f) \simeq Cone(f)
                    \\,.
            %p
              By construction of mapping cones, this sits in the following
              %a.existingWikiWord{:href => "/nlab/show/commuting+squares"} commuting squares
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
