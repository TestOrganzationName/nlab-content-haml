                                  %mn 1
                                %mo ∧
                                %msub
                                  %mi σ
                                  %mrow
                                    %mi n
                                    %mo −
                                    %mn 1
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mi n
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi S
                                    %mn 1
                                  %mo ∧
                                  %msub
                                    %mi σ
                                    %mrow
                                      %mi n
                                      %mo −
                                      %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi σ
                                    %mi n
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mi n
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi σ
                                  %mi n
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^1 \wedge S^1 \wedge X_{n-1}
                    \&amp;\overset{S^1 \wedge \sigma_{n-1}}{\longrightarrow}&amp;
                    S^1 \wedge X_n
                    \\\
                    {}^{\mathllap{S^1 \wedge \sigma_{n-1}}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\sigma_n}}
                    \\\
                    S^1 \wedge X_{n}
                    \&amp;\underset{\sigma_n}{\longrightarrow}&amp;
                    X_{n+1}
                    }
                    \\,.
            %p But in all these cases commutativity it trivially satisfied.
            %p
              That the adjunct structure maps constitute a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Ω
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X \to \Omega X[1]
              follows
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} dually
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
            %p
              From this it follows that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma X[-1]\to X
              is a stable weak homotopy equivalence, because for every
              %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              then by the adjunctions in prop.
              %a.maruku-ref{:href => "#AdjunctionsBetweenLoopingAndDeloopingForSeqSpec"}
              we have a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi Y
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi strict
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi Σ
                            %mi X
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mi Y
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi strict
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi id
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi Y
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi strict
                          %mtd
                            %munder
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi Ω
                            %mi Y
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi strict
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [X, Y]_{strict} &amp;\overset{}{\longrightarrow}&amp; [\Sigma X[-1],Y]_{strict}
                    \\\
                    {}^{\mathllap{id}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    [X,Y]_{strict}  &amp;\underset{\simeq}{\longrightarrow}&amp; [X, \Omega Y[1]]_{strict}
                    }
                    \\,.
            %p
              (To see the commutativity of this diagram in detail, consider for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi strict
                  %annotation{:encoding => "application/x-tex"} [f] \in [X,Y]_{strict}
              chasing the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi σ
                      %mi n
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \sigma_n^Y
              in the two possible ways through the natural adjunction isomorphism:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi Y
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ,
                            %msub
                              %mi Y
                              %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Y
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ,
                            %mi Ω
                            %msub
                              %mi Y
                              %mi n
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msup
                                    %mi S
                                    %mn 1
                                  %mo ∧
                                  %msub
                                    %mi f
                                    %mrow
                                      %mi n
                                      %mo −
                                      %mn 1
                                  %mo ,
                                  %msub
                                    %mi Y
                                    %mi n
                                  %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msub
                                    %mi f
                                    %mrow
                                      %mi n
                                      %mo −
                                      %mn 1
                                  %mo ,
                                  %mi Ω
                                  %msub
                                    %mi Y
                                    %mi n
                                  %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ,
                            %msub
                              %mi Y
                              %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ,
                            %mi Ω
                            %msub
                              %mi Y
                              %mi n
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [S^1 \wedge Y_{n-1}, Y_n]
                    \&amp;\simeq&amp;
                    [Y_{n-1}, \Omega Y_n]
                    \\\
                    {}^{\mathllap{[S^1 \wedge f_{n-1}, Y_n]}}\downarrow &amp;&amp; \downarrow^{\mathrlap{[f_{n-1}, \Omega Y_n]}}
                    \\\
                    [S^1 \wedge X_{n-1}, Y_n]
                    \&amp;\simeq&amp;
                    [X_{n-1}, \Omega Y_n]
                    }
                    \\,.
            %p
              Sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi σ
                      %mi n
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \sigma_n^Y
              down gives
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi σ
                      %mi n
                      %mi Y
                    %mo ∘
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msub
                      %mi f
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma_n^Y \circ S^1 \wedge f_{n-1}
              which equals (by the homomorphism property)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi n
                      %mo ∘
                      %msubsup
                        %mi σ
                        %mi n
                        %mi X
                    %annotation{:encoding => "application/x-tex"} f_n \circ \sigma_n^X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi σ
                      %mi n
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \sigma_n^Y
              to the right yields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mover
                        %mi σ
                        %mo{:stretchy => "false"} ˜
                      %mi n
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \tilde \sigma_n^Y
              and then down yields
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mover
                          %mi σ
                          %mo{:stretchy => "false"} ˜
                        %mi n
                        %mi Y
                      %mo ∘
                      %msub
                        %mi f
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \tilde \sigma_n^Y \circ f_{n-1}
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi n
                      %mo ∘
                      %msubsup
                        %mi σ
                        %mi n
                        %mi X
                    %annotation{:encoding => "application/x-tex"} f_n \circ \sigma_n^X
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi strict
                    %mover
                      %mo ⟶
                      %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi strict
                  %annotation{:encoding => "application/x-tex"}
                    [X, Y]_{strict} \overset{}{\longrightarrow} [\Sigma X[-1],Y]_{strict}
            %p
              is a bijection for all Omega-spectra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma X[-1]\to X
              is a stable weak homotopy equivalence follows as in the proof of lemma
              = succeed "." do
                %a.maruku-ref{:href => "#FakeLoopingPreservesOmegaSpectra"}
          #FakeSuspensionInducesEquivalenceOfHomotopyCategories.num_lemma
            %h6#lemma_8 Lemma
            %p
              The total
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              of the alternative suspension operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              of def.
              %a.maruku-ref{:href => "#SequentialSpectrumFakeSuspension"}
              exists and constitutes an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              from the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              to itself:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma
                    \\;\colon\;
                    Ho(SeqSpec(Top)_{stable})
                    \\overset{\simeq}{\longrightarrow}
                    Ho(SeqSpec(Top)_{stable})
                    \\,.
          .proof
            %h6#proof_31 Proof
            %p
              The total derived functor of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              exists, because by lemma
              %a.maruku-ref{:href => "#FakeLoopingPreservesOmegaSpectra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              preserves stable weak homotopy equivalences. Also the shift functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-1]
              from def.
              %a.maruku-ref{:href => "#ShiftedSpectrum"}
              clearly preserves stable equivalences, hence both descend to the homotopy category. There, by prop.
              %a.maruku-ref{:href => "#CounitOfFakeSuspensionAndShiftIsStableEquivalence"}
              and remark
              = succeed "," do
                %a.maruku-ref{:href => "#ShiftingCommutesWithLoopingAndSuspensionOfSequentialSpectra"}
          #StandardSuspensionOfSequentialSpectraRepresentsCanonicalSuspension.num_lemma
            %h6#lemma_9 Lemma
            %p
              The canonical suspension functor on the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
              of any
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              (from
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LoopingAsFunctorOnHomotopyCategory"} this prop.
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TheStableHomotopyCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra) = Ho(SeqSpec(Top_{cg})_{stable})
              is represented by the “standard suspension” operation of def.
              = succeed "." do
                %a.maruku-ref{:href => "#SequentialSpectrumRealSuspension"}
          .proof
            %h6#proof_32 Proof
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/CW-approximation"} CW-approximation
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#CWApproximationForSequentialSpectra"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-spectrum
              = succeed "," do
                %a.maruku-ref{:href => "#CylinderSpectrumOverCWSpectrumIsGood"}
              %a.existingWikiWord{:href => "/nlab/show/CW-spectra"} CW-spectra
              the canonical suspension functor on the homotopy category (from
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LoopingAsFunctorOnHomotopyCategory"} this prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SequentialSpectrumRealSuspension"}
          %p
            The combination of lemma
            %a.maruku-ref{:href => "#FakeSuspensionInducesEquivalenceOfHomotopyCategories"}
            with lemma
            %a.maruku-ref{:href => "#StandardSuspensionOfSequentialSpectraRepresentsCanonicalSuspension"}
            gives that in order to show that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SeqSpec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Top
                    %mi cg
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi stable
                %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})_{stable}
            is indeed a
            %a.existingWikiWord{:href => "/nlab/show/stable+model+category"} stable model category
            according to def.
            = succeed "," do
              %a.maruku-ref{:href => "#StableModelCategory"}
          %p
            According to remark
            = succeed "," do
              %a.maruku-ref{:href => "#StandardAndAlternativeSuspensionAreNotDirectlyComparable"}
          %p
            Observe that the definition of the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SeqSpec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Top
                    %mi cg
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})
            of
            %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
            in def.
            %a.maruku-ref{:href => "#SequentialSpectra"}
            does not require anything specific of the circle
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            in place of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
