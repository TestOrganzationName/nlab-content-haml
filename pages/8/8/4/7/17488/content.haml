              %a.maruku-ref{:href => "#SequentialSpectra"}>
              ), then there exists a
              %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CWSpectrum"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
