                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Σ
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\longrightarrow&amp; Cone(X)
                    \\\
                    \\downarrow &amp;(po)&amp; \downarrow
                    \\\
                    Y &amp;\longrightarrow&amp; Cone(f)
                    \\\
                    \\downarrow &amp;(po)&amp; \downarrow
                    \\\
                    \\ast &amp;\longrightarrow&amp; \Sigma X
                    }
                    \\,.
            %p
              Consider then the
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Ω
                            %mi Y
                          %mtd
                            %mover
                              %mo ⟶
                              %mi a
                          %mtd
                            %mi hofib
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi ϕ
                          %mtd
                            %mi Ω
                            %mi hocof
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi d
                          %mtd
                            %mi Ω
                            %mi Σ
                            %mi X
                            %mo ≃
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
