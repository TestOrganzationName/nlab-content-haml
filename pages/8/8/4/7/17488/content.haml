                      %msub
                        %mi Top
                        %mi cg
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Cone
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Cone
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
