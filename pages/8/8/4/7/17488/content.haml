                    [A,\Omega Y]
                    \&amp;\longrightarrow&amp;
                    [A,\Omega hocof(f)]
                    \&amp;\longrightarrow&amp;
                    [A,\Omega \Sigma X]
                    \&amp;\longrightarrow&amp;
