                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi Y
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
