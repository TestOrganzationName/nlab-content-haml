                        %mo *
                      %annotation{:encoding => "application/x-tex"} S^1 \wedge \ast \simeq \ast \overset{\simeq}{\to} \ast
                  is an isomorphism in this case the
                  %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                  reduces to just its second summand, and so this is now equivalent to
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msub
                          %mi X
                          %mi n
                        %mo ⟶
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        S^1 \wedge X_n \longrightarrow X_{n+1}
                %p
                  being classical cofibrations; hence
                  %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
                  of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
          #CylinderSpectrumOverCWSpectrumIsGood.num_prop
            %h6#proposition_15 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi strict
                  %annotation{:encoding => "application/x-tex"} X\in SeqSpec(Top)_{strict}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-spectrum
              = succeed "," do
                %a.maruku-ref{:href => "#CWSpectrum"}
              %a.existingWikiWord{:href => "/nlab/show/cylinder+spectrum"} cylinder spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \wedge (I_+)
              of def.
              %a.maruku-ref{:href => "#StandardCylinderSpectrumSequential"}
              satisfies the conditions of an abstract
              %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#PathAndCylinderObjectsInAModelCategory"}> def.
              ) in that the inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∨
                    %mi X
                    %mo ⟶
                    %mi X
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X \vee X \longrightarrow X \wedge (I_+)
            %p
              (of the
              %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with itself, example
              = succeed ")" do
                %a.maruku-ref{:href => "#WedgeSumOfSpectra"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SeqSpec
                      %mo{:stretchy => "false"} (
                      %mi Top
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi strict
                    %annotation{:encoding => "application/x-tex"} SeqSpec(Top)_{strict}
          .proof
            %h6#proof_16 Proof
            %p
              According to def.
              %a.maruku-ref{:href => "#ClassesOfMorphismsOfTheStrictModelStructureOnSequentialSpectra"}
              we need to check that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∨
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %munder
                      %mo ⊔
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ∨
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi n
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    (X \vee X)_{n+1}
                    \\underset{S^1 \wedge (X\vee X)_n}{\sqcup}
                    S^1 \wedge (X \wedge (I_+))_n
                    \\longrightarrow
                    (X \wedge (I_+))_{n+1}
            %p is a retract of a relative cell complex. After distributing indices and smash products over wedge sums, this is equivalently
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∨
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ⊔
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msub
                          %mi X
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo ∨
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msub
                          %mi X
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msub
                      %mi X
                      %mi n
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (X_{n+1} \vee X_{n+1})
                    \\underset{(S^1 \wedge X_n )\vee (S^1 \wedge X_n))}{\sqcup}
                    S^1 \wedge X_n \wedge (I_+)
                    \\longrightarrow
                    X_{n+1} \wedge (I_+)
                    \\,.
            %p
              Now by the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_{n}
              is a CW-complex, and this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X_n \wedge (I_+)
              is a relative cell complex in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} Top^{\ast/}
          %p
            We now turn to discussion of
            %a.existingWikiWord{:href => "/nlab/show/CW-approximation"} CW-approximation
            of sequential spectra. First recall the relative version of CW-approximation for topological spaces.
          %p
            For the following, recall that a
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f \colon X \to Y
            between
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            is called an
            %strong
              %a.existingWikiWord{:href => "/nlab/show/n-connected+map"} n-connected map
            if the induced morphism on
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_\bullet(f)\colon \pi_\bullet(X,x) \to \pi_\bullet(Y,f(x))
            is
          %ol
            %li
              %p
                an
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                in degree
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo &lt;
                        %mi n
                      %annotation{:encoding => "application/x-tex"} \lt n
            %li
              %p
                an
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
                in degree
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
          %p
            (Hence an
            %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            is an “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-connected map”.)
          #nConnectedCWApproximationOfContinuousFunction.num_lemma
            %h6#lemma_2 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; A \longrightarrow X
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              between
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              a
              %a.existingWikiWord{:href => "/nlab/show/relative+CW-complex"} relative CW-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ↪
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat f \colon A \hookrightarrow \hat X
              together with an
              %a.existingWikiWord{:href => "/nlab/show/extension"} extension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:lspace => "verythinmathspace"} :
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \phi \colon \hat X \to X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mi ϕ
                        %mtr
                          %mtd
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\overset{f}{\longrightarrow}&amp; X
                    \\\
                    {}^{\mathllap{\hat f}}\downarrow &amp; \nearrow_{\mathrlap{\phi}}
                    \\\
                    \\hat X
                    }
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-connected+continuous+function"} n-connected
            %p Moreover:
            %ul
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  itself is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/n-connected+continuous+function"} k-connected
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat f
                  may be chosen to have cells only of
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                          %mo ≤
                          %mi dim
                          %mo ≤
                          %mi n
                        %annotation{:encoding => "application/x-tex"} k + 1 \leq dim \leq n
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is already a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \hat f \colon A \to X
                  may be chosen to be a subcomplex inclusion.
          %p
            (
            %a{:href => "CW+approximation#tomDieck08"}> tomDieck 08, theorem 8.6.1
            )
          #CWApproximationForContinuousFunctions.num_prop
            %h6#proposition_16 Proposition
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f \colon A \longrightarrow X
              out of a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/relative+CW-complex"} relative CW-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ⟶
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat f \colon A \longrightarrow \hat X
              that factors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              followed by a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ^
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mi ϕ
                                  %mrow
                                    %mrow
                                      %mo ∈
                                      %msub
                                        %mi W
                                        %mi cl
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ^
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;&amp; \overset{f}{\longrightarrow} &amp;&amp; X
                    \\\
                    \&amp; {}_{\mathllap{\hat f}}\searrow &amp;&amp; \nearrow_{\mathrlap{{\phi} \atop {\in W_{cl}}}}
                    \\\
                    \&amp;&amp; \hat X
                    }
                    \\,.
          .proof
            %h6#proof_17 Proof
            %p
              Apply lemma
              %a.maruku-ref{:href => "#nConnectedCWApproximationOfContinuousFunction"}
              iteratively for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              to produce a sequence with
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 0
                          %mtd
                            %msub
                              %mi X
                              %mn 0
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 1
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ϕ
                                    %mn 0
