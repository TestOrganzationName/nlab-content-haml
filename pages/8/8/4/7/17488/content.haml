                    \\\
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow
                    \\\
                    \\ast
                    \&amp;\longrightarrow&amp;
                    X
                    \&amp;\longrightarrow&amp;
                    Cone(X)
                    \&amp;\longrightarrow&amp;
                    Cone(X)
                    \\\
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{f}}
                    \&amp;&amp;
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow
                    \\\
                    Y
                    \&amp;\underset{=}{\longrightarrow}&amp;
