                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mi n
                          %mn 1
                        %mo −
                        %msub
                          %mi n
                          %mn 2
                    %mi Z
                  %annotation{:encoding => "application/x-tex"}
                    X
                    \\overset{f_1}{\longrightarrow}
                    \\Sigma^{-n_1} Y
                    \\overset{\Sigma^{-n_1}(f_2)}{\longrightarrow}
                    \\Sigma^{-n_1}(\Sigma^{-n_2} Z)
                    \\simeq
                    \\Sigma^{-n_1 - n_2} Z
            %p
              gives the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              the structure of an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ab
                        %mi ℤ
                    %annotation{:encoding => "application/x-tex"} Ab^{\mathbb{Z}}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
          #ForASpectrumXGeneralizedECohomology.num_example
            %h6#example_14 Example
            %p
              %strong (generalized cohomology groups)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E \in SeqSpec(Top_{cg})
              be an
              %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OmegaSpectrum"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} X\in Top^{\ast/}_{cg}
              be a
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty X
              its
              %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#SuspensionSpectrum"}
              %a.existingWikiWord{:href => "/nlab/show/graded+abelian+group"} graded abelian group
              (by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#StableHomotopyCategoryIsAbEnriched"}
              = succeed ")" do
                %a.maruku-ref{:href => "#GradedAbelianGroupStructureOnHomsInTheHomotopyCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mover
                                %mi E
                                %mo{:stretchy => "false"} ˜
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi Σ
                              %mn ∞
                            %mi X
                            %mo ,
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo •
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi Σ
                              %mn ∞
                            %mi X
                            %mo ,
                            %msup
                              %mi Σ
                              %mo •
                            %mi E
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %msup
                              %mi Ω
                              %mn ∞
                            %msup
                              %mi Σ
                              %mo •
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %msub
                              %mi E
                              %mo •
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\tilde E^\bullet(X)
                    \&amp; \coloneqq
                    [\Sigma^\infty X, E]_{-\bullet}
                    \\\
                    \&amp; =
                    [\Sigma^\infty X, \Sigma^\bullet E]
                    \\\
                    \&amp; \simeq
                    [X, \Omega^\infty \Sigma^\bullet E]_\ast
                    \\\
                    \&amp; \simeq
                    [X, E_\bullet]_\ast
                    \\end{aligned}
            %p
              is also called the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/reduced+cohomology"} reduced cohomology
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              in the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
                theory
              that is
              %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} represented
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p Here the equivalences used are
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
                  isomorphism of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Σ
                          %mn ∞
                        %mo ⊣
                        %msup
                          %mi Ω
                          %mn ∞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\Sigma^\infty \dashv \Omega^\infty)
                  from theorem
                  = succeed ";" do
                    %a.maruku-ref{:href => "#StableHomotopyCategoryIsIndeedStabilizationOfClassicalHomotopyCategory"}
              %li
                %p
                  the isomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                        %mo ≃
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \Sigma \simeq [1]
                  of suspension with the shift spectrum (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ShiftedSpectrum"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi Spectra
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ho(Spectra)
                  of lemma
                  = succeed "," do
                    %a.maruku-ref{:href => "#CounitOfFakeSuspensionAndShiftIsStableEquivalence"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Ω
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} \Omega^\infty
                  from prop.
                  = succeed "." do
                    %a.maruku-ref{:href => "#SigmaInfinityOmegaInfinity"}
            %p The latter expression
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %msub
                      %mi E
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E^n(X) \simeq [X, E_n]_\ast
            %p
              (on the right the hom in in the
              %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Top^{\ast/})
              of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              %a.existingWikiWord{:href => "/nlab/show/reduced+cohomology"} reduced
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
              as discussed in
              %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+S"} part S
              in the
              = succeed "." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#BrownRepresentabilityTheorem"} section on the Brown representability theorem
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              here is not necessarily given as an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi stable
                  %annotation{:encoding => "application/x-tex"} [X,E] = [X,E]_{stable}
              in the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              are given by the naive homotopy classes of maps out of a cofibrant resolution of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              into a fibrant resolution of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              (by
              = succeed ")." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomsOutOfCofibrantIntoFibrantComputeHomotopyCategory"} this lemma
              %a.maruku-ref{:href => "#StableModelStructureOnSequentialSpectraIsModelCategory"}
              a fibrant replacement of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is given by Omega-
              %a.existingWikiWord{:href => "/nlab/show/spectrification"} spectrification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mi E
                  %annotation{:encoding => "application/x-tex"} Q E
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SpectrificationForTopologicalSequentialSpectra"}
              %a.maruku-ref{:href => "#StableModelStructureOnSequentialSpectraIsModelCategory"}
              is a left
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} Bousfield localization
              of the strict model structure from theorem
              = succeed "," do
                %a.maruku-ref{:href => "#StrictModelStructureOnSequentialPrespectraIsModelCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi stable
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Q
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi strict
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [X,E]_{stable} \simeq [X,Q E]_{strict}
                    \\,,
            %p and hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi E
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi Σ
                              %mn ∞
                            %mi X
                            %mo ,
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi stable
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi Σ
                              %mn ∞
                            %mi X
                            %mo ,
                            %mi Q
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi strict
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %msup
                              %mi Ω
                              %mn ∞
                            %mi Q
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi Q
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} )
                              %mn 0
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    E^0(X)
                    \&amp;\coloneqq
                    [\Sigma^\infty X, E]_{stable}
                    \\\
                    \&amp; \simeq
                    [\Sigma^\infty X, Q E]_{strict}
                    \\\
                    \&amp; \simeq
                    [X, \Omega^\infty Q E]_\ast
                    \\\
                    \&amp; =
                    [X, (Q E)_0]_\ast
                    \\end{aligned}
                    \\,,
            %p
              where the last two hom-sets are again those of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              happens to be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-spectrum
              %a.maruku-ref{:href => "#SpectrificationForCWSpectra"}
              its Omega-spectrification is given simply by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi k
                    %msup
                      %mi Ω
                      %mi k
                    %msub
                      %mi E
                      %mrow
                        %mi n
                        %mo +
                        %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Q E)_n \simeq \underset{\longrightarrow}{\lim}_k \Omega^k E_{n+k})
              and hence in this case
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi k
                    %msup
                      %mi Ω
                      %mi k
                    %msub
                      %mi E
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^0(X)
                    \\simeq
                    [X, \underset{\longrightarrow}{\lim}_k \Omega^k E_k]_\ast
                    \\,.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              here is moreover a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              = succeed ")," do
                %a{:href => "spectrification#Weibel94"} Weibel 94, topology exercise 10.9.2
              = succeed "-adjunction" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo ⊣
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Sigma \dashv \Omega)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi E
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %munder
                                %mi lim
                                %mo ⟶
                              %mi k
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %msup
                              %mi Ω
                              %mi k
                            %msub
                              %mi E
                              %mi k
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %munder
                                %mi lim
                                %mo ⟶
                              %mi k
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi Σ
                              %mi k
                            %mi X
                            %mo ,
                            %msub
                              %mi E
                              %mi k
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    E^0(X)
                    \&amp; \simeq
                    \\underset{\longrightarrow}{\lim}_k [X, \Omega^k E_k]_\ast
                    \\\
                    \&amp;
                    \\simeq
                    \\underset{\longrightarrow}{\lim}_k [\Sigma^k X, E_k]_\ast
                    \\end{aligned}
                    \\,.
            %p
              (e.g.
              = succeed ")." do
                %a{:href => "#Adams74"} Adams 74, prop. 2.8
            %p
              This last expression is sometimes used to define cohomology with coefficients in an arbitrary spectrum. For examples see in the
              %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+S"} part S
              the section
              = succeed "." do
                %em
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#OrientationAndFiberIntegration"} Orientation in generalized cohomology
            %p
              More generally, it is immediate now that there is a concept of
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/suspension+spectra"} suspension spectra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in Ho(Spectra)
              be any spectrum, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %msup
                      %mi Σ
                      %mo •
                    %mi E
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E^\bullet(X)
                    \\coloneqq
                    [X,\Sigma^\bullet E]
            %p
              is called the reduced
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p Beware that here one usually drops the tilde sign.
          %p
            In summary, lemma
            %a.maruku-ref{:href => "#StableHomotopyCategoryHasCoproducts"}
            and lemma
            %a.maruku-ref{:href => "#StableHomotopyCategoryIsAbEnriched"}
            state that the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            is an
            %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enriched category
            with finite
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
          #AdditiveCategory.num_defn
            %h6#definition_29 Definition
            %p
              An
              %strong
                %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
              is a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              which is
            %ol
              %li
                %p
                  an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enriched category
                %p
                  (sometimes called a
                  = succeed "\u2013this" do
                    %a.existingWikiWord{:href => "/nlab/show/pre-additive+category"} pre-additive category
                  %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
                  carries the structure of an
                  %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
                  and composition is
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear
              %li
                %p
                  which admits
                  %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite
                  %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
                %p
                  (and hence, by prop.
                  %a.maruku-ref{:href => "#ProductsAreBiproducts"}
                  below, finite
                  %a.existingWikiWord{:href => "/nlab/show/products"} products
                  which coincide with the coproducts, hence finite
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/biproducts"} biproducts
          #ProductsAreBiproducts.num_prop
            %h6#proposition_28 Proposition
            %p
              In an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enriched category
              %a.existingWikiWord{:href => "/nlab/show/finite+product"} finite
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              is also a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            %p
              This statement includes the zero-ary case: any
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              is also an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              (and dually), hence every
              %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdditiveCategory"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
            %p
              More precisely, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{X_i\}_{i \in I}
              a
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              of objects in an Ab-enriched category, then the unique morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                    %mo ⟶
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi j
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi j
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\coprod} X_i \longrightarrow \underset{j \in I}{\prod} X_j
                    \\,,
            %p
              whose components are identities for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo =
                    %mi j
                  %annotation{:encoding => "application/x-tex"} i = j
              and are
              %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero
              otherwise, is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .proof
            %h6#proof_48 Proof
            %p
              Consider first the zero-ary case. Given an
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \emptyset
              and a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \ast
              %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo ,
                    %mi ∅
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(\emptyset,\emptyset)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(\ast,\ast)
              by definition contain a single element, this element has to be the zero element in the abelian group structure. But it also has to be the identity morphism, and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi ∅
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} id_\emptyset = 0
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi id
                        %mo *
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} id_{\ast} = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mi ∅
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(\ast, \emptyset)
              is a left and right inverse to the unique element in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %mi ∅
                      %mo ,
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom(\emptyset,\ast)
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ∅
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \;\colon\; \emptyset \overset{\simeq}{\longrightarrow} \ast
                    \\,.
            %p
              Consider now the case of binary (co-)products. Using the existence of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/zero+morphisms"} zero morphisms
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi X
                        %mn 1
                      %mo ×
                      %msub
                        %mi X
                        %mn 2
                      %mo →
                      %msub
                        %mi X
                        %mi i
                    %annotation{:encoding => "application/x-tex"} p_i \colon X_1 \times X_2 \to X_i
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              also receives “injection” maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi i
                      %mo →
                      %msub
                        %mi X
                        %mn 1
                      %mo ×
                      %msub
                        %mi X
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} X_i \to X_1 \times X_2
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %mn 0
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn 0
