                    \\\
                    \\underset{A_0}{\underbrace{a_0}}
                    \&amp;&amp;
                    \\underset{A_1}{\underbrace{a_{-1}}}
                    \&amp;&amp;
                    \\underset{A_2}{\underbrace{a_{-2}}}
                    \&amp;&amp;
                    \\cdots
                    }
                    \\,.
            %p
              This allows to recover the
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi a
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \{a_n\}_{n \in \mathbb{Z}}
              from an
              = succeed "-sequence" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
            %p
              Then consider the case that the
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              of some
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/loop+spaces"} loop spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_\bullet(\Omega X)
                    \\simeq
                    \\pi_{\bullet + 1}(X)
                    \\,.
            %p
              (This may be seen concretely in point-set topology or abstractly by looking at the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
              for the fiber sequence
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mi X
                      %mo →
                      %msub
                        %mi Path
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Omega X \to Path_*(X) \to X
            %p
              We find this kind of behaviour for the stable homotopy groups of Omega-spectra below in example
              = succeed "." do
                %a.maruku-ref{:href => "#StableHomotopyGroupsOfOmegaSpectrum"}
          #OmegaSpectrum.num_defn
            %h6#definition_7 Definition
            %p
              An
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              is a
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectrum"} sequential spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of topological spaces, def.
              = succeed "," do
                %a.maruku-ref{:href => "#SequentialSpectra"}
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊣
                  %annotation{:encoding => "application/x-tex"} \dashv
              = succeed ")-" do
                %a.existingWikiWord{:href => "/nlab/show/pointed+mapping+space"} pointed mapping space
              %a.existingWikiWord{:href => "/nlab/show/adjuncts"} adjuncts
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi σ
                        %mo{:stretchy => "false"} ˜
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \tilde \sigma_n
              of the structure maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Σ
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma_n \colon \Sigma X_n \to X_{n+1}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              are
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#WeakHomotopyEquivalenceOfTopologicalSpaces"}> def.
              ), hence classical weak equivalences (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ClassesOfMorhismsInTopQuillen"}> def.
              ):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi σ
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi W
                          %mi cl
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde \sigma_n
                    \\;\colon\;
                    X_n  \stackrel{\in W_{cl}}{\longrightarrow}  Maps(S^1,X_{n+1})_\ast
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %p
              Equivalently: an
              %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              is a sequential spectrum in the incarnation of def.
              %a.maruku-ref{:href => "#SequentialSpectrumViaAdjunctStructureMaps"}
              such that all adjunct structure maps
              %a.maruku-eqref{:href => "#eq:AdjunctStructureMaps"} (1)
              are weak homotopy equivalences.
          #EMSpectra.num_example
            %h6#example_7 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#BrownRepresentabilityForTraditionalBrownFunctors"}> thm.
              ) implies (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#AdditiveReducedCohomologyTheoryRepresentedByOmegaSpectrum"}> prop.
              ) that every
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology+theory"} generalized (Eilenberg-Steenrod) cohomology theory
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#ReducedGeneralizedCohomology"}> def.
              ) is represented by an
              %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#OmegaSpectrum"}
            %p
              Applied to
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              some
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectra"} Eilenberg-MacLane spectra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mi A
                  %annotation{:encoding => "application/x-tex"} H A
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#EilenbergMacLaneSpectrum"}> exmpl.
              ). These are the Omega-spectra whose
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ≃
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (H A)_n \simeq K(A,n)
                    \\,.
            %p
              A genuinely generalized (i.e. non-ordinary, hence “extra-ordinary”)
              %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
              is
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi K
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K^\bullet(-)
              %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
              to
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
              yields the K-theory spectrum denoted
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/KU"} KU
          %p
            Omega-spectra are singled out among all sequential pre-spectra as having good behaviour under forming
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
          #StableHomotopyGroupsOfOmegaSpectrum.num_example
            %h6#example_8 Example
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectrum"} sequential spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              = succeed "," do
                %a.maruku-ref{:href => "#OmegaSpectrum"}
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              reduce to the actual
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              of the component spaces, in that:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mtext is Omega-spectrum
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi π
                                %mrow
                                  %mi k
                                  %mo +
                                  %mi n
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %msub
                                %mi X
                                %mi n
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi k
                              %mo +
                              %mi n
                              %mo ≥
                              %mn 0
                          %mtr
                            %mtd
                              %msub
                                %mi π
                                %mi k
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %msub
                                %mi X
                                %mn 0
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi k
                              %mo ≥
                              %mn 0
                          %mtr
                            %mtd
                              %msub
                                %mi π
                                %mn 0
                              %msub
                                %mi X
                                %mrow
                                  %mo{:stretchy => "false"} |
                                  %mi k
                                  %mo{:stretchy => "false"} |
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi k
                              %mo &lt;
                              %mn 0
                          %mtr
                            %mtd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \; \text{is Omega-spectrum}
                    \\;\;\;\;\;
                    \\Rightarrow
                    \\;\;\;\;\;
                    \\pi_k(X)
