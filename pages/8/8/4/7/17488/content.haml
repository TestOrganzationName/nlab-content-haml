                                  %mi otherwise
                      %annotation{:encoding => "application/x-tex"} (X[k])_n \coloneqq \left\{ \array{X_{n+k} &amp; for \; n+k \geq 0 \\ \ast &amp; otherwise } \right.
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msubsup
                          %mi σ
                          %mi n
                          %mrow
                            %mi X
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                        %mo ≔
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msubsup
                                    %mi σ
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mi k
                                    %mi X
                                %mtd
                                  %mi for
                                  %mspace{:width => "thickmathspace"}
                                  %mi n
                                  %mo +
                                  %mi k
                                  %mo ≥
                                  %mn 0
                              %mtr
                                %mtd
                                  %mn 0
                                %mtd
                                  %mi otherwise
                      %annotation{:encoding => "application/x-tex"} \sigma_n^{X[k]} \coloneqq \left\{ \array{ \sigma^X_{n+k} &amp; for \; n+k \geq 0 \\ 0 &amp; otherwise} \right.
                  \.
          #SequentialSpectrumFakeSuspension.num_defn
            %h6#definition_12 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
