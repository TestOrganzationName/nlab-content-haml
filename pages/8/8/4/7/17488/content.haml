          #RetractsOfRelativeKCellComplexesAreTheStableEquivalencesAndStrictCofibrationsForSequentialSpectra.num_lemma
            %h6#lemma_17 Lemma
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#RetractsOfMorphisms"}> rmk.
