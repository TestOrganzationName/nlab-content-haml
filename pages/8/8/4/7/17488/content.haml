                              %mi a
                              %mn 2
                          %mtd
                          %mtd
                            %msub
                              %mi a
                              %mn 1
                          %mtd
                          %mtd
                            %msub
                              %mi a
                              %mn 0
                          %mtd
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                            %msub
                              %mi a
                              %mn 1
                          %mtd
                          %mtd
                            %msub
                              %mi a
                              %mn 0
                          %mtd
                          %mtd
                            %msub
                              %mi a
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                          %mtd
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                            %munder
                              %munder
                                %mrow
                                  %msub
                                    %mi a
                                    %mn 0
                                %mo ⏟
                              %mrow
                                %msub
                                  %mi A
                                  %mn 0
                          %mtd
                          %mtd
                            %munder
                              %munder
                                %mrow
                                  %msub
                                    %mi a
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                                %mo ⏟
