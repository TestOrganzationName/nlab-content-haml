                    X &amp;\stackrel{h}{\longrightarrow}&amp; A
                    \\\
                    \\downarrow^{\mathrlap{f}} &amp;&amp; \downarrow
                    \\\
                    Y &amp;\longrightarrow&amp; B
                    }
                    \\,.
            %p
              By definition, this is equivalently an
              = succeed "-collection" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
