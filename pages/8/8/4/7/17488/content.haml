          #BousfieldFriedlanderTheorem.num_prop
            %h6#proposition_22 Proposition
            %p
              %strong (Bousfield-Friedlander theorem)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/right+proper+model+category"} right proper
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Q \colon \mathcal{C} \longrightarrow \mathcal{C}
              be a Quillen idempotent monad on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "." do
                %a.maruku-ref{:href => "#QuillenIdempotentMonad"}
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} Bousfield localization
              model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_Q
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BousfieldLocalizationOfModelCategories"}
              = succeed "-weak" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed ")" do
                %a.maruku-ref{:href => "#ClassesOfMorphismsInBousfieldLocalizationAtQuillenIdempotentMonad"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              with the classes of morphisms in def.
              %a.maruku-ref{:href => "#ClassesOfMorphismsInBousfieldLocalizationAtQuillenIdempotentMonad"}
              exists.
          %p
            (
            %a{:href => "#BousfieldFriedlander78"}> Bousfield-Friedlander 78, theorem 8.7
            ,
            = succeed "," do
              %a{:href => "#Bousfield01"} Bousfield 01, theorem 9.3
            = succeed ")" do
              %a{:href => "#GoerssJardine96"} Goerss-Jardine 96, chapter X, lemma 4.5, lemma 4.6, theorem 4.1
          .proof
            %h6#proof_24 Proof
            %p
              The existence of
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              is guaranteed since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is already assumed to be a model category. The
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              poperty for
              = succeed "-weak" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.maruku-ref{:href => "#FirstLemmaForBousfieldFriedlander"}
              the pair of classes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Cof
                      %mi Q
                    %mo ,
                    %msub
                      %mi W
                      %mi Q
                    %mo ∩
                    %msub
                      %mi Fib
                      %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Cof_{Q}, W_Q \cap Fib_Q)
              equals the pair
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Cof
                      %mo ,
                      %mi W
                      %mo ∩
                      %mi Fib
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Cof, W \cap Fib)
              %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
              by the model structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              Hence it remains to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi Q
                    %mo ∩
                    %msub
                      %mi Cof
                      %mi Q
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Fib
                      %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (W_Q \cap Cof_Q, \; Fib_Q)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fib
                      %mi Q
                    %mo =
                    %mi RLP
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi Q
                    %mo ∩
                    %msub
                      %mi Cof
                      %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fib_Q = RLP(W_Q \cap Cof_Q)
              holds by definition of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Fib
                        %mi Q
                    %annotation{:encoding => "application/x-tex"} Fib_Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi Q
                    %mo ∩
                    %msub
                      %mi Cof
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} W_Q \cap Cof_Q
              followed by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Fib
                        %mi Q
                    %annotation{:encoding => "application/x-tex"} Fib_Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi Q
                    %mo ∩
                    %msub
                      %mi Cof
                      %mi Q
                    %mo =
                    %mi LLP
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Fib
                      %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W_Q \cap Cof_Q = LLP(Fib_Q)
              follows from the
              %a.existingWikiWord{:href => "/nlab/show/retract+argument"} retract argument
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#RetractArgument"}> lemma
              ) and the fact that the classes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} W_Q
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cof
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} Cof_Q
              are closed under retracts, because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cof
                    %mo =
                    %msub
                      %mi Cof
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} Cof = Cof_Q
              are (by
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#WeakEquivalencesAreClosedUnderRetracts"} this prop.
              and
              = succeed "," do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ClosurePropertiesOfInjectiveAndProjectiveMorphisms"} this prop.
            %p
              So we may conclude by showing the existence of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi Q
                    %mo ∩
                    %msub
                      %mi Cof
                      %mi Q
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Fib
                      %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (W_Q \cap Cof_Q, \; Fib_Q)
              factorizations:
            %p
              First we consider the case of morphisms of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Q
