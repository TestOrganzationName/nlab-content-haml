                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        X &amp;\stackrel{\eta_X}{\longrightarrow}&amp; Q(X)
                        \\\
                        {}^{\mathllap{f}}\downarrow &amp;{}^{(pb)^h}&amp; \downarrow^{\mathrlap{Q(f)}}
