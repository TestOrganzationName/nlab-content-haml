              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#JoyalTierneyCalculus"}> prop.
              )
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi n
                    %mo □
                    %msub
                      %mi i
                      %mo +
                  %annotation{:encoding => "application/x-tex"} k_n \Box i_+
              has left lifting against any strict acyclic fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k_n
              has left lifting against the pullback powering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo □
                        %msub
                          %mi i
                          %mo +
                  %annotation{:encoding => "application/x-tex"} f^{\Box i_+}
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#PushoutProductWithRespectToSmashTensoring"}
              %a.maruku-ref{:href => "#PushoutProductWithRespectToSmashTensoringSatisfiesEnrichedModelCategoryAxioms"}
              the latter is still a strict acyclic fibration. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k_n
              is evidently a strict cofibration, the lifting follows and hence also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi n
                    %mo □
                    %msub
                      %mi i
                      %mo +
                  %annotation{:encoding => "application/x-tex"} k_n \Box i_+
              is a strict cofibration, hence a stable cofibration.
            %p
              To see that they are stable weak equivalences: For each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi n
                    %mo ∧
                    %msup
                      %mi S
                      %mrow
                        %mi q
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} k_n \wedge S^{q-1}
              are stable acyclic cofibrations, and since stable acyclic cofibrations are preserved under
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi n
                    %mo □
                    %msub
                      %mi i
                      %mo +
                  %annotation{:encoding => "application/x-tex"} k_n \Box i_+
              is a stable weak equivalence.
          %p
            The reason for considering the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi k
                    %mi n
                  %mo □
                  %msub
                    %mi i
                    %mo +
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{k_n \Box i_+\}
            is to make the following true:
          #KInjectivesAreAcyclicCofibrationsForSequentialSpectra.num_lemma
            %h6#lemma_15 Lemma
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SeqSpec(Top)
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi seq
                        %mi stable
                    %annotation{:encoding => "application/x-tex"} J_{seq}^{stable}
              %a.existingWikiWord{:href => "/nlab/show/injective+morphism"} injective morphism
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LiftingAndExtension"}> def.
              ) precisely if
            %ol
              %li
                %p it is fibration in the strict model structure (hence degreewise a fibration);
              %li
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  the
                  %a.existingWikiWord{:href => "/nlab/show/commuting+squares"} commuting squares
                  of structure map compatibilities on the underlying
                  %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi X
                                  %mi n
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %msubsup
                                      %mover
                                        %mi σ
                                        %mo{:stretchy => "false"} ˜
                                      %mi n
                                      %mi X
                              %mtd
                                %mi Ω
                                %msub
                                  %mi X
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi f
                                        %mi n
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi Ω
                                      %msub
                                        %mi f
                                        %mrow
                                          %mi n
                                          %mo +
                                          %mn 1
                            %mtr
                              %mtd
                                %msub
                                  %mi Y
                                  %mi n
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mrow
                                    %msubsup
                                      %mover
                                        %mi σ
                                        %mo{:stretchy => "false"} ˜
                                      %mi n
                                      %mi Y
                              %mtd
                                %mi Ω
                                %msub
                                  %mi Y
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        X_n  &amp;\overset{\tilde\sigma^X_n}{\longrightarrow}&amp; \Omega X_{n+1}
                        \\\
                        {}^{\mathllap{f_n}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\Omega f_{n+1}}}
                        \\\
                        Y_n &amp;\underset{\tilde \sigma^Y_n}{\longrightarrow}&amp; \Omega Y_{n+1}
                        }
                %p
                  exhibit
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomotopyPullback"}> def.
                  ) in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SeqSpec
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi Top
                            %mi cg
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi strict
                        %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})_{strict}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi n
                        %mo ⟶
                        %msub
                          %mi Y
                          %mi n
                        %munder
                          %mo ×
                          %mrow
                            %mi Ω
                            %msub
                              %mi Y
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mi Ω
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        X_n \longrightarrow Y_n \underset{\Omega Y_{n+1}}{\times} \Omega X_{n-1}
                %p
                  is a weak homotopy equivalence (notice that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ω
                        %msub
                          %mi f
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \Omega f_{n+1}
                  is a fibration by the previous item and since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ω
                        %mo =
                        %mi Maps
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 1
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo *
                      %annotation{:encoding => "application/x-tex"} \Omega = Maps(S^1,-)_\ast
                  is a right Quillen functor by prop.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#SuspensionAndLoopAdjunctionInClassicalHomotopyTheory"}
            %p
              In particular, the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi seq
                        %mi stable
                    %annotation{:encoding => "application/x-tex"} J_{seq}^{stable}
              %a.existingWikiWord{:href => "/nlab/show/injective+objects"} injective objects
              are precisely the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Omega-spectra"} Omega-spectra
              = succeed "." do
                %a.maruku-ref{:href => "#OmegaSpectrum"}
          .proof
            %h6#proof_43 Proof
            %p
              By theorem
              = succeed "," do
                %a.maruku-ref{:href => "#StrictModelStructureOnSequentialPrespectraIsModelCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi seq
                      %mi strict
                  %annotation{:encoding => "application/x-tex"} J_{seq}^{strict}
              alone characterizes strict fibrations, hence degreewise fibrations. Lifting against the remaining
              %a.existingWikiWord{:href => "/nlab/show/pushout+product"} pushout product
              morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi n
                    %mo □
                    %msub
                      %mi i
                      %mo +
                  %annotation{:encoding => "application/x-tex"} k_n \Box i_+
              is, by
              %a.existingWikiWord{:href => "/nlab/show/Joyal-Tierney+calculus"} Joyal-Tierney calculus
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#JoyalTierneyCalculus"}> prop.
              ), equivalent to left lifting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo +
                  %annotation{:encoding => "application/x-tex"} i_+
              against the pullback powering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo □
                        %msub
                          %mi k
                          %mi n
                  %annotation{:encoding => "application/x-tex"} f^{\Box k_n}
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#PushoutProductWithRespectToSmashTensoring"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi i
                      %mo +
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{i_+\}
              are the generating cofibrations in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top_{cg}^{\ast/}
              such lifting means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo □
                        %msub
                          %mi k
                          %mi n
                  %annotation{:encoding => "application/x-tex"} f^{\Box k_n}
              is a weak equivalence in the strict model sructure. But by lemma
              = succeed "," do
                %a.maruku-ref{:href => "#CorepresentationOfAdjunctStructureMaps"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo □
                        %msub
                          %mi k
                          %mi n
                  %annotation{:encoding => "application/x-tex"} f^{\Box k_n}
              is precisely the comparison morphism in question.
          #KInjectiveStableEquivalencesAreStrictEquivalencesForSequentialSpectra.num_lemma
            %h6#lemma_16 Lemma
            %p
              A morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SeqSpec(Top)
              which is both
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalence"} stable weak homotopy equivalence
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#StableWeakHomotopyEquivalenceOfSequentialTopologicalSpectra"}
              %li
                %p
                  a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi J
                            %mi seq
                            %mi stable
                        %annotation{:encoding => "application/x-tex"} J_{seq}^{stable}
                  %a.existingWikiWord{:href => "/nlab/show/injective+morphism"} injective morphism
                  (def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#GeneratingAndGeneratingAcyclicCofibrationsForSeqSpecStable"}
                  = succeed ")" do
                    %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LiftingAndExtension"} def.
            %p
              is an acyclic fibration in the strict model structure, hence is degreewise a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              and
              %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              of topological spaces;
          .proof
            %h6#proof_44 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f \colon X \to B
              be both a stable weak homotopy equivalence as well as a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi seq
                        %mi stable
                    %annotation{:encoding => "application/x-tex"} J_{seq}^{stable}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/injective+morphism"} injective morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi seq
                      %mi stable
                  %annotation{:encoding => "application/x-tex"} J_{seq}^{stable}
              contains the generating acyclic cofibrations for the strict model structure,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is in particular a strict fibration, hence a degreewise fibration.
            %p
              Consider the fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} F \to \ast
              which is the pullback of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \ast \to B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a strict fibration, this is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomotopyFiber"}> def.
              ) of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in the strict model structure.
            %p We claim that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is an Omega-spectrum;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo →
                        %mo *
                      %annotation{:encoding => "application/x-tex"} F\to \ast
                  is a stable weak homotopy equivalence.
            %p
              The first item follows since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "-injective" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi seq
                        %mi stable
                    %annotation{:encoding => "application/x-tex"} J_{seq}^{stable}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi seq
                        %mi stable
                    %annotation{:encoding => "application/x-tex"} J_{seq}^{stable}
              %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective object
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ClosurePropertiesOfInjectiveAndProjectiveMorphisms"}> prop.
              ), so that, by lemma
              = succeed "," do
                %a.maruku-ref{:href => "#KInjectivesAreAcyclicCofibrationsForSequentialSpectra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              it is an Omega-spectrum.
            %p For the second item:
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo →
                    %mi X
                    %mover
                      %mo →
                      %mi f
                    %mi B
                  %annotation{:encoding => "application/x-tex"} F \to X \overset{f}{\to} B
              is degreewise a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences+of+homotopy+groups"} long exact sequences of homotopy groups
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LongExactSequeceOfHomotopyGroups"}> exmpl.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
