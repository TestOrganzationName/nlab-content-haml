                  %annotation{:encoding => "application/x-tex"} Ho(SeqSpec(Top_{cg})_{stable})
              (where we are using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
