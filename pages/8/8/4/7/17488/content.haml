          .proof
            %h6#proof_10 Proof
            %p It is sufficient to check
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn ∞
                    %mo ∘
                    %mi Σ
                    %mo ≃
                    %mi Σ
                    %mo ∘
                    %msup
                      %mi Σ
                      %mn ∞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma^\infty \circ \Sigma \simeq \Sigma \circ \Sigma^\infty
                    \\,.
            %p From this the statement
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn ∞
                    %mo ∘
                    %mi Ω
                    %mo ≃
                    %mi Ω
                    %mo ∘
                    %msup
                      %mi Ω
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\infty \circ \Omega \simeq \Omega \circ \Omega^\infty
            %p follows by uniqueness of adjoints.
            %p
              So let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %msubsup
                        %mi Top
                        %mi cg
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} X \in Top_{cg}^{\ast/}
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %msup
                          %mi Σ
                          %mn ∞
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi n
                        %mo =
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msup
                          %mi S
                          %mi n
                        %mo ∧
                        %mi X
                      %annotation{:encoding => "application/x-tex"} (\Sigma \Sigma^\infty X)_n = S^1 \wedge S^n \wedge X
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msubsup
                          %mi σ
                          %mi n
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %msup
                              %mi Σ
                              %mn ∞
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msup
                          %mi S
                          %mi n
                        %mo ∧
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %mi id
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msup
                          %mi S
                          %mrow
                            %mn 1
                            %mo +
                            %mi n
                        %mo ∧
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \sigma^{(\Sigma \Sigma^\infty X)}_n \colon S^1 \wedge S^1 \wedge S^n \wedge X \overset{S^1 \wedge id}{\longrightarrow} S^1 \wedge S^{1+n} \wedge X
                  ,
            %p while
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Σ
                          %mn ∞
                        %mi Σ
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi n
                        %mo =
                        %msup
                          %mi S
                          %mi n
                        %mo ∧
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %mi X
                      %annotation{:encoding => "application/x-tex"} (\Sigma^\infty \Sigma X)_n = S^n \wedge S^1 \wedge X
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msubsup
                          %mi σ
                          %mi n
                          %mrow
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi Σ
                              %mn ∞
                            %mi Σ
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msup
                          %mi S
                          %mi n
                        %mo ∧
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                            %mi id
                            %mo ∧
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %mi X
                        %msup
                          %mi S
                          %mrow
                            %mn 1
                            %mo +
                            %mi n
                        %mo ∧
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \sigma_n^{(\Sigma^\infty \Sigma X)}\colon S^1\wedge S^n \wedge S^1 \wedge X \overset{id \wedge S^1 \wedge X}{\longrightarrow} S^{1+n} \wedge S^1 \wedge X
                  ,
            %p where we write “id” for the canonical isomorphism. Clearly there is a natural isomorphism given by the canonical identifications
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msup
                      %mi S
                      %mi n
                    %mo ∧
                    %mi X
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mo ∧
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                    %mo ∧
                    %mi X
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi S
                      %mi n
                    %mo ∧
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^1 \wedge S^n \wedge X
                    \\overset{\simeq}{\longrightarrow}
                    (S^1)^{\wedge^{n+1}}\wedge X
                    \\overset{\simeq}{\longrightarrow}
                    S^n \wedge S^1 \wedge X
                    \\,.
            %p
              (As long as we are not smash-permuting the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
              factor with the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              factor – and here we are not – then the fact that they get mixed under this isomorphism is irrelevant. The point where this does become relevant is the content of remark
              %a.maruku-ref{:href => "#StandardAndAlternativeSuspensionAreNotDirectlyComparable"}
              below.)
          %h2#StrictModelStructureOnSequentialSpectra The strict model structure on sequential spectra
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on
            %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
            which
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presents
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            is the “stable model structure” discussed
            = succeed "." do
              %a{:href => "#TheStableModelStructure"} below
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Omega-spectra"} Omega-spectra
            %a.existingWikiWord{:href => "/nlab/show/spectrum+objects"} spectrum objects
            among the pre-spectrum objects.
          %p
            But for technical purposes it is useful to also be able to speak of a model structure on pre-spectra, which sees their homotopy theory as sequences of simplicial sets equipped with suspension maps, but not their stable structure. This is called the “strict model structure” for sequential spectra. Its main point is that the stable model structure of interest arises from it via
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
          #ClassesOfMorphismsOfTheStrictModelStructureOnSequentialSpectra.num_defn
            %h6#definition_13 Definition
            %p
              Say that a homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet \colon X_\bullet \to Y_\bullet
              in the category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SeqSpec
                      %mo{:stretchy => "false"} (
                      %mi Top
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SeqSpec(Top)
              %a.maruku-ref{:href => "#SequentialSpectra"}
              is
            %ul
              %li
                %p
                  a
                  %strong strict weak equivalence
                  if each component
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mi n
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi X
                          %mi n
                        %mo →
                        %msub
                          %mi Y
                          %mi n
                      %annotation{:encoding => "application/x-tex"} f_n \colon X_n \to Y_n
                  is a weak equivalence in the
                  %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
                  (hence a
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              %li
                %p
                  a
                  %strong strict fibration
                  if each component
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mi n
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi X
                          %mi n
                        %mo →
                        %msub
                          %mi Y
                          %mi n
                      %annotation{:encoding => "application/x-tex"} f_n \colon X_n \to Y_n
                  is a fibration in the
                  %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
                  (hence a
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              %li
                %p
                  a
                  %strong strict cofibration
                  if the maps
