                        %semantics
                          %mrow
                            %msubsup
                              %mover
                                %mi σ
                                %mo{:stretchy => "false"} ˜
                              %mi n
                              %mrow
                                %mi Ω
                                %mi X
                            %mo ≔
                            %mi Maps
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mn 1
                            %mo ,
                            %msubsup
                              %mover
                                %mi σ
                                %mo{:stretchy => "false"} ˜
                              %mi n
                              %mi X
                            %msub
