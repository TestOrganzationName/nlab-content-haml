              given by
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi n
