                    \\; \simeq \;
                    \\mathbb{L}((-) \wedge S^1)
                    \\,.
          %p
            (
            %a{:href => "#Jardine15"}> Jardine 15, corollary 10.42, prop. 10.53
            )
          .proof
            %h6#proof_36 Proof
            %p
              Consider the adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mn 2
                    %mo ⊣
                    %msub
                      %mi R
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %mo{:stretchy => "false"} )
                    %mo ↔
                    %msub
                      %mi Seq
                      %mn 2
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L_2 \dashv R_2) \colon SeqSpec(Top) \leftrightarrow Seq_2Spec(Top)
              from lemma
              = succeed "." do
                %a.maruku-ref{:href => "#AdjunctionBetweenSequentialSpectraAndSequentialTSpectra"}
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
