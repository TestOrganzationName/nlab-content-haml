          #SpectrificationForCWSpectra.num_remark
            %h6#remark_2 Remark
            %p
              In the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-spectrum
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CWSpectrum"}
              %a.existingWikiWord{:href => "/nlab/show/spectrification"} spectrification
              in def.
              %a.maruku-ref{:href => "#SpectrificationForTopologicalSequentialSpectra"}
              is not necessary, and one may simply consider
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Q
                      %mi CW
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi k
                    %msup
                      %mi Ω
                      %mi k
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mi k
                    %mspace{:width => "thinmathspace"}
