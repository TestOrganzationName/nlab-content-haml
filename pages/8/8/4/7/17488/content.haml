                              %mi Y
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mi B
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^1 \wedge Y_n
                    \\underset{S^1 \wedge X_n}{\sqcup}
                    X_{n+1}
                    \&amp;\stackrel{(\sigma_n^A \circ S^1 \wedge l_n,\;h_{n+1})}{\longrightarrow}&amp;
                    A_{n+1}
                    \\\
                    {}^{\mathllap{f_n \Box \sigma^X_n}}\downarrow
                    \&amp;{}^{\mathllap{l_{n+1}}}\nearrow&amp;
                    \\downarrow
                    \\\
                    Y_{n+1} &amp;\stackrel{}{\longrightarrow}&amp; B_{n+1}
                    }
                    \\,.
            %p
              This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet
              is a strict cofibration precisely if, in addition to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} f_0
              being a classical cofibration, all these pushout products are classical cofibrations.
          %h3#suspension_and_looping_2 Suspension and looping
          #SigmaInfinityIsQuillenOnStrictModelStructureOnSequential.num_prop
            %h6#proposition_11 Proposition
            %p
              The
              = succeed "-adjunction" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Σ
                        %mn ∞
                      %mo ⊣
                      %msup
                        %mi Ω
                        %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Sigma^\infty \dashv \Omega^\infty)
              %a.maruku-ref{:href => "#SigmaInfinityOmegaInfinity"}
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#QuillenAdjunction"}> def.
              ) between the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed topological spaces
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ClassicalModelStructureOnCompactlyGeneratedTopologicalSpaces"}> thm.
              ,
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ModelStructureOnSliceCategory"} prop.
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+topological+sequential+spectra"} model structure on topological sequential spectra
              of theorem
              = succeed ":" do
                %a.maruku-ref{:href => "#StrictModelStructureOnSequentialPrespectraIsModelCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mn ∞
                    %mo ⊣
                    %msup
                      %mi Ω
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi strict
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %msup
                            %mi Ω
                            %mn ∞
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi Σ
                            %mn ∞
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Sigma^\infty \dashv \Omega^\infty)
                    \\;\colon\;
                    SeqSpec(Top_{cg})_{strict}
                    \\underoverset
                    {\underset{\Omega^{\infty}}{\longrightarrow}}
                    {\overset{\Sigma^\infty}{\longleftarrow}}
                    {\bot}
                    (Top_{cg}^{\ast/})_{Quillen}
                    \\,.
          .proof
            %h6#proof_12 Proof
            %p
              It is clear that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \Omega^\infty
              preserves fibrations and acyclic fibrations. This is sufficient to deduce a Quillen adjunction.
            %p
              Just for the record, we spell out a direct argument that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty
              preserves cofibrations and acyclic cofibrations:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X\longrightarrow Y
              be a morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top^{\ast/}_{cg}
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi X
                    %mo ⟶
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma^\infty f \colon \Sigma^\infty X \longrightarrow \Sigma^\infty Y
            %p its image.
            %p
              Since the structure maps in a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
              = succeed "," do
                %a.maruku-ref{:href => "#SuspensionSpectrum"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              an isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Σ
                          %mn ∞
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi n
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ≃
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Sigma^\infty X)_{n+1}
                    \\underset{S^1 \wedge (\Sigma^\infty X)_n}{\coprod}
                    S^1 \wedge (\Sigma^\infty Y)_n
                    \\simeq
                    S^1 \wedge (\Sigma^\infty Y)_n
                    \\,.
            %p
              Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty f
              is a strict cofibration, according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#ClassesOfMorphismsOfTheStrictModelStructureOnSequentialSpectra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo =
                    %mi f
                  %annotation{:encoding => "application/x-tex"} (\Sigma^\infty f)_0 = f
              is a classical cofibration and all the structure maps of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty Y
              are classical cofibrations. But the latter are even isomorphisms, so that this is no extra condition (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ClosurePropertiesOfInjectiveAndProjectiveMorphisms"}> prop.
              ). Hence
