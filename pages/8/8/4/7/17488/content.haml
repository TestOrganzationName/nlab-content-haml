          %p The following is the lift of this alternative perspective of reflective localization via idempotent monads from category theory to model category theory.
          #QuillenIdempotentMonad.num_defn
            %h6#definition_19 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ModelCategory"}> def.
              ) which is
              %a.existingWikiWord{:href => "/nlab/show/right+proper+model+category"} right proper
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#RightProperModelCategory"}> def.
              ), in that
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              along fibrations preserves weak equivalences.
            %p
              Say that a
              %strong Quillen idempotent monad
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi 𝒞
                        %mo ⟶
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} Q \;\colon\;  \mathcal{C} \longrightarrow \mathcal{C}
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi id
                          %mi 𝒞
                        %mo ⟶
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} \eta \;\colon\; id_{\mathcal{C}} \longrightarrow Q
            %p such that
            %ol
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"}> homotopical functor
                  )
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} Q
                  preserves weak equivalences;
              %li
                %p
                  (idempotency) for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
                  the morphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi η
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %mo ∈
                            %mi W
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Q(\eta_X) \;\colon\; Q(X) \overset{\in W}{\longrightarrow} Q(Q(X))
                %p and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mrow
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %mo ∈
                            %mi W
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\eta_{Q(X)} \;\colon\; Q(X) \overset{\in W}{\longrightarrow} Q(Q(X))
                %p are weak equivalences;
              %li
                %p
                  (right-properness of the localization) if in a
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                  square in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msup
                                  %mi f
                                  %mo *
                                %mi Z
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %msup
                                      %mi f
                                      %mo *
                                    %mi h
                              %mtd
                                %mi X
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi pb
                                %mo{:stretchy => "false"} )
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi f
                            %mtr
                              %mtd
                                %mi Z
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mi h
                              %mtd
                                %mi Y
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        f^\ast Z &amp;\overset{f^\ast h}{\longrightarrow}&amp; X
                        \\\
                        \\downarrow &amp;(pb)&amp; \downarrow^{\mathrlap{f}}
                        \\\
                        Z &amp;\underset{h}{\longrightarrow}&amp; Y
                        }
                %p we have that
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi f
                          %annotation{:encoding => "application/x-tex"} f
                      is a fibration;
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %msub
                              %mi η
                              %mi X
                          %annotation{:encoding => "application/x-tex"} \eta_X
                      ,
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi η
                                %mi Y
                            %annotation{:encoding => "application/x-tex"} \eta_Y
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} Q(h)
                      are weak equivalences
                %p
                  then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi f
                          %mo *
                        %mi h
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Q(f^\ast h)
                  is a weak equivalence.
          #ClassesOfMorphismsInBousfieldLocalizationAtQuillenIdempotentMonad.num_defn
            %h6#definition_20 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Q \colon \mathcal{C} \longrightarrow \mathcal{C}
              a Quillen idempotent monad according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#QuillenIdempotentMonad"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ol
              %li
                %p
                  a
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi Q
                        %annotation{:encoding => "application/x-tex"} Q
                    \-weak equivalence
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Q(f)
                  is a weak equivalence;
              %li
                %p
                  a
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi Q
                        %annotation{:encoding => "application/x-tex"} Q
                    \-cofibration
                  if it is a cofibration.
              %li
                %p
                  a
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi Q
                        %annotation{:encoding => "application/x-tex"} Q
                    \-fibration
                  if it has the
                  %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
                  against the morphisms that are both (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} Q
                  \-)cofibrations as well as
                  = succeed "-weak" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Q
                        %annotation{:encoding => "application/x-tex"} Q
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi Q
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_Q
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              equipped with these classes of morphisms.
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            preserves weak equivalences (by def.
            = succeed ")" do
              %a.maruku-ref{:href => "#QuillenIdempotentMonad"}
            %a.maruku-ref{:href => "#ClassesOfMorphismsInBousfieldLocalizationAtQuillenIdempotentMonad"}
            do constitute a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure, then this is a
            %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            = succeed "." do
              %a.maruku-ref{:href => "#BousfieldLocalizationOfModelCategories"}
          %p
            We establish a couple of lemmas that will prove that the model structure indeed exists (prop.
            %a.maruku-ref{:href => "#BousfieldFriedlanderTheorem"}
            below).
          #FirstLemmaForBousfieldFriedlander.num_lemma
            %h6#lemma_3 Lemma
            %p
              In the situation of def.
              = succeed "," do
                %a.maruku-ref{:href => "#ClassesOfMorphismsInBousfieldLocalizationAtQuillenIdempotentMonad"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_Q
              precisely if it is an acyclic fibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          .proof
            %h6#proof_22 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              be a fibration and a weak equivalence. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              preserves weak equivalences by condition 1 in def.
              = succeed "," do
                %a.maruku-ref{:href => "#QuillenIdempotentMonad"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is also a
              = succeed "-weak" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "-cofibrations" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has right lifting against
              = succeed "-cofibrations," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "-acyclic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "-cofibrations," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "-fibration." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
            %p
              In the other direction, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
              be a
              = succeed "-acyclic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "-fibration." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi Cof
                      %mi i
                    %mi Z
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                        %mo ∩
                        %mi Fib
                      %mi p
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\colon\;
                    X
                    \\underoverset{\in Cof}{i}{\longrightarrow}
                    Z
                    \\underoverset{\in W \cap Fib}{p}{\longrightarrow}
                    Y
                    \\,.
            %p
              Observe that
              = succeed "-equivalences" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
