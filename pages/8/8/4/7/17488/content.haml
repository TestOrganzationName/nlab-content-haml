          #StableHomotopyCategoryIsTriangulated.num_prop
            %h6#proposition_32 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              from def.
              = succeed "," do
                %a.maruku-ref{:href => "#TheStableHomotopyCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Sigma \colon Ho(Spectra) \overset{\simeq}{\longrightarrow} Ho(Spectra)
              (according to
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LoopingAsFunctorOnHomotopyCategory"} this prop.
              %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryWithCofiberSequences"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                    %mo →
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SeqSpec(Top_{cg})_{stable} \to Ho(Spectra)
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#UniversalPropertyOfHomotopyCategoryOfAModelCategory"}> prop.
              ) of the stable model category of theorem
              = succeed ")" do
                %a.maruku-ref{:href => "#StableModelStructureOnSequentialSpectraIsModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequences"} homotopy cofiber sequences
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LongFiberSequence"}> prop.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
