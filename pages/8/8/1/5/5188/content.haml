          %h2#idea Idea
          %p
            A
            %em
              free
              %a.existingWikiWord{:href => "/nlab/show/operad"} operad
            is
            %a.existingWikiWord{:href => "/nlab/show/free+functor"} free
            on a collection of operations.
          %p
            Given a collection
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/trees"} trees
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            leaves equipped with a labelling of each vertex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            with a
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            the incoming edges to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mi G
                %annotation{:encoding => "application/x-tex"} V^G
            for the category of objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            equipped with a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/action"} action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            symmetric monoidal this is again a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            and the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mi G
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} V^G \to V
            is symmetric monoidal.
          .num_defn
            %h6#definition_2 Definition
            %p
              The category of
              %strong collections
              (
              %a{:href => "#BergerMoerdijk"}> Berger-Moerdijk
              ) or
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝕊
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}
                \-modules
              (
              %a{:href => "#GetzlerKapranov"}> Getzler-Kapranov
              ) of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/species"} species
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mi Coll
                    %mo :
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi V
                      %mrow
                        %msub
                          %mi S
                          %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V Coll := \prod_{n \in \mathbb{N}} V^{S_n}
                    \\,.
          %p
            Notice that both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 0
                %annotation{:encoding => "application/x-tex"} S_0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S_1
            are the trivial group.
          %p
            So a
            = succeed "-operad" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is a special
            = succeed "-collection" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mi V
                  %mi Operad
                  %mo →
                  %mi V
                  %mi Coll
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  U : V Operad \to V Coll
                  \\,.
          .num_defn
            %h6#definition_3 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/free+functor"} free functor
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to this forgetful functor is the the
              %strong free operad functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi V
                    %mi Coll
                    %mover
                      %mo →
                      %mo ←
                    %mi V
                    %mi Operad
                    %mo :
                    %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F : V Coll \stackrel{\leftarrow}{\to} V Operad : U
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a given collection, we call
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(C)
              the operad
              = succeed "." do
                %em
                  free on the collection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
          .num_remark
            %h6#remark Remark
            %p
              This free/forgetful
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              is used to define the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+operads"} model structure on operads
              by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transfer
          %h2#properties Properties
          %h3#explicit_construction Explicit construction
          %p
            The free operad functor may more explcitly be described as follows (see (
            %a{:href => "#BergerMoerdijk"}> Berger-Moerdijk, section 5.8
            )).
          .num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕋
                    %mo :
                    %mo =
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Ω
                      %mi pl
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{T} := Core(\Omega_pl)
              be the
              %a.existingWikiWord{:href => "/nlab/show/core"} core
              of the category of planar rooted
              %a.existingWikiWord{:href => "/nlab/show/trees"} trees
              and
              %em non-planar
              morphisms (so the morphisms need not respect the given planar structure).
            %p Write
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi t
                          %mi n
                        %mo ∈
                        %msub
                          %mi Ω
                          %mi n
                      %annotation{:encoding => "application/x-tex"} t_n \in \Omega_n
                  for the
                  = succeed "-corolla" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  inputs and its unique output root);
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                  any tree with
                  = succeed "-ary" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi T
                          %mi i
                        %msubsup
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo =
                            %mn 1
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \{T_i\}_{i=1}^n
                  be the sub-trees such that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi T
                          %mo =
                          %msub
                            %mi t
                            %mi n
                          %mo ∘
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi T
                            %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi T
                            %mi n
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} T = t_n \circ (T_1, \cdots, T_n)
            %p
              Then every collection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∈
                    %mi V
                    %mi Coll
                  %annotation{:encoding => "application/x-tex"} K \in V Coll
              defines a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %msup
                      %mi 𝕋
                      %mi op
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \bar K : \mathbb{T}^{op} \to V
              by the inductive formula
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\bar K (|) \coloneqq I
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi T
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi ⋯
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\bar K(t_n(T_1, \cdots, T_n))
                    \\coloneqq K(n) \otimes \bar K(T_1) \otimes \cdots \bar K(T_n)
                    \\,.
            %p Define moreover the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo :
                    %mi 𝕋
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    \\lambda : \mathbb{T} \to Set
            %p
              to be the functor that sends a tree to the set of numberings of its leaves, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi λ
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %mi 𝕋
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \bar \lambda : \mathbb{T} \to V
              be given by postcomposition with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ↦
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %mi I
                    %annotation{:encoding => "application/x-tex"} S \mapsto \coprod_{s \in S} I
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi S
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {\vert S \vert}
              copies of the tensor unit in the
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
          %p
            So for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            a tree with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            leaves we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi λ
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi σ
                      %mo ∈
                      %msub
                        %mi Σ
                        %mi n
                  %mi I
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\bar \lambda(T) \simeq \coprod_{\sigma \in \Sigma_n} I
                  \\,,
          %p
            where the coproduct ranges over the elements of the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            elements.
          .num_prop
            %h6#proposition Proposition
            %p
              The
              %strong free operad
              on a collection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is isomorphic to the
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ¯
                    %msub
                      %mo ⊗
                      %mi 𝕋
                    %mover
                      %mi λ
                      %mo{:stretchy => "false"} ¯
                    %mo =
                    %msup
                      %mo ∫
                      %mrow
                        %mi T
                        %mo ∈
                        %mi 𝕋
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mover
                      %mi λ
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\bar K \otimes_{\mathbb{T}} \bar \lambda
                    \=
                    \\int^{T \in \mathbb{T}}
                    \\bar K(T) \otimes \bar \lambda(T)
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              The groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕋
                  %annotation{:encoding => "application/x-tex"} \mathbb{T}
              is equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              over isomorphism classes of planar trees of the one-object groupoids with morphisms the given
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕋
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %mi 𝕋
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{T} \simeq \coprod_{[T] \in \pi_0\mathbb{T}}
                    \\mathbf{B} Aut(T)
                    \\,.
            %p Therefore the above coend is equivalently
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ¯
                    %msub
                      %mo ⊗
                      %mi 𝕋
                    %mover
                      %mi λ
                      %mo{:stretchy => "false"} ¯
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %mi 𝕋
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %mi Aut
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo{:stretchy => "false"} )
                    %mover
                      %mi λ
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\bar K \otimes_{\mathbb{T}} \bar \lambda
                    \=
                    \\coprod_{[T] \in \pi_0\mathbb{T}}
                    \\bar K(T) \otimes_{Aut(T)} \bar \lambda(T)
                    \\,.
          %h2#examples Examples
          %h3#rooted_tree_operad Rooted tree operad
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            be the collection with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} K(0) = \emptyset
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi I
                %annotation{:encoding => "application/x-tex"} K(n) = I
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n \gt 0
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            leaves. And composition of operations is given by grafting of trees.
