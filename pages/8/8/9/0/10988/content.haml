          %title Literature
          %p
            A
            %strong pro-C-star-algebra
            (also called locally C-star algebra) is very much like a
            %a.existingWikiWord{:href => "/nlab/show/pro-object"} pro-object
            in the category of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} C-star-algebra
            %a.existingWikiWord{:href => "/nlab/show/topological+algebra"} topological
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/%2A-algebra"} *-algebra
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
          %h2#literature Literature
          %ul
            %li
              N. C. Phillips,
              = succeed "," do
                %em
                  Inverse limits of
                  = succeed "-algebras" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^\ast
              = succeed ";" do
                %a{:href => "http://www.theta.ro/jot/archive/1988-019-001/1988-019-001-010.pdf"} pdf
              = succeed "," do
                %em
                  Inverse limits of
                  = succeed "-algebras" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^\ast
              = succeed "," do
                %em
                  Representable K-theory for
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi σ
                        %annotation{:encoding => "application/x-tex"} \sigma
                  = succeed "-algebras" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^*
              = succeed "," do
                %strong 3
            %li
              Massoud Amini,
              = succeed "," do
                %em
                  Locally compact pro-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^\ast
                  \-algebras
              %a{:href => "http://arxiv.org/abs/math/0205253"} math.OA/0205253
            %li
              Maria Joița,
              = succeed "," do
                %em
                  Hilbert modules over locally
                  = succeed "-algebras" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^*
              = succeed ";" do
                %a{:href => "http://www.geocities.ws/m_joita/Hilbertm.pdf"} pdf
              = succeed "," do
                %em
                  Crossed products of locally
                  = succeed "-algebras" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^*
              = succeed ":5" do
                %strong 37
              = succeed ";" do
                %a{:href => "https://www.jstor.org/stable/44239423"} jstor
              = succeed ";" do
                %em
                  A new look at the crossed products of pro-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^*
                  \-algebras
              = succeed "," do
                %em
                  On representations associated with completely n-positive linear maps on pro-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^*
                  \-algebras
              = succeed "," do
                %em
                  Pro-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^*
                  \-algebras associated to tensor products of pro-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^*
                  \-correspondences
              = succeed ":" do
                %strong 455
              = succeed ";" do
                %a{:href => "https://doi.org/10.1016/j.jmaa.2017.06.065"} doi
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
              = succeed "-modules_," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
              %a{:href => "https://doi.org/10.1007/s40840-014-0067-z"} doi
            %li
              Maria Joiţa, Ioannis Zarakas,
              = succeed "," do
                %em
                  Crossed products by Hilbert pro-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^*
                  \-bimodules
              = succeed ";" do
                %a{:href => "http://dx.doi.org/10.4064%2Fsm215-2-4"} doi
              = succeed "," do
                %em
                  A construction of pro-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^*
                  \-algebras from pro-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^*
                  \-correspondences
              = succeed ":1" do
                %strong 74
              %a{:href => "http://dx.doi.org/10.7900/jot.2014may27.2025"} doi
            %li
              Rachid El Harti, N. Christopher Phillips, Paulo R. Pinto,
              = succeed "," do
                %em
                  Profinite pro-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^\ast
                  \-algebras and pro-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^\ast
                  \-algebras of profinite groups
              %a{:href => "http://arxiv.org/abs/1110.3411"} arxiv/1110.3411
            %li
              Snigdhayan Mahanta,
              = succeed "," do
                %em
                  Noncommutative correspondence categories, simplicial sets and pro-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^\ast
                  \-algebras
              %a{:href => "http://arxiv.org/abs/0906.5400"} arxiv/0906.5400
            %li
              Ilan Barnea, Michael Joachimand Snigdhayan Mahanta,
              = succeed "," do
                %em
                  Model structure on projective systems of
                  = succeed "-algebras" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^*
              %strong 23
              (2017) 383–439
              %a{:href => "http://emis.ams.org/journals/NYJM/j/2017/23-19v.pdf"} pdf
            %li
              %em
                Atiyah-Jänich Theorem for σ-C
                %em
                  \-algebras_ 2017, Applied Categorical Structures
                  = succeed ":5" do
                    %strong 25
                  %a{:href => "https://doi.org/10.1007/s10485-016-9474-7"} doi
          %p
            There is a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
