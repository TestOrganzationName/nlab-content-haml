          %h2#idea Idea
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
            %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
            canonically inherits the structure of a
            %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
            whose Poisson
            %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            reduces on
            %a.existingWikiWord{:href => "/nlab/show/linear+functions"} linear functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mo ↪
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{g} \hookrightarrow C^\infty(\mathfrak{g}^*)
            to the original
            %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %strong Lie-Poisson structure
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
          %p
            More generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
            the fiberwise dual
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔞
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}^*
            inherits such a Poisson manifold structure.
          %p
            %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
            structures of this form are also called
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/linear+Poisson+structures"} linear Poisson structures
          %h2#definition Definition
          %h3#abstractly Abstractly
          %p
            First notice that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathfrak{g}^\ast)
            as smooth function on the dual of a Lie algebra, then its
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
            1-form at some
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \alpha \in \mathfrak{g}^\ast
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi f
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi α
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi T
                    %mi α
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo =
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo ⟶
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{d} f|_{\alpha}
                  \\colon
                  T_\alpha \mathfrak{g}^\ast
                  \=
                  \\mathfrak{g}^\ast
                  \\longrightarrow
                  \\mathbb{R}
          %p is canonically identified with a Lie algebra element itself.
          %p
            With this understood, then for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f,g \in C^\infty(\mathfrak{g}^*)
            two
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
            their Poisson
            %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            in the Lie-Poisson structure is defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi θ
                  %mo ↦
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi θ
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi f
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi g
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\{f,g\} \;\colon\; \theta \mapsto -\theta ([\mathbf{d} f, \mathbf{d} g])
                  \\,.
          %p
            Notice that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} v\in \mathfrak{g}
            regarded as a linear function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -,v\rangle
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\ast
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi v
                  %annotation{:encoding => "application/x-tex"} \mathbf{d} \langle -,v\rangle = v
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo {
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi v
                      %mn 1
                    %mo{:stretchy => "false"} ⟩
                    %mo ,
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ⟩
                    %mo ,
                    %mo }
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi v
                    %mn 1
                  %mo ,
                  %msub
                    %mi v
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ⟩
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left\{
                  \\langle -, v_1\rangle,
                  \\langle -, v_2\rangle,
                  \\right\}
                  \=
                  \\langle - ,[v_1,v_2]\rangle
                  \\,.
          %p
            This Lie-Poisson structure may be thought of as the unique smooth extension of this bracket on linear functions to all smooth functions on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\ast
          %h3#DefinitionInComponents In components
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi x
                    %mi a
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{x^a\}
            be a
            %a.existingWikiWord{:href => "/nlab/show/basis"} basis
            for the
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            underlying the given
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi C
                    %mrow
                      %mi a
                      %mi b
                  %msub
                    %mrow
                    %mi c
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{C^{a b}{}_c\}
            for the components of the
            %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [-,-]
            in this basis (the structure constants), given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi x
                    %mi a
                  %mo ,
                  %msup
                    %mi x
                    %mi b
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi c
                  %msup
                    %mi C
                    %mrow
                      %mi a
                      %mi b
                  %msub
                    %mrow
                    %mi c
                  %msup
                    %mi x
                    %mi c
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [x^a,x^b] = \underset{c}{\sum} C^{a b}{}_c x^c
                  \\,.
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mo ∂
                    %mi a
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\partial_a\}
            for the dual basis of the
            %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual vector space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo ⊗
                  %mi 𝔤
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\ast \otimes\mathfrak{g} \to \mathbb{R}
            is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi a
                  %msup
                    %mi x
                    %mi b
                  %mo =
                  %msubsup
                    %mi δ
                    %mi a
                    %mi b
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mi if
                            %mspace{:width => "thickmathspace"}
                            %mi a
                            %mo =
                            %mi b
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mi otherwise
                %annotation{:encoding => "application/x-tex"}
                  \\partial_a x^b = \delta_a^b =
                  \\left\{
                  \\array{
                  1 &amp; if\; a=b
                  \\\
                  0 &amp; otherwise
                  }
                  \\right.
          %p
            As the notation is meant to suggest, dually the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi x
                    %mi a
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{x^a\}
            may be regarded as basis for the linear functions on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\ast
            and the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mo ∂
                    %mi a
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\partial_a\}
            serve as a basis of
            %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\ast
          %p
            With this identification understood, the
            %a.existingWikiWord{:href => "/nlab/show/multivector+fields"} multivector fields
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\ast
            are spanned by elements of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi v
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi a
                        %mi q
                  %msub
                    %mo ∂
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %msub
                    %mo ∂
                    %mrow
                      %msub
                        %mi a
                        %mi q
                %annotation{:encoding => "application/x-tex"}
                  v^{a_1 \cdots a_q} \partial_{a_1}\wedge \cdots \wedge \partial_{a_q}
          %p
            (with the sum over indices understood) for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi v
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi a
                        %mi q
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{v^{a_1 \cdots a_q}\}
            smooth functions on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\ast
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Poisson+tensor"} Poisson tensor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo ∈
                  %msup
                    %mo ∧
                    %mn 2
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi \in \wedge^2 \Gamma(T\mathfrak{g}^\ast)
            of the Lie-Poisson structure is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo =
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi c
                  %msup
                    %mi C
                    %mrow
                      %mi a
                      %mi b
                  %msub
                    %mrow
                    %mi c
                  %msup
                    %mi x
                    %mi c
                  %msub
                    %mo ∂
                    %mi a
                  %mo ∧
                  %msub
                    %mo ∂
                    %mi b
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi = \tfrac{1}{2}\underset{a,b,c}{\sum} C^{a b}{}_c x^c \partial_a \wedge \partial_b
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
            on multivector fields is given on linear basis elements by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi x
                    %mi a
                  %mo ,
                  %msup
                    %mi x
                    %mi b
                  %msub
                    %mo{:stretchy => "false"} }
                    %mi Sch
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\{x^a, x^b\}_{Sch} = 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mo ∂
                    %mi a
                  %mo ,
                  %msup
                    %mi x
                    %mi b
                  %msub
                    %mo{:stretchy => "false"} }
                    %mi Sch
                  %mo =
                  %msubsup
                    %mi δ
                    %mi a
                    %mi b
                %annotation{:encoding => "application/x-tex"}
                  \\{\partial_a, x^b\}_{Sch} = \delta_a^b
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mo ∂
                    %mi a
                  %mo ,
                  %msub
                    %mo ∂
                    %mi b
                  %msub
                    %mo{:stretchy => "false"} }
                    %mi Sch
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\{\partial_a, \partial_b\}_{Sch} = 0
          %p
            (the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/canonical+commutation+relations"} canonical commutation relations
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            in both arguments.
          %h2#properties Properties
          %h3#deformation_quantization_by_universal_enveloping_algebra Deformation quantization by universal enveloping algebra
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
            the section
            = succeed "." do
              %em
                %a{:href => "formal+deformation+quantization#RelationToUniversalEnvelopingAlgebras"} Relation to universal enveloping algebras
          %h3#symplectic_groupoid Symplectic groupoid
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} integrating
            the Lie-Poisson structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
            is the
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo ⫽
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}^* \sslash G
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coadjoint+action"} coadjoint action
            %em
              %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
            in the section
            = succeed "." do
              %em
                %a{:href => "symplectic+groupoid#OfLiePoissonStructure"} Examples – Of Lie-Poisson stucture
          %h3#symplectic_leaves Symplectic leaves
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/symplectic+leaves"} symplectic leaves
            of the Lie-Poisson structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
            are the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbits"} coadjoint orbits
          %h3#PoissonLieAlgebroidCohomology Poisson-Lie algebroid cohomology
          %p
            We consider the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔓
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{P}(\mathfrak{g}^\ast)
            of a Lie-Poisson structure and the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid+cohomology"} Lie algebroid cohomology
          .num_remark
            %h6#remark Remark
            %p
              By the discussion at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
              %a.existingWikiWord{:href => "/nlab/show/multivector+fields"} multivector fields
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              given by the
              %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
              with the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bivector"} Poisson bivector
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi π
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi Sch
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE} = \{\pi, -\}_{Sch}
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              of this Lie algebroid:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔓
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo (
                      %msup
                        %mo ∧
                        %mo •
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi T
                      %msup
                        %mi 𝔤
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi d
                        %mi CE
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi π
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mo{:stretchy => "false"} }
                        %mi Sch
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{P}(\mathfrak{g}^\ast))
                    \=
                    \\left(
                    \\wedge^\bullet \Gamma(T\mathfrak{g}^\ast),
                    d_{CE} = \{\pi, -\}_{Sch}
                    \\right)
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              As for every
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bivector"} Poisson bivector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo ∈
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔓
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi \in CE(\mathfrak{P}(\mathfrak{g}^\ast))
              is a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid+cocycle"} Lie algebroid cocycle
              of degree 2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                    %mi π
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi π
                    %mo ,
                    %mi π
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi Sch
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE}\pi = \{\pi,\pi\}_{Sch} = 0
            %p
              (see also at
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/symplectic+Lie+n-algebroid"} symplectic Lie n-algebroid
            %p
              In view of the fact that here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              is just another incarnation of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
              %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
              on the Lie algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathfrak{g},[-,-])
          %p But in the simple case of Lie-Poisson structure, this cocycle is in fact exact:
          #PoissonTensorCoboundary.num_prop
            %h6#proposition Proposition
            %p
              For the Poisson-Lie structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\ast
              the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+tensor"} Poisson tensor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo ∈
                    %msup
                      %mi CE
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi 𝔓
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi \in CE^2(\mathfrak{P}(\mathfrak{g}))
              has a
              %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
              and hence is trivial in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid+cohomology"} Lie algebroid cohomology
          .proof
            %h6#proof Proof
            %p
              Consider the component-description from
              = succeed "." do
                %a{:href => "#DefinitionInComponents"} above
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi a
                    %msub
                      %mo ∂
                      %mi a
                  %annotation{:encoding => "application/x-tex"} x^a \partial_a
              is a coboundary.
            %p First notice that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi x
                      %mi b
                    %mo ,
                    %msup
                      %mi x
                      %mi a
                    %msub
                      %mo ∂
                      %mi a
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi Sch
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mi x
                      %mi b
                  %annotation{:encoding => "application/x-tex"}
                    \\{x^b, x^a \partial_a \}_{Sch} = -x^b
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mo ∂
                      %mi b
                    %mo ,
                    %msup
                      %mi x
                      %mi a
                    %msub
                      %mo ∂
                      %mi a
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi Sch
                    %mo =
                    %msub
                      %mo ∂
                      %mi b
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{\partial_b, x^a \partial_a \}_{Sch} = \partial_b
                    \\,.
            %p From this we get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mi CE
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi x
                              %mi a
                            %msub
                              %mo ∂
                              %mi a
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
