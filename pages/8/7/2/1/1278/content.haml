                  \\\
                  \&amp; \nearrow &amp; &amp; \searrow &amp; &amp; \nearrow_{curvature} &amp;&amp; \searrow
                  \\\
                  flat\;differential\;forms  &amp;&amp; &amp;&amp; geometric\;bundle\;with \;connection &amp;&amp; &amp;&amp; rational\;shape\;of\;bundle
                  \\\
                  \&amp; \searrow &amp;  &amp; \nearrow &amp; &amp; \searrow^{\mathrlap{}} &amp;&amp; \nearrow_{\mathrlap{Chern\;character}}
                  \\\
