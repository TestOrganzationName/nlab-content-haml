          .proof
            %h6 Proof
            %p
              This is the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
              applied to the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              from Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#IteratedLoopSpaceAsHomotopyFiberOfMappingSpace"}
          %p
          .num_remark
            %h6 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Grp
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A \,\in\, Grp_\infty
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+of+an+%28infinity%2C1%29-category"} n-truncated
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              out of the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              from the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} (n+2)-sphere
              into it is a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mi A
                    %mphantom
                      %mi AAAAA
                    %mo ⇒
                    %mphantom
                      %mi AAAAA
                    %mi Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ʃ
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi A
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi{:mathvariant => "normal"} W
                          %mi wh
                      %mrow
                        %msub
                          %mi ev
                          %mo *
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_{n}(A) \,\simeq\, A
                    {\phantom{AAAAA}}
                    \\Rightarrow
                    {\phantom{AAAAA}}
                    Maps
                    \\big(
                    \&amp;#643; S^{n+2}
                    ,\,
                    A
                    \\big)
                    \\underoverset
                    {\in \mathrm{W}_{wh}}
                    {ev_\ast}
                    {\longrightarrow}
                    A
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              By assumption, the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              from Cor.
              %a.maruku-ref{:href => "#LESOfHomotopyGroupswithMappingSpace"}
              collapses to exact segments of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %msub
                      %mi π
                      %mo •
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi ʃ
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ev
                          %mo *
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\ast
                    \\to
                    \\pi_{\bullet}
                    \\big(
                    Maps(&amp;#643; S^{n+2},\, A)
                    \\big)
                    \\xrightarrow{
                    \\;\;\;
                    \\pi_\bullet(ev_\ast)
                    \\;\;\;
                    }
                    \\pi_\bullet(A)
                    \\to
                    \\ast
                    \\,.
            %p
          %h3#cohomology Cohomology
          #RationalCohomologyOfIteratedLoopSpaceOf2kSphere.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational cohomology
                of
                %a.existingWikiWord{:href => "/nlab/show/iterated+loop+space"} iterated loop space
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/n-sphere"} 2k-sphere
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi D
                    %mo &lt;
                    %mi n
                    %mo =
                    %mn 2
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    1 \leq D \lt n = 2k \in \mathbb{N}
            %p
              (hence two
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              %a.existingWikiWord{:href => "/nlab/show/even+number"} even
              and the other required to be smaller than the first) and consider the
              %a.existingWikiWord{:href => "/nlab/show/iterated+loop+space"} D-fold loop space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi D
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Omega^D S^n
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            %p
              Its
              %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
              %a.existingWikiWord{:href => "/nlab/show/graded-commutative+algebra"} graded-commutative algebra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              on one
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mrow
                        %mi n
                        %mo −
                        %mi D
                  %annotation{:encoding => "application/x-tex"} e_{n-D}
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mi D
                  %annotation{:encoding => "application/x-tex"} n - D
              and one generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mrow
                        %mn 2
                        %mi n
                        %mo −
                        %mi D
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} a_{2n - D - 1}
              of degree
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                      %mo −
                      %mi D
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 2n - D - 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi Ω
                      %mi D
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msub
                      %mi e
                      %mrow
                        %mi n
                        %mo −
                        %mi D
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %mn 2
                        %mi n
                        %mo −
                        %mi D
                        %mo −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet
                    \\big(
                    \\Omega^D S^n
                    ,
                    \\mathbb{Q}
                    \\big)
                    \\;\simeq\;
                    \\mathbb{Q}\big[ e_{n - D}, a_{2n - D - 1} \big]
                    \\,.
          %p
            (
            %a{:href => "#KallelSjerve99"}> Kallel-Sjerve 99, Prop. 4.10
            )
          %p
            %br/
          %h3#homology Homology
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homology+of+iterated+loop+spaces"} homology of iterated loop spaces
          %p
            %br/
          %h3#relation_to_configuration_spaces_of_points Relation to configuration spaces of points
          #ScanningMapEquivalenceOverCartesianSpace.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/iterated+loop+spaces"} iterated loop spaces
                equivalent to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
            %p For
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi d
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
                  ,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo ≥
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} d \geq 1
                  a
                  %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi d
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^d
                  denoting the
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                  of that
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
                  %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
                  %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} boundary
                  so that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo{:stretchy => "false"} /
                        %mo ∂
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y / \partial Y
                  is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
            %p
              the electric field map/
              %a.existingWikiWord{:href => "/nlab/show/scanning+map"} scanning map
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Conf
                    %mrow
                      %mo (
                      %msup
                        %mi ℝ
                        %mi d
                      %mo ,
                      %mi Y
                      %mo )
                    %mover
                      %mo ⟶
                      %mi scan
                    %msup
                      %mi Ω
                      %mi d
                    %msup
                      %mi Σ
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} /
                    %mo ∂
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Conf\left(
