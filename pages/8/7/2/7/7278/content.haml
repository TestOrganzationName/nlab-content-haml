                  %a{:href => "#general"} General
                %li
                  %a{:href => "#relation_to_configuration_spaces_of_points_2"} Relation to configuration spaces of points
                %li
                  %a{:href => "#rational_cohomology"} Rational cohomology
          %h2#idea Idea
          %p
            A multiple
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
          %p
            A grouplike
            %a.existingWikiWord{:href => "/nlab/show/E-k+algebra"} E-k algebra
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/iterated+loop+space+object"} iterated loop space object
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          %h2#properties Properties
          %h3#higher_group_structure Higher group structure
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/May+recognition+theorem"} May recognition theorem
          %h3#Homotopy Homotopy
          %p
          #IteratedLoopSpaceAsHomotopyFiberOfMappingSpace.num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+homotopy+type"} pointed homotopy type
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              equipped with a base point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi pt
                            %mi A
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \ast \xrightarrow{ pt_A } A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \,\in\, \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/iterated+loop+space"} n-fold loop space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of the basepoint-
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              on the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              from the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi n
                    %mi A
                    %mover
                      %mo →
                      %mrow
                        %mi hofib
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ev
                          %mo *
                        %mo{:stretchy => "false"} )
                    %mi Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ʃ
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi A
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ev
                          %mo *
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^n A
                    \\xrightarrow{ hofib(ev_{\ast}) }
                    Maps
                    \\big(
                    \&amp;#643; S^n
                    ,\,
                    A
                    \\big)
                    \\xrightarrow{ ev_\ast }
                    A
            %p
          .proof
            %h6 Proof
            %p
              We may
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} present
              the sequence in the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              or the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is presented by a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant object
            %p
              In either case, the canonical model for the
              %a.existingWikiWord{:href => "/nlab/show/iterated+loop+space"} iterated loop space
              is evidently the ordinary
              = succeed "-theoretic" do
                %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              of the
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              out of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi n
                    %mi A
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ev
                          %mo *
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi ʃ
                    %msup
                      %mi S
                      %mi d
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ev
                          %mo *
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^n A
                    \\xrightarrow{ ev_\ast }
                    Maps( &amp;#643; S^d ,\, A )
                    \\xrightarrow{ ev_\ast }
                    A
                    \\,.
            %p
              Moreover, the evaluation map is equivalently the image of the point inclusion under the
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ev
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo →
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ev_\ast
                    \\;=\;
                    Maps( \ast \to S^n ,\, A )
                    \\,.
            %p
              Since either model category is a
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
              %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              over itself (
              %a{:href => "enriched+model+category#TheClassicalModelCategoriesOfTopSpacesAndSimpSets"}> this Exp.
              ) and since the canonical model for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi ʃ
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \ast \to &amp;#643;  S^n
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cofibration"} cofibration
              %a.existingWikiWord{:href => "/nlab/show/pullback-power+axiom"} pullback-power axiom
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ev
                      %mo *
                  %annotation{:encoding => "application/x-tex"} ev_\ast
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
          #LESOfHomotopyGroupswithMappingSpace.num_cor
            %h6 Corollary
            %p
