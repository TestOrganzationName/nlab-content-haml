          %title Initiality Project - Partial Interpretation
          %h1#initiality_project__partial_interpretation Initiality Project - Partial Interpretation
          %p
            This page is part of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Initiality+Project"} Initiality Project
          .maruku_toc
            %ul
              %li
                %a{:href => "#overview"} Overview
              %li
                %a{:href => "#inductive_clauses"} Inductive Clauses
              %ul
                %li
                  %a{:href => "#variables"} Variables
                %li
                  %a{:href => "#constants"} Constants
                %li
                  %a{:href => "#types"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi Π
                        %annotation{:encoding => "application/x-tex"} \Pi
                    \-types
              %li
                %a{:href => "#Contexts"} Contexts
          %h2#overview Overview
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Initiality+Project+-+Semantics"} category with families
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ty
                %annotation{:encoding => "application/x-tex"} Ty
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tm
                %annotation{:encoding => "application/x-tex"} Tm
            of “semantic types” and “semantic terms”. Given a finite set of variables
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊆
                    %mi Var
                  %annotation{:encoding => "application/x-tex"} V \subseteq Var
            %strong presheaf of environments
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            to be
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Tm
                      %mi V
                  %annotation{:encoding => "application/x-tex"} Tm^V
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            of variables, the following
            %a.existingWikiWord{:href => "/nlab/show/partial+morphisms"} partial morphisms
            of presheaves.
          %ol
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                    %mi T
                    %msubsup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                      %mi type
                      %mi V
                    %mo :
                    %msup
                      %mi Tm
                      %mi V
                    %mo ⇀
                    %mi Ty
                  %annotation{:encoding => "application/x-tex"} \⟦ T \⟧ ^V_{type} : Tm^V \rightharpoonup Ty
              \.
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                    %mi T
                    %msubsup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                      %mo ⇒
                      %mi V
                    %mo :
                    %msup
                      %mi Tm
                      %mi V
                    %mo ⇀
                    %mi Tm
                  %annotation{:encoding => "application/x-tex"} \⟦ T \⟧ ^V_{\Rightarrow} : Tm^V \rightharpoonup Tm
              \.
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                    %mi T
                    %msubsup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                      %mo ⇐
                      %mi V
                    %mo :
                    %msup
                      %mi Tm
                      %mi V
                    %mo ×
                    %mi Ty
                    %mo ⇀
                    %mi Tm
                  %annotation{:encoding => "application/x-tex"} \⟦ T \⟧ ^V_{\Leftarrow} : Tm^V \times Ty \rightharpoonup Tm
              such that the composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Tm
                      %mi V
                    %mo ×
                    %mi Ty
                    %mo ⇀
                    %mi Tm
                    %mo →
                    %mi Ty
                  %annotation{:encoding => "application/x-tex"} Tm^V \times Ty \rightharpoonup Tm \to Ty
              is the second projection.
          %p
            In fact, the third of these is not actually inductive at all: it is simply a semantic counterpart of the bidirectional mode-switching judgment. We define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                  %mi T
                  %msubsup
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                    %mo ⇐
                    %mi V
                %annotation{:encoding => "application/x-tex"} \⟦ T \⟧ ^V_{\Leftarrow}
            to be the domain restriction of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Tm
                    %mi V
                  %mo ×
                  %mi Ty
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi pr
                        %mn 1
                  %msup
                    %mi Tm
                    %mi V
                  %mover
                    %mo ⇀
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                      %mi T
                      %msubsup
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                        %mo ⇒
                        %mi V
                  %mi Tm
                %annotation{:encoding => "application/x-tex"} Tm^V \times Ty \xrightarrow{pr_1} Tm^V \overset{\⟦ T \⟧ ^V_{\Rightarrow}}{\rightharpoonup} Tm
          %p to the equalizer of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Tm
                    %mi V
                  %mo ×
                  %mi Ty
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi pr
                        %mn 1
                  %msup
                    %mi Tm
                    %mi V
                  %mover
                    %mo ⇀
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                      %mi T
                      %msubsup
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                        %mo ⇒
                        %mi V
                  %mi Tm
                  %mo →
                  %mi Ty
                %annotation{:encoding => "application/x-tex"} Tm^V \times Ty \xrightarrow{pr_1} Tm^V \overset{\⟦ T \⟧ ^V_{\Rightarrow}}{\rightharpoonup} Tm \to Ty
          %p
            and the restriction of the second projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Tm
                    %mi V
                  %mo ×
                  %mi Ty
                %annotation{:encoding => "application/x-tex"} Tm^V \times Ty
            to its domain.
          %p
            The inductive clauses of the definitions of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                  %mi T
                  %msubsup
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                    %mi type
                    %mi V
                %annotation{:encoding => "application/x-tex"} \⟦ T \⟧ ^V_{type}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                  %mi T
                  %msubsup
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                    %mo ⇒
                    %mi V
                %annotation{:encoding => "application/x-tex"} \⟦ T \⟧ ^V_{\Rightarrow}
            will be given below. This is an induction over
            = succeed "," do
              %em raw syntax
            %em should
            be defined to precisely mirror the bidirectional rules of our
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Initiality+Project+-+Type+Theory"} type theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo ⊢
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mi type
                  %annotation{:encoding => "application/x-tex"} \Gamma \vdash A\,type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo ⊢
                    %mi T
                    %mo ⇒
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Gamma \vdash T\Rightarrow A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ⊢
                  %mi T
                  %mo ⇐
                  %mi A
                %annotation{:encoding => "application/x-tex"} \Gamma \vdash T\Leftarrow A
            (and checks for semantic equality as a counterpart of the syntactic equality judgments). This correspondence will then enable the
            %a.existingWikiWord{:href => "/nlab/show/Initiality+Project+-+Totality"} proof of totality
            to proceed straightforwardly.
          %h2#inductive_clauses Inductive Clauses
          %h3#variables Variables
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is a variable
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                    %mi x
                    %msubsup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                      %mi type
                      %mi V
                  %annotation{:encoding => "application/x-tex"} \⟦ x \⟧ ^V_{type}
              is the empty partial function (this might change with Russell universes).
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∉
                      %mi V
                    %annotation{:encoding => "application/x-tex"} x\notin V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                    %mi x
                    %msubsup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                      %mo ⇒
                      %mi V
                  %annotation{:encoding => "application/x-tex"} \⟦ x \⟧ ^V_{\Rightarrow}
              is the empty partial function.
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} x\in V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                    %mi x
                    %msubsup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                      %mo ⇒
                      %mi V
                    %mo :
                    %msup
                      %mi Tm
                      %mi V
                    %mo ⇀
                    %mi Tm
                  %annotation{:encoding => "application/x-tex"} \⟦ x \⟧ ^V_{\Rightarrow} : Tm^V \rightharpoonup Tm
              is the (total) projection onto the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi th
                  %annotation{:encoding => "application/x-tex"} x^{th}
              factor.
          %h3#constants Constants
          %p TODO
          %h3#types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            \-types
          %p
            include
            %span.newWikiWord
              Initiality Project - Partial Interpretation - Pi-types
              %a{:href => "/nlab/new/Initiality+Project+-+Partial+Interpretation+-+Pi-types"} ?
          %h2#Contexts Contexts
          %p
            Now that we have interpreted raw terms as semantic terms and semantic types, we can interpret raw contexts as well. Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            is a raw context, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be the finite (ordered) set of variables occuring in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                  %mi Γ
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                  %mo ⊆
                  %msup
                    %mi Tm
                    %mi V
                %annotation{:encoding => "application/x-tex"} \⟦ \Gamma \⟧ \subseteq Tm^V
            by induction on the length of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            as follows.
          %ul
            %li
              For the empty context
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ()
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                      %mo =
                      %msup
                        %mi Tm
                        %mn 0
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \⟦ () \⟧ = Tm^0 = 1
            %li
              For an extended context
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Gamma, x:A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} V \cup \{x\}
              where
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∉
                      %mi V
                    %annotation{:encoding => "application/x-tex"} x\notin V
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                      %mi Γ
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                      %mo ⊆
                      %msup
                        %mi Tm
                        %mi V
                    %annotation{:encoding => "application/x-tex"} \⟦ \Gamma \⟧ \subseteq Tm^V
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                      %mi A
                      %msubsup
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                        %mi type
                        %mi V
                      %mo :
                      %msup
                        %mi Tm
                        %mi V
                      %mo ⇀
                      %mi Ty
                    %annotation{:encoding => "application/x-tex"} \⟦ A \⟧^V_{type} : Tm^V \rightharpoonup Ty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              be the intersection of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                    %mi Γ
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                  %annotation{:encoding => "application/x-tex"} \⟦ \Gamma \⟧
              and the domain of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                      %mi A
                      %msubsup
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                        %mi type
                        %mi V
                    %annotation{:encoding => "application/x-tex"} \⟦ A \⟧^V_{type}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                    %mi Γ
                    %mo ,
                    %mi x
                    %mo :
                    %mi A
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                  %annotation{:encoding => "application/x-tex"} \⟦ \Gamma, x:A \⟧
              be defined by the following pullback, where the bottom arrow is the composite
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ↪
                      %msup
                        %mi Tm
                        %mi V
                      %mover
                        %mo ⇀
                        %mrow
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                          %mi A
                          %msubsup
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                            %mi type
                            %mi V
                      %mi Ty
                    %annotation{:encoding => "application/x-tex"} U \hookrightarrow Tm^V \overset{\⟦ A \⟧^V_{type}}{\rightharpoonup} Ty
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                              %mi Γ
                              %mo ,
                              %mi x
                              %mo :
                              %mi A
                              %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                            %mtd
                              %mo →
                            %mtd
                              %mi Tm
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi U
                            %mtd
                              %mo →
                            %mtd
                              %mi Ty
                    %annotation{:encoding => "application/x-tex"} \array { \⟦ \Gamma, x:A \⟧ &amp; \to &amp; Tm \\ \downarrow &amp; &amp; \downarrow \\ U &amp; \to &amp; Ty }
              %p
                We equip it with the composite
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                        %mi Γ
                        %mo ,
                        %mi x
                        %mo :
                        %mi A
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                        %mo →
                        %mi U
                        %mo ×
                        %mi Tm
                        %mo →
                        %msup
                          %mi Tm
                          %mi V
                        %mo ×
                        %mi Tm
                      %annotation{:encoding => "application/x-tex"} \⟦ \Gamma, x:A \⟧ \to U \times Tm \to Tm^V \times Tm
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟦
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ⟧
                    %annotation{:encoding => "application/x-tex"} \⟦ \Gamma, x:A \⟧
                is indeed a sub-presheaf of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Tm
                        %mrow
                          %mi V
                          %mo ∪
                          %mo{:stretchy => "false"} {
                          %mi x
                          %mo{:stretchy => "false"} }
                      %mo ≅
                      %msup
                        %mi Tm
                        %mi V
                      %mo ×
                      %mi Tm
                    %annotation{:encoding => "application/x-tex"} Tm^{V\cup \{x\}} \cong Tm^V \times Tm
                as intended.
