                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H)
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (
              %a{:href => "S-matrix#VacuumFree"}> this def.
              ).
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo ,
                    %mi 𝒮
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}, \mathcal{S}'
              any two
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              schemes (
              %a{:href => "S-matrix#LagrangianFieldTheoryPerturbativeScattering"}> this def.
              ) which both satisfy the
              %a.existingWikiWord{:href => "/nlab/show/renormalization+condition"} renormalization condition
              “field independence”, the there exists a unique
              %a.existingWikiWord{:href => "/nlab/show/vertex+redefinition"} vertex redefinition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
