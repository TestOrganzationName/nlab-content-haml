                                    %mo +
                                    %mi j
                                    %mi A
                                    %mo{:stretchy => "false"} )
                                %mtr
                                  %mtd
                                  %mtd
                                    %mo ≔
                                    %munder
                                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                      %mrow
                                        %mi k
                                        %mo ∈
                                        %mi ℕ
                                    %mfrac
                                      %mn 1
                                      %mrow
                                        %mi k
                                        %mo !
                                    %msub
                                      %mi Z
                                      %mi k
