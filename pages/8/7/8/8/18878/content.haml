                        %mo &lt;
                        %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (T \circ \mathcal{Z}_{\lt k})_k
              are
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              (by
              = succeed ")." do
                %a{:href => "S-matrix#TimeOrderedProductsFromSMatrixScheme"} this example
            %p
              So as we solve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo ′
                    %mo =
                    %mi 𝒮
                    %mo ∘
                    %mi 𝒵
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}' = \mathcal{S} \circ \mathcal{Z}
              inductively in degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              the expressions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msub
                      %mo ′
                      %mrow
                        %mo &lt;
                        %mi k
                  %annotation{:encoding => "application/x-tex"} T'_{\lt k}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ∘
                    %mi 𝒵
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo &lt;
                        %mi k
                  %annotation{:encoding => "application/x-tex"} (T \circ \mathcal{Z})_{\lt k}
              agree and are both time-ordered products. By
              %a{:href => "S-matrix#RenormalizationIsInductivelyExtensionToDiagonal"} this prop.
              this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msub
                      %mo ′
                      %mi k
                  %annotation{:encoding => "application/x-tex"} T'_{k}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ∘
                    %msub
                      %mi 𝒵
                      %mrow
                        %mo &lt;
                        %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (T \circ \mathcal{Z}_{\lt k})_{k}
              agree away from the diagonal. This means that their difference
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Z_k
              is supported on the diagonal, and hence is indeed local.
          #StueckelbergPetermannRenormalizationGroup.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/St%C3%BCckelberg-Petermann+renormalization+group"} Stückelberg-Petermann renormalization group
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/vertex+redefinitions"} vertex redefinitions
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H)
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (
              %a{:href => "S-matrix#VacuumFree"}> this def.
              ).
            %p
              Then prop.
              %a.maruku-ref{:href => "#CausalFactorizationSatisfiedByCompositionOfSMatrixWithVertexRedefinition"}
              and prop
              %a.maruku-ref{:href => "#AnyTwoSMatrixRenormalizationSchemesDifferByAUniqueVertexRedefinition"}
              together says that (“
              %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"}> main theorem of perturbative renormalization
              ”):
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/vertex+redefinitions"} vertex redefinitions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒵
                      %annotation{:encoding => "application/x-tex"} \mathcal{Z}
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#InteractionVertexRedefinition"}
                  %a.existingWikiWord{:href => "/nlab/show/group"} group
                  under
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              %li
                %p
                  the set of
                  %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                  %a.existingWikiWord{:href => "/nlab/show/renormalization+schemes"} ("re"-)normalization schemes
                  (
                  %a{:href => "S-matrix#LagrangianFieldTheoryPerturbativeScattering"}> this def.
                  ,
                  = succeed ")" do
                    %a{:href => "S-matrix#calSFunctionIsRenormalizationScheme"} this remark
                  %a.existingWikiWord{:href => "/nlab/show/renormalization+condition"} renormalization condition
                  “field independence” (
                  %a{:href => "S-matrix#BasicConditionsRenormalization"}> this prop.
                  ) is a
                  %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
                  over this group, meaning that the action is
                  %a.existingWikiWord{:href => "/nlab/show/regular+action"} regular
                  on this set, in that any two are S-matrix (“re”-)normalization schemes are related by a unique vertex redefinition.
            %p
              This group is called the (large)
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/St%C3%BCckelberg-Petermann+renormalization+group"} Stückelberg-Petermann renormalization group
            %p
              Typically one imposes a set of
              %a.existingWikiWord{:href => "/nlab/show/renormalization+conditions"} renormalization conditions
              (
              %a{:href => "S-matrix#RenormalizationConditions"}> this def.
              ) and then the corresponding
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of
              %a.existingWikiWord{:href => "/nlab/show/vertex+redefinitions"} vertex redefinitions
              preserving these.
          %h2#properties Properties
          %h3#scaling_transformations_and_running_coupling_constants Scaling transformations and “running coupling constants”
          %p
            A priori the Stückelberg-Petermann renormalization group is not about
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/scaling+transformations"} scaling transformations
            %a.existingWikiWord{:href => "/nlab/show/scaling+transformations"} scaling transformations
            happen to produce new S-matrices/renormalization schemes from given ones, then the
            %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
            induces for each such scaling transformation a re-definition of interaction Lagrangian densities, this is the
            %a.existingWikiWord{:href => "/nlab/show/Gell-Mann-Low+renormalization+cocycle"} Gell-Mann-Low renormalization cocycle
            (
            %a{:href => "#GellMannLow54"}> Gell-Mann &amp; Low 54
            ,
            = succeed ")" do
              %a{:href => "#BrunettiDuetschFredenhagen09"} Brunetti-Dütsch-Fredenhagen 09
            = succeed ")." do
              %a{:href => "#Duetsch18"} Dütsch 18, section 3.5.3
          #GellMannLowTransformations.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/running+coupling+constants"} running coupling constants
                under
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/scale+transformations"} scale transformations
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi vac
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi kin
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    vac
                    \\;\coloneqq\;
                    (E_{\text{BV-BRST}}, \mathbf{L}_{kin}, \Delta_H )
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (according to
              = succeed ")" do
                %a{:href => "S-matrix#VacuumFree"} this def.
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
            %p Assume that in fact
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/free+field"} free field
                  %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
