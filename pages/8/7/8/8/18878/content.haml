              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/continuous+linear+functionals"} continuous linear functionals
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
