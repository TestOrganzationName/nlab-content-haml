                                          %mo +
                                          %mi j
                                          %mi A
                                        %mo ⏟
                                      %mrow
                                        %mi k
                                        %mspace{:width => "thinmathspace"}
                                        %mtext args
                                    %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"}
                            \\begin{aligned}
                            \\mathcal{Z}(g S_{int} + j A)
                            \&amp; =
                            Z \exp_\otimes( g S_{int} + j A )
                            \\\
                            \&amp;
                            \\coloneqq
                            \\underset{k \in \mathbb{N}}{\sum}
                            \\frac{1}{k!}
                            Z_k(
                            \\underset{
                            k \, \text{args}
                            }{
                            \\underbrace{
                            g S_{int} + j A , \cdots, g S_{int} + j A
                            }
                            }
                            )
                            \\end{aligned}
              %li
                %p
                  (field independence) The
                  %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒵
                        %mo{:stretchy => "false"} (
                        %mi g
                        %msub
                          %mi S
                          %mi int
                        %mo +
                        %mi j
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{Z}(g S_{int} + j A)
                  depends on the
                  %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
                  only through its argument
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                          %msub
                            %mi S
                            %mi int
                          %mo +
                          %mi j
                          %mi A
                        %annotation{:encoding => "application/x-tex"} g S_{int} + j A
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/chain+rule"} chain rule
                #eq:FieldIndependenceVertexRedefinition.maruku-equation
                  %span.maruku-eq-number (1)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mfrac
                          %mi δ
                          %mrow
                            %mi δ
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi Φ
                              %mi a
