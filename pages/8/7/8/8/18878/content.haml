                        \\mathcal{Z}'_{g S_{int} + j A}
                        \\left(
                        \\frac{\delta}{\delta \mathbf{\Phi}^a(x)} (g S_{int} + j A)
                        \\right)
          %p
            The following proposition should be compared to the axiom of
            %em
              %a.existingWikiWord{:href => "/nlab/show/causal+additivity"} causal additivity
            of the
            %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
            scheme (
            %a{:href => "S-matrix#eq:CausalAdditivity"}> this equation
            ):
          #InteractionVertexRedefinitionAdditivity.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (local additivity of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/vertex+redefinitions"} vertex redefinitions
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H)
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (
              %a{:href => "S-matrix#VacuumFree"}> this def.
              ) and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒵
                  %annotation{:encoding => "application/x-tex"} \mathcal{Z}
              be a
              %a.existingWikiWord{:href => "/nlab/show/vertex+redefinition"} vertex redefinition
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#InteractionVertexRedefinition"}
            %p
              Then for all
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mn 0
                    %mo ,
                    %msub
                      %mi O
                      %mn 1
                    %mo ,
                    %msub
                      %mi O
                      %mn 2
                    %mo ∈
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} O_0, O_1, O_2 \in LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j ] ]\langle g, j\rangle
              with spacetime support denoted
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi supp
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} supp(O_i) \subset \Sigma
              (
              %a{:href => "A+first+idea+of+quantum+field+theory#SpacetimeSupport"}> this def.
              ) we have
            %ol
              %li
                %p (local additivity)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                              %mtd
                                %mrow
                                  %mo (
                                  %mi supp
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi O
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                                  %mo ∩
                                  %mi supp
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi O
                                    %mn 2
                                  %mo{:stretchy => "false"} )
                                  %mo =
                                  %mi ∅
                                  %mo )
                            %mtr
                              %mtd
                              %mtd
                                %mo ⇒
                                %mphantom
                                  %mi AA
                                %mi 𝒵
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi O
                                  %mn 0
                                %mo +
                                %msub
                                  %mi O
                                  %mn 1
                                %mo +
                                %msub
                                  %mi O
                                  %mn 2
                                %mo{:stretchy => "false"} )
                                %mo =
                                %mi 𝒵
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi O
                                  %mn 0
                                %mo +
                                %msub
                                  %mi O
                                  %mn 1
                                %mo{:stretchy => "false"} )
                                %mo −
                                %mi 𝒵
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi O
                                  %mn 0
                                %mo{:stretchy => "false"} )
                                %mo +
                                %mi 𝒵
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi O
                                  %mn 0
                                %mo +
                                %msub
                                  %mi O
                                  %mn 2
                                %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        \&amp;
                        \\left(
                        supp(O_1)
                        \\cap
                        supp(O_2)
                        \=
                        \\emptyset
                        \\right)
                        \\\
                        \&amp;
                        \\Rightarrow
                        \\phantom{AA}
                        \\mathcal{Z}( O_0 + O_1 + O_2)
                        \=
                        \\mathcal{Z}( O_0 + O_1 ) - \mathcal{Z}(O_0) + \mathcal{Z}(O_0 + O_2)
                        \\end{aligned}
                        \\,.
              %li
                %p (preservation of spacetime support)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi supp
                        %mrow
                          %mo (
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                          %mi 𝒵
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 0
                          %mo +
                          %msub
                            %mi O
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi 𝒵
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 0
                          %mo{:stretchy => "false"} )
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                          %mo )
                        %mspace{:width => "thickmathspace"}
                        %mo ⊂
                        %mspace{:width => "thickmathspace"}
                        %mi supp
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi O
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        supp
                        \\left(
                        {\, \atop \,}
                        \\mathcal{Z}(O_0 + O_1)
                        \-
                        \\mathcal{Z}(O_0)
                        {\, \atop \,}
                        \\right)
                        \\;\subset\;
                        supp(O_1)
                %p hence in particular
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi supp
                        %mrow
                          %mo (
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                          %mi 𝒵
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                          %mo )
                        %mo =
                        %mi supp
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi O
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        supp
                        \\left(
                        {\, \atop \,}
                        \\mathcal{Z}(O_1)
                        {\, \atop \,}
                        \\right) = supp(O_1)
          %p
            (
            %a{:href => "#Duetsch18"}> Dütsch 18, exercise 3.98
            )
          .proof
            %h6#proof Proof
            %p Under the inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    LocObs(E_{\text{BV-BRST}})
                    \\hookrightarrow
                    PolyObs(E_{\text{BV-BRST}})
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              into
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              we may think of each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Z_k
              as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              in
              = succeed "." do
                %a{:href => "S-matrix#NotationForTimeOrderedProductsAsGeneralizedFunctions"} this remark
            %p Hence if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi j
                    %mo =
                    %munder
                      %mo ∫
                      %mi Σ
                    %msubsup
                      %mi j
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    O_j = \underset{\Sigma}{\int} j^\infty_\Sigma( \mathbf{L}_j )
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
              of a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
              we get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mn 1
                    %mo +
                    %msub
                      %mi O
                      %mn 2
                    %mo +
                    %msub
                      %mi O
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mn 1
                    %mo +
                    %msub
                      %mi O
                      %mn 2
                    %mo +
                    %msub
                      %mi O
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi j
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi j
                          %mi k
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} }
                    %munder
                      %mo ∫
                      %mrow
                        %msup
                          %mi Σ
                          %mi k
                    %mi Z
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mrow
                        %msub
                          %mi j
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mrow
                        %msub
                          %mi j
                          %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Z_k(
                    (O_1 + O_2 + O_3)
                    ,
                    \\cdots
                    ,
                    (O_1 + O_2 + O_3)
                    )
                    \=
                    \\underset{
                    j_1, \cdots, j_k \in \{0,1,2\}
                    }{\sum}
                    \\underset{\Sigma^{k}}{\int}
                    Z( \mathbf{L}_{j_1}(x_1) , \cdots , \mathbf{L}_{j_k}(x_k) )
                    \\,.
            %p
              Now by definition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z_k(\cdots)
              is in the subspace of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              whose
              %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
              %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
              are
              %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} supported
              on the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi δ
                      %mrow
                        %mi δ
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi Φ
                          %mi a
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mfrac
                      %mi δ
                      %mrow
                        %mi δ
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi Φ
                          %mi b
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Z
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mphantom
                      %mi AA
                    %mtext for
                    %mphantom
                      %mi AA
                    %mi x
                    %mo ≠
                    %mi y
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\delta}{\delta \mathbf{\Phi}^a(x)}
                    \\frac{\delta}{\delta \mathbf{\Phi}^b(y)}
                    Z_{k}(\cdots)
                    \=
                    0
                    \\phantom{AA}
                    \\text{for}
                    \\phantom{AA}
                    x \neq y
            %p
              Together with the axiom “field independence”
              %a.maruku-eqref{:href => "#eq:FieldIndependenceVertexRedefinition"} (1)
              this means that the support of these generalized functions in the
              %a.existingWikiWord{:href => "/nlab/show/integrand"} integrand
              here must be on the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 1
                      %mo =
                      %mi ⋯
                      %mo =
