            %h6#proposition_3 Proposition
            %p
              %strong
                (any two
                %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                %a.existingWikiWord{:href => "/nlab/show/renormalization+schemes"} renormalization schemes
                differ by a unique
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/vertex+redefinition"} vertex redefinition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
