                              %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                                %mtr
                                  %mtd
                                    %mi 𝒵
                                    %mo{:stretchy => "false"} (
                                    %mi g
                                    %msub
                                      %mi S
                                      %mi int
                                    %mo +
                                    %mi j
                                    %mi A
                                    %mo{:stretchy => "false"} )
                                  %mtd
                                    %mo =
                                    %mi Z
                                    %msub
                                      %mi exp
                                      %mo ⊗
                                    %mo{:stretchy => "false"} (
                                    %mi g
                                    %msub
                                      %mi S
