          %h2#idea Idea
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            %em cofibrantly generated
            if there is a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            (meaning:
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/proper+class"} proper class
            %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
            as well as one of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/acyclic+cofibrations"} acyclic cofibrations
            %em generated
            from these, in some sense.
          %h2#definition Definition
          %p We need the following general terminology:
          %p
          #CellsAndInjectives.num_defn
            %h6 Definition
            %p
              %strong (cells and injectives)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with all
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \subset Mor(C)
              a
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi rlp
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} rlp(S)
                  for the collection of morphisms with the
                  %em right
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi llp
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} llp(S)
                  for the collection of morphisms with the
                  %em left
                  %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
                  with respect to
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
            %p
              Moreover, we also write, now for
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ⊂
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} I \subset Mor(C)
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi cell
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} cell(I)
                  for the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
                  %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
                  of
                  %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
                  of
                  %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
                  of elements in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi I
                        %annotation{:encoding => "application/x-tex"} I
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi cof
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} cof(I)
                  for the class of
                  %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
                  (in the
                  %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Arr
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Arr(C)
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi cell
                          %mo{:stretchy => "false"} (
                          %mi I
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} cell(I)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi inj
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi rlp
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} inj(I) \coloneqq rlp(I)
                  for the class of morphisms with the
                  %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
                  with respect to
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi I
                        %annotation{:encoding => "application/x-tex"} I
                  = succeed "." do
                    %em
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi I
                          %annotation{:encoding => "application/x-tex"} I
                      \-
                      %a.existingWikiWord{:href => "/nlab/show/injective+morphisms"} injective morphisms
            %p
          #CofibrantlyGeneratedModelCategory.num_defn
            %h6#definition_2 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
              %strong cofibrantly generated
              if there are
              %a.existingWikiWord{:href => "/nlab/show/small+set"} small
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ,
                    %mi J
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I, J \subset Mor(\mathcal{C})
              such that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi cof
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} cof(I)
                  is precisely the collection of cofibrations of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi cof
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} cof(J)
                  is precisely the collection of acyclic cofibrations in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
                  permit the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            are assumed to admit the
            %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
            the collection of cofibrations and acyclic cofibrations has the following simpler characterization:
          #RetractsOfCellComplexesExchaustLLPOfRLP.num_prop
            %h6#proposition Proposition
            %p
              In a cofibrantly generated model category (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CofibrantlyGeneratedModelCategory"}
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi cof
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi llp
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi rlp
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} cof(I) = llp\big(rlp(I)\big)
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi cof
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi llp
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi rlp
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} cof(J) = llp\big(rlp(J)\big)
                  \.
          %p
            And therefore the fibrations form precisely
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi rlp
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} rlp(J)
            and the acyclic fibrations precisely
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi rlp
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} rlp(I)
          .proof
            %h6#proof Proof
            %p
              The argument is the same for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
            %p
              By definition we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊂
                    %mi llp
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi rlp
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} I \subset llp\big(rlp(I)\big)
              and it is readily checked that collections of morphisms given by a
              %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
              are stable under
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              and
              %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              (see
              %a{:href => "injective+or+projective+morphism#ClosurePropertiesOfInjectiveAndProjectiveMorphisms"} here
              for details). So
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cof
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi llp
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi rlp
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} cof(I) \subset llp\big(rlp(I)\big)
            %p
              For the converse inclusion we use the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Z
              be in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi llp
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi rlp
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} llp\big(rlp(I)\big)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mover
                        %mo →
                        %mrow
                          %mi f
                          %mo ′
                          %mo ∈
                          %mi cof
                          %mo{:stretchy => "false"} (
                          %mi I
                          %mo{:stretchy => "false"} )
                      %mi Y
                      %mover
                        %mo →
                        %mrow
                          %mi f
                          %mo ″
                          %mo ∈
                          %mi rlp
                          %mo{:stretchy => "false"} (
                          %mi I
                          %mo{:stretchy => "false"} )
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} f : X \stackrel{f' \in cof(I)}{\to} Y \stackrel{f''\in rlp(I)}{\to} Z
            %p
              Finally we apply the “
              %a.existingWikiWord{:href => "/nlab/show/retract+argument"}> retract argument
              ”: It follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has the left
              %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} f''
              which yields a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi f
                                %mo ′
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mi f
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mi σ
                            %mo ↗
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %mi f
                                    %mo ″
                        %mtr
                          %mtd
                            %mi Z
                          %mtd
                            %munder
                              %mo ⟶
                              %mo =
                          %mtd
                            %mi Z
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X
                    \&amp;\overset{f'}{\longrightarrow}&amp; Y
                    \\\
                    \\mathllap{{}^{f}}
                    \\big\downarrow
                    \&amp;{}^\sigma\nearrow&amp;
                    \\big\downarrow
                    \\mathrlap{{}^{f''}}
                    \\\
                    Z
                    \&amp;\underset{=}{\longrightarrow}&amp;
                    Z
                    }
            %p
              which exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              as a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f'
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mo =
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mo =
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mi f
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %mi f
                                    %mo ′
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mi f
                        %mtr
                          %mtd
                            %mi Z
                          %mtd
                            %munder
                              %mo ⟶
                              %mi σ
                          %mtd
                            %mi Y
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi f
                                %mo ″
                          %mtd
                            %mi Z
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X
                    \&amp;\overset{=}{\longrightarrow}&amp;
                    X
                    \&amp;\overset{=}{\longrightarrow}&amp;
                    X
                    \\\
                    \\big\downarrow
                    {\mathrlap{{}^f}}
                    \&amp;&amp;
                    \\big\downarrow
                    {\mathrlap{{}^{f'}}}
                    \&amp;&amp;
                    \\big\downarrow
                    {\mathrlap{{}^f}}
                    \\\
                    Z
                    \&amp;\underset{\sigma}{\longrightarrow}&amp;
                    Y
                    \&amp;\underset{f''}{\longrightarrow}&amp;
                    Z
                    \\,.
                    }
            %p
              Therefore
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi cof
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \in cof(I)
          %h2#properties Properties
          %h3#RecognitionTheorems Recognition theorem
          %p The following theorem allows one to recognize cofibrantly generated model categories by checking fewer conditions.
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with all small
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              a class of maps satisfying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} 2-out-of-3
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              are sets of maps in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              such that
            %ol
              %li
                %p
                  both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
                  permit the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi cof
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mi cof
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo ∩
                        %mi W
                      %annotation{:encoding => "application/x-tex"} cof(J) \subset cof(I) \cap W
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi inj
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mi inj
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo ∩
                        %mi W
                      %annotation{:encoding => "application/x-tex"} inj(I) \subset inj(J) \cap W
                  ;
              %li
                %p one of the following holds
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi cof
                            %mo{:stretchy => "false"} (
                            %mi I
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %mi W
                            %mo ⊂
                            %mi cof
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} cof(I) \cap W \subset cof(J)
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi inj
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %mi W
                            %mo ⊂
                            %mi inj
                            %mo{:stretchy => "false"} (
                            %mi I
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} inj(J) \cap W \subset inj(I)
            %p
              then there is the stucture of a cofibrantly generated model category on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              with
            %ul
              %li
                %p
                  weak equivalences
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi W
                          %mi C
                        %mo :
                        %mo =
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W_C := W
              %li
                %p
                  generating cofibrations
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                  (i.e.
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi cof
                            %mi C
                          %mo :
                          %mo =
                          %mi llp
                          %mo{:stretchy => "false"} (
                          %mi rlp
                          %mo{:stretchy => "false"} (
                          %mi I
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} cof_C := llp(rlp(I))
              %li
                %p
                  generating acyclic cofibrations
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi J
                        %annotation{:encoding => "application/x-tex"} J
          %p
            This is originally due to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
            = succeed ")." do
              %a{:href => "#Hirschhorn03"} Hirschhorn 03, theorem 11.3.1
          .proof
            %h6#proof_2 Proof
            %p
              We have to show that with weak equivalences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              setting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi cof
                      %mi C
                    %mo :
                    %mo =
                    %mi cof
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cof_C := cof(I)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi fib
                      %mi C
                    %mo :
                    %mo =
                    %mi inj
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} fib_C := inj(J)
              defines a model category structure.
            %p
              The existence of
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} 2-out-of-3 property
              holds by assumption. Closure under retracts of the weak equivalences will hold automatically if we check the rest of the axioms without using it, by an argument of A. Joyal. Closure under retracts of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi fib
                  %annotation{:encoding => "application/x-tex"} fib
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cof
                  %annotation{:encoding => "application/x-tex"} cof
              follows by the general statement that classes of morphisms defined by a left or right lifting property are closed under retracts (e.g.
              = succeed ")." do
                %a{:href => "#Hirschhorn03"} Hirschhorn 03, 7.2.8,
            %p
              The factorization property follows by applying the
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              to the set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo →
                      %mrow
                        %mo ∈
                        %mi cof
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mo ∈
                        %mi inj
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msub
                          %mi fib
                          %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\stackrel{\in cof(I)}{\to} \stackrel{\in inj(I) \subset fib_C}{\to}
            %p
              and assumption 3 says that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi inj
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi W
                    %annotation{:encoding => "application/x-tex"} inj(I) \subset W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              gives factorizations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo →
                      %mrow
                        %mo ∈
                        %mi cof
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mo ∈
                        %mi inj
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi fib
                          %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\stackrel{\in cof(J)}{\to} \stackrel{\in inj(J) = fib_C}{\to}
            %p
              and assumption 2 guarantees that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cof
                      %mo{:stretchy => "false"} (
                      %mi J
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi W
                    %annotation{:encoding => "application/x-tex"} cof(J) \subset W
            %p It remains to verify the lifting axiom. This verification depends on which of the two parts of item 4 is satisfied. Assume the first one is, the argument for the second one is analogous.
            %p
              Then using the assumption
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cof
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mi W
                    %mo ⊂
                    %mi cof
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cof(I) \cap W \subset cof(J)
              and remembering that we have set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inj
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi fib
                      %mi C
                  %annotation{:encoding => "application/x-tex"} inj(J) = fib_C
              we immediately have the lifting of trivial cofibrations on the left against fibrations on the right.
            %p
              To get the lifting of cofibrations on the left with acyclic fibrations on the right, we show finally that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi inj
                      %mo{:stretchy => "false"} (
                      %mi J
                      %mo{:stretchy => "false"} )
                      %mo ∩
                      %mi W
                      %mo ⊂
                      %mi inj
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} inj(J) \cap W \subset inj(I)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              to get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mo =
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi cof
                                  %mo{:stretchy => "false"} (
                                  %mi I
                                  %mo{:stretchy => "false"} )
                                  %mo ∩
                                  %mi W
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi f
                                  %mo ∈
                                  %mi inj
                                  %mo{:stretchy => "false"} (
                                  %mi J
                                  %mo{:stretchy => "false"} )
                                  %mo ∩
                                  %mi W
                        %mtr
                          %mtd
                            %mi Z
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi inj
                                %mo{:stretchy => "false"} (
                                %mi I
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\stackrel{=}{\to}&amp; X
                    \\\
                    \\downarrow^{\mathrlap{\in cof(I) \cap W}} &amp;&amp; \downarrow^{\mathrlap{f \in inj(J) \cap W}}
                    \\\
                    Z &amp;\stackrel{inj(I)}{\to}&amp; Y
                    }
                    \\,.
            %p With assumption 4 a this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mo =
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi cof
                                  %mo{:stretchy => "false"} (
                                  %mi J
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi f
                                  %mo ∈
                                  %mi inj
                                  %mo{:stretchy => "false"} (
                                  %mi J
                                  %mo{:stretchy => "false"} )
                                  %mo ∩
                                  %mi W
                        %mtr
                          %mtd
                            %mi Z
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi inj
                                %mo{:stretchy => "false"} (
                                %mi I
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\stackrel{=}{\to}&amp; X
                    \\\
                    \\downarrow^{\mathrlap{\in cof(J) }} &amp;&amp;
                    \\downarrow^{\mathrlap{f \in inj(J) \cap W}}
                    \\\
                    Z &amp;\stackrel{inj(I)}{\to}&amp; Y
                    }
            %p so that we have a lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mo =
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi cof
                                  %mo{:stretchy => "false"} (
                                  %mi J
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mi σ
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi f
                                  %mo ∈
                                  %mi inj
                                  %mo{:stretchy => "false"} (
                                  %mi J
                                  %mo{:stretchy => "false"} )
                                  %mo ∩
                                  %mi W
                        %mtr
                          %mtd
                            %mi Z
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi inj
                                %mo{:stretchy => "false"} (
                                %mi I
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\stackrel{=}{\to}&amp; X
                    \\\
                    {}^{\mathllap{\in cof(J) }}
                    \\downarrow &amp;{}^\sigma\nearrow&amp;
                    \\downarrow^{\mathrlap{f \in inj(J) \cap W}}
                    \\\
                    Z &amp;\stackrel{inj(I)}{\to}&amp; Y
                    }
            %p which establishes a retract
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi Z
                          %mtd
                            %mover
                              %mo →
                              %mi σ
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi inj
                                  %mo{:stretchy => "false"} (
                                  %mi I
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi f
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mo =
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mo =
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\to&amp; Z &amp;\stackrel{\sigma}{\to}&amp; X
                    \\\
                    \\downarrow^f &amp;&amp; \downarrow^{\mathrlap{\in inj(I)}} &amp;&amp; \downarrow^f
                    \\\
                    Y &amp;\stackrel{=}{\to}&amp; Y
                    \&amp; \stackrel{=}{\to} &amp; Y
                    }
            %p
              that exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              as an element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inj
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} inj(I)
              as this is closed under retracts.
          %h3#transfer_along_adjunctions Transfer along adjunctions
          #TransferOfCofibrantlyGeneratedModelStructure.num_theorem
            %h6#theorem_2 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a cofibrantly generated model category, def.
              = succeed "," do
                %a.maruku-ref{:href => "#CofibrantlyGeneratedModelCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              (and
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              be any
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with all small
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              and consider a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ⊣
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒟
                            %mover
                              %munder
                                %mo ⟶
                                %mi U
                              %mover
                                %mo ⟵
                                %mi F
                            %mi 𝒞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (F \dashv U)
                    \\;\colon\;
                    \\array{
                    \\mathcal{D}
                    \\stackrel{\overset{F}{\longleftarrow}}{\underset{U}{\longrightarrow}}
                    \\mathcal{C}
                    }
                    \\,.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi I
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mi i
                    %mo ∈
                    %mi I
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} F I \coloneqq \{F(i) | i \in I\}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mi J
                      %mo ≔
                      %mo{:stretchy => "false"} {
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %mi j
                      %mo ∈
                      %mi J
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} F J \coloneqq \{F(j) | j \in J\}
            %ol
              %li
                %p
                  both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mi I
                      %annotation{:encoding => "application/x-tex"} F I
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mi J
                      %annotation{:encoding => "application/x-tex"} F J
                  admit the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  takes
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mi J
                        %annotation{:encoding => "application/x-tex"} F J
                  %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
                  to weak equivalences
            %p
              then
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mi I
                    %annotation{:encoding => "application/x-tex"} F I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi J
                  %annotation{:encoding => "application/x-tex"} F J
              induce a cofibrantly generated model structure, def.
              = succeed "," do
                %a.maruku-ref{:href => "#CofibrantlyGeneratedModelCategory"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              for these model structures.
          %p
            This is due to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
            = succeed ")." do
              %a{:href => "#Hirschhorn03"} Hirschhorn 03, theorem 11.3.2
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
          %h3#PresentationAndGeneration Presentation and generation
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a cofibrantly generated model category which is also
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} left proper
              %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \subset Obj(C)
              of cofibrant objects which detect weak equivalences:
            %p
              a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : A \to B
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a weak equivalence, precisely if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} s \in S
              the induced morphism of
              %a.existingWikiWord{:href => "/nlab/show/derived+hom-spaces"} derived hom-spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi ℝ
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℝ
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}Hom(s,f) : \mathbb{R}Hom(s,A) \to \mathbb{R}Hom(s,B)
            %p is a weak equivalence.
          %p
            This appears as (
            %a{:href => "#Dugger"}> Dugger, prop. A.5
            ).
          %h2#examples Examples
          %h3#on_simplicial_sets On simplicial sets
          %p
            The
            %a{:href => "https://ncatlab.org/nlab/show/model+structure+on+simplicial+sets"} classical model category structure on simplicial sets
            is cofibrantly generated:
          .num_prop
            %h6#proposition_3 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
              is a cofibrantly generated model category with
            %ul
              %li
                %p
                  generating cofibrations the
                  %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                  inclusions
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∂
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo →
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \partial \Delta[n] \to \Delta[n]
              %li
                %p
                  generating acyclic cofibrations the
                  %a.existingWikiWord{:href => "/nlab/show/horn"} horn
                  inclusions
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Λ
                            %mi i
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo →
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \Lambda^i[n] \to \Delta[n]
          %h3#on_topological_spaces On topological spaces
          %p
            The category of (based, compactly generated) topological spaces has a cofibrantly generated model structure (the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed topological spaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %mo{:stretchy => "false"} {
                  %msubsup
                    %mi S
                    %mo +
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo →
                  %msubsup
                    %mi D
                    %mo +
                    %mi n
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 0
                %annotation{:encoding => "application/x-tex"}
                  I = \{S^{n-1}_+ \rightarrow D^n_+\}_{n\geq 0}
          %p and the set of acyclic cells is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo =
                  %mo{:stretchy => "false"} {
                  %msubsup
                    %mi D
                    %mo +
                    %mi n
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi D
                    %mi n
                  %mo ×
                  %mi I
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo +
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  J = \{D^n_+ \rightarrow (D^n \times I)_+\}_{n\geq 0}
                  \\,.
          %p
            (Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                %annotation{:encoding => "application/x-tex"} +
            means disjoint basepoint, not northern hemisphere.)
          %p
            The category of unbased spaces has a similar cofibrantly generated model structure. (The
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
          %h3#on_sequential_spectra On sequential spectra
          %p
            The category of
            %a.existingWikiWord{:href => "/nlab/show/sequential+prespectra"} sequential prespectra
            has two cofibrantly generated model structures (the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Bousfield-Friedlander+model+structures"} Bousfield-Friedlander model structures
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi d
                  %mi A
                %annotation{:encoding => "application/x-tex"} F_d A
            denote a prespectrum whose
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mrow
                      %mi n
                      %mo −
                      %mi d
                  %mi A
                %annotation{:encoding => "application/x-tex"} \Sigma^{n-d} A
            when
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mi d
                  %annotation{:encoding => "application/x-tex"} n \geq d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} *
            otherwise. Then the
            %em level model structure
            is generated by cells
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi F
                    %mi d
                  %msubsup
                    %mi S
                    %mo +
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo →
                  %msub
                    %mi F
                    %mi d
                  %msubsup
                    %mi D
                    %mo +
                    %mi n
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi d
                      %mo ,
                      %mi n
                      %mo ≥
                      %mn 0
                %annotation{:encoding => "application/x-tex"}
                  I = \{F_d S^{n-1}_+ \rightarrow F_d D^n_+\}_{d,n\geq 0}
          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/free+spectra"} free spectra
            formed on the standard cells of the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed topological spaces
          %p and the set of acyclic cells is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo =
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi F
                    %mi d
                  %msubsup
                    %mi D
                    %mo +
                    %mi n
                  %mo →
                  %msub
                    %mi F
                    %mi d
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi D
                    %mi n
                  %mo ×
                  %mi I
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo +
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi d
                      %mo ,
                      %mi n
                      %mo ≥
                      %mn 0
                %annotation{:encoding => "application/x-tex"}
                  J = \{F_d D^n_+ \rightarrow F_d (D^n \times I)_+\}_{d,n\geq 0}
          %p
            The
            %em stable model structure
            has the same cells, but more acyclic cells, which in turn guarantees that the fibrant spectra are the
            = succeed "-spectra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
          %h3#on_structured_spectra On structured spectra
          %p
            The categories of
            %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
            and
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
            have similar cofibrantly generated level and stable model structures (
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+symmetric+spectra"}> model structure on symmetric spectra
            ,
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+orthogonal+spectra"} model structure on orthogonal spectra
          %p
            (see Mandell, May, Schwede, Shipley:
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Model+categories+of+diagram+spectra"} Model categories of diagram spectra
          %h3#on_diagrams On diagrams
          %p
            The category of diagrams indexed by a fixed small category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            (The
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                A cofibrantly generated model category that is also a
                %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
                is called a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
            %li
              %p
                A cofibrantly generated model category for which the
                %a.existingWikiWord{:href => "/nlab/show/domains"} domains
                of the morphisms in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
                are
                %a.existingWikiWord{:href => "/nlab/show/compact+objects"} compact objects
                or
                %a.existingWikiWord{:href => "/nlab/show/small+objects"} small objects
                is a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/cellular+model+category"} cellular model category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cellular+category"} cellular category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
          %h2#references References
          %p The original reference is:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/William+G.+Dwyer"}> William G. Dwyer
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Philip+S.+Hirschhorn"} Philip S. Hirschhorn
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+M.+Kan"} Daniel M. Kan
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Model+Categories+and+More+General+Abstract+Homotopy+Theory"} Model Categories and More General Abstract Homotopy Theory
              = succeed "," do
                %a{:href => "https://web.math.rochester.edu/people/faculty/doug/otherpapers/dhk.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/DwyerHirschhornKan-ModelCategories.pdf", :title => "pdf"} pdf
          %p
            In particular, the Kan recognition theorem is in §II.8 and the
            %a.existingWikiWord{:href => "/nlab/show/Kan+transfer+theorem"} Kan transfer theorem
            is in §II.9. This manuscript draft later transformed in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Homotopy+Limit+Functors+on+Model+Categories+and+Homotopical+Categories"} Homotopy Limit Functors on Model Categories and Homotopical Categories
          %p Textbook accounts:
          %ul
            %li#Hovey99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
                , Section 2.1 in:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Model+Categories"} Model Categories
                %strong 63
                AMS (1999) &amp;lbrack;
                %a{:href => "https://bookstore.ams.org/surv-63-s"}> ISBN:978-0-8218-4361-1
                ,
                = succeed "," do
                  %a{:href => "https://doi.org/http://dx.doi.org/10.1090/surv/063"} doi:10.1090/surv/063
                = succeed "&rbrack;" do
                  %a{:href => "http://books.google.co.uk/books?id=Kfs4uuiTXN0C&printsec=frontcover"} Google books
            %li#Hirschhorn03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Philip+Hirschhorn"}> Philip Hirschhorn
                , Sec. 11 in:
                = succeed "," do
                  %em Model Categories and Their Localizations
                = succeed "," do
                  %a{:href => "https://bookstore.ams.org/surv-99-s/"} ISBN:978-0-8218-4917-0
                = succeed "," do
                  %a{:href => "http://www.gbv.de/dms/goettingen/360115845.pdf"} pdf toc
                = succeed ")" do
                  %a{:href => "http://www.maths.ed.ac.uk/~aar/papers/hirschhornloc.pdf"} pdf
          %p Further review:
          %ul
            %li#GoerssSchemmerhorn06
              %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"}> Paul Goerss
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kirsten+Schemmerhorn"} Kirsten Schemmerhorn
              = succeed "," do
                %em Model categories and simplicial methods
              = succeed "," do
                %em Interactions between Homotopy Theory and Algebra
              %strong 436
              AMS (2007) &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/math.AT/0609537"}> arXiv:math.AT/0609537
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://dx.doi.org/10.1090/conm/436"} doi:10.1090/conm/436
          %p For the general case a useful reference is for instance the first section of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tibor+Beke"}> Tibor Beke
              ,
              = succeed "," do
                %em Sheafifiable homotopy model categories
              %strong 129
              (2000), no. 3, 447–475.(
              %a{:href => "http://arxiv.org/abs/math/0102087"}> math.CT/0102087
              ),
              = succeed "," do
                %em Sheafifiable homotopy model categories. II
              %strong 164
              (2001), no. 3, 307–324.
          %p
            For the case of a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/presentable+category"} presentable category
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              , section A.1.2 in:
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p See also:
          %ul
            %li#Dugger
              %a.existingWikiWord{:href => "/nlab/show/Dan+Dugger"}> Dan Dugger
              , Appendix of:
              %em Replacing model categories with simplicial ones
              (
              %a{:href => "http://hopf.math.purdue.edu/Dugger/smod.pdf"}> pdf
              )
        .revisedby
