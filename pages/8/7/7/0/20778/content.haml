            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kantorovich-Wasserstein+distance"}> Kantorovich-Wasserstein distance
                ,
                %span.newWikiWord
                  optimal transport
                  %a{:href => "/nlab/new/optimal+transport"} ?
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/metric+space"}> metric space
                ,
                %a.existingWikiWord{:href => "/nlab/show/complete+metric+space"} complete metric space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Banach+space"}> Banach space
                ,
                = succeed "," do
                  %span.newWikiWord
                    ordered Banach space
                    %a{:href => "/nlab/new/ordered+Banach+space"} ?
