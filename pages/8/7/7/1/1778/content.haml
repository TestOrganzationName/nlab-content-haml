                  \&amp;
                  \\simeq
                  \\int_{[k] \in \Delta} SSet(\Delta^k , A(U \times_X \cdots \times_X U) )
                  \\\
                  \&amp;
                  \\simeq
                  \\int_{[k] \in \Delta} SSet(\Delta^k , \prod_{i_0, \cdots, i_k} A(U_{i_0 i_1, \cdots ,i_k}) )
                  \\end{aligned}
                  \\,.
          %p
            Here in the last line we have assumed that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo =
                  %msub
                    %mo ⊔
                    %mi i
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} U = \sqcup_i U_i
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
            an open cover of some space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and we abbreviate as usual with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mrow
                      %msub
                        %mi i
                        %mn 0
                      %mo ,
                      %msub
                        %mi i
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi i
                        %mi k
                %annotation{:encoding => "application/x-tex"}
                  U_{i_0, i_1, \cdots, i_k}
            the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k+1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∩
                      %mrow
                        %mn 0
                        %mo ≤
                        %mi r
                        %mo ≤
                        %mi k
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mi r
                  %annotation{:encoding => "application/x-tex"} \cap_{0 \leq r \leq k} U_{i_r}
          %p
            An object in this last expression – an
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            relative to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            – is a collection of morphisms in
            %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋮
                          %mtd
                          %mtd
                            %mi ⋮
                        %mtr
                          %mtd
                            %msup
                              %mi Δ
                              %mn 2
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi i
                                %mi j
                                %mi k
                            %mi A
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mrow
                                %mi i
                                %mi j
                                %mi k
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mi Δ
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi i
                                %mi j
                            %mi A
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mrow
                                %mi i
                                %mi j
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mi Δ
                              %mn 0
                          %mtd
                            %mover
                              %mo ⟶
                              %mi a
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi i
                            %mi A
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\array{
                  \\vdots &amp;&amp; \vdots
                  \\\
                  \\Delta^2
                  \&amp;\stackrel{f}{\longrightarrow}&amp;
                  \\prod_{i j k} A(U_{i j k})
                  \\\
                  \\Delta^1
                  \&amp;\stackrel{g}{\longrightarrow}&amp;
                  \\prod_{i j}A(U_{ i j})
                  \\\
                  \\Delta^0
                  \&amp;\stackrel{a}{\longrightarrow}&amp;
                  \\prod_i A(U_i)
                  }
                  \\right)
          %p that make all diagrams of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ⋮
                        %mtd
                        %mtd
                          %mi ⋮
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↑
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %msup
                            %mi Δ
                            %mn 2
                        %mtd
                          %mover
                            %mo ⟶
                            %mi f
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi i
                              %mi j
                              %mi k
                          %mi A
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mrow
                              %mi i
                              %mi j
                              %mi k
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↑
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %msup
                            %mi Δ
                            %mn 1
                        %mtd
                          %mover
                            %mo →
                            %mi g
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi i
                              %mi j
                          %mi A
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mrow
                              %mi i
                              %mi j
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↑
                            %mrow
                              %msub
                                %mi δ
                                %mo ⋅
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↑
                            %mrow
                              %mi A
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi d
                                %mrow
                                  %mi C
                                  %mo{:stretchy => "false"} (
                                  %mi U
                                  %mo{:stretchy => "false"} )
                              %msub
                                %mo{:stretchy => "false"} )
                                %mo ⋅
                      %mtr
                        %mtd
                          %msup
                            %mi Δ
                            %mn 0
                        %mtd
                          %mover
                            %mo →
                            %mi a
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mi i
                          %mi A
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\vdots &amp;&amp; \vdots
                  \\\
                  \\uparrow
                  \&amp;&amp;
                  \\uparrow
                  \\\
                  \\Delta^2
                  \&amp;\stackrel{f}{\longrightarrow}&amp;
                  \\prod_{i j k} A(U_{i j k})
                  \\\
                  \\uparrow
                  \&amp;&amp;
                  \\uparrow
                  \\\
                  \\Delta^1
                  \&amp;\stackrel{g}{\to}&amp;
                  \\prod_{i j}A(U_{ i j})
                  \\\
                  \\uparrow^{\delta_{\cdot}}
                  \&amp;&amp;
                  \\uparrow^{A(d_{C(U)})_\cdot}
                  \\\
                  \\Delta^0
                  \&amp;\stackrel{a}{\to}&amp;
                  \\prod_i A(U_i)
                  }
          %p
            commute. Here the vertical morphism on the right, when one traces their origin through the derivation above, are the various inclusion and restriction maps of elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            evaluated on a
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p For instance the three possible vertical maps at the bottom have components on the cartesian factors given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mi U
                        %mi i
                  %mspace{:width => "thinmathspace"}
                  %mo ≔
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mi U
                        %mrow
                          %mi i
                          %mi j
                  %mo :
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mrow
                      %mi i
                      %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A(d_1)|_{U_i} \,\coloneqq\, (-)|_{U_{i j}}
                  \:
                  A(U_i)
                  \\to
                  A(U_{i j})
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mi U
                        %mi i
                  %mspace{:width => "thinmathspace"}
                  %mo ≔
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mi U
                        %mrow
                          %mi i
                          %mi j
                  %mo :
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi j
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mrow
                      %mi i
                      %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A(d_0)|_{U_i} \,\coloneqq\, (-)|_{U_{i j}}
                  \:
                  A(U_j)
                  \\to
                  A(U_{i j})
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi s
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mi U
                        %mrow
                          %mi i
                          %mi i
                  %mo :
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mrow
                      %mi i
                      %mi i
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  A(s_0)|_{U_{i i}}
                  \:
                  A(U_{i i})
                  \\to
                  A(U_{i })
                  \\,.
          %p This picks
          %ul
            %li
              %p
                an object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a \in A(U)
            %li
              %p
                a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %msubsup
                        %mi π
                        %mn 1
                        %mo *
                      %mi a
                      %mo →
                      %msubsup
                        %mi π
                        %mn 2
                        %mo *
                      %mi a
                      %mi in
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi U
                      %msub
                        %mo ×
                        %mi X
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g : \pi_1 ^* a \to \pi_2^* a in A(U \times_X U)
            %li
              %p a 2-morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msubsup
                                %mi π
                                %mn 2
                                %mo *
                              %mi a
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mrow
                                  %msubsup
                                    %mi π
                                    %mn 12
                                    %mo *
                                  %mi g
                              %mo ↗
                            %mtd
                              %msup
                                %mo ⇓
                                %mi f
                            %mtd
                              %msup
                                %mo ↘
                                %mrow
                                  %msubsup
                                    %mi π
                                    %mn 23
                                    %mo *
                                  %mi g
                          %mtr
                            %mtd
                              %msubsup
                                %mi π
                                %mn 1
                                %mo *
                              %mi a
                            %mtd
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msubsup
                                    %mi π
                                    %mn 13
                                    %mo *
                                  %mi g
                            %mtd
                            %mtd
                              %msubsup
                                %mi π
                                %mn 3
                                %mo *
                              %mi a
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; \pi_{2}^* a
                      \\\
                      \&amp; {}^{\pi_{12}^* g}\nearrow &amp;\Downarrow^{f}&amp; \searrow^{\pi_{23}^* g}
                      \\\
                      \\pi_{1}^* a
                      \&amp;&amp;\stackrel{\pi_{13}^* g}{\to}&amp;&amp;
                      \\pi_3^* a
                      }
              %p
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi U
                      %msub
                        %mo ×
                        %mi X
                      %mi U
                      %msub
                        %mo ×
                        %mi X
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A(U \times_X U \times_X U)
            %li
              %p etc.
          %p If we follow tradition and write
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi U
                      %mo =
                      %msub
                        %mo ⊔
                        %mi i
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U = \sqcup_i U_i
                ;
            %li
              %p
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %msub
                        %mo ×
                        %mi X
                      %mi U
                      %mo =
                      %msub
                        %mo ⊔
                        %mrow
                          %mi i
                          %mi j
                      %msub
                        %mi U
                        %mrow
                          %mi i
                          %mi j
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo ⊔
                        %mrow
                          %mi i
                          %mi j
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} U \times_X U = \sqcup_{i j} U_{i j} \,\coloneqq\, \sqcup_{i j} U_i \cap U_j
            %li
              %p etc
          %p this is
          %ul
            %li
              %p
                an collection of objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi i
                      %mo ∈
                      %mi A
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (a_i \in A(U_i))
            %li
              %p
                a collection of morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                      %mo :
                      %msub
                        %mi a
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msub
                            %mi U
                            %mi ij
                      %mo →
                      %msub
                        %mi a
                        %mi j
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msub
                            %mi U
                            %mrow
                              %mi i
                              %mi j
                      %mi in
                      %mi A
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mrow
                          %mi i
                          %mi j
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      (g_{i j} : a_i|_{U_{ij}} \to a_{j}|_{U_{i j}}
                      in A(U_{i j}))
            %li
              %p a collection of 2-morphisms
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %msub
                                  %mi a
                                  %mi j
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %msub
                                      %mi U
                                      %mrow
                                        %mi i
                                        %mi j
                                        %mi k
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mrow
                                    %msub
                                      %mi g
                                      %mi ij
                                    %msub
                                      %mo{:stretchy => "false"} |
                                      %mrow
                                        %msub
                                          %mi U
                                          %mrow
                                            %mi i
                                            %mi j
                                            %mi k
                                %mo ↗
                              %mtd
                                %msup
                                  %mo ⇓
                                  %mrow
                                    %msub
                                      %mi f
                                      %mrow
                                        %mi i
                                        %mi j
                                        %mi k
                              %mtd
                                %msup
                                  %mo ↘
                                  %mrow
                                    %msub
                                      %mi g
                                      %mrow
                                        %mi j
                                        %mi k
                                    %msub
                                      %mo{:stretchy => "false"} |
                                      %mrow
                                        %msub
                                          %mi U
                                          %mrow
                                            %mi i
                                            %mi j
                                            %mi k
                            %mtr
                              %mtd
                                %msub
                                  %mi a
                                  %mi i
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %msub
                                      %mi U
                                      %mrow
                                        %mi i
