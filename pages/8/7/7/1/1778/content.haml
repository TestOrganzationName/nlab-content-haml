                          %mi I
                    %annotation{:encoding => "application/x-tex"} \{U_i \to X\}_{i \in I}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              any test object, the non-degenerate
              = succeed "-simplices" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(U)(W)
              are the
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %msub
                          %mi i
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi i
                          %mi n
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
