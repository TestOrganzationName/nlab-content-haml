                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi k
                              %mo{:stretchy => "false"} ]
                              %mo ∈
                              %mi Δ
                          %msup
                            %mi Δ
                            %mi k
                          %mo ⋅
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi U
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi k
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %msub
                            %mo ∫
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi k
                              %mo{:stretchy => "false"} ]
                              %mo ∈
                              %mi Δ
                          %mi SSh
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mi k
                          %mo ⋅
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi U
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi k
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %msub
                            %mo ∫
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi k
                              %mo{:stretchy => "false"} ]
                              %mo ∈
                              %mi Δ
                          %mi SSet
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mi k
                          %mo ,
                          %mi SSh
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi U
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi k
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %msub
                            %mo ∫
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi k
                              %mo{:stretchy => "false"} ]
                              %mo ∈
                              %mi Δ
                          %mi SSet
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mi k
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} (
                          %mi U
                          %msub
                            %mo ×
                            %mi X
                          %mi ⋯
                          %msub
                            %mo ×
                            %mi X
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %msub
                            %mo ∫
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi k
                              %mo{:stretchy => "false"} ]
                              %mo ∈
                              %mi Δ
                          %mi SSet
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mi k
                          %mo ,
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %msub
                                %mi i
                                %mn 0
                              %mo ,
                              %mi ⋯
                              %mo ,
