                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  SSh(C(U), A)
                  \&amp;
                  \\simeq
                  SSh( \int^{[k] \in \Delta} \Delta^k \cdot C(U)_k, A )
                  \\\
