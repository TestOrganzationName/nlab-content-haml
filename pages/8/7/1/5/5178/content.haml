                  %mi Y
                %annotation{:encoding => "application/x-tex"} u\colon X\to Y
            as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
