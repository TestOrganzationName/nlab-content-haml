                              %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi 𝒮
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\tilde \mathbb{C} \\ \downarrow \\ \mathcal{S}
                    }
            %p
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}
            %p
              Similarly, an
              = succeed "-" do
