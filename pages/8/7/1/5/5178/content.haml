                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
          .num_defn
            %h6#definition_2 Definition
            %p
              An
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝒮
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}
                \-indexed category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ℂ
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde \mathbb{C}
              is a category defined by a
              %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo :
                    %msup
                      %mi 𝒮
                      %mi op
                    %mo →
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C} : \mathcal{S}^{op}\to Cat
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              to the
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              of categories.
            %p
              Under the
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
              this is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/fibered+category"} fibered category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
