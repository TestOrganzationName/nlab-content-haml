                    %mo ,
                    %mi Cat
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{S} IndCat \coloneqq [\mathcal{S}^{op}, Cat]
              of
              = succeed "-indexed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}
          %p
            This appears for instance as (
            %a{:href => "#Johnstone"}> Johnstone, def. B1.2.1
            ).
          %p
            One may also call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
