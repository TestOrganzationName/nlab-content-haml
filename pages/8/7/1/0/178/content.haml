                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi SmoothMfd
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Smooth \infty Grpd \simeq \hat Sh_{(\infty,1)}(SmoothMfd)
                    \\,.
          .proof
            %h6#proof_5 Proof
            %p
              By the above we have that
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
