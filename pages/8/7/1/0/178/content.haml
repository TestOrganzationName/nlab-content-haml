              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
              that is generated from it is the standard
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              topology.
          .proof
            %h6#proof_2 Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              any open cover of a paracompact manifold also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \coprod_i U_i
              is paracompact. Hence we may find a differentiably good open cover
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi K
                        %mi j
                      %mo →
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi i
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{K_j \to \coprod_i U_i\}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .num_defn
