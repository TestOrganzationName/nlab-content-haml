          #RelativeTopologicalCohesion.num_prop
            %h6#proposition_5 Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              extends to an
              %a.existingWikiWord{:href => "/nlab/show/essential+%28%E2%88%9E%2C1%29-geometric+morphism"} essential (∞,1)-geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mo !
                    %mo ⊣
                    %msup
                      %mi i
                      %mo *
                    %mo ⊣
                    %msub
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mrow
                            %msub
                              %mi i
                              %mo *
                        %mover
                          %mo ←
                          %mrow
                            %msup
                              %mi i
                              %mo *
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi i
                            %mo !
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    (i_! \dashv i^* \dashv i_*)
                    \:
                    Smooth\infty Grpd
                    \\stackrel{\overset{i_!}{\to}}{\stackrel{\overset{i^*}{\leftarrow}}{\underset{i_*}{\to}}}
                    ETop\infty Grpd
            %p
              such that the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
              is factored through the induced inclusion
              %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo ↪
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \stackrel{i}{\hookrightarrow}
              %a.existingWikiWord{:href => "/nlab/show/Mfd"} Mfd
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi SmoothMfd
                          %mtd
                            %mo ↪
                          %mtd
                            %mi Smooth
                            %mn ∞
                            %mi Grpd
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi i
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mo !
                        %mtr
                          %mtd
                            %mi Mfd
                          %mtd
                            %mo ↪
                          %mtd
                            %mi ETop
                            %mn ∞
                            %mi Grpd
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    SmoothMfd &amp;\hookrightarrow&amp; Smooth\infty Grpd
                    \\\
                    \\downarrow^{\mathrlap{i}} &amp;&amp; \downarrow^{\mathrlap{i_!}}
                    \\\
                    Mfd &amp;\hookrightarrow&amp; ETop\infty Grpd
                    }
                    \\,
          .proof
            %h6#proof_6 Proof
            %p
              Using the observation that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              preserves
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              = succeed "." do
                %a{:href => "http://nlab.mathforge.org/nlab/edit/cohesive%20(infinity,1)-topos#InfinitesimalNeighbourhoodFromInfinitesimalSite"} this proposition
            %p
              (Both of these are special cases of a general statement about morphisms of
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
          #UnderlyingETopologicalInftyGroupoids.num_prop
            %h6#corollary_2 Corollary
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-geometric+morphism"} (∞,1)-geometric morphism
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth \infty Grpd
              factors through that of
              %a.existingWikiWord{:href => "/nlab/show/ETop%E2%88%9EGrpd"} ETop∞Grpd
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Π
                      %mi Smooth
                    %mo ⊣
                    %msub
                      %mi Disc
                      %mi Smooth
                    %mo ⊣
                    %msub
                      %mi Γ
                      %mi Smooth
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mrow
                            %msub
                              %mi i
                              %mo *
                        %mover
                          %mo ←
                          %mrow
                            %msup
                              %mi i
                              %mo *
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi i
                            %mo !
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mrow
                            %msub
                              %mi Γ
                              %mi ETop
                        %mover
                          %mo ←
                          %mrow
                            %msub
                              %mi Disc
                              %mi ETop
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi Π
                            %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi_{Smooth} \dashv Disc_{Smooth} \dashv \Gamma_{Smooth})
                    \:
                    Smooth \infty Grpd
                    \\stackrel{\overset{i_!}{\to}}{\stackrel{\overset{i^*}{\leftarrow}}{\underset{i_*}{\to}}}
                    ETop\infty Grpd
                    \\stackrel{\overset{\Pi_{ETop}}{\to}}{\stackrel{\overset{Disc_{ETop}}{\leftarrow}}{\underset{\Gamma_{ETop}}{\to}}}
                    \\infty Grpd
          .proof
            %h6#proof_7 Proof
            %p
              This follows from the essential uniqueness of the
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-geometric+morphism"} (∞,1)-geometric morphism
              and of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
          .num_prop
            %h6#observation Observation
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo !
                  %annotation{:encoding => "application/x-tex"} i_!
              here is the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              that forgets
              %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
              and only remembers
              = succeed "-structure." do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+topology"} Euclidean topology
          %h4#infinitesimal_cohesion Infinitesimal cohesion
          %p
            Observe that
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi smooth
                %annotation{:encoding => "application/x-tex"} {}_{smooth}
            is (the
            %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic category
            of) a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theory
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
            = succeed "-rings)." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SmoothAlg
                  %mo :
                  %mo =
                  %mi Alg
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SmoothAlg := Alg(C)
            for the category of its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebras+over+a+Lawvere+theory"} algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi InfPoint
                  %mo ↪
                  %msup
                    %mi SmoothAlg
                    %mi op
                %annotation{:encoding => "application/x-tex"} InfPoint \hookrightarrow SmoothAlg^{op}
            be the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            on the
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+point"} infinitesimally thickened point
          .num_defn
            %h6#definition_7 Definition
            %p
              Let
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi synthdiff
                    %mo ↪
                    %msup
                      %mi SmoothAlg
                      %mi op
                  %annotation{:encoding => "application/x-tex"} {}_{synthdiff} \hookrightarrow SmoothAlg^{op}
              be the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              on the objects of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mi D
                  %annotation{:encoding => "application/x-tex"} U \times D
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ∈
                    %msub
                      %mi CartSp
                      %mi smooth
                    %mo ↪
                    %msup
                      %mi SmoothAlg
                      %mi op
                  %annotation{:encoding => "application/x-tex"} D \in CartSp_{smooth} \hookrightarrow SmoothAlg^{op}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo ∈
                      %mi InfPoint
                      %mo ↪
                      %msup
                        %mi SmoothAlg
                        %mi op
                    %annotation{:encoding => "application/x-tex"} D \in InfPoint \hookrightarrow SmoothAlg^{op}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %msub
                      %mi CartSp
                      %mi smooth
                    %mo ↪
                    %msub
                      %mi CartSp
                      %mi synthdiff
                  %annotation{:encoding => "application/x-tex"}
                    i : CartSp_{smooth} \hookrightarrow CartSp_{synthdiff}
            %p for the canonical inclusion.
          .num_prop
            %h6#proposition_6 Proposition
            %p
              The inclusion exhibits an
              %a{:href => "http://nlab.mathforge.org/nlab/edit/cohesive+(infinity%2C1)-topos#InfinitesimalCohesion"} infinitesimal cohesive neighbourhood
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth \infty Grpd
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mo !
                    %mo ⊣
                    %msup
                      %mi i
                      %mo *
                    %mo ⊣
                    %msub
                      %mi i
                      %mo *
                    %mo ⊣
                    %msup
                      %mi i
                      %mo !
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                    %mo ↪
                    %mi SynthDiff
                    %mn ∞
                    %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (i_! \dashv i^* \dashv i_* \dashv i^!)
                    \:
                    Smooth \infty Grpd
                    \\hookrightarrow
                    SynthDiff\infty Grpd
                    \\,,
            %p
              where
              %a.existingWikiWord{:href => "/nlab/show/SynthDiff%E2%88%9EGrpd"} SynthDiff∞Grpd
              is the
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              of
              = succeed "s:" do
                %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+%E2%88%9E-groupoid"} synthetic differential ∞-groupoid
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi CartSp
                        %mi synthdiff
                    %annotation{:encoding => "application/x-tex"} CartSp_{synthdiff}
          .proof
            %h6#proof_8 Proof
            %p
              This follows as a special case of
              %a{:href => "http://nlab.mathforge.org/nlab/edit/cohesive%20(infinity,1)-topos#InfinitesimalNeighbourhoodFromInfinitesimalSite"} this proposition
              after observing that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CartSp
                      %mi synthdiff
                  %annotation{:encoding => "application/x-tex"} CartSp_{synthdiff}
              is an infinitesimal neighbourhood site of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CartSp
                      %mi smooth
                  %annotation{:encoding => "application/x-tex"} CartSp_{smooth}
              in the sense defined there.
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/SynthDiff%E2%88%9EGrpd"} SynthDiff∞Grpd
            we have
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            = succeed "s." do
