              is equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/hypercompletion"} hypercompletion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi Sh
