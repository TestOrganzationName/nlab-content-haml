                %em
                  %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
          .num_defn
            %h6#definition_3 Definition
            %p
              Let
              %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
              be the
              %a.existingWikiWord{:href => "/nlab/show/large+site"} large site
              of
              %a.existingWikiWord{:href => "/nlab/show/paracompact+manifold"} paracompact
              = succeed "s" do
