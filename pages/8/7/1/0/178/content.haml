                %a{:href => "Brown-Gersten+property#OverSmoothmanifolds"} there
          %h2#properties Properties
          %h3#cohesion Cohesion
          .num_prop
            %h6#proposition_2 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth \infty Grpd
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
          .proof
            %h6#proof_3 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi smooth
                  %annotation{:encoding => "application/x-tex"} {}_{smooth}
              is (as discussed there) an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive site
          .num_defn
            %h6#definition_6 Definition
            %p
              Let
              %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
              be the
              %a.existingWikiWord{:href => "/nlab/show/large+site"} large site
              of
              %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
