                      %annotation{:encoding => "application/x-tex"} \lessapprox 10^{-17}m
                  (
                  %a{:href => "causal+locality#Microcausality"}> Grigoriev 79
                  ),
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
