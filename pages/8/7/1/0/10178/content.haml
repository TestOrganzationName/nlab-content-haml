                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 3
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; Q
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow^{\mathrlap{i}}
                  \\\
                  \\ast
                  \&amp;&amp;
                  \\swArrow_{\xi }
                  \&amp;&amp;
                  X
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow_{\mathrlap{\chi \simeq \tfrac{1}{2}\mathbf{p}_1(X) + 2 \mathbf{a}}}
                  \\\
                  \&amp;&amp; \mathbf{B}^3 U(1)
                  }
          %p
            By (
            %a{:href => "#ABG"}> ABG
            ) we have:
          .num_prop
            %h6#proposition_14 Proposition
            %p
              Circle 3-bundles canonically twist the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
              %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
              in that there is a canonical morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi tmf
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    B^3 U(1) \to B GL_1(tmf)
                    \\,.
          %p
            Therefore we may consider the motivic quantization of the above setup with coefficients in
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-modules"} ∞-modules
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Q
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi i
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                        %mtd
                          %msub
                            %mo ⇙
                            %mi ξ
                        %mtd
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
