              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi Q
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi i
                    %mo *
                  %mi χ
                  %mo +
                  %msub
                    %mi W
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi N
                    %mi i
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Γ
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi χ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi in
                  %mi KU
                  %mi Mod
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma_Q( i^\ast \chi + W_3(N_i Q) ) \to \Gamma_X(\chi)
                  \\;\;\;\;\;
                  in KU Mod
          %p
            compatibility is
            %em
              %a.existingWikiWord{:href => "/nlab/show/Freed-Witten-Kapustin+anomaly+cancellation"} Freed-Witten-Kapustin anomaly cancellation
          %h5#DBraneCharge D-Brane charge
          %p
            We interpret the
            %a.existingWikiWord{:href => "/nlab/show/Freed-Witten-Kapustin+anomaly"} Freed-Witten-Kapustin anomaly
            mechanism in terms of
            %a.existingWikiWord{:href => "/nlab/show/push-forward+in+generalized+cohomology"} push-forward in generalized cohomology
            in
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            interpreted in terms of
            %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
            with push-forward maps given by
            %a.existingWikiWord{:href => "/nlab/show/dual+morphisms"} dual morphisms
            between
            %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality+C%2A-algebras"} Poincaré duality C*-algebras
            (based on
            = succeed "," do
              %a{:href => "#BrodzkiMathaiRosenbergSzabo06"} Brodzki-Mathai-Rosenberg-Szabo 06, section 7
            = succeed "):" do
              %a{:href => "#Tu06"} Tu 06
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Q
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} i \colon Q \to X
            be a map of
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %msup
                    %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \chi \colon X \to B^2 U(1)
            modulate a
            %a.existingWikiWord{:href => "/nlab/show/circle+2-bundle"} circle 2-bundle
            regarded as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twist for K-theory
            %a.existingWikiWord{:href => "/nlab/show/twisted+groupoid+convolution+algebras"} twisted groupoid convolution algebras
            yields a
            %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
            morphism of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %mi χ
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟵
                    %mrow
                      %msup
                        %mi i
                        %mo *
                  %msub
                    %mi C
                    %mi χ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  C_{i^\ast \chi}(Q)
                  \\stackrel{i^\ast}{\longleftarrow}
                  C_{\chi}(X)
                  \\,,
          %p
            with notation as in
            = succeed "." do
              %a{:href => "Poincar&#233;+duality+algebra#CStarAlgebraOf2BundleOnManifold"} this definition
            %a{:href => "Poincar&#233;+duality+algebra#DualOfCompactManifoldWithTwist"} this proposition
            the
            %a.existingWikiWord{:href => "/nlab/show/dual+morphism"} dual morphism
            is of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mfrac
                      %mn 1
                      %mrow
                        %msup
                          %mi i
                          %mo *
                        %mi χ
                        %mo ⊗
                        %msub
                          %mi W
                          %mn 3
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mi Q
                        %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi i
                        %mo !
                  %msub
                    %mi C
                    %mfrac
                      %mn 1
                      %mrow
                        %mi χ
                        %mo ⊗
                        %msub
                          %mi W
                          %mn 3
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mi X
                        %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C_{\frac{1}{i^\ast \chi \otimes W_3(T Q)}}(Q)
                  \\stackrel{i_!}{\longrightarrow}
                  C_{\frac{1}{\chi \otimes W_3(T X)}}(X)
                  \\,.
          %p
            If we redefine the twist on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to absorb this “quantum correction” as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo ↦
                  %mfrac
                    %mn 1
                    %mrow
                      %mi χ
                      %mo ⊗
                      %msub
                        %mi W
                        %mn 3
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mi X
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \chi \mapsto \frac{1}{\chi \otimes W_3(T X)}
            then this is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %mi χ
                      %mfrac
                        %mrow
                          %msub
                            %mi W
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi i
                            %mo *
                          %mi T
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi W
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mi Q
                          %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi i
                        %mo !
                  %msub
                    %mi C
                    %mi χ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  C_{i^\ast \chi\frac{W_3(i^\ast T X)}{W_3(T Q)}}(Q)
                  \\stackrel{i_!}{\longrightarrow}
                  C_{\chi}(X)
                  \\,,
          %p
            where now we may interpret
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %msub
                        %mi W
                        %mn 3
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mi τ
                        %mi X
                      %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi W
                        %mn 3
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi τ
                        %mi Q
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{W_3(i^\ast \tau_X)}{W_3(\tau_Q)}
            as the third
            %a.existingWikiWord{:href => "/nlab/show/integral+Stiefel-Whitney+class"} integral Stiefel-Whitney class
            of the
            %a.existingWikiWord{:href => "/nlab/show/normal+bundle"} normal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mi Q
                %annotation{:encoding => "application/x-tex"} N Q
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            (see
            = succeed ")." do
              %a{:href => "#Nuiten"} Nuiten
          %p
            Postcomposition with this map in
            %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
            now yields a map from the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mi χ
                    %mo ⊗
                    %msub
                      %mi W
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i^\ast \chi \otimes W_3(N Q)
            %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            to the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} \chi
            %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo !
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi K
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %msub
                        %mi W
                        %mn 3
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mi Q
                      %mo{:stretchy => "false"} )
                      %mo +
                      %msup
                        %mi i
                        %mo *
                      %mi χ
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi K
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi χ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  i_! \colon K_{\bullet + W_3(N Q) + i^\ast \chi}(Q) \to K_{\bullet +\chi}
                  \\,.
          %p
            If we here think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Q
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} i \colon Q \hookrightarrow X
            as being the inclusion of a
            %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                %annotation{:encoding => "application/x-tex"} \chi
            would be the class of the
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            and an element
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi ξ
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %msub
                    %mi K
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %msub
                        %mi W
                        %mn 3
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mi Q
                      %mo{:stretchy => "false"} )
                      %mo +
                      %msup
                        %mi i
                        %mo *
                      %mi χ
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  [\xi] \in K_{\bullet + W_3(N Q) + i^\ast \chi}(Q)
          %p
            is called (the K-class of) a
            %em
              %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton gauge field
            on the D-brane satisfying the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Freed-Witten-Kapustin+anomaly"} Freed-Witten-Kapustin anomaly
                cancellation mechanism
            %em Freed-Witten anomaly cancellation
            assumes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                %annotation{:encoding => "application/x-tex"} \xi
            given by a
            %a.existingWikiWord{:href => "/nlab/show/twisted+unitary+bundle"} twisted line bundle
            in which case it exhibits a
            %a.existingWikiWord{:href => "/nlab/show/twisted+spin%5Ec+structure"} twisted spin^c structure
            on
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
            %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} push-forward
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi i
                    %mo !
                  %mi ξ
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %msub
                    %mi K
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi χ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  [i_! \xi] \in K_{\bullet + \chi}(X)
          %p
            is called the corresponding
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/D-brane+charge"} D-brane charge
          %h5#topological_tduality Topological T-duality
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/topological+T-duality"} topological T-duality
          %h3#ExamplesDimension3 Dimension 3
          %h4#HeteroticStringAtBoundaryOfMembrane The heterotic string at the boundary of the M2-brane
          %p
            In the previous example
            %em
              %a{:href => "#ChargedParticleAtBoundaryOfSuperstring"} The charged particle at the boundary of the superstring
            we saw – by analogy with the
            %a{:href => "#PoissonManifoldAtTheBoundaryOf2dChernSimonsTheory"} particle at the boundary of the 2d Chern-Simons theory
            – the motivic quantization with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            %a.existingWikiWord{:href => "/nlab/show/KU"} KU
            of the 1-dimensional field which is the
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            of a
            %a.existingWikiWord{:href => "/nlab/show/charged+particle"} charged particle
            at the intersection of a 2-dimensional field theory which is an
            %a.existingWikiWord{:href => "/nlab/show/open+string"} open string
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            ending on a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            of the 2-dimensional field theory called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/heterotic+string"} heterotic string
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            as the boundary intersection of the 3d field theory known as the
            %em
              %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            with a
            %a.existingWikiWord{:href => "/nlab/show/brane"} brane
            called sometimes the
            %em
              %a.existingWikiWord{:href => "/nlab/show/M9-brane"} M9-brane
            or the
            = succeed "-plane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mn 9
                  %annotation{:encoding => "application/x-tex"} O9
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Ho%C5%99ava-Witten+theory"} Hořava-Witten theory
          %p
            The analog of the
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/index"} index
            %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
            in the
            %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
            of the point now is the
            %a.existingWikiWord{:href => "/nlab/show/Witten+genus"} Witten genus
            with values in
            %a.existingWikiWord{:href => "/nlab/show/topological+modular+forms"} topological modular forms
          %ul
            %li
              %em
                %a{:href => "#TheWittenGenus"} The Witten genus
          %p
            and the analog of the
            %a.existingWikiWord{:href => "/nlab/show/D-brane+charge"} D-brane charge
            in the
            %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
            of the
            %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            is
          %ul
            %li
              %em
                %a{:href => "#TheO9PlaneCharge"} The M9-brane charge
          %p
            in
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology
            of the
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \,,
          %p More in detail, the setup is the following.
          %ul
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be a
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
                equipped with
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                of
                %a.existingWikiWord{:href => "/nlab/show/Ho%C5%99ava-Witten+theory"} Hořava-Witten
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi χ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mn 3
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \chi \colon X \to \mathbf{B}^3 U(1)
                be the (
                %a.existingWikiWord{:href => "/nlab/show/instanton+sector"} instanton sector
                of a)
                %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 3-bundle
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
                = succeed ")" do
