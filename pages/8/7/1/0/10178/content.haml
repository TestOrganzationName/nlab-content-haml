                      %mi ℝ
                      %mn 2
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi q
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{R}^2, \mathbf{d} q \wedge \mathbf{d} p)
              is the globally defined
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
              1-form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo ≔
                    %mi p
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi q
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\theta \coloneqq p \, \mathbf{d} q
                    \\,.
            %p
              We have to check that on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi graph
                    %mo{:stretchy => "false"} (
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} {
                    %mi H
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} graph(\exp(t\{H,-\}))
              we have the
              %a.existingWikiWord{:href => "/nlab/show/equation"} equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
