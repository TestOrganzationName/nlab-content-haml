            a 3-dimensional
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            %a.existingWikiWord{:href => "/nlab/show/conformal+structure"} conformal structure
            on the boundary and so the boundary theory is a non-topological
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/conformal+field+theory"} conformal field theory
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/AdS3-CFT2+and+CS-WZW+correspondence"} AdS3-CFT2 and CS-WZW correspondence
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            this general kind of relation between
            = succeed "-dimensional" do
