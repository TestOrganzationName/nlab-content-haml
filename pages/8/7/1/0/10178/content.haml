                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mrow
                        %mi E
                        %mi Mod
                    %mrow
                      %mo (
                      %msubsup
                        %mi Γ
                        %mrow
                          %msub
                            %mi X
                            %mn 1
                        %mo *
                      %mrow
                        %mo (
                        %msub
                          %mi χ
                          %mn 1
                        %mo )
                      %mo ,
                      %msubsup
                        %mi Γ
                        %mrow
                          %msub
                            %mi X
                            %mn 2
                        %mo *
                      %mrow
                        %mo (
                        %msub
                          %mi χ
                          %mn 2
                        %mo )
                      %mo )
                    %mo ∈
                    %mi E
                    %mi Mod
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^{\bullet + \chi_2 - \chi_1}(X_1,X_2)
                    \\;\coloneqq\;
                    Hom_{E Mod}\left(\Gamma^\ast_{X_1}\left(\chi_1\right), \Gamma^\ast_{X_2}\left(\chi_2\right)\right)
                    \\in
                    E Mod
                    \\,.
          .num_example
            %h6#example Example
            %p
              By the general discussion at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
              = succeed ")" do
                %a{:href => "#ABG"} ABG, def. 5.1
            %ul
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
