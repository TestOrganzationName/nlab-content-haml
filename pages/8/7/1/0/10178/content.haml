                %annotation{:encoding => "application/x-tex"}
                  \\chi
                  \\;
                  \\colon
                  \\;
                  \\mathbf{Fields}
                  \\stackrel{\exp(i S)}{\longrightarrow}
                  \\mathbf{B}^n U(1)
                  \\stackrel{\rho}{\longrightarrow}
                  \\mathbf{B} GL_1(E)
                  \\stackrel{}{\longrightarrow}
                  Pic(E)
                  \\longrightarrow
                  E Mod
          %p
            modulates the associated
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/higher+prequantum+line+bundle"} higher prequantum E-line bundle
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                %annotation{:encoding => "application/x-tex"} \chi
            is a
            = succeed "," do
              %em
                higher
                %a.existingWikiWord{:href => "/nlab/show/wavefunction"} wavefunction
            = succeed "." do
              %em
                higher
                %a.existingWikiWord{:href => "/nlab/show/quantum+state"} quantum state
          %p
            (At this point this looks un-
            %a.existingWikiWord{:href => "/nlab/show/polarization"}> polarized
            , but in fact we will see in the next section that the notion of
            %a.existingWikiWord{:href => "/nlab/show/polarization"} polarization
            in
            %a.existingWikiWord{:href => "/nlab/show/higher+prequantum+geometry"} higher prequantum geometry
            is automatic, but appears in a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/holography"} holographic
            %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
            way in
            %a.existingWikiWord{:href => "/nlab/show/codimension"} codimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (n-1)
            instead of here in codimension
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Accordingly, the
            %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                %annotation{:encoding => "application/x-tex"} \chi
            is the higher
            %a.existingWikiWord{:href => "/nlab/show/space+of+quantum+states"} space of quantum states
            in
            %a.existingWikiWord{:href => "/nlab/show/codimension"} codimension
            0.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete ∞-groupoid
            then the space of sections has a particularly nice description, on which we focus for a bit:
          %p
