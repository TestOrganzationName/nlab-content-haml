            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            for more general ambient
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-toposes"} (∞,1)-toposes
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          #BivariantCohomologyByHomsOfCoSections.num_defn
            %h6#definition Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mi i
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi_i \colon X_i \to \mathbf{B}GL_1(E)
              two
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
