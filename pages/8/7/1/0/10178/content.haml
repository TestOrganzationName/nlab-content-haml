              and with
              %a.existingWikiWord{:href => "/nlab/show/proper+maps"} proper maps
              between them to the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/KU"} KU
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-modules"} ∞-modules
              which factors by a
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
              through
              %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi DiffStack
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mn 2
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %mi prop
                    %mover
                      %mo →
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi KK
                      %mi op
                    %mo →
                    %msup
                      %mrow
                        %mo (
                        %mi Ho
                        %mrow
                          %mo (
                          %mi KU
                          %mi Mod
                          %mo )
                        %mo )
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma
                    \\;\colon\;
                    DiffStack^{prop}_{/\mathbf{B}^2 U(1)}
                    \\stackrel{C(-)}{\to}
                    KK^{op}
                    \\to
                    \\left( Ho\left( KU Mod \right) \right)^{op}
            %p and which
            %ul
              %li
                %p
                  sends a Lie groupoid
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  with circle 2-bundle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                      %annotation{:encoding => "application/x-tex"} \chi
                  first its
                  %a.existingWikiWord{:href => "/nlab/show/twisted+groupoid+convolution+algebra"} twisted groupoid convolution algebra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mi χ
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ∈
                      %annotation{:encoding => "application/x-tex"} C_\chi(X) \in
                  %a.existingWikiWord{:href => "/nlab/show/C%2AAlg"} C*Alg
                  and then produces the
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/operator+K-theory"} operator K-theory
                  %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
                  of that algebra as discussd at
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
                  in the section
                  = succeed ";" do
                    %em
                      %a{:href => "KK-theory#TriangulatedAndSpectrumEnrichedStructure"} Triangulated and KU-module structure
              %li
                %p
                  sends a morphism of Lie groupoids to the
                  %a.existingWikiWord{:href => "/nlab/show/Hilbert+bimodule"} Hilbert bimodule
                  of sections of the corresponding
                  %a.existingWikiWord{:href => "/nlab/show/Hilsum-Skandalis+morphism"} Hilsum-Skandalis
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/bibundle"} bibundle
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal
              at least when restricted to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/amenable+Lie+groupoids"} amenable Lie groupoids
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full inclusion
              of the
              %a.existingWikiWord{:href => "/nlab/show/KK-bootstrap+category"} KK-bootstrap category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
