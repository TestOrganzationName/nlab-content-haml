                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↑
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %msub
                            %mi 𝒪
                            %mi λ
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} /
                          %mi G
                        %mtd
                          %mo ←
                        %mtd
                          %msub
                            %mi 𝒪
                            %mi λ
                        %mtd
                          %mo ↪
                        %mtd
