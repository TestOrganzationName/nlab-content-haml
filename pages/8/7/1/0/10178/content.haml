                  \\mathbf{H}_{/\mathbf{B}^n U(1)_{conn}}
          %p
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo [
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi exp
                                  %mo{:stretchy => "false"} (
                                  %mi i
                                  %mi S
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                    %mo ]
                %annotation{:encoding => "application/x-tex"} \left[\array{\mathbf{Fields} \\ \downarrow^{\mathrlap{exp(i S)}} \\  \mathbf{B}^n U(1)_{conn}}\right]
            and whose
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            are
            %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mn 1
                        %mtd
                        %mtd
                          %mo ⟶
                        %mtd
                        %mtd
