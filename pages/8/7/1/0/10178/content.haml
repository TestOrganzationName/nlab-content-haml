                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathbf{Fields}_{boundary}
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  \\ast &amp;&amp; \swArrow &amp;&amp; \mathbf{Fields}
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow_{\mathrlap{\chi}}
                  \\\
                  \&amp;&amp; \mathbf{B}^n U(1)
                  }
                  \\,.
          %p
            Such a diagram is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/twisted+differential+c-structure"} twisted chi-structure
            and such structures appear all over the place in
            %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum field theory
            (e.g.
            = succeed "," do
              %a{:href => "#FSS09"} Fiorenza-Sati-Schreiber 09
            = succeed ")" do
              %a{:href => "FSS12"} Fiorenza-Sati-Schreiber 12
            %em
              %a.existingWikiWord{:href => "/nlab/show/twisted+smooth+cohomology+in+string+theory"} twisted smooth cohomology in string theory
          %h3#ExpositionLinearizationInGeneralizedCohomology 3. Linearization in generalized cohomology
          %p
            We now survey the linearization step. See (
            %a{:href => "#Nuiten13"}> Nuiten 13, section 3
            ).
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Before actually quantizing a
            %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum field theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo [
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi exp
                                  %mo{:stretchy => "false"} (
                                  %mi i
                                  %mi S
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                    %mo ]
                %annotation{:encoding => "application/x-tex"} \left[ \array{ \mathbf{Fields} \\ \downarrow^{\mathrlap{\exp(i S)}} \\ \mathbf{B}^n U(1)_{conn}}\right]
            as above, we choose linear
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
          %ol
            %li
              %p
                a choice of ground
                %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %p
                (playing the role of the
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                in plain
                = succeed ");" do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            %li
              %p
                a choice of
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
                homomorphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %msub
                        %mi GL
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\rho \;\colon\; \mathbf{B}^{n-1}U(1) \longrightarrow GL_1(E)
              %p
                from the
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
                of
                %a.existingWikiWord{:href => "/nlab/show/phase+and+phase+space+in+physics"} phases
                to the
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-representation"} ∞-representation
                of the
                %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle n-group
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %p
                (playing the role of the canonical
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %msup
                        %mi ℂ
                        %mo ×
                    %annotation{:encoding => "application/x-tex"} U(1) \hookrightarrow \mathbb{C}^\times
                in plain
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
          %p
            Then for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⟶
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \longrightarrow \mathbf{B}^n U(1)
            modulating a
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⟶
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
