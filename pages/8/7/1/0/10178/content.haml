            %h6#proposition_4 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural equivalence
              (with the identification of prop.
              %a.maruku-ref{:href => "#DoldKan"}
              understood) of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi 𝕀
                      %mi X
                      %mrow
                        %mi H
                        %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma(\mathbb{I}_X^{H k})
                    \\simeq
                    C_\bullet(X,k)
                    \\,,
            %p
              between the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (H k)
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module"} (∞,1)-module
              of sections of the trivial
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (H k)
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module+bundle"} (∞,1)-module bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝕀
                      %mi X
                      %mrow
                        %mi H
                        %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{I}_X^{H k}
              and the
              %a.existingWikiWord{:href => "/nlab/show/singular+chain+complex"} singular chain complex
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              for ordinary homology with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          .proof
            %h6#proof Proof
            %p
              This is a classical basic (maybe
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/folklore"} folklore
            %p
              First notice that the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              of functors out of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
              and constant on the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} (H k)Mod
              is by definition the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-tensoring"} (∞,1)-tensoring
              operation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} (H k)Mod
              over
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} (H k)Mod
              by a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              the by the dicussion at
              %em
                %a{:href => "limit+in+a+quasi-category#ModelsForTensoring"} (∞,1)-colomit – Tensoring and cotensoring – Models
              this
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-tensoring"} (∞,1)-tensoring
              is given by the left
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              of the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
              in that simplicial model category.
            %p
              To obtain this, use prop.
              %a.maruku-ref{:href => "#DoldKan"}
              and then the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+chain+complexes"} model structure on chain complexes
              in the section
              %em
                %a{:href => "model%20structure%20on%20chain%20complexes#ProjectiveModelStructureOnUnboundedChainComplexes"} Projective model structure on unbounded chain complexes
              which says that there is a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              structure on the
              %a.existingWikiWord{:href => "/nlab/show/category+of+simplicial+objects"} category of simplicial objects
              in the
              %a.existingWikiWord{:href => "/nlab/show/category+of+unbounded+chain+complexes"} category of unbounded chain complexes
              which models
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mi qi
                      %msub
                        %mi Ch
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mi Mod
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L_{qi} Ch_\bullet(k Mod)
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              under the
              %a.existingWikiWord{:href => "/nlab/show/total+chain+complex"} total chain complex
              functor.
            %p
              In summary it follows that with any
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mi in
                    %msub
                      %mi L
                      %mi whe
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} (\Pi(X))_\bullet in L_{whe} sSet
              representing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X)
              (under the
              = succeed "-theorem)" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mo →
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi 𝕀
                      %mi X
                      %mrow
                        %mi H
                        %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ⋅
                    %mi 𝕀
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\to}{\lim} (\mathbb{I}_X^{H k})
                    \\simeq
                    \\int_{[n] \in \Delta}  (\Pi(X))_n \cdot \mathbb{I}
                    \\,,
            %p
              where on the right we have the
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              over the
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              of the
              %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
              (of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              with
              %a.existingWikiWord{:href => "/nlab/show/simplicial+objects"} simplicial objects
              in the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/category+of+unbounded+chain+complexes"} category of unbounded chain complexes
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            %p
              The result on the right is manifestly, by the very definition of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/chain+complex+of+singular+simplices"} chain complex of singular simplices
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ⋅
                    %mi 𝕀
                    %mo ≃
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi k
                    %mo ≃
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{[n] \in \Delta}  (\Pi(X))_n \cdot \mathbb{I}
                    \\simeq
                    \\Pi(X) \otimes k
                    \\simeq
                    C_\bullet(X,k)
                    \\,.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi L
                      %mi whe
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} X \in L_{whe} Top
              is a
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality+space"} Poincaré duality space
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi 𝕀
                      %mi X
                      %mrow
                        %mi H
                        %mi A
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \Gamma(\mathbb{I}_X^{H A}) \in (H A) Mod
              is a
              %a.existingWikiWord{:href => "/nlab/show/dualizable+object"} dualizable object
              which is almost self-dual except for a degree
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twist
              of (itself) degree 0:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mo (
                        %mi Γ
                        %mrow
                          %mo (
                          %msubsup
                            %mi 𝕀
                            %mi X
                            %mrow
                              %mi H
                              %mi A
                          %mo )
                        %mo )
                      %mo ∨
                    %mo ≃
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi n
                    %mrow
                      %mo (
                      %mi Γ
                      %mrow
                        %mo (
                        %msubsup
                          %mi 𝕀
                          %mi X
                          %mrow
                            %mi H
                            %mi A
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\Gamma\left(\mathbb{I}_X^{H A}\right)
                    \\right)^\vee
                    \\simeq
                    \\Sigma^{-n}
                    \\left(
                    \\Gamma\left(\mathbb{I}_X^{H A}\right)
                    \\right)
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              Under the identifications of prop.
              %a.maruku-ref{:href => "#DoldKan"}
              and prop.
              %a.maruku-ref{:href => "#SectionsOfTrivialKABundleIsAHomology"}
              this is the theorem discussed at
              %em
                %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality"} Poincaré duality
              in the section
              = succeed "." do
                %em
                  %a{:href => "Poincar%C3%A9+duality#RefinementInHomotopyTheory"} Poincaré duality – Refinement to homotopy theory
          %p
            See also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Dold-Thom+theorem"} Dold-Thom theorem
          %h3#dimension_2__pullpush_over__and_theory_indices
            Dimension 2 – Pull-push over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KU
                %annotation{:encoding => "application/x-tex"} KU
            and
            = succeed "-theory" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %h4#KTheoryOfSmoothGroupoids K-theory of smooth groupoids / stacks
          %p
            We discuss here aspects of “smooth” (not yet
            = succeed "!)" do
              %a.existingWikiWord{:href => "/nlab/show/differential+K-theory"} differential
            %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
            to
            %a.existingWikiWord{:href => "/nlab/show/smooth+groupoids"} smooth groupoids
            (a generalization of
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KU
                  %mo ∈
                  %mi CRing
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  KU \in CRing(\infty Grpd)
          %p
            for the periodic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+K-theory+spectrum"} complex K-theory spectrum
          #SnaithTheorem.num_prop
            %h6#proposition_6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/complex+K-theory+spectrum"} complex K-theory spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KU
                  %annotation{:encoding => "application/x-tex"} KU
              is the localization of the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+%E2%88%9E-ring"} ∞-group ∞-ring
              of the
              %a.existingWikiWord{:href => "/nlab/show/circle+2-group"} circle 2-group
              at the
              %a.existingWikiWord{:href => "/nlab/show/Bott+element"} Bott element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KU
                    %mo ≃
                    %mi 𝕊
                    %mo{:stretchy => "false"} [
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    KU \simeq \mathbb{S}[B U(1)][\beta^{-1}]
                    \\,.
          %p
            This is
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Snaith%27s+theorem"} Snaith's theorem
          .num_prop
            %h6#proposition_7 Proposition
            %p There is a canonical map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi KU
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    B^2 U(1) \to B GL_1(KU)
                    \\,.
          %p
            This is observed in (
            %a{:href => "#Nuiten13"}> Nuiten 13, section 3
            ).
          .proof
            %h6#proof_3 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mo{:stretchy => "false"} [
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi 𝕊
                    %mo{:stretchy => "false"} [
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}[B U(1)] \to \mathbb{S}[B U(1)][\beta^{-1}]
            %p
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CRing
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CRing(\infty Grpd)
              has by prop.
              %a.maruku-ref{:href => "#GroupOfUnitsAdjunction"}
              an
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} [
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    B U(1) \to GL_1(\mathbb{S}[B U(1)][\beta^{-1}])
            %p
              in
              = succeed "." do
