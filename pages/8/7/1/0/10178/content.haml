                              %mi χ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi 𝔾
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathbf{Field}^{\partial}
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  \\ast &amp;&amp; \swArrow_{\xi} &amp;&amp; \mathbf{Fields}
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow_{\mathrlap{\chi}}
                  \\\
                  \&amp;&amp; \mathbb{G}
                  }
                  \\,.
          %p
            This is the local incarnation of the corresponding
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/boundary+condition"}> boundary condition
                \/
                %a.existingWikiWord{:href => "/nlab/show/brane"} brane
          %p Or if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi def
                  %mo ≔
                  %mrow
                    %mo {
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ∅
                            %mtd
                              %mover
                                %mo →
                                %mrow
                            %mtd
                              %mi ∅
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mo ∂
                                      %mn 1
