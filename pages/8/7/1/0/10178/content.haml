            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
            %a.existingWikiWord{:href => "/nlab/show/orientations+in+generalized+cohomology"} orientations in generalized cohomology
            that go along with defining a boundary component for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
