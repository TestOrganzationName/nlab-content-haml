          %p
            The actual
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            %a.existingWikiWord{:href => "/nlab/show/path+integral+as+a+pull-push+transform"} path integral as a pull-push transform
            map now consists in forming a
            %a.existingWikiWord{:href => "/nlab/show/dual+morphism"} dual morphism
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mi Mod
