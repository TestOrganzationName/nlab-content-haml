                      %mo )
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  def \coloneqq
                  \\left\{
                  \\left(
                  \\array{
                  \\emptyset &amp;\stackrel{}{\to}&amp; \emptyset
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{\mathrlap{\partial_1}}
                  \\\
                  \\emptyset &amp;\stackrel{\partial_2}{\to}&amp; \ast
                  }
                  \\right)
                  \\right\}
          %p
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bord
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi def
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Bord_n(def)
            consists of cobordisms with two different boundary (
            %a.existingWikiWord{:href => "/nlab/show/brane"}> brane
            ) types and a
            %a.existingWikiWord{:href => "/nlab/show/defect+QFT"} defect
            where they meet.
          %h3#BivariantCohomologyAndTheSuperpositionPrinciple
            %strong 2.)
            Bivariant cohomology and the superposition principle
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_1(E)
            for its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            the ambient
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi GL
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}GL_1(E)}
            for the
            %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
            over the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of this
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+%E2%88%9E-group"} abelian ∞-group
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
            equipped with
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module+bundle"} (∞,1)-line bundles
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Γ
                    %mo *
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi GL
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                  %mo →
                  %mi E
                  %mi Mod
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma^\ast \;\colon \; \mathbf{H}_{/\mathbf{B}GL_1(E)} \to E Mod
          %p
            to the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-modules"} (∞,1)-category of (∞,1)-modules
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module+bundles"} (∞,1)-module bundles
            (generalized
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectra"} Thom spectra
          %p
            This is well understood for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            in which case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ≃
                  %munder
                    %mi lim
                    %mo →
                  %mo ∘
                  %mi i
                %annotation{:encoding => "application/x-tex"} \Gamma \simeq \underset{\to}{\lim} \circ i
            is the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} homotopy colimits
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} E Mod
            under the canonical embedding
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
