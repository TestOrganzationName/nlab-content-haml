                        %msub
                          %mi X
                          %mn 2
                        %mo =
                        %mo *
                      %annotation{:encoding => "application/x-tex"} X_2 = \ast
                  the point, the above bivariant cohomology is the
                  = succeed "-twisted" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
