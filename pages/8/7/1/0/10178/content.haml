                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                a map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mrow
                          %mo •
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mi χ
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E_{\bullet + \chi}(X) \to E
                is a
                %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
                in
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
