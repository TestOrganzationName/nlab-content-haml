                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; Q
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow^{\mathrlap{i}}
                  \\\
                  \\ast &amp;&amp; \swArrow_{\xi} &amp;&amp; X
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow_{\mathrlap{\chi}}
                  \\\
                  \&amp;&amp; \mathbf{B}^2 U(1)
                  }
                  \\,.
          %p
            Here now the twisted
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
            %a.existingWikiWord{:href => "/nlab/show/index"} index
            map comes out as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ind
                    %mi i
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi KU
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %msup
                        %mi i
                        %mo *
                      %mi χ
                      %mo −
                      %msub
                        %mi W
                        %mn 3
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi N
                        %mi i
                      %mi Q
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mi KU
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi χ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  ind_i
                  \\;\colon\;
                  KU^{\bullet + i^\ast \chi - W_3(N_i Q)}(Q)
                  \\longrightarrow
                  KU^{\bullet + \chi}(X)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi N
                    %mi i
                  %mi Q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W_3(N_i Q)
            is the third
            %a.existingWikiWord{:href => "/nlab/show/integral+Stiefel-Whitney+class"} integral Stiefel-Whitney class
            of the
            %a.existingWikiWord{:href => "/nlab/show/normal+bundle"} normal bundle
            of the
            %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %a.existingWikiWord{:href => "/nlab/show/quantum+propagator"} quantum propagator
            this sends the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mi χ
                    %mo −
                    %msub
                      %mi W
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mi i
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i^\ast \chi - W_3(N_i Q)
            %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            of the D-brane to the
            = succeed "-twisted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} \chi
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
          %ul
            %li
              %p
                the condition that the domain are
                %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+fields"} Chan-Paton gauge fields
                in
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi i
                          %mo *
                        %mi χ
                        %mo −
                        %msub
                          %mi W
                          %mn 3
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mi i
                        %mi Q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} i^\ast \chi - W_3(N_i Q)
                %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
                is the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Freed-Witten-Kapustin+anomaly"} Freed-Witten-Kapustin anomaly
                cancellation condition;
            %li
              %p
                the image of this higher
                %a.existingWikiWord{:href => "/nlab/show/quantum+propagator"} quantum propagator
                is the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/D-brane+charge"} D-brane charge
          %p
            Notice that by the above analogous discussion of the
            %a.existingWikiWord{:href => "/nlab/show/2d+Chern-Simons+theory"} 2d Chern-Simons theory
            we have the slogan:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/D-brane+charge"} D-brane charge
              \=
              %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
              of
              %a.existingWikiWord{:href => "/nlab/show/charged+particle"} charged particle
              at the end of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+string"} open string
          %p
            In view of this state of affairs one is to go up in dimension and quantize a 2-dimensional field theory, namely the
            %a.existingWikiWord{:href => "/nlab/show/string"} string
            %a.existingWikiWord{:href => "/nlab/show/sigma+model"} sigma model
            itself, once we canonically realize it as the boundary of a 3-dimensional field theory which is equipped with a suitable
            = succeed "-linearization." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            A natural example for this is the
            %a.existingWikiWord{:href => "/nlab/show/heterotic+string"} heterotic string
            %a.existingWikiWord{:href => "/nlab/show/sigma+model"} sigma model
            on the boundary of the
            %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            in the
            %a.existingWikiWord{:href => "/nlab/show/M9-brane"} M9-brane
            inside the
            %a.existingWikiWord{:href => "/nlab/show/Ho%C5%99ava-Witten+theory"} Hořava-Witten theory
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            = succeed "." do
              %a{:href => "#HeteroticStringAtBoundaryOfMembrane"} below
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            is now the
            %a.existingWikiWord{:href => "/nlab/show/higher+prequantum+bundle"} higher prequantum bundle
            and is naturally turned into a
            %a.existingWikiWord{:href => "/nlab/show/higher+prequantum+line+bundle"} higher prequantum E-line bundle
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                %annotation{:encoding => "application/x-tex"} E =
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
          %p
            The corresponding
            %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            now is the
            %a.existingWikiWord{:href => "/nlab/show/string%5Ec+structure"} string^c structure
            induced by the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            which is naturally implied by the flux quantization condition in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            %a.existingWikiWord{:href => "/nlab/show/M9-brane"} M9-brane
            this induces the
            %a.existingWikiWord{:href => "/nlab/show/twisted+differential+string+structure"} twisted differential string structure
            which is the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+anomaly"} Green-Schwarz anomaly
            cancellation condition in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
            %a.existingWikiWord{:href => "/nlab/show/index"} index
            now is in (twisted)
            %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            the (twisted)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Witten+genus"} Witten genus
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
            %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
            of the
            %a.existingWikiWord{:href => "/nlab/show/heterotic+string"} heterotic string
            2d
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
          %p
            In this fashion one can now in principle climb higher up the dimensional ladder and quantize ever higher dimensional field theories, for instance by
            = succeed "-linearizing" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            a
            %a.existingWikiWord{:href => "/nlab/show/Morava+K-theory"} Morava K-theory
            (and hence after generalizing the formalism to
            = succeed "\u2026)" do
              %a.existingWikiWord{:href => "/nlab/show/A-infinity+rings"} A-infinity rings
          %p
            (Next interesting along these lines might be the holographic motivic quantization analogously of the
            %a.existingWikiWord{:href => "/nlab/show/Yang+monopole"} Yang monopole
            at the boundary of the
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            ending on the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/M9-brane"} M9-brane
          %p
            The earliest and by far best understood example of the
            %a.existingWikiWord{:href => "/nlab/show/holographic+principle"} holographic principle
            is the
            %a.existingWikiWord{:href => "/nlab/show/AdS3-CFT2+and+CS-WZW+correspondence"} AdS3-CFT2 and CS-WZW correspondence
            between the
            %a.existingWikiWord{:href => "/nlab/show/WZW+model"} WZW model
            on a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and 3d
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
          %p
            In (
            %a{:href => "7d+Chern-Simons+theory#Witten98"}> Witten 98
            ) it is argued that all examples of the
            %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+duality"} AdS-CFT duality
            are governed by the
            %a.existingWikiWord{:href => "/schreiber/show/infinity-Chern-Simons+theory"} higher Chern-Simons theory
            terms on the gravity side, hence that the corresponding conformal theories are higher analogs of the WZW model:
            = succeed "-type" do
              %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Wess-Zumino-Witten+theory"} ∞-Wess-Zumino-Witten theory
          %p
            In particular for
            %a.existingWikiWord{:href => "/nlab/show/AdS7-CFT6"} AdS7-CFT6
            this means that the
            %a.existingWikiWord{:href => "/nlab/show/6d+%282%2C0%29-superconformal+QFT"} 6d (2,0)-superconformal QFT
            on the
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            should be a 6d-dimensional WZW model holographically related to the
            %a.existingWikiWord{:href => "/nlab/show/7d+Chern-Simons+theory"} 7d Chern-Simons theory
            which appears when
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            is
            %a.existingWikiWord{:href => "/nlab/show/KK-reduction"} KK-reduced
            on a 4-
            %a.existingWikiWord{:href => "/nlab/show/sphere"}> sphere
            \:
          %table
            %thead
              %tr
                %th
                  %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ←
                      %annotation{:encoding => "application/x-tex"} \leftarrow
                  %a.existingWikiWord{:href => "/nlab/show/holographic+principle"} holographic principle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo →
                      %annotation{:encoding => "application/x-tex"} \rightarrow
                %th
                  %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Wess-Zumino-Witten+theory"} ∞-Wess-Zumino-Witten theory
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  3d
                  %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  2d
                  %a.existingWikiWord{:href => "/nlab/show/Wess-Zumino-Witten+model"} Wess-Zumino-Witten model
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/7d+Chern-Simons+theory"} 7d Chern-Simons theory
                  from
                  %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/6d+%282%2C0%29-superconformal+QFT"} 6d (2,0)-superconformal QFT
                  on
                  %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
          %p
            In (
            %a{:href => "http://ncatlab.org/nlab/show/7d+Chern-Simons+theory#WittenI"}> Witten 96
            ) this is argued, by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
            %em bosonic and abelian
            contribution in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/7d+Chern-Simons+theory"} 7d Chern-Simons theory
            %a.existingWikiWord{:href => "/nlab/show/theta+characteristic"} theta characteristic
            involved was later formalized in
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Quadratic+Functions+in+Geometry%2C+Topology%2C+and+M-Theory"} Hopkins-Singer 02
          %p
            In (
            %a{:href => "#FSS12a"}> Fiorenza-Sati-Schreiber 12a
            ,
            = succeed ")" do
              %a{:href => "#FSS12b"} Fiorenza-Sati-Schreiber 12b
            %em non-abelian
            quantum correction to the
            %a.existingWikiWord{:href => "/nlab/show/7d+Chern-Simons+theory"} 7d Chern-Simons theory
            induced by 11d Sugra is considered, and refined to a
            %a.existingWikiWord{:href => "/nlab/show/local+action+functional"} local action functional
            along the lines considered here. Therefore by (
            %a{:href => "#Witten98"}> Witten 98
            ) the corresponding
            %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Wess-Zumino-Witten+theory"} ∞-Wess-Zumino-Witten theory
            should be the bosonic and nonabelian part of the
            %a.existingWikiWord{:href => "/nlab/show/6d+%282%2C0%29-superconformal+QFT"} 6d (2,0)-superconformal QFT
            on the
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
          %p
            To see this, what one needs is evidently a general formalization of
            %a.existingWikiWord{:href => "/nlab/show/holography"} holography
            for
            %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum field theory
            as these. How are
            = succeed "-models" do
              %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Wess-Zumino-Witten+theory"} ∞-Wess-Zumino-Witten theory
            = succeed "?" do
              %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
          %p
            At the level of
            %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum field theory
            this is answered in (
            %a{:href => "#FiorenzaSatiSchreiber13"}> Fiorenza-Sati-Schreiber 13
            ):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi 𝔤
                  %mo ⟶
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mu \;\colon\; \mathfrak{g} \longrightarrow \mathbb{R}[n]
          %p
            be a
            %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"} super L-∞ algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+cocycle"} L-∞ cocycle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi c
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ⟶
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi Γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{c} \;\colon\; \mathbf{B}G \longrightarrow \mathbf{B}^{n+1}(\mathbb{R}/\Gamma)
          %p
            be its
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+super+%E2%88%9E-groupoids"} smooth super ∞-groupoids
            = succeed ")." do
              %a{:href => "#FiorenzaSchreiberStasheff10"} Fiorenza-Schreiber-Stasheff 10
          %p
            Observe that the
            %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-group"} smooth ∞-group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            has, by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
            %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi G
                  %mo ⟶
                  %msub
                    %mo ♭
                    %mi dR
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\theta \;\colon \; G \longrightarrow \flat_{dR}\mathbf{B}G
                  \\,.
          %p
            This is a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in the nonabelian de Rham
            %a.existingWikiWord{:href => "/nlab/show/hypercohomology"} hypercohomology
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Wess-Zumino-Witten+theory"} ∞-Wess-Zumino-Witten theory
            model with a
            %em globally defined
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            = succeed "-form." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            %a.existingWikiWord{:href => "/nlab/show/universal+construction"} universal
            solution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde G
            of making
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \theta
            globally well defined, hence the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mi G
                            %mo{:stretchy => "false"} ˜
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi θ
                                %mi global
                        %mtd
                          %msub
                            %mi Ω
                            %mi flat
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi G
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi θ
                                %mi G
                        %mtd
                          %msub
