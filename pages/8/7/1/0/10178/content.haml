                  )
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/cobordism+hypothesis"} cobordism hypothesis
            provides a good characterization of the space of
            %em all
            such
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
