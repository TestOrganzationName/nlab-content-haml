                  }
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-groups"} automorphism ∞-groups
            in this
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            of
            %a.existingWikiWord{:href => "/nlab/show/local+action+functionals"} local action functionals
            are precisely the
            %a.existingWikiWord{:href => "/nlab/show/quantomorphism+%E2%88%9E-groups"} quantomorphism ∞-groups
            (infinitesimally the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+L-%E2%88%9E+algebras"} Poisson L-∞ algebras
            %a.existingWikiWord{:href => "/nlab/show/Heisenberg+%E2%88%9E-groups"} Heisenberg ∞-groups
            (infinitesimally the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Heisenberg+L-%E2%88%9E+algebras"} Heisenberg L-∞ algebras
            %a.existingWikiWord{:href => "/nlab/show/prequantum+observables"} prequantum observables
            (
            %a{:href => "FiorenzaRogersSchreiber13a"}> Fiorenza-Rogers-Schreiber 13a
            ). Equivalently, they are
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/conserved+currents"} conserved currents
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Corr
                    %mi n
                  %mrow
                    %mo (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
