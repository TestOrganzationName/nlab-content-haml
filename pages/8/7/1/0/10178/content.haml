                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi tmf
                          %mi Mod
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; Q
