                    %mo ⊗
                  %mo →
                  %msup
                    %mi 𝒞
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"} Z \colon Bord_n(def)^\otimes \to \mathcal{C}^\otimes
            a topological
            %a.existingWikiWord{:href => "/nlab/show/local+field+theory"} local field theory
            which includes a boundary condition encoded by a generator
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ∅
