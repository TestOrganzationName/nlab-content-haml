                %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology"} generalized cohomology
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %p Hence we write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mrow
                          %mo •
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mi χ
                      %mrow
                        %mo (
                        %mi X
                        %mo )
                      %mo ≔
                      %mrow
                        %mo [
                        %msub
                          %mi E
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mi χ
                        %mrow
