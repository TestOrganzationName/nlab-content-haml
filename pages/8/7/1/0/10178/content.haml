            %h6#proof_5 Proof
            %p
              The canonical
              %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
