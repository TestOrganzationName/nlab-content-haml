            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %mo ←
                  %mi Q
                  %mo →
                  %msub
                    %mi X
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  X_1 \leftarrow Q \rightarrow X_2
          %p
            and
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            is given by
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-fiber+product"} (∞,1)-fiber product
            of such diagrams.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is equipped with the stucture of a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2C1%29-category"} monoidal (∞,1)-category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Corr
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Corr(\mathcal{C})
            naturally inherits a monoidal structure, too, given by the objectwise
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            Notice that even if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mo ×
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \times)
            is a
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+%28%E2%88%9E%2C1%29-category"} cartesian monoidal (∞,1)-category
            then the induced monoidal structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Corr
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo ⊗
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Corr(\mathcal{C}), \otimes)
            is
            %em not
            cartesian. Notice also that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mo ⊗
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes)
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} symmetric monoidal
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Corr
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Corr(\mathcal{C})
          %p
            In the following we consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Corr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi 𝔾
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Corr(\mathbf{H}_{/\mathbb{G}})
            always equipped with the
            %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2C1%29-category"} monoidal (∞,1)-category
            structure which is induced by the non-cartesian tensor monoidal structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊗
                    %mi 𝔾
                %annotation{:encoding => "application/x-tex"} \otimes_{\mathbb{G}}
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi 𝔾
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbb{G}}
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒞
                    %mrow
                      %msup
                        %mo □
                        %mi n
                %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\Box^n}
            for the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/cube"} cube
            %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
            of diagrams this is naturally an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category"} (∞,n)-category
          %p We write for short
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Corr
                    %mi n
                  %mrow
                    %mo (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi 𝔾
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi Corr
                  %msup
                    %mrow
                      %mo (
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi 𝔾
                      %mo )
                    %mrow
                      %msup
                        %mo □
                        %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Corr_n\left(\mathbf{H}_{/\mathbb{G}}\right)
                  \\;\coloneqq\;
                  Corr\left(\mathbf{H}_{/\mathbb{G}}\right)^{\Box^n}
                  \\,.
          %p
            This is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,n)-category
          %h3#CorrespondencesAndLocalPrequantumFieldTheory
            %strong 1.)
            Correspondences and local prequantum field theory
          #GroupOfUnitsAdjunction.num_prop
            %h6#proposition Proposition
            %p
              There is a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functors"} adjoint (∞,1)-functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CRing
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi GL
                            %mn 1
                      %mover
                        %mo ←
                        %mrow
                          %mi 𝕊
                          %mo{:stretchy => "false"} [
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} ]
                    %mi AbGrp
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CRing(\mathbf{H})
                    \\stackrel{\overset{\mathbb{S}[-]}{\leftarrow}}{\underset{\mathbf{GL}_1}{\to}}
                    AbGrp(\mathbf{H})
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{GL}_1(-)
              forms the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
              (see there) of an
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              object.
          %p Choose now once and for all
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi E
                      %mo ∈
                      %mi CRing
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E \in CRing(\mathbf{H})
                \.
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bord
                    %mi n
                  %mo ≔
                  %msub
                    %mi Bord
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %mo *
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Bord_n \coloneqq Bord_n(\{\ast\})
            for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+of+cobordisms"} (∞,n)-category of framed cobordisms
          %p
            By (
            %a{:href => "#lpqft"}> Nuiten-Schreiber 13
            ), following (
            %a{:href => "#Schreiber08"}> Schreiber 08
            ,
            = succeed ")" do
              %a{:href => "#FreedHopkinsLurieTeleman09"} Freed-Hopkins-Lurie-Teleman 09, section 3
          %ul
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} physical field
                of a
                %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum field theory
                of
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                is a
                %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2Cn%29-functor"} monoidal (∞,n)-functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Fields
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi Bord
                        %mi n
                        %mo ⊗
                      %mo →
                      %msub
                        %mi Corr
                        %mi n
                      %msup
                        %mrow
                          %mo (
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo )
                        %mo ⊗
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{Fields} \;\colon \; Bord_n^\otimes \to Corr_n\left(\mathbf{H}\right)^\otimes
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum field theory
                of
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                with field content
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Fields
                    %annotation{:encoding => "application/x-tex"} \mathbf{Fields}
                and with
                %em
                  %a.existingWikiWord{:href => "/nlab/show/phase+and+phase+space+in+physics"} phases
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi GL
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{GL}_1(E)
                is a lift
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exp(i S)
                in the
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi Corr
                                %mi n
                              %msup
                                %mrow
                                  %mo (
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi H
                                    %mrow
                                      %mo{:stretchy => "false"} /
                                      %mstyle{:mathvariant => "bold"}
                                        %mi B
                                      %msub
                                        %mstyle{:mathvariant => "bold"}
                                          %mi GL
                                        %mn 1
                                      %mrow
                                        %mo (
                                        %mi E
                                        %mo )
                                  %mo )
                                %mo ⊗
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mrow
                                  %mi exp
                                  %mo{:stretchy => "false"} (
                                  %mi i
                                  %mi S
                                  %mo{:stretchy => "false"} )
                              %mo ↗
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %msubsup
                                %mi Bord
                                %mi n
                                %mo ⊗
                            %mtd
                              %mover
                                %mo →
                                %mstyle{:mathvariant => "bold"}
                                  %mi Fields
                            %mtd
                              %msub
                                %mi Corr
                                %mi n
                              %msup
                                %mrow
                                  %mo (
                                  %mstyle{:mathvariant => "bold"}
                                    %mi H
                                  %mo )
                                %mo ⊗
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; Corr_n\left(\mathbf{H}_{/\mathbf{B}\mathbf{GL}_1\left(E\right)}\right)^\otimes
                      \\\
                      \&amp; {}^{\exp(i S)}\nearrow \;\;\;\;\; &amp; \downarrow
                      \\\
                      Bord_n^\otimes &amp;\stackrel{\mathbf{Fields}}{\to}&amp; Corr_n\left(\mathbf{H}\right)^\otimes
                      }
                      \\,.
          %p
            More generally, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi def
                %annotation{:encoding => "application/x-tex"} def
            be a set of
            %a.existingWikiWord{:href => "/nlab/show/defect+QFT"} defect
            data, hence a set of shapes of cells. Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bord
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi def
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Bord_n(def)
            for the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+of+cobordisms"} (∞,n)-category of cobordisms
            with this defect structure, hence, by the
            %a.existingWikiWord{:href => "/nlab/show/cobordism+hypothesis"} cobordism hypothesis
            theorem, the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,n)-category
            with all
            %a.existingWikiWord{:href => "/nlab/show/fully+dualizable+objects"} fully dualizable objects
            freely generated on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi def
                  %annotation{:encoding => "application/x-tex"} def
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-categories"} symmetric monoidal (∞,n)-categories
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi Corr
                            %mi n
                          %msup
                            %mrow
                              %mo (
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi H
                                %mrow
                                  %mo{:stretchy => "false"} /
                                  %mstyle{:mathvariant => "bold"}
                                    %mi B
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi GL
                                    %mn 1
                                  %mrow
                                    %mo (
                                    %mi E
                                    %mo )
                              %mo )
                            %mo ⊗
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mrow
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mi i
                              %mi S
                              %mo{:stretchy => "false"} )
                          %mo ↗
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi Bord
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi def
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                        %mtd
                          %mover
                            %mo →
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                        %mtd
                          %msub
                            %mi Corr
                            %mi n
                          %msup
                            %mrow
                              %mo (
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mo )
                            %mo ⊗
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; Corr_n\left(\mathbf{H}_{/\mathbf{B}\mathbf{GL}_1\left(E\right)}\right)^\otimes
                  \\\
                  \&amp; {}^{\exp(i S)}\nearrow \;\;\;\;\; &amp; \downarrow
                  \\\
                  Bord_n(def)^\otimes &amp;\stackrel{\mathbf{Fields}}{\to}&amp; Corr_n\left(\mathbf{H}\right)^\otimes
                  }
          %p
            is a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary
            %a.existingWikiWord{:href => "/nlab/show/defect+QFT"} defect
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum field theory
          %p For instance for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi def
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi ∅
                  %mover
                    %mo →
                    %mo ∂
                  %mo *
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  def \coloneqq \{ \emptyset \stackrel{\partial}{\to} \ast \}
          %p
            such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(i S)
            is equivalently the choice of a
            %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Field
                            %mo ∂
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                        %mtd
                          %msub
                            %mo ⇙
                            %mi ξ
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi Fields
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
