              %p
                This is to be called the
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
                %a.existingWikiWord{:href => "/nlab/show/local+action+functional"} local action functional
                for the
                %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
                3d
                %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
                field theory with
                %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                Write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Q \hookrightarrow X
                for the inclusion of the locus of
                = succeed "-fixed" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "\u201D" do
                  %a.existingWikiWord{:href => "/nlab/show/M9-brane"} M9-brane
                %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
                or equivalently the
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                of
                %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
                in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Ho%C5%99ava-Witten+theory"} Hořava-Witten theory
            %li
              %p
                This data is required to constitute a
                %a.existingWikiWord{:href => "/nlab/show/higher+orientifold"} higher orientifold
                structure on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                which means in particular that there is a trivialization
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi χ
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi Q
                      %mo ≃
                      %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\xi \;\colon\; \chi|_Q \simeq 0
              %p
                of the restriction of the background field to the
                = succeed "-fixed" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi p
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mn 2
                      %mstyle{:mathvariant => "bold"}
                        %mi a
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi Q
                      %mo ≃
                      %mn 0
                    %annotation{:encoding => "application/x-tex"}
