                %annotation{:encoding => "application/x-tex"} \mathcal{O}_\lambda
            as its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/brane"} brane
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo ←
                        %mtd
                          %mo *
                        %mtd
