                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E \to E_{\bullet + \chi}(X)
                is a
                %a.existingWikiWord{:href => "/nlab/show/cycle"} cycle
                in
                = succeed "-" do
