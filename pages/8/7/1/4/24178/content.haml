                  \\big)
                  \\,.
          %p
            That the
            %a.existingWikiWord{:href => "/nlab/show/Pfaffian"} Pfaffian
            of the (inverse) distance matrix is indeed skew-symmetric is readily seen in its
            = succeed "-formulation" do
              %a.existingWikiWord{:href => "/nlab/show/Berezinian+integral"} Berezinian integral
            = succeed ")." do
              %a{:href => "Pfaffian#InTermOfBerezinianIntegrals"} there
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            between the Laughlin and the Moore-Read wavefunctions:
          %h3#SupersymmetryBetweenLaughlinAndMooreReadStates Supersymmetry between Laughlin- and Moore&amp;Read-wavefunctions
          %p
            Consider the
            %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
            (“
            %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} Cartesian
            = succeed "\u201D)" do
              %a.existingWikiWord{:href => "/nlab/show/superspace"} superspace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℂ
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{C}^{1 \vert 1}
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
            = succeed "-coordinates" do
              %em super
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo ,
                    %mi θ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (z,\theta)
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+group"} super Lie group
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+translation+group"} super translation group
            = succeed "):" do
              %a{:href => "super-translation+group#eq:GroupLawIn1D"} there
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi z
                    %mi i
                  %mo ,
                  %msub
                    %mi θ
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi z
                    %mi j
                  %mo ,
                  %msub
                    %mi θ
                    %mi j
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi z
                    %mi i
                  %mo +
                  %msub
                    %mi z
                    %mi j
                  %mo +
                  %msub
                    %mi θ
                    %mi i
                  %msub
                    %mi θ
                    %mi i
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi θ
                    %mi i
                  %mo +
                  %msub
                    %mi θ
                    %mi j
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo ,
                  %mi θ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi z
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi θ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (z_i, \theta_i)
                  +
                  (z_j, \theta_j)
                  \\;=\;
                  \\big(
                  z_i + z_j + \theta_i \theta_i
                  ,\,
                  \\theta_i + \theta_j
                  \\big)
                  \\,,
                  \\;\;\;\;
                  \-(z, \theta) = (-z, -\theta)
                  \\,.
          %p
            Via this super-translation structure, the basic Laughlin state
            %a.maruku-eqref{:href => "#eq:BasicLaughlinState"} (1)
            lifts to
            %a.existingWikiWord{:href => "/nlab/show/superspace"} superspace
            as
          #eq:BasciSuperLaughlinWavefunction.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
