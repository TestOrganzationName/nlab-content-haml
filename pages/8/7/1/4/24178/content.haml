              (which is manifest in the
              = succeed "," do
                %a{:href => "Pfaffian#InTermOfBerezinianIntegrals"} Berezinian presentation
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
