          .num_prop
            %h6#proposition_5 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a sequential spectrum, then (using remark
              %a.maruku-ref{:href => "#ShiftingCommutesWithLoopingAndSuspensionOfSequentialSpectra"}
              to suppress parenthesis)
            %ol
              %li
                %p the structure maps constitute a homomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                        %mi X
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ⟶
                        %mi X
                      %annotation{:encoding => "application/x-tex"}
                        \\Sigma X[-1]
                        \\longrightarrow
                        X
                %p and this is a stable equivalence.
              %li
                %p the adjunct structure maps constitute a homomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ⟶
                        %mi Ω
                        %mi X
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        X
                        \\longrightarrow
                        \\Omega X[1]
                        \\,.
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
