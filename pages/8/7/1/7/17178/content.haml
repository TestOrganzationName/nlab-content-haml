          .proof
            %h6#proof Proof
            %p
              That the limits and colimits exist and are computed objectwise follows via prop.
              %a.maruku-ref{:href => "#SequentialSpectraAsDiagramSpectra"}
              from the general statement for categories of topological functors (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopologicallyEnrichedCopresheavesHaveAllLimitsAndColimits"}> prop.
              ). But it is also immediate to directly check the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
          #WedgeSumOfSpectra.num_example
            %h6#example_2 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              of
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                      %mo ∈
                      %mi SeqSpec
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi cg
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X, Y \in SeqSpec(Top_{cg})
              %strong wedge sum of spectra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∨
                    %mi Y
                    %mo ≔
                    %mi X
                    %mo ⊔
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    X \vee Y
                    \\coloneqq
                    X \sqcup Y
            %p
              is componentwise the
              %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
              of pointed topological spaces (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#WedgeSumAsCoproduct"}> exmpl.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∨
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %msub
                      %mi X
                      %mi n
                    %mo ∨
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    (X \vee Y)_n
                    \=
                    X_n \vee Y_n
            %p with structure maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi σ
                      %mi n
                      %mrow
                        %mi X
                        %mo ∨
                        %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
