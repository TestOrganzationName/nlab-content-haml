          #SmashProductOfSpectrumWithSimplicialSet.num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
