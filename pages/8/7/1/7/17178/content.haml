            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %msub
                      %mi K
                      %mo +
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo ∧
                    %msub
                      %mi K
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (X \wedge K_+)_n \coloneqq (X_n \wedge K_+)
            %p And whose structure maps are given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
