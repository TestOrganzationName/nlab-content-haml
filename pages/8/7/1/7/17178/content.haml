                        %mo ∧
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} S^1 \wedge(-)
                  preserves all colimits, since it is a
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  by prop.
                  = succeed ";" do
