          #QuillenEquivalenceBetweenSequentialBFAndExcisiveFunctors.num_prop
            %h6#proposition_7 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ι
                      %mo *
                    %mo ⊣
                    %msup
                      %mi ι
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi sSet
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Ly
                    %mover
                      %munder
                        %mo ⟶
                        %mrow
                          %msup
                            %mi ι
                            %mo *
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi ι
                            %mo *
                    %mo{:stretchy => "false"} [
                    %mi StdSpheres
                    %mo ,
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi seq
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi BF
                  %annotation{:encoding => "application/x-tex"}
                    (\iota_\ast \dashv \iota^\ast)
                    \\;\colon\;
                    [sSet^{\ast/}_{fin}, sSet^{\ast/}]_{Ly}
                    \\stackrel{\overset{\iota_\ast}{\longleftarrow}}{\underset{\iota^\ast}{\longrightarrow}}
                    [StdSpheres, sSet^{\ast/}]
                    \\underoverset{\simeq}{(-)^{seq}}{\longrightarrow}
                    SeqSpec(sSet)_{BF}
            %p
              (given by restriction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ι
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \iota^\ast
              along the defining inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
