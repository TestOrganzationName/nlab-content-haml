                    \\;\colon\;
                    [StdSpheres,sSet^{\ast/}]
                    \\longrightarrow
                    SeqSpec(sSet)
            %p
              (from the category of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi sSet
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} sSet^{\ast/}
              %a.existingWikiWord{:href => "/nlab/show/enriched+presheaves"} enriched copresheaves
              on the categories of standard simplicial spheres of def.
              %a.maruku-ref{:href => "#CategoriesOfStandardSpheres"}
              to the category of
              %a.existingWikiWord{:href => "/nlab/show/sequential+prespectra"} sequential prespectra
              in
