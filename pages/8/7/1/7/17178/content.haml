                                    %mo −
                                    %mn 1
                          %mtd
                            %msub
                              %mi X
                              %mi n
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi S
                                    %mn 1
                                  %mo ∧
                                  %msub
                                    %mi σ
                                    %mrow
                                      %mi n
                                      %mo −
                                      %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi σ
                                    %mi n
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mi n
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi σ
                                  %mi n
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^1 \wedge S^1 \wedge X_{n-1}
                    \&amp;\overset{S^1 \wedge \sigma_{n-1}}{\longrightarrow}&amp;
                    X_n
                    \\\
                    {}^{\mathllap{S^1 \wedge \sigma_{n-1}}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\sigma_n}}
                    \\\
                    S^1 \wedge X_{n}
                    \&amp;\underset{\sigma_n}{\longrightarrow}&amp;
                    X_{n+1}
                    }
                    \\,.
            %p But in all these cases, commutativity it trivially satisfied.
            %p
              Now as in the proof of prop.
              = succeed "," do
