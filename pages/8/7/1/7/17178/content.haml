                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo ∧
                    %msub
                      %mi K
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %msub
                      %mi K
                      %mo +
