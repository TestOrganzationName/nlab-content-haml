                    \\sigma^{X \wedge Y}_{2 n} \colon S^1 \wedge (X \wedge Y)_{2n} = S^1 \wedge X_n \wedge Y_n = (X \wedge Y)_{2n+1}
            %p and in odd degree as the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
