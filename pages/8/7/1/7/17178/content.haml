                          %mi K
                          %mo +
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∧
                    %msub
                      %mi K
                      %mo +
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^1 \wedge (X_n \wedge K_+) \simeq (S^1 \wedge X_n) \wedge K_+ \stackrel{\sigma_n \wedge K_+}{\longrightarrow} X_{n+1}\wedge K_+
                    \\,.
