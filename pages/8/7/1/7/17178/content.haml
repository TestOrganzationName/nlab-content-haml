                    %mi X
                    %mo ∨
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ∨
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %mi Y
                    %mover
