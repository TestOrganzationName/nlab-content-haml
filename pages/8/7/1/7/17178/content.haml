                          %mi X
                        %mo ,
                        %msubsup
                          %mi σ
                          %mi n
                          %mi Y
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∨
                    %msub
                      %mi Y
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_n^{X \vee Y}
                    \\;\colon\;
                    S^1 \wedge (X \vee Y)
                    \\simeq
                    S^1 \wedge X \,\vee\, S^1 \wedge Y
                    \\overset{(\sigma_n^X, \sigma_n^Y)}{\longrightarrow}
                    X_{n+1} \vee Y_{n+1}
                    \\,.
          %h3#tensoring_and_powering_over_pointed_spaces Tensoring and powering over pointed spaces
          %p
            The following defines
            %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
            and
            %a.existingWikiWord{:href => "/nlab/show/powering"} powering
            of sequential spectra over
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pointed+simplicial+sets"} pointed simplicial sets
          #TensoringAndPoweringOfSequentialSpectra.num_defn
            %h6#definition_5 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a sequential spectrum and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pointed+simplicial+set"} pointed simplicial set
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∧
                        %mi K
                      %annotation{:encoding => "application/x-tex"} X \wedge K
                  is the sequential spectrum with
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ∧
                            %mi K
                            %msub
                              %mo{:stretchy => "false"} )
