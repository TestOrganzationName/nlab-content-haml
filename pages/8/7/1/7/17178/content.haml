                                  %msup
                                    %mi S
                                    %mn 1
                                  %mo ∧
                                  %mn 0
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi σ
                                    %mn 0
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mn 0
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi σ
                                  %mn 0
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^1 \wedge S^1 \wedge \ast &amp;\overset{0}{\longrightarrow}&amp; X_0
                    \\\
                    {}^{\mathllap{S^1 \wedge 0}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\sigma_0}}
                    \\\
                    S^1 \wedge X_0 &amp;\underset{\sigma_0}{\longrightarrow}&amp; X_1
                    }
            %p
              and in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
              these:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %mi n
