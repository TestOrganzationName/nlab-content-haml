                  %annotation{:encoding => "application/x-tex"} X \in SeqSpec(sSet)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} K \in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
