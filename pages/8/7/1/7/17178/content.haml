          .proof
            %h6#proof_3 Proof
            %p The diagrams that need to commute for the structure maps to give a homomorphism as claimed are in degree 0 this one
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
