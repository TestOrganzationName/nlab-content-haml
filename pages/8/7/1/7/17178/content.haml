                          %mtd
                            %msub
                              %mi X
                              %mn 1
                        %mtr
                          %mtd
                            %munder
                              %mrow
                                %msub
                                  %mi X
                                  %mn 0
                              %mo ⏟
                          %mtd
                            %mover
