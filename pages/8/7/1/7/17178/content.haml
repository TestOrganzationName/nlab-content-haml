          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            %em
              sequential (
              %a.existingWikiWord{:href => "/nlab/show/prespectrum"}> pre-
              )
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            (also
            = succeed "," do
              %em Boardman spectrum
            = succeed "))" do
              %a{:href => "#Boardman65"} Boardman 65
            %a.existingWikiWord{:href => "/nlab/show/pointed+homotopy+types"} pointed homotopy types
            (
            %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"}> pointed topological spaces
            , pointed
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi n
                  %annotation{:encoding => "application/x-tex"} E_n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %msub
                    %mi E
                    %mi n
                  %mo →
                  %msub
                    %mi E
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \Sigma E_n \to E_{n+1}
            from the
            %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"} reduced suspension
            of one into the next space in the sequence.
          %p
            This is the original definition of
            %em
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            (or
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/pre-spectrum"} pre-spectrum
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coordinate-free+spectra"} coordinate-free spectra
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/excisive+functors"} excisive functors
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+spectra"} equivariant spectra
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+spectra"} combinatorial spectra
            %em sequential spectrum
            for emphasis (e.g.
            = succeed ")." do
              %a{:href => "#Schwede12"} Schwede 12, def. 2.1
          %h2#definition Definition
          %h3#in_components In components
          %p
            In what follows,
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi sSet
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"} sSet^{\ast/}
            the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo{:stretchy => "false"} /
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} \ast/sSet
            of
            %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed
            simplicial sets (the
            %a.existingWikiWord{:href => "/nlab/show/undercategory"} undercategory
            under the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enrichment
          #SequentialSpectra.num_defn
            %h6#definition_2 Definition
            %p
              A
              %em sequential
              %a.existingWikiWord{:href => "/nlab/show/pre-spectrum"} pre-spectrum
              in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              equipped with morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
