                %path{:d => "M -2.486964 2.869015 C -2.033937 1.148249 -1.021512 0.334129 0.00117847 0.0000723629 C -1.018155 -0.333966 -2.03371 -1.146971 -2.487933 -2.87024 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(0.78622, 0.61787, 0.61787, -0.78622, 86.89356, 68.70636)"}
