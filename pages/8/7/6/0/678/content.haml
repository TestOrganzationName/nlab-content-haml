          %h2#properties Properties
          %p Here are some basic but useful facts about simplicial presheaves.
          .un_prop
            %h6#proposition Proposition
            %p
              Every simplicial presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy colimit
              over a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of
              = succeed "-valued" do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %p
              More precisely, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo :
                    %msup
                      %mi S
                      %mi op
                    %mo →
                    %mi SSet
                  %annotation{:encoding => "application/x-tex"} X : S^{op} \to SSet
              a simplicial presheaf, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi X
                    %mo :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mi op
                    %mo ,
                    %mi SSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} D_X : \Delta^{op} \to [S^{op},Set] \hookrightarrow [S^{op},SSet]
              be given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi X
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi X
                        %mi n
                    %annotation{:encoding => "application/x-tex"} D_X : [n] \mapsto X_n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi hocolim
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %msub
                      %mi D
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    hocolim_{[n] \in \Delta} D_X([n]) \stackrel{\simeq}{\to} X
                    \\,.
          .proof
            %h6#proof Proof
            %p
              See for instance
              %a{:href => "http://www.math.uiuc.edu/K-theory/0563/spre.pdf#page=6"} remark 2.1, p. 6
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Dugger"}> Daniel Dugger
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sharon+Hollander"} Sharon Hollander
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Isaksen"} Daniel Isaksen
                = succeed "," do
                  %em Hypercovers and simplicial presheaves
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/math/0205027"} arXiv:math/0205027
                = succeed "," do
                  %a{:href => "http://www.math.uiuc.edu/K-theory/0563"} K-theory:0563
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1017/S0305004103007175"} doi:10.1017/S0305004103007175
            %p
              (which is otherwise about
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/descent+for+simplicial+presheaves"} descent for simplicial presheaves
          .un_cor
            %h6#corollary Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi SSet
                      %mrow
                        %msup
                          %mi S
                          %mi op
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ×
                    %msup
                      %mi SSet
                      %mrow
                        %msup
                          %mi S
                          %mi op
                    %mo →
                    %mi SSet
                  %annotation{:encoding => "application/x-tex"} [-,-] : (SSet^{S^{op}})^{op} \times SSet^{S^{op}} \to SSet
              be the canonical
              = succeed "-enrichment" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SSet
                    %annotation{:encoding => "application/x-tex"} SSet
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor categories
            %p
              It follows in particular from the above that every such
              %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X,A]
              of simplical presheaves can be written as a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
              (in
              %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
              for instance realized as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weighted+limit"} weighted limit
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          .proof
            %h6#proof_2 Proof
            %p First the above yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi hocolim
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi n
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %msub
                              %mi X
                              %mi n
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi holim
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi n
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi X
                              %mi n
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    [X, A ]  &amp; \simeq [ hocolim_{[n] \in \Delta} X_n , A ]
                    \\\
                    \&amp; holim_{[n] \in \Delta} [X_n, A]
                    \\end{aligned}
                    \\,.
            %p
              Next from the
              %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              we know that the
              = succeed "-valued" do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n
              are in turn colimits over representables in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mo ≃
                            %msub
                              %mi holim
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi n
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi colim
                              %mi i
                            %msub
                              %mi U
                              %mi i
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi holim
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi n
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %msub
                              %mi lim
                              %mi i
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi U
                              %mi i
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\cdots &amp; \simeq
                    holim_{[n] \in \Delta}
                    [ colim_i U_{i}, A]
                    \\\
                    \&amp; \simeq
                    holim_{[n] \in \Delta} lim_i
                    [  U_{i}, A]
                    \\end{aligned}
                    \\,.
            %p
              And finally the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              reduces this to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %msub
                              %mi holim
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi n
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %msub
                              %mi lim
                              %mi i
                            %mi A
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\cdots
                    \&amp;
                    holim_{[n] \in \Delta} lim_i
                    A(U_i)
                    \\end{aligned}
                    \\,.
          %p
            Notice that these kinds of computations are in particular often used when checking/computing
            %a.existingWikiWord{:href => "/nlab/show/descent"} descent and codescent
            along a
            %a.existingWikiWord{:href => "/nlab/show/cover"} cover
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/hypercover"} hypercover
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/descent+for+simplicial+presheaves"} descent for simplicial presheaves
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/descent+for+simplicial+presheaves"} descent for simplicial presheaves
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/presheaf+of+spectra"} presheaf of spectra
          %p Applications appear for instance at
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/geometric+infinity-function+theory"} geometric infinity-function theory
          %h2#references References
          %p The original articles are
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kenneth+S.+Brown"}> Kenneth S. Brown
                ,
                = succeed "." do
                  %em Abstract homotopy theory and generalized sheaf cohomology
                = succeed "." do
                  %a{:href => "http://dx.doi.org/10.1090/s0002-9947-1973-0341469-9"} doi
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kenneth+S.+Brown"}> Kenneth S. Brown
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Stephen+M.+Gersten"} Stephen M. Gersten
                = succeed "." do
                  %em Algebraic K-theory as generalized sheaf cohomology
                = succeed "." do
                  %a{:href => "http://dx.doi.org/10.1007/bfb0067062"} doi
          %p
            The Joyal model structure on
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sheaves"} simplicial sheaves
            was constructed in 1984 by
            %a.existingWikiWord{:href => "/nlab/show/Joyal"} Joyal
            in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"}> André Joyal
              ,
              = succeed "," do
                %em Lettre d’André Joyal à Alexandre Grothendieck
              = succeed "." do
                %a{:href => "https://webusers.imj-prg.fr/~georges.maltsiniotis/ps/lettreJoyal.pdf"} PDF
          %p
            Simplicial sheaves were endowed with a structure of a
            %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/J.+F.+Jardine"}> J. F. Jardine
              ,
              = succeed "." do
                %em Simplicial objects in a Grothendieck topos
              %a{:href => "http://dx.doi.org/10.1090/conm/055.1/862637"} doi
          %p
            The model structure on simplicial presheaves is due to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Jardine"} Jardine
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+F.+Jardine"}> John F. Jardine
              ,
              = succeed "," do
                %em Simplical presheaves
              %strong 47
              1 (1987) 35-87 &amp;lbrack;
              %a{:href => "http://dx.doi.org/10.1016/0022-4049(87)90100-9"}> doi:10.1016/0022-4049(87)90100-9
              \&amp;rbrack;
          %p A modern expository account is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+F.+Jardine"}> John F. Jardine
              ,
              = succeed "," do
                %em Local Homotopy Theory
              = succeed "." do
                %a{:href => "http://dx.doi.org/10.1007/978-1-4939-2300-7"} doi
          %p
            The local
            %a.existingWikiWord{:href => "/nlab/show/projective+model+structure"} projective model structure
            (as opposed to the injective model structures used above) on
            %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
            and
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sheaves"} simplicial sheaves
            is due to
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Benjamin+A.+Blander"}> Benjamin A. Blander
              ,
              = succeed "," do
                %em Local Projective Model Structures on Simplicial Presheaves
              = succeed "." do
                %a{:href => "http://dx.doi.org/10.1023/a:1013302313123"} doi
          %p Further articles:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/J.+F.+Jardine"}> J. F. Jardine
                ,
                = succeed "." do
                  %em Stacks and the homotopy theory of simplicial sheaves
                = succeed "." do
                  %a{:href => "http://dx.doi.org/10.4310/hha.2001.v3.n2.a5"} doi
            %li#Jardine07
              %p
                %a.existingWikiWord{:href => "/nlab/show/J.+F.+Jardine"}> J. F. Jardine
                \:
                = succeed "," do
                  %em Fields Lectures: Simplicial presheaves
                = succeed "," do
                  %a{:href => "https://www.math.uwo.ca/faculty/jardine/courses/fields/fields-01.pdf"} pdf
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/files/Jardine-SimplicialPresheaves.pdf", :title => "pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://www.uwo.ca/math/faculty/jardine/courses/fields/fields_lectures.html"} webpage
          %p
            For their interpretation in the more general context of
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+of+%28infinity%2C1%29-sheaves"} (infinity,1)-sheaves
            see Section 6.5.2 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
