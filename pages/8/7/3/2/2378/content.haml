                    %mo :
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} \alpha^{-1}_{f} : X \times Y \rightarrow Z
              given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,y) \mapsto \big( f(x) \big)(y)
              is continuous, where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              is equipped with the
              %a.existingWikiWord{:href => "/nlab/show/product+topology"} product topology
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒪
                        %mrow
                          %mi X
                          %mo ×
                          %mi Y
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}_{X \times Y}
          .proof
            %h6#proof_3 Proof
            %p We make the following observations.
            %p
              1) We have that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi α
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo =
                      %mi ev
                      %mo ∘
                      %mi τ
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ×
                      %mi id
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha^{-1}_{f} = ev \circ \tau \circ (f \times id)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo :
                    %msup
                      %mi Z
                      %mi Y
                    %mo ×
                    %mi Y
                    %mo →
                    %mi Y
                    %mo ×
                    %msup
                      %mi Z
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \tau : Z^{Y} \times Y \rightarrow Y \times Z^{Y}
              is given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f,y) \mapsto (y,f)
            %p
              2) By Proposition
              = succeed "," do
                %a.maruku-ref{:href => "#evIsContinuous"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                  %annotation{:encoding => "application/x-tex"} ev
              is continuous.
            %p
              3) It is an elementary fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
              is continuous.
            %p
              4) Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is continuous, it follows by an elementary fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ×
                    %mi id
                  %annotation{:encoding => "application/x-tex"} f \times id
              is continuous.
            %p
              5) We deduce from 2) - 4) that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                    %mo ∘
                    %mi τ
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ×
                    %mi id
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev \circ \tau \circ (f \times id)
              is continuous. By 1), we conclude that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi α
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \alpha^{-1}_{f}
              is continuous.
          #GivesExponentialObject.num_cor
            %h6#corollary Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \mathcal{O}_{X})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi 𝒪
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y, \mathcal{O}_{Y})
              be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \mathcal{O}_{X})
              is locally compact. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Y
                      %mi X
                    %mo ,
                    %msub
                      %mi 𝒪
                      %mrow
                        %msup
                          %mi Y
                          %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y^{X}, \mathcal{O}_{Y^{X}})
              together with the corresponding map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                  %annotation{:encoding => "application/x-tex"} ev
              defines an
              %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
              in the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of all topological spaces.
          .proof
            %h6#proof_4 Proof
            %p
              Follows immediately from Proposition
              = succeed "," do
                %a.maruku-ref{:href => "#alphafIsContinuous"}
              = succeed "," do
                %a.maruku-ref{:href => "#alphainvfIsContinuous"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mi X
                  %annotation{:encoding => "application/x-tex"} Y^{X}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                  %annotation{:encoding => "application/x-tex"} ev
              are exhibited by the corresponding maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} \alpha_{-}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi α
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \alpha^{-1}_{-}
              of Proposition
              %a.maruku-ref{:href => "#alphafIsContinuous"}
              and Proposition
              %a.maruku-ref{:href => "#alphainvfIsContinuous"}
              to define an exponential object in the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Set
                  %annotation{:encoding => "application/x-tex"} \mathsf{Set}
              of sets.
          .num_remark
            %h6#remark Remark
            %p
              A proof can also be found in
              = succeed "," do
                %a{:href => "#AguilarGitlerPrieto02"} Aguilar-Gitler-Prieto 02, prop. 1.3.1
            %p
              However, the result is almost universally stated with an assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\mathcal{O}_{X})
              is
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
              which, as the proof we have given illustrates, is not needed.
          .num_remark
            %h6#remark_2 Remark
            %p
              We moreover have a homeomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Map(X,Map(Y,Z))\cong Map(X\times Y,Z)
              if in addition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"} convenient category of topological spaces
          %h2#examples Examples
          %h3#maps_out_of_the_point_space Maps out of the point space
          #MappingSpaceOutOfPoint.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
                construction out of the
                %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
                is the identity)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
              is clearly a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              the mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Maps(\ast, (X,\tau))
              exists. This is
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              to the space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,\tau)
              itself:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Maps(\ast, (X,\tau))
                    \\simeq
                    (X,\tau)
                    \\,.
          %h3#maps_into_metric_spaces Maps into metric spaces
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is a
            %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
            then the compact-open topology on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Map(X,Y)
            is the
            %em topology of uniform convergence on compact subsets
            in the sense that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi n
                  %mo →
                  %mi f
                %annotation{:encoding => "application/x-tex"} f_n \to f
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Map(X,Y)
            with the compact-open topology iff for every compact subset
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} K\subset X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi n
                  %mo →
                  %mi f
                %annotation{:encoding => "application/x-tex"} f_n \to f
            uniformly on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is compact then this is the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/topology+of+uniform+convergence"} topology of uniform convergence
          %h3#loop_spaces_and_path_spaces Loop spaces and path spaces
          #LoopSpace.num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %ol
              %li
                %p
                  The standard
                  %a.existingWikiWord{:href => "/nlab/show/circle"} circle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S^1
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
                  %a.existingWikiWord{:href => "/nlab/show/open+subspaces+of+compact+Hausdorff+spaces+are+locally+compact"} hence
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
                  %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℒ
                        %mi X
                        %mo ≔
                        %mi Maps
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 1
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{L} X \coloneqq Maps( S^1, (X,\tau) )
                %p
                  exists. This is called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi τ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (X,\tau)
                %p
                  If both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S^1
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  are equipped with a choice of point (“
                  %a.existingWikiWord{:href => "/nlab/show/basepoint"}> basepoint
                  ”)
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi s
                            %mn 0
                          %mo ∈
                          %msup
                            %mi S
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} s_0 \in S^1
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi x
                            %mn 0
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} x_0 \in X
                  %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ω
                        %mi X
                        %mo ⊂
                        %mi ℒ
                        %mi X
                      %annotation{:encoding => "application/x-tex"}
                        \\Omega X \subset \mathcal{L}X
                %p
                  on those functions which take the basepoint of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S^1
                  to that of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/based+loop+space"} based loop space
              %li
                %p
                  Similarly the
                  %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
                  %a.existingWikiWord{:href => "/nlab/show/open+subspaces+of+compact+Hausdorff+spaces+are+locally+compact"} hence
                  a
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#LocallyCompactSpace"}
                  %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Maps
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Maps( [0,1], (X,\tau) )
                %p
                  exists. Again if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is equipped with a choice of basepoint
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi x
                            %mn 0
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} x_0 \in X
                  %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
                  of those functions that take
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} 0 \in [0,1]
                  to that chosen basepoint is called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
                  of
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mi τ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (X\tau)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mi X
                        %mo ⊂
                        %mi Maps
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        P X \subset Maps( [0,1], (X,\tau) )
                        \\,.
            %p
              Notice that we may encode these subspaces more abstractly in terms of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/universal+properties"} universal properties
            %p
              The path space and the loop space are characterized, up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
              %a.existingWikiWord{:href => "/nlab/show/limit"} limiting cones
              in the following
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              diagrams of topological spaces:
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/loop+space"}> loop space
                  \:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi Ω
                                %mi X
                              %mtd
                                %mo ⟶
                              %mtd
                                %mi Maps
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi S
                                  %mn 1
                                %mo ,
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %mi τ
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi pb
                                %mo{:stretchy => "false"} )
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi Maps
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi const
                                        %mrow
                                          %msub
                                            %mi s
                                            %mn 0
                                      %mo ,
                                      %msub
                                        %mi id
                                        %mrow
                                          %mo{:stretchy => "false"} (
                                          %mi X
                                          %mo ,
                                          %mi τ
                                          %mo{:stretchy => "false"} )
                                      %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo *
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mrow
                                    %msub
                                      %mi const
                                      %mrow
                                        %msub
                                          %mi x
                                          %mn 0
                              %mtd
                                %mi X
                                %mo ≃
                                %mi Maps
                                %mo{:stretchy => "false"} (
                                %mo *
                                %mo ,
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %mi τ
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\Omega X &amp;\longrightarrow&amp; Maps(S^1, (X,\tau))
                        \\\
                        \\downarrow &amp;(pb)&amp; \downarrow^{\mathrlap{Maps(const_{s_0}, id_{(X,\tau)})}}
                        \\\
                        \\ast &amp;\underset{const_{x_0}}{\longrightarrow}&amp; X \simeq Maps(\ast,(X,\tau))
                        }
                        \\,.
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/path+space"}> path space
                  \:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi P
                                %mi X
                              %mtd
                                %mo ⟶
                              %mtd
                                %mi Maps
                                %mo{:stretchy => "false"} (
                                %mo{:stretchy => "false"} [
                                %mn 0
                                %mo ,
                                %mn 1
                                %mo{:stretchy => "false"} ]
                                %mo ,
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %mi τ
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi pb
                                %mo{:stretchy => "false"} )
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi Maps
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi const
                                        %mi x
                                      %mo ,
                                      %msub
                                        %mi id
                                        %mrow
                                          %mo{:stretchy => "false"} (
                                          %mi X
                                          %mo ,
                                          %mi τ
                                          %mo{:stretchy => "false"} )
                                      %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo *
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mrow
                                    %msub
                                      %mi const
                                      %mrow
                                        %msub
                                          %mi x
                                          %mn 0
                              %mtd
                                %mi X
                                %mo ≃
                                %mi Maps
                                %mo{:stretchy => "false"} (
                                %mo *
                                %mo ,
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %mi τ
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        P X &amp;\longrightarrow&amp; Maps([0,1], (X,\tau))
                        \\\
                        \\downarrow &amp;(pb)&amp; \downarrow^{\mathrlap{Maps(const_x, id_{(X,\tau)})}}
                        \\\
                        \\ast &amp;\underset{const_{x_0}}{\longrightarrow}&amp; X \simeq Maps(\ast,(X,\tau))
                        }
            %p
              Here on the right we are using that the mapping space construction is a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              and we are using example
              %a.maruku-ref{:href => "#MappingSpaceOutOfPoint"}
              in the identification on the bottom right mapping space out of the point space.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/topology+of+mapping+spaces"} topology of mapping spaces
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/differential+topology+of+mapping+spaces"} differential topology of mapping spaces
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/C-k+topology"} C-k topology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/space+of+knots"} space of knots
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/mapping+complex"}> mapping complex
                ,
                %a.existingWikiWord{:href => "/nlab/show/simplicial+mapping+complex"} simplicial mapping complex
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/nearby+homomorphisms+from+compact+Lie+groups+are+conjugate"} nearby homomorphisms from compact Lie groups are conjugate
          %h2#references References
          %p Textbook accounts:
          %ul
            %li#Bredon93
              %p
                %a.existingWikiWord{:href => "/nlab/show/Glen+Bredon"}> Glen Bredon
                , Section VII.2 of:
                = succeed "," do
                  %em Topology and Geometry
                = succeed "," do
                  %strong 139
                = succeed "," do
                  %a{:href => "https://link.springer.com/book/10.1007/978-1-4757-6848-0"} doi:10.1007/978-1-4757-6848-0
                = succeed "&rbrack;" do
                  %a{:href => "http://virtualmath1.stanford.edu/~ralph/math215b/Bredon.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"}> Francis Borceux
                , Sections 7.1 &amp; 7.2 of:
                = succeed "," do
                  %em Categories and Structures
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Categorical+Algebra"} Handbook of Categorical Algebra
                %strong 50
                Cambridge University Press (1994) (
                %a{:href => "https://doi.org/10.1017/CBO9780511525865"}> doi:10.1017/CBO9780511525865
                )
            %li#AguilarGitlerPrieto02
              %p
                Marcelo Aguilar,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Samuel+Gitler"} Samuel Gitler
                = succeed "," do
                  %em Algebraic topology from a homotopical viewpoint
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/b97586"} doi:10.1007/b97586
                = succeed "&rbrack;" do
                  %a{:href => "http://tocs.ulb.tu-darmstadt.de/106999419.pdf"} toc pdf
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            of mapping spaces:
          %ul
            %li#Barratt55
              %a.existingWikiWord{:href => "/nlab/show/Michael+G.+Barratt"}> Michael G. Barratt
              \:
              = succeed "," do
                %em Track Groups (I)
              %strong s3-5
              1 (1955) &amp;lbrack;
              %a{:href => "https://doi.org/10.1112/plms/s3-5.1.71"}> doi:10.1112/plms/s3-5.1.71
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/barrtr1.pdf"} pdf
          %p
            and via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequences"} spectral sequences
          %ul
            %li#Federer56
              %p
                %a.existingWikiWord{:href => "/nlab/show/Herbert+Federer"}> Herbert Federer
                \:
                = succeed "," do
                  %em A Study of Function Spaces by Spectral Sequences
                %strong 82
                2 (1956) 340-361 [
                %a{:href => "https://doi.org/10.2307/1993052"}> doi:10.2307/1993052
                ,
                = succeed "]" do
                  %a{:href => "https://www.jstor.org/stable/1993052"} jstor:1993052
            %li#Dyer67
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+N.+Dyer"}> Michael N. Dyer
                \:
                = succeed "," do
                  %em Two Term Conditions in π Exact Couples
                %strong 19
                (1967) 1263-1288 [
                %a{:href => "https://doi.org/10.4153/CJM-1967-116-6"}> doi:10.4153/CJM-1967-116-6
                ]
          %p See also:
          %ul
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "http://en.wikipedia.org/wiki/Compact-open_topology"} Compact-open topology
            %li
              %p
                Ralph H. Fox,
                = succeed "," do
                  %em On Topologies for Function Spaces
                %strong 51
                (1945) pp.429-432. (
                %a{:href => "http://projecteuclid.org/download/pdf_1/euclid.bams/1183506987"}> pdf
                )
            %li
              %p
                Eva Lowen-Colebunders, Günther Richter,
                = succeed "," do
                  %em An Elementary Approach to Exponential Spaces
                = succeed ")" do
                  %a{:href => "http://link.springer.com/article/10.1023%2FA%3A1011268007097"} publisher
