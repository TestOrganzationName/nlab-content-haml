                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\Lambda^k[n] &amp;\to&amp; X
                      \\\
                      \\downarrow &amp;{}^\exists\nearrow&amp; \downarrow^f
                      \\\
                      \\Delta[n] &amp;\to&amp; Y
                      }
                      \\,.
            %li
              %p
                A morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f : X \to Y
                of fibrant simplicial sets /
                = succeed "es" do
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                on all
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+groups"} simplicial homotopy groups
            %li
              %p All simplicial sets are cofibrant with respect to this model structure.
            %li
              %p
                The fibrant objects are precisely the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complexes
          .num_prop
            %h6#proposition Proposition
            %p
              The
              %strong acyclic fibrations
              (i.e. the maps that are both fibrations as well as weak equivalences) between
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              that have the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              with respect to all inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \partial \Delta[n] \hookrightarrow \Delta[n]
              of boundaries of
              = succeed "-simplices" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-simplices" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo ∂
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mo ∃
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi f
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\partial \Delta[n] &amp;\to&amp; X
                    \\\
                    \\downarrow &amp;{}^\exists\nearrow&amp; \downarrow^f
                    \\\
                    \\Delta[n] &amp;\to&amp; Y
                    }
                    \\,.
          %p
            This appears spelled out for instance as (
            %a{:href => "#GoerssJardine"}> Goerss-Jardine, theorem 11.2
            ).
          %p In fact:
          .num_prop
            %h6#proposition_2 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
              is a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
              with
            %ul
              %li
                %p
                  generating cofibrations the
                  %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                  inclusions
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∂
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo →
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \partial \Delta[n] \to \Delta[n]
              %li
                %p
                  generating acyclic cofibrations the
                  %a.existingWikiWord{:href => "/nlab/show/horn"} horn
                  inclusions
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Λ
                            %mi i
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo →
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \Lambda^i[n] \to \Delta[n]
          .num_theorem
            %h6#theorem Theorem
            %p
              The
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                    %mo ⊣
                    %mi Sing
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi Top
                      %mi Quillen
                    %mover
                      %munder
                        %mo →
                        %mi Sing
                      %mover
                        %mo ←
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} |
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"}
                    ({\vert -\vert}\dashv Sing)
                    \:
                    Top_{Quillen}
                    \\stackrel{\overset{{\vert -\vert}}{\leftarrow}}{\underset{Sing}{\to}}
                    sSet_{Quillen}
            %p
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              with the standard
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+model+structure+on+topological+spaces"} Quillen model structure on topological spaces
          %p
            For more on this see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
          %h3#characterisations_of_weak_homotopy_equivalences Characterisations of weak homotopy equivalences
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              be the smallest class of morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
              satisfying the following conditions:
            %ol
              %li
                The class of monomorphisms that are in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                is closed under
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                has the
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
                property in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
                and contains all the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              %li
                For all natural numbers
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta [n] \to \Delta [0]
                is in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              is the class of weak homotopy equivalences.
          .proof
            %h6#proof Proof
            %ul
              %li
                First, notice that the horn inclusions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Λ
                        %mn 0
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ↪
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Lambda^0 [1] \hookrightarrow \Delta [1]
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Λ
                        %mn 1
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ↪
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Lambda^1 [1] \hookrightarrow \Delta [1]
                are in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
              %li
                Suppose that the horn inclusion
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Λ
                        %mi k
                      %mo{:stretchy => "false"} [
                      %mi m
                      %mo{:stretchy => "false"} ]
                      %mo ↪
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi m
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Lambda^k [m] \hookrightarrow \Delta [m]
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo &lt;
                      %mi n
                    %annotation{:encoding => "application/x-tex"} m \lt n
                and all
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ≤
                        %mi k
                        %mo ≤
                        %mi m
                      %annotation{:encoding => "application/x-tex"} 0 \le k \le m
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ≤
                        %mi l
                        %mo ≤
                        %mi n
                      %annotation{:encoding => "application/x-tex"} 0 \le l \le n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Λ
                        %mi l
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ↪
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Lambda^l [n] \hookrightarrow \Delta [n]
                is also in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
              %li
                Quillen’s
                %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
                then implies all the trivial cofibrations are in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
              %li
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} p : X \to Y
                is a trivial Kan fibration, then its right lifting property implies there is a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo :
                      %mi Y
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} s : Y \to X
                such that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ∘
                        %mi s
                        %mo =
                        %msub
                          %mi id
                          %mi Y
                      %annotation{:encoding => "application/x-tex"} p \circ s = id_Y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo :
                      %mi Y
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} s : Y \to X
                is a trivial cofibration. Thus every trivial Kan fibration is also in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
              %li
                Every weak homotopy equivalence factors as
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∘
                      %mi i
                    %annotation{:encoding => "application/x-tex"} p \circ i
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                is a trivial Kan fibration and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                is a trivial cofibration, so every weak homotopy equivalence is indeed in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
              %li
                Finally, noting that the class of weak homotopy equivalences satisfies the conditions in the theorem, we deduce that it is the
                %em smallest
                such class.
          %p
            As a corollary, we deduce that the classical model structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} sSet
            is the smallest (in terms of weak equivalences) model structure for which the cofibrations are the monomorphisms and the weak equivalences include the (combinatorial) homotopy equivalences.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo :
                    %mi sSet
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \pi_0 : sSet \to Set
              be the connected components functor, i.e. the left adjoint of the constant functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cst
                      %mo :
                      %mi Set
                      %mo →
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} cst : Set \to sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Z
                    %mo →
                    %mi W
                  %annotation{:encoding => "application/x-tex"} f : Z \to W
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
              is a weak homotopy equivalence if and only if the induced map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi K
                      %mi f
                    %mo :
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi K
                      %mi W
                    %mo →
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi K
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} \pi_0 K^f : \pi_0 K^W \to \pi_0 K^Z
            %p
              is a bijection for all
              %em Kan complexes
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
          .proof
            %h6#proof_2 Proof
            %p
              One direction is easy: if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a Kan complex, then axiom SM7 for
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
              implies the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi K
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi sSet
                      %mi op
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} K^{(-)} : sSet^{op} \to sSet
              is a right
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+functor"} Quillen functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi K
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi sSet
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \pi_0 K^{(-)} : sSet^{op} \to Set
              sends weak homotopy equivalences to bijections.
            %p
              Conversely, when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a Kan complex, there is a natural bijection between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi K
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \pi_0 K^X
              and the hom-set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi sSet
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho (sSet) (X, K)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Z
                    %mo →
                    %mi W
                  %annotation{:encoding => "application/x-tex"} f : Z \to W
              such that the induced morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi K
                      %mi W
                    %mo →
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi K
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} \pi_0 K^W \to \pi_0 K^Z
              is a bijection for all Kan complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is precisely a morphism that becomes an isomorphism in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi sSet
                      %mo{:stretchy => "false"} )
