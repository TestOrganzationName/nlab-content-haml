          %h3#relation_to_the_model_structure_on_strict_groupoids
            Relation to the model structure on strict
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %blockquote
            %p under construction
          %p
            Recall the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+strict+omega-groupoids"} model structure on strict omega-groupoids
            and the
            %a.existingWikiWord{:href => "/nlab/show/omega-nerve"} omega-nerve
            operation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo :
                  %mi Str
                  %mn ∞
                  %mi Grpd
                  %mo →
                  %mi Kan
                  %mi Complx
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  N : Str \infty Grpd \to Kan Complx
                  \\,.
          %blockquote
            %p this ought to be a Quillen functor, but is it?
          %p
            As a warmup, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ,
                  %mi D
                %annotation{:encoding => "application/x-tex"} C, D
            be ordinary
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(C)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(D)
            their ordinary
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
          .num_prop
            %h6#proposition_4 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F : C \to D
              is
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/k-surjective+functor"} k-surjective
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                and hence a surjective
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
                precisely if under the
                %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N(F) : N(C) \to N(D)
                it induces an acyclic fibration of Kan complexes;
          .proof
            %h6#proof_3 Proof
            %p
              We know that both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(C)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(D)
              are Kan complexes. By the above theorem it suffices to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(f)
              being a surjective equivalence is the same as having all lifts
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo ∂
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mi N
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mo ∃
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %mi N
                                %mo{:stretchy => "false"} (
                                %mi F
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mi N
                            %mo{:stretchy => "false"} (
                            %mi D
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\partial \Delta[n] &amp;\to&amp; N(C)
                    \\\
                    \\downarrow &amp;{}^\exists\nearrow&amp; \downarrow^{N(F)}
                    \\\
                    \\Delta[n] &amp;\to&amp; N(D)
                    }
                    \\,.
            %p
              We check successively what this means for increasing
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} n= 0
                  \. In degree 0 the boundary inclusion is that of the empty set into the
                  %a.existingWikiWord{:href => "/nlab/show/point"} point
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ∅
                          %mo ↪
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \emptyset \hookrightarrow {*}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} N(D)
                  lifts through
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} N(F)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi ∅
                              %mtd
                                %mo →
                              %mtd
                                %mi N
                                %mo{:stretchy => "false"} (
                                %mi C
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %msup
                                  %mrow
                                  %mo ∃
                                %mo ↗
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mrow
                                    %mi N
                                    %mo{:stretchy => "false"} (
                                    %mi F
                                    %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo *
                              %mtd
                                %mo →
                              %mtd
                                %mi N
                                %mo{:stretchy => "false"} (
                                %mi D
                                %mo{:stretchy => "false"} )
                        %mo ⇔
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi N
                                %mo{:stretchy => "false"} (
                                %mi C
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mo ∃
                                %mo ↗
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mrow
                                    %mi N
                                    %mo{:stretchy => "false"} (
                                    %mi F
                                    %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo *
                              %mtd
                                %mo →
                              %mtd
                                %mi N
                                %mo{:stretchy => "false"} (
                                %mi D
                                %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\emptyset &amp;\to&amp; N(C)
                        \\\
                        \\downarrow &amp;{}^\exists\nearrow&amp; \downarrow^{N(F)}
                        \\\
                        {*} &amp;\to&amp; N(D)
                        }
                        \\Leftrightarrow
                        \\array{
                        \&amp;&amp; N(C)
                        \\\
                        \&amp;{}^\exists\nearrow&amp; \downarrow^{N(F)}
                        \\\
                        {*} &amp;\to&amp; N(D)
                        }
                        \\,.
                %p
                  This precisely says that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} N(F)
                  is surjective on 0-cells and hence that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is surjective on objects.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n=1
                  \. In degree 1 the boundary inclusion is that of a pair of points as the endpoints of the interval
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %mo ∘
                          %mo ,
                          %mo •
                          %mo{:stretchy => "false"} }
                          %mo ↪
                          %mo{:stretchy => "false"} {
                          %mo ∘
                          %mo →
                          %mo •
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} \{\circ, \bullet\} \hookrightarrow \{\circ \to \bullet\}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a,b \in Obj(C)
                  all elements in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Hom(F(a),F(b))
                  are hit. Hence that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/full+functor"} full functor
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n=2
                  \. In degree 2 the boundary inclusion is that of the triangle as the boundary of a filled triangle. It is sufficient to restrict attention to the case that the map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 2
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \partial \Delta[2] \to N(C)
                  sends the top left edge of the triangle to an identity. Then the lifting property here evidently is equivalent to saying that for all objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a,b \in Obj(C)
                  the map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mi a
                            %mo ,
                            %mi b
                        %mo :
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F_{a,b} : Hom(a,b) \to Hom(F(a),F(b))
                  is injective. Hence that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mi b
                              %mtr
                                %mtd
                                %mtd
                                  %msup
                                    %mrow
                                    %mrow
                                      %msub
                                        %mi Id
