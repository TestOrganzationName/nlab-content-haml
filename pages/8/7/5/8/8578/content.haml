                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ω
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ×
                    %mi X
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mi cl
                      %mi n
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{(\Delta^1 \times X)/X}
                    \\;\colon\;
                    \\Omega(\Delta^1 \times X)_{cl}^n
                    \\longrightarrow
                    \\Omega^{n-1}(X)/im(\mathbf{d})
                    \\,.
          %p
            (
            %a{:href => "#BunkeNikolausVoelkl13"} Bunke-Nikolaus-Völkl 13, lemma 4.2 (7)
