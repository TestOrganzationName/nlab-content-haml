                      %mn 1
                    %mo ∘
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mo ≃
                    %msubsup
                      %mi i
                      %mn 1
                      %mo *
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msubsup
                      %mi i
                      %mn 0
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_0^1 \circ \mathbf{d} \simeq i_1^\ast - i_0^\ast
                    \\,.
          %p
            (
            %a{:href => "#BunkeNikolausVoelkl13"} Bunke-Nikolaus-Völkl 13, theorem 3.2
          %h3#recovering_traditional_integration_of_differential_forms Recovering traditional integration of differential forms
          .num_prop
            %h6#proposition_2 Proposition
            %p
              In
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} =
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat E \in Stab(\mathbf{H})
              be given, under the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/stable+Dold-Kan+correspondence"} stable Dold-Kan correspondence
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ^
                      %mo ≔
                      %msup
                        %mi Ω
                        %mrow
                          %mo •
                          %mo ≥
                          %mi n
                    %annotation{:encoding => "application/x-tex"} \hat E \coloneqq \Omega^{\bullet \geq n }
            %p
              Then on this object the general cohesive integration map of def.
              %a.maruku-ref{:href => "#CohesiveIntegrationOfDifferentialForms"}
              reduces on the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi n
                    %annotation{:encoding => "application/x-tex"} -n
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              to the tradition
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
              of differential forms as
              = succeed ":" do
                %a{:href => "#Description"} above
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
