            %li#RandallSundrum99b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lisa+Randall"}> Lisa Randall
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Raman+Sundrum"} Raman Sundrum
                = succeed "," do
                  %em An Alternative to Compactification
                = succeed ")" do
