          %h2#selected_writings Selected writings
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
            of
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifolds"} Kähler manifolds
          %ul
            %li#BordemannMeinrenkenSchlichenmaier93
              %a.existingWikiWord{:href => "/nlab/show/Martin+Bordemann"}> Martin Bordemann
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Eckhard+Meinrenken"} Eckhard Meinrenken
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Martin+Schlichenmaier"} Martin Schlichenmaier
              = succeed "," do
                %em
                  Toeplitz Quantization of Kähler Manifolds and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi gl
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} gl(N)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo →
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} N\to\infty
              %strong 165
              (1994) 281-296 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/hep-th/9309134"}> arXiv:hep-th/9309134
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/BF02099772"} doi:10.1007/BF02099772
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/basic+bundle+gerbe"} basic bundle gerbe
            over a
            %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/simple+Lie+group"} simple Lie group
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eckhard+Meinrenken"}> Eckhard Meinrenken
              ,
              = succeed "," do
                %em The basic gerbe over a compact simple Lie group
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/math/0209194"} arXiv:math/0209194
              = succeed "&rbrack;" do
                %a{:href => "https://www.e-periodica.ch/digbib/view?pid=ens-001:2003:49::562"} e-periodica
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eckhard+Meinrenken"}> Eckhard Meinrenken
              ,
              = succeed "," do
                %em Lie groups and Lie algebas
              = succeed ")" do
                %a{:href => "http://www.math.toronto.edu/mein/teaching/lie.pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/Clifford+algebras"} Clifford algebras
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eckhard+Meinrenken"}> Eckhard Meinrenken
              ,
              = succeed "," do
                %em Clifford algebras and Lie groups
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/978-3-642-36216-3"} doi:10.1007/978-3-642-36216-3
          %p
            On the image in
            %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
            of
            %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+fields"} Chan-Paton gauge fields
            over
            %a.existingWikiWord{:href => "/nlab/show/conjugacy+classes"} conjugacy classes
            giving the
            = succeed "/the" do
              %a.existingWikiWord{:href => "/nlab/show/Verlinde+ring"} Verlinde ring
            %a.existingWikiWord{:href => "/nlab/show/positive+energy+representations"} positive energy representations
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/loop+group"} loop group
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eckhard+Meinrenken"}> Eckhard Meinrenken
              ,
              = succeed "," do
                %em On the quantization of conjugacy classes
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/0707.3963"} arXiv:0707.3963
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-homology"} twisted K-homology
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eckhard+Meinrenken"}> Eckhard Meinrenken
              ,
              %em Twisted K-homology and group-valued moment maps
              (2010) (
              %a{:href => "http://arxiv.org/abs/1008.1261"}> arXiv:1008.1261
              )
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/transformation+groups"} transformation groups
            %a.existingWikiWord{:href => "/nlab/show/G-spaces"} G-spaces
            (
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"}> Lie group
            \-
            %a.existingWikiWord{:href => "/nlab/show/group+actions"} group actions
            on
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            in relation to
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory"} Chern-Weil theory
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+de+Rham+cohomology"} equivariant de Rham cohomology
          %ul
            %li#Meinrenken03
              %a.existingWikiWord{:href => "/nlab/show/Eckhard+Meinrenken"}> Eckhard Meinrenken
              ,
              = succeed "," do
                %em Group actions on manifolds
              = succeed "," do
                %a{:href => "http://www.math.toronto.edu/mein/teaching/LectureNotes/action.pdf"} pdf
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/Meinrenken_GroupActionsOnManifolds.pdf", :title => "pdf"} pdf
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+de+Rham+cohomology"} equivariant de Rham cohomology
          %ul
            %li#Meinrenken06
              %a.existingWikiWord{:href => "/nlab/show/Eckhard+Meinrenken"}> Eckhard Meinrenken
              ,
              = succeed "," do
                %em Equivariant cohomology and the Cartan model
              = succeed "," do
                %em Encyclopedia of Mathematical Physics
              = succeed "," do
                %a{:href => "http://www.math.toronto.edu/mein/research/enc.pdf"} pdf
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/B0-12-512666-2/00344-8"} doi:10.1016/B0-12-512666-2/00344-8
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/geometric+quantization+by+push-forward"} geometric quantization by push-forward
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Guillemin-Sternberg+geometric+quantization+conjecture"} Guillemin-Sternberg geometric quantization conjecture
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eckhard+Meinrenken"}> Eckhard Meinrenken
                ,
                = succeed "," do
                  %em
                    Symplectic surgery and the
                    = succeed "-Dirac" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi Spin
                              %mi c
                          %annotation{:encoding => "application/x-tex"} Spin^c
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hans+Duistermaat"}> Hans Duistermaat
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Victor+Guillemin"} Victor Guillemin
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eckhard+Meinrenken"} Eckhard Meinrenken
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Siye+Wu"} Siye Wu
                = succeed "," do
                  %em Symplectic reduction and Riemann-Roch for circle actions
                = succeed ")" do
                  %a{:href => "http://intlpress.com/_newsite/site/pub/files/_fulltext/journals/mrl/1995/0002/0003/MRL-1995-0002-0003-A-003.pdf"} pdf
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/moment+maps"} moment maps
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anton+Alekseev"}> Anton Alekseev
                , Anton Malkin,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eckhard+Meinrenken"} Eckhard Meinrenken
                = succeed "," do
                  %em Lie group valued moment maps
                = succeed "," do
                  %a{:href => "http://projecteuclid.org/euclid.jdg/1214460860"} euclid
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=1638045"} MR1638045
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eckhard+Meinrenken"}> Eckhard Meinrenken
                ,
                = succeed "," do
                  %em Lectures on group-valued moment maps and Verlinde formulas
                %a{:href => "http://www.math.toronto.edu/mein/research/NotreLectures.pdf"} pdf
          %p
