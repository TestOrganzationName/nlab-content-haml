                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is furthermore left anodyne, then it is an acyclic
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
          %p
            This appears as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, cor. 2.1.2.9
          .num_prop
            %h6#proposition_6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi A
                      %mn 0
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f : A_0 \to A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %msub
                      %mi B
                      %mn 0
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} g : B_0 \to B
              two inclusions of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              left anodyne, we have that the canonical morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 0
                    %mo ⋆
                    %mi B
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi A
                          %mn 0
                        %mo ⋆
                        %msub
                          %mi B
                          %mn 0
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⋆
                    %msub
                      %mi B
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                    %mo ⋆
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    (A_0 \star B ) \coprod_{A_0 \star B_0} (A \star B_0)
                    \\to
                    A \star B
            %p
              into the
              %a.existingWikiWord{:href => "/nlab/show/join+of+simplicial+sets"} join of simplicial sets
              is left anodyne.
          %p
            This is due to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Andre+Joyal"} Andre Joyal
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, lemma 2.1.4.2
          .num_prop
            %h6#proposition_7 Proposition
            %p
              %strong (restriction of over-quasi-categories along left anodyne inclusions)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi B
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p : B \to S
              be a morphism of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} i : A \to B
              a left anodyne morphism, then the restriction morphism of
              %a.existingWikiWord{:href => "/nlab/show/over+quasi-categories"} under quasi-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi p
                    %mo →
                    %msub
                      %mi S
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi p
                        %msub
                          %mo{:stretchy => "false"} |
                          %mi A
                  %annotation{:encoding => "application/x-tex"}
                    S_{/p} \to S_{/p|_A}
            %p
              is an acyclic
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
          %p
            This is a special case of what appears as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 2.1.2.5
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Andre+Joyal"} Andre Joyal
          .num_prop
            %h6#proposition_8 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p : X \to S
              be a morphism of simplicial sets with
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo :
                      %mi S
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} s : S \to X
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} X \times \Delta[1] \to S
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∘
                    %mi p
                  %annotation{:encoding => "application/x-tex"} s \circ p
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Id
                      %mi X
                  %annotation{:encoding => "application/x-tex"} Id_X
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              is left anodyne.
          %p
            This appears as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 2.1.2.11
