                        %mo{:stretchy => "false"} ]
                        %mo ×
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        (\Delta[m] \times \{0\})
