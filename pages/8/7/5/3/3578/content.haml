                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %mi S
                            %mo ×
