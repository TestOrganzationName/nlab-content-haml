                %a.existingWikiWord{:href => "/nlab/show/point"} point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %p
          %p
          .proof
            %h6 Proof
            %p
            %p
              This is originally due to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Andre+Joyal"} Andre Joyal
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 1.2.5.1
            %p
          %p
          #LeftFibrationsArePreservedByPullback.num_prop
            %h6 Proposition
            %p
              Right (left) fibrations are preserved by
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
          .proof
            %h6 Proof
            %p
              This follows on general grounds, since they are defined by a right
              %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
              (see, e.g. hereTheory#ClosurePropertiesOfInjectiveAndProjectiveMorphisms))
          %p
          #PullbackOfLeftFibrationsIsHomotopyPullback.num_prop
            %h6 Proposition
            %p
              The pullback (in
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/SimplicialSets"} SimplicialSets
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              in the
              %a.existingWikiWord{:href => "/nlab/show/Joyal+model+structure+for+quasi-categories"} Joyal model structure for quasi-categories
          %p
            (
            %a{:href => "#Cisinski19"}> Cisinski 2019, Cor. 5.3.6
            )
          .num_cor
            %h6#corollary_2 Corollary
            %p
              It follows that the fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi c
                  %annotation{:encoding => "application/x-tex"} X_c
              of every right fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X \to C
              over every point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c \in C
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mi c
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mi c
                            %mo{:stretchy => "false"} }
