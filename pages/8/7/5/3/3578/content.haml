                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi Λ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi i
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
