                        %mo ×
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mi S
                        %mo ′
                        %mo ×
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        (S' \times \{0\})
                        \\coprod_{S \times \{0\}}
