          .proof
            %h6#proof_4 Proof
            %p …
          .num_cor
            %h6#corollary_3 Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} i : A \to A'
              left-anodyne and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %mi B
                    %mo →
                    %mi B
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} j : B \to B'
              a cofibration in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ×
                    %mi B
                    %mo ′
                    %mo{:stretchy => "false"} )
