                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} LAn = LLP(RLP(LAn_0))
              for the following choices of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
