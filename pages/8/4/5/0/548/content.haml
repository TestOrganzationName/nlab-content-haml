                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
            is a monoidal category where every morphism is invertible and
            = succeed ":" do
              %em equipped with
          %ul
            %li
              for each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              a specific object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} x^{-1}
              and specific
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊗
                    %msup
                      %mi x
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} x \otimes x^{-1}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ⊗
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x^{-1} \otimes x
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              which form an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
          %p
            A theorem in HDA V (see references) shows that every weak
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internalization
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"} 2Grp
              of
              %strong 2-groups
              is equivalently
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(2,1)-category
                  of that of
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
                  and
                  %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functors"} strong monoidal functors
                  on those that are
                  %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
                  and whose
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                  has weak
                  %a.existingWikiWord{:href => "/nlab/show/inverses"} inverses
                  for each object;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
                  of that of
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/n-truncated"} 1-truncated
                  objects;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
                  of that of
                  %a.existingWikiWord{:href => "/nlab/show/group+object+in+an+%28%E2%88%9E%2C1%29-category"} group objects
                  in
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/n-truncated"} 1-truncated
                  objects;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                        %msubsup
                          %mi Grpd
                          %mrow
                            %mn 1
                            %mo ≤
                            %mo •
                            %mo ≤
                            %mn 2
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                        %mo ↪
                        %mn ∞
                        %msup
                          %mi Grpd
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"}
                        \\infty Grpd_{1 \leq \bullet \leq 2}^{*/}
                        \\hookrightarrow
                        \\infty Grpd^{*/}
                %p
                  of
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} ^{*/}
                  on those objects which are both
                  %a.existingWikiWord{:href => "/nlab/show/n-connected"} connected
                  as well as
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/n-truncated"} 2-truncated
          .num_remark
            %h6#remark Remark
            %p
              The last equivalent characterization is related to the previous ones by the
              = succeed "-equivalence" do
                %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping and delooping
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Grp
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mi Grpd
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %munder
                                %mo →
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                              %mover
                                %mo ←
                                %mi Ω
                          %mtd
                            %mn ∞
                            %msubsup
                              %mi Grpd
                              %mrow
                                %mo ≥
                                %mn 1
                              %mrow
                                %mo *
                                %mo{:stretchy => "false"} /
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi full
                                  %mspace{:width => "thickmathspace"}
                                  %mi inc
                                  %mo .
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi full
                                  %mspace{:width => "thickmathspace"}
                                  %mi inc
                                  %mo .
                        %mtr
                          %mtd
                            %mn 2
                            %mi Grp
                          %mtd
                            %mover
                              %munder
                                %mo →
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                              %mover
                                %mo ←
                                %mi Ω
                          %mtd
                            %mn 2
                            %msubsup
                              %mi Grpd
                              %mrow
                                %mo ≥
                                %mn 1
                              %mrow
                                %mo *
                                %mo{:stretchy => "false"} /
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Grp(\infty Grpd)
                    \&amp;\stackrel{\overset{\Omega}{\leftarrow}}{\underset{\mathbf{B}}{\to}}&amp;
                    \\infty Grpd^{*/}_{\geq 1}
                    \\\
                    \\uparrow^{\mathrlap{full\;inc.}}
                    \&amp;&amp;
                    \\uparrow^{\mathrlap{full\;inc.}}
                    \\\
                    2 Grp
                    \&amp;\stackrel{\overset{\Omega}{\leftarrow}}{\underset{\mathbf{B}}{\to}}&amp;
                    2Grpd_{\geq 1}^{*/}
                    }
                    \\,.
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} (-)^{*/}
              denotes taking
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-category"} slice under
              the point, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo ≥
                  %annotation{:encoding => "application/x-tex"} (-)_{\geq}
              denotes the full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} full inclusion
              on
              %a.existingWikiWord{:href => "/nlab/show/n-connected"} connected
              objects.
          %p
            By replacing in the last of these equivalent characterizations the ambient
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            with any other one, to be denoted
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            the
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-groupoids
            one obtains:
          .num_defn
            %h6#definition_3 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn 2
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"} Smooth2Grp
              of
              %strong smooth 2-groups
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Grp
                            %mo{:stretchy => "false"} (
                            %mi Smooth
                            %mn ∞
                            %mi Grpd
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %munder
                                %mo →
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                              %mover
                                %mo ←
                                %mi Ω
                          %mtd
                            %mi Smooth
                            %mn ∞
                            %msubsup
                              %mi Grpd
                              %mrow
                                %mo ≥
                                %mn 1
                              %mrow
                                %mo *
                                %mo{:stretchy => "false"} /
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi full
                                  %mspace{:width => "thickmathspace"}
                                  %mi inc
                                  %mo .
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi full
                                  %mspace{:width => "thickmathspace"}
                                  %mi inc
                                  %mo .
                        %mtr
                          %mtd
                            %mi Smooth
                            %mn 2
                            %mi Grp
                          %mtd
                            %mover
                              %munder
                                %mo →
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                              %mover
                                %mo ←
                                %mi Ω
                          %mtd
                            %mi Smooth
                            %mn 2
                            %msubsup
                              %mi Grpd
                              %mrow
                                %mo ≥
                                %mn 1
                              %mrow
                                %mo *
                                %mo{:stretchy => "false"} /
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Grp(Smooth \infty Grpd)
                    \&amp;\stackrel{\overset{\Omega}{\leftarrow}}{\underset{\mathbf{B}}{\to}}&amp;
                    Smooth\infty Grpd^{*/}_{\geq 1}
                    \\\
                    \\uparrow^{\mathrlap{full\;inc.}}
                    \&amp;&amp;
                    \\uparrow^{\mathrlap{full\;inc.}}
                    \\\
                    Smooth 2 Grp
                    \&amp;\stackrel{\overset{\Omega}{\leftarrow}}{\underset{\mathbf{B}}{\to}}&amp;
                    Smooth2Grpd_{\geq 1}^{*/}
                    }
                    \\,.
          %p
            Below in
            %a{:href => "#PresentationByCrossedModules"} presentation by crossed modules
            are discussed more explict presentations of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi Grp
                %annotation{:encoding => "application/x-tex"} 2Grp
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Smooth
                  %mn 2
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} Smooth2Grpd
            etc. by explicit algebraic data.
          %h2#properties Properties
          %h3#PresentationByCrossedModules Presentation by crossed modules
          %p
            By the discussion there, every
            %em
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            has a
            %em presentation
            by a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"} \infty Grp
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
            by the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+groups"} model structure on simplicial groups
            (for instance under
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi Grpd
                  %mo ≃
                  %msub
                    %mi L
                    %mi W
                  %msup
                    %mi Grp
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\infty Grpd \simeq L_W Grp^{\Delta^{op}}
                  \\,.
          %p
            Moreover, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∈
                  %msup
                    %mi Grp
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                %annotation{:encoding => "application/x-tex"} G \in Grp^{\Delta^{op}}
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-group"} n-group
            %a.existingWikiWord{:href => "/nlab/show/coskeleton"} n-coskeletal
            simplicial group. For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n = 2
            one finds that these are naturally identified with
            %em
              %a.existingWikiWord{:href => "/nlab/show/crossed+modules"} crossed modules
            of groups (see there for more details).
          %p In conclusion, this means that
          #PresentationOf2GrpByCrossedModules.num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"} 2Grp
              of 2-groups is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28infinity%2C1%29-categories"} equivalent
              to the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
              of the
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
              whose
            %ul
              %li
                %p
                  objects are
                  %a.existingWikiWord{:href => "/nlab/show/crossed+modules"} crossed modules
              %li
                %p
                  morphisms are
                  %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
                  of crossed modules;
              %li
                %p
                  weak equivalences are those morphisms of crossed modules which correspond to
                  %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
                  of the corresponding simplicial groups.
          %p A straightforward analysis shows that
          #HomotopyGroupsOfCrossedModule.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mn 1
                    %mover
                      %mo →
                      %mi δ
                    %msub
                      %mi G
                      %mn 0
                    %mo ,
                    %msub
                      %mi G
                      %mn 0
                    %mover
                      %mo →
                      %mi α
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (G_1 \stackrel{\delta}{\to} G_0, G_0 \stackrel{\alpha}{\to} Aut(G_1))
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              of the corresponding
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              are
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 0
                        %mo =
                        %msub
                          %mi G
                          %mn 0
                        %mo{:stretchy => "false"} /
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi δ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_0 = G_0 / im(\delta)
                  (the
                  %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} G_0
                  by the
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi δ
                        %annotation{:encoding => "application/x-tex"} \delta
                  %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
                  of
                  = succeed ");" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi G
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} G_0
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 1
                        %mo =
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %mi δ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_1 = ker(\delta)
                  (the
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  of
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi δ
                        %annotation{:encoding => "application/x-tex"} \delta
            %p
              Accordingly, a weak equivalence of crossed modules
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi G
                    %mo →
                    %mi H
                  %annotation{:encoding => "application/x-tex"} f : G \to H
              is a morphism of crossed modules which induces an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of kernel and cokernel of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi G
                  %annotation{:encoding => "application/x-tex"} \delta_G
              with that of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \delta_H
          %p
            Similar statements hold for 2-groups with extra structure. For instance the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Smooth
                  %mn 2
                  %mi Grp
                %annotation{:encoding => "application/x-tex"} Smooth2Grp
            of smooth 2-groups is equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
            of the category whose
          %ul
            %li
              %p
                objects are
                %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
                of
                %a.existingWikiWord{:href => "/nlab/show/crossed+modules"} crossed modules
                on
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                          %mi smooth
                      %annotation{:encoding => "application/x-tex"} {}_{smooth}
            %li
              %p
                weak equivalences are those morphisms of sheaves of crossed modules which on every
                %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
                induce weak equivalences of crossed modules as above.
          %p
            (See the discussion at
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            for more on this.)
          %h2#examples Examples
          %h3#specific_examples Specific examples
          %h4#picard_2group Picard 2-group
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Picard+2-group"} Picard 2-group
          %h4#automorphism_2groups Automorphism 2-groups
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            any
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \in C
            any object of it, the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Aut
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Aut_C(c) \subset Hom_C(c,c)
            of auto-equivalences of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            and invertible 2-morphisms between these is naturally a 2-group, whose group product comes from the horizontal composition in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
            there is the notion of strict
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/automorphism+2-group"} automorphism 2-group
          %p
            For instance if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %msub
                    %mi Grp
                    %mn 2
                  %mo ⊂
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} C = Grp_2 \subset Grpd
            is the 2-category of
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            obtained by regarding groups as one-object
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ∈
                  %mi Grp
                %annotation{:encoding => "application/x-tex"} H \in Grp
            a group, its automorphism 2-group obtained this way is the strict 2-group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi AUT
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi Aut
                    %mrow
                      %msub
                        %mi Grp
                        %mn 2
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  AUT(H) := Aut_{Grp_2}(H)
          %p
            corresponding to the
            %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mover
                      %mo →
                      %mi Ad
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (H \stackrel{Ad}{\to} Aut(H))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Aut(H)
            is the ordinary
            %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
          %h4#inner_automorphism_2groups Inner automorphism 2-groups
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inner+automorphism+2-group"} inner automorphism 2-group
          %h4#string_2group String 2-group
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
          %h4#platonic_2group Platonic 2-group
          %p
            See
            %em
              %a.existingWikiWord{:href => "/nlab/show/Platonic+2-group"} Platonic 2-group
          %h3#ExamplesForEquivalencesOf2Groups Equivalences of 2-groups
          %p
            We discuss some weak equivalences in the
            %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            of
            %a.existingWikiWord{:href => "/nlab/show/crossed+modules"} crossed modules
            and crossed module homomorphisms, which presents
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi Grp
                %annotation{:encoding => "application/x-tex"} 2Grp
            by the discussion
            = succeed "." do
              %a{:href => "#PresentationByCrossedModules"} above
          %h4#FromInclusionsOfNormalSubgroups From inclusions of normal subgroups
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo ↪
                  %mi G
                %annotation{:encoding => "application/x-tex"} N \hookrightarrow G
            the inclusion of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo ↪
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (N \hookrightarrow G)
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo →
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1 \to G/N)
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            group, regarded as a crossed module.
          .num_prop
            %h6#observation Observation
            %p
              The morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ↪
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi N
                  %annotation{:encoding => "application/x-tex"} (N \hookrightarrow G) \to G/N
              is a weak equivalence of crossed modules, prop.
              = succeed "." do
                %a.maruku-ref{:href => "#PresentationOf2GrpByCrossedModules"}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28infinity%2C1%29-category"} equivalence
              of 2-groups.
          .proof
            %h6#proof Proof
            %p The canonical morphism in question is given by the commuting diagram of groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi N
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi f
                                  %mn 1
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi f
                                  %mn 0
                          %mtd
                            %mi G
                            %mo{:stretchy => "false"} /
                            %mi N
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    N &amp;\stackrel{f_1}{\to}&amp; 1
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    G &amp;\stackrel{f_0}{\to}&amp; G/N
                    }
                    \\,.
            %p
              By prop.
              %a.maruku-ref{:href => "#HomotopyGroupsOfCrossedModule"}
              we need to check that this induces an isomorphism on the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              and
              %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
              of the vertical morphisms.
            %p
              The kernel of the left vertical morphism is the trivial group, because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ↪
                    %mi G
                  %annotation{:encoding => "application/x-tex"} N \hookrightarrow G
              is an inclusion, by definition. Clearly also the kernel of the right vertical morphisms is the trivial group. Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1
              restricted to the kernels is the unique morphism from the trivial group to itself, hence is an isomrphism.
            %p
              Moreover, the cokernel of the left vertical morphism is of course the quotient
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi N
                  %annotation{:encoding => "application/x-tex"} G/N
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} f_0
          %p
            This class of weak equivalence plays an important role as constituting
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctor"} 2-anafunctors
            that exhibit long
            %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
            extensions of
            %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
            of
            %a.existingWikiWord{:href => "/nlab/show/central+extensions"} central extensions
            of groups.
          .num_prop
            %h6#observation_2 Observation
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} A \to \hat G
              be the inclusion of a
              %a.existingWikiWord{:href => "/nlab/show/center"} central
              subgroup, exhibiting a
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} A \to \hat G \to G
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo :
                      %mo =
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} /
                      %mi A
                    %annotation{:encoding => "application/x-tex"} G := \hat G/A
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of groups extends to a long
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
              of 2-groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi A
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A \to \hat G \to G \to \mathbf{B}A \to \mathbf{B}\hat G \to \mathbf{B}G \to \mathbf{B}^2 A
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}A
              denotes the 2-group given by the
              %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo →
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A \to 1)
            %p
              Here the
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi A
                  %annotation{:encoding => "application/x-tex"} G \to \mathbf{B}A
              is presented in the category of crossed modules by a zig-zag /
              %a.existingWikiWord{:href => "/nlab/show/anafunctor"} anafunctor
              whose left leg is the above weak equivalence:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo →
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (1 \to G) \stackrel{\simeq}{\leftarrow}
                    (A \to \hat G)
                    \\to
                    (A \to 1)
                    \\,.
          .num_example
            %h6#example Example
            %p
              For smooth 2-groups, useful examples of the above are smooth refinements of various
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/universal+characteristic+classes"} universal characteristic classes
            %ul
              %li
                %p
                  the second
                  %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+class"} Stiefel-Whitney class
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi w
                          %mn 2
                        %mo :
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi SO
                        %mo →
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mn 2
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"}
                        w_2 : \mathbf{B}SO \to \mathbf{B}^2\mathbb{Z}_2
                %p
                  is induced this way from the central extension
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
                        %mo →
                        %mi Spin
                        %mo →
                        %mi SO
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2 \to Spin \to SO
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} special orthogonal group
                  by the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              %li
                %p
                  the first
                  %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mn 1
                        %mo :
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mn 2
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"}
                        c_1 : \mathbf{B}U(1) \to \mathbf{B}^2 \mathbb{Z}
                %p
                  induced from the central extension
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo →
                          %mi ℝ
                          %mo →
