                        %mn 1
                    %mo ⊗
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x^{-1} \otimes x
              are each
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the monoidal unit
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
          %p
            A
            %strong
              coherent
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
