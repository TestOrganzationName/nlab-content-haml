          %h4#horavawitten_theory Horava-Witten theory
          %p
            One considers the
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
            of
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            on a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"} Z/2
            %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/torus"} torus
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            of two
            %a.existingWikiWord{:href => "/nlab/show/circles"} circles
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                          %msubsup
                            %mi S
                            %mi A
                            %mn 1
                        %mtd
                          %mo ×
                        %mtd
                          %msubsup
                            %mi S
                            %mi B
                            %mn 1
                      %mtr
                        %mtd
                          %mtext radius
                          %mo :
                        %mtd
                          %msub
                            %mi R
                            %mn 11
                        %mtd
                        %mtd
                          %msub
                            %mi R
                            %mn 10
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; S^1_A &amp;\times&amp; S^1_B
                  \\\
                  \\text{radius}: &amp;  R_{11} &amp;&amp; R_{10}
                  }
          %p
            such that the reduction on the first factor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi S
                    %mi A
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1_A
            corresponds to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/duality+between+M-theory+and+type+IIA+string+theory"} duality between M-theory and type IIA string theory
            %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-duality
            along the second factor yields
            %a.existingWikiWord{:href => "/nlab/show/type+IIB+string+theory"} type IIB string theory
            (in its
            = succeed "-incarnation)." do
              %a.existingWikiWord{:href => "/nlab/show/F-theory"} F-theory
            %a.existingWikiWord{:href => "/nlab/show/S-duality"} S-duality
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
