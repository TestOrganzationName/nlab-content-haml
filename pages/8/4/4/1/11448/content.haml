                            %mrow
                              %mi KK
                              %mo{:stretchy => "false"} /
                              %msubsup
                                %mi ℤ
                                %mn 2
                                %mi A
                        %mtd
                          %mi M
                        %mtd
                          %mover
                            %mo ↔
                            %mrow
                              %mi KK
                              %mo{:stretchy => "false"} /
                              %msubsup
                                %mi ℤ
                                %mn 2
                                %mi B
                        %mtd
                          %mi I
                          %mo ′
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mi T
                          %mo{:stretchy => "false"} ↕
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↕
