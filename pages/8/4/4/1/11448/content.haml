                            %mrow
                              %mphantom
                                %mi A
                              %mi S
                              %mphantom
                                %mi A
                        %mtd
                        %mtd
                          %mi I
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  HE
                  \&amp;\overset{KK/\mathbb{Z}^A_2}{\leftrightarrow}&amp;
                  M
                  \&amp;\overset{KK/\mathbb{Z}^B_2}{\leftrightarrow}&amp;
                  I'
                  \\\
