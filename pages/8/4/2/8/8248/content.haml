                                %msub
                                  %mi g
                                  %mn 2
                          %mtd
                          %mtd
                            %msub
                              %mi D
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
